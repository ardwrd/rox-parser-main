    ["ui_SpringFestivalActivity_028"]="Tons of Lucky Bags",
    ["ui_SpringFestivalActivity_029"]="(Maksimal 10 kali per hari)",
    ["ui_SpringFestivalActivity_030"]="Bonus reward langka",
