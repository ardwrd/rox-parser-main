    ["DialogueOption91603011"]="Kontrak...?",
    ["DialogueOption91701011"]="(｡･∀･)ﾉﾞ Hai?",
    ["DialogueOption91701021"]="Makan malam, rambut cerpelai?",
    ["DialogueOption91701031"]="...",
    ["DialogueOption91701041"]="Ah",
    ["DialogueOption91702011"]="Jakdal",
    ["DialogueOption91702021"]="Yang paling mahal?",
    ["DialogueOption91702031"]="72 jam??",
    ["DialogueOption91702041"]="Terlalu berlebihan...",
    ["DialogueOption91704011"]="Kostummu~",
    ["DialogueOption91704021"]="Kejutan?",
    ["DialogueOption91801011"]="Apakah ini penting bagimu?",
