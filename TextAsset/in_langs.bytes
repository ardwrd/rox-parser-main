    ["LiquorParty_Task_21_12"]="Total penggunaan Crystal di Exchange Center %s/%s",
    ["LiquorParty_Task_21_13"]="Total Vending Machine Coin terpakai %s/%s",
    ["LiquorParty_Task_21_14"]="Level Upgrade Equipment dalam sejarah mencapai %s/%s",
