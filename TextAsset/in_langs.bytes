    ["ui_Christmas2022_001"]="Kucing Natal",
    ["ui_Christmas2022_002"]="Lindungi Toy Factory",
    ["ui_Christmas2022_003"]="Perbaikan Kereta Luncur",
    ["ui_Christmas2022_004"]="Sudah diambil\nHari ini",
    ["ui_Christmas2022_005"]="Progres Perbaikan",
    ["ui_Christmas2022_006"]="Kereta luncur Santa sudah dirusak oleh Garm! Ayo bantu dia perbaiki!",
    ["ui_Christmas2022_007"]="\u{3000}\u{3000}<color=#b3f56d>Cookie Manager</color> setiap hari menerima banyak <color=#a0edfe>laporan serangan</color> dari Garm dari Adventurer yang berpetualang. Selesaikan quest-nya untuk memperoleh reward-nya.",
    ["ui_Christmas2022_008"]="Deskripsi Gameplay",
    ["ui_Christmas2022_009"]="\u{3000}\u{3000}<color=#b3f56d>Garm</color> akhir-akhir ini selalu menyerang Toy Factory, konon katanya hanya <color=#a0edfe>Transmog</color> yang bisa terlepas dari sihirnya. Ayo lindungi Toy Factory bersama!",
    ["ui_Christmas2022_010"]="Progres Pribadi",
    ["ui_Christmas2022_011"]="Mungkin\nMenda-\npatkan",
    ["ui_Christmas2022_012"]="Bahan",
    ["ui_Christmas2022_013"]="Pergi ke map natal setiap hari dan cari Clown yang bersembunyi. Akan ada rewardnya loh!",
    ["ui_ChristmasActivity_001"]="Harus <color=#fffaaf>membuka fitur [Home]</color> agar bisa menggunakan Furniture Giftbox!",
    ["ui_ChristmasActivity_002"]="Belum berpartisipasi hari ini",
