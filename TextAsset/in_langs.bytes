    ["OXExam_Question114"]="<color=#F2C730FF>Lotus Root</color> adalah <color=#F2C730FF>akar</color> dari <color=#F2C730FF>teratai</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question114_1"]="Batang teratai",
    ["OXExam_Question115"]="Planet yang paling dekat dengan matahari adalah <color=#F2C730FF>Mars</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question115_1"]="Merkurius",
    ["OXExam_Question116"]="<color=#F2C730FF>Hitam</color> dapat menyerap tujuh warna sinar matahari, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question117"]="<color=#F2C730FF>Hiu</color> adalah hewan bertelur, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question117_1"]="Hiu adalah hewan mamalia.",
    ["OXExam_Question118"]="<color=#F2C730FF>Awan</color> dan <color=#F2C730FF>kabut</color> pada dasarnya adalah elemen yang sama, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question119"]="Coco dari Payon menjadi rabun senja karena pilih-pilih makan, alasannya adalah karena kekurangan vitamin B, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question119_1"]="Rabun senja karena kekurangan vitamin A.",
    ["OXExam_Question120"]="Coco dari Payon menggertakkan gigi ketika dia tidur karena kurangnya asupan Zinc, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question121"]="Ragnarok Online diadaptasi dari sebuah <color=#F2C730FF>komik/manhwa</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question122"]="DMG yang disebabkan oleh <color=#F2C730FF>M.ATK</color> akan terpengaruh oleh <color=#F2C730FF>size target</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question122_1"]="DMG M.ATK tidak dipengaruhi oleh Size target",
    ["OXExam_Question123"]="Hewan terbesar di darat adalah <color=#F2C730FF>Gajah</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question124"]="<color=#F2C730FF>Poison Element</color> Attack dapat meningkatkan damage <color=#F2C730FF>kepada semua Element</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question124_1"]="Poison Element Attack hanya meningkatkan damage sebagian Element",
    ["OXExam_Question125"]="<color=#F2C730FF>ASPD</color> dan <color=#F2C730FF>Final ASPD</color> bukanlah Stats yang sama, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question126"]="<color=#F2C730FF>Crit</color> dan <color=#F2C730FF>Final Crit</color> adalah Stats yang sama, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question126_1"]="Crit dan Final Crit bukanlah Stats yang sama",
    ["OXExam_Question127"]="<color=#F2C730FF>Flee</color> dan <color=#F2C730FF>Final Flee</color> adalah Stats yang sama, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question127_1"]="Flee dan Final Flee bukanlah Stats yang sama",
    ["OXExam_Question128"]="Lapangan golf standar memiliki <color=#F2C730FF>20 hole</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question128_1"]="18 hole",
    ["OXExam_Question129"]="Setelah menggunakan <color=#F2C730FF>Magnum Break</color>, Attribute Normal Attack menjadi <color=#F2C730FF>fire</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question130"]="Setelah menggunakan <color=#F2C730FF>Aspersio</color>, Attribute Normal Attack menjadi <color=#F2C730FF>holy</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question131"]="Hanya job <color=#F2C730FF>Merchant</color> yang dapat melakukan <color=#F2C730FF>Vending</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question131_1"]="Pet Merchant juga bisa melakukan vending",
    ["OXExam_Question132"]="Kamu bisa mempercepat pengisian <color=#F2C730FF>Odin's Blessing</color> di <color=#F2C730FF>Prontera</color> setiap jam <color=#F2C730FF>12:00 dan 20:00</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question133"]="Dengan meningkatkan <color=#F2C730FF>Haste</color>, bisa mengurangi durasi <color=#F2C730FF>Variable Cast</color> skill, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question134"]="<color=#F2C730FF>Waktu Spawn</color> <color=#F2C730FF>MVP</color> dan <color=#F2C730FF>Mini</color> selalu sama, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question134_1"]="Waktu Spawn MVP dan Mini tidak sama",
    ["OXExam_Question135"]="Untuk menemukan item di <color=#F2C730FF>Vending</color>, hanya bisa dicek <color=#F2C730FF>satu persatu</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question135_1"]="Shop Finder di Sundries Store bisa menemukan Vending dengan cepat",
    ["OXExam_Question136"]="Dalam Exchange Center, item yang terjual dengan <color=#F2C730FF>Diamond</color> akan mendapatkan <color=#F2C730FF>sejumlah Crystal yang setara</color> jumlah Diamond setelah dikurangi pajak transaksi. benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question137"]="Setelah Maya menggunakan <color=#F2C730FF>Defensive Stance</color>, <color=#F2C730FF>Job dengan serangan range</color> seharusnya <color=#F2C730FF>memperkuat serangan</color> untuk menembus pertahanan Maya, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question137_1"]="Ranged Job seharusnya menjauh",
    ["OXExam_Question138"]="Katanya sebelum <color=#F2C730FF>Munak</color> dan <color=#F2C730FF>Bongun</color> menjadi monster, mereka dulu adalah <color=#F2C730FF>pasangan</color> yang saling mengasihi, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question138_1"]="Munak dan Bongun adalah kakak beradik",
    ["OXExam_Question139"]="<color=#F2C730FF>Ayah dan anak perempuan</color> di luar <color=#F2C730FF>Prontera South Gate</color> <color=#F2C730FF>tidak memiliki</color> hubungan darah, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question140"]="Ada <color=#F2C730FF>9</color> jenis <color=#F2C730FF>Poring</color> yang berbeda di Midgard, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question140_1"]="Ada tujuh jenis Poring",
    ["OXExam_Question141"]="<color=#F2C730FF>Kantor pusat</color> Kafra terletak di <color=#F2C730FF>Alberta</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question141_1"]="Terletak di Al De Baran",
    ["OXExam_Question142"]="Kota perbatasan <color=#F2C730FF>Morroc</color> memiliki <color=#F2C730FF>industri kapas</color> yang sangat berkembang, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question143"]="Saat ini, ada <color=#F2C730FF>9</color> jenis <color=#F2C730FF>goblin bertopeng</color> di Midgard, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question143_1"]="Ada delapan jenis",
    ["OXExam_Question144"]="Setelah memasuki <color=#F2C730FF>malam hari</color>, <color=#F2C730FF>Vagabond Wolf</color> akan menjadi lebih kuat, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question145"]="<color=#F2C730FF>Eclipse</color> paling suka bau <color=#F2C730FF>Durian Grass</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question146"]="Accessory yang dikenakan <color=#F2C730FF>Baphomet</color> disebut \"<color=#F2C730FF>Demon Ring</color>\", benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question147"]="Dikatakan bahwa mata <color=#F2C730FF>Nightmare</color> memiliki kekuatan <color=#F2C730FF> untuk melihat menembus hati manusia </color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question148"]="<color=#F2C730FF>Deviling</color> adalah monster <color=#F2C730FF>large</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question148_1"]="Medium",
    ["OXExam_Question149"]="Setelah menggunakan skill <color=#F2C730FF>Roll</color> atau <color=#F2C730FF>Hiding</color>, Assassin akan memasuki status <color=#F2C730FF>Hiding</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question150"]="Ragnarok Online adalah game yang diadaptasi dari <color=#F2C730FF>kartun</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question151"]="Makanan favorit <color=#F2C730FF>Poring</color> adalah <color=#F2C730FF>Apple Juice</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question152"]="“<color=#F2C730FF>Worn Out Scroll</color>\" dan \"<color=#F2C730FF>Alcohol</color>\" adalah item yang dijatuhkan oleh monster <color=#F2C730FF>Undead Race</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question152_1"]="Drop dari Demon",
    ["OXExam_Question153"]="MVP/Mini yang disummon dengan <color=#F2C730FF>Bloody Dead Branch</color> hanya bisa bertahan selama <color=#F2C730FF>1 jam</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question154"]="<color=#F2C730FF>Burung gagak</color> milik Drake selalu berdiri di atas <color=#F2C730FF>bahu kirinya</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question155"]="<color=#F2C730FF>Geffen</color> adalah kediaman <color=#F2C730FF>Mage Guild</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question156"]="<color=#F2C730FF>Shattering Shroom</color> tidak hanya muncul pada Night, tetapi juga dapat dikumpulkan saat <color=#F2C730FF>Sunny</color> <color=#F2C730FF>Day</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question156_1"]="Hanya di Morning atau Evening",
    ["OXExam_Question157"]="Saat berpartisipasi dalam <color=#F2C730FF>Guild KVM</color>, anggota party boleh dapat berasal dari <color=#F2C730FF>Guild yang berbeda </color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question157_1"]="Harus satu Guild",
    ["OXExam_Question158"]="Ada <color=#F2C730FF>6</color> ikan berbeda yang dapat ditangkap di <color=#F2C730FF>Underwater Cave</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question159"]="Ketika <color=#F2C730FF>Hollgrehenn</color> menunjukkan bisepnya, dia selalu suka mengangkat <color=#F2C730FF>kedua tangan</color> dulu, lalu mengangkat <color=#F2C730FF>tangan kanan</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question159_1"]="2 tangan dulu lalu tangan kiri",
    ["OXExam_Question160"]="Ada <color=#F2C730FF>3</color> jenis bunga teratai di <color=#F2C730FF>Bright Lotus Pond</color> Payon, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question161"]="<color=#F2C730FF>W</color> disebut <color=#F2C730FF>ratu paling populer</color> dari seluruh Kafra, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question162"]="Dalam permainan <color=#F2C730FF>Panco</color> di tavern, kita selalu menggunakan <color=#F2C730FF>tangan kiri</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question162_1"]="Panco menggunakan tangan kanan",
    ["OXExam_Question163"]="<color=#F2C730FF>Moonlight Flower</color> memiliki pupil <color=#F2C730FF>merah</color> yang cantik, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question164"]="Tanda merah pada <color=#F2C730FF>King Dramoh</color> adalah luka karena pernah <color=#F2C730FF>dimasak dengan suhu tinggi</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question165"]="Ketika terkena serangan <color=#F2C730FF>Acid Rain</color> Phreeoni, kamu dapat menggunakan <color=#F2C730FF>Panacea</color> untuk menghilangkan debuff, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question166"]="<color=#F2C730FF>Jur</color> bisa mengakibatkan 100% Damage terhadap <color=#F2C730FF>Monster berukuran Small dan Medium</color>, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question166_1"]="Mengakibatkan 100% Damage kepada Small Monster",
    ["OXExam_Question167"]="<color=#F2C730FF>Saat Auto di map</color>, pengali bonus akan meningkat secara proporsional seiring dengan meningkatnya jumlah anggota party, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question168"]="<color=#F2C730FF>Equipment emas</color> bisa diperoleh dengan cara: MVP, MINI, Exchange Center, dan Equipment Vending Machine, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question169"]="Dalam halaman skill, skill dengan tanda bentuk <color=#F2C730FF>lingkaran</color> adalah skill aktif, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question170"]="Dalam halaman skill, skill dengan tanda bentuk <color=#F2C730FF>persegi</color> adalah skill pasif, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question171"]="Dalam pengaturan Auto di halaman skill, <color=#F2C730FF>Skill aktif</color> tidak bisa disesuaikan levelnya, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question171_1"]="Level skill bisa diatur di halaman Auto",
    ["OXExam_Question172"]="<color=#F2C730FF>Crystal Store</color> di Alberta menjual Neuralizer yang bisa me-reset skill point, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question173"]="<color=#F2C730FF>Crystal Store</color> di Alberta menjual Magical Stone yang bisa me-reset stat point, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question174"]="<color=#F2C730FF> Ultimate Showdown</color> adalah gameplay PVP yang adil, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question175"]="Mengikuti event <color=#F2C730FF> Ultimate Showdown </color> akan bisa mendapatkan berbagai material peningkatan <color=#F2C730FF>Shadow Equipment</color>, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question176"]="Pet <color=#F2C730FF>Yoyo</color> paling suka dengan Juicy Grape, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question177"]="Pet<color=#F2C730FF>Baby Desert Wolf</color> paling suka dengan Animal Gore, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question177_1"]="Baby Desert Wolf menyukai Livestock Gore",
    ["OXExam_Question178"]="<color=#F2C730FF>Odin's Blessing</color> hanya efektif terhadap monster dengan perbedaan 3 level, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question178_1"]="Monster dengan perbedaan 6 level",
    ["OXExam_Question179"]="<color=#F2C730FF>Odin's Blessing</color> hanya bisa diperoleh dengan menyelesaikan Mission Board setiap hari, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question179_1"]="Mission Board dan air mancur Prontera",
    ["OXExam_Question180"]="Mengikuti <color=#F2C730FF>Tavern Minigame</color> akan bisa mendapatkan <color=#F2C730FF>Stamina Potion</color>, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question181"]="<color=#F2C730FF>Pelayan Kafra</color> bisa menteleportasi kamu ke kota yang belum pernah dikunjungi sebelumnya, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question182"]="<color=#F2C730FF>Saat menangkap pet</color>, semakin rendah HP monster, semakin tinggi keberhasilannya, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question183"]="<color=#F2C730FF>Odin's Blessing</color> memberikan reward tambahan, drop monster tidak akan berkurang karena penalty level, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question184"]="Saat <color=#F2C730FF>mengalahkan monster</color> dalam kondisi biasa, drop monster akan berkurang karena penalty level, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question185"]="Membeli <color=#F2C730FF>Change Name Card</color> di dalam game akan bisa membuatmu mengubah nama sendiri, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question186"]="Kamu bisa membuka level Enchant yang lebih tinggi dengan meningkatkan Favor NPC, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question187"]="Kamu hanya bisa menikah dengan pasangan lawan jenis di dalam game, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question187_1"]="Bisa",
    ["OXExam_Question188"]="Automatic Fishing Rod bisa diperoleh dengan menukarkan Fish Print Coin, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question189"]="Skill Sanctuary Priest bisa menghasilkan Damage terhadap Undead dan Demon Race, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question190"]="Ada total 4 peti reward di Activity Carnival, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question190_1"]="Total ada 5",
    ["OXExam_Question191"]="Hanya Jalur Swordsman yang bisa menunggangi mount battle untuk bertempur, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question191_1"]="Job terusan Swordsman dan Ranger bisa",
    ["OXExam_Question192"]="Membuka mulut saat menetes obat mata sehingga mata tidak berkedip, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXExam_Question193"]="Saat mata kelilipan, tutup matamu dan batuk beberapa kali, debunya akan keluar sendiri, benar<color=#64b4ff> (O) </color>atau salah<color=#ff6481> (X)</color>?",
    ["OXMidAutumnQuestion001"]="Festival Kue Bulan berasal dari <color=#F2C730FF>pemujaan terhadap dewa-dewi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion002"]="Festival Kue Bulan pertama kali tercatat dalam <color=#F2C730FF>\"Kitab Ritus Zhou\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion003"]="Festival Kue Bulan ditentukan menjadi festival nasional yang diakui secara resmi pada masa <color=#F2C730FF>Dinasti Sui</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion003_1"]="Ditentukan menjadi festival nasional yang diakui secara resmi pada masa Dinasti Tang",
    ["OXMidAutumnQuestion004"]="Yang dimaksud dalam \"kue kecil dan karamel yang garing dan lembut seperti mengunyah bulan\" adalah <color=#F2C730FF>kue bulan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion005"]="Festival Kue Bulan yang melambangkan reuni dimulai dari <color=#F2C730FF>Dinasti Song Utara</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion005_1"]="Dimulai saat peralihan Dinasti Ming ke Dinasti Qing",
    ["OXMidAutumnQuestion006"]="Selain upacara persembahan kepada bulan, <color=#F2C730FF>Bunga Osmanthus</color> juga merupakan salah satu bagian penting dari Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion007"]="Terdapat tradisi <color=#F2C730FF>menyalakan lentera</color> saat Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion008"]="Yang disebut dengan \"Mengejar Bulan\" adalah mengajak setiap tamu untuk menikmati keindahan bulan <color=#F2C730FF>seminggu</color> setelah Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion008_1"]="\"Mengejar Bulan\" adalah mengajak setiap tamu untuk menikmati keindahan bulan hari berikutnya setelah Festival Kue Bulan",
    ["OXMidAutumnQuestion009"]="Festival Kue Bulan juga memiliki tradisi <color=#F2C730FF>teka-teki lentera</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion010"]="Pada saat Festival Kue Bulan, di Tiongkok bagian tenggara memiliki tradisi <color=#F2C730FF>menyaksikan air laut pasang</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion011"]="Mengikat lentera kertas dengan tiang yang tinggi secara vertikal merupakan tradisi <color=#F2C730FF>teka-teki lentera</color> pada Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion011_1"]="Tradisi ini disebut dengan \"Festival Kue Bulan Vertikal\"",
    ["OXMidAutumnQuestion012"]="\"Permainan Luzi\" merupakan suatu tradisi yang dilakukan oleh <color=#F2C730FF>orang dewasa</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion012_1"]="\"Permainan Luzi\" merupakan kegiatan yang dimainkan oleh anak-anak",
    ["OXMidAutumnQuestion013"]="Lentera yang dinyalakan pada Festival Kue Bulan, jika dibandingkan dengan Festival Lentera memiliki <color=#F2C730FF>skala yang sama</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion013_1"]="Lentera pada Festival Kue Bulan memiliki skala yang jauh lebih kecil jika dibandingkan dengan Festival Lentera",
    ["OXMidAutumnQuestion014"]="<color=#F2C730FF>Tarian Naga Api</color> juga merupakan salah satu tradisi dari Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion015"]="\"Mendengarkan Dupa\" merupakan kegiatan membakar dupa untuk <color=#F2C730FF>mendapatkan petunjuk dari dewa</color> untuk mewujudkan harapan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion015_1"]="\"Mendengarkan Dupa\" merupakan kegiatan membakar dupa sambil mengajukan pertanyaan, kata yang pertama kali terdengar merupakan jawaban dari dewa untuk kita",
    ["OXMidAutumnQuestion016"]="Tradisi \"Membakar Pagoda\" melambangkan <color=#F2C730FF>penyalaan pagoda tinggi</color> pada perayaan Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion016_1"]="\"Membakar Pagoda\" melambangkan penyalaan lampu berbentuk pagoda yang tinggi",
    ["OXMidAutumnQuestion017"]="Wujud Dewa Kelinci merupakan <color=#F2C730FF>Kelinci Giok</color> di Istana Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion018"]="Festival Kue Bulan pada masa Dinasti Ming akan <color=#F2C730FF>menghidangkan sajian kepiting</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion019"]="\"Laki-laki tidak memuja bulan, perempuan tidak memuja dapur\" berarti bahwa <color=#F2C730FF>laki-laki tidak merayakan Festival Kue Bulan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion020"]="Tradisi bermain dengan Dewa Kelinci pada Festival Kue Bulan berasal dari <color=#F2C730FF>Dinasti Qing awal</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion020_1"]="Tradisi ini berasal dari Dinasti Ming akhir",
    ["OXMidAutumnQuestion021"]="Daerah Jiangnan di Tiongkok memiliki kegiatan mengitari jalanan di kota selama Festival Kue Bulan yang disebut <color=#F2C730FF>\"berjalan di bulan\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion022"]="Pada saat Festival Kue Bulan, anak-anak menancapkan dupa pada buah jeruk bali dan menari. Kegiatan ini disebut sebagai \"Tarian Dupa Bola Meteor\" yang berasal dari <color=#F2C730FF>Tiongkok bagian utara</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion022_1"]="Tradisi \"Tarian Dupa Bola Meteor\" berasal dari Sichuan",
    ["OXMidAutumnQuestion023"]="Tradisi \"Bo Bing\" pada saat Festival Kue Bulan yang berasal dari daerah Minnan merupakan salah satu jenis <color=#F2C730FF>permainan dadu</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion024"]="\"Kelompok Tanaman Muda\" merupakan kegiatan penghormatan kepada <color=#F2C730FF>bulan</color> yang dilaksanakan di Tiongkok bagian utara. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion024_1"]="\"Kelompok Tanaman Muda\" merupakan kegiatan penghormatan kepada Dewa Bumi",
    ["OXMidAutumnQuestion025"]="Di beberapa tempat wilayah <color=#F2C730FF>Hebei</color>, Festival Kue Bulan juga disebut sebagai \"Tahun Baru Kecil\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion026"]="Suku Mongolia memiliki tradisi <color=#F2C730FF>\"Mengejar Bulan\"</color>. Penunggang kuda akan terus mengejar bulan sampai terbenam. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion027"]="Tradisi \"Mencari Bulan\" dalam Suku Tibet saat Festival Kue Bulan berhubungan dengan <color=#F2C730FF>bayangan bulan yang terpantul di air</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion028"]="Tradisi \"berjalan di bulan\" dalam suku Dong di Guangxi adalah <color=#F2C730FF>menaiki kuda sambil menikmati keindahan bulan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion028_1"]="Tradisi \"berjalan di bulan\" dilakukan dengan membuat kelompok yang menari sambil menyanyikan lagu berjalan di bulan",
    ["OXMidAutumnQuestion029"]="Tradisi \"Menyeberangi Bulan\" dalam suku minoritas di Yunnan dilakukan pada Festival Kue Bulan dengan cara <color=#F2C730FF>mengunjungi kerabat</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion029_1"]="Tradisi \"Menyeberangi Bulan\" dilakukan oleh remaja untuk saling mencari pasangan",
    ["OXMidAutumnQuestion030"]="Tradisi <color=#F2C730FF>\"Melompati Bulan\"</color> dalam Suku Yi dari Yunnan adalah bernyanyi dan menari di bawah sinar rembulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion031"]="\"Hari Harimau\" dalam Suku Klao adalah sebutan untuk <color=#F2C730FF>Festival Kue Bulan</color>. Mereka akan menyembelih sapi pada hari itu. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion031_1"]="\"Hari Harimau\" adalah beberapa hari sebelum Festival Kue Bulan",
    ["OXMidAutumnQuestion032"]="Pada saat Festival Kue Bulan, Suku Chaoxian akan mempersiapkan \"Bingkai Melihat Bulan\" agar <color=#F2C730FF>anak-anak</color> bisa melihat bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion032_1"]="\"Bingkai Melihat Bulan\" digunakan oleh orang tua untuk melihat bulan",
    ["OXMidAutumnQuestion033"]="Pada saat Festival Kue Bulan, <color=#F2C730FF>Suku Zhuang</color> memiliki tradisi untuk mengundang Dewa Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion034"]="Prosesi mengundang Dewa Bulan oleh Suku Zhuang membutuhkan seorang <color=#F2C730FF>pria</color> sebagai juru bicara. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion034_1"]="Juru bicara sebaiknya memilih seorang wanita",
    ["OXMidAutumnQuestion035"]="Dalam prosesi mengundang Dewa Bulan oleh Suku Zhuang, semua orang akan <color=#F2C730FF>mendengarkan</color> juru bicara Dewa Bulan bernyanyi. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion035_1"]="Ketika mengundang Dewa Bulan, seharusnya semua orang tidak hanya diam mendengarkan, melainkan ikut bernyanyi",
    ["OXMidAutumnQuestion036"]="Dalam prosesi mengundang Dewa Bulan oleh Suku Zhuang, pada bagian akhir <color=#F2C730FF>tidak perlu</color> mengantar Dewa Bulan untuk kembali ke langit. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion036_1"]="Ketika prosesi mengundang Dewa Bulan sudah selesai, maka perlu untuk mengantarkan kepulangan dewa",
    ["OXMidAutumnQuestion037"]="<color=#F2C730FF>Suku Li</color> mengenal Festival Kue Bulan dengan sebutan \"Pertemuan Bulan Delapan\" atau \"Festival Irama Lagu\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion038"]="Dalam kegiatan \"Festival Irama Lagu\" oleh suku Li, ada pemimpin muda pria dan wanita yang disebut sebagai <color=#F2C730FF>\"Kepala Irama Lagu\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion039"]="Dalam \"Pertemuan Bulan Delapan\" oleh suku Li, <color=#F2C730FF>tidak ada</color> tradisi memakan kue bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion039_1"]="Suku Li memiliki tradisi memakan kue bulan",
    ["OXMidAutumnQuestion040"]="Festival Kue Bulan dikenal dengan nama <color=#F2C730FF>\"Chuseok\"</color> di Korea. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion041"]="Dalam bahasa inggris, Festival Kue Bulan disebut dengan <color=#F2C730FF>\"Korean Thanksgiving\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion042"]="Festival Kue Bulan di Vietnam diadakan untuk mengenang seorang legendaris yang disebut <color=#F2C730FF>\"Dewa A Gui\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion043"]="Sosok legendaris \"Dewa A Gui\" di Vietnam adalah <color=#F2C730FF>seorang dewa dengan ilmu pengobatan yang hebat</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion043_1"]="\"Dewa A Gui\" mengobati penyakit manusia dengan Pohon Bodhi, bukan dengan ilmu medis",
    ["OXMidAutumnQuestion044"]="Sosok legendaris \"Dewa A Gui\" di Vietnam naik ke Istana Bulan <color=#F2C730FF>seorang diri</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion044_1"]="Dia dibawa naik ke Istana Bulan oleh Pohon Bodhi",
    ["OXMidAutumnQuestion045"]="Perayaan Festival Kue Bulan di Vietnam <color=#F2C730FF>lebih berkaitan dengan hewan</color>, misalnya barongsai dan lentera ikan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion046"]="Festival Kue Bulan di Jepang juga dikenal sebagai <color=#F2C730FF>\"Perayaan Tanggal Lima Belas Malam\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion047"]="Festival Kue Bulan di Jepang juga dikenal dengan <color=#F2C730FF>\"Talas Terang Bulan\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion048"]="Festival Kue Bulan di Jepang memiliki tradisi <color=#F2C730FF>memakan kue bulan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion048_1"]="Festival Kue Bulan di Jepang menikmati hidangan Tsukimi",
    ["OXMidAutumnQuestion049"]="Kegiatan menikmati keindahan bulan di Jepang dikenal dengan <color=#F2C730FF>\"Tsukimi\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion050"]="Dalam kegiatan menikmati keindahan bulan saat Festival Kue Bulan di Jepang, akan terdapat hidangan pangsit beserta pajangan tanaman Miscanthus dan benda-benda lainnya <color=#F2C730FF>di dalam rumah</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion051"]="Festival Kue Bulan merupakan acara kegiatan yang sangat penting di <color=#F2C730FF>Malaysia</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion052"]="Kisah Chang E memakan obat dewa dan kemudian terbang ke langit menjadi dewa merupakan kisah <color=#F2C730FF>yang muncul paling awal</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion052_1"]="Kisah Chang E memakan obat dewa dan terbang ke langit merupakan hasil akhir setelah dilakukan perubahan dan adaptasi cerita",
    ["OXMidAutumnQuestion053"]="Kisah Kelinci Giok meracik obat pertama kali ditemukan dalam puisi Qu Yuan yang berjudul <color=#F2C730FF>\"Pertanyaan Surgawi\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion054"]="Dalam kisah legenda, Kelinci Giok merupakan peliharaan <color=#F2C730FF>Chang E</color> yang ikut dibawa olehnya saat naik ke Istana Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion055"]="Dalam mitologi apa pun, dikisahkan bahwa Kelinci Giok meracik <color=#F2C730FF>\"Ramuan Panjang Umur\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion055_1"]="Dalam kisah legenda Jepang, yang dilakukan Kelinci Giok adalah membuat kue bakul",
    ["OXMidAutumnQuestion056"]="Kisah <color=#F2C730FF>\"Lamunan di Istana Bulan\"</color> dari Kaisar XuanZong memiliki kaitan dengan lagu terkenal berjudul \"Tarian Pakaian Pelangi dan Bulu\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion057"]="Kue bulan pernah digunakan untuk menyampaikan informasi tentang pemberontakan di <color=#F2C730FF>Dinasti Yuan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion058"]="Peribahasa: Bulan pada bulan 8 tanggal 15 -- <color=#F2C730FF>jujur</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion058_1"]="Bulan pada bulan 8 tanggal 15 -- sangat besar",
    ["OXMidAutumnQuestion059"]="Peribahasa: Makan kue bakul pada bulan 8 tanggal 15 -- <color=#F2C730FF>sangat cocok</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion059_1"]="Makan kue bakul pada bulan 8 tanggal 15 -- terlalu awal",
    ["OXMidAutumnQuestion060"]="Peribahasa: Melihat lentera pada bulan 8 tanggal 15 -- <color=#F2C730FF>tidak berbeda jauh</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion060_1"]="Melihat lentera pada bulan 8 tanggal 15 -- terlambat setengah tahun",
    ["OXMidAutumnQuestion061"]="Peribahasa: Tahun baru pada bulan 8 tanggal 15 -- <color=#F2C730FF>dijadwalkan lebih cepat</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion061_1"]="Tahun baru pada bulan 8 tanggal 15 -- salah jadwal",
    ["OXMidAutumnQuestion062"]="Terdapat tradisi curi-curi makan di beberapa tempat saat Festival Kue Bulan. Semakin banyak <color=#F2C730FF>pencuri makan tertangkap</color>, semakin bahagia tuan rumahnya. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion062_1"]="Dalam tradisi curi-curi makanan saat Festival Kue Bulan, semakin banyak makanan yang dicuri, tuan rumah akan semakin bahagia",
    ["OXMidAutumnQuestion063"]="Perayaan \"Merebus Lilin\" yang dilakukan dengan menyebarkan cairan lilin, masih menjadi tradisi Festival Kue Bulan yang terkenal hingga <color=#F2C730FF>sekarang</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion063_1"]="Tradisi \"Merebus Lilin\" sejak abad sebelumnya telah dilarang dikarenakan alasan keamanan",
    ["OXMidAutumnQuestion064"]="Pada malam Festival Kue Bulan di semenanjung Chaoxian, selain merayakan hasil panen di musim gugur, juga turut <color=#F2C730FF>memperingati kemenangan atas Kerajaan Balhae</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion065"]="\"Ganggangsullae\" adalah suatu jenis tarian rakyat untuk merayakan <color=#F2C730FF>Festival Perahu Naga</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion065_1"]="\"Ganggangsullae\" adalah tarian untuk merayakan Festival Kue Bulan",
    ["OXMidAutumnQuestion066"]="Selain dilakukan pada saat Festival Kue Bulan, \"Melihat Bulan\" juga mengacu pada <color=#F2C730FF>bulan 9 tanggal 13</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion067"]="Festival Kue Bulan juga disebut sebagai <color=#F2C730FF>\"Kelahiran Cahaya Bulan\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion068"]="Tradisi memuja Dewa Yue Lao bagi pria dan wanita lajang untuk menemukan jodoh disebut sebagai <color=#F2C730FF>\"Memohon Bulan\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion069"]="Mengamati air laut pasang juga merupakan tradisi yang besar, terutama bagi mereka yang berkumpul di <color=#F2C730FF>sepanjang pesisir utara</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion069_1"]="Tradisi mengamati air laut pasang lebih terfokus di daerah Zhejiang",
    ["OXMidAutumnQuestion070"]="\"Memandang Bulan\" merupakan permohonan atas pernikahan yang baik. Tradisi ini dilakukan dengan cara mandi di bawah sinar rembulan yang dilakukan oleh <color=#F2C730FF>wanita lajang</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion070_1"]="Tradisi \"Memandang Bulan\" dilakukan oleh wanita yang sudah menikah dan ingin mendapatkan keturunan",
    ["OXMidAutumnQuestion071"]="Tradisi membakar dupa bertingkat adalah tradisi saat Festival Kue Bulan yang berasal dari daerah <color=#F2C730FF>Jiangsu di Tiongkok</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion072"]="Tradisi <color=#F2C730FF>\"Mencuri Sayuran Bulan\"</color> pada Festival Kue Bulan dilakukan oleh wanita muda dengan mencuri sayuran di malam hari yang melambangkan harapan mendapatkan jodoh pernikahan yang baik. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion073"]="Melemparkan sapu tangan untuk menemukan pasangan berasal dari daerah Fujian di Tiongkok. Sapu tangan dilempar oleh wanita yang belum menikah untuk menemukan pasangan dengan <color=#F2C730FF>menyamar sebagai Chang E</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion074"]="Wu Gang yang kesehariannya memotong Pohon Osmanthus, <color=#F2C730FF>berasal</color> dari bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion074_1"]="Wu Kang dihukum di Istana Bulan",
    ["OXMidAutumnQuestion075"]="Suku Tu memiliki tradisi <color=#F2C730FF>\"Memukul Bulan\"</color>. Mereka memantulkan bulan dengan air dan memukulnya dengan batu. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion076"]="Yang dimaksud dengan Dewa Kelinci adalah <color=#F2C730FF>Kelinci Giok</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion077"]="Tarian naga pada Festival Kue Bulan berasal dari legenda <color=#F2C730FF>Ular Piton</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion078"]="Dewa Kelinci dipercaya Chang E datang ke dunia untuk mengobati penyakit dan <color=#F2C730FF>menerima pembayaran</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion078_1"]="Dewa Kelinci tidak mengharapkan imbalan, tetapi hanya meminjam pakaian",
    ["OXMidAutumnQuestion079"]="Tradisi membakar pagoda ketika Festival Kue Bulan berasal dari <color=#F2C730FF>pemberontakan petani</color> terdahulu. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion080"]="Pada saat Festival Kue Bulan di Ryukyu, <color=#F2C730FF>orang-orang memakan kue bulan dan mempersembahkan Fuchagi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion080_1"]="Keduanya boleh dimakan atau dipersembahkan",
    ["OXMidAutumnQuestion081"]="Festival Kue Bulan tidak hanya untuk menghormati bulan, tetapi juga menghormati bumi sebagai <color=#F2C730FF>peringatan terhadap hari panen</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion082"]="Menanam gandum di bulan 8 tanggal 15 -- <color=#F2C730FF>harus bergegas</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion082_1"]="Menanam gandum di bulan 8 tanggal 15 -- terlalu awal",
    ["OXMidAutumnQuestion083"]="</color>Cuaca saat pertengahan musim gugur -- <color=#F2C730FF>lembut dan menyenangkan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion083_1"]="Cuaca saat pertengahan musim gugur -- tidak dingin atau panas",
    ["OXMidAutumnQuestion084"]="Menyimpan penggiling di bulan 8 tanggal 15 -- <color=#F2C730FF>keterlaluan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion084_1"]="Menyimpan penggiling di bulan 8 tanggal 15 -- lebih awal",
    ["OXMidAutumnQuestion085"]="Makan pangsit di bulan 8 tanggal 15 -- <color=#F2C730FF>keterlaluan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion085_1"]="Makan pangsit di bulan 8 tanggal 15 -- melanggar peraturan",
    ["OXMidAutumnQuestion086"]="Memukul kelinci di bulan 8 tanggal 15 -- <color=#F2C730FF>pemberontakan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion086_1"]="Memukul kelinci di bulan 8 tanggal 15 -- melakukan kesalahan",
    ["OXMidAutumnQuestion087"]="Menanam kacang tanah di bulan 8 tanggal 15 -- <color=#F2C730FF>tepat pada waktunya</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion087_1"]="Menanam kacang tanah di bulan 8 tanggal 15 -- perintah yang membingungkan",
    ["OXMidAutumnQuestion088"]="Berdiri di tepi sungai untuk menangkap bulan -- <color=#F2C730FF>kerja keras</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion088_1"]="Berdiri di tepi sungai untuk menangkap bulan -- tidak berguna",
    ["OXMidAutumnQuestion089"]="Bulan mengejar matahari -- <color=#F2C730FF>tidak bisa</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion089_1"]="Bulan mengejar matahari -- tidak pernah bertemu",
    ["OXMidAutumnQuestion090"]="Awan menutupi bulan di bulan 8 tanggal 15 -- <color=#F2C730FF>gelap tanpa cahaya</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion090_1"]="Awan menutupi bulan di bulan 8 tanggal 15 -- mengecewakan",
    ["OXMidAutumnQuestion091"]="Menghadap ke api di bulan 8 tanggal 15 -- <color=#F2C730FF>gelisah</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion091_1"]="Menghadap ke api di bulan 8 tanggal 15 -- perlahan-lahan menjadi dingin",
    ["OXMidAutumnQuestion092"]="Menanam kacang polong di bulan 8 tanggal 15 -- <color=#F2C730FF>harus bergegas</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion092_1"]="Menanam kacang polong di bulan 8 tanggal 15 -- terlambat panen",
    ["OXMidAutumnQuestion093"]="Kue reuni di bulan 8 tanggal 15 -- <color=#F2C730FF>saling berbagi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion093_1"]="Kue reuni di bulan 8 tanggal 15 -- tidak untuk orang luar",
    ["OXMidAutumnQuestion094"]="Chang E menggunakan gunting -- <color=#F2C730FF>tidak berperasaan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion094_1"]="Chang E menggunakan gunting -- berbakat",
    ["OXMidAutumnQuestion095"]="Memukul bulan dengan tiang bambu -- <color=#F2C730FF>sangat berani</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion095_1"]="Memukul bulan dengan tiang bambu -- tidak masuk akal",
    ["OXMidAutumnQuestion096"]="Matahari berbicara dengan bulan -- <color=#F2C730FF>suara yang keras</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion096_1"]="Matahari berbicara dengan bulan -- omong kosong",
    ["OXMidAutumnQuestion097"]="Anjing gila menggigit bulan -- <color=#F2C730FF>nafsu makan besar</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion097_1"]="Anjing gila menggigit bulan -- sombong",
    ["OXMidAutumnQuestion098"]="Seorang botak mengejar bulan -- <color=#F2C730FF>keduanya saling menarik</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion098_1"]="Seorang botak mengejar bulan -- mendapatkan manfaat",
    ["OXMidAutumnQuestion099"]="Menyalakan lampu di bawah bulan -- <color=#F2C730FF>saling menerangi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion099_1"]="Menyalakan lampu di bawah bulan -- melakukan hal tidak berguna",
    ["OXMidAutumnQuestion100"]="Bermain pedang lengkung di bawah bulan -- <color=#F2C730FF>memamerkan kemampuan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion100_1"]="Menghalangi pandangan",
    ["OXMidAutumnQuestion101"]="Festival Kue Bulan bermula dari <color=#F2C730FF>penghormatan terhadap karakter manusia</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion101_1"]="Festival Kue Bulan berasal dari pemujaan terhadap dewa-dewi",
    ["OXMidAutumnQuestion102"]="Festival Kue Bulan pertama kali tercatat dalam <color=#F2C730FF>\"Kitab Tafsiran Zuo\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion102_1"]="Festival Kue Bulan pertama kali tercatat dalam \"Kitab Ritus Zhou\"",
    ["OXMidAutumnQuestion103"]="Festival Kue Bulan ditentukan menjadi festival nasional yang diakui secara resmi pada masa <color=#F2C730FF>Dinasti Tang</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion104"]="Yang dimaksud dalam \"kue kecil dan karamel yang garing dan lembut seperti mengunyah bulan\" adalah <color=#F2C730FF>bacang</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion104_1"]="Kue bulan yang disebutkan adalah \"kue kecil dari karamel yang garing dan lembut seperti mengunyah bulan\"",
    ["OXMidAutumnQuestion105"]="Festival Kue Bulan yang melambangkan reuni dimulai saat peralihan <color=#F2C730FF>Dinasti Ming ke Dinasti Qing</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion106"]="Selain upacara persembahan kepada bulan, <color=#F2C730FF>Bunga Persik</color> juga merupakan salah satu bagian penting dari Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion106_1"]="Selain upacara persembahan kepada bulan, Bunga Osmanthus juga merupakan salah satu bagian penting dari Festival Kue Bulan",
    ["OXMidAutumnQuestion107"]="<color=#F2C730FF>Tidak terdapat</color> tradisi menyalakan lentera saat Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion107_1"]="Festival Kue Bulan memiliki tradisi menyalakan lentera",
    ["OXMidAutumnQuestion108"]="Yang disebut dengan \"Mengejar Bulan\" adalah mengajak setiap tamu untuk menikmati keindahan bulan <color=#F2C730FF>di hari berikutnya</color> setelah Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion109"]="Festival Kue Bulan <color=#F2C730FF>tidak memiliki</color> tradisi teka-teki lentera. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion109_1"]="Festival Kue Bulan memiliki tradisi menebak teka-teki lentera",
    ["OXMidAutumnQuestion110"]="Pada saat Festival Kue Bulan, di Tiongkok <color=#F2C730FF>bagian barat laut</color> memiliki tradisi menyaksikan air laut pasang. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion110_1"]="Pada saat Festival Kue Bulan, di Tiongkok bagian tenggara memiliki tradisi menyaksikan air laut pasang",
    ["OXMidAutumnQuestion111"]="Mengikat lentera kertas dengan tiang yang tinggi secara vertikal saat Festival Kue Bulan dikenal juga dengan sebutan <color=#F2C730FF>\"Festival Kue Bulan Vertikal\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion112"]="\"Permainan Luzi\" merupakan suatu tradisi yang dilakukan oleh <color=#F2C730FF>anak-anak</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion113"]="Festival Kue Bulan memiliki lentera yang <color=#F2C730FF>skalanya jauh lebih kecil dibandingkan Festival Lentera</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion114"]="Tarian Naga Api <color=#F2C730FF>bukan</color> merupakan salah satu tradisi dari Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion114_1"]="Pada saat Festival Kue Bulan, di daerah selatan terdapat tradisi Tarian Naga Api",
    ["OXMidAutumnQuestion115"]="\"Mendengarkan Dupa\" merupakan kegiatan <color=#F2C730FF>membakar dupa sambil mengajukan pertanyaan</color>, kata yang pertama kali terdengar merupakan jawaban atas pertanyaan tersebut. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion116"]="Tradisi \"Membakar Pagoda\" melambangkan penyalaan <color=#F2C730FF>lampu berbentuk pagoda tinggi</color> pada perayaan Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion117"]="Wujud Dewa Kelinci merupakan <color=#F2C730FF>Chang E</color> di Istana Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion117_1"]="Wujud Dewa Kelinci merupakan Kelinci Giok",
    ["OXMidAutumnQuestion118"]="Festival Kue Bulan pada masa Dinasti Ming <color=#F2C730FF>dilarang menghidangkan sajian kepiting</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion118_1"]="Festival Kue Bulan pada masa Dinasti Ming akan menghidangkan sajian kepiting",
    ["OXMidAutumnQuestion119"]="\"Laki-laki tidak memuja bulan, perempuan tidak memuja dapur\" berarti bahwa <color=#F2C730FF>perempuan</color> tidak merayakan Festival Kue Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion119_1"]="\"Laki-laki tidak memuja bulan, perempuan tidak memuja dapur\" berarti bahwa laki-laki tidak merayakan Festival Kue Bulan",
    ["OXMidAutumnQuestion120"]="Tradisi bermain dengan Dewa Kelinci pada Festival Kue Bulan berasal dari <color=#F2C730FF>Dinasti Ming akhir</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion121"]="Daerah Jiangnan di Tiongkok memiliki kegiatan mengitari jalanan di kota selama Festival Kue Bulan yang disebut <color=#F2C730FF>\"mengejar bulan\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion121_1"]="Tradisi ini disebut \"berjalan di bulan\"",
    ["OXMidAutumnQuestion122"]="Pada saat Festival Kue Bulan, anak-anak menancapkan dupa pada jeruk bali dan menari. Kegiatan ini disebut sebagai \"Tarian Dupa Bola Meteor\" yang berasal dari daerah <color=#F2C730FF>Sichuan di Tiongkok</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion123"]="Tradisi \"Bo Bing\" pada saat Festival Kue Bulan yang berasal dari daerah Minnan merupakan salah satu jenis <color=#F2C730FF>permainan kartu</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion123_1"]="\"Bo Bing\" adalah permainan dadu",
    ["OXMidAutumnQuestion124"]="\"Kelompok Tanaman Muda\" merupakan kegiatan penghormatan kepada <color=#F2C730FF>Dewa Bumi</color> yang dilaksanakan di Tiongkok bagian utara. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion125"]="Di beberapa tempat wilayah Hebei, Festival Kue Bulan juga disebut sebagai <color=#F2C730FF>\"Tahun Baru Besar\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion125_1"]="Di beberapa tempat wilayah Hebei menyebut Festival Kue Bulan sebagai \"Tahun Baru Kecil\"",
    ["OXMidAutumnQuestion126"]="<color=#F2C730FF>Suku Uyghurs</color> memiliki tradisi \"Mengejar Bulan\". Penunggang kuda akan terus mengejar bulan sampai terbenam. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion126_1"]="Suku Mongolia memiliki tradisi \"Mengejar Bulan\"",
    ["OXMidAutumnQuestion127"]="Tradisi \"Mencari Bulan\" dalam suku Tibet saat Festival Kue Bulan berhubungan dengan <color=#F2C730FF>sosok bulan di langit</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion127_1"]="Tradisi \"Mencari Bulan\" dalam suku Tibet saat Festival Kue Bulan berhubungan dengan sosok bulan di langit",
    ["OXMidAutumnQuestion128"]="Tradisi \"berjalan di bulan\" dalam suku Dong di Guangxi adalah <color=#F2C730FF>membuat kelompok yang menari sambil menyanyikan lagu</color> \"berjalan di bulan\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion129"]="Tradisi \"Menyeberangi Bulan\" dalam suku minoritas di Yunnan <color=#F2C730FF>dilakukan oleh remaja</color> pada Festival Kue Bulan untuk mencari pasangan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion130"]="Tradisi \"Melompati Bulan\" dalam <color=#F2C730FF>Suku Chaoxian</color> adalah bernyanyi dan menari di bawah sinar rembulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion130_1"]="Tradisi \"Melompati Bulan\" berasal dari suku Yi",
    ["OXMidAutumnQuestion131"]="\"Hari Harimau\" dalam Suku Klao adalah sebutan untuk <color=#F2C730FF>beberapa hari sebelum Festival Kue Bulan</color>. Mereka akan menyembelih sapi pada hari itu sebagai persiapan menyambut hari perayaan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion132"]="Pada saat Festival Kue Bulan, Suku Chaoxian akan mempersiapkan \"Bingkai Melihat Bulan\" agar <color=#F2C730FF>orang tua</color> bisa melihat bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion133"]="Pada saat Festival Kue Bulan, Suku Zhuang memiliki tradisi untuk mengundang <color=#F2C730FF>Dewa Matahari</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion133_1"]="Suku Zhuang mengundang Dewa Bulan pada saat Festival Kue Bulan",
    ["OXMidAutumnQuestion134"]="Prosesi mengundang Dewa Bulan oleh Suku Zhuang membutuhkan seorang <color=#F2C730FF>wanita</color> sebagai juru bicara. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion135"]="Dalam prosesi mengundang Dewa Bulan oleh Suku Zhuang, semua orang akan <color=#F2C730FF>bernyanyi bersama</color> juru bicara Dewa Bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion136"]="Dalam prosesi mengundang Dewa Bulan oleh Suku Zhuang, pada bagian akhir <color=#F2C730FF>harus</color> mengantar Dewa Bulan untuk kembali ke langit. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion137"]="<color=#F2C730FF>Suku Zhuang</color> mengenal Festival Kue Bulan dengan sebutan \"Pertemuan Bulan Delapan\" atau \"Festival Irama Lagu\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion137_1"]="Dua nama yang berbeda tersebut adalah cara penyebutan dari suku Li",
    ["OXMidAutumnQuestion138"]="Dalam kegiatan \"Festival Irama Lagu\" oleh suku Li, ada <color=#F2C730FF>pemimpin tua pria dan wanita</color> yang disebut sebagai \"Kepala Irama Lagu\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion138_1"]="Dalam kegiatan Festival Irama Lagu, pemimpin yang disebut sebagai \"Kepala Irama Lagu\" adalah seorang muda",
    ["OXMidAutumnQuestion139"]="Dalam \"Pertemuan Bulan Delapan\" oleh suku Li, juga terdapat tradisi <color=#F2C730FF>memakan kue bulan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion140"]="Festival Kue Bulan dikenal dengan nama \"Chuseok\" di <color=#F2C730FF>Jepang</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion140_1"]="\"Chuseok\" merupakan sebutan Festival Kue Bulan di Korea",
    ["OXMidAutumnQuestion141"]="Dalam bahasa inggris, Festival Kue Bulan disebut dengan <color=#F2C730FF>\"Korean Easter\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion141_1"]="Dalam bahasa inggris, Festival Kue Bulan disebut sebagai \"Korean Thanksgiving\"",
    ["OXMidAutumnQuestion142"]="Festival Kue Bulan di <color=#F2C730FF>Filipina</color> diadakan untuk mengenang seorang legendaris yang disebut \"Dewa A Gui\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion142_1"]="Festival Kue Bulan yang diadakan di Vietnam adalah untuk mengenang \"Dewa A Gui\"",
    ["OXMidAutumnQuestion143"]="Sosok legendaris \"Dewa A Gui\" mengobati penyakit manusia dengan menggunakan <color=#F2C730FF>Pohon Bodhi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion144"]="Sosok legendaris \"Dewa A Gui\" di Vietnam dibawa naik ke Istana Bulan oleh <color=#F2C730FF>Pohon Bodhi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion145"]="Perayaan Festival Kue Bulan di <color=#F2C730FF>Jepang</color> lebih berkaitan dengan hewan, misalnya barongsai dan lentera ikan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion145_1"]="Kegiatan perayaan Festival Kue Bulan di Vietnam memiliki kaitan dengan hewan",
    ["OXMidAutumnQuestion146"]="Festival Kue Bulan di Jepang juga dikenal sebagai <color=#F2C730FF>\"Perayaan Tanggal Enam Belas Malam\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion146_1"]="Festival Kue Bulan di Jepang juga disebut sebagai \"Perayaan Tanggal Lima Belas Malam\"",
    ["OXMidAutumnQuestion147"]="Festival Kue Bulan di Jepang juga dikenal dengan <color=#F2C730FF>\"Talas Bulan\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion147_1"]="Festival Kue Bulan di Jepang juga disebut \"Talas Terang Bulan\"",
    ["OXMidAutumnQuestion148"]="Festival Kue Bulan di Jepang memiliki tradisi memakan <color=#F2C730FF>Tsukimi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion149"]="Kegiatan menikmati keindahan bulan di <color=#F2C730FF>Korea</color> dikenal dengan \"Tsukimi\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion149_1"]="\"Tsukimi\" merupakan kegiatan menikmati keindahan bulan di Jepang",
    ["OXMidAutumnQuestion150"]="Dalam kegiatan menikmati keindahan bulan saat Festival Kue Bulan di Jepang, akan terdapat hidangan pangsit beserta pajangan tanaman Miscanthus dan benda-benda lainnya di <color=#F2C730FF>teras rumah</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion150_1"]="Dalam kegiatan menikmati keindahan bulan, semua hidangan dan perlengkapan diletakkan di dalam rumah",
    ["OXMidAutumnQuestion151"]="Festival Kue Bulan di Malaysia adalah kegiatan yang <color=#F2C730FF>diadaptasi dari budaya luar</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion151_1"]="Festival Kue Bulan merupakan acara kegiatan yang sangat penting di Malaysia",
    ["OXMidAutumnQuestion152"]="Kisah Chang E memakan obat dewa dan terbang ke langit menjadi dewa adalah kisah yang diteruskan turun-temurun dan telah melalui proses <color=#F2C730FF>adaptasi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion153"]="Kisah Kelinci Giok meracik obat pertama kali ditemukan dalam puisi Qu Yuan yang berjudul <color=#F2C730FF>\"Menghadapi Kesedihan\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion153_1"]="Kisah Kelinci Giok meracik obat pertama kali ditemukan dalam puisi Qu Yuan yang berjudul \"Pertanyaan Surgawi\"",
    ["OXMidAutumnQuestion154"]="Dalam kisah legenda, Kelinci Giok dan Chang E naik ke Istana Bulan secara masing-masing dan dua kisah ini <color=#F2C730FF>tidak saling berhubungan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion154_1"]="Kelinci Giok merupakan peliharaan Chang E yang ikut dibawa olehnya saat naik ke Istana Bulan",
    ["OXMidAutumnQuestion155"]="Dalam <color=#F2C730FF>mitologi Jepang</color>, Kelinci Giok tidak membuat \"Ramuan Panjang Umur\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion156"]="Kisah \"Lamunan di Istana Bulan\" dari <color=#F2C730FF>Kaisar XuanZong</color> memiliki kaitan dengan lagu terkenal berjudul \"Tarian Pakaian Pelangi dan Bulu\". Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion157"]="Kue bulan pernah digunakan untuk menyampaikan informasi tentang pemberontakan di <color=#F2C730FF>Dinasti Song</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion157_1"]="Kue bulan pernah digunakan untuk menyampaikan informasi tentang pemberontakan di Dinasti Yuan",
    ["OXMidAutumnQuestion158"]="Peribahasa: Bulan pada bulan 8 tanggal 15 -- <color=#F2C730FF>sangat besar</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion159"]="Peribahasa: Makan kue bakul pada bulan 8 tanggal 15 -- <color=#F2C730FF>terlalu awal</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion160"]="Peribahasa: Melihat lentera pada bulan 8 tanggal 15 -- <color=#F2C730FF>terlambat setengah tahun</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion161"]="Peribahasa: Tahun baru pada bulan 8 tanggal 15 -- <color=#F2C730FF>salah jadwal</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion162"]="Terdapat tradisi curi-curi makan di beberapa tempat saat Festival Kue Bulan. Semakin banyak <color=#F2C730FF>makanan yang dicuri</color>, semakin bahagia tuan rumahnya. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion163"]="Perayaan \"Merebus Lilin\" yang dilakukan dengan menyebarkan cairan lilin, <color=#F2C730FF>sekarang sudah dilarang</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion164"]="Pada malam Festival Kue Bulan di semenanjung Chaoxian, <color=#F2C730FF>hanya untuk merayakan hasil panen di musim gugur</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion164_1"]="Selain merayakan hasil panen di musim gugur, malam Festival Kue Bulan di semenanjung Chaoxian juga turut memperingati kemenangan atas Kerajaan Balhae",
    ["OXMidAutumnQuestion165"]="\"Ganggangsullae\" adalah suatu jenis tarian rakyat untuk merayakan <color=#F2C730FF>Festival Kue Bulan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion166"]="Selain dilakukan pada saat Festival Kue Bulan, \"Melihat Bulan\" juga mengacu pada <color=#F2C730FF>bulan 10 tanggal 13</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion166_1"]="Selain dilakukan pada saat Festival Kue Bulan, \"Melihat Bulan\" juga mengacu pada bulan 9 tanggal 13",
    ["OXMidAutumnQuestion167"]="Festival Kue Bulan juga disebut sebagai <color=#F2C730FF>\"Kelahiran Cahaya Matahari\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion167_1"]="Festival Kue Bulan juga disebut sebagai \"Kelahiran Cahaya Bulan\".",
    ["OXMidAutumnQuestion168"]="Tradisi memuja Dewa Yue Lao bagi pria dan wanita lajang untuk menemukan jodoh disebut sebagai <color=#F2C730FF>\"Memandang Bulan\"</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion168_1"]="Kegiatan ini disebut dengan \"Memohon Bulan\"",
    ["OXMidAutumnQuestion169"]="Mengamati air laut pasang juga merupakan tradisi yang besar, terutama bagi mereka yang berkumpul di daerah <color=#F2C730FF>Zhejiang</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion170"]="\"Memandang Bulan\" merupakan permohonan untuk mendapatkan kehamilan. Tradisi ini dilakukan dengan cara mandi di bawah sinar rembulan yang dilakukan oleh <color=#F2C730FF>wanita yang belum mendapatkan keturunan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion171"]="Tradisi membakar dupa bertingkat adalah tradisi saat Festival Kue Bulan yang berasal dari <color=#F2C730FF>daerah utara di Tiongkok</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion171_1"]="Tradisi membakar dupa bertingkat berasal dari daerah Jiangsu di Tiongkok",
    ["OXMidAutumnQuestion172"]="Tradisi \"Mencuri Sayuran Bulan\" pada Festival Kue Bulan dilakukan oleh wanita muda dengan mencuri sayuran di malam hari yang melambangkan <color=#F2C730FF>harapan mendapatkan kekayaan dan harta</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion172_1"]="Tradisi \"Mencuri Sayuran Bulan\" dilakukan dengan harapan mendapatkan jodoh pernikahan yang baik",
    ["OXMidAutumnQuestion173"]="Melemparkan sapu tangan untuk menemukan pasangan berasal dari daerah Fujian di Tiongkok. Sapu tangan dilempar oleh wanita yang belum menikah untuk menemukan pasangan dengan menyamar sebagai <color=#F2C730FF>Kelinci Giok</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion173_1"]="Melemparkan sapu tangan untuk menemukan pasangan berasal dari daerah Fujian di Tiongkok, dilakukan oleh wanita yang belum menikah dengan menyamar sebagai Chang E",
    ["OXMidAutumnQuestion174"]="Wu Gang yang kesehariannya memotong Pohon Osmanthus, <color=#F2C730FF>dihukum</color> tetap tinggal di bulan. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion175"]="<color=#F2C730FF>Suku Tibet</color> memiliki tradisi \"Memukul Bulan\". Mereka memantulkan bulan dengan air dan memukulnya dengan batu. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion175_1"]="Tradisi \"Memukul Bulan\" berasal dari suku Tu",
    ["OXMidAutumnQuestion176"]="Dewa Kelinci dan Kelinci Giok adalah dua sosok yang <color=#F2C730FF>berbeda</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion176_1"]="Yang dimaksud dengan Dewa Kelinci adalah Kelinci Giok",
    ["OXMidAutumnQuestion177"]="Tarian naga pada Festival Kue Bulan berasal dari legenda <color=#F2C730FF>naga bersisik</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion177_1"]="Tradisi tarian naga pada Festival Kue Bulan berasal dari legenda Ular Piton.",
    ["OXMidAutumnQuestion178"]="Dewa Kelinci dipercaya Chang E datang ke dunia untuk mengobati penyakit <color=#F2C730FF>tanpa mengharapkan imbalan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion179"]="Tradisi membakar pagoda ketika Festival Kue Bulan berasal dari tindakan <color=#F2C730FF>kudeta</color> terdahulu. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion179_1"]="Tradisi membakar pagoda ketika Festival Kue Bulan berasal dari pemberontakan petani terdahulu",
    ["OXMidAutumnQuestion180"]="Pada saat Festival Kue Bulan di Ryukyu, kue bulan dan Fuchagi <color=#F2C730FF>boleh dimakan atau dipersembahkan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion181"]="Festival Kue Bulan dilakukan untuk menghormati bulan dan merupakan salah satu jenis <color=#F2C730FF>Festival Astronomi</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion181_1"]="Festival Kue Bulan tidak hanya untuk menghormati bulan, tetapi juga menghormati bumi sebagai peringatan terhadap hari panen",
    ["OXMidAutumnQuestion182"]="Menanam gandum di bulan 8 tanggal 15 -- <color=#F2C730FF>terlalu awal</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion183"]="Cuaca saat pertengahan musim gugur -- <color=#F2C730FF>tidak dingin atau panas</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion184"]="Menyimpan penggiling di bulan 8 tanggal 15 -- <color=#F2C730FF>lebih awal</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion185"]="Makan pangsit di bulan 8 tanggal 15 -- <color=#F2C730FF>melanggar peraturan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion186"]="Memukul kelinci di bulan 8 tanggal 15 -- <color=#F2C730FF>melakukan kesalahan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion187"]="Menanam kacang tanah di bulan 8 tanggal 15 -- <color=#F2C730FF>perintah yang membingungkan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion188"]="Berdiri di tepi sungai untuk menangkap bulan -- <color=#F2C730FF>tidak berguna</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion189"]="Bulan mengejar matahari -- <color=#F2C730FF>tidak pernah bertemu</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion190"]="Awan menutupi bulan di bulan 8 tanggal 15 -- <color=#F2C730FF>mengecewakan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion191"]="Menghadap ke api di bulan 8 tanggal 15 -- <color=#F2C730FF>perlahan-lahan menjadi dingin</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion192"]="Menanam kacang polong di bulan 8 tanggal 15 -- <color=#F2C730FF>terlambat panen</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion193"]="Kue reuni di bulan 8 tanggal 15 -- <color=#F2C730FF>tidak untuk orang luar</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion194"]="Chang E menggunakan gunting -- <color=#F2C730FF>berbakat</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion195"]="Memukul bulan dengan tiang bambu -- <color=#F2C730FF>tidak masuk akal</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion196"]="Matahari berbicara dengan bulan -- <color=#F2C730FF>omong kosong</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion197"]="Anjing gila menggigit bulan -- <color=#F2C730FF>sombong</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion198"]="Seorang botak mengejar bulan -- <color=#F2C730FF>mendapatkan manfaat</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion199"]="Menyalakan lampu di bawah bulan -- <color=#F2C730FF>melakukan hal tidak berguna</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion200"]="Bermain pedang lengkung di bawah bulan -- <color=#F2C730FF>menghalangi pandangan</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
