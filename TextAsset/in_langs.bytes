    ["DialogueBubble662491199"]="O\nS",
    ["DialogueBubble662491200"]="Selanjutnya, aku akan mulai putarkan telegramnya, perhatikan!",
    ["DialogueBubble662491201"]="A\nJ",
    ["DialogueBubble662491202"]="AD",
    ["DialogueBubble662491203"]="x/2-√ (4x) =-2",
    ["DialogueBubble662491204"]="C\nO",
    ["DialogueBubble662491205"]="I\nA",
    ["DialogueBubble662491206"]="T22",
    ["DialogueBubble662491207"]="FX",
    ["DialogueBubble662491208"]="Z",
