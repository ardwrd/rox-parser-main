    ["ui_FNS_013"]="Refresh setiap hari",
    ["ui_FNS_014"]="Reward Partisipasi Setiap Hari",
    ["ui_FNS_015"]="Tidak ada reward",
    ["ui_FNS_016"]="Nilai Penyelesaian",
