    ["OXExam_Question023_1"]="VIT yang memengaruhi Max HP.",
    ["OXExam_Question024"]="Bertambahnya <color=#F2C730FF>DEX</color> dapat meningkatkan Haste, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question025"]="Bertambahnya <color=#F2C730FF>DEX</color> dapat meningkatkan Hit, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question026"]="Bertambahnya <color=#F2C730FF>DEX</color> dapat meningkatkan Movement Speed, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question026_1"]="Mount yang memengaruhi Movement Speed.",
    ["OXExam_Question027"]="Meningkatkan <color=#F2C730FF>LUK</color> dapat meningkatkan Crit dan Anti-Crit, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
