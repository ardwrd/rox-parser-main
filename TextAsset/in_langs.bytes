    ["LeaseShopUnlocktips"]="Berhasil Membuka Item",
    ["LeaseShop_001"]="Butuh Lv.3 Favor Kafra",
    ["LeaseShop_UIInfo_001"]="Kamu membutuhkan <color=#d14d75>%s</color>",
    ["LeaseShop_UIInfo_002"]="Perlu <color=#d14d75>[%s] Lv.%d</color> untuk menyewa~",
    ["LeaseShop_UIInfo_003"]="Kamu telah memiliki %s....",
