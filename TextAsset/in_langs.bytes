    ["BuffDes_550061202"]="Final Damage Stack diri sendiri -<color=#44afee>%s%%</color>.",
    ["BuffDes_550061401"]="Dalam status <color=#7ACEFF>Auto Counter</color>, Final Damage Reduction +<color=#7ACEFF>%s%%</color>.",
    ["BuffDes_550061701"]="Dalam status <color=#7ACEFF>Ignore P.DEF Attack</color>, serangan mengabaikan <color=#7ACEFF>%s%%</color> DEF target.",
    ["BuffDes_550061901"]="Dalam status <color=#7ACEFF>Anubis Trial</color>, ukuran tubuh +<color=#7ACEFF>20%%</color>, setiap kali Normal Attack jarak dekat akan memberikan tambahan Undead Attribute Damage dan meningkatkan Movement Speed.",
    ["BuffDes_550062201"]="Dalam status <color=#7ACEFF>Adrenaline Rush</color>, Final ASPD +<color=#7ACEFF>%s%% </color>, persentase Bonus Crit Damage +<color=#7ACEFF>%s%%</color>.",
