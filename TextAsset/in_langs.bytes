    ["OXExam_Question062"]="Skill Archer <color=#F2C730FF>[Double Strafe]</color> adalah Skill Pasif, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question062_1"]="[Double Strafe] adalah Skill Aktif.",
