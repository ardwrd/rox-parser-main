    ["UnlockDescribe_1"]="<color=#FF751CFF>Mount</color> telah dibuka!\nSelesaikan sub-quest <color=#FF751CFF>level 12</color> <color=#FF751CFF>Berkelilinglah di sekitar Izlude Island</color> untuk mendapatkan Mount!",
    ["UnlockDescribe_10"]="Equipment <color=#FF751CFF> Enchant</color> telah dibuka!\nBiarkan magic Lil' Kitty memperkuat Equipmentmu!",
    ["UnlockDescribe_11"]="Equipment Enchant sudah di <color=#FF751CFF>Refine</color>!\nDapatkan Stats yang lebih kuat, buat dirimu menjadi lebih kuat!",
    ["UnlockDescribe_12"]="<color=#FF751CFF>Arena</color> telah dibuka!\nPanggil teman-temanmu untuk bersama bermain PVP!",
    ["UnlockDescribe_13"]="<color=#FF751CFF>Endless Tower</color> telah dibuka!\nKejar tujuanmu, lewati batasanmu.",
    ["UnlockDescribe_14"]="Fungsi <color=#FF751CFF>Craft</color> telah dibuka!\nCiptakan Senjata favoritmu sendiri!",
    ["UnlockDescribe_2"]="<color=#FF751CFF>Headwear Gift Pack</color> sudah ada di dalam Backpack! \nBuka dan lihat betapa indah Headwear itu!",
    ["UnlockDescribe_3"]="Selamat! <color=#FF751CFF>Job Advancement</color> berhasil!\nRasakan dirimu yang baru~",
    ["UnlockDescribe_4"]="<color=#FF751CFF>Academy</color> telah dibuka!\nTerus ikuti berita besar di Midgarts!",
    ["UnlockDescribe_5"]="Mendapatkan <color=#FF751CFF>Card</color> baru!\nIngatlah untuk memasang Card pada Equipment, barulah berguna!",
    ["UnlockDescribe_6"]="Sudah bisa ambil Quest di <color=#FF751CFF>Mission Board</color>!\nJika ingin mendapatkan EXP yang banyak, ingat untuk mengambilnya ya!",
    ["UnlockDescribe_7"]="<color=#FF751CFF>Guild</color> telah dibuka!\nBergabunglah dengan guild, bertemu teman-teman yang memiliki tujuan yang sama!",
    ["UnlockDescribe_8"]="<color=#FF751CFF>Instance</color> telah dibuka!\nInstance baru akan terus dibuka seiring dengan levelmu, ayo tantang terus menerus!",
    ["UnlockDescribe_9"]="<color=#FF751CFF>MVP</color> telah dibuka!\nReward dan Risk selalu ada, lawanlah MVP yang muncul!",
