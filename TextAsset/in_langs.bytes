    ["ItemDes_10403041"]="Cat berwarna Emas, dapat digunakan untuk cat warna rambut dan mata.",
    ["ItemDes_10403042"]="Cat berwarna Merah Muda, dapat digunakan untuk cat Mount, warna rambut dan mata.",
