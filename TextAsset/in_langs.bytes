    ["OXExam_Question073"]="<color=#F2C730FF>Mjolnir Mine</color> yang legendaris memiliki boss jahat yang bernama <color=#F2C730FF>Fein</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question074"]="Dulu ada kerajaan sihir di bawah tanah <color=#F2C730FF>Geffen</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question075"]="Kamu harus memiliki Party untuk masuk ke <color=#F2C730FF>Endless Tower</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question076"]="<color=#F2C730FF>Geffen</color> adalah lokasi di mana <color=#F2C730FF>Mage Guild</color> berada. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question077"]="Dengan meningkatnya <color=#F2C730FF>Level Guild</color>, <color=#F2C730FF>jumlah maksimum anggota</color> juga akan meningkat, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question078"]="<color=#F2C730FF>Payon</color> adalah <color=#F2C730FF>kota pegunungan</color>, tempat tinggal tersembunyi bagi seorang raja legendaris, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question079"]="<color=#F2C730FF>Magnolia</color> adalah roh kebencian yang lahir setelah <color=#F2C730FF>Pecopeco Egg</color> dihancurkan, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question080"]="<color=#F2C730FF>Falcon</color> adalah binatang eksklusif <color=#F2C730FF>Hunter</color>, tidak bisa dimiliki oleh <color=#F2C730FF>job lain</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question081"]="Kota gurun <color=#F2C730FF>Morroc</color> adalah surga bagi <color=#F2C730FF>Knight</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question081_1"]="Morroc adalah surga bagi Assassin.",
    ["OXExam_Question082"]="<color=#F2C730FF>Panacea</color> dapat menghilangkan hampir semua <color=#F2C730FF>efek Debuff</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question083"]="Di Tavern Minigame, saat orang bermain <color=#F2C730FF>panco</color>, kebanyakan orang menggunakan tangan <color=#F2C730FF>kiri</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question083_1"]="Bunga White Poppy melambangkan melupakan.",
    ["OXExam_Question084"]="<color=#F2C730FF>Moonlight Flower</color> memiliki bola mata berwarna <color=#F2C730FF>kuning</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question084_1"]="Berwarna merah",
    ["OXExam_Question085"]="Sebuah tim sepak bola bisa memiliki hingga <color=#F2C730FF>11 </color>pemain di lapangan, benar <color=#64b4ff>(O) </color>atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question086"]="Saat menuangkan air mendidih ke dalam gelas kaca di musim dingin, gelas <color=#F2C730FF>kaca yang tebal</color> mungkin bisa <color=#F2C730FF>retak</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question087"]="Bau mentol pada pasta gigi terjadi karena mengandung <color=#F2C730FF>daun mint</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question088"]="Kafra punya trik, menggunakan <color=#F2C730FF>cuka di dalam nasi</color> akan menghilangkan <color=#F2C730FF>bau gosong</color> nasi, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question089"]="Investigator monster baru-baru ini <color=#F2C730FF>indra penciumannya</color> menjadi semakin buruk, alasannya adalah <color=#F2C730FF>fungsi hati</color> melemah, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question089_1"]="Fungsi paru-paru yang melemah.",
    ["OXExam_Question090"]="Tedlyn baru-baru ini <color=#F2C730FF>panas dalam</color>, alasannya adalah karena makan terlalu banyak <color=#F2C730FF>buah leci</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question091"]="Karena <color=#F2C730FF>ujung lidah</color> <color=#F2C730FF>Catgirl</color> di Tavern sangat sensitif, jadi dia tidak pernah makan makanan yang masih <color=#F2C730FF>panas</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question092"]="<color=#F2C730FF>Dry ice</color> dibuat dari kondensasi <color=#F2C730FF>air</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question092_1"]="Dry ice dibuat dari kondensasi CO2.",
    ["OXExam_Question093"]="<color=#F2C730FF>Mutated Obeaune</color> adalah makhluk paling banyak di lautan, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question093_1"]="Makhluk paling banyak di lautan adalah Plankton.",
    ["OXExam_Question094"]="<color=#F2C730FF>Lubang sarang lebah</color> yang dibuat Mistress berbentuk <color=#F2C730FF>bulat</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question094_1"]="Berbentuk segi enam.",
    ["OXExam_Question095"]="Bahan yang digunakan untuk ujung pensil adalah grafit, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question096"]="Kode negara untuk Indonesia adalah <color=#F2C730FF>+62</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question097"]="Fungsi utama <color=#F2C730FF>kincir angin</color> Prontera West Gate adalah untuk <color=#F2C730FF>drainase air</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question098"]="Angka Romawi XVIII sama dengan angka <color=#F2C730FF>18</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question099"]="Nama ibukota terpanjang di dunia adalah <color=#F2C730FF>Bangkok</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question100"]="Bangku di Prontera South Gate bisa diduduki selama yang diinginkan, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question100_1"]="Ada batas waktu duduknya.",
    ["OXExam_Question101"]="<color=#F2C730FF>Poison</color> adalah <color=#F2C730FF>item</color> wajib yang digunakan <color=#F2C730FF>job Archer</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question101_1"]="Poison adalah item wajib bagi job Thief.",
    ["OXExam_Question102"]="Favor/ Hubungan baik dengan <color=#F2C730FF>Hollgrehenn</color> dapat meningkatkan tingkat keberhasilan <color=#F2C730FF>Upgrade Equipment</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question103"]="Lensa dengan bagian tepi lebih <color=#F2C730FF>tebal</color> daripada bagian tengahnya disebut <color=#F2C730FF>lensa cembung</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question103_1"]="Lensa dengan bagian tepi lebih tebal daripada bagian tengahnya disebut lensa cekung.",
    ["OXExam_Question104"]="Satuan kecepatan kapal adalah <color=#F2C730FF>knot</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question105"]="Elemen paling ringan adalah <color=#F2C730FF>hidrogen</color>, benar <color=#64b4ff>(O) </color>atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question106"]="Angka romawi M sama dengan <color=#F2C730FF>1.000.000</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question106_1"]="M = 1.000",
    ["OXExam_Question107"]="Kode negara untuk Filipina adalah <color=#F2C730FF>+63</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question108"]="Jumlah sudut dalam segitiga adalah <color=#F2C730FF>180 derajat</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question109"]="Drake memiliki <color=#F2C730FF>burung gagak</color> yang selalu bergantung di  <color=#F2C730FF>bahu kanannya</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question109_1"]="Di bahu kiri",
    ["OXExam_Question110"]="Jumlah sudut dalam persegi adalah <color=#F2C730FF>360 derajat</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question111"]="Monster Mini <color=#F2C730FF>Deviling</color> termasuk jenis <color=#F2C730FF>large</color> monster. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question111_1"]="Deviling adalah monster Medium",
    ["OXExam_Question112"]="Di Benua Midgard, ada total <color=#F2C730FF>9</color> jenis <color=#F2C730FF>Poring</color> yang berbeda. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question112_1"]="Ada total 7 jenis poring",
    ["OXExam_Question113"]="Penyambut murid baru <color=#F2C730FF>Perekrut Student Academy</color> di Prontera bernama <color=#F2C730FF>Kikik</color>. Benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
