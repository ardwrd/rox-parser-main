    ["worldKVM2_rule_103"]="Bronze",
    ["worldKVM2_rule_104"]="30",
    ["worldKVM2_rule_105"]="Fungsi Chosen's Medal",
    ["worldKVM2_rule_106"]="Reward Chosen's Medal yang diperoleh tidak akan hilang setelah event berakhir. Setelah event selanjutnya dimulai, item ini akan bisa kembali dipakai untuk keperluan berikut:\n1. Mengikuti prediksi turnamen\n2. Menukar item di Toko Chosen",
    ["worldKVM2_rule_107"]="Jumlah MVP: %s",
    ["worldKVM2_rule_108"]="Jumlah dikerahkan: %s",
    ["worldKVM2_rule_109"]="Total Kalah: %s",
    ["worldKVM2_rule_110"]="Total Kill: %s",
    ["worldKVM2_rule_111"]="Reward akan bisa diambil 13 jam setelah turnamen berakhir",
    ["worldKVM2_rule_112"]="Tidak ada reward yang bisa diambil sekarang",
    ["worldKVM2_rule_113"]="Pemenang Babak Ranked Match Sub-Server",
