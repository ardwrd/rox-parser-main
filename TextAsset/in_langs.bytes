    ["ui_GVG_031"]="Ranking Guild",
    ["ui_GVG_032"]="Panduan GVG",
    ["ui_GVG_033"]="Jumlah pemain Castle %s sudah penuh. Kamu harus mengantri!\nAntrianmu sekarang: <color=#FFFFFFFF>%s</color>",
    ["ui_GVG_034"]="Berhasil membatalkan antrian",
    ["ui_GVG_035"]="Gagal membatalkan antrian",
    ["ui_GVG_036"]="Batalkan",
    ["ui_GVG_037"]="Detail Pertempuran",
