    ["LeadText_1800"]="Ketuk untuk naik level",
    ["LeadText_1801"]="Ketuk <color=#FF6F76>Academy Handbook</color>",
    ["LeadText_1802"]="Ketuk untuk memeriksa <color=#FF6F76>Archive</color>",
    ["LeadText_1803"]="Ketuk untuk tutup",
    ["LeadText_1804"]="Ketuk untuk mulai <color=#FF6F76>Adventure Level Test</color>",
    ["LeadText_1805"]="Ketuk untuk kembali",
    ["LeadText_1806"]="Ketuk untuk menuju <color=#FF6F76>Adventure Level Test</color>",
    ["LeadText_1901"]="Ketuk untuk menggunakan <color=#FF6F76>Normal Attack</color>",
    ["LeadText_2001"]="Ketuk untuk mengubah <color=#FF6F76>Magic Bait</color>",
    ["LeadText_2002"]="Lebih mudah menangkap ikan langka dengan <color=#FF6F76>bait</color>",
    ["LeadText_2201"]="<color=#FF6F76>Academy Handbook</color> adalah <color=#FF6F76>panduan yang harus dimiliki</color> untuk Adventure di Rune-Midgarts Kingdom.",
    ["LeadText_2301"]="<color=#FF6F76>Life Skill</color> mempelajari kemampuan bertahan hidup, <color=#FF6F76>cari</color> item unik di seluruh map, dan <color=#FF6F76>olah</color> item yang kamu butuhkan selama bertualang",
    ["LeadText_2401"]="<color=#FF6F76>Wardrobe</color> untuk pakaian berkarakteristik.",
    ["LeadText_2501"]="Ketuk tombol <color=#FF6F76>Upgrade</color>",
    ["LeadText_2502"]="Konfirmasi <color=#FF6F76>Upgrade</color>",
    ["LeadText_2601"]="Di dunia RO, Guild itu seperti <color=#FF6F76>keluarga</color> hangat yang membutuhkan manajemen dan perlindungan yang cermat.",
    ["LeadText_2701"]="<color=#FF6F76>Mount</color> adalah partner perjalanan yang baik.",
    ["LeadText_2801"]="<color=#FF6F76>RO Carnival</color> adalah tempat berkumpulnya para RO-er, ada berbagai Event harian yang menarik dan eksklusif, serta ada <color=#FF6F76>kotak harta karun harian</color> yang dapat diambil lho!",
