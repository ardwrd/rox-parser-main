    ["BuffDes_15232028"]="Selama efek berlangsung, penggunaan Rhythm Shooting akan mendapatkan peningkatan Damage",
    ["BuffDes_15232052"]="Selama efek berlangsung, anggota party dalam radius akan mendapatkan <color=#44afee>%s%%</color> Bonus DMG (kepada Demons)",
    ["BuffDes_15232062"]="Selama efek berlangsung, anggota party dalam radius akan mendapatkan persentase Final M.PEN sebesar <color=#44afee>%s%%</color> dan persentase Final M.DMG Bonus sebesar <color=#44afee>%s%%</color>",
    ["BuffDes_15232071"]="Selama efek berlangsung, stat tertinggi (selain VIT) anggota party dalam radius meningkat <color=#44afee>%s%%</color>",
    ["BuffDes_15232072"]="STR +<color=#44afee>%s%%</color>",
    ["BuffDes_15232073"]="AGI +<color=#44afee>%s%%</color>",
    ["BuffDes_15232074"]="VIT +<color=#45afee>%s%%</color>",
