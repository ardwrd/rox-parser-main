    ["OXExam_Question064"]="Skill Acolyte <color=#F2C730FF>[Blessing]</color> dapat meningkatkan Crit dan Anti-Crit, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question064_1"]="[Blessing] dapat meningkatkan STR, DEX dan INT.",
    ["OXExam_Question065"]="Skill Mage <color=#F2C730FF>[Increase SP Recovery]</color> dapat meningkatkan SP Regen, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
