    ["SlimeTask2_007"]="Ikuti %s/%s kali Kontes Memancing",
    ["SlimeTask2_008"]="Gunakan dadu jenis apa pun di Petualangan Rimuru %s/%s buah",
    ["SlimeTask2_009"]="Picu %s/%s Kejadian Ajaib di Petualangan Rimuru",
    ["SlimeTask2_010"]="Total menyelesaikan %s/%s lap (putaran) di Petualangan Rimuru",
    ["SlimeTask2_011"]="Total memicu %s/%s Kejadian Ajaib di Petualangan Rimuru",
