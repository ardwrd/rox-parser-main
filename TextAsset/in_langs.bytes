    ["ui_Re0_029"]="Leaderboard Total Rem",
    ["ui_Re0_030"]="Emilia mengirimkan undangan pesta teh untukmu, akumulasi sign in 7 hari untuk mendapatkan reward berlimpah.",
    ["ui_Re0_031"]="Selama masa event, akumulasi log in 7 hari untuk mendapatkan seluruh reward",
