    ["SlimeTask2_001"]="Log In setiap hari %s/%s",
    ["SlimeTask2_002"]="Gunakan Odin %s/%s",
    ["SlimeTask2_003"]="Activity harian mencapai %s/%s",
    ["SlimeTask2_004"]="Fishing %s/%s kali",
    ["SlimeTask2_005"]="Mining %s/%s kali",
