    ["OXExam_Question006"]="Nama lengkap RO adalah <color=#F2C730FF>Regolark Online</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question006_1"]="Ragnarok Online",
    ["OXExam_Question007"]="Hanya <color=#F2C730FF>Prontera</color> yang memiliki Kafra Service Staff, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
