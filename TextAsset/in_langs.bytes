    ["ResonateDesc_1710"]="Awakening Pet X",
    ["ResonateDesc_18"]="Syarat Awakening: Upgrade 8 Equipment hingga tahap VIII\nWeapon Upgrade hingga <color=#ffc821>+200</color>\nArmor Upgrade hingga <color=#ffc821>+100</color>\nAccessory Upgrade hingga <color=#ffc821>+50</color>",
    ["ResonateDesc_19"]="Syarat Awakening: Upgrade 8 Equipment hingga tahap IX\nWeapon Upgrade hingga <color=#ffc821>+220</color>\nArmor Upgrade hingga <color=#ffc821>+110</color>\nAccessory Upgrade hingga <color=#ffc821>+55</color>",
    ["ResonateDesc_2"]="Saat angin dan pasir menutupi mata semua makhluk hidup,\nKabut abu-abu membasahi jubah penjelajah,\nKekuatan Magic akan beresonansi dengan angin sekali lagi di seluruh daratan.\nPewaris darah Odin, Equipment Enchant akan membangkitkan kekuatan resonansi angin, pergilah, selesaikanlah misimu.",
    ["ResonateDesc_20"]="Syarat Awakening: Upgrade 8 Equipment hingga tahap X\nWeapon Upgrade hingga <color=#ffc821>+240</color>\nArmor Upgrade hingga <color=#ffc821>+120</color>\nAccessory Upgrade hingga <color=#ffc821>+60</color>",
    ["ResonateDesc_21"]="Syarat Awakening: \nTotal Lv Enchant 2 Equipment mencapai Lv.18",
    ["ResonateDesc_22"]="Syarat Awakening: \nTotal Lv Enchant 4 Equipment mencapai Lv.21",
    ["ResonateDesc_23"]="Syarat Awakening: \nTotal Lv Enchant 6 Equipment mencapai Lv.24",
    ["ResonateDesc_24"]="Syarat Awakening: \nTotal Lv Enchant 8 Equipment mencapai Lv.27",
    ["ResonateDesc_25"]="Syarat Awakening: \nTotal Lv Enchant 8 Equipment mencapai Lv.30",
    ["ResonateDesc_26"]="Syarat Awakening: \nTotal Lv Enchant 8 Equipment mencapai Lv.33",
    ["ResonateDesc_27"]="Syarat Awakening: \nTotal Lv Enchant 8 Equipment mencapai Lv.36",
    ["ResonateDesc_28"]="Syarat Awakening: \nTotal Lv Enchant 8 Equipment mencapai Lv.39",
    ["ResonateDesc_29"]="Syarat Awakening: \nTotal Lv Enchant 8 Equipment mencapai Lv.42",
    ["ResonateDesc_3"]="Kekuatan agung yang tersimpan di lautan luas,\nLagu laut yang jauh dan halus,\nSiapa yang terbentur ombak?\nPewaris darah Odin, Refine Equipment akan membangkitkan kekuatan resonansi air, pergilah, selesaikanlah misimu.",
    ["ResonateDesc_30"]="Syarat Awakening: \nEnchant 8 Equipment menjadi +45",
    ["ResonateDesc_31"]="Syarat Awakening: \nRefine 2 Equipment menjadi +6",
