    ["CollegeText_001"]="Total Skor Murid",
    ["CollegeText_002"]="Total Skor Mastery",
    ["CollegeText_003"]="Title Mentor",
    ["CollegeText_004"]="Kelas Murid",
    ["CollegeText_005"]="Poin Mentor: <color=#130c0e>%s</color>",
    ["CollegeText_006"]="Murid Lulus: <color=#130c0e>%s</color>",
    ["CollegeText_007"]="Sedang Berusaha",
    ["CollegeText_008"]="Sedang istirahat",
    ["CollegeText_009"]="Murid Rekomendasi",
    ["CollegeText_010"]="Mentor Rekomendasi",
