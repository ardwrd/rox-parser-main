    ["ResonateDesc_11"]="Syarat Awakening: Upgrade 2 Equipment hingga tahap I\nWeapon Upgrade hingga <color=#ffc821>+60</color>\nArmor Upgrade hingga <color=#ffc821>+30</color>\nAccessory Upgrade hingga <color=#ffc821>+15</color>",
    ["ResonateDesc_12"]="Syarat Awakening: Upgrade 4 Equipment hingga tahap II\nWeapon Upgrade hingga <color=#ffc821>+80</color>\nArmor Upgrade hingga <color=#ffc821>+40</color>\nAccessory Upgrade hingga <color=#ffc821>+20</color>",
    ["ResonateDesc_13"]="Syarat Awakening: Upgrade 6 Equipment hingga tahap III\nWeapon Upgrade hingga <color=#ffc821>+100</color>\nArmor Upgrade hingga <color=#ffc821>+50</color>\nAccessory Upgrade hingga <color=#ffc821>+25</color>",
    ["ResonateDesc_14"]="Syarat Awakening: Upgrade 8 Equipment hingga tahap IV\nWeapon Upgrade hingga <color=#ffc821>+120</color>\nArmor Upgrade hingga <color=#ffc821>+60</color>\nAccessory Upgrade hingga <color=#ffc821>+30</color>",
    ["ResonateDesc_15"]="Syarat Awakening: Upgrade 8 Equipment hingga tahap V\nWeapon Upgrade hingga <color=#ffc821>+140</color>\nArmor Upgrade hingga <color=#ffc821>+70</color>\nAccessory Upgrade hingga <color=#ffc821>+35</color>",
    ["ResonateDesc_16"]="Syarat Awakening: Upgrade 8 Equipment hingga tahap VI\nWeapon Upgrade hingga <color=#ffc821>+160</color>\nArmor Upgrade hingga <color=#ffc821>+80</color>\nAccessory Upgrade hingga <color=#ffc821>+40</color>",
    ["ResonateDesc_17"]="Syarat Awakening: Upgrade 8 Equipment hingga tahap VII\nWeapon Upgrade hingga <color=#ffc821>+180</color>\nArmor Upgrade hingga <color=#ffc821>+90</color>\nAccessory Upgrade hingga <color=#ffc821>+45</color>",
