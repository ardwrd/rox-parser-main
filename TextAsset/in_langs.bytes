    ["DialogueOption91106011"]="Kamu jangan berpikir sendiri",
    ["DialogueOption91106021"]="Apa tujuanmu?",
    ["DialogueOption91201011"]="Kamu tidak membiarkan aku berbicara...",
    ["DialogueOption91201021"]="Lalu... kamu ingin aku melakukan apa?",
    ["DialogueOption91202011"]="Temanku patah hati.",
    ["DialogueOption91202021"]="Terima kasih banyak!",
    ["DialogueOption91203011"]="Sungguh terima kasih...",
    ["DialogueOption91203021"]="Bukan aku yang menyakitimu...",
    ["DialogueOption91204011"]="Kalau begitu kita jangan membahasnya lagi?",
    ["DialogueOption91204021"]="Semoga berhasil!",
    ["DialogueOption91301011"]="Tentu saja~",
    ["DialogueOption91301021"]="Tidak masalah~",
    ["DialogueOption91302011"]="Jimmy Lin...",
    ["DialogueOption91302021"]="Sama-sama~",
    ["DialogueOption91302041"]="Aku akan membantumu bertanya padanya",
    ["DialogueOption91303011"]="(Menjelaskan)",
    ["DialogueOption91303031"]="Jangan khawatir, aku akan bertanya",
    ["DialogueOption91304011"]="Dia bilang tidak masalah",
    ["DialogueOption91304021"]="Tapi kostumnya...",
    ["DialogueOption91304031"]="Apa yang harus kupersiapkan?",
    ["DialogueOption91305011"]="(Beritahu permintaan)",
    ["DialogueOption91305021"]="Apa maksudmu?",
    ["DialogueOption91305022"]="Jimmy Lin...",
    ["DialogueOption91305041"]="Sibuk apa?",
    ["DialogueOption91305051"]="Tidak masalah!",
    ["DialogueOption91401011"]="Halo?",
    ["DialogueOption91401021"]="(Melambai)",
    ["DialogueOption91401031"]="Kamu belajar memasak?",
    ["DialogueOption91401041"]="Kenapa kamu tiba-tiba...",
    ["DialogueOption91401061"]="Hanya apa?",
    ["DialogueOption91401071"]="Bukankah ada aku?",
    ["DialogueOption91402011"]="Rosemary...",
    ["DialogueOption91403011"]="Bagaimana?",
    ["DialogueOption91403021"]="Selamat!",
    ["DialogueOption91404011"]="Aku di sini bukan untuk membeli bahan makanan",
    ["DialogueOption91404021"]="Lihat ini.",
    ["DialogueOption91405011"]="(Menjelaskan)",
    ["DialogueOption91501011"]="Apakah ini penting bagimu?",
    ["DialogueOption91501021"]="Apa yang terjadi?",
    ["DialogueOption91501031"]="Jangan putus asa",
    ["DialogueOption91501041"]="Whitesmith Howard...",
    ["DialogueOption91501051"]="Aku bisa memintanya untuk mencoba",
    ["DialogueOption91502011"]="(Menjelaskan)",
    ["DialogueOption91502021"]="Kalau begitu kuserahkan padamu",
    ["DialogueOption91504011"]="Apakah ada cara untuk mengatasinya?",
    ["DialogueOption91505021"]="Berhasil?",
    ["DialogueOption91505031"]="Terima kasih!",
    ["DialogueOption91601011"]="Tentu saja bersedia.",
