    ["ui_Kingdom_007"]="List Pemenang",
    ["ui_Kingdom_008"]="Berhasil like! Selamat! Kamu mendapatkan Reward.",
    ["ui_Kingdom_009"]="Lihat Reward",
    ["ui_Kingdom_010"]="Season Quiz",
