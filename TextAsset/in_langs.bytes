    ["OXExam_Question009"]="Job Cenia setelah ganti job adalah <color=#F2C730FF>Mage</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question009_1"]="Swordsman",
    ["OXExam_Question010"]="Kapten yang bertanggung jawab atas teleport laut di Izlude Island disebut <color=#F2C730FF>Carew</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question011"]="Kapten yang bertanggung jawab atas teleport laut di Izlude Island disebut <color=#F2C730FF>Kahn</color>, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question011_1"]="Carew",
    ["OXExam_Question012"]="Bertambahnya <color=#F2C730FF>STR</color> akan meningkatkan Physical Attack, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question013"]="Bertambahnya <color=#F2C730FF>STR</color> bisa meningkatkan Physical Attack dan Magic Attack, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question013_1"]="STR hanya memengaruhi Physical Attack.",
    ["OXExam_Question014"]="Bertambahnya <color=#F2C730FF>STR</color> dapat meningkatkan Physical Attack dan P.DEF, benar <color=#64b4ff>(O)</color> atau salah <color=#ff6481>(X)</color>?",
    ["OXExam_Question014_1"]="STR hanya memengaruhi Physical Attack.",
