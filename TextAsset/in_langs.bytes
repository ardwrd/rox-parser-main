    ["DialogueOption21042032"]="Serahkan saja padaku!",
    ["DialogueOption21050301"]="Oh ya, ya, ini!",
    ["DialogueOption21050401"]="Teman lamaku, sekarang waktunya untuk bertarung bersama.",
    ["DialogueOption23010101"]="Terlalu pelan... terlalu pelan!",
    ["DialogueOption23010201"]="(Emoticon terkejut)",
    ["DialogueOption23010301"]="Wah, terima kasih banyak!",
    ["DialogueOption23010401"]="Odin, apa yang terjadi dengan kelinci-kelinci ini?",
    ["DialogueOption23010501"]="Wah, terima kasih banyak!",
    ["DialogueOption23020101"]="Ah... sakit, sakit--!!!",
