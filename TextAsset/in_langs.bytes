    ["ResonateTextDesc_1705"]="Syarat awakening: \nMengerahkan <color=#ffc821>1</color> Pet Bintang <color=#ffc821>5</color> dan <color=#ffc821>2</color> Pet Bintang <color=#ffc821>7</color>",
