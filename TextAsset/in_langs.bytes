    ["ui_ChristmasActivity_007"]="Progres Pribadi:",
    ["ui_ChristmasGift_001"]="Christmas Carnival Pack",
    ["ui_ChristmasMagic_001"]="Mode Tembak",
    ["ui_ChristmasMagic_002"]="Event Christmas",
    ["ui_ChristmasMagic_003"]="Christmas Shooting Festival",
    ["ui_ChristmasMagic_004"]="Beli item wajib di Christmas Shop di Geffen: Deer Slingshot~",
    ["ui_ChristmasMagic_005"]="Dapatkan Magic Bullet dengan menggunakan Odin dan cara lainnya. Semakin tinggi kualitasnya, semakin besar kekuatannya~",
    ["ui_ChristmasMagic_006"]="Gunakan Deer Slingshot atau dekati meriam tembak untuk masuk ke dalam mode menembak, cepat bidik dan tembak balonnya, saat berhasil memecahkan balon, kamu akan mendapatkan Hadiah Christmas, semakin besar balonnya semakin besar hadiahnya~",
    ["ui_ChristmasMagic_007"]="Kota Geffen sedang menyelenggarakan Christmas Shooting Festival!",
    ["ui_ChristmasMagic_008"]="Pecahkan balon untuk mendapatkan Hadiah Christmas!",
    ["ui_ChristmasMagic_009"]="Christmas Exchange",
    ["ui_ChristmasMagic_010"]="Gold Angeling Balloon",
    ["ui_ChristmasMagic_011"]="Drop",
    ["ui_ChristmasMagic_012"]="Sasquatch Sled Mount",
    ["ui_ChristmasMagic_013"]="Jingle Bell Mount",
    ["ui_ChristmasMagic_014"]="Kostum Christmas Acak",
