    ["ui_Deposit_001"]="Pengguna VIP Card dapat memilih satu Hadiah Top Up Pertama setiap 30 hari",
    ["ui_Deposit_002"]="Top Up Pertama",
    ["ui_Deposit_003"]="　Adventurer yang terhormat, dapatkan <size=18> <color=#ff9638>2x</color> </size> Diamond untuk top up <size=18> <color=#ff9638>pertama setiap tier</color> </size> ",
