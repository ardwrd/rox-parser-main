    ["Time_2"]="j",
    ["Time_20"]="%d-%m %H:%M",
    ["Time_21"]="Pilih waktu~~~",
    ["Time_22"]="%d/%m/%Y",
    ["Time_23"]="%s/%s/%s %s:%s:%s",
    ["Time_3"]="m",
