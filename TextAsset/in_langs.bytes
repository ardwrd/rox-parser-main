    ["ui_ChildrenDay_043"]="Reward Rank akan dikirimkan melalui Mail setelah event selesai",
    ["ui_ChildrenDay_044"]="Level up untuk mendapatkan",
    ["ui_ChildrenDay_045"]="Hadiah Pelangi",
    ["ui_ChildrenDay_046"]="Terbang Tinggi!",
    ["ui_ChildrenDay_047"]="Bisa ditingkatkan menjadi ",
    ["ui_ChildrenDay_048"]="Gunakan Odin's Blessing, kalahkan MVP di map untuk kemungkinan mendapatkan Music Box Medal dan Rainbow Medal yah~",
    ["ui_ChildrenDay_049"]="Reward leaderboard akan dikirimkan melalui Mail pukul 05:00 setiap hari",
