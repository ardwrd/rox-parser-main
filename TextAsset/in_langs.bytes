    ["SEA_Achievement_Name_580302"]="VIP Tertinggi",
    ["SEA_AnniversaryCommand"]="Kirimkan tulisan berikut di Channel Dunia: <color=#ffc982>\"Happy 3rd Anniversary\"</color> untuk mengaktifkan reward",
    ["SEA_AnniversaryCommand_CommandLock"]="Masukkan dulu kata sandinya baru ambil rewardnya",
    ["SEA_AnniversaryCommand_Day1"]="1day",
    ["SEA_AnniversaryCommand_Day2"]="2days",
    ["SEA_AnniversaryCommand_Day3"]="3days",
    ["SEA_AnniversaryCommand_Day4"]="4days",
    ["SEA_AnniversaryCommand_Day5"]="5days",
    ["SEA_AnniversaryCommand_Day6"]="6days",
    ["SEA_AnniversaryCommand_Day7"]="7days",
    ["SEA_AnniversaryCommand_Day8"]="8days",
    ["SEA_AnniversaryCommand_EndTime"]="Waktu berakhir kali ini: 30 Juni 2022",
    ["SEA_AnniversaryCommand_Help01_01"]="Deskripsi Berkat Harian:\n1. Selama event anniversary kali ini ini, kumpulkan check in selama jumlah hari yang ditentukan, untuk mendapatkan Reward Check In\n2. Kata sandi akan dibuka saat anniversary tanggal 18 Juni, masukkan kata sandi ini di channel world untuk mengaktifkan Reward Kata Sandi\n3. Setelah kata sandi diaktifkan hingga Event Anniversary berakhir, kamu akan bisa mengaktifkan Reward Kata Sandi\n4. Jumlah Reward Kata Sandi yang bisa diperoleh sama dengan jumlah akumulasi hari check in",
    ["SEA_AnniversaryCommand_Lock"]="Tunggu rewardnya diaktifkan dulu baru diambil yah",
    ["SEA_AnniversaryFuncDesc1"]="Reward Bisa Diambil",
    ["SEA_AnniversaryFuncDesc2"]="Masukkan Achievement untuk mengambil reward",
    ["SEA_AnniversaryFuncDesc3"]="Reward Bisa Diambil",
    ["SEA_AnniversaryFuncDesc4"]="Beli Kostum",
    ["SEA_Anniversary_Duration"]="Waktu Event: %s/%s/%s - %s/%s/%s",
    ["SEA_Anniversary_WorldKVM"]="War of the Chosen II Dimulai\n<size=20>2022/06/20</size>",
    ["SEA_Year2MemoirDes1_004"]="\nKafra's VIP tetap menunggumu.",
    ["SEA_Year2MemoirDes1_010"]="\nPercaya dengan penglihatanmu sendiri,",
    ["SEA_Year2MemoirDes1_011"]="kamu sudah memilih jalan perubahan job.",
    ["SEA_Year2MemoirDes1_017"]="\nAdventurer, bangkitkanlah Shadow Equipment-mu.",
    ["SEA_Year2MemoirDes1_018"]="\nKamu masih perlu mengikuti pertempuran dengan MVP dan Mini,",
    ["SEA_Year2MemoirDes1_019"]="kamu masih harus memecah sejarah jumlah Instance \"0\",",
    ["SEA_Year2MemoirDes1_021"]="kamu masih harus mendaki Endless Tower yang tak berujung,",
    ["SEA_Year2MemoirDes1_023"]="kamu masih harus melindungi kemuliaan Guild melalui KVM.",
    ["SEA_Year2MemoirDes1_024"]="\nDemikianlah,",
    ["SEA_Year2MemoirDes1_025"]="kamu baru bisa menjadi pemberani yang sesungguhnya,",
    ["SEA_Year2MemoirDes1_026"]="\nEntah sendiri, atau dengan pasangan,",
    ["SEA_Year2MemoirDes1_027"]="semuanya akan tergugah.",
    ["SEA_Year2MemoirDes1_028"]="\nBerjalan sendiri, atau dengan kawan,",
    ["SEA_Year2MemoirDes1_029"]="tetaplah tenang apa pun yang terjadi.",
    ["SEA_Year2MemoirDes1_032"]="\nSatu orang, atau dengan kelompok,",
    ["SEA_Year2MemoirDes1_033"]="tetaplah tenang di mana pun kamu berada.",
    ["SEA_Year2MemoirDes1_036"]="\nPintu Exchange Center sudah terbuka,",
    ["SEA_Year2MemoirDes1_037"]="selesaikanlah transaksi pertamamu~",
    ["SEA_Year2MemoirDes1_038"]="\nPilih item untuk dijual,",
    ["SEA_Year2MemoirDes1_039"]="dan dapatkan uang pertamamu!",
    ["SEA_Year2MemoirDes1_040"]="\nGunakan Crystal untuk bertransaksi,",
    ["SEA_Year2MemoirDes1_041"]="Beli item yang kamu inginkan.",
    ["SEA_Year2MemoirDes1_042"]="\nGunakan Diamond untuk bertransaksi,",
    ["SEA_Year2MemoirDes1_043"]="bersihkan keranjangmu.",
    ["SEA_Year2MemoirDes1_044"]="\nSiapa yang bisa menolak",
    ["SEA_Year2MemoirDes1_045"]="kebahagiaan dari beli, beli, dan beli?",
    ["SEA_Year2MemoirDes1_053"]="\nPilihlah pasangan yang paling cocok untukmu!",
    ["SEA_Year2MemoirDes1_055"]="\nTambahkan kostummu,",
    ["SEA_Year2MemoirDes1_056"]="dan penuhi Wardrobe-mu!",
    ["SEA_Year2MemoirDes1_057"]="\nTambahkan gerakanmu,",
    ["SEA_Year2MemoirDes1_058"]="supaya lebih ekspresif saat berkomunikasi!",
    ["SEA_Year2MemoirDes1_059"]="\nBeli Mount,",
    ["SEA_Year2MemoirDes1_060"]="dan keliling benua bersamanya!",
    ["SEA_Year2MemoirDes_001"]="Halo, <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_002"]="Sejak <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_003"]="kamu sudah melewati <color=#c69d46>%s</color> hari bertualang di Benua Midgard,",
    ["SEA_Year2MemoirDes_004"]="dan menjadi Kafra's VIP pada <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_005"]="\nWaktu berlalu dengan cepat, semua itu adalah memori yang berharga.\nMari kita hitung bersama\nlegenda yang sudah kamu ukir.",
    ["SEA_Year2MemoirDes_006"]="Pada tanggal <color=#c69d46>%s</color>, kamu menjadi job 1-<color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_007"]="<color=#c69d46>%s</color> hari kemudian, kamu menjadi job 2,",
    ["SEA_Year2MemoirDes_008"]="<color=#c69d46>%s</color> hari kemudian, kamu menjadi job Transcendent,",
    ["SEA_Year2MemoirDes_009"]="<color=#c69d46>%s</color> hari kemudian, kamu menjadi Adventurer job 3 yang membanggakan.",
    ["SEA_Year2MemoirDes_010"]="Kamu sudah mengaktifkan <color=#c69d46>%s</color> cabang job,\ndan membuat dunia menyaksikan bakat dari Adventurer.",
    ["SEA_Year2MemoirDes_011"]="\nSehingga dunia menyaksikan bakat dan pencapaianmu.",
    ["SEA_Year2MemoirDes_012"]="<color=#c69d46>%s</color> kali Upgrade,",
    ["SEA_Year2MemoirDes_013"]="<color=#c69d46>%s</color> kali Refine sampai level <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_014"]="<color=#c69d46>%s</color> kali Enchant sampai level <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_015"]="<color=#c69d46>%s</color> buah Card yang menemani perjalananmu.",
    ["SEA_Year2MemoirDes_016"]="Oh Odin yang di atas, rupanya kamu masih memiliki <color=#c69d46>%s</color> Card emas!",
    ["SEA_Year2MemoirDes_017"]="Kamu sudah berhasil level up <color=#c69d46>%s</color> kali Shadow Equipment,",
    ["SEA_Year2MemoirDes_018"]="<color=#c69d46>%s</color> kali bertempur dengan MVP dan Mini,",
    ["SEA_Year2MemoirDes_019"]="<color=#c69d46>%s</color> kali menyelesaikan Instance berbahaya,",
    ["SEA_Year2MemoirDes_020"]="<color=#c69d46>%s</color> kali mendapatkan jempol di Instance.",
    ["SEA_Year2MemoirDes_021"]="<color=#c69d46>%s</color> lantai Endless Tower yang ditaklukkan,",
    ["SEA_Year2MemoirDes_022"]="<color=#c69d46>%s</color> kali melewati Instance Team,",
    ["SEA_Year2MemoirDes_023"]="<color=#c69d46>%s</color> kali bertempur dalam KVM yang berdarah.\nKamu sudah menggunakan seluruh teknik untuk melatih sebuah hati yang berani.",
    ["SEA_Year2MemoirDes_024"]="\nKamu menggunakan pelatihan tanpa batas,",
    ["SEA_Year2MemoirDes_025"]="Untuk menempa hati pejuangmu.",
    ["SEA_Year2MemoirDes_026"]="<color=#c69d46>%s</color>, kamu sudah mengikat janji manis dengannya.",
    ["SEA_Year2MemoirDes_027"]="Kamu sudah mengikat kontrak cinta dengannya.",
    ["SEA_Year2MemoirDes_028"]="<color=#c69d46>%s</color>，",
    ["SEA_Year2MemoirDes_029"]="kamu bergabung dengan <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_030"]="\nTanpa terasa, waktu berlalu begitu saja,",
    ["SEA_Year2MemoirDes_031"]="Kamu sekarang adalah <color=#c69d46>%s</color> <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_032"]="Kamu mengenal <color=#c69d46>%s</color> teman, persahabatanmu tak pernah layu.",
    ["SEA_Year2MemoirDes_033"]="semoga persahabatan kalian tetap berlangsung sampai selamanya.",
    ["SEA_Year2MemoirDes_034"]="Secara keseluruhan, kamu sudah pernah memberikan teman <color=#c69d46>%s</color> kali hadiah,",
    ["SEA_Year2MemoirDes_035"]="meski hadiahnya tidak seberapa, tapi niatnya tetap dari lubuk hati yang terdalam.",
    ["SEA_Year2MemoirDes_036"]="\nKamu adalah pelanggan tetap di Exchange Center,",
    ["SEA_Year2MemoirDes_037"]="\ndan sudah menyelesaikan <color=#c69d46>%s</color> kali pesanan.",
    ["SEA_Year2MemoirDes_038"]="\nSebagai penjual,",
    ["SEA_Year2MemoirDes_039"]="\nKamu sudah mendapatkan <color=#c69d46>%s</color> Crystal.",
    ["SEA_Year2MemoirDes_040"]="Sebagai pembeli dengan Crystal,",
    ["SEA_Year2MemoirDes_041"]="Kamu sudah menggunakan <color=#c69d46>%s</color> Crystal di Exchange Center.",
    ["SEA_Year2MemoirDes_042"]="Sebagai pembeli dengan Diamond,",
    ["SEA_Year2MemoirDes_043"]="Kamu sudah menggunakan <color=#c69d46>%s</color> Diamond di Exchange Center.\nBertransaksi dengan adil, bertukar dengan setara, kamu tetap mengingat semua hukum pasar.",
    ["SEA_Year2MemoirDes_044"]="\nTransaksi yang adil, pertukaran yang setimpal,",
    ["SEA_Year2MemoirDes_045"]="kamu memahami hukum pasar.",
    ["SEA_Year2MemoirDes_046"]="Kamu melempar pancing<color=#c69d46>%s</color> kali,",
    ["SEA_Year2MemoirDes_047"]="level Fishing mencapai <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_048"]="Kamu berkebun <color=#c69d46>%s</color> kali,",
    ["SEA_Year2MemoirDes_049"]="level Gardening mencapai <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_050"]="Kamu menambang <color=#c69d46>%s</color> kali,",
    ["SEA_Year2MemoirDes_051"]="level Mining mencapai <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_052"]="Kamu pernah menangkap pet dengan serius <color=#c69d46>%s</color> kali,",
    ["SEA_Year2MemoirDes_053"]="akhirnya memiliki <color=#c69d46>%s</color> teman pet sampai sekarang.",
    ["SEA_Year2MemoirDes_054"]="Progres penangkapan pet-mu adalah<color=#c69d46>%s</color>%%!",
    ["SEA_Year2MemoirDes_055"]="Kamu memiliki <color=#c69d46>%s</color> kostum, menjadi bintang abadi dalam dunia fashion.",
    ["SEA_Year2MemoirDes_056"]="menjadi tren sepanjang masa.",
    ["SEA_Year2MemoirDes_057"]="Kamu memiliki <color=#c69d46>%s</color> gerakan, dan menjadi bintang dalam dunia sosial.",
    ["SEA_Year2MemoirDes_058"]="sehingga menjadi bintang interaksi",
    ["SEA_Year2MemoirDes_059"]="Kamu memiliki <color=#c69d46>%s</color> Mount, menemanimu melewati setiap musim.",
    ["SEA_Year2MemoirDes_060"]="menemanimu melewati hari demi hari.",
    ["SEA_Year2MemoirDes_061"]="\nMeski tren sudah berlalu,",
    ["SEA_Year2MemoirDes_062"]="tapi kenangan kita tetap abadi.",
    ["SEA_Year2MemoirShareDes1_003"]="Mulai dari nol, pelajari pengetahuan berdagang, dan raih transaksi pertamamu",
    ["SEA_Year2MemoirShareDes_001"]="<color=#c69d46>%s</color>, Adventurer <color=#c69d46>%s</color> tiba di Benua Midgard.",
    ["SEA_Year2MemoirShareDes_002"]="Dari awal, upgrade <color=#c69d46>%s</color> kali, refine <color=#c69d46>%s</color> kali, enchant <color=#c69d46>%s</color> kali.",
    ["SEA_Year2MemoirShareDes_003"]="Dari awal, belajar cara bertransaksi dan telah mendapatkan <color=#c69d46>%s</color> Crystal.",
    ["SEA_Year2MemoirShareDes_004"]="Biarlah semua equipment dan Crystal yang berkilauan ini,",
    ["SEA_Year2MemoirShareDes_005"]="menjadi saksi atas hadirnya dirimu selama <color=#c69d46>%s</color> hari di sini yang tak pernah sia-sia!",
    ["SEA_YearMemoirDes_001"]="%s, kamu memasuki Rune-Midgarts dengan nama %s.",
    ["SEA_YearMemoirDes_002"]="%s, kamu menerima persahabatan dengan Kafra.",
    ["SEA_YearMemoirDes_003"]="Petualanganmu selama <color=#ecc993>%s</color> hari membuatmu semakin sekarang.",
    ["SEA_YearMemoirDes_004"]="Sampai sekarang, kamu sudah berubah ke job 2 selama <color=#ecc993>%s</color> hari,",
    ["SEA_YearMemoirDes_005"]="Job Trascendent selama %s hari,",
    ["SEA_YearMemoirDes_006"]="Adventurer Job 3 <color=#ecc993>%s</color> hari.",
    ["SEA_YearMemoirDes_021"]="\nKamu punya kesan sendiri terhadap build equipment-mu,",
    ["SEA_YearMemoirDes_022"]="<color=#ecc993>%s</color> kali upgrade, <color=#ecc993>%s</color> kali refine, <color=#ecc993>%s</color> kali enchant,",
    ["SEA_YearMemoirDes_023"]="akhirnya kamu mencapai refine lv. <color=#ecc993>%s</color> untuk equipment <color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_024"]="level tertinggi enchant-mu juga telah mencapai <color=#ecc993>%s</color>.",
    ["SEA_YearMemoirDes_031"]="\nIngin mendapatkan equipment terkuat?\nCarilah Hollgrehenn,\ndia akan memberitahumu rahasia untuk meningkatkan equipment.\nTapi, kamu harus tenang.",
    ["SEA_YearMemoirDes_041"]="\nKamu adalah pemburu yang sangat berbakat.",
    ["SEA_YearMemoirDes_042"]="Dari pertarungan MVP dan Mini sebanyak <color=#ecc993>%s</color> kali,",
    ["SEA_YearMemoirDes_043"]="kamu berhasil memberikan pukulan terakhir untuk musuh sebanyak <color=#ecc993>%s</color> kali.",
    ["SEA_YearMemoirDes_044"]="Kamu sudah menyelesaikan <color=#ecc993>%s</color> kali instance,",
    ["SEA_YearMemoirDes_045"]="dan <color=#ecc993>%s</color> like yang kamu terima adalah bukti kerja kerasmu.",
    ["SEA_YearMemoirDes_051"]="\nPertempuran adalah bumbu dari sebuah petualangan.\nBagaimana kalau kita coba Eclipse yang ada di luar?\nNuansanya pasti sangat luar biasa.",
    ["SEA_YearMemoirDes_061"]="\nAdventurer yang paling beruntung, akan bisa menemukan cinta dan sahabatnya.",
    ["SEA_YearMemoirDes_062"]="Kamu telah menyematkan janji suci sehidup semati pada %s,",
    ["SEA_YearMemoirDes_063"]="pada %s, kamu bergabung dengan %s,",
    ["SEA_YearMemoirDes_064"]="waktu berlalu dengan cepat, tanpa disadari kamu telah menjadi <color=#ecc993>%s</color> dari <color=#ecc993>%s</color>.",
    ["SEA_YearMemoirDes_065"]="Kamu sudah menjadi sahabat dengan <color=#ecc993>%s</color> orang,",
    ["SEA_YearMemoirDes_071"]="\nkamu sepertinya sangat menyukai kesendirianmu di dalam berpetualang,\natau mungkin takdir sedang menentukan siapa yang pantas menjadi sahabatmu.\nTapi tidak usah khawatir,\nsendirian ataupun\nbersama teman,\npemandangan indah di Rune-Midgarts akan selalu menemanimu.",
    ["SEA_YearMemoirDes_081"]="\nKamu adalah pelanggan tetap di Exchange Center,",
    ["SEA_YearMemoirDes_082"]="kamu sudah melakukan <color=#ecc993>%s</color> kali transaksi di Exchange Center,",
    ["SEA_YearMemoirDes_083"]="mendapatkan <color=#ecc993>%s</color> Crystal,",
    ["SEA_YearMemoirDes_084"]="membayar <color=#ecc993>%s</color> Crystal dan <color=#ecc993>%s</color> Diamond.",
    ["SEA_YearMemoirDes_091"]="\nApa kamu pernah mendengar suara uang jatuh yang sangat menyenangkan?\nPergilah ke Exchange Center sekarang,\nmaka semua rejeki di sana akan jatuh di tanganmu~",
    ["SEA_YearMemoirDes_101"]="\nSelain bertarung, kehidupan life skill-mu juga sangat beragam,",
    ["SEA_YearMemoirDes_102"]="Dalam <color=#ecc993>%s</color> kali melakukan Fishing, kamu sudah menjadi Master Fishing Lv. <color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_103"]="Dalam <color=#ecc993>%s</color> kali melakukan Mining, kamu sudah menjadi Master Mining Lv. <color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_104"]="Dalam <color=#ecc993>%s</color> kali melakukan Gardening, kamu sudah menjadi Master Gardening Lv. <color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_105"]="Dalam <color=#ecc993>%s</color> kali penangkapan pet, kamu sudah memiliki <color=#ecc993>%s</color> pet yang menemanimu berkembang bersama.",
    ["SEA_YearMemoirDes_106"]="Tingkat penangkapan pet-mu adalah <color=#ecc993>%s%%</color>.",
    ["SEA_YearMemoirDes_111"]="\nApa kamu ingin mencoba kesenangan kehidupan yang lainnya?\nCoba hentikan langkah kakimu,\nuntuk merasakan luasnya dunia ini.",
    ["SEA_YearMemoirDes_Data"]="%s hingga hari ini",
    ["SEA_YearMemoirDes_Duration"]="Waktu Event",
    ["SEA_YearMemoirDes_End"]="End",
    ["SEA_YearMemoirDes_EndTime"]="Batas pengambilan: %s",
    ["SEA_YearMemoirDes_Open"]="Mulai",
    ["SEA_YearMemoirDes_RewardTips"]="Lihat memori untuk mengaktifkan reward",
    ["SEA_YearMemoirDes_Title"]="Rekap Petualangan",
    ["SEA_YearMemoirShareDes_001"]="%s, aku memasuki Rune-Midgarts dengan nama %s ....",
    ["SEA_YearMemoirShareDes_002"]="Aku telah melakukan total <color=#ecc993>%s</color> kali refine, dengan refine tertinggi sekarang mencapai +<color=#ecc993>%s</color>!",
    ["SEA_YearMemoirShareDes_003"]="Dalam <color=#ecc993>%s</color> kali pertempuran MVP dan Mini dan <color=#ecc993>%s</color> kali Instance, kamu telah menjadi pemburu monster yang legendaris!",
    ["SEA_YearMemoirShareDes_004"]="Aku sudah mengenal <color=#ecc993>%s</color> teman Adventurer di ROX.",
