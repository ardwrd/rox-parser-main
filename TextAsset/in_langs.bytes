    ["VIPCard_Tips17"]="Item Pengaktifan 30 Hari",
    ["VIPCard_Tips18"]="Item Pengaktifan 7 Hari",
    ["VIPCard_Tips20"]="Oke",
    ["VIPCard_Tips21"]="Reset Tersisa: %s",
    ["VIPCard_Tips22"]="Privilege diatur (%s)",
    ["VIPCard_Tips23"]="Daftar Privilege",
    ["VIPCard_Tips27"]="Belum mengaktifkan card, tidak ada privilege",
    ["VIPCard_Tips28"]="Pilih 7 Privilege",
    ["VIPCard_Tips29"]="Pilih 10 Privilege",
