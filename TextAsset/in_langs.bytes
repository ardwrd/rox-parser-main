    ["DialogueOption91802021"]="Emm.. sama-sama",
    ["DialogueOption91802041"]="Butuh apa?",
    ["DialogueOption91803011"]="Sama-sama!",
    ["DialogueOption91901011"]="Ah?",
    ["DialogueOption91901041"]="Bagaimana bisa bertemu?",
    ["DialogueOption91901051"]="Aku akan mencari dia",
    ["DialogueOption91902011"]="(Menjelaskan)",
    ["DialogueOption91902031"]="Bagaimana cara mempersiapkannya?",
    ["DialogueOption91902041"]="Biar aku tanya dia",
    ["DialogueOption91903011"]="(Menjelaskan)",
