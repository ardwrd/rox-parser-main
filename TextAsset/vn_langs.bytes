    ["ui_OdinBlessing_025"]="Diệt quái sẽ tự động tiêu hao <color=#d48b5f>1</color> Nhỏ, <color=#d48b5f>2</color> Vừa, <color=#d48b5f>3</color> Lớn",
    ["ui_OdinBlessing_026"]="Diệt quái chênh lệch với nhân vật chính trong vòng <color=#d48b5f>6</color> cấp mới tiêu hao Chúc Phúc Odin, hãy lưu ý cấp của quái.",
