    ["WeddingAnnouncementTips001"]="Diễu Hành Xe Hoa Lời Hứa Hoàng Hôn mà %s và %s đặt sắp long trọng tổ chức trước cổng Nhà Thờ Lớn Prontera, tham gia diễu hành còn có nhiều quà để nhận, mau đi xem nào!",
    ["WeddingButtonName101"]="Thơ Tình Hoa Trắng",
    ["WeddingButtonName102"]="Giấc Mộng Hoa Đào",
    ["WeddingButtonName103"]="Bữa Tiệc Ngọt Ngào",
    ["WeddingButtonName104"]="Tiếng Hát Biển Xanh",
    ["WeddingButtonName201"]="Cực Kỳ Xuất Sắc",
    ["WeddingButtonName202"]="Khách Đầy Nhà",
    ["WeddingButtonName203"]="Vẹn Cả Đôi Đường",
    ["WeddingButtonName204"]="Ko Còn Chỗ Trống",
    ["WeddingButtonName301"]="Hoa Bay Đầy Trời",
    ["WeddingButtonName302"]="Champagne Mộng Ảo",
    ["WeddingButtonName303"]="Tâm Đầu Ý Hợp",
    ["WeddingButtonName304"]="Chắp Cánh Bay (Trái)",
    ["WeddingButtonName305"]="Chắp Cánh Bay (Phải)",
    ["WeddingButtonName306"]="Thần Tình Yêu Đến",
    ["WeddingButtonName401"]="Chim Pecopeco Cánh Vàng",
    ["WeddingButtonName402"]="Chim Pecopeco Cánh Đỏ",
    ["WeddingButtonName403"]="Chim Pecopeco Hoàng Gia",
    ["WeddingDiologue1000101"]="Thưa quý vị, rất tiếc, do %s %s vắng mặt, Đám Cưới không thể tổ chức. Xin lỗi vì đã làm lỡ thời gian quý báu, cảm ơn bạn đã đến tham dự.",
    ["WeddingDiologue1000102"]="Đám Cưới sắp bắt đầu, mời cô dâu chú rể mau thay lễ phục.",
    ["WeddingDiologue1000103"]="Cười nói vui vẻ, trời ban may mắn. Trong ngày tươi đẹp này, mong cho hạnh phúc được dài lâu!",
    ["WeddingDiologue1000104"]="Đang tự do phát lì xì! Chúc các vị gặp nhiều may mắn, làm ăn phát tài, chúc cô dâu chú rể trăm năm hạnh phúc, bền lâu viên mãn!",
    ["WeddingDiologue1000105"]="Các vị! Mở máy ảnh nào! Hãy ghi lại khoảnh khắc mỹ mãn này!",
    ["WeddingDiologue1000106"]="Mãi mãi bên nhau! Trăm năm hạnh phúc!",
    ["WeddingDiologue1000107"]="Tiếng hò reo và vỗ tay... Không khí ngập tràn hạnh phúc ...",
    ["WeddingDiologue1000108"]="Quá vinh hạnh được cùng chứng kiến thời khắc ngọt ngào này!",
    ["WeddingDiologue1000109"]="Ôi... Đám Cưới đẹp nhất tôi từng dự!",
    ["WeddingDiologue1000110"]="Các vị, hãy cùng gửi đến cô dâu chú rể lời chúc mừng chân thành nhất!",
    ["WeddingFunctionName63001"]="Ký Khế Ước",
    ["WeddingFunctionName63002"]="Ly Hôn",
    ["WeddingFunctionName63003"]="Nhận nhiệm vụ Lễ Phục Thề Ước",
    ["WeddingFunctionName63004"]="Hủy nhiệm vụ Thề Ước",
    ["WeddingFunctionName63005"]="Chọn/Đổi Vị Chứng Hôn",
    ["WeddingFunctionName63006"]="Tổ chức lễ thề ước",
    ["WeddingFunctionName63007"]="Tổ chức Đám Cưới",
    ["WeddingFunctionName63008"]="Xem lịch trình Đám Cưới",
    ["WeddingFunctionName63009"]="Xem Đám Cưới hiện tại",
    ["WeddingFunctionName63010"]="Ly Hôn",
    ["WeddingGoodsDes10001"]="Áo Cưới, Rượu Vang, Hoa Hồng. Chuông nhà thờ vang lời thề thánh. Lễ cưới trong mơ của đôi ta.",
    ["WeddingGoodsDes10002"]="Dưới những bông hoa đào bay rợp trời, trải nghiệm một Đám Cưới như mơ đầy độc đáo và lãng mạn.",
    ["WeddingGoodsDes10003"]="Đám Cưới ngọt ngào, tuyết trắng, đèn màu, cả Người Bánh Gừng trong khay cũng mừng cho đôi ta.",
    ["WeddingGoodsDes10004"]="Nắng ban mai, sóng xô bờ cát, tiếng hát nàng người cá vang bọt sóng, chàng và nàng chung tay.",
    ["WeddingGoodsDes20001"]="Mỗi bên có <color=#ba7d7d>1</color> Thiệp Người Thân, <color=#ba7d7d>10</color> Thiệp Mời Khách",
    ["WeddingGoodsDes20002"]="Mỗi bên có <color=#ba7d7d>1</color> Thiệp Người Thân, <color=#ba7d7d>16</color> Thiệp Mời Khách",
    ["WeddingGoodsDes20003"]="Mỗi bên có <color=#ba7d7d>2</color> Thiệp Người Thân, <color=#ba7d7d>10</color> Thiệp Mời Khách",
    ["WeddingGoodsDes20004"]="Mỗi bên có <color=#ba7d7d>2</color> Thiệp Người Thân, <color=#ba7d7d>16</color> Thiệp Mời Khách",
