    ["DialogueOption30086041"]="Đó là điều tất nhiên!",
    ["DialogueOption30087031"]="Cậu không phải vì hồi sinh?",
    ["DialogueOption30088011"]="Chúng ta đến trễ rồi",
    ["DialogueOption30088021"]="Vùng Đất Tuyệt Vọng cuối cùng...",
    ["DialogueOption30088031"]="Thực sự ở đó sao?",
    ["DialogueOption30088091"]="Các cậu có tin ta không?",
    ["DialogueOption30088111"]="Lời hứa đã định!",
    ["DialogueOption30089011"]="Thư?",
    ["DialogueOption30089031"]="Tôi cũng...",
    ["DialogueOption30089081"]="Cứ giao cho tôi!",
    ["DialogueOption30089121"]="Cái này quá khó hiểu...",
    ["DialogueOption30090011"]="Ba, Baphomet!",
    ["DialogueOption30091011"]="Mục đích của cậu là gì!",
