    ["LackEnsemble"]="Không có mục tiêu liên kết hợp tấu, không thể sử dụng kỹ năng hợp tấu",
    ["LanternTip_001"]="Ở trạng thái Chúc Phúc Thỏ Ngọc không thể ăn tết Nguyên Tiêu!",
    ["LaughLarvaActivityTips_001"]="Có xác nhận chọn không",
    ["LaughLarvaActivityTips_002"]="Bạn cần chọn 1 phe trước",
    ["LaughLarvaActivityTips_003"]="Không phải phe ta không thể cho ăn",
    ["LaughLarvaActivityTips_004"]="Cho ăn thành công",
    ["LaughLarvaActivityTips_005"]="Cho ăn của tôi:",
    ["LaughLarvaActivityTips_006"]="Số lượng hiện có:",
    ["LaughLarvaActivityTips_007"]="Thời gian tổng kết cho ăn vòng này:",
    ["LaughLarvaActivityTips_008"]="Thời gian sự kiện: %s, thời gian đổi: %s",
    ["LaughLarvaActivityTips_009"]="Cho ăn tổng cộng 3 vòng, thưởng sẽ phát qua thư khi tổng kết mỗi vòng",
    ["LaughLarvaActivityTips_010"]="Cho ăn 10 lần nhận",
    ["LaughLarvaActivityTips_011"]="Nơi cho Yellow ăn",
    ["LaughLarvaActivityTips_012"]="Nơi cho Red ăn",
    ["LaughLarvaActivityTips_013"]="Tham gia sự kiện tích luỹ Xu Đổi Larva có thể đổi lượng lớn thưởng, dùng Gói Quà Thú Cưỡi Larva càng có xác suất nhận thưởng lớn Thú Cưỡi!",
    ["LaughLarvaActivityTips_014"]="Hiện không trong thời gian cho ăn, thời gian cho ăn: 05:00 - 23:00",
    ["LaughLarvaActivityTips_015"]="Đạo cụ cho ăn không đủ, có thể nhận qua gói ưu đãi hoặc lối chơi Garden Party",
    ["LaughLarvaActivityTips_016"]="Thời gian cho ăn mỗi ngày: 05:00 - 23:00",
    ["LaughLarvaActivityTips_017"]="Cho ăn tổng 3 vòng, thời gian tổng kết đại chiến vòng này:",
    ["LaughLarvaActivityTips_018"]="Không có dữ liệu BXH",
    ["LaughLarvaQuestDesc_01"]="Tham gia Đấu Xếp Hạng của Đối Đầu Vô Hạn hoặc hoàn thành phó bản bất kỳ với bạn bè 1 lần",
    ["LaughLarvaQuestDesc_03"]="Cá nhân tham gia hạng mục bất kỳ của Khu Vui Chơi 1 lần",
    ["LaughLarvaQuestDesc_04"]="Tham gia Đu Quay Ngựa Gỗ, Xe Lửa Nhỏ, Bạch Tuộc ở Khu Vui Chơi với bạn bè, bạn đời hoặc sư đồ 1 lần",
    ["LaughLarvaQuestDesc_07"]="Cho Yellow và Red ăn %s/%s lần",
    ["LaughLarvaQuestDesc_08"]="Tổ đội với bạn bè leo tháp %s/%s tầng",
    ["LaughLarvaQuestDesc_09"]="Tổ đội với bạn bè hoàn thành Phó Bản Nhóm bất kỳ %s/%s lần",
    ["LaughLarvaQuestDesc_10"]="Giao dịch thành công ở Quầy Giao Dịch %s/%s Pha Lê",
    ["LaughLarva_Get"]="Nhận từ sự kiện liên kết Larva",
    ["LaunchNotice001"]="Với game MMOPRG 3D mới nhất của RO, hãy cùng bạn bè phiêu lưu ở một thế giới khác!",
    ["LaunchNotice002"]="Bối cảnh kinh điển, nghề nghiệp kinh điển, quái vật kinh điển, tác phẩm mới kỷ niệm 20 năm của RO đã ra lò!",
    ["LeadText_1001"]="Thu thập các loại nguyên liệu quái vật rơi, có thể đến chỗ <color=#FF6F76>Miss Smile</color> đổi Cài Tóc hiếm",
    ["LeadText_101"]="Nhấp nhiệm vụ bắt đầu thám hiểm nào",
    ["LeadText_1201"]="Nhấp nút trao đổi",
    ["LeadText_1301"]="Nhấp nút <color=#FF6F76>chụp ảnh</color>",
    ["LeadText_1302"]="Nhấp đóng",
    ["LeadText_1303"]="Nhấp trở về",
    ["LeadText_1401"]="Nhấp giao",
    ["LeadText_1402"]="Xác định giao",
    ["LeadText_1501"]="Dùng <color=#FF6F76>Trọng Kích</color>",
    ["LeadText_15701"]="Nhấn giữ nút emo có thể mở vòng quay emo nhé~",
    ["LeadText_1601"]="Dùng <color=#FF6F76>Giả Chết</color>",
    ["LeadText_162_01"]="Nhấn cài đặt dùng nhanh",
    ["LeadText_162_02"]="Nhấp để chuyển đổi giữa dùng nhanh khác nhau",
    ["LeadText_163"]="Nhấn hoặc giữ để giữ kim đồng hồ duy trì ở khu vực trung tâm",
    ["LeadText_1721"]="Chọn cá con muốn thả và nhấn Thả. Mỗi lần thả đều sẽ tiêu hao Điểm Thể Lực.",
    ["LeadText_1751"]="Chọn hạt giống muốn gieo và nhấn Gieo Hạt. Mỗi lần gieo hạt đều sẽ tiêu hao Điểm Thể Lực.",
    ["LeadText_1781"]="Xem cách nhận EXP",
    ["LeadText_1791"]="Xem trước thăng cấp",
    ["LeadText_1800"]="Nhấp vào thăng cấp",
    ["LeadText_1801"]="Nhấp <color=#FF6F76>Sổ Tay Học Viện</color>",
    ["LeadText_1802"]="Nhấp xem <color=#FF6F76>Tài Liệu</color>",
    ["LeadText_1803"]="Nhấp đóng",
    ["LeadText_1804"]="Nhấp bắt đầu <color=#FF6F76>Thi Cấp Thám Hiểm</color>",
    ["LeadText_1805"]="Nhấp trở về",
    ["LeadText_1806"]="Nhấp đến <color=#FF6F76>Thi Cấp Thám Hiểm</color>",
    ["LeadText_1901"]="Nhấp dùng <color=#FF6F76>Đánh Thường</color>",
    ["LeadText_2001"]="Nhấp đổi <color=#FF6F76>Mồi Câu Pháp Thuật</color>",
    ["LeadText_2002"]="Dùng <color=#FF6F76>Mồi Câu</color> để dễ được cá hiếm hơn",
    ["LeadText_2201"]="<color=#FF6F76>Sổ Tay Học Viện</color> là <color=#FF6F76>kim chỉ nam cần thiết</color> để thám hiểm Vương Quốc Midgarts",
    ["LeadText_2301"]="<color=#FF6F76>Kỹ Năng Đời Sống</color> học kỹ năng đời sống, <color=#FF6F76>tìm kiếm</color> vật chất của cả thế giới, và <color=#FF6F76>gia công</color> thành vật cần cho thám hiểm",
    ["LeadText_2401"]="<color=#FF6F76>Tủ Áo</color> tạo phong cách ăn mặc cá tính",
    ["LeadText_2501"]="Nhấp nút <color=#FF6F76>Cường hóa</color>",
    ["LeadText_2502"]="Xác nhận <color=#FF6F76>Cường hóa</color>",
    ["LeadText_2601"]="Trong thế giới RO, Công Hội giống như là <color=#FF6F76>gia đình</color> ấm cúng, cần quan tâm xây dựng và bảo vệ",
    ["LeadText_2701"]="<color=#FF6F76>Thú Cưỡi</color> là bạn đồng hành",
    ["LeadText_2801"]="<color=#FF6F76>Lễ Hội RO</color> là lễ hội dành cho các RO-er, mọi sự kiện hạn giờ đều có trong đó, còn có <color=#FF6F76>Rương Năng Động Mỗi Ngày</color> có thể nhận",
    ["LeadText_2901"]="Nhấp <color=#FF6F76>Chúc Phúc Odin</color>",
    ["LeadText_2902"]="Nhấp <color=#FF6F76>Điểm Huấn Luyện tiến cử</color>",
