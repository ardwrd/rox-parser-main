    ["SkillTypelabel01"]="Sát thương",
    ["SkillTypelabel02"]="Buff",
    ["SkillTypelabel03"]="Cứu Viện",
    ["Skill_UIInfo_001"]="<color=#74717b>Cần %s cho</color> <color=#d14d75>%s Lv.%s</color>",
    ["Skill_UIInfo_002"]="<color=#74717b>Kỹ năng đã mãn cấp</color>",
    ["Skill_UIInfo_003"]="Xin lỗi, kỹ năng bị động không thể trang bị",
    ["Skill_UIInfo_004"]="Kỹ năng có dùng điểm kỹ năng nhưng chưa xác định, bạn chắc chắn muốn đóng?",
    ["Skill_UIInfo_005"]="Cột kỹ năng chưa cài đặt kỹ năng chủ động nào, bạn chắc chắn cài đặt như vậy?",
    ["Skill_UIInfo_006"]="Vui lòng hủy học %s trước khi thao tác",
    ["Skill_UIInfo_007"]="Phương án cộng điểm bạn chưa xác nhận sẽ bị thay thế, có muốn tiếp tục không?",
    ["Skill_UIInfo_008"]="Bạn chưa học kỹ năng này",
    ["Skill_UIInfo_009"]=" giây",
    ["Skill_UIInfo_010"]=" mét",
    ["Skill_UIInfo_011"]="Hết điểm kỹ năng có thể dùng!",
    ["Skill_UIInfo_012"]="Trang sau chưa trang bị kỹ năng nào!",
    ["Skill_UIInfo_013"]="<color=#74717b>Không thể cùng tồn tại với %s</color>",
    ["SkillsCanChangeLevels"]="Kỹ năng này sau khi trang bị có thể điều chỉnh cấp thi triển.",
    ["SlimeEvent_GuiRen_R1_1"]="Khéo léo từ chối yêu cầu nếm thử món ăn của Shion và giới thiệu thành công Gobta làm ứng cử viên mới.",
    ["SlimeEvent_GuiRen_R1_10"]="Souei hy vọng có thể tra khảo thủ lĩnh phe địch cùng với tôi. Cảnh tượng đó có lẽ sẽ rất đẫm máu, nên tôi đã từ chối anh ấy.",
    ["SlimeEvent_GuiRen_R1_2"]="Tình cờ gặp Shion và Shuna, những người \"bạn\" đang làm công việc thư ký, và trốn thoát trước khi bầu không khí trở nên kỳ lạ hơn.",
    ["SlimeEvent_GuiRen_R1_3"]="Được Hakurou mời để tiến hành một khóa huấn luyện đặc biệt kéo dài một tuần dành cho Goblin, lấy lý do \"tin tưởng năng lực huấn luyện của ngài\" để từ chối.",
    ["SlimeEvent_GuiRen_R1_4"]="Đi ngang qua nhà Hakurou, Hakurou nhiệt tình mời tôi nhận những bông hoa anh ấy mới trồng, nhưng tôi từ chối vì tôi không giỏi trồng hoa.",
    ["SlimeEvent_GuiRen_R1_5"]="Benimaru muốn đặt tên cho nhóm Tinh Anh mới là \"Đội Rimuru\", nhưng vì cái tên này thật đáng xấu hổ nên anh đã bị từ chối rất thẳng thừng.",
    ["SlimeEvent_GuiRen_R1_6"]="Từ xa đã nhìn thấy Benimaru và những cán bộ khác thi uống rượu bằng những chiếc cốc siêu lớn, nhanh chóng rời khỏi nơi này trước khi bị kéo vào cuộc thi.",
    ["SlimeEvent_GuiRen_R1_7"]="Shuna đan cho tôi một chiếc mũ màu hồng, nhưng chiếc mũ cũ vẫn còn dùng được nên tôi đã từ chối cô ấy theo cách dịu dàng nhất.",
    ["SlimeEvent_GuiRen_R1_8"]="Shuna hy vọng rằng tôi có thể chọn một bộ trang phục nữ phù thủy để cô ấy mặc trong lễ tế, nhưng do thiếu kinh nghiệm ở kiếp trước nên đã từ chối cô ấy.",
    ["SlimeEvent_GuiRen_R1_9"]="Souei đề nghị tôi tăng số lượng hộ vệ xung quanh, nhưng từ chối anh ấy với lý do \"Souei có mặt là rất yên tâm\".",
    ["SlimeEvent_GuiRen_R2_1"]="Để khen thưởng cho thành quả công việc thư ký của Shion, quyết tâm chết để ăn hết món ăn yêu thích nhưng may mắn sống sót!",
    ["SlimeEvent_GuiRen_R2_2"]="Để đáp lại yêu cầu của Hakurou, đã tưới những bông hoa bằng một lượng lớn tinh chất ma thuật, nuôi dưỡng thành công hoa xác thối lớn có thể nuốt chửng Gobta chỉ bằng một miếng!",
    ["SlimeEvent_GuiRen_R2_3"]="Chiến đấu với kẻ địch với đội thám hiểm do Benimaru dẫn đầu, giành chiến thắng mà không có thương vong và nhận được rất nhiều chiến lợi phẩm!",
    ["SlimeEvent_GuiRen_R2_4"]="Được Shuna mời tham gia lễ tế của Kijin, những đứa trẻ của Kijin rất dễ thương, thức ăn của Kijin cũng rất tuyệt!",
    ["SlimeEvent_GuiRen_R2_5"]="Phải mất một ngày để xem tình báo bí mật do Souei gửi và thu được rất nhiều thông tin về các quan chức cấp cao của con người.",
    ["SlimeEvent_GuiRen_R3_1"]="Mơ thấy Shion rời bỏ mình lần nữa nên tâm trạng vô cùng chán nản, sau khi bị phát hiện, đã thề \"không bao giờ rời xa\".",
    ["SlimeEvent_GuiRen_R3_2"]="Đặt tên cho Kijin trẻ trong buổi lễ trưởng thành của Kijin, mối liên kết với mọi người lại được củng cố!",
    ["SlimeEvent_GuiRen_R3_3"]="Đến thăm người bảo vệ rừng Jura cùng với Kijin - Treyni, và nhận được chúc phúc của yêu tinh cây sau khi được xác nhận!",
    ["SlimeEvent_TY1"]="Giúp gia cố cây cầu gỗ trong rừng, hiện có thể chứa được nhiều người hơn.",
    ["SlimeEvent_TY10"]="Những cánh hoa anh đào màu hồng bay tới từ phía xa, cảm thấy dễ chịu hơn rất nhiều sau khi ngửi thấy mùi thơm.",
    ["SlimeEvent_TY11"]="Cho những chú chim nhỏ dễ thương bên đường ăn và chạm vào lớp lông nhung mềm mại của chúng.",
    ["SlimeEvent_TY12"]="Phát hiện một túp lều đổ nát trong rừng, có lẽ có thể dùng để tổ chức Cuộc Thi Dũng Cảm.",
    ["SlimeEvent_TY13"]="Con suối trên núi chảy róc rách, chơi đùa dưới nước cùng những người bạn đồng hành.",
    ["SlimeEvent_TY14"]="Vì tò mò, đã ăn một loại quả dại không rõ nguồn gốc, may là không bị ngộ độc.",
    ["SlimeEvent_TY15"]="Gặp gỡ những du khách thân thiện, cùng nhau trải qua khoảng thời gian khó quên.",
    ["SlimeEvent_TY16"]="Leo lên đỉnh Mjolnir, đã nhìn thấy cảnh bình minh tuyệt đẹp trước khi kiệt sức.",
    ["SlimeEvent_TY17"]="Đã gặp Nhà Thông Thái vĩ đại Kroneika ẩn cư, và ở lại qua đêm trong căn nhà nhỏ của Nhà Thông Thái...",
    ["SlimeEvent_TY18"]="Đã gặp Giearth thân thiện ở chỗ Đá Quặng và nếm thử rượu mạnh của chúng.",
    ["SlimeEvent_TY19"]="Đã gặp Hồn Ma Trắng lang thang, dường như nghe thấy tiếng \"Cảm ơn\" sau khi đánh bại chúng.",
    ["SlimeEvent_TY2"]="Gặp Người Hát Rong, nghe được nhiều truyền thuyết về Storm Dragon Veldora.",
    ["SlimeEvent_TY20"]="Tình cờ gặp Jarod đang trốn việc ở Quán Rượu Hoa Hồng, đưa anh ta trở lại vị trí làm việc để tiếp tục công việc.",
    ["SlimeEvent_TY21"]="Điểm Nhật Ký Thám Hiểm Mới được cập nhật ở chỗ W, Độ Khám Phá Thế Giới đã chính thức tăng lên!",
    ["SlimeEvent_TY22"]="Sau khi nghe bài hát mới của Arielle, cảm thấy tâm hồn đã được chữa lành!",
    ["SlimeEvent_TY23"]="Đưa thư cho một con vẹt ốm, mới cảm nhận được sự vất vả của một người đưa thư sau khi chạy khắp hang cùng ngõ hẻm.",
    ["SlimeEvent_TY24"]="Ở Payon, tôi đã thấy một loại Poring Mới - Poporing, hóa ra có màu xanh lục!",
    ["SlimeEvent_TY25"]="Búp măng tươi mềm được đào trong rừng trúc Payon, hầm với thịt thành món canh thơm ngon.",
    ["SlimeEvent_TY26"]="Lắng nghe Người Hát Rong kể những truyền thuyết cổ xưa về các kim tự tháp, kiến ​​thức du lịch đã tăng lên!",
    ["SlimeEvent_TY27"]="Phát hiện một ốc đảo sâu trong sa mạc, tiếp tục thám hiểm sau khi bổ sung vật tư nào!",
    ["SlimeEvent_TY28"]="Đã tham gia lễ hội pháo hoa địa phương ở Geffen, hóa ra pháo hoa cũng có thể bắn ra từ cây đũa thần...",
    ["SlimeEvent_TY29"]="Đã bắt được con ma cà rồng lẻn vào Tháp Geffen, nghe nói sau đó nó sẽ bị các Ma Pháp Sư sử dụng làm vật thí nghiệm...",
    ["SlimeEvent_TY3"]="Gặp Milim muốn ăn mật ong, bèn đưa cho cô ấy tất cả đồ ngọt trong túi.",
    ["SlimeEvent_TY30"]="Vô tình kích hoạt bẫy của Thư Viện Geffen, không ngờ bị dịch chuyển đến chân tháp!",
    ["SlimeEvent_TY31"]="Sau khi bị nước ở Đài Phun Nước Trung Tâm làm cho ướt sũng, đã bị hắt hơi ngay tại chỗ, may là không bị cảm lạnh.",
    ["SlimeEvent_TY32"]="Không thể mượn cuốn sách mong muốn ở Thư Viện Prontera, quyết định đến Thư Viện Geffen xem thử.",
    ["SlimeEvent_TY33"]="Bị lạc trong chuyến phiêu lưu ở Rừng Labyrinth, đi bộ mất một ngày mới tìm được lối ra.",
    ["SlimeEvent_TY34"]="Chủ tiệm đã nghỉ khi mua Trang Bị, vậy thì đi chơi ở Alberta một tuần vậy.",
    ["SlimeEvent_TY35"]="Đến Hầm Mỏ Mjolnir đào mỏ, nhưng không may cuốc đào bị gãy giữa chừng nên đành phải quay về đường cũ.",
    ["SlimeEvent_TY36"]="Khi ra khơi gặp bão lớn nhưng rất may thuyền không bị lật.",
    ["SlimeEvent_TY37"]="Sau khi hít phải bột gai của Nấm Quỷ, nằm trên mặt đất một lúc lâu mới hồi phục.",
    ["SlimeEvent_TY38"]="Rơi vào Động Cương Thi, giả làm đồng loại của chúng mới trốn thoát được.",
    ["SlimeEvent_TY39"]="Thám hiểm trong sa mạc ở Morroc, khi trở về phát hiện làn da đã rám nắng.",
    ["SlimeEvent_TY4"]="Ngủ thiếp đi trên lưng Ranga, trải qua cả ngày uể oải như thế này.",
    ["SlimeEvent_TY40"]="Gặp hội trưởng Hassan của Công Hội Sát Thủ, dường như anh ta còn đáng sợ hơn khi kiềm chế sát khí...",
    ["SlimeEvent_TY41"]="Đã hoàn thành ủy thác đặc biệt trên Bảng Ủy Thác, được Quân Phòng Vệ Vương Quốc tuyên dương.",
    ["SlimeEvent_TY42"]="Chơi với những chú Thỏ Điên dễ thương cả ngày, có thể nhận nuôi một con làm Pet...",
    ["SlimeEvent_TY43"]="Tình cờ gặp giáo sư thuật luyện kim Lawrence, đã chặn ngăn hành vi ông ta coi bản thân làm đối tượng thí nghiệm.",
    ["SlimeEvent_TY44"]="Giúp ngài Gray thu hoạch lúa mì ở Nông Trường Xanh, trải qua một ngày nông trại trọn vẹn.",
    ["SlimeEvent_TY45"]="Ước một điều ước dưới gốc Cây Ước Nguyện, hy vọng một ngày nào đó điều ước của bản thân sẽ thành hiện thực.",
    ["SlimeEvent_TY46"]="Được Morts tặng vé ngồi ở hàng đầu tiên của buổi hòa nhạc, nghe câu chuyện của bản thân được hát thành lời ở khoảng cách gần.",
    ["SlimeEvent_TY47"]="Đi qua di tích Poring, đã gặp được Angeling và Vua Poring trong truyền thuyết!",
    ["SlimeEvent_TY48"]="Tận mắt chứng kiến sự biến mất của Khe Nứt Thời Gian, nhặt được những đạo cụ quý giá tại chỗ.",
    ["SlimeEvent_TY49"]="Đi ngang qua Lò Phép trục trặc, không may bị khói đen phun ra làm cho sặc.",
    ["SlimeEvent_TY5"]="Gặp thợ rèn tộc Dwarf và biết được rằng rượu từ Vương Quốc Quái Vật rất được tộc Dwarf ưa chuộng.",
    ["SlimeEvent_TY50"]="Uống say trong Quán Rượu Hoa Hồng, may là không có chuyện gì đáng xấu hổ xảy ra.",
    ["SlimeEvent_TY51"]="Dây câu bị một con cá khổng lồ làm đứt khi đang câu, tin rằng lần sau nhất định sẽ chinh phục được nó!",
    ["SlimeEvent_TY52"]="Tới động dưới đáy biển để tìm kho báu, mặc dù trở về tay không nhưng gặp được một Người Cá xinh đẹp.",
    ["SlimeEvent_TY53"]="Đã mua được thứ mong muốn tại Quầy Giao Dịch nhưng dường như ví của tôi đã trống rỗng.",
    ["SlimeEvent_TY54"]="Đã gặp Ma Pháp Sư bán thuốc thay đổi giới tính nhưng từ chối việc chào hàng của đối phương.",
    ["SlimeEvent_TY55"]="Sau khi uống lọ Thuốc Phép Trí Lực do Geffen sản xuất, cảm thấy bị lừa dối...",
    ["SlimeEvent_TY56"]="Đã gặp con mèo đen bí ẩn ở một góc của Geffen, hóa ra là do con người biến thành!",
    ["SlimeEvent_TY57"]="Vật tay với lũ trẻ Làng Orc, chiến thắng gay cấn.",
    ["SlimeEvent_TY58"]="Giao tiếp với thủ lĩnh Orc, cổ rất đau vì luôn phải ngẩng lên.",
    ["SlimeEvent_TY59"]="Giúp tiểu thư Lindra sắp xếp các kệ hàng, được biết trước về các sản phẩm mới.",
    ["SlimeEvent_TY6"]="Gặp Treyni đang ăn khoai tây chiên và chứng kiến ​​sự biến mất của túi khoai tây chiên ngoại cỡ.",
    ["SlimeEvent_TY60"]="Được Hollgrehenn tặng cuốn \"Một Trăm Cách Luyện Cơ Bắp\", vừa hay có thể dùng làm đệm chân bàn.",
    ["SlimeEvent_TY61"]="Đã gặp Kỵ Sĩ Tanders ở Tháp Cối Xay Gió và được nghe rất nhiều câu chuyện thám hiểm.",
    ["SlimeEvent_TY62"]="Giúp ngài Taksch bắt Pet và hẹn nhau trong chuyến đi tiếp theo.",
    ["SlimeEvent_TY63"]="Giành chiến thắng trong cuộc thi uống rượu ở Quán Rượu Sapphire và nhận thưởng phong phú!",
    ["SlimeEvent_TY64"]="Là khách hàng thứ 10.000 vào Khu Vui Chơi Cổng Nam, đã chơi miễn phí trong khu vui chơi trong một ngày.",
    ["SlimeEvent_TY65"]="Đã gặp các thành viên của Hội Eden đang khảo sát ở Prontera, đã được phổ cập rất nhiều về lịch sử của Vương Quốc Rune.",
    ["SlimeEvent_TY66"]="Đã đến thăm Viện Trưởng Mainz của Học Viện Criatura, có một bữa tối vui vẻ với các thầy hướng dẫn của học viện.",
    ["SlimeEvent_TY67"]="Sau khi bị trúng Poring từ trên trời rơi xuống, đã trải qua một ngày trong sự bàng hoàng.",
    ["SlimeEvent_TY68"]="Sau khi đi ngang qua Nghĩa Trang U Hồn, đã gặp ác mộng vào ban đêm và quyết định cầu nguyện dưới Tượng Thần Odin vào ngày mai.",
    ["SlimeEvent_TY69"]="Chứng kiến ​​toàn bộ quá trình Thợ Rèn Hollgrehenn bị một khách hàng đánh đập dã man, may là không liên lụy đến bản thân.",
    ["SlimeEvent_TY7"]="Gặp nhóm thám hiểm truy tìm kho báu, họ đã ngay lập tức chạy trốn sau khi được biết rằng đây là Vương Quốc Quái Vật.",
    ["SlimeEvent_TY70"]="Nghe hành khúc của bộ tộc Orc, tuy không hiểu nhưng tinh thần chiến đấu đã tăng lên!",
    ["SlimeEvent_TY71"]="Đi qua lãnh thổ của tộc Kobold, anh ta trả phí cầu đường bằng một miếng thịt khô.",
    ["SlimeEvent_TY72"]="Chờ mưa sao băng đến ở Đình Hồ Tâm trong Rừng Kordt, vô tình ngủ quên mất.",
    ["SlimeEvent_TY73"]="Đã nhìn thấy Totem Thần Khuyển của tộc Kobold, nhưng đáng tiếc là cấm loài người chạm vào.",
    ["SlimeEvent_TY74"]="Học được kiến ​​thức giám định từ ngài Vali, ông ấy đề nghị tôi nên bắt đầu bằng cách học cách tiết kiệm thuốc giám định...",
    ["SlimeEvent_TY75"]="Khi ngồi Tàu Bay đến điểm dừng tiếp theo, không may bị say...",
    ["SlimeEvent_TY76"]="Tình cờ gặp Phreeoni trong hang động để tránh mưa, may là nó đã được ăn no...",
    ["SlimeEvent_TY77"]="Quan sát quá trình huấn luyện hàng ngày của Đoàn Kỵ Sĩ Hoàng Gia, đã khơi gợi kỹ năng chiến đấu mới.",
    ["SlimeEvent_TY78"]="Lắng nghe những lời giảng dạy của Tổng Giám Mục Wolmas, càng tăng thêm sự ngưỡng mộ đối với Thần Odin.",
    ["SlimeEvent_TY79"]="Nhận được lời hỏi thăm của Công Ty Kafra, hy vọng tôi có thể đánh giá về dịch vụ giao hàng của họ.",
    ["SlimeEvent_TY8"]="Đợi Nhà Thông Thái cập nhật tin tức về Wonderland, ở lại đây một lúc rồi lại xuất phát.",
    ["SlimeEvent_TY80"]="Chọc tổ ong trên cây, chẳng những không có ong mà còn có mật ngọt!",
    ["SlimeEvent_TY81"]="Hỗ trợ Quân Phòng Vệ Vương Quốc xử lý lũ quái vật trong đường hầm, và tình bạn đặc biệt đã nảy sinh!",
    ["SlimeEvent_TY82"]="Công nương Kaitlyn đã mời tôi dự tiệc tối trong cung điện, đã ăn được rất nhiều món ăn ngon!",
    ["SlimeEvent_TY83"]="Tình cờ nghe được buổi hòa nhạc ngoài trời của Châu Chấu Vocal, hóa ra trong đám quái vật có những nhạc công cừ khôi.",
    ["SlimeEvent_TY84"]="Ngồi Khinh Khí Cầu Poring để ngắm bầu trời Prontera, tận hưởng khung cảnh tuyệt đẹp.",
    ["SlimeEvent_TY9"]="Gặp những công nhân vận chuyển Muspellium, giúp họ nhặt quặng bị rơi và rời đi.",
    ["SlimeEvent_XiRen_R1_1"]="Bắt gặp Gabiru đang bị Milim đánh đập dã man, dứt khoát bỏ đi sau một lúc suy nghĩ.",
    ["SlimeEvent_XiRen_R1_10"]="Sau khi nhận được Thơ Ca Ngợi có chữ ký của Gabiru, quyết định chưa mở nó ra vội...",
    ["SlimeEvent_XiRen_R1_2"]="Nhìn thấy Gabiru bị ai đó đánh bay lên không trung, tin rằng anh ta có thể tung ra đôi cánh nên yên tâm rời đi.",
    ["SlimeEvent_XiRen_R1_3"]="Khi gặp Gabiru đang trải qua khóa huấn luyện chiến đấu đặc biệt với Hakurou, đã đặt thuốc chữa thương xuống một cách chu đáo và rời đi.",
    ["SlimeEvent_XiRen_R1_4"]="Abiru hy vọng rằng tôi có thể thuyết phục Souka tìm đồng đội càng tốt, nghĩ đến sự tồn tại của Souei nên đã từ chối.",
    ["SlimeEvent_XiRen_R1_5"]="Gabiru nói với tôi rằng \"Souka không còn bám lấy anh trai như hồi còn nhỏ nữa\", không thể đồng cảm nên đã kết thúc cuộc trò chuyện từ sớm.",
    ["SlimeEvent_XiRen_R1_6"]="Nhìn thấy Gabiru đang dạy những đứa trẻ Goblin hát, rời đi sau khi bày tỏ sự mong đợi về thành quả.",
    ["SlimeEvent_XiRen_R1_7"]="Nghe thấy bộ ba Lizardman hét lên \"Quả nhiên là đại nhân Gabiru\", rời đi mà không biết phải trả lời như thế nào.",
    ["SlimeEvent_XiRen_R1_8"]="Thấy Lizardman nhảy nhót trên ruộng lúa, nhắc nhở họ không giẫm lên mạ rồi bỏ đi.",
    ["SlimeEvent_XiRen_R1_9"]="Nhìn thấy Souka và Souei cùng thực hiện nhiệm vụ, rời đi sau khi nói \"Cố lên\".",
    ["SlimeEvent_XiRen_R2_1"]="Sau khi nhận được các loại thảo dược mới được trồng từ tộc Thằn Lằn, có thể sản xuất ra những loại thuốc chữa bệnh hiệu quả hơn trong tương lai!",
    ["SlimeEvent_XiRen_R2_2"]="Xem Gabiru và nhóm ba người khiêu vũ tại lễ hội sẽ làm tăng thêm không khí của ngày lễ!",
    ["SlimeEvent_XiRen_R2_3"]="Năm mới rút thẻ, Gabiru và nhóm ba người đều rút được thưởng lớn, năm sau nhất định sẽ suôn sẻ!",
    ["SlimeEvent_XiRen_R2_4"]="Đã đến thăm những cánh đồng lúa do Lizardman phụ trách, chỉ cần có đủ nguồn nước thì nhất định sẽ có một vụ mùa bội thu!",
    ["SlimeEvent_XiRen_R2_5"]="Thử ngồi trên Thú Cưỡi của Lizardman để du ngoạn là một trải nghiệm rất đặc biệt!",
    ["SlimeEvent_XiRen_R3_1"]="Lắng nghe Abiru kể về lịch sử của Lizardman là \"Hậu duệ của Rồng\", đã có được kiến ​​thức cổ xưa.",
    ["SlimeEvent_XiRen_R3_2"]="Sau khi nhiệt độ giảm xuống, Gabiru dường như cực kỳ buồn ngủ, hóa ra các loài lưỡng cư trong thế giới này cũng ngủ đông ư...",
    ["SlimeEvent_XiRen_R3_3"]="Xin nhờ Shuna chuẩn bị áo tắm mùa hè cho Souka, đợi đến mùa hè là có thể đi biển chơi rồi!",
    ["SlimeEvent_ZhuTou_R1_1"]="Nhìn thấy Gerudo chơi với lũ Goblin nhỏ, bí mật rời đi vì không muốn phá hỏng bầu không khí.",
    ["SlimeEvent_ZhuTou_R1_10"]="Thỉnh thoảng nghe thấy phụ nữ Orc tỏ tình với Gerudo, sau đó giả vờ như không biết gì rồi rời đi.",
    ["SlimeEvent_ZhuTou_R1_2"]="Được Orc từng đặt tên nhận ra, nhưng hoàn toàn không nhớ ra đối phương, chỉ có thể mỉm cười đáp lại.",
    ["SlimeEvent_ZhuTou_R1_3"]="Làm việc với mọi người của Orc đến tối, và vô tình ngủ thiếp đi trong sự mệt mỏi tột độ.",
    ["SlimeEvent_ZhuTou_R1_4"]="Đi ngang qua nhà mới của Orc, từ chối lời mời ăn cơm vì bận việc khác.",
    ["SlimeEvent_ZhuTou_R1_5"]="Đặt tên cho trẻ mới sinh của Orc, nhưng không giỏi đối phó với những đứa trẻ nhiệt tình, vì vậy đã bỏ đi sau khi đặt tên.",
    ["SlimeEvent_ZhuTou_R1_6"]="Gerudo hỏi tôi về kỹ thuật canh tác, đã rời đi sau khi mang đến một cuốn sách canh tác từ Vương Quốc Loài Người.",
    ["SlimeEvent_ZhuTou_R1_7"]="Bím tóc của cô bé Goblin rất đáng yêu, sau khi biết là do Gerudo tết, cô bé đã tươi cười rời đi.",
    ["SlimeEvent_ZhuTou_R1_8"]="Khi gặp Hakurou đang học kỹ năng chiến đấu của Gerudo, đã nói \"Cố lên\" rồi rời đi.",
    ["SlimeEvent_ZhuTou_R1_9"]="Khi mua đồ, gặp Gerudo đang cầm theo một túi lớn đồ ăn vặt dành cho trẻ con và rời đi sau khi từ chối lời đề nghị giúp xách đồ của anh ta.",
    ["SlimeEvent_ZhuTou_R2_1"]="Đã gặp Gerudo tại Hội Thi Giã Mochi, và ăn bánh mochi ngon tuyệt có hình con heo cùng những Goblin nhỏ!",
    ["SlimeEvent_ZhuTou_R2_2"]="Đã gặp người Orc đang lang thang bên ngoài, và sau khi đặt tên cho anh ta, số lượng cư dân ở Quỷ Quốc lại tăng lên!",
    ["SlimeEvent_ZhuTou_R2_3"]="Tại lễ hội, đã gặp Gerudo đang đóng giả thành Ma Vương, không đánh bại anh ta nhưng đã nhận được phần thưởng!",
    ["SlimeEvent_ZhuTou_R2_4"]="Nhận được món quà từ Orc, hóa ra đó là một bản khắc gỗ có hình dạng của Slime!",
    ["SlimeEvent_ZhuTou_R2_5"]="Đã thu thập các đề xuất phát triển nông nghiệp từ Orc tại Hội nghị Quỷ Quốc và quyết định khởi động vào tháng tới!",
    ["SlimeEvent_ZhuTou_R3_1"]="Hãy cùng Gerudo tế bái những Orc đã quá cố, nếu họ vẫn còn sống sẽ không chết đói...",
    ["SlimeEvent_ZhuTou_R3_2"]="Tăng thêm thiết bị đuổi chim ở đồng ruộng cho Orc, năm nay nhất định sẽ có một vụ mùa bội thu!",
    ["SlimeEvent_ZhuTou_R3_3"]="Đã chuẩn bị quần áo mùa đông mới cho Gerudo, mặc dù không sợ lạnh nhưng cũng phải mặc đầy đủ!",
