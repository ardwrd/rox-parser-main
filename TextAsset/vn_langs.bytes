    ["WeddingListDes10001"]="Thơ Tình Hoa Trắng",
    ["WeddingListDes10002"]="Dưới những bông hoa đào bay rợp trời, trải nghiệm một Đám Cưới như mơ đầy độc đáo và lãng mạn.",
    ["WeddingListDes10003"]="Đám Cưới ngọt ngào, tuyết trắng, đèn màu, cả Người Bánh Gừng trong khay cũng mừng cho đôi ta.",
    ["WeddingListDes10004"]="Nắng ban mai, sóng xô bờ cát, tiếng hát nàng người cá vang bọt sóng, chàng và nàng chung tay.",
    ["WeddingListDes20001"]="Mỗi bên được Thiệp Mời Người Thân *<color=#ba7d7d>1</color>+ Thiệp Mời Khách *<color=#ba7d7d>10</color>",
    ["WeddingListDes20002"]="Mỗi bên được Thiệp Mời Người Thân *<color=#ba7d7d>1</color>+ Thiệp Mời Khách *<color=#ba7d7d>16</color>",
    ["WeddingListDes20003"]="Mỗi bên được Thiệp Mời Người Thân *<color=#ba7d7d>2</color>+ Thiệp Mời Khách *<color=#ba7d7d>10</color>",
    ["WeddingListDes20004"]="Mỗi bên được Thiệp Mời Người Thân *<color=#ba7d7d>2</color>+ Thiệp Mời Khách *<color=#ba7d7d>16</color>",
    ["WeddingListDes30001"]="Hoa Bay Đầy Trời 5 cái",
    ["WeddingListDes30002"]="Hoa Bay Đầy Trời 10 cái",
    ["WeddingListDes30003"]="Hoa Bay Đầy Trời 15 cái",
