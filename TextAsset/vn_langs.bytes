    ["OXExam_Question093"]="Sinh vật có nhiều nhất trong đại dương là <color=#F2C730FF>Cá Ăn Thịt Người Biến Dị</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question093_1"]="Sinh vật phù du có nhiều nhất trong đại dương",
    ["OXExam_Question094"]="<color=#F2C730FF>Mắt trong tổ ong</color> của Ong Chúa<color=#F2C730FF> có hình tròn</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question094_1"]="Mắt tổ ong có hình lục giác đều",
    ["OXExam_Question095"]="Than chì được dùng làm ruột bút chì, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question096"]="Thành viên đội cứu hộ Geffen có thể vừa <color=#F2C730FF>trồng cây chuối</color> vừa <color=#F2C730FF>ăn đồ ăn</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question097"]="<color=#F2C730FF>Cối Xay Gió</color> ở Cổng Tây Prontera có tác dụng chủ yếu là để <color=#F2C730FF>thoát nước</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question098"]="Thành viên <color=#F2C730FF>đội phục vụ Kafra</color> tuy chỉ mặc 1 bộ đồng phục duy nhất nhưng mỗi người có <color=#F2C730FF>size riêng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question099"]="<color=#F2C730FF>Những cặp đôi hẹn hò</color> ở Cổng Nam Prontera thích nhất là được cưỡi <color=#F2C730FF>Ngựa Gỗ Đôi</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question100"]="Có thể ngồi mãi ở băng ghế dài tại Cổng Nam Prontera, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question100_1"]="Thời gian sử dụng băng ghế dài của mỗi người đều có giới hạn",
    ["OXExam_Question101"]="<color=#F2C730FF>Thuốc Độc</color> là <color=#F2C730FF>vật tiêu hao</color> không thể thiếu của <color=#F2C730FF>Cung Thủ</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question101_1"]="Thuốc Độc là vật phẩm không thể thiếu của Đạo Chích",
    ["OXExam_Question102"]="Quan hệ tốt với <color=#F2C730FF>Hollgrehenn</color> sẽ tăng tỉ lệ thành công khi <color=#F2C730FF>cường hóa trang bị</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question103"]="Thấu kính có viền <color=#F2C730FF>dày hơn</color> so với phần giữa được gọi là <color=#F2C730FF>Thấu Kính Lồi</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question103_1"]="Thấu kính có phần viền dày hơn phần giữa gọi là Thấu Kính Lõm",
    ["OXExam_Question104"]="Cá Biến Dị có <color=#F2C730FF>tai</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question105"]="<color=#F2C730FF>Heo Rừng Nhỏ</color> khi vui vẻ <color=#F2C730FF>đuôi</color> sẽ <color=#F2C730FF>vẫy ngang</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question106"]="<color=#F2C730FF>Tôm Càng To</color> nhờ vào <color=#F2C730FF>mũi</color> để hít thở, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question106_1"]="Tôm Càng To hít thở qua mang",
    ["OXExam_Question107"]="<color=#F2C730FF>Chim Pecopeco</color> có lúc sẽ ăn <color=#F2C730FF>viên sỏi nhỏ</color> để <color=#F2C730FF>hỗ trợ tiêu hóa</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question108"]="<color=#F2C730FF>Dơi Hút Máu</color> không thuộc <color=#F2C730FF>loài chim</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question109"]="<color=#F2C730FF>Trên quả táo</color> bộ phận ngọt nhất là phần <color=#F2C730FF>đáy</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question109_1"]="Trên quả táo bộ phận ngọt nhất là phần đỉnh",
    ["OXExam_Question110"]="<color=#F2C730FF>Hạt tiêu</color> không phải là một loại rau củ, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question111"]="<color=#F2C730FF>Khăn ướt</color> được coi là <color=#F2C730FF>rác ướt</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question111_1"]="Khăn ướt được coi là rác khô",
    ["OXExam_Question112"]="<color=#F2C730FF>Nho khô</color> được coi là <color=#F2C730FF>rác khô</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question112_1"]="Nho khô được coi là rác ướt",
    ["OXExam_Question113"]="<color=#F2C730FF>Khả năng thăng bằng</color> của Arielle rất mạnh là do có <color=#F2C730FF>đại não</color> cực kỳ phát triển, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question113_1"]="Tiểu não mới quyết định khả năng thăng bằng",
    ["OXExam_Question114"]="<color=#F2C730FF>Ngó Sen</color> là <color=#F2C730FF>gốc</color> của <color=#F2C730FF>Sen</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question114_1"]="Là thân",
    ["OXExam_Question115"]="<color=#F2C730FF>Vảy</color> của Cá Ăn Thịt Người Biến Dị có nhiều vân tuổi, mỗi vân đại diện <color=#F2C730FF>1 tuổi</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question115_1"]="Vảy cá mỗi vân đại diện cho 6 tháng tuổi",
    ["OXExam_Question116"]="<color=#F2C730FF>Màu đen</color> có thể hấp thụ toàn bộ 7 màu sắc của ánh sáng mặt trời, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question117"]="<color=#F2C730FF>Cá mập</color> sinh ra từ trứng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question117_1"]="Cá mập sinh ra từ bào thai",
    ["OXExam_Question118"]="<color=#F2C730FF>Mây</color> và <color=#F2C730FF>sương</color> có vật chất về cơ bản là tương đồng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question119"]="Coco của Payon vì kén ăn nên mắc bệnh mất ngủ, nguyên nhân là do thiếu vitamin B, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question119_1"]="Bệnh mất ngủ là do thiếu hụt vitamin A",
    ["OXExam_Question120"]="Coco của Payon khi ngủ có lúc nghiến răng, nguyên nhân là do thiếu Kẽm, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question121"]="Bờ biển Đảo Izlude <color=#F2C730FF>mùa hè</color> thường xuất hiện hiện tượng <color=#F2C730FF>ảo ảnh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question122"]="Sát thương gây ra từ đòn <color=#F2C730FF>Pháp Công</color> bị ảnh hưởng bởi <color=#F2C730FF>thể hình của mục tiêu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question122_1"]="Sát thương gây ra từ Pháp Công không bị ảnh hưởng bởi thể hình",
    ["OXExam_Question123"]="Lượng HP và EXP của 3 loại thể hình quái bé, vừa, lớn <color=#F2C730FF>cùng cấp</color> sẽ <color=#F2C730FF>tăng dần đều</color> theo tỉ lệ, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question124"]="Tấn công <color=#F2C730FF>hệ Độc</color> đối với <color=#F2C730FF>toàn bộ hệ</color> đều tăng thêm sát thương, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question124_1"]="Công Kích Độc chỉ tăng sát thương đối với vài thuộc tính",
    ["OXExam_Question125"]="<color=#F2C730FF>Tốc Đánh</color> và <color=#F2C730FF>Tốc Đánh Cuối</color> không cùng 1 loại thuộc tính, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question126"]="<color=#F2C730FF>Bạo Kích</color> và <color=#F2C730FF>Bạo Kích Cuối</color> là cùng 1 loại thuộc tính, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question126_1"]="Bạo Kích và Bạo Kích Cuối không cùng 1 loại thuộc tính",
    ["OXExam_Question127"]="<color=#F2C730FF>Né</color> và <color=#F2C730FF>Né Cuối</color> cùng 1 loại thuộc tính, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question127_1"]="Né và Né Cuối không cùng 1 loại thuộc tính",
    ["OXExam_Question128"]="Sau khi dùng <color=#F2C730FF>Bôi Độc</color> hệ đánh thường sẽ có <color=#F2C730FF>hệ Độc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question128_1"]="Sau khi sử dụng Bôi Độc Chí Mạng đòn đánh thường sẽ có hệ Độc",
    ["OXExam_Question129"]="Sau khi dùng <color=#F2C730FF>Cơn Giận Bùng Nổ</color> đánh thường sẽ có <color=#F2C730FF>hệ Lửa</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question130"]="Sau khi dùng <color=#F2C730FF>Cầu Phúc Vẩy Nước</color> thuộc tính đánh thường của mục tiêu sẽ có <color=#F2C730FF>Hệ Thánh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question131"]="Chỉ <color=#F2C730FF>Thương Gia</color> mới có thể mở <color=#F2C730FF>Chợ Trời</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question131_1"]="Pet có đặc tính kinh doanh có thể mở Chợ Trời",
    ["OXExam_Question132"]="Hàng ngày <color=#F2C730FF>12:00</color> và <color=#F2C730FF>20:00</color> trong <color=#F2C730FF>Prontera</color> sẽ nhận thêm điểm <color=#F2C730FF>Chúc Phúc Odin</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question133"]="Thông qua tăng <color=#F2C730FF>Cấp Tốc</color> có thể giảm <color=#F2C730FF>thời gian vận công kỹ năng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question134"]="<color=#F2C730FF>MVP</color> và <color=#F2C730FF>Mini</color> có <color=#F2C730FF>thời gian hồi sinh</color> như nhau, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question134_1"]="MVP và Mini có thời gian hồi sinh khác nhau",
    ["OXExam_Question135"]="Trong <color=#F2C730FF>Chợ Trời</color> tìm vật phẩm cần mua chỉ có thể xem ở <color=#F2C730FF>tiệm đầu tiên</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question135_1"]="Có thể dùng Radar Tìm Tiệm có bán trong tiệm tạp hóa để tìm kiếm",
    ["OXExam_Question136"]="Vật phẩm bán bằng <color=#F2C730FF>Kim Cương</color> trong Quầy Giao Dịch khi bán thành công sẽ nhận được lượng Kim Cương <color=#F2C730FF>tương đương</color> với số Pha Lê nhận được sau khi bán vật phẩm trừ đi thuế, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question137"]="Maya sau khi mở <color=#F2C730FF>Tư Thế Phòng Thủ</color> <color=#F2C730FF>nghề tầm xa</color> nên <color=#F2C730FF>tăng cường gây sát thương</color> để phá khiên bảo vệ, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question137_1"]="Nghề tầm xa nên chạy ra xa",
    ["OXExam_Question138"]="Nghe nói <color=#F2C730FF>Cương Thi</color> và <color=#F2C730FF>Bongun</color> trước khi hóa thành quái vật, đã từng là một cặp <color=#F2C730FF>vợ chồng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question138_1"]="Cương Thi và Bongun là anh em",
    ["OXExam_Question139"]="<color=#F2C730FF>Cha con</color> ngoài <color=#F2C730FF>Cổng Nam Prontera</color>, thật ra <color=#F2C730FF>không có</color> quan hệ huyết thống, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question140"]="Trên Đại Lục Midgard có <color=#F2C730FF>9</color> loài <color=#F2C730FF>Poring</color> khác nhau cùng sinh sống, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question140_1"]="Tổng có 7 loại Poring",
    ["OXExam_Question141"]="<color=#F2C730FF>Tổng bộ</color> công ty Kafra ở thủ phủ kênh đào <color=#F2C730FF>Alberta</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question141_1"]="Ở thủ đô biên giới-Aldebaran",
    ["OXExam_Question142"]="Thủ đô biên giới <color=#F2C730FF>Morroc</color> có <color=#F2C730FF>ngành công nghiệp bông</color> rất phát triển, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question143"]="<color=#F2C730FF>Goblin Mặt Nạ</color> ở Đại Lục Midgard gồm có <color=#F2C730FF>9</color> loại khác nhau, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question143_1"]="Tổng có 8 loại Goblin Mặt Nạ",
    ["OXExam_Question144"]="Vào <color=#F2C730FF>ban đêm</color>,<color=#F2C730FF>Sói Lang Thang</color> sẽ càng mạnh hơn, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question145"]="<color=#F2C730FF>Thỏ Điên Lam</color> thích nhất là mùi vị <color=#F2C730FF>Cỏ Sầu Riêng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question146"]="Trang sức <color=#F2C730FF>Baphomet</color> đeo có tên là \"<color=#F2C730FF>Nhẫn Ác Quỷ</color>\", đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question147"]="Mắt của <color=#F2C730FF>Quỷ Ác Mộng</color> trong truyền thuyết có khả năng <color=#F2C730FF>nhìn thấu lòng người</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question148"]="MINI <color=#F2C730FF>Deviling</color> là quái vật <color=#F2C730FF>lớn</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question148_1"]="Deviling là quái vừa",
    ["OXExam_Question149"]="Sát Thủ sau khi sử dụng kỹ năng <color=#F2C730FF>Nhào Lộn</color> hoặc <color=#F2C730FF>Ẩn Nấp</color> đều sẽ vào trạng thái <color=#F2C730FF>Ẩn Nấp</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question150"]="Truyền Thuyết RO là game được cải biên từ <color=#F2C730FF>truyện tranh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question151"]="Món <color=#F2C730FF>Poring</color> thích nhất là <color=#F2C730FF>Nước Ép Táo</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question152"]="\"<color=#F2C730FF>Cuộn Cũ</color>\" và \"<color=#F2C730FF>Cồn</color>\" đều là đạo cụ do quái vật <color=#F2C730FF>Hệ Thây Ma</color> rơi, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question152_1"]="Quái Hệ Ác Quỷ rơi",
    ["OXExam_Question153"]="Quái vật MVP/MINI dùng <color=#F2C730FF>Nhánh Cây Máu</color> triệu hồi tối đa chỉ có thể tồn tại <color=#F2C730FF>1 giờ</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question154"]="<color=#F2C730FF>Quạ</color> của Drake luôn đứng trên <color=#F2C730FF>vai trái</color> anh ấy, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question155"]="<color=#F2C730FF>Geffen</color> là căn cứ của <color=#F2C730FF>Công Hội Pháp Thuật</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question156"]="<color=#F2C730FF>Nấm Giòn Tan</color> không chỉ xuất hiện vào ban đêm, vào <color=#F2C730FF>ngày</color> <color=#F2C730FF>trời trong xanh</color> cũng có thể thu thập được, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question156_1"]="Chỉ vào sáng sớm hoặc chiều tối",
    ["OXExam_Question157"]="Khi tham gia <color=#F2C730FF>KVM Công Hội</color>, thành viên đội cùng phe có thể đến từ các <color=#F2C730FF>Hội khác nhau</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question157_1"]="Không thể có thành viên không thuộc Công Hội",
    ["OXExam_Question158"]="Trong <color=#F2C730FF>Hang Đáy Biển</color> có thể câu được <color=#F2C730FF>6</color> loại cá khác nhau, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question159"]="Khi <color=#F2C730FF>Hollgrehenn</color> khoe bắp tay của mình, thường hay giơ cao <color=#F2C730FF>hai tay</color>, rồi mới giơ <color=#F2C730FF>tay phải</color> lên, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question159_1"]="Giơ cao hai tay rồi giơ cao tay trái",
    ["OXExam_Question160"]="<color=#F2C730FF>Hồ Sen Gấm</color> ở Payon mọc <color=#F2C730FF>3 đóa</color> hoa sen, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question161"]="<color=#F2C730FF>W</color> được xưng là <color=#F2C730FF>Nữ Vương Nổi Tiếng</color> Kafra, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question162"]="Khi chơi <color=#F2C730FF>vật tay</color> trong quán rượu, mọi người thường quen dùng <color=#F2C730FF>tay trái</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question162_1"]="Vật tay dùng tay phải",
    ["OXExam_Question163"]="<color=#F2C730FF>Mèo Trăng</color> có đôi mắt <color=#F2C730FF>đỏ</color> xinh đẹp, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question164"]="Những mảng đỏ trên thân <color=#F2C730FF>Tôm Càng To</color> là do <color=#F2C730FF>hấp ở nhiệt độ cao</color> lưu lại, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question165"]="Khi bị <color=#F2C730FF>Mưa Axít</color> ở Phreeoni tấn công, có thể dùng <color=#F2C730FF>Thuốc Vạn Năng</color> xóa debuff, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question166"]="<color=#F2C730FF>Kiếm Katar</color> gây cho <color=#F2C730FF>quái bé và vừa</color> 100% sát thương, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question166_1"]="Có thể gây 100% ST cho Quái Bé",
    ["OXExam_Question167"]="Khi <color=#F2C730FF>treo máy dã ngoại</color>, số người tổ đội tỷ lệ thuận với chỉ số buff, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question168"]="Cách nhận <color=#F2C730FF>Trang Bị Phẩm Cam</color> là: MVP, MINI, Quầy Giao Dịch, Máy Quay Trang Bị, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question169"]="Trong giao diện kỹ năng, các biểu tượng kỹ năng hiển thị bằng <color=#F2C730FF>hình tròn</color> đều là kỹ năng chủ động, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question170"]="Trong giao diện kỹ năng, các biểu tượng kỹ năng hiển thị bằng <color=#F2C730FF>hình vuông</color> đều là kỹ năng bị động, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question171"]="Khi cài đặt Auto trong giao diện kỹ năng, <color=#F2C730FF>kỹ năng chủ động</color> không thể điều chỉnh cấp thi triển, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question171_1"]="Có thể điều chỉnh cấp thi triển của kỹ năng chủ động trong Cài Đặt Auto",
    ["OXExam_Question172"]="Trong <color=#F2C730FF>Tiệm Pha Lê</color> của Alberta có thể mua [Gậy Cài Kỹ Năng] để cài lại điểm kỹ năng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question173"]="Trong <color=#F2C730FF>Tiệm Pha Lê</color> của Alberta có thể mua [Đá Luân Hồi] để cài lại điểm thuộc tính, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question174"]="<color=#F2C730FF>[Vương Bài Tranh Bá]</color> là một lối chơi cạnh tranh công bằng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question175"]="Tham gia sự kiện <color=#F2C730FF>[Vương Bài Tranh Bá]</color> có thể nhận được rất nhiều nguyên liệu thăng cấp <color=#F2C730FF>Shadow</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>？ ",
    ["OXExam_Question176"]="Trái cây yêu thích nhất của Pet <color=#F2C730FF>Khỉ Yoyo</color> là Nho Thân Cứng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?  ",
    ["OXExam_Question177"]="Thức ăn yêu thích nhất của Pet <color=#F2C730FF>Sói Con Sa Mạc</color> là Máu Gia Súc, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?  ",
    ["OXExam_Question177_1"]="Thức ăn yêu thích của Sói Con Sa Mạc là Máu Súc Vật",
    ["OXExam_Question178"]="<color=#F2C730FF>Chúc Phúc Odin</color> chỉ có hiệu lực với Quái Vật có cấp chênh lệch với bản thân 3 cấp, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?  ",
    ["OXExam_Question178_1"]="Có hiệu lực với Quái Vật trong cấp 6",
    ["OXExam_Question179"]="<color=#F2C730FF>Chúc Phúc Odin</color> chỉ nhận được bằng cách hoàn thành ủy thác hàng ngày, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?  ",
    ["OXExam_Question179_1"]="Có thể nhận được bằng cách hoàn thành Ủy Thác hàng ngày và treo máy map Prontera",
    ["OXExam_Question180"]="Tham gia <color=#F2C730FF>Trò Chơi Tửu Quán</color> có thể nhận được <color=#F2C730FF>Thuốc Thể Lực</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>？",
    ["OXExam_Question181"]="<color=#F2C730FF>Nhân Viên Phục Vụ Kafra</color> có thể dịch chuyển bạn tới thành phố chưa từng tới đó, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?  ",
    ["OXExam_Question182"]="Khi <color=#F2C730FF>Bắt Pet</color>, HP Quái Vật càng thấp, tỉ lệ thành công càng cao, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?   ",
    ["OXExam_Question183"]="Trong phần thưởng bổ sung mà <color=#F2C730FF>Chúc Phúc Odin</color> cung cấp, đạo cụ rơi ra từ Quái Vật không bị giới hạn bởi cấp độ giảm dần, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question184"]="<color=#F2C730FF>Tiêu diệt Quái Vật</color> trong trạng thái thường, vật rơi từ Quái Vật bị giới hạn bởi cấp độ giảm dần, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question185"]="Trong game, có thể đổi tên nhân vật của mình bằng cách mua <color=#F2C730FF>Thẻ Đổi Tên Nhân Vật</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question186"]="Trong game, có thể mở khóa cấp Yểm Bùa cao hơn bằng cách tăng độ thân mật với NPC, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question187"]="Trong game có người chơi khác giới mới có thể kết thành bạn đời, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question187_1"]="Đều được",
    ["OXExam_Question188"]="[Cần Câu Tự Động] trong game có thể đổi được thông qua [Xu In Cá], đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question189"]="Kỹ năng Mục Sư [Thánh Đường Ánh Sáng] có thể gây ST lên Quái Thây Ma và Quái Ác Quỷ,  đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question190"]="Có tổng cộng 4 Rương Tiến Độ trong [Lễ Hội], đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question190_1"]="Tổng cộng có 5",
    ["OXExam_Question191"]="Chỉ có [Kiếm Sĩ] mới có thể cưỡi Thú Cưỡi chiến đấu để tấn công, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question191_1"]="Kiếm Sĩ và Du Hiệp đều được",
    ["OXExam_Question192"]="Khẽ há miệng khi ngẩng đầu để nhỏ thuốc vào mắt, để mắt không bị chớp loạn xạ, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question193"]="Bụi nhỏ bay vào mắt, nhắm mắt gắng sức để ho vài cái thì bụi sẽ tự bay ra, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion001"]=" Trung Thu bắt nguồn từ <color=#F2C730FF>Sùng Bái Thiên Tượng</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion002"]="Trung thu được ghi lại sớm nhất trong <color=#F2C730FF>\"Chu Lễ\"</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion003"]="Tết trung thu được công nhận là ngày lễ của đất nước vào <color=#F2C730FF>thời Tùy</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion003_1"]="Trung thu ở triều Đường trở thành ngày lễ toàn đất nước",
    ["OXMidAutumnQuestion004"]="\"Chiếc bánh như mặt trăng, xốp giòn lại thơm hương\" nói về <color=#F2C730FF>Bánh Trung Thu</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion005"]="Trung thu tượng trưng đoàn viên, từ thời <color=#F2C730FF>Bắc Tống</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion005_1"]="Bắt đầu từ thời Minh Thanh",
    ["OXMidAutumnQuestion006"]="Ngoài cúng trăng ra, <color=#F2C730FF>hoa quế</color> cũng là trọng điểm của trung thu, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion007"]="Trung thu có tập tục <color=#F2C730FF>thắp thuyền đèn</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion008"]="\"Đuổi theo trăng\" có thể ngắm trăng sau <color=#F2C730FF>một tuần</color> trung thu, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion008_1"]="\"Đuổi theo trăng\" trong trung thu xong hôm sau mời ngắm trăng tiếp",
    ["OXMidAutumnQuestion009"]="Trung thu cũng có <color=#F2C730FF>Đố Đèn</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion010"]="Đông nam Trung Quốc, trung thu cũng có <color=#F2C730FF>ngắm thủ triều</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion011"]="Vào trung thu, tập tục dùng sào cao chống đèn giấy lên là <color=#F2C730FF>Đố Đèn</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion011_1"]="Tập tục này là lập trung thu",
    ["OXMidAutumnQuestion012"]="\"Trêu trẻ\" là tập tục <color=#F2C730FF>trưởng thành</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion012_1"]="Trêu trẻ là tập tục thuộc về trẻ em",
    ["OXMidAutumnQuestion013"]="Hoa đăng trung thu, và tết nguyên tiêu <color=#F2C730FF>khá giống nhau</color>, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion013_1"]="Quy mô hoa đăng trung thu nhỏ hơn nhiều so với nguyên tiêu",
    ["OXMidAutumnQuestion014"]="<color=#F2C730FF>Rồng mùa lửa</color> cũng là một tập tục trung thu, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion015"]="\"Nghe hương\" là chỉ sau khi đốt hương <color=#F2C730FF>nhận được lời thần dạy</color>, thực hiện nguyện vọng, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion015_1"]="\"Nghe hương\" là chỉ hỏi khi thắp hương, sau đó nghe câu đầu tiên, cũng chính là đáp án",
    ["OXMidAutumnQuestion016"]="\"Tháp lửa\" là tập tục chỉ việc <color=#F2C730FF>đốt lửa trên tháp cao</color> mừng trung thu, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion016_1"]="\"Tháp lửa\" là chỉ việc đốt lửa trên tháp cao",
    ["OXMidAutumnQuestion017"]="Hình hài ban đầu của chú thỏ là <color=#F2C730FF>thỏ ngọc</color> trên cung trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion018"]="Vào thời Minh, trung thu trong hoàng cung sẽ <color=#F2C730FF>ăn cua</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion019"]="\"Nam không thưởng trăng, nữ không cúng bếp\" là chỉ <color=#F2C730FF>nam không vui trung thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion020"]="Tập tục chơi thỏ trung thu bắt nguồn từ <color=#F2C730FF>đầu nhà Thanh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion020_1"]="Tập tục này bắt nguồn cuối nhà Minh",
    ["OXMidAutumnQuestion021"]="Giang Nam Trung Quốc có sự kiện đường phố lúc trung thu gọi là <color=#F2C730FF>\"Dạo trăng\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion022"]="Vào trung thu, trẻ con múa dâng hương, được gọi là \"Múa sao băng dâng hương\", sự kiện bắt nguồn từ <color=#F2C730FF>phía bắc Trung Quốc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion022_1"]="Tập tục \"Múa sao băng dâng hương\" bắt nguồn từ Tứ Xuyên",
    ["OXMidAutumnQuestion023"]="Tập tục trung thu bắt nguồn từ Phúc Kiến \"đoạt bánh\" là <color=#F2C730FF>trò xúc xắc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion024"]="\"Thanh Miêu Xã\" là hoạt động cúng <color=#F2C730FF>trăng</color> của phía bắc Trung Quốc, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion024_1"]="\"Thanh Miêu Xã\" là hoạt động cúng thần thổ địa",
    ["OXMidAutumnQuestion025"]="Ở một số nơi <color=#F2C730FF>Hà Bắc</color>, trung thu còn được gọi là \"Nguyên Đán Nhỏ\", đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion026"]="Người tộc Mông Cổ sẽ có tập tục <color=#F2C730FF>\"Đuổi trăng\"</color>, có kỵ thủ đuổi theo mặt trăng đến phía tây, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion027"]="Tập tục trung thu \"Tìm trăng\" của tộc Tàng, có liên quan đến <color=#F2C730FF>bóng phản chiếu trong nước</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion028"]="Tập tục \"Trăng đi\" của tộc Đồng Quảng Tây là <color=#F2C730FF>cưỡi ngựa ngắm trăng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion028_1"]="Tập tục \"Trăng đi\" là kết thành đội ca múa đạp trăng",
    ["OXMidAutumnQuestion029"]="\"Băng trăng\" là tập tục trung thu của <color=#F2C730FF>đi thăm người thân</color> của dân tộc thiểu số Vân Nam, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion029_1"]="\"Băng trăng\" là tập tục nam thanh nữ tú tìm lương duyên tốt",
    ["OXMidAutumnQuestion030"]="<color=#F2C730FF>\"Nhảy trăng\"</color> là tập tục ca hát dưới trăng của tộc Di Vân Nam, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion031"]="\"Hổ trắng\" là cách gọi <color=#F2C730FF>trung thu</color> của tộc Cờ Lao, ngày này họ sẽ mổ bò đực, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion031_1"]="\"Hổ trắng\" là vài ngày trước trung thu",
    ["OXMidAutumnQuestion032"]="Tộc Triều Tiên sẽ dựng \"giá vọng nguyệt\" để <color=#F2C730FF>trẻ em</color> ngắm trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion032_1"]="Giá vọng nguyệt dành cho người già ngắm trăng",
    ["OXMidAutumnQuestion033"]="<color=#F2C730FF>Tộc Tráng</color> có tập tục mời thần trăng vào trung thu, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion034"]="Trong tập tục mời thần trăng của tộc Tráng, cần <color=#F2C730FF>con trai</color> làm người đại diện, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion034_1"]="Người đại diện là nữ",
    ["OXMidAutumnQuestion035"]="Trong tập tục mời thần trăng của tộc Tráng, người ta đều <color=#F2C730FF>lắng nghe</color> bài ca người đại diện mời thần trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion035_1"]="Khi mời thần linh, người thần sẽ hát đối, không chỉ có một bên nghe",
    ["OXMidAutumnQuestion036"]="Trong tập tục mời thần trăng của tộc Tráng, cuối cùng <color=#F2C730FF>không cần</color> mời thần trăng về trời, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion036_1"]="Kết thúc nghi thức thần trăng, cần mời thần về trời",
    ["OXMidAutumnQuestion037"]="<color=#F2C730FF>Tộc Lê</color> gọi trung thu là \"Hội tháng tám\" hoặc \"Tiết Điều Tiếng\", đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion038"]="Trong hoạt động \"Tiết Đều Tiếng\" của tộc Lê, nam thanh nữ tú dẫn đầu gọi là <color=#F2C730FF>\"Đầu điều tiếng\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion039"]="Trong \"Hội Tháng Tám\" của tộc Lê, <color=#F2C730FF>không có</color> tập tục ăn bánh trung thu, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion039_1"]="Trung thu của tộc Lê, cũng có tập tục ăn bánh trung thu",
    ["OXMidAutumnQuestion040"]="Ở Hàn Quốc, trung thu còn có tên là <color=#F2C730FF>\"Ngày hỉ bài\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion041"]="Tiếng Anh trung thu của Hàn Quốc là <color=#F2C730FF>\"Lễ tạ ơn Hàn Quốc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion042"]="Trung thu Việt Nam là để tưởng nhớ <color=#F2C730FF>A Quý thăng thiên</color> trong truyền thuyết, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion043"]="A Quý trong truyền thuyết Việt Nam là một <color=#F2C730FF>thần y cao minh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion043_1"]="A Quý dùng cây đa chữa bệnh, không phải nhờ y thuật của mình",
    ["OXMidAutumnQuestion044"]="A Quý trong truyền thuyết Việt Nam, là <color=#F2C730FF>tự</color> lên cung trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion044_1"]="Cây đa đưa anh lên cung trăng",
    ["OXMidAutumnQuestion045"]="Hoạt động trung thu Việt Nam có liên quan nhiều đến <color=#F2C730FF>động vật</color>, như múa sư tử, đèn cá chép, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion046"]="Trung thu của Nhật Bản còn gọi là <color=#F2C730FF>Đêm Rằm</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion047"]="Trung thu của Nhật Bản còn gọi là <color=#F2C730FF>Tiết Vu Minh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion048"]="Trung thu Nhật Bản có tập tục <color=#F2C730FF>ăn bánh trung thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion048_1"]="Trung thu Nhật Bản ăn bánh ngắm trăng",
    ["OXMidAutumnQuestion049"]="Hoạt động xem trăng ở Nhật Bản còn gọi là <color=#F2C730FF>\"Ngắm trăng\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion050"]="Khi ngắm trăng trung thu Nhật Bản, sẽ ở <color=#F2C730FF>trong nhà</color> bày đệm ngồi, vong thảo ra, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion051"]="Trung thu là ngày lễ quan trọng với <color=#F2C730FF>Malaysia</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion052"]="Hằng Nga ăn thuốc tiên bay lên cung trăng là phiên bản <color=#F2C730FF>ban sơ nhất</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion052_1"]="Hằng Nga ăn thuốc tiên bay lên cung trăng là phiên bản cải biên thành",
    ["OXMidAutumnQuestion053"]="Thỏ ngọc giã thuốc đã sớm xuất hiện trong <color=#F2C730FF>\"Thiên Vấn\"</color> của Khuất Nguyên, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion054"]="Trong truyền thuyết, thỏ ngọc chính là thỏ do <color=#F2C730FF>Hẳng Nga</color> nuôi, khi bay lên trời cũng sẽ mang theo cung trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion055"]="Trong thần thoại bất kỳ nào, thỏ ngọc đều đang giã <color=#F2C730FF>thuốc trường sinh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion055_1"]="Thỏ ngọc trong truyền thuyết nhật bản là làm bánh nếp",
    ["OXMidAutumnQuestion056"]="Khúc nhạc nổi tiếng <color=#F2C730FF>\"Khúc áo nghê thường\"</color> có liên quan đến Đường Huyền Tông mộng du cung trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion057"]="Bánh trung thu từng truyền tình báo khởi nghĩa vào <color=#F2C730FF>thời Nguyên</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion058"]="Phần sau của ngày rằm tháng tám... <color=#F2C730FF>Lỗi lạc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion058_1"]="Ánh trăng ngày rằm tháng tám... Chính đại",
    ["OXMidAutumnQuestion059"]="Phần sau của Bánh nếp ngày rằm tháng tám... <color=#F2C730FF>Đúng lúc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion059_1"]="Ăn bánh nếp ngày rằm tháng tám... Còn sớm",
    ["OXMidAutumnQuestion060"]="Phần sau của Đèn lồng ngày rằm tháng tám... <color=#F2C730FF>Không rời</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion060_1"]="Ngắm đèn lông ngày rằm tháng tám... Muộn hơn nửa năm",
    ["OXMidAutumnQuestion061"]="Phần sau của Đón năm mới ngày rằm tháng tám... <color=#F2C730FF>Sớm hơn</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion061_1"]="Đón năm mới ngày rằm tháng tám... Thiếu không khí lễ hội",
    ["OXMidAutumnQuestion062"]="Có tập tục ăn vụng trong trung thu một số nơi, <color=#F2C730FF>bắt người ăn trộm</color> càng nhiều, chủ nhân càng vui, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion062_1"]="Trong tập tục ăn vụng trung thu, ăn trộm càng nhiều, chủ nhân càng vui",
    ["OXMidAutumnQuestion063"]="Hắt nước nến chúc mừng, <color=#F2C730FF>bây giờ</color> còn nổi tiếng trong tập tục trung thu, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion063_1"]="Hắt nước nến chúc mừng đã bị cấm vì không an toàn",
    ["OXMidAutumnQuestion064"]="Đêm trung thu của bán đảo Triều Tiên ngoài chúc mừng bội thu, còn có ý <color=#F2C730FF>chúc mừng thắng nước Bột Hải</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion065"]="Ganggangsullae, là một điệu múa dân tộc để chúc mừng <color=#F2C730FF>Đoan Ngọ</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion065_1"]="Ganggangsullae là một điệu múa dân tộc để chúc mừng trung thu",
    ["OXMidAutumnQuestion066"]="Ngoài trung thu, \"ngắm trăng\" cũng có thể chỉ đêm <color=#F2C730FF>ngày 13 tháng 9</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion067"]="Trung thu còn có tên khác là <color=#F2C730FF>\"Lễ ánh trăng\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion068"]="<color=#F2C730FF>Xin Trăng</color> là ngày cầu lương duyên cho nam nữ độc thân, có tập tục cúng trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion069"]="Ngắm thủy triều cũng là tập tục lớn của trung thu, chủ yếu tập trung ở <color=#F2C730FF>ven biển phía bắc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion069_1"]="Ngắm thủy triều cũng là tập tục lớn Chiết Giang",
    ["OXMidAutumnQuestion070"]="Trăng soi là lúc cầu nhân duyên cho <color=#F2C730FF>nam nữ độc thân</color>, tập tục tắm dưới ánh trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion070_1"]="\"Trăng soi\" là tập tục cầu con cái cho cô gái đã lấy chồng",
    ["OXMidAutumnQuestion071"]="Đốt đầu hương là tập tục trung thu của <color=#F2C730FF>Giang Tô Trung Quốc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion072"]="<color=#F2C730FF>\"Trộm rau dưới trăng\"</color> là một tập tục trung thu, con gái trẻ trộm rau ban đêm, có ý cầu xin nhân duyên tốt đẹp, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion073"]="Ném khăn tay tìm người yêu bắt nguồn từ khu vực Phúc Kiến, cô gái chưa chồng <color=#F2C730FF>đóng làm Hằng Nga</color>, ném khăn tay cầu thân, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion074"]="Ngô Cương <color=#F2C730FF>vốn</color> ở trên cung trăng , đốn củi cây quế làm kế sinh nhai, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion074_1"]="Ngô Cương bị phạt ở trên cung trăng",
    ["OXMidAutumnQuestion075"]="<color=#F2C730FF>\"Đánh trăng\"</color> là tập tục tộc Thổ, người ta múc nước in bóng trăng và dùng đá ném vào bóng phản chiếu, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion076"]="Thỏ chính là <color=#F2C730FF>thỏ ngọc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion077"]="Múa rồng trung thu bắt nguồn từ truyền thuyết <color=#F2C730FF>mãng xà</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion078"]="Thỏ ngọc được Hằng Nga nhờ giáng thế trị bệnh, <color=#F2C730FF>và nhận thù lao</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion078_1"]="Thỏ không cần thù lao, chỉ mượn áo mặc",
    ["OXMidAutumnQuestion079"]="Tập tục tháp lửa trung thu, bắt nguồn từ <color=#F2C730FF>khởi nghĩa nông dân</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion080"]="Vào trung thu Ryukyu, <color=#F2C730FF>người ăn bánh trung thu, dùng bánh thổi nên làm đồ tế</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion080_1"]="Cả hai đều làm đồ ăn và đồ cúng được",
    ["OXMidAutumnQuestion081"]="Trung thu không chỉ cúng trăng, mà còn cúng đất đai, thuộc loại <color=#F2C730FF>mùa bội thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion082"]="15 tháng 8 trồng kê... <color=#F2C730FF>vội vàng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion082_1"]="15 tháng 8 trồng kê... quá sớm",
    ["OXMidAutumnQuestion083"]="Thời tiết trung thu... <color=#F2C730FF>ấm áp và dễ chịu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion083_1"]="Thời tiết trung thu... không lạnh không nóng",
    ["OXMidAutumnQuestion084"]="Bộ niên 15 tháng 8... <color=#F2C730FF>không nói lý</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion084_1"]="Bộ niên 15 tháng 8... bữa sáng",
    ["OXMidAutumnQuestion085"]="Ăn sủi cảo 15 tháng 8... <color=#F2C730FF>li phổ</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion085_1"]="Ăn sủi cảo 15 tháng 8... phá quy tắc",
    ["OXMidAutumnQuestion086"]="Thỏ 15 tháng 8... <color=#F2C730FF>tạo phản</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion086_1"]="Thỏ 15 tháng 8... còn kém xa",
    ["OXMidAutumnQuestion087"]="Trồng đậu phộng 15 tháng 8... <color=#F2C730FF>vừa đúng lúc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion087_1"]="Trồng đậu phộng 15 tháng 8... chỉ huy mù",
    ["OXMidAutumnQuestion088"]="Vớt trăng bên bờ... <color=#F2C730FF>cố gắng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion088_1"]="Vớt trăng bên bờ... đánh bộp",
    ["OXMidAutumnQuestion089"]="Trăng đuổi theo mặt trời... <color=#F2C730FF>không thể</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion089_1"]="Trăng đuổi theo mặt trời... trứng không chọi đá",
    ["OXMidAutumnQuestion090"]="Mây che trăng 15 tháng 8... <color=#F2C730FF>đèn tối lửa tắt</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion090_1"]="Mây che trăng 15 tháng 8... mất hứng",
    ["OXMidAutumnQuestion091"]="Nhìn vào lửa 15 tháng 8... <color=#F2C730FF>hoảng hốt</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion091_1"]="Nhìn vào lửa 15 tháng 8... lạnh dần",
    ["OXMidAutumnQuestion092"]="Trồng đậu 15 tháng 8... <color=#F2C730FF>vội vã</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion092_1"]="Trồng đậu 15 tháng 8... trễ ba mùa thu",
    ["OXMidAutumnQuestion093"]="Bánh đoàn viên 15 tháng 8... <color=#F2C730FF>chia sẻ</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion093_1"]="Bánh đoàn viên 15 tháng 8... không cho người ngoài",
    ["OXMidAutumnQuestion094"]="Kéo Hằng Nga dùng... <color=#F2C730FF>tuyệt tình</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion094_1"]="Kéo Hằng Nga dùng... tài cao",
    ["OXMidAutumnQuestion095"]="Sào tre đánh trăng... <color=#F2C730FF>can đảm</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion095_1"]="Sào tre đánh trăng... không chịu đòn",
    ["OXMidAutumnQuestion096"]="Mặt trời và mặt trăng nói chuyện... <color=#F2C730FF>loa to</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion096_1"]="Mặt trời và mặt trăng nói chuyện... nói không",
    ["OXMidAutumnQuestion097"]="Chó điên cắn mặt trăng... <color=#F2C730FF>ăn miếng to</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion097_1"]="Chó điên cắn mặt trăng... cuồng vọng",
    ["OXMidAutumnQuestion098"]="Người hói đuổi theo mặt trăng... <color=#F2C730FF>đồng loại thu hút nhau</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion098_1"]="Người hói đuổi theo mặt trăng... tắm ánh sáng",
    ["OXMidAutumnQuestion099"]="Thắp đèn dưới trăng... <color=#F2C730FF>mượn ánh sáng nhau</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion099_1"]="Thắp đèn dưới trăng... so thêm một lần",
    ["OXMidAutumnQuestion100"]="Vung đao dưới trăng... <color=#F2C730FF>diễu võ dương oai</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion100_1"]="Chém ánh sáng",
    ["OXMidAutumnQuestion101"]=" Trung thu bắt nguồn từ <color=#F2C730FF>sùng bái nhân vật</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion101_1"]="Trung Thu bắt nguồn từ Sùng Bái Thiên Tượng",
    ["OXMidAutumnQuestion102"]="Trung thu được ghi lại sớm nhất ở <color=#F2C730FF>\"Tả Truyện\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion102_1"]="Trung thu được ghi lại sớm nhất ở \"Chu Lễ\"",
    ["OXMidAutumnQuestion103"]="Trung thu ở <color=#F2C730FF>triều Đường</color> trở thành ngày lễ toàn đất nước. Đúng (O) hay sai (X)?, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion104"]="\"Chiếc bánh như mặt trăng, xốp giòn lại thơm hương\" nói đến <color=#F2C730FF>Bánh Ú</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion104_1"]="\"Chiếc bánh như mặt trăng, xốp giòn lại thơm hương\" nói đến bánh trung thu",
    ["OXMidAutumnQuestion105"]="Trung thu tượng trung đoàn viên, bắt đầu có từ <color=#F2C730FF>Minh Thanh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion106"]="Ngoài cúng trăng, <color=#F2C730FF>hoa đào</color> cũng là thứ chính của trung thu, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion106_1"]="Hoa quế là thứ quan trọng ngoài cúng trăng trung thu",
    ["OXMidAutumnQuestion107"]="Trung thu có tập tục <color=#F2C730FF>từ không</color> đốt thuyền đèn, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion107_1"]="Trung thu có tập tục thuyền đèn",
    ["OXMidAutumnQuestion108"]="\"Đuổi theo trăng\" trong trung thu xong <color=#F2C730FF>hôm sau</color> mời khách ngắm trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion109"]="Trung thu <color=#F2C730FF>không có</color> tập tục đố đèn, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion109_1"]="Trung thu có tập tục đố đèn",
    ["OXMidAutumnQuestion110"]="<color=#F2C730FF>Phía tây bắc</color> Trung Quốc, vào trung thu cũng có thói quen ngắm thủy triều, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion110_1"]="Đông nam Trung Quốc, trung thu cũng có tập tục ngắm thủ triều",
    ["OXMidAutumnQuestion111"]="Vào trung thu, tập tục dùng sào cao chống đèn giấy lên là <color=#F2C730FF>lập trung thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion112"]="\"Trêu trẻ\" là tập tục thuộc về <color=#F2C730FF>trẻ em</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion113"]="Trung thu có hoa đăng, nhưng <color=#F2C730FF>rất nhiều điều giống nguyên tiêu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion114"]="Rồng múa lửa <color=#F2C730FF>không phải</color> một tập tục của trung thu, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion114_1"]="Khu vực đông nam có tập tục rồng múa lửa trung thu",
    ["OXMidAutumnQuestion115"]="\"Nghe hương\" là chỉ <color=#F2C730FF>hỏi khi thắp hương</color>, sau đó nghe câu đầu tiên, cũng chính là đáp án, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion116"]="\"Tháp lửa\" là tập tục chỉ <color=#F2C730FF>thắp đèn trên tháp cao</color> mừng trung thu, đúng <color=#64b4ff>(O)</color> hoặc sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion117"]="Hình hài ban đầu của chú thỏ là <color=#F2C730FF>Hằng Nga</color> trên cung trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion117_1"]="Hình dáng thỏ ban đầu là thỏ ngọc",
    ["OXMidAutumnQuestion118"]="Vào thời Minh, trung thu trong hoàng cung sẽ <color=#F2C730FF>cấm ăn cua</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion118_1"]="Vào thời Minh, hoàng cung thịnh hành ăn cua vào trung thu",
    ["OXMidAutumnQuestion119"]="\"Nam không thưởng trăng, nữ không cúng bếp\" là chỉ <color=#F2C730FF>nữ không vui trung thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion119_1"]="\"Nam không thưởng trăng, nữ không cúng bếp\" là chỉ nam không vui trung thu",
    ["OXMidAutumnQuestion120"]="Tập tục chơi thỏ trung thu bắt nguồn từ <color=#F2C730FF>cuối nhà Minh</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion121"]="Giang Nam Trung Quốc có sự kiện đường phố lúc trung thu gọi là <color=#F2C730FF>\"Đuổi trăng\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion121_1"]="Tập tục này gọi là gọi trăng",
    ["OXMidAutumnQuestion122"]="Vào trung thu, trẻ con múa dâng hương, được gọi là \"Múa sao băng dâng hương\", sự kiện bắt nguồn từ <color=#F2C730FF>Tứ Xuyên Trung Quốc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion123"]="Tập tục trung thu bắt nguồn từ Phúc Kiến \"đoạt bánh\" là <color=#F2C730FF>trò bài giấy</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion123_1"]="Bánh cược là trò chơi xúc xắc",
    ["OXMidAutumnQuestion124"]="\"Thanh Miêu Xã\" là hoạt động cúng <color=#F2C730FF>Thần thổ địa</color> của phía bắc Trung Quốc, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion125"]="Ở một số nơi Hà Bắc, trung thu còn được gọi là <color=#F2C730FF>\"Nguyên Đán To\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion125_1"]="Nơi nào đó ở Hà Bắc gọi trung thu là \"Nguyên Đán Nhỏ\"",
    ["OXMidAutumnQuestion126"]="<color=#F2C730FF>Tộc Duy Ngô Nhĩ</color> có tập tục \"đuổi trăng\", có kỵ thủ đuổi theo trăng về phía tây, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion126_1"]="Tộc Mông Cổ mới có tập tục đuổi theo trăng",
    ["OXMidAutumnQuestion127"]="Tập tục trung thu \"Tìm trăng\" của tộc Tàng, có liên quan đến <color=#F2C730FF>trăng hiện trên bầu trời</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion127_1"]="Tập tục \"tìm trăng trung thu có liên quan với bóng trăng trong nước",
    ["OXMidAutumnQuestion128"]="Tập tục \"Trăng đi\" của tộc Đồng Quảng Tây là <color=#F2C730FF>kết thành đội ca múa</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion129"]="\"Băng trăng\" là tập tục trung thu của <color=#F2C730FF>nam thanh nữ tú</color> tìm lương duyên tốt của dân tộc thiểu số Vân Nam, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion130"]="\"Nhảy trăng\" là tập tục ca hát dưới trăng của <color=#F2C730FF>tộc Triều Tiên</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion130_1"]="\"Nhảy trăng\" là tập tục của tộc Di",
    ["OXMidAutumnQuestion131"]="\"Hổ trắng\" là cách gọi <color=#F2C730FF>vài ngày trước trung thu</color> của tộc Cờ Lao, ngày này họ sẽ mổ bò đực, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion132"]="Tộc Triều Tiên sẽ dựng \"giá vọng nguyệt\" để <color=#F2C730FF>người già</color> ngắm trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion133"]="Vào trung thu tộc Tráng sẽ có tập tục mời <color=#F2C730FF>Thần ban ngày</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion133_1"]="Tộc Tráng hay mời thần trăng vào trung thu",
    ["OXMidAutumnQuestion134"]="Trong tập tục mời thần trăng của tộc Tráng, cần <color=#F2C730FF>con gái</color> làm người đại diện, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion135"]="Trong tập tục mời thần trăng của tộc Tráng, con người và người đại diện thần trăng <color=#F2C730FF>hát đối</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion136"]="Trong tập tục mời thần trăng của tộc Tráng, cuối cùng <color=#F2C730FF>cần</color> mời thần trăng về trời, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion137"]="<color=#F2C730FF>Tộc Tráng</color> gọi trung thu là \"Hội tháng tám\" hoặc \"Tiết Điều Tiếng\", đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion137_1"]="Hai cách gọi này là của tộc Lê",
    ["OXMidAutumnQuestion138"]="Trong hoạt động \"Tiết Đều Tiếng\" của tộc Lê, <color=#F2C730FF>Ông bà cao tuổi</color> dẫn đầu gọi là <color=#F2C730FF>\"Đầu điều tiếng\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion138_1"]="Trong hoạt động \"Tiết Đều Tiếng\" của tộc Lê, nam thanh nữ tú dẫn đầu gọi là \"Đầu điều tiếng\"",
    ["OXMidAutumnQuestion139"]="Trong \"Hội Tháng Tám\" của tộc Lê, cũng có tập tục <color=#F2C730FF>ăn bánh trung thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion140"]="Ở <color=#F2C730FF>Nhật Bản</color>, trung thu còn gọi là \"Ngày hỉ bài\", đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion140_1"]="Ở Hàn Quốc, trung thu còn có tên là \"Ngày hỉ bài\"",
    ["OXMidAutumnQuestion141"]="Tiếng Anh trung thu của Hàn Quốc là <color=#F2C730FF>\"Lễ hồi sinh Hàn Quốc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion141_1"]="Tiếng Anh trung thu của Hàn Quốc là \"Lễ tạ ơn Hàn Quốc",
    ["OXMidAutumnQuestion142"]="Trung thu <color=#F2C730FF>Philippines</color> là để tưởng nhớ A Quý thăng thiên trong truyền thuyết, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion142_1"]="Trung thu Việt Nam là để tưởng nhớ A Quý thăng thiên",
    ["OXMidAutumnQuestion143"]="A Quý trong truyền thuyết Việt Nam dùng <color=#F2C730FF>cây đa</color> để chữa bệnh, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion144"]="A Quý trong truyền thuyết Việt Nam, là được <color=#F2C730FF>cây đa</color> đưa lên cung trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion145"]="Hoạt động trung thu <color=#F2C730FF>Nhật Bản</color> có liên quan nhiều đến động vật, như múa sư tử, đèn cá chép, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion145_1"]="Hoạt động trung thu Việt Nam có liên quan nhiều đến động vật",
    ["OXMidAutumnQuestion146"]="Trung thu của Nhật Bản còn gọi là <color=#F2C730FF>Đêm Mười Sáu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion146_1"]="Trung thu của Nhật Bản còn gọi là Đêm Rằm",
    ["OXMidAutumnQuestion147"]="Trung thu của Nhật Bản còn gọi là <color=#F2C730FF>Vu Âm Nguyệt</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion147_1"]="Trung thu của Nhật Bản còn gọi là Tiết Vu Minh",
    ["OXMidAutumnQuestion148"]="Trung thu ở Nhật Bản có tập tục ăn <color=#F2C730FF>bánh ngắm trăng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion149"]="Hoạt động xem trăng <color=#F2C730FF>Hàn Quốc</color> được gọi là \"ngắm trăng\", đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion149_1"]="Hoạt động xem trăng ở Nhật Bản còn gọi là \"Ngắm trăng\"",
    ["OXMidAutumnQuestion150"]="Khi ngắm trăng trung thu Nhật Bản, sẽ ở <color=#F2C730FF>sân vườn</color> bày đệm ngồi, vong thảo ra, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion150_1"]="Khi \"ngắm trăng\" sẽ bày đồ ở trong nhà",
    ["OXMidAutumnQuestion151"]="Trung thu là <color=#F2C730FF>chỉ là ngoại nhập</color> với Malaysia</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion151_1"]="Trung thu là ngày lễ truyền thống quan trọng nhất ở Malaysia",
    ["OXMidAutumnQuestion152"]="Hằng Nga ăn thuốc tiên bay lên cung trăng là phiên bản <color=#F2C730FF>cải biên</color> thành, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion153"]="Thỏ ngọc giã thuốc đã sớm xuất hiện trong <color=#F2C730FF>\"Li Tao\"</color> của Khuất Nguyên, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion153_1"]="Thỏ ngọc giã thuốc bắt nguồn sớm nhất từ \"Thiên Vấn\"",
    ["OXMidAutumnQuestion154"]="Trong truyền thuyết, thỏ ngọc và Hằng Nga <color=#F2C730FF>không có quan hệ</color>, lần lượt bay lên cung trăng mà thôi, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion154_1"]="Thỏ ngọc là thỏ được Hằng Nga nuôi, khi bay lên trời cùng ở trong cung trăng",
    ["OXMidAutumnQuestion155"]="Trong <color=#F2C730FF>thần thoại Nhật Bản</color>, thỏ ngọc không giã thuốc trường sinh, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion156"]="Khúc nhạc nổi tiếng \"Khúc áo nghê thường\" có liên quan đến <color=#F2C730FF>Đường Thái Tông</color> mộng du cung trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion157"]="Bánh trung thu từng truyền tình báo khởi nghĩa vào <color=#F2C730FF>thời Tống</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion157_1"]="Bánh trung thu từng truyền tình báo khởi nghĩa",
    ["OXMidAutumnQuestion158"]="Phần sau của ngày rằm tháng tám... <color=#F2C730FF>Chính đại</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion159"]="Phần sau của Ăn bánh nếp ngày rằm tháng tám... <color=#F2C730FF>Còn sớm</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion160"]="Phần sau của Ngắm đèn lông ngày rằm tháng tám... <color=#F2C730FF>Muộn hơn nửa năm</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion161"]="Phần sau của Đón năm mới ngày rằm tháng tám... <color=#F2C730FF>Thiếu không khí lễ hội</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion162"]="Có tập tục ăn vụng trong trung thu một số nơi, <color=#F2C730FF>bị ăn trộm càng nhiều</color>, chủ nhân càng vui, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion163"]="Hắt nước nến chúc mừng, <color=#F2C730FF>bây giờ đã bị cấm</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion164"]="Đêm trung thu của bán đảo Triều Tiên <color=#F2C730FF>chỉ chúc mừng bội thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion164_1"]="Đêm trung thu của bán đảo Triều Tiên ngoài chúc mừng bội thu, còn có ý chúc mừng thắng nước Bột Hải",
    ["OXMidAutumnQuestion165"]="Ganggangsullae, là một điệu múa dân tộc để chúc mừng <color=#F2C730FF>Trung Thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion166"]="Ngoài trung thu, \"ngắm trăng\" cũng có thể chỉ đêm <color=#F2C730FF>ngày 13 tháng 10</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion166_1"]="Ngoài trung thu, \"ngắm trăng\" cũng có thể chỉ đêm ngày 13 tháng 9",
    ["OXMidAutumnQuestion167"]="Trung thu còn có tên khác là <color=#F2C730FF>\"Lễ Mặt Trời\"</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion167_1"]="Trung thu còn có tên khác là \"Lễ ánh trăng\"",
    ["OXMidAutumnQuestion168"]="<color=#F2C730FF>Vọng nguyệt</color> là ngày cầu lương duyên cho nam nữ độc thân, có tập tục cúng trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion168_1"]="Hoạt động này có tên Xin Trăng",
    ["OXMidAutumnQuestion169"]="Ngắm thủy triều cũng là tập tục lớn của trung thu, chủ yếu tập trung ở <color=#F2C730FF>Chiết Giang</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion170"]="Trăng soi là lúc cầu con cái cho <color=#F2C730FF>cô gái chưa từng sinh con</color>, tập tục tắng dưới ánh trăng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion171"]="Đốt đầu hương là tập tục trung thu của <color=#F2C730FF>phía bắc Trung Quốc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion171_1"]="Đốt đầu hương là tập tục trung thu của Giang Tô Trung Quốc",
    ["OXMidAutumnQuestion172"]="<color=#F2C730FF>\"Trộm rau dưới trăng\"</color> là một tập tục trung thu, con gái trẻ trộm rau ban đêm, có ý cầu <color=#F2C730FF>tiền tài của cải</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion172_1"]="\"Trộm rau dưới trăng\" có ý cầu xin nhân duyên tốt đẹp",
    ["OXMidAutumnQuestion173"]="Ném khăn tay tìm người yêu bắt nguồn từ khu vực Phúc Kiến, cô gái chưa chồng đóng làm <color=#F2C730FF>Thỏ Ngọc</color>, ném khăn tay cầu thân, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion173_1"]="Ném khăn tay tìm người yêu bắt nguồn từ khu vực Phúc Kiến, cô gái chưa chồng đóng làm Hằng Nga",
    ["OXMidAutumnQuestion174"]="Ngô Cương <color=#F2C730FF>bị phạt</color> ở trên cung trăng , đốn củi cây quế làm kế sinh nhai, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion175"]="\"Đánh trăng\" là tập tục <color=#F2C730FF>tộc Tạng</color>, người ta múc nước in bóng trăng và dùng đá ném vào bóng phản chiếu, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion175_1"]="\"Đánh trăng\" là tập tục tộc Thổ",
    ["OXMidAutumnQuestion176"]="Thỏ và thỏ ngọc <color=#F2C730FF>khác nhau</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion176_1"]="Thỏ chính là thỏ ngọc",
    ["OXMidAutumnQuestion177"]="Múa rồng trung thu bắt nguồn từ truyền thuyết <color=#F2C730FF>giao long</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion177_1"]="Múa rồng trung thu bắt nguồn từ truyền thuyết giao long",
    ["OXMidAutumnQuestion178"]="Thỏ ngọc được Hằng Nga nhờ giáng thế trị bệnh, lại <color=#F2C730FF>không nhận thù lao</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion179"]="Tập tục tháp lửa trung thu, bắt nguồn từ <color=#F2C730FF>binh biến</color> thời xưa, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion179_1"]="Tập tục tháp lửa trung thu, bắt nguồn từ khởi nghĩa nông dân",
    ["OXMidAutumnQuestion180"]="Vào trung thu Ryukyu, bánh trung thu, bánh thổi <color=#F2C730FF>đều có thể ăn được, cũng làm đồ cúng được</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion181"]="Trung thu chỉ cúng trăng, thuộc loại <color=#F2C730FF>mùa thiên tượng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion181_1"]="Trung thu không chỉ cúng trăng, mà còn cúng đất đai, thuộc loại mùa bội thu",
    ["OXMidAutumnQuestion182"]="15 tháng 8 trồng kê... <color=#F2C730FF>quá sớm</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion183"]="Thời tiết trung thu... <color=#F2C730FF>không lạnh không nóng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion184"]="Bộ niên 15 tháng 8... <color=#F2C730FF>bữa sáng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion185"]="Ăn sủi cảo 15 tháng 8... <color=#F2C730FF>phá quy tắc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion186"]="Thỏ 15 tháng 8... <color=#F2C730FF>còn kém xa</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion187"]="Trồng đậu phộng 15 tháng 8... <color=#F2C730FF>chỉ huy mù</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion188"]="Vớt trăng bên bờ... <color=#F2C730FF>đánh bộp</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion189"]="Trăng đuổi theo mặt trời... <color=#F2C730FF>trứng không chọi đá</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion190"]="Mây che trăng 15 tháng 8... <color=#F2C730FF>mất hứng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion191"]="Nhìn vào lửa 15 tháng 8... <color=#F2C730FF>lạnh dần</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion192"]="Trồng đậu 15 tháng 8... <color=#F2C730FF>trễ ba mùa thu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion193"]="Bánh đoàn viên 15 tháng 8... <color=#F2C730FF>không cho người ngoài</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion194"]="Kéo Hằng Nga dùng... <color=#F2C730FF>tài cao</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion195"]="Sào tre đánh trăng... <color=#F2C730FF>không chịu đòn</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion196"]="Mặt trời và mặt trăng nói chuyện... <color=#F2C730FF>nói không</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion197"]="Chó điên cắn mặt trăng... <color=#F2C730FF>cuồng vọng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion198"]="Người hói đuổi theo mặt trăng... <color=#F2C730FF>tắm ánh sáng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion199"]="Thắp đèn dưới trăng... <color=#F2C730FF>so thêm một lần</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion200"]="Vung đao dưới trăng... <color=#F2C730FF>chém ánh sáng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
