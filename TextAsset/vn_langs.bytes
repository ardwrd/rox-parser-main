    ["DialogueOption20830051"]="Vậy nên làm gì bây giờ?",
    ["DialogueOption20830091"]="Bạn muốn...",
    ["DialogueOption20830101"]="Xuyên qua thời không?",
    ["DialogueOption20830111"]="Tôi sẵn lòng!",
