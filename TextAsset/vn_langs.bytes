    ["AnniCeremonyTips_001"]="(Nhận sau khi giao xong)",
    ["AnniCeremonyTips_002"]="(Đã nhận)",
    ["AnniCeremonyTips_003"]="Vẫn chưa nhập chúc phúc",
    ["AnniversaryAchievement_tips_001"]="Bồi Dưỡng",
    ["AnniversaryAchievement_tips_002"]="Chiến Ca",
    ["AnniversaryAchievement_tips_003"]="Vạn Vật",
    ["AnniversaryAchievement_tips_004"]="Tận Hưởng",
    ["AnniversaryAchievement_tips_005"]="Thương Nhân",
    ["AnniversaryDataDes_001"]="<color=#CA2E0AFF>%s</color>, bạn đã tới Vương Quốc Rune-Midgarts. (Một phần dữ liệu được tính đến ngày 13/10/2021)",
    ["AnniversaryDataDes_002"]="<color=#CA2E0AFF>%s</color>, bạn đã trở thành VIP Kafra.",
    ["AnniversaryDataDes_003"]="<color=#CA2E0AFF>%s</color>, bạn mau quyết định con đường phía trước.",
    ["AnniversaryDataDes_003_1"]="Bạn vẫn giữ được thân phận Tân Thủ, mong bạn sẽ quyết định hướng Chuyển Nghề sớm.",
    ["AnniversaryDataDes_004"]="Bạn đã trở thành một <color=#CA2E0AFF>%s</color> từ trong số nhiều lựa chọn.",
    ["AnniversaryDataDes_005"]="Trong cuộc thám hiểm, bạn đã có <color=#CA2E0AFF>%s</color> loại Đồ Giám Quái Vật làm phong phú Sổ Tay của mình.",
    ["AnniversaryDataDes_006"]="Đến nay, bạn đã tiêu diệt được <color=#CA2E0AFF>%s</color> con quái vật.",
    ["AnniversaryDataDes_007"]="<color=#CA2E0AFF>%s</color> lần rơi vào thế hạ phong khi đối đầu với kẻ địch mạnh.",
    ["AnniversaryDataDes_008"]="Trên chặng đường này, bạn đã nhận được <color=#CA2E0AFF>%s</color> món trang sức, đến nay vẫn đang chờ bạn khiêu chiến tiếp.",
    ["AnniversaryDataDes_008_1"]="Tủ Áo của bạn vẫn còn nhiều chỗ trống, đoán xem thứ gì là món may mắn tiếp theo?",
    ["AnniversaryDataDes_009"]="Vào chặng đường tiếp theo, <color=#CA2E0AFF>%s</color> Thú Cưỡi sẽ bên cạnh bạn.",
    ["AnniversaryDataDes_010"]="Tình bạn bền vững như kim cương, tô điểm chuyến hành trình, bạn đã làm bạn bè với <color=#CA2E0AFF>%s</color> Nhà Thám Hiểm.",
    ["AnniversaryDataDes_010_1"]="Trong lòng bạn, dường như có một thế giới nhỏ chỉ thuộc về riêng mình, dù tương lai náo nhiệt hay trầm lắng, bạn đều có thể tìm thấy sự bình yên ở đó.",
    ["AnniversaryDataDes_011"]="Trong đó, <color=#CA2E0AFF>%s</color> là đồng hành thân thiết nhất của bạn.",
    ["AnniversaryDataDes_012"]="Ngoài ra, bạn còn kết duyên lành với <color=#CA2E0AFF>%s</color> NPC.",
    ["AnniversaryDataDes_013"]="Bạn cũng là người giỏi mua bán, đã thực hiện <color=#CA2E0AFF>%s</color> đơn hàng trong Quầy Giao Dịch.",
    ["AnniversaryDataDes_013_1"]="Hãy vào Quầy Giao Dịch trổ tài mua bán thiên bẩm của mình bằng đơn hàng đầu tiên nào!",
    ["AnniversaryDataDes_014"]="Trong quá trình này, bạn kiếm được tổng <color=#CA2E0AFF>%s</color> Pha Lê.",
    ["AnniversaryDataDes_015"]="Đồng thời, bạn cũng trở nên mạnh hơn, bạn đã tiêu <color=#CA2E0AFF>%s</color> Pha Lê.",
    ["AnniversaryDataDes_016"]="Bạn còn kiếm được vật phẩm quý hiếm, đã chi ra <color=#CA2E0AFF>%s</color> Kim Cương.",
    ["AnniversaryDataDes_017"]="Một nhà sưu tập thiên bẩm như bạn cũng đã có được <color=#CA2E0AFF>%s</color> tấm Thẻ.",
    ["AnniversaryDataDes_017_1"]="Rất tiếc, bạn chưa có Thẻ nào cả, chúng sẽ giúp bạn có lực chiến đấu mạnh hơn, tiếp tục cố gắng nhé!",
    ["AnniversaryDataDes_018"]="Trong đó, Thẻ <color=#CA2E0AFF>%s</color> là chiến lợi phẩm quý giá sau khi đánh quái trong nửa năm gần đây.",
    ["AnniversaryDataDes_019"]="Thám hiểm đến nay, Sổ Tay Học Viện bạn đã mở khóa <color=#CA2E0AFF>%s</color> loại Đồ Giám Thẻ.",
    ["AnniversaryHint_2"]="HAPPY 3RD ANNIVERSARY",
    ["AnniversaryHint_3"]="Nhận thành công",
    ["AnniversaryMessageTips_002"]="Ký tự bạn nhập quá ít, không thể để lại lời nhắn",
    ["AnniversaryMessageTips_003"]="Ký tự bạn nhập đã đạt giới hạn",
    ["AnniversaryMessageTips_004"]="Cứ tiêu hao %s Xu Ước Nguyện Sao, có thể tặng %s đạo cụ lời nhắn màn hình chạm sàn (%s/%s)",
    ["AnniversaryMessageTips_005"]="Số lượng Pha Lê nhận được: %s (Thưởng được gửi qua thư)",
    ["AnniversaryMessageTips_006"]="1. Các loại màn hình khác nhau tiêu hao các loại Xu khác nhau khi để lại lời nhắn\n2. Sau khi để lại lời nhắn trên màn hình toàn cảnh, có thể được hiển thị trên màn hình lớn nhất trong map Prontera và hiển thị thông báo toàn server, hiển thị trong kênh Chat Thế Giới và hiển thị trên đầu\n3. Sau khi để lại lời nhắn trên màn hình chạm sàn, có thể được hiển thị trên màn hình cỡ trung bình trong map Prontera. Khi người chơi di chuyển đến chỗ NPC Poring sẽ có hiển thị bình luận màn hình trên map\n4. Sau khi để lại lời nhắn trên màn hình nhỏ, có thể được hiển thị trên màn hình nhỏ trong map Prontera. Khi người chơi di chuyển đến chỗ NPC Poring sẽ có hiển thị bình luận màn hình trên map\n5. Tăng số lượng lời nhắn có thể tăng thời lượng lời nhắn hiển thị trên màn hình\n6. Khi có đạo cụ lời nhắn, đạo cụ lời nhắn sẽ được ưu tiên sử dụng khi để lại lời nhắn\n7. Đối với cùng một loại lời nhắn màn hình, sau khi lời nhắn lần này kết thúc hiển thị mới có thể để lại lời nhắn lần sau. Khi có nhiều người để lại lời nhắn cùng một loại màn hình, sẽ được xếp hàng và hiển thị theo thời gian của lời nhắn.",
    ["AnniversaryMessageTips_007"]="Để lại lời nhắn thành công",
    ["AnniversaryMessageTips_008"]="Xu Ước Nguyện Sao đã có: %s",
    ["AnniversaryMessageTips_009"]="Có thể nhận được qua Gói Quà và nhiệm vụ Ước Nguyện",
    ["AnniversaryMessageTips_010"]="1. Trong giai đoạn Ước Nguyện, chọn ước nguyện, đặt vào Xu Ước Nguyện Sao là có thể ước nguyện\n2. Khi đến giai đoạn mở thưởng, tiến hành rút thưởng dựa trên số lượng Xu Ước Nguyện Sao đặt vào, đặt vào càng nhiều, xác suất rút trúng càng cao\n3. Có thể chọn nhiều lần ba ước nguyện\n4. Rút Pha Lê dựa trên tổng số Xu Ước Nguyện Sao đặt vào của ba ước nguyện",
    ["AnniversaryMessageTips_011"]="Lời nhắn của loại màn hình hiện tại đang được xếp hàng/hiển thị",
    ["AnniversaryMessageTips_012"]="Số lượng đã đặt vào: %s",
    ["AnniversaryMessageTips_013"]="Số lượng người chơi có xác suất hiện tại vượt quá %s%",
    ["AnniversaryMessageTips_014"]="Số trận hiện tại: Đang mở, kết thúc sau %s",
    ["AnniversaryMessageTips_015"]="Bắt đầu trận tiếp theo sau %s",
    ["AnniversaryMessageTips_016"]="Thời gian sự kiện: %s-%s",
    ["AnniversaryMessageTips_017"]="Ước nguyện thành công",
    ["AnniversaryMessageTips_018"]="%s mở",
    ["AnniversaryMessageTips_019"]="TIME:%s~%s",
    ["AnniversaryMessageTips_020"]="Thời gian sự kiện: %s-%s",
    ["AnniversaryMessageTips_051"]="Bạn có muốn trở thành Nhà Thám Hiểm được mọi người chú ý? Vậy hãy đến tìm tôi và để lại lời nhắn nhé!",
    ["AnniversaryMessageTips_052"]="Lời nhắn sẽ hiển thị ở %s, phía trước có %s người chơi, duy trì %s",
    ["AnniversaryMessageTips_053"]="Dự kiến lời nhắn sẽ hiển thị ở %s, phía trước có %s người chơi, duy trì %s",
    ["AnniversaryMessageTips_054"]="Lời nhắn đang hiển thị, duy trì %s phút",
