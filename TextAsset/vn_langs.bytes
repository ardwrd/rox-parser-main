    ["ui_TanabataFestival_006"]="Thưởng nhận được",
    ["ui_TanabataFestival_007"]="Cầu Nguyện",
    ["ui_TanabataFestival_008"]="Trong thời gian sự kiện, sau khi <color=#FFED00FF>Nhà Thám Hiểm kết đôi</color> tốn Odin diệt quái chỉ định nhận được phần thưởng",
    ["ui_TanabataFestival_009"]="Quà Tình Yêu",
    ["ui_TanabataFestival_010"]="VIP Kafra sẽ được nhận thêm <color=#DB79F0>10</color> lần tặng quà!",
