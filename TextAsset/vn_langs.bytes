    ["ui_Affirm_003"]="Xác nhận bán",
    ["ui_Affirm_004"]="Kiểm tra đạo cụ sẽ tăng tỷ lệ thành công nếu nâng cấp thất bại (thẻ đặc quyền có thể tăng thêm)",
    ["ui_Affirm_005"]="Chúc Phúc",
    ["ui_Affirm_006"]="Cấp này không cần buff",
    ["ui_Affirm_007"]="Sau khi nâng cấp, cấp độ của tất cả các thiết bị bóng tối sẽ được tăng lên đồng thời.",
    ["ui_Affirm_008"]="Vui lòng chọn vật liệu gắn bóng ở bên trái",
    ["ui_Alert001"]="Tài khoản được đăng nhập ở nơi khác",
    ["ui_Alert002"]="Kết nối lại thất bại\n\nVui lòng kiểm tra đường truyền mạng và thử lại!",
    ["ui_AncientInspection_001"]="Vật Tư Hội Eden",
    ["ui_AncientInspection_002"]="Sổ Tay Khảo Cổ",
    ["ui_AncientInspection_003"]="Khảo Cổ",
    ["ui_AncientInspection_004"]="Trong thời gian mở Odin, tiêu diệt quái vật chỉ định sẽ nhận Mẫu Ký Tự",
    ["ui_AncientInspection_005"]="Đánh bại quái chỉ định\nNhận Mẫu Ký Tự đổi Thưởng lớn",
    ["ui_AnniCeremony_001"]="Hãy nhập lời chúc sinh nhật~ Có cơ hội hãy thể hiện ở buổi diễn mừng sinh nhật nhé~",
    ["ui_AnniCeremony_003"]="Bấm đê nhập (tối đa 30 chữ)",
    ["ui_AnniCeremony_004"]="[Buổi hòa nhạc thường niên] sẽ được tổ chức vào 20:00 ngày 15 tháng 10!",
    ["ui_AnniCeremony_005"]="Top 3 Nhà Thám Hiểm trong cuộc bình chọn cuối cùng của khu vực sẽ có cơ hội tham gia tương tác tại nhạc hội mừng sinh nhật và cùng chia thưởng. Do rủi ro bất khả kháng trong các sự kiện offline, quyền giải thích cuối cùng của sự kiện này thuộc về \"Ragnarok X: Thế Hệ Mới\".",
    ["ui_AnniCeremony_006"]="Biết Cách\n Làm Giàu",
    ["ui_AnniCeremony_007"]="Trai Tim\n Dũng Sĩ",
    ["ui_AnniCeremony_008"]="Tinh Thần\n Cầu Tiến",
    ["ui_AnniCeremony_009"]="Đại Gia\n Sưu Tầm",
    ["ui_AnniCeremony_010"]="Du Ngoạn\n Thế Giới",
    ["ui_AnniCeremony_011"]="Cấp Dũng Sĩ",
    ["ui_AnniCeremony_012"]="Thử Thách Nốt Nhạc",
    ["ui_AnniCeremony_013"]="Shop",
    ["ui_AnniCeremony_014"]="Thời Đại Mới Nổi",
    ["ui_AnniCeremony_015"]="Đụng Đâu Đánh Đó",
    ["ui_AnniCeremony_016"]="Không Có Niềm Vui",
    ["ui_AnniCeremony_017"]="Thơ Văn Hoa Mỹ",
    ["ui_AnniCeremony_018"]="Tiếng Vọng Trời Cao",
    ["ui_AnniCeremony_019"]="Thưởng Thám Hiểm",
    ["ui_AnniCeremony_020"]="Hãy nhận quà sinh nhật của dũng sĩ",
    ["ui_AnniCeremony_021"]="Nhận nhanh",
    ["ui_AnniCeremony_022"]="Ước nguyện sinh nhật",
    ["ui_AnniCeremony_023"]="Ước nguyện",
    ["ui_AnniCeremony_024"]="Được nhận gói quà mừng sinh nhật <size=20>2022</size>, thực hiệu nguyện vọng",
    ["ui_AnniCeremony_025"]="Chỉ được chọn 1 trong ba nguyện vọng",
    ["ui_AnniCeremony_026"]="Shop",
    ["ui_AnniCeremony_027"]="Đạo cụ hiếm",
    ["ui_AnniCeremony_028"]="Đạo cụ trưởng thành",
    ["ui_AnniCeremony_029"]="Điểm Lễ Hội",
    ["ui_AnniCeremony_030"]="Xin chào!",
    ["ui_AnniCeremony_031"]="Hàng tạm trống",
    ["ui_AnniCeremony_032"]="Bắt đầu truy xuất",
    ["ui_AnniCeremony_033"]="1. Trong [Tiếng Vọng Bass], thống kê dữ liệu từ khi người chơi tạo tài khoản, để hoàn thành nhiệm vụ truy xuất; \n\n2. Trong thời gian sự kiện, các nhiệm vụ cần tích lũy vẫn có thể tăng tiếp; \n\n3. Các nhiệm vụ trong chuỗi [Thợ Săn Kim Cương] thống kê số Kim Cương đã nạp trước đây của người chơi, Kim Cương đã nạp trước đây sẽ dựa trên tỷ lệ 10:1, trong sự kiện, Kim Cương đã nạp được chuyển đổi thành điểm Kim Cương với tỷ lệ 1:1, dùng để hoàn thành nhiệm vụ; \n\n4. Chuỗi nhiệm vụ [Ông Trùm Kinh Doanh] thống kê giá trị giao dịch Pha Lê trước thuế ứng với các giao dịch lịch sử của người chơi, nhưng không tính vào giao dịch mua bán Kim Cương và đấu giá vật phẩm quý hiếm.",
    ["ui_AnniCeremony_034"]="[Thử Thách Nốt Nhạc] thống kê dữ liệu người chơi trong sự kiện, dùng để hoàn thành nhiệm vụ",
    ["ui_AnniCeremony_035"]="Đã chọn xong sẽ không thể đổi",
    ["ui_AnniCeremony_036"]="Mau bỏ phiếu cho Thời Trang yêu thích!\nBXH sẽ được làm mới sau giây lát~",
    ["ui_AnniCeremony_037"]="Mỗi đợt chỉ được bỏ phiếu một lần, hoàn thành bỏ phiếu sẽ nhận được phần thưởng",
    ["ui_AnniCeremony_038"]="Đã bỏ phiếu",
    ["ui_AnniCeremony_039"]="Thu thập",
    ["ui_AnniCeremony_040"]="x2",
    ["ui_AnniCeremony_041"]="Hoàn thành ngay",
    ["ui_AnnivWardrobe_001"]="Hiệu ứng Tủ trưng Bày",
    ["ui_AnnivWardrobe_002"]="Hiệu ứng hiển thị",
    ["ui_AnnivWardrobe_003"]="Bỏ vào Tủ Trưng Bày",
    ["ui_AnniversaryCeremonyKR_001"]="Lời Nhắn Neon",
    ["ui_AnniversaryCeremonyKR_002"]="Chọn loại Lời Nhắn",
    ["ui_AnniversaryCeremonyKR_003"]="Số lượng tin nhắn",
    ["ui_AnniversaryCeremonyKR_004"]="Tiêu hao:",
    ["ui_AnniversaryCeremonyKR_005"]="Ưu tiên tiêu hao:",
    ["ui_AnniversaryCeremonyKR_006"]="Nhập nội dung văn bản",
    ["ui_AnniversaryCeremonyKR_007"]="Văn bản ngẫu nhiên",
    ["ui_AnniversaryCeremonyKR_008"]="Gửi",
    ["ui_AnniversaryCeremonyKR_009"]="Trong thời gian sự kiện, <color=#ffd800>%s-%s đúng</color> hàng ngày, có thể nhận được Rương tại khu vực Prontera chỉ định",
    ["ui_AnniversaryCeremonyKR_010"]="1. Cứ cách 10 giây sẽ nhận được Rương Vui Vẻ",
    ["ui_AnniversaryCeremonyKR_011"]="2. Vào khu vực chỉ định sẽ tự động phát động tác khiêu vũ",
    ["ui_AnniversaryCeremonyKR_012"]="3. Tiến độ nhận thưởng lớn Rương Vui Vẻ: %s/%s",
    ["ui_AnniversaryCeremonyKR_013"]="Giới hạn nhận được hôm nay",
    ["ui_AnniversaryCeremonyKR_014"]="Thu thập Xu Ước Nguyện Sao, tổng cộng chia thành <size=26><color=#FEEF3C>400 triệu</color></size> Pha Lê",
    ["ui_AnniversaryCeremonyKR_015"]="Thu thập nhiều Ước Nguyện Sao, được nhận nhiều Pha Lê hơn!",
    ["ui_AnniversaryCeremonyKR_016"]="Đã có Xu Ước Nguyện Sao",
    ["ui_AnniversaryCeremonyKR_017"]="Ước Nguyện",
    ["ui_AnniversaryCeremonyKR_018"]="(Thưởng được gửi qua thư)",
    ["ui_AnniversarySea2024_00"]="Tiêu hao 2.000 Chúc Phúc Odin mỗi ngày nhận trang phục",
    ["ui_AnniversarySea2024_001"]="Mỗi ngày tiêu hao 2.000 Chúc Phúc Odin tổng 5 ngày liên tục nhận trọn bộ trang phục",
    ["ui_AnniversarySea2024_002"]="Nhận thẻ bài",
    ["ui_AnniversarySea2024_003"]="Ra bài",
    ["ui_AnniversarySea2024_004"]="Mỗi tấm chắc chắn nhận thưởng",
    ["ui_AnniversarySea2024_005"]="Đã sao chép, hãy mau dán đi nhé!",
    ["ui_AnniversarySea2024_006"]="Tổng giá sản phẩm",
    ["ui_AnniversarySea2024_007"]="Giá nhận được",
    ["ui_AnniversarySea2024_008"]="Tiêu thụ phiếu mua lại từ các nhà giao dịch để nhận được pha lê; tiêu thụ pha lê từ các nhà giao dịch để nhận được nhiều phiếu mua lại hơn.",
