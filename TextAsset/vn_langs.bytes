    ["BuffDes_10413079"]="Ăn Thịt Nướng Bạc Hà I, Hút Máu Pháp Thuật +6%",
    ["BuffDes_10413080"]="Ăn Trai Nướng Than I, Phản Đòn Pháp Thuật +6%",
    ["BuffDes_10413081"]="Ăn Thịt Nướng Tỉnh Táo I, Kháng Trạng Thái Debuff +10",
    ["BuffDes_1042"]="Vào trạng thái <color=#7ACEFF>Giáp Hệ Nước</color>, trong thời gian duy trì hiệu ứng, thuộc tính Giáp chuyển thành hệ <color=#9ACEFF>Nước</color>.",
    ["BuffDes_10420007"]="Đã ăn Xiên Nướng I, Kháng Choáng +23%, Kháng Mù +23%",
    ["BuffDes_10420008"]="Đã ăn Cơm Chiên Hải Sản Đặc Sắc I, Kháng Đông Đá +23%, Kháng Nguyền Rủa +23%",
    ["BuffDes_10420009"]="Đã ăn Salad Miền Biển I, Kháng Định Thân +23%, Kháng Trúng Độc +23%",
    ["BuffDes_10420010"]="Đã ăn Da Cá Tráp Nhồi Thịt Thượng Hạng I, Kháng Hóa Đá +23%, Kháng Đổ Máu +23%",
    ["BuffDes_10420011"]="Đã ăn Cua Màn Thầu Cay Nồng I, Kháng Mê Man +23%, Kháng Phá Giáp +23%",
    ["BuffDes_10420012"]="Đã ăn Cá Tráp Đỏ Nướng Đá I, Kháng Trầm Mặc +23%, Kháng Phá Vũ Khí +23%",
    ["BuffDes_10424175"]="Ăn Thịt Bò Dầm I, Giảm Sát Thương Vật Lý Cuối PVP +5%",
    ["BuffDes_10424176"]="Ăn Chocolate Hoa Hồng I, Giảm Sát Thương Pháp Thuật Cuối PVP +5%",
    ["BuffDes_10424177"]="Ăn Thịt Sốt Kem I, Sát Thương Vật Lý Cuối PVP kèm theo +5%",
    ["BuffDes_10424178"]="Ăn Ếch Nướng I, Sát Thương Pháp Thuật Cuối PVP kèm theo +5%",
    ["BuffDes_10424179"]="Ăn Tôm Viên I, Giảm Debuff PVP +5%",
    ["BuffDes_10424180"]="Ăn Thịt Hàu Sữa I, Kháng Trạng Thái Debuff PVP +5",
    ["BuffDes_1043"]="Vào trạng thái <color=#7ACEFF>Giáp Hệ Đất</color>, trong thời gian duy trì hiệu ứng, thuộc tính giáp chuyển thành hệ <color=#9ACEFF>Nước</color>.",
    ["BuffDes_10450000"]="Tăng EXP treo máy diệt quái Odin gấp 3 lần",
    ["BuffDes_10450001"]="Tăng EXP treo máy diệt quái Odin gấp 5 lần",
    ["BuffDes_1046"]="Vào trạng thái <color=#44afee>Sợ Hãi</color>, trong thời gian duy trì hiệu ứng, di chuyển ngẫu nhiên không bị khống chế.",
    ["BuffDes_1047"]="Vào trạng thái <color=#7ACEFF>Giáp Hệ Gió</color>, trong thời gian duy trì hiệu ứng, thuộc tính Giáp chuyển thành Hệ <color=#9ACEFF>Gió</color>.",
    ["BuffDes_1048"]="Vào trạng thái <color=#7ACEFF>Giáp Hệ Lửa</color>, trong thời gian duy trì hiệu ứng, thuộc tính Giáp chuyển thành Hệ <color=#9ACEFF>Lửa</color>.",
    ["BuffDes_1049"]="Vào trạng thái <color=#7ACEFF>Giáp Hệ Thánh</color>, trong thời gian duy trì hiệu ứng, thuộc tính Giáp chuyển thành Hệ <color=#9ACEFF>Thánh</color>.",
    ["BuffDes_1057"]="Khi ở trạng thái <color=#44afee>Ẩm Ướt</color>, trong thời gian duy trì hiệu ứng, khi Điểm Ẩm Ướt đạt đến <color=#44afee>%s</color>, sẽ vào trạng thái bóng nước.",
    ["BuffDes_1058"]="Khi ở trạng thái <color=#44afee>Trói Buộc Bóng Nước</color>, trong thời gian duy trì hiệu ứng, không thể di chuyển và tấn công. Trạng thái bóng nước tích lũy vượt quá <color=#44afee>%s</color>giây sẽ bị loại. Trong thời gian được cứu viện sẽ không tích lũy thời gian duy trì.",
    ["BuffDes_1061"]="Ở trạng thái <color=#7ACEFF>giảm kháng hệ Thây Ma</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>hệ Thây Ma</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1062"]="Ở trạng thái <color=#7ACEFF>giảm kháng Lửa</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>thuộc tính Lửa</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1063"]="Ở trạng thái <color=#7ACEFF>giảm kháng Nước</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>thuộc tính Nước</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1064"]="Ở trạng thái <color=#7ACEFF>giảm kháng hệ Bóng Tối</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>hệ Bóng Tối</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1065"]="Ở trạng thái <color=#7ACEFF>giảm kháng hệ Hồn Ma</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>hệ Hồn Ma</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1066"]="Ở trạng thái <color=#7ACEFF>giảm kháng Thánh</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>thuộc tính Thánh</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1067"]="Ở trạng thái <color=#7ACEFF>giảm kháng Gió</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>thuộc tính Gió</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1068"]="Ở trạng thái <color=#7ACEFF>giảm kháng Đất</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>thuộc tính Đất</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1069"]="Ở trạng thái <color=#7ACEFF>giảm kháng Độc</color>, trong lúc duy trì hiệu ứng sát thương <color=#7ACEFF>thuộc tính Độc</color> nhận mỗi tầng tăng <color=#7ACEFF>10%%</color>, có thể cộng dồn.",
    ["BuffDes_1079"]="Vào buổi tối, tỷ lệ EXP Odin tăng 130%",
    ["BuffDes_1080"]="Hệ nghề hiện tại: Kiếm Sĩ-Thương Kỵ",
    ["BuffDes_1081"]="Hệ nghề hiện tại: Kiếm Sĩ-Kiếm Nhanh",
    ["BuffDes_1082"]="Hệ nghề hiện tại: Kiếm Sĩ-Thể Kỵ",
    ["BuffDes_1083"]="Hệ nghề hiện tại: Kiếm Sĩ-Xả Thân",
    ["BuffDes_1084"]="Hệ nghề hiện tại: Kiếm Sĩ-Thẩm Phán",
    ["BuffDes_1085"]="Hệ nghề hiện tại: Kiếm Sĩ-Nện Khiên",
    ["BuffDes_1086"]="Hệ nghề hiện tại: Ma Pháp Sư-Địa Hỏa",
    ["BuffDes_1087"]="Hệ nghề hiện tại: Ma Pháp Sư-Sấm Băng",
    ["BuffDes_1088"]="Hệ nghề hiện tại: Thương Gia-Người Máy",
    ["BuffDes_1089"]="Hệ nghề hiện tại: Thương Gia-Tiền Bạc",
    ["BuffDes_1090"]="Hệ nghề hiện tại: Thương Gia-Xe Đẩy",
    ["BuffDes_1091"]="Hệ nghề hiện tại: Tu Sĩ-Bạo Mục",
    ["BuffDes_1092"]="Hệ nghề hiện tại: Tu Sĩ-Trục Quỷ",
    ["BuffDes_1093"]="Hệ nghề hiện tại: Tu Sĩ-Ngợi Khen",
    ["BuffDes_1094"]="Hệ nghề hiện tại: Tu Sĩ-A Bá",
    ["BuffDes_1095"]="Hệ nghề hiện tại: Tu Sĩ-Phá Hoàng",
    ["BuffDes_1096"]="Hệ nghề hiện tại: Tu Sĩ-Đạn Chỉ",
    ["BuffDes_1097"]="Hệ nghề hiện tại: Tu Sĩ-Đạn Chỉ",
    ["BuffDes_1098"]="Hệ nghề hiện tại: Cung Thủ-Bạo Liệp",
    ["BuffDes_1099"]="Hệ nghề hiện tại: Cung Thủ-Cung Dài Săn Chim",
    ["BuffDes_1100"]="Hệ nghề hiện tại: Cung Thủ-Săn Bắn",
    ["BuffDes_11003221"]="Ở trạng thái <color=#7ACEFF>Cơn Giận Bùng Nổ</color>, trong thời gian duy trì hiệu ứng, vũ khí chuyển thành <color=#7ACEFF>Hệ Lửa</color> và tăng <color=#7ACEFF>%s%%</color> ST Đánh Thường.",
    ["BuffDes_11003231"]="Vào trạng thái <color=#7ACEFF>Bá Thể</color>, khi cách người thi triển 30m và trong thời gian duy trì hiệu ứng, bị tấn công sẽ không dừng cũng không bị đánh lùi, đồng thời tăng <color=#7ACEFF>%s</color> Điểm Song Phòng. Ở trạng thái Bá Thể, sau khi bị tấn công <color=#7ACEFF>%s</color> lần sẽ bị cưỡng chế giải trừ.",
    ["BuffDes_11003241"]="Vào trạng thái <color=#7ACEFF>Chọc Ghẹo</color>, trong thời gian duy trì hiệu ứng, đơn vị bị chọc ghẹo Lực Phòng Thủ giảm <color=#7ACEFF>%s%%</color>, Lực Tấn Công tăng <color=#7ACEFF>%s%%</color>, đồng thời cưỡng chế mục tiêu tấn công bản thân.",
    ["BuffDes_11003261"]="Vào trạng thái <color=#7ACEFF>Hồi Phục Cấp Tốc</color>, trong thời gian duy trì hiệu ứng, mỗi giây hồi <color=#7ACEFF>4%%</color> HP Max.",
    ["BuffDes_11003271"]="Vào trạng thái <color=#7ACEFF>Ý Chí Chiến Đấu</color>, trong thời gian duy trì hiệu ứng, mỗi lần đánh thường trúng, Vật Thương kèm tăng <color=#44afee>%s</color> điểm, tối đa cộng dồn <color=#7ACEFF>8</color> lớp.",
    ["BuffDes_11003281"]="Vào trạng thái <color=#7ACEFF>Đánh Vào Điểm Yếu</color>, trong thời gian duy trì hiệu ứng, Vật Phòng giảm <color=#7ACEFF>%s</color> điểm.",
    ["BuffDes_1101"]="Hệ nghề hiện tại: Cung Thủ-Cung Ngắn Săn Chim",
    ["BuffDes_1102"]="Hệ nghề hiện tại: Đạo Chích-Bạo Thích",
    ["BuffDes_1103"]="Hệ nghề hiện tại: Đạo Chích-Ẩn Kích",
    ["BuffDes_1104"]="Hệ nghề hiện tại: Tân Thủ",
    ["BuffDes_1106"]="Phòng Cụ Lv.0",
    ["BuffDes_1107"]="Phòng Cụ Lv.1",
    ["BuffDes_1108"]="Phòng Cụ Lv.2",
    ["BuffDes_1109"]="Phòng Cụ Lv.3",
    ["BuffDes_1110"]="Phòng Cụ Lv.4",
    ["BuffDes_11102351"]="Vào trạng thái <color=#7ACEFF>Trọng Kích Đôi</color>, trong thời gian duy trì hiệu ứng, mỗi lần đánh thường có xác suất <color=#7ACEFF>30%%</color> kèm <color=#7ACEFF>%s%%</color> Sát thương hệ Trung Tính bỏ qua Phòng Thủ và Xuyên Thấu.",
    ["BuffDes_11103211"]="Vào trạng thái <color=#7ACEFF>Phản Kích</color>, trong thời gian duy trì hiệu ứng, miễn dịch sát thương bằng <color=#7ACEFF>%s%%</color> HP Max.",
    ["BuffDes_11103271"]="Vào trạng thái <color=#7ACEFF>Tăng Tốc Kiếm</color>, trong thời gian duy trì hiệu ứng, Tốc Đánh Cuối tăng <color=#7ACEFF>%s%%</color>, khi hủy trang bị Kiếm, trạng thái này sẽ bị cưỡng chế giải trừ.",
    ["BuffDes_11103291"]="Ở trạng thái <color=#7ACEFF>Dũng Cảm</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy tăng <color=#7ACEFF>%s%%</color>, Vật Phòng tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_11103301"]="Vào trạng thái <color=#7ACEFF>Cưỡi Ngựa Tấn Công</color>, trong thời gian duy trì hiệu ứng, Tốc Đánh Cuối và Tốc Chạy giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_11103341"]="Vào trạng thái <color=#7ACEFF>Tim Thép</color>, trong thời gian duy trì hiệu ứng, sát thương phải chịu giảm <color=#7ACEFF>%s%%</color>, đồng thời trong <color=#7ACEFF>%s</color> lần tiếp theo, khi bị tấn công sẽ không dừng, số lần bị tấn công sau khi đạt giới hạn thì hiệu ứng này hết hiệu lực.",
    ["BuffDes_1111"]="Phòng Cụ Lv.5",
    ["BuffDes_11113211"]="Vào trạng thái <color=#7ACEFF>Dồn Sát Thương</color>, trong thời gian duy trì hiệu ứng tăng <color=#7ACEFF>%s%%</color> Vật Công và <color=#7ACEFF>50%%</color> Sát Thương Bạo Kích, và có xác suất <color=#7ACEFF>%s%%</color> khiến mục tiêu rơi vào trạng thái Đổ Máu khi trúng đánh thường.",
    ["BuffDes_11113241"]="Vào trạng thái <color=#7ACEFF>Kiếm Linh Khí</color>, trong thời gian duy trì hiệu ứng, tăng <color=#44afee>%s%%</color> Bạo Kích Cuối và <color=#44afee>%s%%</color> Sát Thương Bạo Kích kèm.",
    ["BuffDes_11113251"]="Vào trạng thái <color=#7ACEFF>Cuồng Nộ</color>, trong thời gian duy trì hiệu ứng, HP Max tăng <color=#7ACEFF>%s%%</color>, Vật Công tăng <color=#7ACEFF>%s%%</color>, Tốc Chạy tăng <color=#7ACEFF>30%%</color>, duy trì Bá Thể, Song Phòng mỗi thứ giảm <color=#7ACEFF>50%%</color>. Trong trạng thái Cuồng Nộ không thể chủ động sử dụng kỹ năng và vật phẩm phục hồi, giảm hiệu ứng nhận trị liệu <color=#44afee>100%%</color>, HP và SP không thể tự hồi phục. Khi HP dưới <color=#7ACEFF>5%%</color>, cưỡng chế giải trừ trạng thái này.",
    ["BuffDes_11113253"]="Vào trạng thái <color=#7ACEFF>Cấm Hồi Phục</color>, trong thời gian duy trì hiệu ứng không thể hồi HP và SP.",
    ["BuffDes_11113261"]="Vào trạng thái <color=#7ACEFF>Tập Trung Tấn Công</color>, trong thời gian duy trì hiệu ứng, sát thương phải chịu từ đội của người thi triển tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_11113271"]="Ở trạng thái <color=#7ACEFF>Chống Đỡ Vũ Khí</color>, khi chịu Vật Thương đến từ kẻ địch trước mặt bản thân trong thời gian duy trì hiệu ứng sẽ có <color=#7ACEFF>%s%%</color> xác suất chống đỡ tấn công của kẻ địch, sau khi chống đỡ thành công, miễn <color=#7ACEFF>Vật Thương</color> phải chịu lần này và gây Vật Thương Hệ Vũ Khí bằng <color=#7ACEFF>%s%%</color> x Vật Công cho mục tiêu, kỹ năng này có thể bạo kích. Khi trang bị Kiếm Hai Tay, Hệ Số ST của kỹ năng này tăng <color=#7ACEFF>100%%</color>.",
    ["BuffDes_11113311"]="Vào trạng thái <color=#7ACEFF>Thắp Sáng Sinh Mệnh</color>, trong thời gian duy trì hiệu ứng, mỗi giây giảm <color=#7ACEFF>1%%</color> HP Max và gây cho đơn vị phe địch xung quanh (<color=#7ACEFF>%s%%</color> HP Max +<color=#7ACEFF>%s</color>) điểm sát thương <color=#7ACEFF>Vật Lý Thần Thánh</color> hệ Trung Tính, khi HP dưới <color=#7ACEFF>10%%</color> sẽ giải trừ trạng thái này. Trong trạng thái Thắp Sáng Sinh Mệnh, HP&SP (gồm HP&SP mỗi 5 giây) sẽ không thể tự hồi phục, trong PVP không thể kích hoạt hiệu ứng hồi phục hồi máu cấp tốc. Sát thương này không thể hút máu.",
    ["BuffDes_11113331"]="Vào trạng thái <color=#7ACEFF>Hào Quang Lãnh Chúa</color>, toàn bộ thành viên cách người thi triển 30m tăng <color=#7ACEFF>%s%%</color> Vật Công trong thời gian duy trì hiệu ứng. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_1112"]="Phòng Cụ Lv.6",
    ["BuffDes_11122021"]="Ở trạng thái <color=#44afee>Thiêu Đốt</color>, trong thời gian duy trì hiệu ứng mỗi giây mất <color=#44afee>2%%</color> HP tối đa.",
    ["BuffDes_11122051"]="Ở trạng thái <color=#44afee>Ràng Buộc Chết Chóc</color>, HP bị mất do bản thân nhận sát thương trong thời gian duy trì hiệu ứng sẽ được chuyển thành sát thương vật lý hệ trung tính theo tỷ lệ <color=#44afee>%s%%</color> và được chia sẻ với mục tiêu bị ràng buộc. Khi khoảng cách lớn hơn 12m, hiệu ứng Ràng Buộc sẽ bị hủy.",
    ["BuffDes_11122052"]="Ở trạng thái <color=#44afee>Ràng Buộc Chết Chóc</color>, trong thời gian duy trì hiệu ứng, bản thân sẽ chịu sát thương vật lý hệ trung tính theo tỷ lệ <color=#44afee>%s%%</color> của HP bị mất do người thi triển chịu sát thương. Khi khoảng cách lớn hơn 12m, hiệu ứng Ràng Buộc sẽ bị hủy.",
    ["BuffDes_11122071"]="Ở trạng thái <color=#44afee>Kiên Cố Vững Chắc</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> hiệu ứng Vật Phòng Cuối và hiệu ứng Pháp Phòng Cuối, được cộng dồn <color=#44afee>5</color> lớp. Khi số lớp cộng dồn đạt tối đa sẽ hình thành Thần Khiên Phù Văn.",
    ["BuffDes_11122072"]="Ở trạng thái <color=#44afee>Thần Khiên Phù Văn</color>, sát thương bị chặn bởi khiên có <color=#44afee>%s%%</color> HP tối đa trong thời gian duy trì hiệu ứng.",
    ["BuffDes_11122082"]="Tất cả ST phải chịu tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_11122101"]="Ở trạng thái <color=#44afee>Đao Liệt Phong</color>, Sát Thương Bạo Kích kèm tăng <color=#44afee>%s%%</color> trong thời gian duy trì hiệu ứng, cộng dồn tối đa <color=#44afee>6</color> lớp. Khi số lớp cộng dồn đạt tối đa, mỗi lần gây Bạo Kích sẽ gây thêm Vật Thương thuộc tính vũ khí <color=#44afee>%s%%</color> Vật Công lên mục tiêu.",
    ["BuffDes_11122121"]="Ở trạng thái <color=#44afee>Kiếm Trận Lửa</color>, đánh thường trúng mục tiêu trong thời gian duy trì sẽ cộng dồn một lớp hiệu ứng <color=#44afee>Lửa Tối</color> cho thành viên đội trong vòng <color=#44afee>30</color>m. Mỗi lớp <color=#44afee>Lửa Tối</color> tăng <color=#44afee>%s%%</color> Chính Xác Cuối và <color=#44afee>%s%%</color> Bạo Kích Cuối, cộng dồn tối đa <color=#44afee>12</color> lớp.",
    ["BuffDes_11122122"]="Ở trạng thái <color=#44afee>Lửa Tối</color>, mỗi lớp tăng <color=#44afee>%s%%</color> Chính Xác Cuối và <color=#44afee>%s%%</color> Bạo Kích Cuối.",
    ["BuffDes_11122131"]="Mỗi lớp giảm <color=#44afee>25%%</color> Tốc Chạy.",
    ["BuffDes_11131011"]="Ở trạng thái <color=#44afee>Chúc Phúc Đá Rune Nosiege</color>, trong thời gian duy trì hiệu ứng, bản thân tăng <color=#44afee>5%%</color> * Vật Thương Cuối kèm/ Pháp Thương Cuối kèm/ Vật Thương Cuối PVP kèm/ Pháp Thương Cuối PVP kèm của số người có trạng thái này trong đội, cộng dồn tối đa <color=#44afee>5</color> lớp.",
    ["BuffDes_11131021"]="Ở trạng thái <color=#44afee>Chúc Phúc Đá Rune Rhydo</color>, trong thời gian duy trì hiệu ứng, bản thân tăng <color=#44afee>5%%</color> * Giảm Vật Thương Cuối/ Giảm Pháp Thương cuối/ Giảm Vật Thương Cuối PvP/ Giảm Pháp Thương Cuối PvP của số người có trạng thái này trong đội, cộng dồn tối đa <color=#44afee>5</color> lớp.",
    ["BuffDes_11131031"]="Ở trạng thái <color=#44afee>Chúc Phúc Đá Rune Verkana</color>, trong thời gian duy trì hiệu ứng, mỗi 30 giây bản thân thêm <color=#44afee>10%%</color> HP tối đa * Khiên Chắn của số người có trạng thái này trong đội, Khiên duy trì <color=#44afee>15</color> giây.",
    ["BuffDes_11131041"]="Ở trạng thái <color=#44afee>Chúc Phúc Đá Rune Isia</color>, trong thời gian duy trì hiệu ứng, khi thành viên trong đội có trạng thái này thi triển kỹ năng chủ động đều sẽ hồi <color=#44afee>1%%</color> HP tối đa cho toàn đội.",
    ["BuffDes_11131051"]="Ở trạng thái <color=#44afee>Chúc Phúc Đá Rune Asir</color>, trong thời gian duy trì hiệu ứng, khi thành viên trong đội có trạng thái này kích hoạt Bạo Kích đều sẽ hồi <color=#44afee>0.15%%</color> HP tối đa cho toàn đội.",
    ["BuffDes_11131061"]="Vào trạng thái <color=#44afee>Chúc Phúc Đá Rune Urj</color>, trong thời gian duy trì hiệu ứng, sát thương bản thân phải chịu giảm <color=#44afee>3%%</color>*số người trong đội mang trạng thái này, đồng thời phần sát thương còn lại sẽ được chia đều cho tất cả các thành viên trong đội mang trạng thái trong phạm vi 30m, tối đa cộng dồn <color=#44afee>5</color> lớp.",
    ["BuffDes_11131071"]="Ở trạng thái <color=#44afee>Chúc Phúc Đá Rune Turisus</color>, trong thời gian duy trì hiệu ứng, bản thân tăng <color=#44afee>0.5</color> * Tốc Chạy của số người có trạng thái này trong đội, cộng dồn tối đa <color=#44afee>5</color> lớp.",
    ["BuffDes_11131081"]="Ở trạng thái <color=#44afee>Chúc Phúc Đá Rune Pertz</color>, trong thời gian duy trì hiệu ứng khi gây Trạng Thái Debuff cho kẻ địch, bỏ qua Kháng Trạng Thái bằng <color=#44afee>5%%</color> x Số người có trạng thái này trong đội. Bỏ qua Kháng Trạng Thái Debuff, Kháng Trạng Thái Debuff PVP bằng <color=#44afee>5</color> x Số người có trạng thái này trong đội, cộng dồn tối đa <color=#44afee>5</color> tầng.",
    ["BuffDes_11131091"]="Ở trạng thái <color=#44afee>Chúc Phúc Đá Rune Hagalas</color>, trong thời gian duy trì hiệu ứng, cứ mỗi <color=#44afee>10%%</color> HP bị mất sẽ có tỉ lệ <color=#44afee>5%%</color> * số người có trạng thái này trong đội khiến kẻ địch bị choáng <color=#44afee>1</color> giây trong phạm vi <color=#44afee>2</color> mét quanh bản thân. Tỉ lệ kích hoạt cộng dồn tối đa <color=#44afee>5</color> lớp.",
    ["BuffDes_11132011"]="Khi thực hiện đòn tấn công cơ bản<color=#44afee>%s%%</color>Xác suất tiêu thụ<color=#44afee>1</color>Hướng thân kiếm khí xung quanh mục tiêu<color=#44afee>4</color>Gây sát thương cho tất cả kẻ thù trong phạm vi một mét và sát thương do thân kiếm khí gây ra có thể là đòn chí mạng.",
    ["BuffDes_11132021"]="Tích lũy mỗi khi bạn bị một thành viên trong nhóm tấn công từ nguồn dấu ấn<color=#44afee>1</color>Đánh dấu lớp, dấu ấn chồng lên<color=#44afee>%s</color>lớp, rơi<color=#44afee>1</color>Bó<color=#44afee>Vũ khí tối thượng của Deadpool</color>",
    ["BuffDes_11132051"]="khi có được<color=#44afee>%s</color>lớp<color=#44afee>lực bão</color>Khi đó, Storm Slash sẽ được kích hoạt để tấn công mục tiêu.<color=#44afee>5</color>các cuộc tấn công.",
    ["BuffDes_11132071"]="khi<color=#44afee>Tích lũy sức mạnh</color>Lớp phủ để<color=#44afee>12</color>lớp, có thể được kích hoạt tích cực<color=#44afee>đâm thủng</color>Tác dụng",
    ["BuffDes_11132072"]="Thi triển bằng giáo<color=#44afee>đâm liên tiếp</color>,<color=#44afee>mũi giáo đâm</color>,<color=#44afee>ném giáo</color>,<color=#44afee>lực đẩy xoắn ốc</color>,<color=#44afee>Cuộc tấn công ma quái</color>,<color=#44afee>cú đâm nhanh</color>,<color=#44afee>đập phá bạo lực</color>Gây thêm sát thương.",
    ["BuffDes_11132091"]="TRONG<color=#7ACEFF>chậm lại</color>Trạng thái, tốc độ di chuyển bị giảm trong thời gian hiệu ứng<color=#7ACEFF>33%%</color>.",
    ["BuffDes_11132101"]="TRONG<color=#44afee>Nguồn sức sống</color>trạng thái, bạn sẽ nhận được<color=#44afee>%s</color>Với việc tăng kỹ năng này, các đòn tấn công kỹ năng được tung ra sẽ mang thêm sát thương từ Rune Dragon Lord.",
    ["BuffDes_11132111"]="nhận được<color=#44afee>chế nhạo</color>, Buộc phải tấn công mục tiêu của nguồn Buff.",
    ["BuffDes_11132112"]="Sạc lên để vào trạng thái phòng thủ và đạt được<color=#44afee>%s%%</color>Giảm sát thương vật lý cuối cùng và giảm sát thương phép thuật cuối cùng, giảm tốc độ di chuyển của bản thân<color=#44afee>%s%%</color>",
    ["BuffDes_1115"]="Thợ Săn Biến Hình",
    ["BuffDes_1116"]="Thợ Rèn Biến Hình",
    ["BuffDes_1117"]="Kỵ Sĩ Biến Hình",
    ["BuffDes_1118"]="Sát Thủ Biến Hình",
    ["BuffDes_1119"]="Phù Thủy Biến Hình",
    ["BuffDes_1120"]="Mục Sư Biến Hình",
    ["BuffDes_11202051"]="Ở trạng thái <color=#ffd700>Thánh Lực</color>, trong thời gian duy trì hiệu ứng, mỗi tầng tăng <color=#44afee>%s%%</color> phần trăm Vật Công và <color=#44afee>%s%%</color> Tốc Chạy của bản thân.",
    ["BuffDes_11202101"]="Ở trạng thái <color=#7ACEFF>Tăng Tốc Vũ Khí</color>, trong thời gian duy trì hiệu ứng, tăng <color=#7ACEFF>%s</color> điểm Tốc Đánh và <color=#7ACEFF>%s</color> điểm Bạo Kích của bản thân.",
    ["BuffDes_11202111"]="Ở trạng thái <color=#7ACEFF>Liều Mình Tấn Công</color>, trong thời gian duy trì hiệu ứng, <color=#7ACEFF>%s</color> lần đánh thường tiếp theo sẽ kèm thêm ST vật lý hệ Vũ Khí bằng <color=#7ACEFF>%s%%</color> HP Max của bản thân (có thể bạo kích), đồng thời khi kết thúc trạng thái sẽ hoàn trả HP bằng (<color=#7ACEFF>0.8%%</color> *số lần bạo kích) HP Max của bản thân.",
    ["BuffDes_1121"]="Thập Tự Quân Biến Hình",
    ["BuffDes_11212021"]="Ở trạng thái <color=#7ACEFF>Uy Danh</color>, trong thời gian duy trì hiệu ứng, Hệ Giáp biến thành Hệ Thánh, đồng thời tăng <color=#7ACEFF>%s%%</color> Phòng Bạo và <color=#7ACEFF>%s%%</color> Giảm ST Bạo Kích.",
    ["BuffDes_11212031"]="Ở trạng thái <color=#7ACEFF>Thánh Âm</color>, trong thời gian duy trì hiệu ứng, sát thương bản thân gây ra tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_11212051"]="Ở trạng thái <color=#7ACEFF>Súng Trận-Trăng Tròn</color>, trong thời gian duy trì hiệu ứng, sát thương kẻ địch trong trận gây cho bản thân giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_11212061"]="Ở trạng thái <color=#44afee>Uy Lực Thần Thánh</color>, trong thời gian duy trì hiệu ứng, mỗi tầng khiến bản thân chịu ST từ thành viên của đội người thi triển tăng <color=#44afee>%s%%</color>, khi kết thúc thời gian duy trì, dựa theo số tầng <color=#daa520>Thánh Lực</color> tiêu hao, chịu Vật Thương Hệ Thánh bằng Vật Công của người thi triển x <color=#44afee>313%%|713%%|1213%%</color> x Số tầng Uy Lực Thần Thánh.",
    ["BuffDes_11212081"]="Ở trạng thái <color=#7ACEFF>Khiên Ánh Sáng</color>, trong thời gian duy trì hiệu ứng, sát thương bản thân phải chịu giảm <color=#7ACEFF>%s%%</color>. Nếu bị tấn công, thì trong 5s sẽ giảm <color=#7ACEFF>%s%%</color> Tốc Chạy của người tấn công.",
    ["BuffDes_11212082"]="Ở trạng thái <color=#7ACEFF>Khiên Ánh Sáng</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy bản thân giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_11212091"]="Ở trạng thái <color=#7ACEFF>Phá Giáp</color>, trong thời gian duy trì hiệu ứng, sát thương bản thân phải chịu tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_11212101"]="Ở trạng thái <color=#7ACEFF>Chiến Ý</color>, trong thời gian duy trì hiệu ứng, mỗi lớp Chiến Ý tăng <color=#7ACEFF>%s%%</color> Bạo Kích Cuối và <color=#7ACEFF>%s%%</color> Sát Thương Bạo Kích Kèm của bản thân. Khi mỗi lần chịu 1 lần sát thương vượt quá <color=#7ACEFF>35%%</color> HP Max của bản thân, trong đó sát thương bằng <color=#7ACEFF>%s%%</color> *(số lớp còn) sẽ giảm (tối đa tính [20] lớp).",
    ["BuffDes_1122"]="Võ Tăng Biến Hình",
    ["BuffDes_11222031"]="Ở trạng thái <color=#7ACEFF>Vua Bảo Vệ</color>, trong thời gian duy trì hiệu ứng, nhận được Khiên bằng <color=#7ACEFF>%s%%</color> HP Max của bản thân, khi xóa Khiên, sẽ gây ST vật lý hệ Vũ Khí bằng <color=#7ACEFF>%s%%</color> Khiên cho tất cả đơn vị phe địch trong phạm vi 3m xung quanh.",
    ["BuffDes_11222041"]="Ở trạng thái <color=#7ACEFF>Đổ Máu</color>, trong thời gian duy trì hiệu ứng, mỗi giây mất HP bằng Vật Công x <color=#7ACEFF>%s%%</color> của Người Thi Triển. Cả Vật Công và Tốc Đánh đều giảm <color=#7ACEFF>25%%</color>, đồng thời HP và SP không thể hồi phục một cách tự nhiên.",
    ["BuffDes_11222051"]="Ở trạng thái <color=#44afee>Thẩm Phán Khởi Nguyên</color>, trong thời gian duy trì hiệu ứng, ST Hệ Thánh bản thân phải chịu từ người thi triển tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_11222053"]="Ở trạng thái <color=#44afee>Xua Đuổi Khởi Nguyên</color>, cứ <color=#44afee>2</color> giây xoá hiệu ứng Buff một lần",
    ["BuffDes_11222081"]="Ở trạng thái <color=#7ACEFF>Hy Sinh</color>, trong thời gian duy trì hiệu ứng, HP Max của bản thân tăng <color=#7ACEFF>%s%%</color>, đồng thời giảm <color=#7ACEFF>50%%</color> Vật Công của bản thân, <color=#7ACEFF>50%%</color> sát thương thành viên nhóm phải chịu do bản thân chịu.",
    ["BuffDes_11222082"]="Ở trạng thái <color=#7ACEFF>Thủ Hộ Hy Sinh</color>, <color=#7ACEFF>50%%</color> sát thương bản thân phải chịu sẽ do nguồn Buff chịu trong thời gian duy trì hiệu ứng.",
    ["BuffDes_11222092"]="Ở trạng thái <color=#7ACEFF>Áp Chế</color>, Tốc Đánh và Tốc Chạy của bản thân giảm <color=#7ACEFF>%s%%</color> trong thời gian duy trì hiệu ứng.",
    ["BuffDes_11222101"]="Ở trạng thái <color=#7ACEFF>Dao Thề Ước</color>, trong thời gian duy trì hiệu ứng nhận được Khiên bằng <color=#7ACEFF>%s%%</color> HP Max bản thân, đồng thời tăng Hút Máu Vật Lý theo HP đã mất.",
    ["BuffDes_11222111"]="Ở trạng thái <color=#7ACEFF>Lời Thề Sinh Mệnh</color>, trong thời gian duy trì hiệu ứng, khi bản thân dùng [Liều Mình Tấn Công], [Đòn Đánh Dũng Cảm], [Lời Thề Sinh Mệnh] để trừ HP bản thân, mục tiêu được ký khế ước cũng sẽ chịu ST vật lý hệ Vũ Khí bằng <color=#7ACEFF>%s%%</color> lượng trừ, tối đa gây sát thương bằng <color=#7ACEFF>30%%</color> HP Max của bản thân.",
    ["BuffDes_11222112"]="Ở trạng thái <color=#7ACEFF>Lời Thề Sinh Mệnh</color>, trong thời gian duy trì hiệu ứng, khi người thi triển dùng [Liều Mình Tấn Công], [Đòn Đánh Dũng Cảm], [Lời Thề Sinh Mệnh] để trừ HP bản thân, bản thân cũng sẽ chịu ST vật lý hệ Vũ Khí bằng <color=#7ACEFF>%s%%</color> lượng trừ.",
    ["BuffDes_11222121"]="Ở trạng thái <color=#7ACEFF>Thánh Linh Cảm Nhận</color>, trong thời gian duy trì hiệu ứng, Đánh Thường sẽ chuyển thành bắn [Thánh Linh Sáng Chói] về phía mục tiêu, [Thánh Linh Sáng Chói] khiến mục tiêu và đơn vị phe địch trong phạm vi <color=#7ACEFF>3</color>m xung quanh mục tiêu chịu ST vật lý hệ Thánh bằng <color=#7ACEFF>%s%%</color> HP Max của người thi triển (có thể bạo kích), nếu trong phạm vi không có mục tiêu khác, thì mục tiêu sẽ chịu thêm ST vật lý hệ Thánh bằng <color=#7ACEFF>%s%%</color> HP Max của người thi triển (có thể bạo kích). Trong thời gian [Thánh Linh Cảm Nhận], <color=#7ACEFF>%s%%</color> sát thương bản thân phải chịu sẽ được lưu, đồng thời trong <color=#7ACEFF>3</color> s sẽ trừ theo hình thức Đổ Máu, số lần bạo kích của bản thân cứ đạt <color=#7ACEFF>30</color> lần sẽ kích hoạt 1 lần [Tịnh Hóa], xóa hiệu ứng Đổ Máu và tất cả sát thương được lưu.",
    ["BuffDes_1123"]="Nhà Thông Thái Biến Hình",
    ["BuffDes_11232011"]="In Offensive Stance.",
    ["BuffDes_11232013"]="While active, using <color=#44afee>Shield Charge</color>, <color=#44afee>Shield Boomerang</color>, or <color=#44afee>Earth Drive</color> grants you a certain chance to increase the skill coefficient by an additional <color=#44afee>%s%%</color>.",
    ["BuffDes_11232021"]="In Defensive Stance.",
    ["BuffDes_11232041"]="Each stack increases your Final Crit by <color=#44afee>%s%%</color> and Crit DMG Bonus by <color=#44afee>%s%%</color>.",
    ["BuffDes_11232051"]="Upon activation, the next attack deals additional corresponding element damage equal to <color=#44afee>%s%%</color> of the attacker's Adaptive ATK.",
    ["BuffDes_11232052"]="While active, the next attack deals additional corresponding element damage equal to <color=#44afee>%s%%</color> of the attacker's Adaptive ATK.",
    ["BuffDes_11232093"]="Each stack increases the damage against Dragon monsters, Undead monsters, and Formless monsters by <color=#44afee>%s%%</color>, <color=#44afee>%s%%</color>, and <color=#44afee>%s%%</color>, respectively.",
    ["BuffDes_11232094"]="Each stack increases your Final P.DEF by <color=#44afee>%s%%</color> and Final M.DEF by <color=#44afee>%s%%</color>.",
    ["BuffDes_11232121"]="Increases the damage dealt to MVP and MINI units by <color=#44afee>%s%%</color>.",
    ["BuffDes_1124"]="Người Hát Rong Biến Hình",
    ["BuffDes_1125"]="Vũ Nữ Biến Hình",
    ["BuffDes_1127"]="Ở trạng thái Tước Vũ Khí, không thể tấn công và thi triển kỹ năng.",
    ["BuffDes_12003251"]="TRONG<color=#7ACEFF>ánh sáng thiên thần</color>Trạng thái, giảm trong thời gian hiệu ứng<color=#44afee>%s</color>Điểm phòng thủ vật lý và phòng thủ phép thuật.",
    ["BuffDes_12003261"]="Vào trạng thái <color=#7ACEFF>Thiên Sứ Ban Phúc</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, Sức Mạnh, Linh Hoạt và Trí Lực mỗi thứ tăng <color=#7ACEFF>%s</color> điểm. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12003271"]="Vào trạng thái <color=#7ACEFF>Ruwach</color>, trong thời gian duy trì hiệu ứng, có thể nhờ Thánh Linh giúp tìm đơn vị phe địch <color=#7ACEFF>ẩn nấp</color> cạnh bản thân.",
    ["BuffDes_12003281"]="Vào trạng thái <color=#7ACEFF>Thuật Tăng Tốc</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, Nhanh Nhẹn tăng <color=#7ACEFF>%s</color> điểm, Tốc Chạy tăng <color=#7ACEFF>%s%%</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12003282"]="Vào trạng thái <color=#7ACEFF>Thuật Tăng Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Đánh tăng <color=#7ACEFF>%s</color> điểm.",
    ["BuffDes_12003301"]="Vào trạng thái <color=#7ACEFF>Chúc Phúc Ánh Sáng</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, mỗi giây hồi cho người thi triển HP bằng (<color=#7ACEFF>%s%%</color> Pháp Công +<color=#7ACEFF>%s</color>). Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12102321"]="Vào trạng thái <color=#7ACEFF>Chướng Ngại Ánh Sáng</color>, trong thời gian duy trì hiệu ứng sẽ <color=#7ACEFF>miễn dịch Vật Thương Tầm Xa</color>, Chướng Ngại tối đa có thể chịu được <color=#7ACEFF>%s</color> lần. ST ngăn cản không thể vượt quá 50%% HP tối đa của người giữ buff.",
    ["BuffDes_12103241"]="TRONG<color=#7ACEFF>Cơn thịnh nộ của thiên thần</color>Trạng thái, sát thương của đòn tấn công kỹ năng chủ động tiếp theo trong thời gian hiệu ứng được tăng lên.<color=#7ACEFF>%s%%</color>. Không hợp lệ ngoài 30 mét từ caster.",
    ["BuffDes_12103271"]="Vào trạng thái <color=#7ACEFF>Cầu Phúc Vẩy Nước</color>, trong thời gian duy trì hiệu ứng, thuộc tính Vũ Khí chuyển thành <color=#7ACEFF>hệ Thánh</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12103281"]="TRONG<color=#7ACEFF>Sức mạnh và phước lành của Thiên Chúa</color>Trạng thái, sát thương vật lý sẽ được tăng thêm trong thời gian hiệu lực.<color=#44afee>%s%%</color>. Trong thời gian này, khi sử dụng kỹ năng gây sát thương vật lý, một vật mang bổ sung sẽ được gắn vào.<color=#44afee>%s%%</color>Đòn tấn công vật lý bỏ qua sát thương vật lý thánh phòng thủ và sát thương bổ sung là<color=#44afee>2</color>Hiệu ứng này có thể được kích hoạt tối đa một lần mỗi giây. Thiệt hại do hiệu ứng tiêu cực định kỳ gây ra sẽ không kích hoạt hiệu ứng này. Không hợp lệ ngoài 30 mét từ caster.",
    ["BuffDes_12103291"]="Vào trạng thái <color=#7ACEFF>Chướng Ngại Thiên Sứ</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, Vật Phòng tăng <color=#7ACEFF>%s%%</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12103301"]="Vào trạng thái <color=#7ACEFF>Ca Tụng Thánh Mẫu</color>, trong thời gian duy trì hiệu ứng tăng <color=#7ACEFF>%s%%</color> tốc độ hồi SP, đồng thời tăng <color=#7ACEFF>%s</color> điểm Pháp Thương kèm. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12103331"]="Vào trạng thái <color=#7ACEFF>Kyrie Eleison</color>, trong thời gian duy trì hiệu ứng, dùng Khiên Phòng Thủ đỡ sát thương, Khiên Phòng Thủ tối đa có thể đỡ <color=#7ACEFF>%s</color> lần sát thương hoặc <color=#7ACEFF>%s%%</color> HP Max, mục nào vượt mức thì Khiên Phòng Thủ mất hiệu lực. ",
    ["BuffDes_12103371"]="Ở trạng thái <color=#7ACEFF>Làm Chậm</color>, trong thời gian duy trì hiệu ứng, giảm <color=#7ACEFF>%s%%</color> Tốc Chạy, <color=#7ACEFF>%s%%</color> Tốc Đánh Cuối và <color=#44afee>%s%%</color> Cấp Tốc Cuối.",
    ["BuffDes_12112291"]="Vào trạng thái <color=#7ACEFF>Bức Tường An Toàn</color>, trong thời gian duy trì hiệu ứng sẽ <color=#7ACEFF>miễn dịch Vật Thương Cận Chiến</color>, Bức Tường tối đa có thể chịu được <color=#7ACEFF>%s</color> lần.",
    ["BuffDes_12113221"]="Vào trạng thái <color=#7ACEFF>Bảo Hộ Thần Thánh</color>, trong thời gian duy trì hiệu ứng nếu nhận phải Sát Thương Chí Tử sẽ miễn dịch sát thương bằng <color=#7ACEFF>%s%%</color> HP Max (bị ảnh hưởng bởi hiệu quả trị liệu). Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12113251"]="Vào trạng thái <color=#7ACEFF>Cầu Phúc Hiến Tế</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, Cấp Tốc Cuối tăng <color=#7ACEFF>%s%%</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12113261"]="Vào trạng thái <color=#7ACEFF>Cầu Phúc Thánh Mẫu</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, Pháp Phòng tăng <color=#7ACEFF>%s%%</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12113271"]="Vào trạng thái <color=#7ACEFF>Bài Ca May Mắn</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng tăng <color=#7ACEFF>%s</color> Điểm May Mắn. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_12113272"]="Vào trạng thái <color=#7ACEFF>Bài Ca May Mắn</color>, trong thời gian duy trì hiệu ứng, Bạo Kích tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_12113361"]="Vào trạng thái <color=#7ACEFF>Đòn Vòng Sáng</color>, trong thời gian duy trì hiệu ứng, Đánh Thường của Chùy gây thêm Vật Thương hệ Thánh Bỏ Qua Thủ bằng <color=#8ACEFF>%s</color> Vật Công bản thân.",
    ["BuffDes_12113362"]="Vào trạng thái <color=#7ACEFF>Ký Hiệu Vòng Sáng</color>, mỗi lần vào trạng thái <color=#9ACEFF>Đòn Vòng Sáng</color>, người chơi sau khi đánh thường sẽ tăng một lớp ký hiệu, số lớp tối đa là <color=#9ACEFF>20</color> lớp.",
    ["BuffDes_12122011"]="Vào trạng thái <color=#44afee>Ấn Ký Cây Sinh Mệnh</color>, trong thời gian duy trì hiệu ứng, mỗi giây hồi <color=#44afee>3%%</color> HP và SP, đồng thời tăng <color=#44afee>%s%%</color> Giảm Sát Thương Cuối.",
    ["BuffDes_12122021"]="Ở trạng thái <color=#44afee>Cống Hiến Cầu Phúc</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Buff Trị Liệu và trạng thái Miễn Dịch Debuff.",
    ["BuffDes_12122022"]="Vào trạng thái <color=#44afee>Cầu Phúc Hiến Dâng</color>, trong thời gian duy trì hiệu ứng, miễn dịch debuff (Không miễn dịch debuff có nguồn gốc từ Quái Cấp Boss).",
    ["BuffDes_12122031"]="Vào trạng thái <color=#44afee>Kyrie Eleison-Ca Tụng</color>, trong thời gian duy trì hiệu ứng, dùng Khiên Phòng Thủ chống đỡ sát thương, Khiên Phòng Thủ tối đa có thể chống đỡ <color=#7ACEFF>%s</color> lần sát thương hoặc <color=#7ACEFF>%s%%</color> HP Max, vượt mục bất kỳ Khiên Phòng Thủ sẽ vô hiệu.",
    ["BuffDes_12122051"]="Vào trạng thái <color=#44afee>Thánh Lễ</color>, trong thời gian duy trì hiệu ứng, rút ngắn thêm <color=#44afee>%s</color> giây thời gian Vận Công cố định và <color=#44afee>%s</color> giây CD cố định.",
    ["BuffDes_12122061"]="Vào trạng thái <color=#44afee>Chống Đỡ Trị Liệu</color>, trong thời gian duy trì hiệu ứng, hiệu quả trị liệu nhận được vô hiệu, đồng thời lượng trị liệu <color=#44afee>%s%%</color> nhận được chuyển hóa thành Pháp Thương Trung Tính.",
    ["BuffDes_12122071"]="Vào trạng thái <color=#44afee>Ấn Ký Ánh Sáng</color>, trong thời gian duy trì, khiến mục tiêu kết nối Vòng Sáng giảm tốc <color=#44afee>50%%</color>, kết thúc thời gian duy trì, gây Pháp Thương Hệ Thánh của <color=#44afee>%s%%</color> Pháp Công cho kẻ địch kết nối Vòng Sáng trong phạm vi 6m, và khiến mục tiêu vào trạng thái Định Thân <color=#44afee>%s</color> giây.",
    ["BuffDes_12122072"]="Vào trạng thái <color=#44afee>Trói Buộc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#44afee>50%%</color>. Nếu khi kết thúc thời gian duy trì, ở trong phạm vi cách người thi triển 6m, sẽ chịu Pháp Thương Hệ Thánh.",
    ["BuffDes_12122081"]="Vào trạng thái <color=#44afee>Lời Cầu Nguyện</color>, trong thời gian duy trì hiệu ứng, tăng <color=#44afee>%s%%</color> Tăng Cường Hệ Thánh.",
    ["BuffDes_12122091"]="Vào trạng thái <color=#44afee>Khuyên Can</color>, trong thời gian duy trì hiệu ứng, Vật Thương Cuối kèm & Pháp Thương Cuối kèm giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_12122101"]="Vào trạng thái <color=#44afee>Hai Tầng Vòng Sáng</color>, trong thời gian duy trì hiệu ứng, mỗi giây gây cho kẻ địch trong phạm vi 3m <color=#44afee>%s%%</color> sát thương Hệ Thánh, sát thương tạo thành mỗi lần cho cùng 1 mục tiêu tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_12122111"]="Vào trạng thái <color=#44afee>Thánh Linh Phù Hộ</color>, trong thời gian duy trì hiệu ứng, mỗi lần chịu sát thương sẽ đồng thời nhận được <color=#44afee>%s%%</color> hiệu ứng trị liệu sát thương đó.",
    ["BuffDes_12122121"]="Vào trạng thái <color=#44afee>Kiếm Thánh Linh</color>, trong thời gian duy trì hiệu ứng, Đánh Thường lần đầu sẽ thi triển Ký Hiệu Kiếm Thánh Linh cho mục tiêu.",
    ["BuffDes_12122122"]="Vào trạng thái <color=#44afee>Ký Hiệu Kiếm Thánh Linh</color>, khi kết thúc thời gian duy trì hiệu ứng, sẽ chịu tỉ lệ sát thương nhất định từ tổng sát thương phải chịu từ người thi triển trong suốt thời gian diễn ra hiệu ứng.",
    ["BuffDes_12122131"]="TRONG<color=#44afee>Búa phán xét</color>Trạng thái, tăng thêm sát thương chí mạng trong thời gian hiệu ứng<color=#44afee>%s%%</color>và tăng cường thâm nhập vật liệu cuối cùng<color=#44afee>%s%%</color>, nhiều nhất là chồng lên nhau<color=#44afee>%s</color>lớp. Khi cộng dồn đến mức tối đa, mỗi khi xảy ra đòn chí mạng, thời gian hồi chiêu của [Holy Hammer] và [Holy Light Strike] sẽ giảm đi.<color=#44afee>0,25</color>Thứ hai.",
    ["BuffDes_12132011"]="Trả lời mỗi giây<color=#44afee>%s%%</color>Tuổi thọ MaxHp.",
    ["BuffDes_12132031"]="Mỗi lớp tự tăng lên<color=#44afee>%s%%</color>MaxHp.",
    ["BuffDes_12132041"]="TRONG<color=#7ACEFF>Vận mệnh vinh quang</color>Trạng thái, sát thương đòn đánh cơ bản của phép thuật sẽ được tăng thêm trong thời gian hiệu ứng.<color=#44afee>%s%%</color>. Trong thời gian này, khi sử dụng kỹ năng gây sát thương phép, một vật mang bổ sung sẽ được gắn vào.<color=#44afee>%s%%</color>Các đòn tấn công phép thuật bỏ qua sát thương phép thuật phòng thủ, với sát thương bổ sung cho mỗi<color=#44afee>2</color>Hiệu ứng này có thể được kích hoạt tối đa một lần mỗi giây. Thiệt hại do hiệu ứng tiêu cực định kỳ gây ra sẽ không kích hoạt hiệu ứng này. Không hợp lệ ngoài 30 mét từ caster.",
    ["BuffDes_12132061"]="giảm bớt<color=#44afee>%s%%</color>chống cháy nổ cuối cùng và<color=#44afee>%s%%</color>Giảm sát thương chí mạng.",
    ["BuffDes_12132062"]="giảm bớt<color=#44afee>%s%%</color>Hiệu ứng phòng thủ vật lý cuối cùng.",
    ["BuffDes_12132063"]="Không thể di chuyển và giải phóng kỹ năng trong thời gian bị giam giữ",
    ["BuffDes_12132071"]="Mỗi đòn tấn công cơ bản có<color=#44afee>%s%%</color>Có khả năng triệu hồi ánh sáng thần thánh để gây sát thương vật lý thần thánh cho mục tiêu không phòng thủ.",
    ["BuffDes_12132081"]="Mỗi lần Holy Light Strike được kích hoạt, nó sẽ gây ra sát thương vật lý thuộc tính Holy, bỏ qua phòng thủ xung quanh mục tiêu và sát thương gây ra sẽ được chia cho tất cả các mục tiêu trong phạm vi.",
    ["BuffDes_12132091"]="Mỗi lớp tự tăng lên<color=#44afee>%s%%</color>Kháng trạng thái tiêu cực và giảm trạng thái tiêu cực.",
    ["BuffDes_12132101"]="Mất mỗi giây<color=#44afee>%s%%</color>MaxSP, mỗi khi bạn nhận sát thương thuộc tính thánh trong thời gian này<color=#44afee>%s%%</color>Có khả năng bị choáng trong 0,5 giây.",
    ["BuffDes_12132111"]="ngắt<color=#44afee>một mình</color>,<color=#44afee>quần thể</color>,<color=#44afee>tụng kinh</color>Và<color=#44afee>điệp khúc</color>Kỹ năng và không thể sử dụng trong thời gian hiệu lực<color=#44afee>một mình</color>,<color=#44afee>quần thể</color>,<color=#44afee>tụng kinh</color>Và<color=#44afee>điệp khúc</color>Kỹ năng.",
    ["BuffDes_12202021"]="Ở trạng thái [Đạn Khí], mỗi viên Đạn Khí có thể khiến Vật Công của người mang tăng (Nhanh Nhẹn *<color=#44afee>%s%%</color>) điểm.",
    ["BuffDes_12202041"]="Ở trạng thái [Khí Nén Cuồng Bạo], mỗi viên Đạn Khí có thể khiến Vật Công của người mang tăng (Nhanh Nhẹn *<color=#44afee>%s%%</color>) điểm.",
    ["BuffDes_12202051"]="Ở trạng thái [Thịnh Nộ], mỗi lớp khiến Vật Công tăng thêm <color=#44afee>%s%%</color>.",
    ["BuffDes_12212011"]="Ở trạng thái [Điều Tức], cứ 0.5s hồi SP Max bằng (<color=#44afee>%s%%</color>* số lần hồi), nếu bị đánh thường hoặc tấn công kỹ năng trong quá trình dẫn dắt Điều Tức, Điều Tức sẽ kết thúc.",
    ["BuffDes_12212071"]="Ở trạng thái [Băng Kích], trong thời gian này, sát thương đến từ người thi triển tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_12212101"]="Ở trạng thái [Nội Công], trong thời gian này, mục tiêu cứ chịu 1 lần sát thương từ người thi triển, sẽ kích nổ Nội Công, chịu thêm ST vật lý hệ Vũ Khí bằng (<color=#44afee>%s%%</color> *Vật Công người thi triển)",
    ["BuffDes_12222011"]="Ở trạng thái Siêu Phàm, miễn dịch tất cả Trạng Thái Debuff.",
    ["BuffDes_12222021"]="Ở trạng thái [Rồng Thăng Thiên], trong thời gian này thêm <color=#44afee>%s</color> lớp trạng thái [Thịnh Nộ] cho bản thân đồng thời khiến Đạn Khí và giới hạn Đạn Khí bản thân mang theo tăng <color=#44afee>%s</color>, đồng thời giãn cách thời gian dùng cho [Khí Nén] giảm <color=#44afee>%s</color>s, trạng thái [Thịnh Nộ] mà Rồng Thăng Thiên kèm theo sẽ không bị xóa khi tiêu hao kỹ năng.",
    ["BuffDes_12222031"]="Ở trạng thái [Chú Ràng Buộc], tấn công trong thời gian này sẽ cấm cố <color=#44afee>%s</color>s.",
    ["BuffDes_12222041"]="Ở trạng thái [Kim Cang Bất Hoại], tăng <color=#44afee>%s%%</color> Miễn Sát Thương cho bản thân, đồng thời khi bị tấn công có <color=#44afee>%s%%</color> hồi HP bằng <color=#44afee>60%%</color> sát thương phải chịu lần này, duy trì 3s. Trong thời gian kỹ năng hiệu lực không thể thi triển kỹ năng khác và Đánh Thường.",
    ["BuffDes_12222091"]="Ở trạng thái Quyền Kình, mỗi lớp Quyền Kình khiến Bạo Kích Cuối của bản thân tăng <color=#44afee>%s%%</color>, ST Bạo Kích tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_12222111"]="Ở trạng thái [Dư Chấn], mỗi lớp Dư Chấn giảm <color=#44afee>30%%</color> Tốc Chạy của bản thân, tối đa được cộng dồn <color=#44afee>3</color> lớp. Khi đạt số lớp tối đa, sẽ bị choáng <color=#44afee>3</color>s.",
    ["BuffDes_12222121"]="Ở trạng thái [Lóa Mắt], mỗi lớp khiến sát thương bản thân phải chịu từ người thi triển tăng <color=#44afee>5%%</color>.",
    ["BuffDes_12232021"]="Max HP +<color=#44afee>%s%%</color>.",
    ["BuffDes_12232022"]="Reduces damage received from MVP, MINI, and Boss units by <color=#44afee>%s%%</color>.",
    ["BuffDes_12232023"]="Receives an additional <color=#44afee>%s%%</color> of Base EXP and Job EXP when killing monsters.",
    ["BuffDes_12232031"]="While active, casting certain skills grants an additional damage boost.",
    ["BuffDes_12232041"]="While active, casting certain skills has a chance to trigger the <color=#44afee>Zen</color> effect.",
    ["BuffDes_12232051"]="When taking damage from the Brand caster, each stack increases <color=#44afee>%s%%</color> damage.",
    ["BuffDes_12232061"]="While active, each stack increases your PVP Final P.DMG RED and PVP Final M.DMG RED by <color=#44afee>%s%%</color>.",
    ["BuffDes_12232062"]="While active, for <color=#44afee>each</color> stack of Brand applied to the target, you gain <color=#44afee>1</color> stack of Faith.",
    ["BuffDes_12232072"]="While active, for <color=#44afee>each</color> stack of Brand applied to the target, you deal an additional attack.",
    ["BuffDes_12232081"]="While active, attacking a target afflicted with Brand has a (<color=#44afee>%s%%</color> x Brand stacks) chance of triggering an additional attack. Triggers <color=#44afee>once</color> every <color=#44afee>2</color> seconds.",
    ["BuffDes_12232121"]="While active, casting certain skills does not consume Spirit Spheres and ignores <color=#44afee>%s%%</color> of the target's P.DMG Reflection.",
    ["BuffDes_13001221"]="Ở trạng thái <color=#44afee>Thi Triển Quán Tính</color>, giảm thời gian Ngân Nga cố định của Thuật Sét Đánh lần sau.",
    ["BuffDes_13001281"]="Ở trạng thái <color=#44afee>Thi Triển Quán Tính</color>, giảm thời gian Ngân Nga cố định của Thuật Tên Lửa lần sau.",
    ["BuffDes_13001301"]="Ở trạng thái <color=#44afee>Thi Triển Quán Tính</color>, giảm thời gian Ngân Nga cố định của Mũi Tên Băng lần sau.",
    ["BuffDes_13003211"]="Vào trạng thái <color=#7ACEFF>Giáp Nước Kéo Dài</color>, trong thời gian duy trì hiệu ứng, thuộc tính Giáp chuyển thành hệ <color=#9ACEFF>Nước</color>.",
    ["BuffDes_13003241"]="Vào trạng thái <color=#7ACEFF>Săn Lửa</color>, trong thời gian duy trì hiệu ứng có thể triệu hồi Cầu Lửa tìm đơn vị phe địch <color=#7ACEFF>ẩn nấp</color> bên cạnh.",
    ["BuffDes_13003261"]="Vào trạng thái <color=#7ACEFF>Áo Ngoài Năng Lượng</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Giảm Vật Thương Cuối của bản thân.",
    ["BuffDes_13101311"]="Ở trạng thái <color=#44afee>Thi Triển Quán Tính</color>, giảm thời gian Ngân Nga cố định của Thuật Rạn Nứt lần sau.",
    ["BuffDes_13103211"]="Vào trạng thái <color=#7ACEFF>Bão Tuyết Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>%s%%</color>, khi hiệu ứng Giảm Tốc đạt <color=#7ACEFF>3</color> lớp sẽ kích hoạt <color=#7ACEFF>Đóng Băng</color>.",
    ["BuffDes_13103221"]="Vào trạng thái <color=#7ACEFF>Bão Tuyết Đóng Băng</color>, trong thời gian duy trì hiệu ứng, thuộc tính Giáp chuyển thành hệ <color=#7ACEFF>Nước</color>, Pháp Phòng giảm <color=#44afee>20%%</color> đồng thời HP và SP không thể hồi phục tự nhiên. Sát thương phải chịu của hiệu ứng đóng băng này sẽ không loại bỏ.  ",
    ["BuffDes_13103231"]="Vào trạng thái <color=#44afee>Shadow-Tiếng Sấm</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Kháng Hắc Ám.",
    ["BuffDes_13103341"]="Ở trạng thái <color=#7ACEFF>Đầm Vực Sâu</color>, Tốc Đánh Cuối giảm <color=#7ACEFF>%s%%</color>, Cấp Tốc Cuối giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_13103342"]="Ở trạng thái <color=#7ACEFF>Đầm Vực Sâu</color>, tốc độ di chuyển giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_13113211"]="Ở trạng thái <color=#44afee>Bão Thiên Thạch II</color>, tăng <color=#44afee>%s%%</color> Kháng Choáng trong thời gian duy trì hiệu ứng, tối đa cộng dồn 6 lớp.",
    ["BuffDes_13113221"]="Vào trạng thái <color=#44afee>Shadow-Hồng Liên Vương</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Kháng Mù.",
    ["BuffDes_13113231"]="Vào trạng thái <color=#44afee>Shadow-Thuật Kết Sương</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Kháng Đông Đá.",
    ["BuffDes_13113241"]="Ở trạng thái <color=#44afee>Trường Trọng Lực II</color>, tăng <color=#44afee>%s%%</color> Kháng Choáng trong thời gian duy trì hiệu ứng, tối đa cộng dồn 6 lớp.",
    ["BuffDes_13113251"]="Vào trạng thái <color=#7ACEFF>Tăng Ma Lực</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, Pháp Thương tăng <color=#7ACEFF>%s%%</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_13113321"]="Khi ở trạng thái <color=#7ACEFF>Đốt Cháy</color>, trong thời gian duy trì hiệu ứng, mỗi giây chịu sát thương Lửa bằng <color=#7ACEFF>%s%%</color> Pháp Công, đồng thời sát thương Lửa đến từ người thi triển tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_13113341"]="TRONG<color=#7ACEFF>Dịch chuyển mạnh mẽ</color>Trạng thái, mỗi lớp giảm dần trong thời gian hiệu ứng.<color=#44afee>0,2</color>Đã sửa lỗi tụng kinh mỗi giây, được cải thiện<color=#44afee>%s%%</color>Thuộc tính suy nghĩ được tăng cường.",
    ["BuffDes_13122011"]="Vào trạng thái <color=#44afee>Nhà Ngục Trắng</color>, trong thời gian duy trì hiệu ứng ở trạng thái <color=#44afee>Định Thân</color> và sát thương Hệ Hồn Ma khác phải chịu từ người thi triển tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_13122031"]="TRONG<color=#44afee>rào cản trắng</color>trạng thái và trong thời gian hiệu ứng, thuộc tính áo giáp của bạn sẽ trở thành<color=#44afee>đọc</color>thuộc tính và miễn nhiễm với mọi sát thương thuộc tính khác ngoại trừ thuộc tính tâm trí (sát thương của Mvp, Mini và Boss không thể miễn nhiễm).",
    ["BuffDes_13122061"]="Vào trạng thái <color=#44afee>Tăng Cường Hệ Gió</color>, trong thời gian duy trì hiệu ứng, tăng cường Hệ Gió tăng <color=#44afee>%s%%</color>, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_13122062"]="Vào trạng thái <color=#44afee>Tăng Cường Hệ Đất</color>, trong thời gian duy trì hiệu ứng, tăng cường Hệ Đất tăng <color=#44afee>%s%%</color>, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_13122063"]="Vào trạng thái <color=#44afee>Tăng Cường Hệ Nước</color>, trong thời gian duy trì hiệu ứng, tăng cường Hệ Nước tăng <color=#44afee>%s%%</color>, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_13122064"]="Vào trạng thái <color=#44afee>Tăng Cường Hệ Lửa</color>, trong thời gian duy trì hiệu ứng, tăng cường Hệ Lửa tăng <color=#44afee>%s%%</color>, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_13122071"]="Vào trạng thái <color=#44afee>Thiêu Đốt</color>, trong thời gian duy trì hiệu ứng, mỗi giây mất HP bằng <color=#44afee>%s%%</color> HP Max.",
    ["BuffDes_13122076"]="Vào trạng thái <color=#44afee>Vòng Xoáy Nguyên Tố - Thuật Hắc Ám</color>, trong thời gian duy trì hiệu ứng, giảm <color=#44afee>50%</color> Kháng Mù.",
    ["BuffDes_13122077"]="Vào trạng thái <color=#44afee>Vòng Xoáy Nguyên Tố - Thuật Hóa Đá</color>, trong thời gian duy trì hiệu ứng, giảm <color=#44afee>50%</color> Kháng Hóa Đá.",
    ["BuffDes_13122078"]="Vào trạng thái <color=#44afee>Vòng Xoáy Nguyên Tố - Thuật Đông Đá</color>, trong thời gian duy trì hiệu ứng, giảm <color=#44afee>50%</color> Kháng Đông Đá.",
    ["BuffDes_13122091"]="Vào trạng thái <color=#44afee>Cảm Ứng</color>, trong thời gian duy trì hiệu ứng, cách xa đơn vị khác mang trạng thái Cảm Ứng dưới <color=#44afee>4</color>m, sẽ chịu Pháp Thương Hệ Gió.",
    ["BuffDes_13122101"]="Ở trạng thái <color=#44afee>Bão Hỗn Loạn</color>, trong thời gian duy trì hiệu ứng mỗi <color=#44afee>0.5</color> giây sẽ nhận Pháp Thương hệ Gió và kèm thêm trạng thái <color=#44afee>Hỗn Loạn</color>.",
    ["BuffDes_13122111"]="Vào trạng thái <color=#44afee>Sương Băng</color>, trong thời gian duy trì hiệu ứng Tốc Chạy giảm <color=#44afee>%s%%</color>, đồng thời khi chịu sát thương có <color=#44afee>%s%%</color> xác suất bị Đóng Băng <color=#44afee>3</color>s. Kích hoạt Đóng Băng 1 lần sẽ xóa hiệu ứng Sương Băng.",
    ["BuffDes_13122131"]="Giảm <color=#44afee>50%%</color> tốc chạy của bản thân",
    ["BuffDes_13122141"]="Vào trạng thái <color=#44afee>Ngọn Lửa Bảo Vệ</color>, trong thời gian duy trì hiệu ứng nhận hiệu ứng Khiên bằng <color=#44afee>%s%%</color> HP Max.",
    ["BuffDes_13122151"]="TRONG<color=#44afee>Lời nguyền hóa đá</color>Trạng thái, MaxHp giảm trong thời gian hiệu lực<color=#44afee>15%%</color>, hiệu quả điều trị và phục hồi nhận được trong giai đoạn này sẽ giảm đi.<color=#44afee>50%%</color>.",
    ["BuffDes_13132011"]="<color=#44afee>Đỉnh cao của ma thuật - lửa</color>trạng thái, tự tăng<color=#44afee>%s%%</color>Yếu tố lửa được tăng cường,<color=#44afee>%s</color>Điểm thâm nhập trạng thái tiêu cực,<color=#44afee>%s</color>Điểm nâng cao trạng thái tiêu cực.",
    ["BuffDes_13132012"]="<color=#44afee>Đỉnh Ma Thần - Gió</color>trạng thái, tự tăng<color=#44afee>%s%%</color>Yếu tố gió được tăng cường,<color=#44afee>%s</color>Điểm thâm nhập trạng thái tiêu cực,<color=#44afee>%s</color>Điểm nâng cao trạng thái tiêu cực.",
    ["BuffDes_13132013"]="<color=#44afee>Đỉnh cao của phép thuật - nước</color>trạng thái, tự tăng<color=#44afee>%s%%</color>Yếu tố nước được tăng cường,<color=#44afee>%s</color>Điểm thâm nhập trạng thái tiêu cực,<color=#44afee>%s</color>Điểm nâng cao trạng thái tiêu cực",
    ["BuffDes_13132014"]="<color=#44afee>Đỉnh cao của phép thuật - trái đất</color>trạng thái, tự tăng<color=#44afee>%s%%</color>Yếu tố đất được tăng cường,<color=#44afee>%s</color>Điểm thâm nhập trạng thái tiêu cực,<color=#44afee>%s</color>Điểm nâng cao trạng thái tiêu cực",
    ["BuffDes_13202011"]="Ở trạng thái <color=#44afee>Thi Triển Tự Do</color>, trong thời gian hiệu ứng duy trì Ngân Nga pháp thuật vẫn có thể <color=#44afee>di chuyển</color>, đồng thời tăng <color=#44afee>%s</color> điểm Trí Lực cho bản thân.",
    ["BuffDes_13202021"]="lực lượng thân thiện<color=#44afee>hình phạt ma thuật</color>Dưới sự bảo vệ của , mỗi lớp hiệu ứng này có thể chống lại sát thương phép thuật do kỹ năng gây ra.",
    ["BuffDes_13202022"]="TRONG<color=#44afee>hình phạt ma thuật</color>Trạng thái, mỗi lớp hiệu ứng này sẽ tự tăng lên<color=#44afee>0,5</color>Đã sửa lỗi thời gian hồi chiêu tính bằng giây.",
    ["BuffDes_13202023"]="TRONG<color=#44afee>phần thưởng ma thuật</color>Trạng thái, mỗi lớp hiệu ứng này sẽ tự tăng lên<color=#44afee>%s%%</color>Sát thương phép thuật cuối cùng được thêm vào.",
    ["BuffDes_13202031"]="Ở trạng thái <color=#44afee>Phá Giải Niệm Chú</color>, trong thời gian hiệu ứng duy trì Thi Triển, Ngân Nga và Hướng Dẫn sẽ không bị ngắt quãng và trầm mặc.",
    ["BuffDes_13202041"]="Ở trạng thái <color=#44afee>Giải Hiệu Ứng Pháp Thuật</color>, trong thời gian hiệu ứng duy trì giảm <color=#44afee>%s%%</color> Pháp Phòng.",
    ["BuffDes_13202051"]="Ở trạng thái <color=#44afee>Sách Tiến Hóa</color>, trong thời gian hiệu ứng duy trì tăng <color=#44afee>%s%%</color> tốc đánh và <color=#44afee>%s</color> điểm lực Pháp Công của bản thân.",
    ["BuffDes_13202061"]="Ở trạng thái <color=#44afee>Tự Động Niệm Chú</color>, trong thời gian hiệu ứng duy trì Đánh Thường có <color=#44afee>%s%%</color> xác suất kích hoạt mũi tên nguyên tố tương ứng.",
    ["BuffDes_13202071"]="Ở trạng thái <color=#44afee>Ấn Ký Nguyên Tố</color>, trong thời gian hiệu ứng duy trì chịu thêm <color=#44afee>%s</color> điểm ST thuộc tính nguyên tố tương ứng.",
    ["BuffDes_13202081"]="Trong trạng thái <color=#44afee>kèm thuộc tính nguyên tố</color>, trong thời gian duy trì hiệu ứng sẽ nhận được tăng cường thuộc tính hiệu ứng bằng <color=#44afee>%s%%</color> của nguyên tố tương ứng với tiêu hao Nguyên Thạch và tăng <color=#44afee>%s%%</color> Xuyên Pháp Phòng Cuối và <color=#44afee>%s%%</color> Pháp Công.",
    ["BuffDes_13202082"]="Ở trạng thái <color=#44afee>Thuộc Tính Nguyên Tố Kèm Theo</color>, trong thời gian duy trì hiệu ứng sẽ nhận được <color=#44afee>%s%%</color> tăng cường thuộc tính Nguyên Tố Lửa và tăng <color=#44afee>%s%%</color> Xuyên Pháp Phòng Cuối và <color=#44afee>%s%%</color> Pháp Công.",
    ["BuffDes_13202083"]="Ở trạng thái <color=#44afee>Thuộc Tính Nguyên Tố Kèm Theo</color>, trong thời gian duy trì hiệu ứng sẽ nhận được <color=#44afee>%s%%</color> tăng cường thuộc tính Nguyên Tố Nước và tăng <color=#44afee>%s%%</color> Xuyên Pháp Phòng Cuối và <color=#44afee>%s%%</color> Pháp Công.",
    ["BuffDes_13202084"]="Ở trạng thái <color=#44afee>Thuộc Tính Nguyên Tố Kèm Theo</color>, trong thời gian duy trì hiệu ứng sẽ nhận được <color=#44afee>%s%%</color> tăng cường thuộc tính Nguyên Tố Gió và tăng <color=#44afee>%s%%</color> Xuyên Pháp Phòng Cuối và <color=#44afee>%s%%</color> Pháp Công.",
    ["BuffDes_13202091"]="Ở trạng thái <color=#44afee>Thi Triển Quán Tính</color>, trong thời gian hiệu ứng duy trì, thi triển lại mũi tên nguyên tố tương đồng, thời gian Ngân Nga cố định giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_13202101"]="Ở trạng thái <color=#44afee>Bức Xạ Bán Kính</color>, trong thời gian hiệu ứng duy trì, tăng khoảng cách thi triển [Thuật Rạn Nứt] [Thuật Tên Lửa] [Mũi Tên Băng] [Thuật Sét Đánh] <color=#44afee>%s</color>m.",
    ["BuffDes_13202111"]="Ở trạng thái <color=#44afee>Tăng Cường Thuật Rạn Nứt</color>, trong thời gian hiệu ứng duy trì Thuật Rạn Nứt, tăng thành ST trong phạm vi bán kính <color=#44afee>3</color>m.",
    ["BuffDes_13202112"]="Ở trạng thái <color=#44afee>Tăng Cường Thuật Tên Lửa</color>, trong thời gian hiệu ứng duy trì Thuật Tên Lửa tăng ST phạm vi trong bán kính <color=#44afee>3</color>m.",
    ["BuffDes_13202113"]="Ở trạng thái <color=#44afee>Tăng Cường Mũi Tên Băng</color>, trong thời gian hiệu ứng duy trì Mũi Tên Băng tăng ST phạm vi trong bán kính <color=#44afee>3</color>m.",
    ["BuffDes_13202114"]="Ở trạng thái <color=#44afee>Tăng Cường Thuật Sét Đánh</color>, trong thời gian hiệu ứng duy trì Thuật Sét Đánh tăng ST phạm vi trong bán kính <color=#44afee>3</color>m.",
    ["BuffDes_13202121"]="Ở trạng thái <color=#44afee>Lãnh Địa Nguyên Tố Đất</color>, trong thời gian duy trì hiệu ứng sẽ gây ST Pháp Thuật hệ Đất bằng <color=#44afee>%s%%</color> Pháp Công cho kẻ địch trong phạm vi lãnh địa, bản thân và đồng đội giảm <color=#44afee>%s%%</color> ST hệ Đất phải chịu.",
    ["BuffDes_13202122"]="Ở trạng thái <color=#44afee>Lãnh Địa Nguyên Tố Lửa</color>, trong thời gian duy trì hiệu ứng sẽ gây ST Pháp Thuật hệ Lửa bằng <color=#44afee>%s%%</color> Pháp Công cho kẻ địch trong phạm vi lãnh địa, bản thân và đồng đội giảm <color=#44afee>%s%%</color> ST hệ Lửa phải chịu.",
    ["BuffDes_13202123"]="Ở trạng thái <color=#44afee>Lãnh Địa Nguyên Tố Nước</color>, trong thời gian duy trì hiệu ứng sẽ gây ST Pháp Thuật hệ Nước bằng <color=#44afee>%s%%</color> Pháp Công cho kẻ địch trong phạm vi lãnh địa, bản thân và đồng đội giảm <color=#44afee>%s%%</color> ST hệ Nước phải chịu.",
    ["BuffDes_13202124"]="Ở trạng thái <color=#44afee>Lãnh Địa Nguyên Tố Gió</color>, trong thời gian duy trì hiệu ứng sẽ gây ST Pháp Thuật hệ Gió bằng <color=#44afee>%s%%</color> Pháp Công lên kẻ địch trong phạm vi lãnh địa, bản thân và đồng đội giảm <color=#44afee>%s%%</color> ST hệ Gió phải chịu.",
    ["BuffDes_13212022"]="Trong trạng thái <color=#44afee>Kiệt Sức</color>, tất cả các cách hồi phục SP trong thời gian duy trì hiệu ứng đều vô hiệu và mỗi giây trừ %%Max SP",
    ["BuffDes_13212041"]="Ở trạng thái <color=#44afee>Tinh Thần Suy Sụp</color>, Pháp Công <color=#44afee>%s%%</color> và Pháp Phòng giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_13212051"]="Ở trạng thái <color=#44afee>Lưới Dễ Cháy</color>, không thể di chuyển.",
    ["BuffDes_13212052"]="Ở trạng thái <color=#44afee>Lưới Dễ Cháy</color>, khi bị thuộc tính lửa tấn công, ST tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_13212061"]="Ở trạng thái <color=#44afee>Nắm Đấm Ma Lực</color>, tăng thêm <color=#44afee>%s%%</color> Chính Xác Cuối, cứ <color=#44afee>50</color> điểm Trí Lực tăng thêm <color=#44afee>1%%</color> Chính Xác Cuối. Đánh Thường đổi thành thuộc tính Đất, và có xác suất gây <color=#44afee>6</color> lần <color=#44afee>%s%%</color> Pháp Thương thuộc tính Đất.",
    ["BuffDes_13212062"]="Ở trạng thái <color=#44afee>Nắm Đấm Ma Lực</color>, tăng thêm <color=#44afee>%s%%</color> Chính Xác Cuối, cứ <color=#44afee>50</color> điểm Trí Lực tăng thêm <color=#44afee>1%%</color> Chính Xác Cuối. Đánh Thường đổi thành thuộc tính Lửa, và có xác suất gây <color=#44afee>6</color> lần <color=#44afee>%s%%</color> Pháp Thương thuộc tính Lửa.",
    ["BuffDes_13212063"]="Ở trạng thái <color=#44afee>Nắm Đấm Ma Lực</color>, tăng thêm <color=#44afee>%s%%</color> Chính Xác Cuối, cứ <color=#44afee>50</color> điểm Trí Lực tăng thêm <color=#44afee>1%%</color> Chính Xác Cuối. Đánh Thường đổi thành thuộc tính Nước, và có xác suất gây <color=#44afee>6</color> lần <color=#44afee>%s%%</color> ST pháp thuật thuộc tính Nước.",
    ["BuffDes_13212064"]="Ở trạng thái <color=#44afee>Nắm Đấm Ma Lực</color>, tăng thêm <color=#44afee>%s%%</color> Chính Xác Cuối, cứ <color=#44afee>50</color> điểm Trí Lực tăng thêm <color=#44afee>1%%</color> Chính Xác Cuối. Đánh Thường đổi thành thuộc tính Gió, và có xác suất gây <color=#44afee>6</color> lần <color=#44afee>%s%%</color> Pháp Thương thuộc tính Gió.",
    ["BuffDes_13212071"]="Ở trạng thái <color=#44afee>Mài Giũa Vũ Khí</color>, mục tiêu mất [1%] HP Max, ST gây ra cho mục tiêu tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_13212072"]="Ở trạng thái <color=#44afee>Phá Giáp</color>, cứ mất [1%] HP Max, ST nhận tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_13212091"]="Ở trạng thái <color=#44afee>Thuật Đọc Nhanh</color>, Thuật Tên Lửa, Mũi Tên Băng, Thuật Sét Đánh hoặc Thuật Rạn Nứt thi triển lần sau sẽ không cần Ngân Nga.",
    ["BuffDes_13222011"]="Ở trạng thái <color=#44afee>Gió Ấm</color>, miễn dịch [Đóng Băng] và [Giảm Tốc].",
    ["BuffDes_13222021"]="Ở trạng thái <color=#44afee>giảm tốc</color>, Tốc Chạy giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_13222022"]="Ở trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>60%%</color>.",
    ["BuffDes_13222051"]="Triệu Hồi Tinh Linh Đất",
    ["BuffDes_13222052"]="Triệu Hồi Tinh Linh Lửa",
    ["BuffDes_13222053"]="Triệu Hồi Tinh Linh Nước",
    ["BuffDes_13222054"]="Triệu Hồi Tinh Linh Gió",
    ["BuffDes_13222071"]="Ở trạng thái <color=#44afee>Elemental Shield</color>, hấp thụ <color=#44afee>%s</color> lần ST vật lý cận chiến và tầm xa.",
    ["BuffDes_13222081"]="Ở trạng thái <color=#44afee>Giao Tiếp Tinh Linh</color>, tăng cường thuộc tính nguyên tố tương ứng tăng [<color=#44afee>%s%%</color>], tốc chạy tăng [<color=#44afee>%s%%</color>].",
    ["BuffDes_13222082"]="Ở trạng thái <color=#44afee>Giao Tiếp Tinh Linh Đất</color>, mỗi lớp sẽ giúp tăng thuộc tính Đất của Nhà Thông Thái lên [<color=#44afee>%s%%</color>].",
    ["BuffDes_13222083"]="Ở trạng thái <color=#44afee>Giao Tiếp Tinh Linh Lửa</color>, mỗi lớp sẽ giúp tăng thuộc tính Lửa của Nhà Thông Thái lên [<color=#44afee>%s%%</color>].",
    ["BuffDes_13222084"]="Ở trạng thái <color=#44afee>Giao Tiếp Tinh Linh Nước</color>, mỗi lớp sẽ giúp tăng thuộc tính Nước của Nhà Thông Thái lên [<color=#44afee>%s%%</color>].",
    ["BuffDes_13222085"]="Ở trạng thái <color=#44afee>Giao Tiếp Tinh Linh Gió</color>, mỗi lớp sẽ giúp tăng thuộc tính Gió của Nhà Thông Thái lên [<color=#44afee>%s%%</color>].",
    ["BuffDes_13222087"]="While under the effect of <color=#44afee>Poison Spirit Sympathy</color>, each stack increases Sage's Poison Enhancement by <color=#44afee>%s%%</color>.",
    ["BuffDes_13222091"]="Ở trạng thái <color=#44afee>Huy Hiệu Tinh Linh Đất</color>, đồng đội Hệ Đất trong 4m mỗi giây hồi phục Pháp Công x <color=#44afee>%s%%</color> HP, kẻ địch Hệ Gió mỗi giây phải chịu <color=#44afee>%s%%</color> Pháp Thương.",
    ["BuffDes_13222092"]="Ở trạng thái <color=#44afee>Huy Hiệu Tinh Linh Lửa</color>, đồng đội Hệ Lửa trong 4m mỗi giây hồi phục Pháp Công x <color=#44afee>%s%%</color> HP, kẻ địch Hệ Đất mỗi giây phải chịu <color=#44afee>%s%%</color> Pháp Thương.",
    ["BuffDes_13222093"]="Ở trạng thái <color=#44afee>Huy Hiệu Tinh Linh Nước</color>, đồng đội Hệ Nước trong 4m mỗi giây hồi phục Pháp Công x <color=#44afee>%s%%</color> HP, kẻ địch Hệ Lửa mỗi giây phải chịu <color=#44afee>%s%%</color> Pháp Thương.",
    ["BuffDes_13222094"]="Ở trạng thái <color=#44afee>Huy Hiệu Tinh Linh Gió</color>, đồng đội Hệ Gió trong 4m mỗi giây hồi phục Pháp Công x <color=#44afee>%s%%</color> HP, kẻ địch Hệ Nước mỗi giây phải chịu <color=#44afee>%s%%</color> Pháp Thương.",
    ["BuffDes_13222095"]="Under the effect of <color=#44afee>Poison Insignia</color>. Restores (M.ATK x <color=#44afee>%s%%</color>) HP to party members wearing Poison armor within 4 meters every second and deals <color=#44afee>%s%%</color> M.DMG to Earth/Fire/Wind attribute enemies every second.",
    ["BuffDes_13222111 "]="Ở trạng thái <color=#44afee>Nhập Thân Tinh Linh Đất</color>, chuyển đổi thuộc tính áo giáp và vũ khí của Sứ Giả Tinh Linh thành thuộc tính đất, giúp ST bản thân phải chịu giảm [<color=#44afee>%s%%</color>], đồng thời dùng sách Đánh Thường trúng mục tiêu sẽ có [50%%] xác suất khiến kẻ địch trong phạm vi [2*4]m phía trước giảm [<color=#44afee>%s%%</color>] tốc đánh và giảm [<color=#44afee>%s%%</color>] tốc chạy.",
    ["BuffDes_13222111"]="Ở trạng thái <color=#44afee>Nhập Thân Tinh Linh Đất</color>, chuyển đổi thuộc tính áo giáp và vũ khí thành thuộc tính đất, ST phải chịu giảm [<color=#44afee>%s%%</color>], đồng thời dùng sách Đánh Thường trúng mục tiêu sẽ có [50%%] xác suất khiến kẻ địch trong phạm vi [2*4]m phía trước giảm [<color=#44afee>%s%%</color>] tốc đánh cuối và giảm [<color=#44afee>%s%%</color>] tốc chạy.",
    ["BuffDes_13222112"]="Ở trạng thái <color=#44afee>Nhập Thân Tinh Linh Lửa</color>, chuyển đổi thuộc tính áo giáp và vũ khí của Sứ Giả Tinh Linh thành thuộc tính lửa, đồng thời tốc chạy tăng [<color=#44afee>%s%%</color>], khiến công cận chiến mở rộng đến phạm vi hình quạt bán kính [180] độ [4]m phía trước.",
    ["BuffDes_13222113"]="Ở trạng thái <color=#44afee>Nhập Thân Tinh Linh Nước</color>, chuyển đổi thuộc tính áo giáp và vũ khí của Sứ Giả Tinh Linh thành thuộc tính nước, đồng thời triệu hồi ra Thủy Triều Xung Phong trong phạm vi [4]m quanh Sứ Giả Tinh Linh, cứ [1]s sẽ gây ra ST pháp thuật thuộc tính nước bằng Pháp Công*[<color=#44afee>%s%%</color>] cho đơn vị phe địch trong phạm vi, đồng thời đẩy lùi kẻ địch trong phạm vi về hướng Sứ Giả Tinh Linh [4]m và gây giảm tốc chạy [40%%] trong [2]s.",
    ["BuffDes_13222115"]="Ở trạng thái <color=#44afee>Nhập Thân Tinh Linh Gió</color>, chuyển đổi thuộc tính áo giáp và vũ khí của Sứ Giả Tinh Linh thành thuộc tính gió, khi phải chịu ST có [<color=#44afee>%s%%</color>] xác suất phóng Chuỗi Tia Chớp về hướng tấn công, gây ST pháp thuật thuộc tính gió bằng Pháp Công*[<color=#44afee>%s%%</color>] lên mục tiêu, đồng thời khiến mục tiêu rơi vào trạng thái [Bóng Tối] [2]s, cứ [0,2]s tối đa kích hoạt 1 lần.",
    ["BuffDes_13222116"]="Tốc đánh cuối giảm [<color=#44afee>%s%%</color>], tốc chạy giảm [<color=#44afee>%s%%</color>].",
    ["BuffDes_13222118"]="While under the <color=#44afee>Poison Spirit Possession</color>, changes the armor and weapon attribute to Poison and ignores <color=#44afee>%s%%</color> of the target's M.DEF when dealing Poison attribute M.DMG.",
    ["BuffDes_13222122"]="Ở trạng thái <color=#44afee>Khống Chế Tinh Linh</color>, hồi phục tự nhiên HP của bản thân Sứ Giả Tinh Linh chuyển hóa thành HP Tinh Linh theo tỉ lệ [<color=#44afee>%s%%</color>], đồng thời [<color=#44afee>%s%%</color>] ST phải chịu sẽ do Sứ Giả Tinh Linh gánh chịu.",
    ["BuffDes_13232011"]="While under the effect of <color=#44afee>Crystallize</color>, becomes incapable of movement or attacking, and the armor attribute changes to Earth. Receiving damage will not cancel the Crystallize effect.",
    ["BuffDes_13232021"]="While under the effect of <color=#44afee>Firestorm</color>, receives Fire attribute M.DMG equal to <color=#44afee>%s%%</color> of the caster's M.ATK every <color=#44afee>2</color> seconds.",
    ["BuffDes_13232031"]="While under the effect of <color=#44afee>Instant Freeze</color>, becomes incapable of movement or attacking, and the armor attribute changes to Water. Receiving damage will not cancel the Instant Freeze effect.",
    ["BuffDes_13232041"]="While under the effect of <color=#44afee>Conductive</color>, receives Wind attribute M.DMG equal to <color=#44afee>%s%%</color> of the caster's M.ATK every <color=#44afee>2</color> seconds.",
    ["BuffDes_13232051"]="While under the effect of <color=#44afee>Lethal Venom</color>, generates a <color=#44afee>4</color>-meter poison cloud every <color=#44afee>3</color> seconds, applying <color=#44afee>1</color> stack of Poison that lasts for <color=#44afee>6</color> seconds to targets in the area.",
    ["BuffDes_13232052"]="While under the effect of <color=#44afee>Venom Swamp - Poison</color>, the Poison carrier receives Poison attribute M.DMG equal to <color=#44afee>%s%%</color> of the caster's M.ATK every second for each stack they carry.",
    ["BuffDes_13232071"]="While under the effect of <color=#44afee>Increasing Activity - Earth</color>, the attribute of the highest Elemental Enhancement becomes Earth Enhancement.",
    ["BuffDes_13232072"]="While under the effect of <color=#44afee>Increasing Activity - Fire</color>, the attribute of the highest Elemental Enhancement becomes Fire Enhancement.",
    ["BuffDes_13232073"]="While under the effect of <color=#44afee>Increasing Activity - Water</color>, the attribute of the highest Elemental Enhancement becomes Water Enhancement.",
    ["BuffDes_13232074"]="While under the effect of <color=#44afee>Increasing Activity - Wind</color>, the attribute of the highest Elemental Enhancement becomes Wind Enhancement.",
    ["BuffDes_13232075"]="While under the effect of <color=#44afee>Increasing Activity - Poison</color>, the attribute of the highest Elemental Enhancement becomes Poison Enhancement.",
    ["BuffDes_13232081"]="Summon Poison Spirit",
    ["BuffDes_13232091"]="While under the effect of <color=#44afee>Spell Enchanting - Earth</color>, Earth Enhancement and Earth Resistance are increased by <color=#44afee>%s%%</color>.",
    ["BuffDes_13232092"]="While under the effect of <color=#44afee>Spell Enchanting - Fire</color>, Fire Enhancement and Fire Resistance are increased by <color=#44afee>%s%%</color>.",
    ["BuffDes_13232093"]="While under the effect of <color=#44afee>Spell Enchanting - Water</color>, Water Enhancement and Water Resistance are increased by <color=#44afee>%s%%</color>.",
    ["BuffDes_13232094"]="While under the effect of <color=#44afee>Spell Enchanting - Wind</color>, Wind Enhancement and Wind Resistance are increased by <color=#44afee>%s%%</color>.",
    ["BuffDes_13232095"]="While under the effect of <color=#44afee>Spell Enchanting - Poison</color>, Poison Enhancement and Poison Resistance are increased by <color=#44afee>%s%%</color>.",
    ["BuffDes_13232101"]="While under the effect of <color=#44afee>Elemental Buster</color>, Earth/Fire/Water/Wind Resistance is reduced by <color=#44afee>%s%%</color>/<color=#44afee>%s%%</color>/<color=#44afee>%s%%</color>/<color=#44afee>%s%%</color>, respectively. When the effect ends, receives the corresponding attribute M.DMG equal to <color=#44afee>%s%%</color> of the caster's M.ATK.",
    ["BuffDes_14003221"]="TRONG<color=#7ACEFF>dư ảnh</color>Trạng thái, đòn tấn công vật lý tăng trong thời gian hiệu ứng<color=#7ACEFF>%s%%</color>và tốc độ tấn công cuối cùng<color=#7ACEFF>%s%%</color>.",
    ["BuffDes_14003251"]="Ở trạng thái <color=#7ACEFF>Ẩn Nấp</color>, trong thời gian duy trì không bị kẻ địch phát hiện, khi chủ động tấn công, chịu ST hoặc bị Phản Ẩn sẽ giải trừ trạng thái Ẩn Nấp. Khi nghề là <color=#7ACEFF>Đạo Chích</color>, ST phải chịu sau khi học Ngụy Trang Ẩn Nấp sẽ không giải trừ trạng thái Ẩn Nấp.",
    ["BuffDes_14003252"]="Vào trạng thái <color=#7ACEFF>Ám Sát</color>, trong thời gian duy trì hiệu ứng, sát thương phải chịu từ người thi triển tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_14003253"]="Khi bản thân gây ST lần đầu tiên, thi triển dấu ấn Ám Sát lên mục tiêu bị sát thương đầu tiên",
    ["BuffDes_14003331"]="Vào trạng thái <color=#7ACEFF>Miễn Dịch Trúng Độc</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, miễn dịch hiệu ứng <color=#8ACEFF>Trúng Độc</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_14021311"]="ST của Đâm Sau Lưng tăng thêm <color=#44afee>%s%%</color>.",
    ["BuffDes_14103281"]="Vào trạng thái <color=#7ACEFF>Bôi Độc</color>, trong thời gian duy trì hiệu ứng, Đánh Thường kèm <color=#7ACEFF>%s%%</color> Vật Thương hệ Độc và có xác suất <color=#7ACEFF>%s%%</color> khiến mục tiêu trúng độc khi trúng đánh thường.",
    ["BuffDes_14103331"]="Vào trạng thái <color=#7ACEFF>Nhào Lộn Né Tránh</color>, trong thời gian duy trì hiệu ứng, Né tăng <color=#7ACEFF>%s</color> điểm.",
    ["BuffDes_14103332"]="Ở trạng thái <color=#44afee>Giảm ST Cao</color>, trong thời gian duy trì hiệu ứng, lần sau chịu ST vượt quá <color=#44afee>25%%</color> HP Max, sẽ giảm <color=#44afee>%s%%</color> ST trong đó.",
    ["BuffDes_14103341"]="Vào trạng thái <color=#7ACEFF>Phá Giáp Song Đao</color>, trong thời gian duy trì hiệu ứng, Vật Phòng giảm <color=#7ACEFF>%s</color> điểm.",
    ["BuffDes_14103351"]="Vào trạng thái <color=#7ACEFF>Cường Hóa Ẩn Nấp</color>, trong thời gian duy trì hiệu ứng, kỹ năng được cường hóa hoặc được dùng ở trạng thái Ẩn Nấp cũ vẫn hiệu lực, và giảm <color=#7ACEFF>%s%%</color> sát thương phải chịu.",
    ["BuffDes_14103361"]="Vào trạng thái <color=#7ACEFF>Bôi Độc Cường Hóa</color>, khiến Vũ Khí có độc kèm thêm Vật Thương hệ Độc bằng <color=#44afee>%s%%</color> Vật Công. Có <color=#7ACEFF>%s%%</color> tỉ lệ khiến mục tiêu trúng độc khi công thường đánh trúng mục tiêu. ",
    ["BuffDes_14103371"]="Vào trạng thái <color=#7ACEFF>Lưỡi Đao Hình Bóng</color>, trong thời gian duy trì hiệu ứng, Tốc Đánh bản thân tăng x<color=#7ACEFF>%s</color>.",
    ["BuffDes_14113251"]="Vào trạng thái <color=#7ACEFF>Bôi Độc Chí Mạng</color>, khiến thuộc tính Vũ Khí bản thân chuyển thành <color=#7ACEFF>hệ Độc</color>, đồng thời trong thời gian duy trì hiệu ứng, khiến sát thương Độc bản thân gây ra tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_14113311"]="Vào trạng thái <color=#7ACEFF>Hào Quang Sát Thủ</color>, trong thời gian duy trì hiệu ứng, Bạo Kích Cuối tăng <color=#7ACEFF>%s%%</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_14113313"]="lấy<color=#44afee>%s%%</color>né tránh cuối cùng và<color=#44afee>%s%%</color>Tốc độ tấn công cuối cùng.",
    ["BuffDes_14113321"]="Vào trạng thái <color=#7ACEFF>Đòn Chém</color>, trong thời gian duy trì hiệu ứng được dùng lại Đòn Chém.",
    ["BuffDes_14113333"]="Ở trạng thái <color=#44afee>Ảo Ảnh Phân Thân</color>, trong thời gian duy trì hiệu ứng, miễn dịch Debuff và đánh lùi (ngoài một số Debuff quái vật cấp Boss và Debuff được ghi rõ không thể xóa bỏ hay miễn dịch).",
    ["BuffDes_14122062"]="Miễn tất cả hiệu ứng Debuff (Hiệu ứng từ MVP & Mini & Boss không thể bị giải trừ và miễn dịch), đồng thời tăng <color=#44afee>%s%%</color> Tốc Chạy của bản thân.",
    ["BuffDes_14122071"]="Ở trạng thái <color=#44afee>Bước Chân Gió Táp</color>, trong thời gian duy trì hiệu ứng tấn công lần đầu sẽ gây sát thương cho mục tiêu đồng thời sẽ khiến mục tiêu trọng thương <color=#44afee>5</color> giây, hiệu quả trị liệu trong trạng thái Trọng Thương giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_14122072"]="Ở trạng thái <color=#44afee>Trọng Thương</color>, hiệu quả trị liệu nhận được giảm <color=#44afee>%s%%</color> trong thời gian duy trì hiệu ứng và khi bị người thi triển tấn công sẽ nhận thêm Vật Thương thuộc tính vũ khí <color=#44afee>%s%%</color> HP tối đa. Mỗi <color=#44afee>1</color> giây có thể kích hoạt một lần, tối đa chịu <color=#44afee>%s</color> lần sát thương thêm.",
    ["BuffDes_14122081"]="Ở trạng thái <color=#44afee>Lưỡi Dao Hộ Thể</color>, lưỡi dao có <color=#44afee>%s%%</color> xác suất hỗ trợ bản thân chống đỡ Vật Thương sắp đến trong thời gian duy trì hiệu ứng. Mỗi lần chống đỡ thành công, năng lượng sinh ra khi chống đỡ sẽ nạp năng lượng cho một trong các lưỡi dao. Mỗi lần nạp thành công một lưỡi dao, giảm <color=#44afee>1,5</color> giây CD cố định.",
    ["BuffDes_14122082"]="Ở trạng thái <color=#44afee>Lưỡi Dao Phản Kích</color>, sát thương đầu tiên lên phe địch trong thời gian duy trì hiệu ứng sẽ kích hoạt lưỡi dao xuất kích. Mỗi lưỡi dao được nạp năng lượng sẽ bay tới mục tiêu, gây ra Vật Thương thuộc tính vũ khí <color=#44afee>%s%%</color> Vật Công cho phe địch.",
    ["BuffDes_14122091"]="Ở trạng thái tích lũy <color=#44afee>Điểm Xoay Tròn</color>, biểu thị số điểm quay tròn tích lũy hiện tại của bản thân",
    ["BuffDes_14122111"]="Ở trạng thái <color=#44afee>Vết Thương Đen Tối</color>, trong thời gian duy trì hiệu ứng, ST Bạo Kích phải chịu từ người thi triển tăng <color=#44afee>%s%%</color>, phần trăm HP Cuối của bản thân giảm <color=#44afee>%s%%</color>, cộng dồn tối đa <color=#44afee>6</color> tầng.",
    ["BuffDes_14132011"]="giảm bớt<color=#44afee>%s%%</color>Hiệu ứng phòng thủ vật lý cuối cùng.",
    ["BuffDes_14132012"]="giảm bớt<color=#44afee>%s%%</color>Giảm sát thương chí mạng.",
    ["BuffDes_14132111"]="Mỗi lần<color=#44afee>1</color>Một lớp sẹo bóng tối, tăng sát thương nhận được từ các đòn tấn công ảo<color=#44afee>%s%%</color>.",
    ["BuffDes_14202011"]="Mỗi lớp <color=#44afee>Ngấm Độc</color> sẽ tăng <color=#44afee>%s%%</color> Tăng cường hệ Độc.",
    ["BuffDes_14202031"]="Tăng <color=#44afee>%s</color> điểm Xuyên Thấu cho bản thân",
    ["BuffDes_14202032"]="Tăng <color=#44afee>%s</color> điểm Bạo Kích và <color=#44afee>%s%%</color> Sát Thương Bạo Kích kèm cho bản thân",
    ["BuffDes_14202123"]="Vào trạng thái <color=#44afee>Truy Bắt</color>, trong thời gian này không thể di chuyển và đánh thường. Có thể sử dụng <color=#44afee>Ẩn Nấp</color>, <color=#44afee>Đòn Xung Phong</color>, <color=#44afee>Lưỡi Xung Kích</color>, <color=#44afee>Chà Đạp</color>, <color=#44afee>Khiên Áp Chế</color>, <color=#44afee>Thân Thủ Nhanh Nhẹn</color>, <color=#44afee>Ngọn Lửa Xung Kích</color>, <color=#44afee>Nhào Lộn Né Tránh</color>, <color=#44afee>Sói Tập Kích</color>, <color=#44afee>Chiêu Trò của Người Múa Rối</color>, <color=#44afee>Trượt Mặt Trước</color>, <color=#44afee>Tự Nổ</color> thoát khỏi trạng thái <color=#44afee>Truy Bắt</color>, ngoài các kỹ năng trên, trong thời gian Truy Bắt không thể thi triển các kỹ năng khác.",
    ["BuffDes_14212032"]="Tăng <color=#44afee>%s%%</color> Vật Công của bản thân, khi gây ST lên đơn vị phe địch có <color=#44afee>20%%</color> xác suất khiến kẻ địch Giảm Tốc <color=#44afee>50%%</color>.",
    ["BuffDes_14212033"]="Tốc độ giảm <color=#44afee>50%%</color>",
    ["BuffDes_14212041"]="Nhẫn bên trái bị tháo bỏ",
    ["BuffDes_14212042"]="Nhẫn bên phải bị tháo bỏ",
    ["BuffDes_14212043"]="Bùa bị tháo bỏ",
    ["BuffDes_14212061"]="Tốc độ giảm <color=#44afee>50%%</color>",
    ["BuffDes_14212071"]="Không thể chọn trúng, cũng không thể di chuyển, thi triển kỹ năng và Đánh Thường",
    ["BuffDes_14212072"]="Miễn dịch với Bẫy Lỗ Đen",
    ["BuffDes_14212091"]="Ở trạng thái Áp Chế, không thể di chuyển, thi triển kỹ năng và Đánh Thường",
    ["BuffDes_14212101"]="Giáp bị tháo bỏ",
    ["BuffDes_14212102"]="Khăn choàng bị tháo bỏ",
    ["BuffDes_14212103"]="Giày bị tháo bỏ",
    ["BuffDes_14212121"]="Khi phải chịu Vật Thương cận chiến, <color=#44afee>%s%%</color> ST được phản đòn cho kẻ tấn công",
    ["BuffDes_14222011"]="Khi bị nhập thân, gánh chịu <color=#44afee>%s%%</color> ST thay Lưu Manh, Lưu Manh được hưởng <color=#44afee>%s%%</color> hiệu quả trị liệu mà bản thân nhận được",
    ["BuffDes_14222012"]="Mục tiêu sẽ gánh chịu <color=#44afee>%s%%</color> ST bản thân phải chịu, bản thân được hưởng <color=#44afee>%s%%</color> hiệu quả trị liệu mà mục tiêu nhận được",
    ["BuffDes_14222042"]="Mỗi lớp giúp <color=#44afee>Vật Công</color> của bản thân tăng <color=#44afee>%s%%</color>, Linh Hoạt tăng <color=#44afee>%s</color> điểm, Tốc Chạy tăng <color=#44afee>20</color> điểm, cộng dồn tối đa <color=#44afee>5</color> lớp",
    ["BuffDes_14222051"]="Sau <color=#44afee>3</color> giây trở về vị trị <color=#44afee>Cánh Cửa Không Gian</color>",
    ["BuffDes_14222061"]="Khi tiến hành <color=#44afee>Đánh Thường</color>, <color=#44afee>Song Tiễn</color>, <color=#44afee>Bắn Liên Hoàn</color>, <color=#44afee>Tam Tiễn</color> lên mục tiêu, sẽ gây thêm Vật Thương thuộc tính Vũ Khí bằng <color=#44afee>%s%%</color> kỹ năng gốc cho kẻ địch trong phạm vi <color=#44afee>4</color>m, có xác suất Bạo Kích, duy trì <color=#44afee>6</color> giây",
    ["BuffDes_14222071"]="Thuộc tính Vũ Khí trở thành hệ <color=#44afee>Hồn Ma</color>",
    ["BuffDes_14222081"]="ST phải chịu giảm <color=#44afee>%s%%</color>",
    ["BuffDes_14222091"]="Vũ khí bị tháo bỏ",
    ["BuffDes_14222101"]="Sức Mạnh bị cướp <color=#44afee>%s</color>",
    ["BuffDes_142221010"]="Cướp <color=#47afee>%s</color> điểm Trí Lực",
    ["BuffDes_142221011"]="Cướp <color=#48afee>%s</color> điểm Linh Hoạt",
    ["BuffDes_142221012"]="Cướp <color=#49afee>%s</color> điểm May Mắn",
    ["BuffDes_14222102"]="Nhanh Nhẹn bị cướp <color=#45afee>%s</color>",
    ["BuffDes_14222103"]="Thể Chất bị cướp <color=#46afee>%s</color>",
    ["BuffDes_14222104"]="Trí Lực bị cướp <color=#47afee>%s</color>",
    ["BuffDes_14222105"]="Linh Hoạt bị cướp <color=#48afee>%s</color>",
    ["BuffDes_14222106"]="May Mắn bị cướp <color=#49afee>%s</color>",
    ["BuffDes_14222107"]="Cướp <color=#44afee>%s</color> điểm Sức Mạnh",
    ["BuffDes_14222108"]="Cướp <color=#45afee>%s</color> điểm Nhanh Nhẹn",
    ["BuffDes_14222109"]="Cướp <color=#46afee>%s</color> điểm Thể Chất",
    ["BuffDes_14222111"]="<color=#44afee>Phòng Thủ Cuối</color> trong Nhà Lao Bóng Tối<color=#44afee> giảm %s%%</color>",
    ["BuffDes_14222112"]="Vào trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>75%</color>.",
    ["BuffDes_14222121"]="Mỗi giây mỗi lớp phải chịu <color=#44afee>%s%%</color> Vật Thương Vũ Khí, duy trì <color=#44afee>10</color> giây. Vật Công và Tốc Đánh của bản thân giảm <color=#7ACEFF>25%%</color>, đồng thời HP và SP không thể hồi phục một cách tự nhiên.",
    ["BuffDes_14232011"]="Each stack increases your PVP Debuff Resistance and PVP Debuff Duration Reduction by <color=#44afee>%s</color>.",
    ["BuffDes_14232021"]="Strips away the Shadow Equipment.",
    ["BuffDes_14232071"]="Unable to move or release skill while being trapped.",
    ["BuffDes_14232101"]="While active, each stack increases your DEX by <color=#44afee>%s%%</color>.",
    ["BuffDes_14232111"]="While under the effect, the target's Max HP is reduced by <color=#7ACEFF>%s%%</color>, with the healing received and recovery effect reduced by<color=#7ACEFF>%s%%</color> (ineffective against MVP, MINI, and Boss).",
    ["BuffDes_15003242"]="Ở trạng thái <color=#44afee>Thi Triển Quyền Cước</color>, trong thời gian duy trì hiệu ứng sẽ tăng <color=#44afee>%s%%</color> tăng DMG cuối.",
    ["BuffDes_15003243"]="Ở trạng thái <color=#44afee>Thân Lâm Ngục Tù</color>, trong thời gian duy trì hiệu ứng sẽ giảm <color=#44afee>%s%%</color> tăng DMG cuối.",
    ["BuffDes_15003251"]="Vào trạng thái <color=#7ACEFF>Ngưng Tụ Tinh Thần</color>, trong thời gian duy trì hiệu ứng, tăng <color=#7ACEFF>%s</color> điểm Nhanh Nhẹn và <color=#7ACEFF>%s</color> điểm Linh Hoạt.",
    ["BuffDes_1501"]="Ở trạng thái <color=#44afee>Độc Tấu</color>, trong thời gian này, không thể sử dụng độc tấu khác và kỹ năng độc tấu.",
    ["BuffDes_1502"]="Ở trạng thái <color=#44afee>Hợp Tấu</color>, trong thời gian này không thể di chuyển, đánh thường và sử dụng các kỹ năng khác ngoài hủy hợp tấu.",
    ["BuffDes_1503"]="Ở trạng thái <color=#44afee>Hợp Tấu - Longing for Freedom</color>, trong thời gian này không thể sử dụng kỹ năng độc tấu và hợp tấu khác và ST phải chịu giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_15103231"]="Vào trạng thái <color=#7ACEFF>Sét Đánh</color>, trong thời gian duy trì hiệu ứng, tăng thêm cho bản thân <color=#7ACEFF>%s</color> Tốc Đánh.",
    ["BuffDes_15103251"]="Vào trạng thái <color=#7ACEFF>Giảm Tốc Cạm Bẫy Đóng Sương</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_15103301"]="Vào trạng thái <color=#7ACEFF>Ký Hiệu Mắt Ưng</color>, trong thời gian duy trì hiệu ứng, sát thương phải chịu từ người thi triển tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_15103331"]="Vào trạng thái <color=#7ACEFF>Ký Hiệu Cú Bắn Tập Trung</color>, trong thời gian duy trì hiệu ứng, mỗi lớp hiệu ứng Ký Hiệu đều sẽ chịu thêm <color=#7ACEFF>8%%</color> sát thương.",
    ["BuffDes_15113241"]="Ở trạng thái <color=#44afee>Mắt Chim Ưng</color>, trong thời gian duy trì hiệu ứng, tăng <color=#44afee>10</color> điểm mỗi loại trong sáu thuộc tính cơ bản của bản thân, <color=#44afee>%s%%</color> phần trăm Vật Công, <color=#44afee>%s%%</color> ST Bạo Kích kèm và <color=#44afee>%s%%</color> Xuyên Vật Phòng Cuối.",
    ["BuffDes_15113261"]="Vào trạng thái <color=#7ACEFF>Định Thân</color>, trong thời gian duy trì hiệu ứng, không thể dịch chuyển, đồng thời sát thương từ Cạm Bẫy khác tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_15113301"]="Vào trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Giảm Tốc <color=#8ACEFF>30%%</color>.",
    ["BuffDes_15113331"]="Vào trạng thái <color=#7ACEFF>Thầy Dạy Thú Ace</color>, trong thời gian duy trì hiệu ứng, mỗi lớp trạng thái Thầy Dạy Thú Ace tăng <color=#7ACEFF>%s%%</color> Vật Công, hiệu ứng này tối đa được cộng dồn <color=#7ACEFF>3</color> lần.",
    ["BuffDes_15113351"]="Vào trạng thái <color=#7ACEFF>Khiếp Sợ</color>, trong thời gian duy trì hiệu ứng, ở trạng thái Choáng và sát thương đến từ người thi triển tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_15122021"]="Ở trạng thái <color=#44afee>Giảm Tốc</color>, Tốc Chạy giảm <color=#44afee>%s</color> trong thời gian duy trì hiệu ứng.",
    ["BuffDes_15122031"]="Ở trạng thái <color=#44afee>Cắn Xé Đổ Máu</color>, trong thời gian duy trì hiệu ứng, mỗi giây mất HP bằng HP Max x <color=#44afee>%s%%</color>. Cả Vật Công và Tốc Đánh đều giảm <color=#7ACEFF>25%%</color>, đồng thời HP và SP không thể hồi phục một cách tự nhiên.",
    ["BuffDes_15122071"]="Ở trạng thái <color=#44afee>Xạ Kích Tàn Sát</color>, Sát Thương Bạo Kích kèm tăng <color=#44afee>%s%%</color> trong thời gian duy trì hiệu ứng, cộng dồn tối đa <color=#44afee>4</color> lớp.",
    ["BuffDes_15122091"]="Ở trạng thái <color=#44afee>Phát Bắn Chính Xác</color>, Tốc Đánh Cuối giảm <color=#44afee>%s%%</color> trong thời gian duy trì hiệu ứng.",
    ["BuffDes_15122101"]="Vào trạng thái <color=#44afee>Trọng Thương</color>, hiệu quả nhận trị liệu giảm <color=#44afee>%s%%</color> trong thời gian duy trì hiệu ứng (bao gồm hiệu ứng hút Máu).",
    ["BuffDes_15122102"]="Vào trạng thái <color=#44afee>Trọng Thương</color>, hiệu quả nhận trị liệu giảm <color=#44afee>50%%</color> trong thời gian duy trì hiệu ứng (bao gồm hiệu ứng hút Máu).",
    ["BuffDes_15132051"]="Tốc độ di chuyển tăng lên<color=#44afee>%s</color>điểm, trong thời gian đó bạn không thể tấn công và không bị ảnh hưởng bởi tất cả các hiệu ứng mặt đất liên tục của kẻ thù.",
    ["BuffDes_15132053"]="ít hơn cuộc sống<color=#44afee>%s%%</color>Sát thương gây ra bởi kẻ địch tăng lên<color=#44afee>%s%%</color>.",
    ["BuffDes_15132061"]="Không thể vào<color=#44afee>Ẩn giấu</color>tình trạng",
    ["BuffDes_15132111"]="nhận thêm<color=#44afee>%s%%</color>Sát thương nguyên tố không thuộc tính cho các thành viên trong nhóm của Arrow Realm Releaser",
    ["BuffDes_15132112"]="nhận thêm<color=#45afee>%s%%</color>Sát thương nguyên tố nước của các thành viên trong nhóm Arrow Field Releaser",
    ["BuffDes_15132113"]="nhận thêm<color=#46afee>%s%%</color>Sát thương nguyên tố lửa lên các thành viên trong nhóm của Arrow Domain Releaser",
    ["BuffDes_15132114"]="nhận thêm<color=#47afee>%s%%</color>Sát thương nguyên tố thần thánh của các thành viên trong nhóm Arrow Domain Releaser",
    ["BuffDes_15132115"]="nhận thêm<color=#48afee>%s%%</color>Sát thương nguyên tố gió của các thành viên trong nhóm Arrow Domain Releaser",
    ["BuffDes_15132116"]="nhận thêm<color=#49afee>%s%%</color>Sát thương nguyên tố đất của các thành viên trong nhóm Arrow Domain Releaser",
    ["BuffDes_15202052"]="Ở trạng thái <color=#44afee>Assassin Cross of Sunset</color>, trong thời gian này, tăng <color=#44afee>%s%%</color> Tốc Đánh Cuối của bản thân, mỗi khi người thi triển có <color=#44afee>%s</color> điểm Trí Lực, Tốc Đánh Cuối tăng thêm<color=#44afee>1%%</color>.",
    ["BuffDes_15202062"]="Ở trạng thái <color=#44afee>The Apple of Idun</color>, trong thời gian này Max HP tăng <color=#44afee>%s%%</color>, mỗi khi người thi triển có <color=#44afee>%s</color> điểm Thể Chất, Max HP tăng thêm <color=#44afee>1%%</color>.",
    ["BuffDes_15202101"]="Giảm Vật Thương Cuối của bản thân tăng <color=#44afee>%s%%</color>, ở trạng thái này có thể dùng kỹ năng Hợp Tấu",
    ["BuffDes_15202102"]="Giảm Vật Thương Cuối của bản thân tăng <color=#44afee>%s%%</color>, rời bạn Hợp Tấu quá xa không thể dùng kỹ năng Hợp Tấu",
    ["BuffDes_15202111"]="Ở trạng thái <color=#44afee>A Drum on the Battlefield</color>, trong thời gian này tăng <color=#44afee>%s%%</color> ST tự thích ứng.",
    ["BuffDes_15202121"]="Ở trạng thái <color=#44afee>Mr. Kim A Rich Man</color>, EXP Cơ Bản và EXP Nghề bản thân nhận được tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_15212032"]="Ở trạng thái <color=#44afee>A Poem of Bragi</color>, trong thời gian này, thời gian ngân nga có thể thay đổi của bản thân giảm<color=#44afee>%s</color> giây và ngân nga sẽ không bị gián đoạn.",
    ["BuffDes_15212061"]="Ở trạng thái <color=#44afee>Nốt Nhạc Tụ Họp</color>, mỗi tầng tăng <color=#44afee>%s%%</color> Vật Công.",
    ["BuffDes_15212081"]="Ở trạng thái <color=#44afee>Eternal Chaos</color>, trong thời gian này tăng <color=#44afee>%s%%</color> Vật Thương Kèm &<color=#44afee>%s%%</color> Pháp Thương Kèm.",
    ["BuffDes_15212091"]="Ở trạng thái <color=#44afee>Invulnerable Siegfried</color>, trong thời gian này, ST Hệ Lửa, Gió, Đất, Nước của bản thân giảm <color=#44afee>%s%%</color>, đồng thời tăng <color=#44afee>%s</color> điểm Kháng Trạng Thái Debuff.",
    ["BuffDes_15212111"]="Ở trạng thái <color=#44afee>Cứu Rỗi</color>, trong thời gian này, ST phải chịu giảm <color=#44afee>%s%%</color>. Mỗi khi tích lũy <color=#44afee>4</color> lần ST phải chịu, sẽ hồi phục <color=#44afee>%s%%</color> HP đã mất (Cứ <color=#44afee>4</color> giây kích hoạt tối đa 1 lần). Trong đội cứ có thêm 1 nghề thuộc hệ Nhà Thơ & Vũ Nữ, ST phải chịu giảm thêm <color=#44afee>%s%%</color>, hồi phục HP đã mất tăng thêm<color=#44afee>%s%%</color>.",
    ["BuffDes_15222031"]="Mỗi lớp <color=#44afee>Tiếng Vọng</color> đều sẽ tăng <color=#44afee>%s%%</color> ST <color=#44afee>Khu Vực Chấn Động</color>.",
    ["BuffDes_15222042"]="Mỗi điểm giúp hồi phục lượng HP bằng <color=#44afee>2%%</color> HP Max (cứ 5s hồi 1 lần).",
    ["BuffDes_15222043"]="Mỗi điểm mang lại <color=#44afee>4%%</color> Pháp Công.",
    ["BuffDes_15222044"]="Mỗi điểm mang lại <color=#44afee>4%%</color> Vật Công.",
    ["BuffDes_15222045"]="Mỗi điểm mang lại <color=#44afee>4%%</color> Giảm Sát Thương Cuối.",
    ["BuffDes_15222072"]="Cứ <color=#44afee>3</color>s hồi sinh HP bằng<color=#44afee>%s%%</color> Max HP",
    ["BuffDes_15222091"]="Bản thân không thể di chuyển và tấn công, đồng thời Vật Thương Cuối và Giảm Pháp Thương giảm <color=#44afee>%s%%</color>, mỗi lần phải chịu đánh thường hoặc ST kỹ năng sẽ xóa bỏ một lớp Buff Ngủ Say.",
    ["BuffDes_15222092"]="Trong thời gian duy trì Buff, bản thân không rơi vào trạng thái <color=#44afee>Ngủ Say</color> lần nữa.",
    ["BuffDes_15222111"]="Bản thân tiến hành Nhảy Phấn Khích (không thể di chuyển và tấn công).",
    ["BuffDes_15222112"]="Mỗi giây bản thân mất <color=#44afee>%s%%</color> HP Max & SP Max, đồng thời hiệu ứng điều trị được nhận giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_15232011"]="While active, damage received from the caster and their ensemble partner increases by <color=#44afee>%s%%</color> per stack.",
    ["BuffDes_15232021"]="While active, gains one random music note every <color=#44afee>5</color> seconds.",
    ["BuffDes_15232022"]="While active, increases the damage of Rhythm Shooting.",
    ["BuffDes_15232023"]="While active, increases the damage of Rhythm Shooting.",
    ["BuffDes_15232024"]="While active, increases the damage of Rhythm Shooting.",
    ["BuffDes_15232025"]="While active, increases the damage of Rhythm Shooting.",
    ["BuffDes_15232026"]="While active, increases the damage of Rhythm Shooting.",
    ["BuffDes_15232027"]="While active, increases the damage of Rhythm Shooting.",
    ["BuffDes_15232028"]="While active, increases the damage of Rhythm Shooting.",
    ["BuffDes_15232052"]="While active, all party members within range gain a <color=#44afee>%s%%</color> damage boost against Demon monsters.",
    ["BuffDes_15232062"]="While active, all party members within range gain <color=#44afee>%s%%</color> Final M.PEN and <color=#44afee>%s%%</color> Final M.DMG Bonus.",
    ["BuffDes_15232071"]="While active, all party members within range gain a <color=#44afee>%s%%</color> increase in their highest main attribute (excluding VIT).",
    ["BuffDes_15232072"]="Increases STR by <color=#44afee>%s%%</color>.",
    ["BuffDes_15232073"]="Increases AGI by <color=#44afee>%s%%</color>.",
    ["BuffDes_15232074"]="Increases VIT by <color=#45afee>%s%%</color>.",
    ["BuffDes_15232075"]="Increases INT by <color=#46afee>%s%%</color>.",
    ["BuffDes_15232076"]="Increases DEX by <color=#47afee>%s%%</color>.",
    ["BuffDes_15232077"]="Increases LUK by <color=#48afee>%s%%</color>.",
    ["BuffDes_15232081"]="While active, the existing ensemble effect will not disappear.",
    ["BuffDes_15232091"]="Failing to return to the ensemble range in time will interrupt the ensemble.",
    ["BuffDes_15232112"]="While active, reduces DMG taken by <color=#44afee>%s%%</color>.",
    ["BuffDes_15232122"]="Gaining Remorse extends the duration of active debuffs by <color=#44afee>1</color> second. When Remorse ends, any debuffs it caused will disappear.",
    ["BuffDes_15302052"]="Ở trạng thái <color=#44afee>Humming</color>, trong thời gian này, Xuyên Vật Phòng Cuối tăng <color=#44afee>%s%%</color> và <color=#44afee>%s</color> điểm Vật Thương kèm.",
    ["BuffDes_15302062"]="Ở trạng thái <color=#44afee>Moonlit Serenade</color>, trong thời gian này, tăng <color=#44afee>%s%%</color> ST nguyên tố Đất, Lửa, Nước, Gió, Thánh.",
    ["BuffDes_15312011"]="Ở trạng thái <color=#44afee>Mê Hoặc</color>, trong thời gian này sẽ di chuyển về phía bản thân với Tốc Chạy là<color=#44afee>2</color> và không không thể tấn công và sử dụng kỹ năng.",
    ["BuffDes_15312022"]="Ở trạng thái <color=#44afee>Fortune's Kiss</color>, trong thời gian này tăng <color=#44afee>%s%%</color> Bạo Thương Kèm.",
    ["BuffDes_15312032"]="Ở trạng thái <color=#44afee>Please Don't Forget Me</color>, trong thời gian này giảm Cấp Tốc Cuối của bản thân <color=#44afee>%s</color>+ Nhanh Nhẹn của Người Thi Triển/<color=#44afee>500</color>)%%.",
    ["BuffDes_15332052"]="While active, all party members within range gain a <color=#44afee>%s%%</color> damage boost against Angel monsters.",
    ["BuffDes_15332062"]="While active, party members within a 6-meter radius can ignore <color=#44afee>%s</color> of Debuff Resistance and Debuff Duration Reduction when applying debuffs to monsters they have already damaged.",
    ["BuffDes_16001061"]="Ở trạng thái <color=#7ACEFF>Tiếng Gào Lớn</color>, trong thời gian duy trì hiệu ứng tăng cho toàn bộ thành viên <color=#7ACEFF>%s</color> điểm Sức Mạnh. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_16001071"]="Vào trạng thái <color=#7ACEFF>Ý Chí Chiến Đấu</color>, trong thời gian duy trì hiệu ứng, mỗi lần đánh thường trúng, Vật Thương kèm tăng <color=#44afee>%s</color> điểm, tối đa cộng dồn <color=#7ACEFF>8</color> lớp.",
    ["BuffDes_16002081"]="Ở trạng thái <color=#7ACEFF>Tiền Thưởng</color>, trong thời gian duy trì hiệu ứng, diệt quái vật có trạng thái Tiền Thưởng được nhận thêm <color=#7ACEFF>%s%%</color> Zeny.",
    ["BuffDes_16101031"]="Vào trạng thái <color=#7ACEFF>Đồ Sát</color>, trong thời gian duy trì hiệu ứng, tăng cho người thi triển <color=#7ACEFF>%s%%</color> Vật Công và cho toàn bộ thành viên cách người thi triển 30m <color=#7ACEFF>%s%%</color> Vật Công. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_16101041"]="Vào trạng thái <color=#7ACEFF>Kích Hoạt Nhanh Chóng</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, Tốc Đánh Cuối tăng <color=#7ACEFF>%s%%</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_16101042"]="Ở trạng thái <color=#44afee>Kích Hoạt Nhanh Chóng I</color>, trong thời gian duy trì hiệu ứng sẽ tăng <color=#44afee>%s%%</color> Chính Xác Cuối.",
    ["BuffDes_16101051"]="Vào trạng thái <color=#7ACEFF>Đòn Xem Thường Thể Hình</color>, cách người thi triển 30m và trong thời gian duy trì hiệu ứng, Điểm Sửa Vũ Khí tăng <color=#7ACEFF>%s%%</color>, hiệu ứng Sửa tối đa đạt <color=#7ACEFF>100%</color>. Cách người thi triển hơn 30m mất hiệu lực.",
    ["BuffDes_16101061"]="Vào trạng thái <color=#7ACEFF>Xe Đẩy Xung Phong</color>, trong thời gian duy trì hiệu ứng, tăng <color=#7ACEFF>%s</color> điểm Tốc Chạy, trong thời gian xung phong, duy trì Bá Thể và miễn dịch khống chế, sát thương phải chịu giảm <color=#7ACEFF>%s%%</color>, khi Xe Đẩy Xung Phong tiêu diệt <color=#44afee>8</color> mục tiêu hoặc gây ra <color=#44afee>32</color> lần xung kích, sẽ kết thúc trạng thái xung phong.",
    ["BuffDes_16111011"]="Vào trạng thái <color=#7ACEFF>Xe Đẩy Tăng Tốc</color>, trong thời gian duy trì hiệu ứng tăng <color=#7ACEFF>%s%%</color> Tốc Chạy và <color=#7ACEFF>%s%%</color> Né Cuối, hiệu ứng Tăng Tốc sẽ không bị Đầm Lầy Bùn giải trừ, không cộng dồn với hiệu ứng tăng Tốc Chạy khác.",
    ["BuffDes_16111041"]="Ở trạng thái <color=#7ACEFF>Đồ Sát Max</color>, trong thời gian duy trì hiệu ứng, ST Đánh Thường tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_16111071"]="Vào trạng thái <color=#7ACEFF>Bão Tiền</color>, trong thời gian duy trì hiệu ứng, giảm tốc <color=#7ACEFF>50%%</color>.",
    ["BuffDes_16111101"]="Vào trạng thái <color=#7ACEFF>Man Rợ</color>, trong thời gian duy trì hiệu ứng, mỗi lớp trạng thái Man Rợ tăng cho bản thân <color=#7ACEFF>%s%%</color> Hút Máu, tối đa cộng dồn 5 lớp.",
    ["BuffDes_16112031"]="Vào trạng thái <color=#7ACEFF>Phá Hủy Giáp</color>, trong thời gian duy trì hiệu ứng, Phòng Thủ giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_16122012"]="Vào trạng thái <color=#44afee>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>50%%</color> Tốc Chạy.",
    ["BuffDes_16122023"]="Ở trạng thái <color=#44afee>Khiên Chắn Năng lượng</color>, năng lượng tích trữ trong thời gian duy trì hiệu ứng được chuyển thành khiên chắn đỡ sát thương.",
    ["BuffDes_16122062"]="Tốc Chạy giảm <color=#44afee>50%%</color>.",
    ["BuffDes_16122081"]="Ở trạng thái <color=#44afee>Cuồng Nộ Dã Man</color>, Vật Công tăng <color=#44afee>%s%%</color> trong thời gian duy trì hiệu ứng, Tốc Đánh Cuối tăng <color=#44afee>%s%%</color>, cộng dồn tối đa <color=#44afee>6</color> lớp. Khi số lớp cộng dồn đạt tối đa được nhận thêm hiệu ứng Khát Máu.",
    ["BuffDes_16122082"]="Ở trạng thái <color=#44afee>Khát Máu</color>, nhận được <color=#44afee>%s%%</color> Hút Máu Vật Lý trong thời gian duy trì hiệu ứng.",
    ["BuffDes_16122111"]="Ở trạng thái <color=#44afee>Xoay Vòng Mạnh Mẽ</color>, Tốc Chạy giảm <color=#44afee>%s%%</color> trong thời gian duy trì hiệu ứng.",
    ["BuffDes_16122131"]="Ở trạng thái <color=#44afee>Dụ Dỗ</color>, Hiệu ứng Vật Phòng Cuối giảm <color=#44afee>%s%%</color>, Tốc Chạy giảm <color=#44afee>%s%%</color> trong thời gian duy trì hiệu ứng, cộng dồn tối đa <color=#44afee>6</color> lớp.",
    ["BuffDes_16122132"]="Ở trạng thái <color=#44afee>Miễn Dịch</color>, trong thời gian duy trì hiệu ứng miễn dịch trạng thái debuff (ngoài những Debuff nêu rõ không thể miễn dịch).",
    ["BuffDes_16132021"]="Chống lại sát thương từ bên ngoài vị trí của thiết bị phòng thủ.",
    ["BuffDes_16132051"]="<color=#44afee>ABR-Chiến binh quyết đoán</color>,<color=#44afee>Giáp pháo đôi ABR</color>Có thể sử dụng vô hạn <color=#44afee Tấn công hạng nặng</color>,<color=#44afee>pháo</color>. Tần suất tấn công của các thiết bị tấn công bằng máy bay không người lái cũng sẽ tăng lên.",
    ["BuffDes_16132121"]="<color=#44afee>áo giáp khẩn cấp</color>Tốc độ di chuyển tăng lên khi ở trạng thái<color=#44afee>4</color>,không thể truyền<color=#44afee>tự hủy</color>.",
    ["BuffDes_16202071"]="Ở trạng thái <color=#44afee>Bảo Hộ Phòng Cụ</color>, trong thời gian này sẽ không vào trạng thái <color=#44afee>Phá Giáp</color>. Tỷ lệ thành công Tháo Phòng Cụ của bản thân bị <color=#44afee>Tháo Phòng Cụ</color> giảm <color=#44afee>25%%</color>.",
    ["BuffDes_16202081"]="Ở trạng thái Bảo Hộ Vũ Khí, trong thời gian này sẽ không vào trạng thái <color=#44afee>Phá Vũ Khí</color>. Tỷ lệ thành công Tháo Vũ Khí của bản thân bị <color=#44afee>Tháo Vũ Khí</color> giảm <color=#44afee>25%%</color>.",
    ["BuffDes_16202121"]="Ở trạng thái <color=#44afee>Đổ Máu</color>, cứ mỗi <color=#44afee>0,5</color> giây phải chịu Vật Thương Hệ Vũ Khí <color=#44afee>%s</color> điểm. Vật Công và Tốc Đánh của bản thân giảm <color=#7ACEFF>25%%</color>, cả HP và SP đều không thể hồi phục một cách tự nhiên.",
    ["BuffDes_16212031"]="Hiệu ứng Hút Máu tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_16212032"]="Đã được cấy Cỏ Hút Máu, khi bản thân nhận được hiệu quả trị liệu, sẽ chuyển <color=#44afee>%s%%</color> hiệu quả trị liệu cho người thi triển.",
    ["BuffDes_16212041"]="Bị Mandragora Thét Gào ảnh hưởng, <color=#44afee>hồi chiêu cố định</color> của kỹ năng chủ động tăng <color=#44afee>%s</color>s, <color=#44afee>Ngân Nga cố định</color> tăng <color=#44afee>%s</color>s.",
    ["BuffDes_16212051"]="Ở trạng thái <color=#44afee>Điên Cuồng</color>, trong thời gian này, Tốc Chạy tăng <color=#44afee>%s</color>, ST Bạo Kích kèm tăng <color=#44afee>%s%%</color>, Xuyên Vật Phòng Cuối tăng <color=#44afee>%s%%</color>, Vật Công tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_16212111"]="Đã được cấy <color=#44afee>Bào Tử Nổ</color>, sau <color=#44afee>3</color>s, bản thân và đồng đội trong phạm vi <color=#44afee>3</color>m sẽ phải chịu Vật Thương thuộc tính Vũ Khí bằng (<color=#44afee>%s%%</color> Vật Công + Trí Lực *<color=#44afee>%s</color>) của người thi triển.",
    ["BuffDes_16212131"]="Ở trạng thái <color=#44afee>Bảo Hộ Trang Sức</color>, trong thời gian này, tỷ lệ thành công Tháo Trang Sức của bản thân bị <color=#44afee>Tháo Trang Sức</color> giảm <color=#44afee>25%%</color>.",
    ["BuffDes_16222011"]="Ở trạng thái <color=#44afee>Xe Đẩy Bùng Nổ</color>, tăng <color=#44afee>%s</color> Tốc Chạy và <color=#44afee>%s%%</color> Vật Công của bản thân.",
    ["BuffDes_16222061"]="HP tối đa tăng <color=#44afee>%s%%</color>, hiệu quả trị liệu tạo ra tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_16222062"]="HP tối đa tăng <color=#44afee>%s%%</color>, Vật Phòng và Pháp Phòng tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_16222063"]="Vật Công tăng <color=#44afee>%s%%</color>, Xuyên Vật Công tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_16222064"]="Vật Công tăng <color=#44afee>%s%%</color>, Bạo Kích Cuối tăng <color=#44afee>%s%%</color>, ST Bạo Kích kèm tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_16222071"]="Bản thân ở trong <color=#44afee>Ảo Giác</color>, tầm nhìn bị mờ, đồng thời mỗi lớp giảm <color=#44afee>%s%%</color> Chính Xác Cuối và <color=#44afee>%s</color> điểm Tốc Chạy.",
    ["BuffDes_16222081"]="Ở trạng thái <color=#44afee>giam cầm</color>, trong thời gian này, mỗi giây phải chịu <color=#44afee>%s</color> điểm Vật Thương thuộc tính Vũ Khí của người thi triển. Khi kẻ địch rơi vào Bẫy Gai Nhọn sẽ giải trừ hiệu ứng <color=#44afee>giam cầm</color> của Bẫy Gai Nhọn trước thời hạn.",
    ["BuffDes_16222112"]="Sức Chứa Đạn Pháo Hạng Nặng hiện tại",
    ["BuffDes_16222162"]="Né Cuối tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_16222163"]="Chính Xác Cuối giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_16232021"]="Each stack increases your Final P.DMG Bonus by <color=#44afee>%s%%</color>.",
    ["BuffDes_16232081"]="While active, the Shadow Equipment Disarm success rate of removing the Shadow Equipment's Pioneer and Inscription effects is reduced by <color=#44afee>%s%%</color>.",
    ["BuffDes_16232101"]="While active, your attacks ignore size decay effects, and you take <color=#44afee>%s%%</color> less M.DMG.",
    ["BuffDes_16232111"]="Reduces STR by <color=#44afee>%s%%</color>, Debuff Resistance and Debuff Duration Reduction by <color=#44afee>%s%%</color>.",
    ["BuffDes_16232112"]="Reduces AGI by <color=#45afee>%s%%</color>, Debuff Resistance and Debuff Duration Reduction by <color=#44afee>%s%%</color>.",
    ["BuffDes_16232113"]="Reduces VIT by <color=#46afee>%s%%</color>, Debuff Resistance and Debuff Duration Reduction by <color=#44afee>%s%%</color>.",
    ["BuffDes_16232114"]="Reduces INT by <color=#47afee>%s%%</color>, Debuff Resistance and Debuff Duration Reduction by <color=#44afee>%s%%</color>.",
    ["BuffDes_16232115"]="Reduces DEX by <color=#48afee>%s%%</color>, Debuff Resistance and Debuff Duration Reduction by <color=#44afee>%s%%</color>.",
    ["BuffDes_16232116"]="Reduces LUK by <color=#49afee>%s%%</color>, Debuff Resistance and Debuff Duration Reduction by <color=#44afee>%s%%</color>.",
    ["BuffDes_16232121"]="While active, gains a shield equal to (INT x <color=#44afee>%s</color>).",
    ["BuffDes_17002041"]="Mỗi tầng tăng <color=#44afee>%s</color> điểm Tốc Đánh và <color=#44afee>%s%%</color> Vật Công",
    ["BuffDes_17002061"]="Mỗi giây phải chịu Vật Thương Hệ Trung Tính bằng <color=#44afee>%s%%</color> Vật Công",
    ["BuffDes_17002071"]="Mỗi tầng Tập Trung tăng <color=#44afee>%s%%</color> Buff ST Cuối của bản thân, giảm <color=#44afee>%s%%</color> ST Cận Chiến phải chịu, giảm <color=#44afee>%s%%</color> ST Tầm Xa phải chịu, có thể cộng dồn tối đa <color=#44afee>3</color> tầng, duy trì <color=#44afee>60</color> giây. Khi bản thân rời khỏi phạm vi khu vực, khu vực sẽ biến mất.",
    ["BuffDes_17002091"]="Ở trạng thái Đạn Ma Thuật, khiến Hệ Vũ Khí của bản thân chuyển thành Hệ Hồn Ma, đồng thời trong thời gian duy trì hiệu ứng, khiến Hệ Hồn Ma bản thân gây ra tăng <color=#44afee>%s%%</color>. Duy trì <color=#44afee>300</color> giây.",
    ["BuffDes_17003071"]="Giới hạn trong map, tất cả tấn công không tiêu hao đạn.",
    ["BuffDes_17102011"]="Tốc Chạy của bản thân tăng <color=#44afee>20%%</color>.",
    ["BuffDes_17102031"]="Tăng <color=#44afee>%s</color> điểm Tốc Chạy, duy trì 1 giây.",
    ["BuffDes_17102041"]="Tăng <color=#44afee>%s%%</color> Né Cuối của bản thân, duy trì 5 giây.",
    ["BuffDes_17102051"]="Ở trạng thái <color=#44afee>Đổ Máu</color>, mỗi giây phải chịu Vật Thương Hệ Trung Tính bằng <color=#44afee>%s%%</color> Vật Công, duy trì <color=#44afee>6</color> giây.",
    ["BuffDes_17102061"]="Ở trạng thái Dấu Ấn Máu, không thể vào Ẩn Thân, đồng thời giảm <color=#44afee>%s%%</color> Né Cuối.",
    ["BuffDes_17112051"]="Gây hiệu ứng \"Chớp Trắng\" cho tất cả mục tiêu (không phân biệt địch ta) trong phạm vi <color=#44afee>3</color>m, duy trì <color=#44afee>%s</color> giây. Khi mục tiêu phe địch chịu ST trong thời gian \"Chớp Trắng\", sẽ phải chịu thêm Vật Thương Hệ Thánh bằng <color=#44afee>%s%%</color> Vật Công, kích hoạt tối đa <color=#44afee>%s</color> lần.",
    ["BuffDes_17112052"]="Khi chịu ST sẽ phải chịu thêm Vật Thương Hệ Thánh bằng <color=#44afee>%s%%</color> Vật Công, kích hoạt tối đa <color=#44afee>30</color> lần.",
    ["BuffDes_17112071"]="Mỗi giây phải chịu Vật Thương Hệ Trung Tính bằng <color=#44afee>%s%%</color> Vật Công",
    ["BuffDes_17112091"]="ST Đánh Thường của bản thân tăng thêm <color=#44afee>%s%%</color>, Chính Xác Cuối giảm <color=#44afee>%s%%</color>, hiệu ứng duy trì <color=#44afee>20</color> giây",
    ["BuffDes_17112101"]="Vật Thương Tầm Xa mà bản thân phải chịu giảm <color=#44afee>99%%</color>, tăng <color=#44afee>50%%</color> Giảm ST Quái Hệ Thây Ma",
    ["BuffDes_17112102"]="Tốc Chạy giảm <color=#44afee>50%%</color>, Chính Xác Cuối giảm <color=#44afee>50%%</color>",
    ["BuffDes_17112111"]="Mỗi lần nạp đạn, nhận được một tầng hiệu ứng Tăng Nhiệt, duy trì <color=#44afee>30</color> giây. Mỗi tầng Tăng Nhiệt tăng <color=#44afee>%s</color> điểm Tốc Đánh.",
    ["BuffDes_17112112"]="Ở trạng thái Quá Tải, Đánh Thường trong thời gian này gây thêm ST Thực bằng <color=#44afee>%s%%</color> ST mà lần Đánh Thường này gây ra, cứ <color=#44afee>20</color> điểm May Mắn tăng thêm <color=#44afee>1%%</color> Hệ Số ST.",
    ["BuffDes_17122021"]="Trong thời gian chỉ dẫn kỹ năng, tất cả ST mà bản thân phải chịu tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_17122031"]="Giảm <color=#44afee>50%%</color> Tốc Chạy.",
    ["BuffDes_17122071"]="Ở trạng thái Quyết Đấu, một bên tử trận, bên còn lại nhận được hiệu ứng Quyết Thắng.",
    ["BuffDes_17122072"]="Ở trạng thái Quyết Đấu, một bên tử trận, bên còn lại nhận được hiệu ứng Quyết Thắng.",
    ["BuffDes_17122073"]="Nhận được hiệu ứng Quyết Thắng, đồng thời hồi <color=#44afee>%s%%</color> HP và SP của bản thân, trong thời gian duy trì hiệu ứng, ST của bản thân tăng <color=#44afee>%s%%</color>, duy trì <color=#44afee>12</color> giây.",
    ["BuffDes_17122081"]="Mỗi tầng tăng <color=#44afee>0,5</color> điểm Tốc Chạy và khiến ST do Thợ Săn gây ra tăng <color=#44afee>1%%</color>.",
    ["BuffDes_17122082"]="Mỗi giây phải chịu Vật Thương Hệ Trung Tính bằng <color=#44afee>%s%%</color> Vật Công",
    ["BuffDes_17122101"]="Mục tiêu kèm thêm hiệu ứng Đốt Cháy, duy trì <color=#44afee>3</color> giây, mỗi giây phải chịu Vật Thương Hệ Lửa bằng <color=#44afee>%s%%</color> Vật Công.",
    ["BuffDes_17122111"]="Trong thời gian chỉ dẫn Điệu Chết Chóc giảm <color=#44afee>%s%%</color> ST mà bản thân phải chịu",
    ["BuffDes_17122112"]="ST Đánh Thường lần tiếp theo của bản thân tăng.",
    ["BuffDes_17122121"]="Cưỡng chế mục tiêu lơ lửng trên không <color=#44afee>1</color> giây, Điệu Chết Chóc gây thêm <color=#44afee>%s%%</color> ST lên mục tiêu lơ lửng trên không, và khi đánh trúng sẽ làm mới hiệu ứng lơ lửng trên không.",
    ["BuffDes_18002041"]="Ở trạng thái <color=#44afee>Ẩn Nấp</color>, trong thời gian duy trì hiệu ứng không bị kẻ địch phát hiện. Khi chủ động tấn công, phải chịu ST hoặc bị phản ẩn sẽ giải trừ trạng thái Ẩn Nấp.",
    ["BuffDes_18002091"]="Tốc Chạy và Tốc Đánh của bản thân giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_18002101"]="Mỗi tầng khiến Tốc Chạy của bản thân giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_18102021"]="Giảm ST Cuối của bản thân tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_18102031"]="Ở trạng thái <color=#44afee>Ảo Thuật</color>, bản thân không thể đánh thường trong thời gian duy trì hiệu ứng, sử dụng bất kỳ kỹ năng nào đều sẽ gây ST cho 1 mục tiêu ngẫu nhiên trong phạm vi, đồng thời chuyển tất cả hiệu ứng Trị Liệu bản thân nhận được thành ST Thực bằng <color=#44afee>%s%%</color> lượng Trị Liệu",
    ["BuffDes_18102052"]="Mỗi tầng tăng <color=#44afee>%s%%</color> Vật Công và Xuyên Vật Phòng cho bản thân",
    ["BuffDes_18102071"]="Hiệu ứng Chấn Thương do Ninja nam thi triển, mỗi tầng khiến ST bản thân phải chịu từ thành viên trong đội của người thi triển Buff tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_18102072"]="Hiệu ứng Chấn Thương do Ninja nữ thi triển, mỗi tầng khiến ST bản thân phải chịu từ thành viên trong đội của người thi triển Buff tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_18102073"]="Khiến ST bản thân phải chịu từ thành viên trong đội của người thi triển Buff tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_18102081"]="Viên ngọc tràn đầy sức mạnh Thuật Thủy Độn.",
    ["BuffDes_18102082"]="Viên ngọc tràn đầy sức mạnh Thuật Hỏa Độn.",
    ["BuffDes_18102083"]="Viên ngọc tràn đầy sức mạnh Thuật Phong Độn.",
    ["BuffDes_18102111"]="Bóng của bản thân bị Ninja trấn áp, nếu ở trạng thái Ẩn Thân, Ẩn Thân sẽ lập tức bị xua tan, khiến bản thân rơi vào hiệu ứng Định Thân, duy trì <color=#44afee>5</color> giây.",
    ["BuffDes_18102112"]="Sự phối hợp của các Ninja khiến Tốc Đánh và Cấp Tốc của bản thân giảm <color=#44afee>%s</color> điểm.",
    ["BuffDes_18112022"]="Trong thời gian duy trì không chịu ảnh hưởng của hiệu ứng <color=#44afee>Ảo Thuật - Giam Cầm</color>.",
    ["BuffDes_18112041"]="Meikyo Shisui bị cắt ngang, vào trạng thái Choáng.\n",
    ["BuffDes_18112051"]="Cứ di chuyển <color=#44afee>5</color>m sẽ để lại một Vùng Bóng dưới chân, duy trì <color=#44afee>5</color> giây, đồng thời tồn tại tối đa <color=#44afee>3</color> Vùng Bóng.",
    ["BuffDes_18112091"]="Giảm <color=#44afee>%s%%</color> vận công cố định của bản thân, tăng <color=#44afee>%s%%</color> Xuyên Pháp Phòng, đồng bộ giá trị Tăng Cường Hệ Gió, Nước, Lửa của bản thân thành giá trị cao nhất trong ba thuộc tính.",
    ["BuffDes_18122012"]="Ở trạng thái <color=#44afee>Ảo Thuật - Jyusatsu</color>, mỗi tầng khiến giới hạn HP Max của bản thân giảm <color=#44afee>%s%%</color> (Hiệu ứng cùng loại giảm tổng cộng tối đa <color=#44afee>50%%</color>). Khi <color=#44afee>Ảo Thuật - Jyusatsu</color> đạt tới <color=#44afee>7</color> tầng, bản thân sẽ trực tiếp tử trận.",
    ["BuffDes_18122041"]="ST bản thân gây ra tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_18122061"]="Tăng <color=#44afee>%s%%</color> Hút Máu Vật Lý và <color=#44afee>%s%%</color> Tăng Cường Hiệu Ứng Trị Liệu nhận được.",
    ["BuffDes_18122101"]="Mỗi tầng tăng <color=#44afee>2%%</color> Tăng Cường Hệ Gió, Nước, Lửa.",
    ["BuffDes_18122131"]="Ở trong Vùng Nước do <color=#44afee>Suijinton - Mitsuha</color> tạo ra, giảm <color=#44afee>%s</color> điểm Tốc Chạy của bản thân.",
    ["BuffDes_18202111"]="Bản thân bị ánh trăng bao phủ, Vật Phòng và Pháp Phòng giảm <color=#44afee>%s</color> điểm.",
    ["BuffDes_18202112"]="Lấy bản thân làm trung tâm để triệu hồi ánh trăng, có thể hiện hình kẻ địch đang ẩn thân xung quanh.",
    ["BuffDes_19002051"]="Vật Phòng mỗi tầng giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_19002071"]="Mỗi tầng Tốc Chạy tăng <color=#44afee>%s</color>.",
    ["BuffDes_19002081"]="Mỗi tầng tăng <color=#44afee>%s%%</color> Vật Công/Pháp Công.",
    ["BuffDes_19002082"]="Mỗi tầng tăng <color=#44afee>%s%%</color> Vật Công/Pháp Công.",
    ["BuffDes_19002091"]="Giảm ST Cuối của bản thân tăng <color=#44afee>1%%</color>.",
    ["BuffDes_19102012"]="Mỗi tầng nhận <color=#44afee>1</color> ngôi sao.",
    ["BuffDes_19102021"]="Ở trạng thái Ngôi Sao Hoà Hợp, Vật Công tăng <color=#44afee>%s%%</color> và nhận hiệu ứng Bá Thể.",
    ["BuffDes_19102031"]="Bản thân chìm trong sự ấm áp của các ngôi sao, ST phải chịu một lần vượt quá <color=#44afee>5%%</color> HP Max sẽ giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_19102041"]="Giảm sát thương cuối cùng khi ở trạng thái Star's Wrath<color=#44afee>40%%</color>, tốc độ di chuyển cơ bản tăng lên<color=#44afee>%s</color>.",
    ["BuffDes_19102043"]="Tốc Chạy của bản thân giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_19102051"]="Gây <color=#44afee>%s%%</color> hiệu ứng Giảm Tốc.",
    ["BuffDes_19102071"]="Vật Phòng mỗi tầng giảm <color=#44afee>5%%</color>.",
    ["BuffDes_19112011"]="Dưới ánh mặt trời chiếu rọi, thuộc tính phần trăm Vật Phòng và Pháp Phòng của bản thân tăng <color=#44afee>%s%%</color>, Vật Thương gây thêm cho mục tiêu trong khu vực tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_19112021"]="Ở trạng thái Mặt Trời Phẫn Nộ, cứ 10 tầng chuyển thành hiệu ứng Choáng.",
    ["BuffDes_19112041"]="Nhận chúc phúc của mặt trời, có thể giảm ST bản thân phải chịu.",
    ["BuffDes_19112044"]="Nhận chúc phúc của mặt trời, có thể giảm ST bản thân phải chịu.",
    ["BuffDes_19112071"]="Né Cuối của bản thân tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_19122011"]="Dưới ánh sáng của mặt trăng, Tốc Chạy của bản thân tăng <color=#44afee>%s</color>.",
    ["BuffDes_19122031"]="Mỗi tầng giảm <color=#44afee>%s</color> Vật Phòng và Pháp Phòng của đơn vị địch.",
    ["BuffDes_19122032"]="tăng mỗi lớp<color=#44afee>%s%%</color>Tấn công vật lý và phép thuật.",
    ["BuffDes_19122041"]="Mỗi tầng có thể chống đỡ 1 lần Vật Thương.",
    ["BuffDes_19122043"]="Nhận chúc phúc của mặt trăng, tăng <color=#44afee>%s%%</color> Né Cuối.",
    ["BuffDes_19122052"]="Ở trạng thái <color=#7ACEFF>Cấm Hồi Phục</color>, không thể hồi HP trong thời gian duy trì hiệu ứng.",
    ["BuffDes_19122071"]="Khiên bằng [A] HP Max, trong thời gian duy trì Khiên, xoá và miễn tất cả Trạng Thái Debuff.",
    ["BuffDes_19122072"]="Khiên bằng <color=#44afee>%s%%</color> HP Max, trong thời gian duy trì Khiên, xoá và miễn tất cả Trạng Thái Debuff.",
    ["BuffDes_1991"]="Vào trạng thái <color=#7ACEFF>Phạt Tải Trọng</color>, trong thời gian duy trì hiệu ứng, HP và SP của bản thân không thể hồi phục tự nhiên; Tốc Đánh Cuối giảm <color=#7ACEFF>75%%</color>, thời gian Vận Công tăng <color=#7ACEFF>100%%</color>, thời gian chờ tăng <color=#7ACEFF>100%%</color>; Tốc Chạy giảm <color=#7ACEFF>50%%</color>, HP Max và SP Max giảm <color=#7ACEFF>50%%</color>.",
    ["BuffDes_1992"]="Vào trạng thái <color=#7ACEFF>Phạt Tải Trọng</color>, trong thời gian duy trì hiệu ứng, HP và SP của bản thân không thể hồi phục tự nhiên; Tốc Đánh Cuối giảm <color=#7ACEFF>77%%</color>, thời gian Vận Công tăng <color=#7ACEFF>100%%</color>, thời gian chờ tăng <color=#7ACEFF>100%%</color>.",
    ["BuffDes_1993"]="Vào trạng thái<color=#7ACEFF>Phạt Tải Trọng</color>, trong thời gian duy trì hiệu ứng, HP và SP của bản thân không thể hồi phục tự nhiên.",
    ["BuffDes_1994"]="Được <color=#7ACEFF>Arielle</color> chúc phúc, trong thời gian duy trì hiệu ứng, mỗi giây hồi <color=#7ACEFF>10%%</color> HP Max.",
    ["BuffDes_1996"]="Vào trạng thái <color=#7ACEFF>Ngồi Im</color>, trong thời gian duy trì hiệu ứng, cứ <color=#7ACEFF>5</color>s hồi <color=#7ACEFF>20%%</color> HP Max và <color=#7ACEFF>20%</color> SP Max.",
    ["BuffDes_1998"]="Ngồi Đu Quay Ngựa Gỗ xong tâm trạng sảng khoái, trong thời gian duy trì hiệu ứng, Vật Công và Pháp Công tăng <color=#7ACEFF>1%%</color> đồng thời tăng <color=#7ACEFF>10%%</color> Tốc Chạy.",
    ["BuffDes_2000"]="Thời gian treo máy dã ngoại hôm nay đã dùng hết, treo máy dã ngoại sẽ không tiếp tục <color=#7ACEFF>nhận lợi ích</color>. 05:00 hôm sau cài lại.",
    ["BuffDes_2001"]="Bão Cát",
    ["BuffDes_20012"]="Khi ở trạng thái <color=#44afee>Giảm Sát Thương</color>, trong thời gian duy trì hiệu ứng sẽ tăng <color=#44afee>30%</color> Giảm Sát Thương Cuối.",
    ["BuffDes_2002"]="Nắng Gắt",
    ["BuffDes_2003"]="Mưa Giông",
    ["BuffDes_2003601"]="Khi ở trạng thái <color=#44afee>Phao Cứu Sinh</color>, trong thời gian duy trì hiệu ứng, ngăn cản tấn công Súng Nước hay Bóng Nước nhận phải trong lần sau, sẽ có hiệu lực <color=#44afee>%s</color> lần.",
    ["BuffDes_2003901"]="Khi ở trạng thái <color=#44afee>Van Tăng Áp</color> trong thời gian duy trì hiệu ứng, khoảng cách thời gian bắn ra Đạn Nước sẽ rút ngắn <color=#44afee>%s%%</color>.",
    ["BuffDes_2004"]="Mưa Nhỏ",
    ["BuffDes_2004001"]="Khi ở trạng thái <color=#44afee>Đồ Uống Năng Lượng</color>, trong thời gian duy trì hiệu ứng, tăng cho chính mình <color=#44afee>%s%%</color> Tốc Chạy và mỗi giây giảm <color=#44afee>%s</color>Điểm Ẩm Ướt.",
    ["BuffDes_2004101"]="Khi ở trạng thái <color=#44afee>Bị Cứu Viện</color>, trong thời gian duy trì hiệu ứng, khi tiến độ cứu viện đạt đến <color=#44afee>%s</color>, sẽ thoát khỏi trạng thái bóng nước.",
    ["BuffDes_2005"]="Sao băng",
    ["BuffDes_2006"]="Mây Mù",
    ["BuffDes_2007"]="Ở trạng thái hồi <color=#7ACEFF>HP</color>, trong thời gian duy trì hiệu ứng, mỗi giây hồi một lượng HP nhất định",
    ["BuffDes_2008"]="Ở trạng thái hồi <color=#7ACEFF>SP</color>, trong thời gian duy trì hiệu ứng, mỗi giây hồi một lượng SP nhất định",
    ["BuffDes_20313302"]="Nhận được Chúc Phúc Cây Con Tịnh Hóa, tăng <color=#4169E1>30% ST Cuối</color>",
    ["BuffDes_20313303"]="Nhận được Chúc Phúc Cây Con Tịnh Hóa, tăng <color=#4169E1>1 điểm Tốc Chạy</color>",
    ["BuffDes_20313304"]="Nhận được Chúc Phúc Cây Con Tịnh Hóa, cứ 2 giây hồi phục <color=#4169E1>20% HP đã mất và 10% SP Max</color>, hiệu ứng này không chịu ảnh hưởng của Dịch Bệnh",
    ["BuffDes_21002301"]="Bị nguyền rủa, hiệu ứng Trị Liệu giảm, không thể dùng Thuốc Trị Liệu.",
    ["BuffDes_21030"]="Bị giam cầm! <color=#FF4500>Nhanh chóng rung cảm biến từ xa</color>, giảm thời gian giam cầm!",
    ["BuffDes_21034"]="Bị tên lửa đánh dấu! Tên lửa đang tiến về phía bạn!",
    ["BuffDes_21052"]="Ở trạng thái <color=#7ACEFF>Tăng Tốc Chạy</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy tăng.",
    ["BuffDes_2108"]="Pháp Thương Cuối PVP kèm +150%, Vật Thương Cuối PVP kèm +150%, Cấp Tốc Cuối +50%, Tốc Đánh Cuối +500%, Kháng Trạng Thái Debuff +150, Kháng Choáng, Kháng Hắc Ám, Kháng Đóng Băng và Kháng Giảm Tốc +100%",
    ["BuffDes_21099301"]="Hàng hóa bí ẩn trong Hành Lang Vực Sâu, làm chậm quá trình vận chuyển và không thể tàng hình, hãy giao hàng hóa cho chỉ huy ở lối vào để nhận tiền thưởng",
    ["BuffDes_21099302"]="Chúc phúc Chiến Thần nhận được khi chiếm lĩnh tế đàn thành công, nhận được hiệu ứng Khiên một lần trong thời gian duy trì hiệu ứng và đòn tấn công sẽ gây thêm ST Thực bằng 1% HP Max của mục tiêu, mỗi giây kích hoạt tối đa 1 lần (chỉ có hiệu lực với người chơi)",
    ["BuffDes_21099303"]="Khi đánh đòn cuối vào MVP, trở thành Chủ Nhân Thú Linh, đồng minh ở gần bạn trong bán kính 15m sẽ nhận được Khiên theo chu kỳ, đồng thời Giảm ST Cuối và ST Cuối tăng. Trong thời gian duy trì hiệu ứng, nếu Chủ Nhân Thú Linh bị tiêu diệt, hiệu ứng sẽ được chuyển sang phe địch",
    ["BuffDes_21099304"]="Hiệu ứng chúc phúc do Chủ Nhân Thú Linh mang lại, nhận được Khiên theo chu kỳ trong thời gian duy trì hiệu ứng, đồng thời Giảm ST Cuối và Tăng ST Cuối đều tăng 15%",
    ["BuffDes_21099305"]="Báu vật vực sâu mà MVP đánh rơi trong Hành Lang Vực Sâu, làm chậm quá trình vận chuyển và không thể tàng hình, hãy giao hàng hóa cho chỉ huy ở lối vào để nhận rất nhiều tiền thưởng",
    ["BuffDes_212221"]="Vào trạng thái <color=#7ACEFF>Hỗn Loạn</color>, trong thời gian duy trì hiệu ứng, nhân vật di chuyển hướng ngược lại.",
    ["BuffDes_212671"]="ST với tất cả quái nhỏ thường, MVP, Mini, Boss tăng <color=#44afee>84%%</color>.",
    ["BuffDes_212681"]="Hút Máu Pháp Thuật/Vật Lý tăng <color=#44afee>84%%</color>, phần trăm Tấn Công tăng <color=#44afee>84%%</color>.",
    ["BuffDes_212682"]="Phần trăm Tấn Công tăng <color=#44afee>42%%</color>, Hút Máu Pháp Thuật/Vật Lý tăng <color=#44afee>42%%</color>.",
    ["BuffDes_212691"]="Phần trăm Pháp Công và Vật Công tăng <color=#44afee>120%%</color>.",
    ["BuffDes_212711"]="Gây <color=#44afee>1680%%</color> ST Hệ Vũ Khí tương thích bỏ qua Phòng Thủ cho đơn vị phe địch trong phạm vi 4m xung quanh bản thân.",
    ["BuffDes_212761"]="Miễn nhiễm với mọi trạng thái tiêu cực trong suốt thời gian hiệu lực.",
    ["BuffDes_212771"]="Tăng dần trong suốt thời gian<color=#44afee>84%%</color>Thiệt hại cuối cùng sẽ sâu sắc hơn.",
    ["BuffDes_30000323"]="Ở trạng thái <color=#7ACEFF>Trọng Thương</color>, mỗi tầng giảm 10% HP Max Cuối, cộng dồn tối đa 5 tầng",
    ["BuffDes_30003302"]="Vào trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>50%</color>.",
    ["BuffDes_30004304"]="Vào trạng thái <color=#7ACEFF>Đuối Nước</color>, trong thời gian duy trì hiệu ứng không thể hành động và liên tục chịu nhiều sát thương, chờ đồng đội giải cứu.",
    ["BuffDes_30005302"]="Vào trạng thái <color=#7ACEFF>Đóng Sương</color>, trong thời gian duy trì hiệu ứng, cộng dồn 5 lớp sẽ vào trạng thái <color=#7ACEFF>Tê Cóng</color>, cộng dồn 10 lớp sẽ vào trạng thái <color=#7ACEFF>Đóng Băng</color>, khi chịu Công Kích Gió sẽ giảm số lớp hiệu ứng <color=#7ACEFF>Đóng Sương</color>.",
    ["BuffDes_30005304"]="Vào trạng thái <color=#7ACEFF>Tê Cóng</color>, trong thời gian duy trì hiệu ứng, mỗi giây sẽ liên tục chịu sát thương, đồng thời Tốc Đánh Tốc Chạy đều giảm 20%.",
    ["BuffDes_30005305"]="Vào trạng thái <color=#7ACEFF>Đóng Băng</color>, trong thời gian duy trì hiệu ứng, không thể hành động, sát thương phải chịu sẽ tăng và sẽ giải trừ trạng thái <color=#7ACEFF>Đóng Băng</color>, nếu bị Công Kích Gió sẽ chịu thêm nhiều sát thương và giải trừ tất cả hiệu ứng <color=#7ACEFF>Đóng Sương</color>.",
    ["BuffDes_30011301"]="Ở trạng thái <color=#7ACEFF>Phản Pháp Thuật</color>, trong thời gian duy trì hiệu ứng, mỗi lần thi triển kỹ năng sẽ tiêu hao <color=#7ACEFF>gấp đôi SP</color>, đồng thời chịu Pháp Thương.",
    ["BuffDes_30011303"]="Vào trạng thái <color=#7ACEFF>Bảo Hộ Thần Trăng</color>, trong thời gian duy trì hiệu ứng, năng lực tăng mạnh, miễn dịch sát thương Thiên Thạch.",
    ["BuffDes_30011304"]="Ở trạng thái <color=#7ACEFF>Chuông Hỗn Loạn</color>, trong thời gian duy trì hiệu ứng sẽ di chuyển ngược lại. Khi hiệu ứng kết thúc, nếu xung quanh không ai có hiệu ứng Chuông tương tự sẽ chịu Pháp Thương thuộc tính ngẫu nhiên.",
    ["BuffDes_30011310"]="Ở trạng thái Pháp Phòng Giảm, trong thời gian duy trì hiệu ứng, Pháp Phòng giảm 100%",
    ["BuffDes_30012301"]="Vào trạng thái <color=#7ACEFF>Phá Giáp</color>, trong thời gian duy trì hiệu ứng, sát thương mỗi lớp phải chịu tăng <color=#7ACEFF>20%</color>, tối đa cộng dồn 10 lớp.",
    ["BuffDes_30013302"]="Vào trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Đánh và Tốc Chạy giảm <color=#7ACEFF>60%</color>.",
    ["BuffDes_30013303"]="Vào trạng thái <color=#7ACEFF>Cực Độc</color>, trong thời gian duy trì hiệu ứng, mỗi giây chịu sát thương ma pháp hệ <color=#00EE00>Độc</color>, sát thương phải chịu tăng, sát thương gây ra giảm, hiệu ứng tối đa cộng dồn <color=#7ACEFF>5</color> lớp.",
    ["BuffDes_30013306"]="Vào trạng thái <color=#7ACEFF>Năng Lượng Bất Diệt</color>, trong thời gian duy trì <color=#7ACEFF>ngăn lằn đen</color>, mỗi giây chịu sát thương thực bằng <color=#7ACEFF>5%</color> HP Max, nếu lằn đen nối với Osiris sẽ tạo <color=#7ACEFF>80%</color> hiệu ứng giảm sát thương, đồng thời <color=#7ACEFF>liên tục trị liệu</color>",
    ["BuffDes_30014301"]="Vào trạng thái <color=#7ACEFF>Chấn Thương</color>, trong thời gian duy trì hiệu ứng, mỗi lớp Chấn Thương mỗi giây chịu sát thương vật lý trung tính bằng <color=#7ACEFF>10%%</color> Vật Công của người thi triển, sát thương chịu tăng 15%, trị liệu nhận giảm 15%, đồng thời HP và SP sẽ không tự hồi phục, cộng dồn 10 lớp Chấn Thương sẽ trực tiếp trảm sát (bỏ qua trạng thái Miễn Tử).",
    ["BuffDes_30014305"]="Vào trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>30%</color>.",
    ["BuffDes_30014306"]="Vào trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>60%</color>.",
    ["BuffDes_30014307"]="Vào trạng thái <color=#7ACEFF>Bất Động</color>, trong thời gian duy trì hiệu ứng không thể di chuyển.",
    ["BuffDes_30016302"]="Ở trạng thái <color=#7ACEFF>Suy Yếu</color>, trong thời gian duy trì hiệu ứng, ST phải chịu mỗi lớp tăng 10%, Trị Liệu nhận được giảm 10%, được cộng dồn.",
    ["BuffDes_30017301"]="Ở trạng thái <color=#7ACEFF>Khô Kiệt</color>, trong thời gian duy trì <color=#7ACEFF>Vạch Đỏ</color>, giảm HP Max và Trị Liệu cho Pharaoh, cách xa Pharaoh và thoát khỏi vạch nối là có thể hủy trạng thái <color=#7ACEFF>Khô Kiệt</color>.",
    ["BuffDes_30017303"]="Ở trạng thái <color=#7ACEFF>Cái Chết Đen</color>, trong thời gian duy trì hiệu ứng sẽ chịu Nguyền Rủa độc ác nhất của Pharaoh, tất cả thuộc tính giảm mạnh, chú ý <color=#7ACEFF>cách xa nhóm người</color> để tránh <color=#7ACEFF>Cái Chết Đen</color> lây cho người khác.",
    ["BuffDes_30019301"]="Lời Nguyền Ma Vương của Morroc dành cho những sinh vật yếu đuối, mỗi lớp lời nguyền sẽ phải chịu ST <color=#FFFFF0>Thực</color> bằng 1% HP Max, sau khi cộng dồn đến 10 lớp sẽ phải chịu trạng thái debuff <color=#ff00ff>Lời Nguyền Nô Lệ</color>.",
    ["BuffDes_30019302"]="Bị Morroc nô dịch, ST gây cho Morroc sẽ chuyển thành hiệu ứng Trị Liệu, và tạo hiệu ứng Phản ST 100% lên bản thân.",
    ["BuffDes_30019303"]="Sát thương hệ Bóng Tối nhận của mỗi lớp tăng 10%",
    ["BuffDes_30019308"]="Bị Bày Tay Ma Vương trói buộc, <color=#ff0000>không ngừng giãy dụa để thoát ra!</color>",
    ["BuffDes_30022301"]="Bạn đang dần dần tiếp cận với sự thật đáng sợ... Giảm <color=#FF4500>10%</color> Tốc Đánh, chuyển thành Sự Sống Tàn Lụi ở lớp 5.",
    ["BuffDes_30022302"]="Tất cả hy vọng đều bị cắt đứt ở đây, bạn không thể từ chối, cũng không thể kháng cự. Không thể tấn công và thi triển, đồng thời tiếp tục gây ST cho xung quanh.",
    ["BuffDes_30022303"]="Sức mạnh đủ để làm khô héo tâm trí của bạn đang đến, chia sẻ sát thương mà sự cô đơn mang đến với các đồng minh của mình!",
    ["BuffDes_30022304"]="Đang bị tri thức điên cuồng xâm nhập...",
    ["BuffDes_30022307"]="Rơi vào cuồng loạn, mất cảm giác phương hướng",
    ["BuffDes_30024304"]="Mỗi lớp giảm Tấn Công, Tốc Đánh, Phòng Thủ, Trị Liệu & Hút Máu <color=#FF4500>-10%</color>, khi kèm Buff <color=#FF4500>Tử Vong</color> này, ngẫu nhiên tạo 1 Bẫy Megalith, bẫy duy trì <color=#FF4500>10 giây</color>.",
    ["BuffDes_30024305"]="Số hiển thị trên đầu là số lớp đánh dấu, số đánh dấu nhỏ nhất là <color=#FF4500>1</color>, lớn nhất là <color=#FF4500>5</color>, trong phạm vi bán kính 5m quanh bản thân cứ có 1 người chơi không có đánh dấu, sẽ phải phân chia 1 lớp đánh dấu, sau<color=#FF4500>10 giây</color> sẽ gây ST Thực bằng <color=#FF4500>số đánh dấu x 50 HP Max</color>.",
    ["BuffDes_30024306"]="Số hiển thị trên đầu là số lớp đánh dấu, số đánh dấu lớn nhất là <color=#FF4500>1</color>, nếu đến gần người chơi bị đánh dấu khác trong phạm vi bán kính 5m, sẽ phải phân chia cho người đó 1 lớp đánh dấu, sở hữu đánh dấu được phân chia này sẽ không phải chịu ST.",
    ["BuffDes_30024308"]="Đang bị Tao Gunka đánh dấu! Tao Gunka sẽ không ngừng bắn đạn về phía mục tiêu đánh dấu, trong phạm vi bán kính 10m gây ST thực bằng <color=#FF4500>10% HP Max</color> và bị thu hút <color=#FF4500>2m</color>, trong phạm vi bán kính 3m của điểm trung tâm gây thêm ST Thực bằng <color=#FF4500>80% HP Max</color>, và kèm thêm <color=#FF4500>3 lớp Buff Phá Hoại Tinh Thần</color>.",
    ["BuffDes_30025306"]="Bị uy hiếp! BOSS sẽ gây <color=#FF4500>sát thương thêm</color> cho mục tiêu ở trạng thái Uy Hiếp, <color=#FF4500>nhanh chóng rung cảm biến từ xa</color>, giảm thời gian uy hiếp!",
    ["BuffDes_30025308"]="Khi ở trạng thái <color=#7ACEFF>Định Thân</color>, không thể di chuyển trong thời gian duy trì hiệu ứng. ",
    ["BuffDes_30025314"]="Mỗi lần thi triển kỹ năng sẽ tăng <color=#FF4500>300%</color> sp tốn, đồng thời chịu <color=#FF4500>100%</color> sát thương ma pháp của BOSS",
    ["BuffDes_30026301"]="Đang bị tội nghiệt xưa kia trừng phạt, giảm <color=#FF4500>10%</color> lượng hồi phục và Lực Công, khi tội nghiệp bị giải trừ hoặc kích nổ, sẽ nhận phải nhiều sát thương",
    ["BuffDes_30026302"]="Bạn bị Gai Đinh Linh Hồn đâm trúng, sau đó Gai Đinh sẽ phát nổ, gây Pháp Thương cho xung quanh.",
    ["BuffDes_30026304"]="Bạn bị xem là thiện linh, nhưng sắp được siêu độ, mau về vùng đất tội ác để cân bằng giữa thiện và ác.",
    ["BuffDes_30026305"]="Bạn bị phán là Linh Hồn Tội Lỗi, sắp bị trừng phạt, hãy mau bước vào Vùng Đất Lương Thiện để cân bằng thiện ác.",
    ["BuffDes_30027301"]="Vào trạng thái <color=#7ACEFF>Ám Hỏa</color>, trong thời gian duy trì hiệu ứng, Trị Liệu nhận được sẽ chuyển thành Pháp Thương hệ Bóng Tối.",
    ["BuffDes_30027302"]="Tăng ST Hệ Nước phải chịu, có thể giải trừ khi tiếp xúc với Cầu Nguyên Tố Hệ Lửa.",
    ["BuffDes_30027303"]="Tăng ST Hệ Lửa phải chịu, có thể giải trừ khi tiếp xúc với Cầu Nguyên Tố Hệ Nước.",
    ["BuffDes_30027304"]="Tăng ST Hệ Thánh phải chịu, có thể giải trừ khi tiếp xúc với Cầu Nguyên Tố Hệ Bóng Tối.",
    ["BuffDes_30027305"]="Tăng ST Hệ Bóng Tối phải chịu, có thể giải trừ khi tiếp xúc với Cầu Nguyên Tố Hệ Thánh.",
    ["BuffDes_30028311"]="ST phải chịu tăng 1000%.",
    ["BuffDes_30028317"]="Biến nhỏ, HP Max giảm 30%",
    ["BuffDes_30029301"]="Bị <color=#ff5252>thiêu đốt</color>! Tốc đánh và lượng trị liệu giảm, kéo dài thời gian chờ. Liệt Hỏa khiến chiến trường tăng nhiệt, có thể sẽ khiến <color=#ff5252>dung nham</color> phun trào!",
    ["BuffDes_30029320"]="Bị <color=#528fff>đóng băng</color>! Hàn băng kiên cố giúp bạn tránh được cú tấn công của Người Lai Rồng!",
    ["BuffDes_30030301"]="Kẻ bẩn thỉu ô uế được sinh ra từ cơ thể của người chết, kẻ sở hữu khi chết sẽ sinh ra <color=#006400>Vong Linh Ôn Dịch</color> ngẫu nhiên tại chỗ theo <color=#4169E1>thuộc tính cơ thể</color> của kẻ sở hữu.",
    ["BuffDes_30030303"]="Bị dịch bệnh quấn thân, vết thương không thể kết vảy mà dần thối rữa, <color=#800080>cấm</color> kẻ sở hữu <color=#00FF7F>hồi HP</color>",
    ["BuffDes_30030320"]="Vòng Sáng bị vấy bẩn sau khi qua tay Beelzebub, không còn chữa trị được đau đớn cho con người, mà đã trở thành trợ thủ cho Quân Đoàn Vong Linh <color=#FFD700>(5% HP Max*Số lớp Buff Dịch Bệnh)/10 Sát Thương Hệ Thánh</color>, duy trì <color=#800080>10s</color>, mỗi giây giúp Vong Linh Ôn Dịch và Vong Linh Ôn Dịch Khổng Lồ <color=#00FF7F>hồi phục 5% HP Max</color>, duy trì <color=#800080>10s</color>",
    ["BuffDes_30031301"]="Tốc đánh giảm 20%, tốc chạy giảm 20%",
    ["BuffDes_30031302"]="Hiệu ứng Trị Liệu và Hồi Phục nhận được giảm 20%",
    ["BuffDes_30031311"]="Sinh mạng sắp lụi tàn, chỉ hiệu chỉnh thời gian mới có thể ngừng lại tất cả.",
    ["BuffDes_30031312"]="ST phải chịu từ Thuốc Hiệu Chỉnh Thời Gian tăng 100%.",
    ["BuffDes_30031316"]="Biến lớn, sát thương gây ra tăng 30%",
    ["BuffDes_30032301"]="Cơ thể bạn bắt đầu phát ra Thánh Quang... Nhận 20% Giảm Trị Liệu và Dễ Bị Thương Hệ Thánh, nhanh chóng bước vào khu vực Thánh Quang để trung hòa nó nhé!",
    ["BuffDes_30032304"]="Cơ thể bạn bắt đầu suy yếu, mất đi rất nhiều HP",
    ["BuffDes_30033301"]="Dòng điện mà bạn mang theo lan ra ngoài không kiểm soát, mỗi tầng dòng diện cảm ứng gây ST Phạm Vi một lần",
    ["BuffDes_30033302"]="Bạn đang ở Cực Dương, HP Max giảm <color=#7ACEFF>30%</color>, hãy duy trì liên kết với Cực Âm, nếu không sẽ gây nổ!",
    ["BuffDes_30033303"]="Bạn đang ở Cực Âm, HP Max giảm <color=#7ACEFF>30%</color>, hãy duy trì liên kết với Cực Dương, nếu không sẽ gây nổ!",
    ["BuffDes_30033304"]="Dòng điện chạy qua cơ thể bạn, làm giảm thuộc tính Hệ Gió",
    ["BuffDes_30033305"]="Dòng điện đã tràn ngập toàn bộ cơ thể của bạn! Vào trạng thái Định Thân không liên tục",
    ["BuffDes_30033306"]="Hiện tại bạn miễn nhiễm với điện giật",
    ["BuffDes_30034301"]="Bạn nhặt rác sửa chữa của RSX-0806, HP Max giảm <color=#7ACEFF>50%</color>, nhưng ST Cuối của bạn và đồng đội tăng <color=#7ACEFF>20%</color>!",
    ["BuffDes_30091302"]="Ở trạng thái <color=#00ffcc>Nhân Tố Bão Táp</color>, sau vài giây sẽ tạo ra cơn bão lớn, chú ý di chuyển liên tục để né!",
    ["BuffDes_30099301"]="Ở trạng thái <color=#7ACEFF>Hồng Liên</color>.",
    ["BuffDes_30099302"]="Ở trạng thái <color=#7ACEFF>Nghiệp Hỏa</color>.",
    ["BuffDes_30099325"]="Cùng với nhịp điệu mừng vui, cơ thể cảm thấy uyển chuyển hơn, Giảm ST Cuối <color=#44afee>3%</color>, ST Cuối tăng <color=#44afee>3%</color>, Tốc Chạy tăng <color=#44afee>5%</color>",
    ["BuffDes_30110302"]="Buff ST Cuối +20%",
    ["BuffDes_30181301"]="Cơn ớn lạnh xâm chiếm cơ thể bạn, làm giảm hiệu quả trị liệu và tăng sát thương phải chịu. Chuyển thành \"Phá Xương\" ở tầng 5",
    ["BuffDes_30181302"]="Nhiệt độ thấp thấu xương xuyên vào tận xương tủy của bạn! Liên tục mất HP, chỉ khi dùng ngụy trang mới có thể xóa được hiệu ứng!",
    ["BuffDes_30181307"]="Sự tồn tại của bạn đã trở thành trở ngại cho hành động của bạn trong thế giới cổ tích, tất cả ST trở thành 1, chỉ có bể trị liệu trong truyện cổ tích mới có thể loại bỏ phép thuật này.",
    ["BuffDes_30181308"]="Tất cả tấn công của bạn đều bị phép thuật biến thành quà tặng, tất cả ST đều trở thành 1, chỉ có bể trị liệu trong truyện cổ tích mới có thể loại bỏ phép thuật này.",
    ["BuffDes_30181309"]="Sự tồn tại của bạn đang dần bị xóa bỏ! HP liên tục giảm, chỉ có bể trị liệu trong truyện cổ tích mới có thể loại bỏ phép thuật này.",
    ["BuffDes_30181310"]="Vết thương của bạn quá nặng, không thể chữa trị, không thể tiếp tục trị liệu nữa, chỉ có bể trị liệu trong truyện cổ tích mới có thể loại bỏ phép thuật này.",
    ["BuffDes_30181311"]="Bạn và Garm cùng ở trong thế giới cổ tích, bỏ qua bảo vệ của nó.",
    ["BuffDes_30184303"]="Cơ thể của bạn trở nên bất lực, mỗi tầng giảm <color=#44afee>5%</color> Buff ST Cuối",
    ["BuffDes_30184304"]="Cơ thể của bạn bị nhiễm năng lượng thây ma, một tầng giảm <color=#44afee>50%</color> giới hạn HP Max, hai tầng sẽ lập tức tử trận và gây ra phạm vi nổ dưới chân.",
    ["BuffDes_30205301"]="Mỗi tầng tăng <color=#44afee>10%%</color> Vật Công và Pháp Công của bản thân.",
    ["BuffDes_30208301"]="Ở trạng thái <color=#44afee>Ẩn Nấp</color>, tăng <color=#44afee>2</color> Tốc Chạy và <color=#44afee>50%%</color> Né Cuối",
    ["BuffDes_30209303"]="Ấn Ký Nô Lệ được Yuda tăng cường, trong thời gian này mỗi lần gây ST cho Yuda sẽ chịu ST Thực nhất định, ST này sẽ chí tử",
    ["BuffDes_30210301"]="Đòn tấn công của Quyền Vương Raoh kèm hiệu ứng. Tích luỹ 10 tầng nhận hiệu ứng Tử Huyệt, sau 5 giây sẽ tử trận. (Ở trạng thái Tử Huyệt, có thể được người chơi có hiệu ứng Kế Thừa Bắc Đẩu Thần Quyền chạm vào để cứu)",
    ["BuffDes_30210303"]="Nhận kế thừa của Bắc Đẩu Thần Quyền. Sẽ không chịu ảnh hưởng của hiệu ứng Phong Huyệt, khi va chạm với đồng đội có thể xoá hiệu ứng Tử Huyệt. Nhận kỹ năng Trái Tim Nhân Ái. Sau khi tử trận sẽ rơi.",
    ["BuffDes_30212301"]="TRONG<color=#7ACEFF>ô nhiễm tinh thần</color>trạng thái kéo dài trong<color=#7ACEFF>lú lẫn</color>hiệu ứng và mất 20% MaxHp mỗi giây",
    ["BuffDes_30212307"]="TRONG<color=#7ACEFF>chiếm hữu</color>Trạng thái và thời gian hiệu ứng ở cùng phe với Lười biếng.",
    ["BuffDes_30213301"]="Trong thời gian tác dụng, ở<color=#7ACEFF>Chóng mặt, cấm điều trị</color>tình trạng",
    ["BuffDes_30213302"]="Ở trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>20%</color>.",
    ["BuffDes_30213307"]="Ở trạng thái <color=#7ACEFF>Giảm Vật Phòng</color>",
    ["BuffDes_30213308"]="Ở trạng thái <color=#7ACEFF>Giảm Pháp Phòng</color>",
    ["BuffDes_3080302"]="Trong thời gian này, bạn không thể nhận được vật phẩm tăng cường trong trò chơi \"Bảo vệ rắn thần\".",
    ["BuffDes_31006301"]="Nhận được hiệu ứng cường hóa Sức Mạnh Cà Rốt, tăng tốc chạy và khi chạm vào Sói có thể gây ST chí mạng.",
    ["BuffDes_31009301"]="Vào trạng thái <color=#7ACEFF>Bom Biển Sâu</color>, <color=#7ACEFF>5</color>s sau gây cho bản thân và tất cả mọi người trong phạm vi 10m xung quanh nhiều Pháp Thương hệ Nước, <color=#7ACEFF>chú ý tránh xa nhóm người! </color>",
    ["BuffDes_31010303"]="Mỗi giây nhận Pháp Thương Hệ Độc của Người Thi Triển (500% Pháp Công + 15% HP Max của bản thân).",
    ["BuffDes_31011301"]="Tốc Chạy giảm 50%, chịu sát thương tùy theo khoảng cách di chuyển.",
    ["BuffDes_31012301"]="Mỗi lớp giảm <color=#FF4500>10%</color> Tốc Đánh và giảm hiệu ứng trị liệu đồng thời mỗi giây mất <color=#FF4500>5%</color> HP, mau <color=#FF4500>di chuyển</color> để giảm uy hiếp.",
    ["BuffDes_31012302"]="Đã bị đánh dấu! Xung quanh sẽ liên tục xuất hiện <color=#FF4500>Gai Nhọn</color>.",
    ["BuffDes_31012303"]="Bạn đã trở thành mục tiêu của <color=#FF4500>Nhảy Bổ Vô Hạn</color>.",
    ["BuffDes_31014301"]="Đã nhiễm <color=#FF4500>virus</color>. Mỗi lớp giảm <color=#FF4500>30%</color> Tốc Đánh, Tốc Chạy và hồi phục hiệu ứng, có thể sẽ chuyển thành kháng thể, cũng sẽ biến bạn thành Cương Thi.",
    ["BuffDes_31014302"]="Bạn đã biến dị! Giảm <color=#FF4500>90%</color> Tốc Chạy và biến thành <color=#FF4500>Cương Thi</color>!",
    ["BuffDes_31014303"]="Bạn đã nhận được kháng thể, <color=#FF4500>miễn dịch</color> hiệu quả của virus trong thời gian ngắn.",
    ["BuffDes_31014304"]="Được bảo vệ, sẽ không bị pháp thuật hắc ám nuốt chửng.",
    ["BuffDes_31014305"]="Bạn bị nhiễm pháp thuật hắc ám, đang bị nuốt chửng dần dần.",
    ["BuffDes_31015301"]="Cơ thể đang dần biến thành xương... Tốc Đánh và hiệu quả hồi phục giảm <color=#FF4500>20%</color>, khi tử trận sẽ biến thành đống xương.",
    ["BuffDes_31015302"]="Bạn cảm thấy HP đang dần mất đi, mỗi giây mất <color=#FF4500>15%</color> HP.",
    ["BuffDes_31015303"]="Bạn bị đóng đinh vào lồng giam địa ngục, giảm <color=#FF4500>80%</color> Tốc Chạy.",
    ["BuffDes_31016301"]="Bị ngọn lửa thiêu đốt, mỗi giây giảm <color=#FF4500>15%</color> HP1",
    ["BuffDes_31016302"]="Bị lửa chết thiêu đốt, tăng mạnh sát thương nhận",
    ["BuffDes_31016303"]="Vào trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>70%%</color>.",
    ["BuffDes_31016304"]="Bị địa ngục phán tội, sắp gây sát thương cao lên xung quanh, giữ phân tán!",
    ["BuffDes_31017301"]="Tâm trí của bạn bị chấn động, lần sau phải chịu hiệu ứng Nộ Hỏa gấp đôi.",
    ["BuffDes_31017302"]="Hành động của bạn đã bị kìm nén, Giảm Tốc <color=#7ACEFF>40%</color>, đồng thời HP Max giảm <color=#7ACEFF>50%</color>.",
    ["BuffDes_31017303"]="Bạn phải trải qua bài sát hạch khiêm tốn, tiếp tục mất HP cho đến khi người chơi khác bị chặn.",
    ["BuffDes_31017304"]="Bạn đang được sự an ủi của Thiên Giới, tiếp tục mất HP cho đến khi bàn tay quái vật biến mất!",
    ["BuffDes_31017306"]="Bạn đang bị giám sát, đừng làm trái quy tắc.",
    ["BuffDes_31017311"]="Bạn đã phá vỡ quy tắc và phải chịu cơn thịnh nộ của Thần!",
    ["BuffDes_31018301"]="Tốc Chạy giảm <color=#7ACEFF>20%</color>",
    ["BuffDes_31018303"]="Năng lượng khổng lồ tràn vào cơ thể của bạn! Mỗi giây mất <color=#7ACEFF>10%</color> HP.",
    ["BuffDes_31018304"]="Giáp của bạn bị Mây Axit ăn mòn, mỗi tầng Giảm ST Cuối và Buff ST Cuối giảm <color=#7ACEFF>5%</color>.",
    ["BuffDes_31018305"]="Bạn bị Sóng Năng Lượng tấn công, Giảm Tốc <color=#7ACEFF>80%</color>.",
    ["BuffDes_31019302"]="Bạn bị lượng lớn cát quét qua, túi đồ trên người ngày càng nặng, tải trọng tối đa giảm <color=#7ACEFF>1.000</color>; khi cát quá nhiều, bạn sẽ rơi vào <color=#44afee>Hóa Đá</color>",
    ["BuffDes_33034301"]="Khi Quỷ Tượng Đá liên kết bị thương, bản thân cũng bị thương theo tỉ lệ tương tự.",
    ["BuffDes_33066301"]="Ở trạng thái <color=#7ACEFF>Giảm Phòng Thủ</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>20%</color> Vật Phòng và Pháp Phòng",
    ["BuffDes_33068301"]="Ở trạng thái <color=#7ACEFF>Tầm Nhìn Hạn Chế</color>, trong thời gian duy trì hiệu ứng, Chính Xác Cuối giảm <color=#7ACEFF>30%%</color>.",
    ["BuffDes_33068302"]="Ở trạng thái <color=#7ACEFF>Tầm Nhìn Hạn Chế</color>, trong thời gian duy trì hiệu ứng, Chính Xác Cuối giảm <color=#7ACEFF>25%%</color>.",
    ["BuffDes_33068303"]="Ở trạng thái <color=#7ACEFF>Tầm Nhìn Hạn Chế</color>, trong thời gian duy trì hiệu ứng, Chính Xác Cuối giảm <color=#7ACEFF>20%%</color>.",
    ["BuffDes_35011302"]="Ở trạng thái <color=#7ACEFF>Phản Pháp Thuật</color>, trong thời gian duy trì hiệu ứng, mỗi lần thi triển kỹ năng sẽ tiêu hao <color=#7ACEFF>SP nhân đôi</color> và mỗi giây trừ 10% SP. Khi SP dưới 5% sẽ tử trận, sau khi thời gian duy trì kết thúc sẽ chuyển đổi SP của bản thành HP theo tỷ lệ",
    ["BuffDes_35016302"]="Ở trạng thái <color=#7ACEFF>Suy Yếu</color>, trong thời gian duy trì hiệu ứng, ST phải chịu mỗi lớp tăng 20%, Trị Liệu nhận được giảm 100%.",
    ["BuffDes_36000301"]="Buff ST Cuối 20%",
    ["BuffDes_4000"]="HP trong chiến trường GVG x4",
    ["BuffDes_4001"]="Không thể hồi sinh.",
    ["BuffDes_4001101"]="Ở trạng thái <color=#44afee>Khiên Chắn Quang Năng</color>, trong thời gian duy trì hiệu ứng sẽ chống đỡ sát thương bằng điểm khiên chắn.",
    ["BuffDes_4002"]="Con Dấu Chiến Trường",
    ["BuffDes_4003"]="Nếu tiếp tục tử trận trong thời gian hiệu lực, khi hồi sinh sẽ bị suy yếu khiến thuộc tính giảm, chỉ có hiệu lực trong chế độ PVP.",
    ["BuffDes_4004"]="ST Công Cuối gây ra, Buff Trị Liệu nhận được và hiệu ứng Hút Máu giảm 20%, ST Cuối phải chịu tăng 20%.",
    ["BuffDes_4004353"]="Đi theo Saitama cùng rèn luyện, cảm thấy bản thân ngày càng mạnh mẽ hơn, Sức Mạnh tăng 52 điểm",
    ["BuffDes_4004354"]="Đi theo Saitama cùng rèn luyện, cảm thấy bản thân ngày càng mạnh mẽ hơn, Linh Hoạt tăng 52 điểm",
    ["BuffDes_4004355"]="Đi theo Saitama cùng rèn luyện, cảm thấy bản thân ngày càng mạnh mẽ hơn, Thể Chất tăng 52 điểm",
    ["BuffDes_4005"]="ST Công Cuối gây ra, Buff Trị Liệu nhận được và hiệu ứng Hút Máu giảm 30%, ST Cuối phải chịu tăng 30%.",
    ["BuffDes_4006"]="ST Công Cuối gây ra, Buff Trị Liệu nhận được và hiệu ứng Hút Máu giảm 50%, ST Cuối phải chịu tăng 50%.",
    ["BuffDes_4007"]="ST Công Cuối gây ra, Buff Trị Liệu nhận được và hiệu ứng Hút Máu giảm 70%, ST Cuối phải chịu tăng 70%.",
    ["BuffDes_4008"]="Bảo vệ an toàn, trong thời gian Buff tồn tại sẽ không phải chịu sát thương",
    ["BuffDes_4009"]="Hồi sinh sau tử vong nhận 1s Vô Địch",
    ["BuffDes_4010"]="Bảo Vệ Đầu Trận",
    ["BuffDes_4011"]="Giai đoạn chuẩn bị không thể dùng kỹ năng nghề",
    ["BuffDes_4017"]="Cấm sử dụng tấn công đánh thường và kỹ năng",
    ["BuffDes_4020"]="Những dũng sĩ không rời khỏi khu an toàn trong vòng 40 giây sẽ bị loại khỏi map",
    ["BuffDes_4031"]="Nhận được cổ vũ của hầu gái, có thể biết trước đáp án chính xác trong Đố Vui OX",
    ["BuffDes_4032"]="Trong thời gian sự kiện, hãy hoàn thành các đơn đặt hàng bang hội nâng cao và phần thưởng của bạn sẽ tăng lên.<color=#44afee>100%%</color>",
    ["BuffDes_4101101"]="Ở trạng thái <color=#44afee>Khiên Chắn Sấm Sét</color>, trong thời gian duy trì hiệu ứng sẽ chống đỡ sát thương bằng điểm khiên chắn.",
    ["BuffDes_4101301"]="Đơn vị này mỗi 2 giây tăng 1 tầng hiệu ứng, mỗi tầng tăng <color=#44afee>2%%</color> Tăng ST.",
    ["BuffDes_4101304"]="Mỗi sát thương sẽ gây thêm sát thương thực tế <color=#44afee>3%% máu tối đa của mục tiêu</color>. Hiệu ứng có thể được xếp chồng lên nhau.",
    ["BuffDes_4101326"]="Nếu không rời khỏi vùng an toàn khi kết thúc đếm ngược, bạn sẽ nhận được hiệu ứng \"yếu\".",
    ["BuffDes_4101327"]="Bạn không thể tận hưởng hiệu ứng bất khả chiến bại và phục hồi của vùng an toàn trong suốt thời gian hiệu ứng này.",
    ["BuffDes_4101328"]="Khuếch đại sát thương cuối cùng -50%, giảm sát thương cuối cùng -50%, tốc độ di chuyển -50%",
    ["BuffDes_4110303"]="Khi số người phe ta nhiều hơn kẻ địch trong phạm vi điẻm tài nguyên, có thể nhận Buff ST.",
    ["BuffDes_4500"]="Trong thời gian sự kiện, EXP Cơ Bản, EXP Nghề, số lượng Zeny nhận được khi đánh bại Quái Dã Ngoại tăng %s%%",
    ["BuffDes_4501"]="Trong thời gian sự kiện, xác suất rơi vật phẩm hiếm MVP/Mini nhận được khi đánh bại Quái Dã Ngoại tăng %s%%",
    ["BuffDes_4502"]="Trong thời gian sự kiện, EXP Cơ Bản, EXP Nghề, số lượng Zeny và xác suất rơi vật phẩm hiếm MVP/Mini nhận được khi đánh bại quái dã ngoại tăng %s%%",
    ["BuffDes_4510"]="Trong thời gian sự kiện, xác suất rơi vật phẩm hiếm khi đánh bại MVP dã ngoại tăng %s%%",
    ["BuffDes_4511"]="Trong thời gian sự kiện, xác suất rơi vật phẩm hiếm khi đánh bại Mini dã ngoại tăng %s%%",
    ["BuffDes_4512"]="Trong thời gian sự kiện, xác suất rơi Thẻ nhận được khi đánh bại Quái Dã Ngoại tăng %s%%",
    ["BuffDes_4513"]="Trong thời gian sự kiện, xác suất rơi Zeny Poring trong lối chơi Phó Bản, Tháp Vô Tận tăng %s%%",
    ["BuffDes_4514"]="Trong thời gian sự kiện, xác suất rơi Thẻ và Trang Phục trong Phó Bản tăng %s%%",
    ["BuffDes_4515"]="Trong thời gian sự kiện, xác suất rơi Thẻ và Trang Phục trong lối chơi Nhóm tăng %s%%",
    ["BuffDes_4516"]="Trong thời gian sự kiện, trong lối chơi Câu Cá và Đào Mỏ, có %s%% xác suất bạo kích, có thể nhận thêm đạo cụ",
    ["BuffDes_4517"]="Trong thời gian sự kiện, trong lối chơi Làm Vườn và Đúc, có %s%% xác suất bạo kích, có thể nhận thêm đạo cụ. Trong thời tiết đặc biệt, tốc độ thu thập Làm Vườn tăng %s%%",
    ["BuffDes_4518"]="Trong thời gian sự kiện, nhận thêm %s lần thưởng nhiệm vụ trong lối chơi Bảng Ủy Thác hàng ngày",
    ["BuffDes_4519"]="Trong thời gian sự kiện, các kỹ năng đời sống Câu Cá/Đào Mỏ/Làm Vườn/Đúc sẽ nhận Buff EXP",
    ["BuffDes_4521"]="Ở trạng thái <color=#44afee>Cuồng Nhiệt</color>, Sức Mạnh, Trí Lực, Nhanh Nhẹn, Thể Chất, Linh Hoạt, May Mắn trong thời gian duy trì hiệu ứng tăng <color=#46afee>Cấp cơ bản của bản thân x150%</color>",
    ["BuffDes_4522"]="Ở trạng thái <color=#44afee>Cuồng Nhiệt</color>, Sức Mạnh, Trí Lực, Nhanh Nhẹn, Thể Chất, Linh Hoạt, May Mắn trong thời gian duy trì hiệu ứng tăng <color=#46afee>%s%%</color>",
    ["BuffDes_4534"]="Trong thời gian diễn ra sự kiện, lượng kinh nghiệm Nghề cơ bản thu được từ việc đánh bại quái vật hoang dã sẽ tăng lên.%s%%",
    ["BuffDes_4550"]="Trong thời gian sự kiện, xác suất bắt được Pet phẩm S/A tăng 50%\nXác suất tiến hóa thành Pet phẩm S/A tăng 50%",
    ["BuffDes_50003111"]="Tăng cho Pet và chủ nhân [20] điểm Sức Mạnh, duy trì [60]s",
    ["BuffDes_50003121"]="Tăng cho Pet và chủ nhân [20] điểm Nhanh Nhẹn, duy trì [60]s",
    ["BuffDes_50003131"]="Tăng cho Pet và chủ nhân [20] điểm Thể Chất, duy trì [60]s",
    ["BuffDes_50003141"]="Tăng cho Pet và chủ nhân [20] điểm Trí Lực, duy trì [60]s",
    ["BuffDes_50003151"]="Tăng cho Pet và chủ nhân [20] điểm Linh Hoạt, duy trì [60]s",
    ["BuffDes_50003161"]="Tăng cho Pet và chủ nhân [20] điểm May Mắn, duy trì [60]s",
    ["BuffDes_50003211"]="Khiến tất cả mục tiêu nhóm mỗi giây liên tục hồi HP bằng [100%] Pháp Công, duy trì 5s",
    ["BuffDes_50003281"]="Phản đòn [50%] Vật Thương Cận Chiến. Duy trì [5]s",
    ["BuffDes_50005011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Đất, duy trì [60]s",
    ["BuffDes_50005021"]="Gây sát thương Đất cho bản thân và chủ nhân tăng [20%], sát thương Đất phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50006011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Lửa, duy trì [60]s",
    ["BuffDes_50006021"]="Gây sát thương Lửa cho bản thân và chủ nhân tăng [20%], sát thương Lửa phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50007011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Nước, duy trì [60]s",
    ["BuffDes_50007021"]="Gây sát thương Nước cho bản thân và chủ nhân tăng [20%], sát thương Nước phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50008011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Gió, duy trì [60]s",
    ["BuffDes_50008021"]="Gây sát thương Gió cho bản thân và chủ nhân tăng [20%], sát thương Gió phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50009011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Bóng Tối, duy trì [60]s",
    ["BuffDes_50009021"]="Gây sát thương hệ Bóng Tối cho bản thân và chủ nhân tăng [20%], sát thương Ám phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50010011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Hồn Ma, duy trì [60]s",
    ["BuffDes_50010021"]="Gây sát thương hệ Hồn Ma cho bản thân và chủ nhân tăng [20%], sát thương hệ Hồn Ma phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50011011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Độc, duy trì [60]s",
    ["BuffDes_50011021"]="Gây sát thương Độc cho bản thân và chủ nhân tăng [20%], sát thương Độc phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50012011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Thây Ma, duy trì [60]s",
    ["BuffDes_50012021"]="Gây sát thương hệ Thây Ma cho bản thân và chủ nhân tăng [20%], sát thương hệ Thây Ma phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50013011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Trung Tính, duy trì [60]s",
    ["BuffDes_50013021"]="Gây sát thương hệ Trung Tính cho bản thân và chủ nhân tăng [20%], sát thương hệ Trung Tính phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_50014011"]="Tăng cho bản thân và chủ nhân [20%] hiệu ứng hệ Thánh, duy trì [60]s",
    ["BuffDes_50014021"]="Gây sát thương Thánh cho bản thân và chủ nhân tăng [20%], sát thương Thánh phải chịu giảm [20%], duy trì [60]s",
    ["BuffDes_55002192"]="Sát thương lửa bản thân hứng chịu tăng <color=#44afee>50%%</color>",
    ["BuffDes_55003011"]="Vào trạng thái <color=#44afee>Bí Thuật-Tăng Cường Hệ Đất</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> tăng Cường Hệ Đất.",
    ["BuffDes_55003021"]="Vào trạng thái <color=#44afee>Bí Thuật-Tăng cường Hệ Lửa</color>, trong thời gian duy trì hiệu ứng tăng <color=#45afee>%s%%</color> tăng cường Hệ Lửa.",
    ["BuffDes_55003031"]="Vào trạng thái <color=#44afee>Bí Thuật-Tăng cường Hệ Gió</color>, trong thời gian duy trì hiệu ứng tăng <color=#46afee>%s%%</color> tăng cường Hệ Gió.",
    ["BuffDes_55003041"]="Vào trạng thái <color=#44afee>Bí Thuật-Tăng cường Hệ Nước</color>, trong thời gian duy trì hiệu ứng tăng <color=#47afee>%s%%</color> tăng cường Hệ Nước.",
    ["BuffDes_55003051"]="Vào trạng thái <color=#44afee>Bí Thuật-Kháng Đất</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> ST nhận từ quái vật Hệ Đất.",
    ["BuffDes_55003061"]="Vào trạng thái <color=#44afee>Bí Thuật-Kháng Hỏa</color>, trong thời gian duy trì hiệu ứng giảm <color=#45afee>%s%%</color> ST nhận từ quái vật thuộc tính Hỏa.",
    ["BuffDes_55003071"]="Vào trạng thái <color=#44afee>Bí Thuật-Kháng Gió</color>, trong thời gian duy trì hiệu ứng giảm <color=#46afee>%s%%</color> ST nhận từ quái vật Hệ Gió.",
    ["BuffDes_55003081"]="Vào trạng thái <color=#44afee>Bí Thuật-Kháng Nước</color>, trong thời gian duy trì hiệu ứng giảm <color=#47afee>%s%%</color> ST nhận từ quái vật Hệ Nước.",
    ["BuffDes_55003091"]="Vào trạng thái <color=#44afee>Bí Thuật-Công Kích Đất</color>, trong thời gian duy trì hiệu ứng thuộc tính vũ khí sẽ đổi thành Hệ Đất, tăng <color=#44afee>%s%%</color> tăng Cường Hệ Đất.",
    ["BuffDes_55003101"]="Vào trạng thái <color=#44afee>Bí Thuật-Công Kích Lửa</color>, trong thời gian duy trì hiệu ứng thuộc tính vũ khí sẽ đổi thành Hệ Lửa, tăng <color=#45afee>%s%%</color> tăng cường Hệ Lửa.",
    ["BuffDes_55003111"]="Vào trạng thái <color=#44afee>Bí Thuật-Công Kích Gió</color>, trong thời gian duy trì hiệu ứng thuộc tính vũ khí sẽ đổi thành Hệ Gió, tăng <color=#46afee>%s%%</color> tăng cường Hệ Gió.",
    ["BuffDes_55003121"]="Vào trạng thái <color=#44afee>Bí Thuật-Công Kích Nước</color>, trong thời gian duy trì hiệu ứng thuộc tính vũ khí sẽ đổi thành Hệ Nước, tăng <color=#47afee>%s%%</color> tăng cường Hệ Nước.",
    ["BuffDes_55003131"]="Vào trạng thái <color=#44afee>Bí Thuật-Giáp Hệ Đất</color>, trong thời gian duy trì thuộc tính giáp sẽ đổi thành Hệ Đất, giảm <color=#44afee>%s%%</color> ST nhận từ quái vật Hệ Đất.",
    ["BuffDes_55003141"]="Vào trạng thái <color=#44afee>Bí Thuật-Giáp Hệ Lửa</color>, trong thời gian duy trì thuộc tính giáp sẽ đổi thành Hệ Lửa, giảm <color=#45afee>%s%%</color> ST nhận từ quái vật Hệ Lửa.",
    ["BuffDes_55003151"]="Vào trạng thái <color=#44afee>Bí Thuật-Giáp Hệ Gió</color>, trong thời gian duy trì thuộc tính giáp sẽ đổi thành Hệ Gió, giảm <color=#46afee>%s%%</color> ST nhận từ quái vật Hệ Gió.",
    ["BuffDes_55003161"]="Vào trạng thái <color=#44afee>Bí Thuật-Giáp Hệ Nước</color>, trong thời gian duy trì thuộc tính giáp sẽ đổi thành Hệ Nước, giảm <color=#47afee>%s%%</color> ST nhận từ quái vật Hệ Nước.",
    ["BuffDes_55003171"]="Vào trạng thái <color=#44afee>Bí Thuật-Bùn Lầy</color>, trong thời gian duy trì hiệu ứng Tốc Chạy giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_55003181"]="Vào trạng thái <color=#44afee>Bí Thuật-Thiêu Đốt Sinh Mệnh</color>, trong thời gian duy trì hiệu ứng cứ <color=#44afee>3</color> giây sẽ giảm <color=#44afee>%s%%</color>HP Max.",
    ["BuffDes_55003191"]="Vào trạng thái <color=#44afee>Bí Thuật-Khiên Băng Sương</color>, trong thời gian duy trì hiệu ứng khi nhận ST có <color=#44afee>%s%%</color> tỉ lệ Đóng Băng người tấn công <color=#44afee>1</color> giây.",
    ["BuffDes_55003201"]="Vào trạng thái <color=#44afee>Bí Thuật-Phá Hủy Vũ Khí</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Buff DMG cuối.",
    ["BuffDes_55003211"]="Ở trạng thái <color=#44afee>Bí Thuật-Da Cứng</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s</color> điểm Kháng Trạng Thái Debuff và Giảm Trạng Thái Debuff.",
    ["BuffDes_55003221"]="Vào trạng thái <color=#44afee>Bí Thuật-Ma Lực Thiêu Đốt</color>, trong thời gian duy trì hiệu ứng cứ <color=#44afee>3</color> giây sẽ giảm <color=#44afee>%s%%</color>HP Max.",
    ["BuffDes_55003231"]="Vào trạng thái <color=#44afee>Bí Thuật-Khiên Hàn Sương</color>, trong thời gian duy trì hiệu ứng sẽ được Khiên Hàn Sương bảo vệ, có thể đỡ được ST bằng <color=#44afee>%s%%</color>HP Max.",
    ["BuffDes_55003241"]="Vào trạng thái <color=#44afee>Bí Thuật-Phá Hủy Giáp</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Giảm DMG Cuối.",
    ["BuffDes_55003411"]="Vào trạng thái <color=#44afee>Đặc Kỹ-Dấu Hệ Đất</color>, trong thời gian duy trì hiệu ứng sẽ cộng dồn số lớn dấu ấn Hệ Đất, cộng đầy <color=#44afee>4</color> lớp sẽ tăng <color=#44afee>%s%%</color> tăng Cường Hệ Đất.",
    ["BuffDes_55003412"]="Vào trạng thái <color=#44afee>Dấu Ấn-Tăng Cường Hệ Đất</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> tăng Cường Hệ Đất.",
    ["BuffDes_55003421"]="Vào trạng thái <color=#44afee>Đặc Kỹ-Dấu Hệ Lửa</color>, trong thời gian duy trì hiệu ứng sẽ cộng dồn số lớp dấu ấn Hệ Lửa, cộng đầy <color=#44afee>4</color> lớp sẽ tăng <color=#44afee>%s%%</color> tăng cường Hệ Lửa.",
    ["BuffDes_55003422"]="Vào trạng thái <color=#44afee>Dấu Ấn-Tăng Cường Hệ Lửa</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> tăng Cường Hệ Lửa.",
    ["BuffDes_55003431"]="Vào trạng thái <color=#44afee>Đặc Kỹ-Dấu Hệ Nước</color>, trong thời gian duy trì hiệu ứng sẽ cộng dồn số lớp dấu ấn Hệ Nước, cộng đầy <color=#44afee>4</color> lớp sẽ tăng <color=#44afee>%s%%</color> tăng Cường Hệ Nước.",
    ["BuffDes_55003432"]="Vào trạng thái <color=#44afee>Dấu Ấn-Tăng Cường Hệ Nước</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> tăng Cường Hệ Nước.",
    ["BuffDes_55003441"]="Vào trạng thái <color=#44afee>Đặc Kỹ-Dấu Hệ Gió</color>, trong thời gian duy trì hiệu ứng sẽ cộng dồn số lớp dấu ấn Hệ Gió, cộng đầy <color=#44afee>4</color> lớp sẽ tăng <color=#44afee>%s%%</color> tăng Cường Hệ Gió.",
    ["BuffDes_55003442"]="Vào trạng thái <color=#44afee>Dấu Ấn-Tăng Cường Hệ Gió</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> tăng Cường Hệ Gió.",
    ["BuffDes_55003571"]="Vào trạng thái <color=#44afee>Bí Thuật-Kháng Vật Lý</color>, trong thời gian duy trì hiệu ứng tăng thêm <color=#44afee>%s%%</color> hiệu ứng Vật Phòng Cuối và Giảm Vật Thương Cuối.",
    ["BuffDes_55003581"]="Vào trạng thái <color=#44afee>Bí Thuật-Kháng Pháp Thuật</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> hiệu ứng Pháp Phòng Cuối và Giảm Pháp Thương Cuối.",
    ["BuffDes_55003591"]="Vào trạng thái <color=#44afee>Bí Thuật-Kháng Đánh Thường</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Né Cuối và Phòng Bạo Cuối.",
    ["BuffDes_55003601"]="Vào trạng thái <color=#44afee>Bí Thuật-Tăng Trị Liệu</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Buff Trị Liệu nhận và Buff Trị Liệu.",
    ["BuffDes_55003611"]="Vào trạng thái <color=#44afee>Bí Thuật-Chướng Ngại Ánh Sáng</color>, trong thời gian duy trì hiệu ứng <color=#44afee>miễn ST Vật Lý</color>, tối đa chịu được <color=#44afee>%s</color> lần chướng ngại.",
    ["BuffDes_55003621"]="Vào trạng thái <color=#44afee>Bí Thuật-Bức Tường An Toàn</color>, trong thời gian duy trì hiệu ứng <color=#44afee>miễn ST Pháp Thuật</color>, tối đa chịu được <color=#44afee>%s</color> lần chướng ngại.",
    ["BuffDes_55003631"]="Vào trạng thái <color=#44afee>Pet-Hồi Phục Cấp Tốc</color>, trong thời gian duy trì hiệu ứng mỗi giây hồi <color=#44afee>%s%%</color> HP Max",
    ["BuffDes_55003641"]="Vào trạng thái <color=#44afee>Pet-Kyrie Eleison</color>, trong thời gian duy trì hiệu ứng, dùng Khiên Phòng Thủ đỡ sát thương, Khiên Phòng Thủ tối đa có thể đỡ được ST bằng <color=#44afee>%s%%</color> HP Max",
    ["BuffDes_55003651"]="Vào trạng thái <color=#44afee>Pet-Bảo Hộ Thần Thánh</color>, trong thời gian duy trì hiệu ứng, khi chịu Sát Thương Chí Tử lập tức hồi <color=#44afee>%s%%</color> HP.",
    ["BuffDes_55003711"]="Vào trạng thái <color=#44afee>Bí Thuật-Phá Hủy Sắc Bén</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Chính Xác Cuối và Bạo kích Cuối, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003721"]="Vào trạng thái <color=#44afee>Bí Thuật-Phá Hủy Kiên Cố</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Né Cuối và Phòng Bạo Cuối, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003731"]="Vào trạng thái <color=#44afee>Bí Thuật-Phá Hủy Phòng Ngự</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> hiệu ứng Vật Phòng Cuối và hiệu ứng Pháp Phòng Cuối, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003741"]="Vào trạng thái <color=#44afee>Bí Thuật-Phá Hủy Xuyên Thấu</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Xuyên Vật Phòng Cuối và Xuyên Pháp Phòng Cuối, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003751"]="Vào trạng thái <color=#44afee>Bí Thuật-Phá Hủy Kèm Theo</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Sát Thương Vật Lý Cuối kèm và Sát Thương Pháp Thuật Cuối kèm, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003761"]="Vào trạng thái <color=#44afee>Bí Thuật-Phá Hủy Miễn Giảm</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Giảm Vật Thương Cuối và Giảm Pháp Thương Cuối, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003771"]="Vào trạng thái <color=#44afee>Tuyệt Kỹ-Phá Hủy Miễn Giảm</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Vật Công và Pháp Công, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003781"]="Vào trạng thái <color=#44afee>Tuyệt Kỹ-Phá Hủy Bạo Kích</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Sát Thương Bạo Kích kèm và Giảm DMG Bạo Kích, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003791"]="Vào trạng thái <color=#44afee>Tuyệt Kỹ-Phá Hủy Trị Liệu</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Buff Trị Liệu và Buff Trị Liệu nhận, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003801"]="Ở trạng thái <color=#44afee>Tuyệt Kỹ-Phá Hủy Trạng Thái</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s</color> điểm Kháng Trạng Thái Debuff và Giảm Trạng Thái Debuff, cộng dồn tối đa <color=#44afee>4</color> tầng.",
    ["BuffDes_55003811"]="Vào trạng thái <color=#44afee>Đặc Kỹ-Phá Hủy Cuối Cùng</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Buff sát thương cuối và Giảm DMG Cuối, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003821"]="Vào trạng thái <color=#44afee>Đặc Kỹ-Phá Hủy Kèm Theo</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Sát Thương Vật Lý Cuối PVP kèm và Pháp Thương Cuối PVP kèm, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003831"]="Vào trạng thái <color=#44afee>Đặc Kỹ-Phá Hủy Miễn Giảm</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Giảm Vật Thương Cuối PVP và Giảm Pháp Thương Cuối PVP, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_55003841"]="Ở trạng thái <color=#44afee>Đặc Kỹ-Phá Hủy Trạng Thái</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s</color> điểm Giảm Trạng Thái Debuff PVP và Kháng Trạng Thái Debuff PVP, cộng dồn tối đa <color=#44afee>4</color> tầng.",
    ["BuffDes_55003911"]="Vào trạng thái <color=#44afee>Tuyệt Kỹ-Cầm Cố Tốc Đánh</color>, trong thời gian duy trì hiệu ứng, Tốc Đánh Cuối giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_55003921"]="Vào trạng thái <color=#44afee>Tuyệt Kỹ-Cầm Cố Cấp Tốc</color>, trong thời gian duy trì hiệu ứng, Cấp Tốc Cuối giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_55003931"]="Vào trạng thái <color=#44afee>Tuyệt Kỹ-Cầm Cố HP</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> HP hồi phục, hồi HP mỗi 5 giây, hồi thuốc HP, hiệu ứng trị liệu nhận.",
    ["BuffDes_55003941"]="Vào trạng thái <color=#44afee>Tuyệt Kỹ-Cầm Cố SP</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> hồi phục SP, hồi SP mỗi 5 giây, hồi thuốc SP.",
    ["BuffDes_55004071"]="Vào trạng thái <color=#44afee>Sói Gầm</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Giảm Vật Thương Cuối và Giảm Pháp Thương Cuối.",
    ["BuffDes_55004081"]="Vào trạng thái <color=#44afee>Sói Tru</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Giảm Vật Thương Cuối PVP và Giảm Pháp Thương Cuối PVP.",
    ["BuffDes_55004091"]="Vào trạng thái <color=#44afee>Khát Máu</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Hút Máu Vật Lý và Hút Máu Pháp Thuật.",
    ["BuffDes_55004101"]="Vào trạng thái <color=#44afee>Truyền Máu</color>, trong thời gian duy trì hiệu ứng mỗi giây hồi phục <color=#44afee>%s%%</color> HP (không bị thuộc tính liên quan Buff Trị Liệu nhận ảnh hưởng).",
    ["BuffDes_55004155"]="Vào trạng thái <color=#44afee>Miễn Dịch</color>, trong thời gian duy trì hiệu ứng, trừ trạng thái Debuff (ngoài những Debuff quái cấp BOSS). ",
    ["BuffDes_55004181"]="Khi ở trạng thái <color=#44afee>Hồn Trăng</color>, trong thời gian duy trì hiệu quả sẽ tăng <color=#FFA500>%s%%</color> Sát Thương Cuối và Giảm Sát Thương Cuối",
    ["BuffDes_55004211"]="Ở trạng thái <color=#7ACEFF>Carnage</color>, thể hình sẽ lớn hơn <color=#7ACEFF>30%%</color>, hiệu ứng Vật Phòng Cuối và Pháp Phòng Cuối tăng <color=#7ACEFF>30%%</color>.",
    ["BuffDes_55004224"]="Ở trạng thái <color=#7ACEFF>Giảm Tốc</color>, trong thời gian duy trì hiệu ứng, Tốc Chạy giảm <color=#7ACEFF>75%%</color>.",
    ["BuffDes_55004231"]="Mỗi tầng tăng <color=#44afee>%s%%</color> Tăng ST với Quái Lớn và <color=#44afee>%s%%</color> Tăng Cường Hệ Nước.",
    ["BuffDes_55004261"]="Trong trạng thái thức tỉnh phòng thủ, bạn sẽ đạt được mức MaxHp tương đương của chính mình trong suốt thời gian hiệu ứng.<color=#44afee>%s%%</color>lá chắn của.",
    ["BuffDes_55004276"]="TRONG<color=#7ACEFF>hôn mê</color>Trạng thái: Trong thời gian hiệu lực, bạn không thể giải phóng kỹ năng, tấn công hoặc di chuyển, đồng thời không thể phục hồi các giá trị sức khỏe và phép thuật của bạn một cách tự nhiên. tích lũy nhận được<color=#7ACEFF>30%%</color>Giải phóng trạng thái hôn mê sau khi nhận sát thương MaxHp của bản thân.",
    ["BuffDes_55004278"]="Sẽ vào khi đếm ngược kết thúc<color=#7ACEFF>hôn mê</color>Ở trạng thái này, bạn không thể giải phóng kỹ năng, tấn công hoặc di chuyển khi đang hôn mê, đồng thời các giá trị sức khỏe và phép thuật của bạn không thể được phục hồi một cách tự nhiên. tích lũy nhận được<color=#7ACEFF>30%%</color>Giải phóng trạng thái hôn mê sau khi nhận sát thương MaxHp của bản thân.",
    ["BuffDes_55004281"]="Tăng<color=#E79741>%s</color>kháng trạng thái tiêu cực và<color=#E79741>2</color>tốc độ di chuyển điểm",
    ["BuffDes_55004282"]="Nhận MaxHp riêng<color=#E79741>%s%%</color>lá chắn của",
    ["BuffDes_55004332"]="cải thiện bản thân<color=#FFA500>%s%%</color>Tăng cường phi thuộc tính và tăng cường thuộc tính suy nghĩ",
    ["BuffDes_550060101"]="Ở trạng thái <color=#7ACEFF>Bão Lực Hấp Dẫn</color>, trong thời gian duy trì hiệu ứng, tiêu hao SP kỹ năng tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_550060301"]="Ở trạng thái <color=#7ACEFF>Va Chạm Yếu Ớt</color>, trong thời gian duy trì hiệu ứng, HP Max giảm <color=#7ACEFF>60%%</color>.",
    ["BuffDes_550060601"]="Ở trạng thái <color=#7ACEFF>Giáp Sắc Nhọn</color>, trong thời gian duy trì hiệu ứng, Hệ Giáp chuyển hoá thành <color=#7ACEFF>Hệ Lửa</color>, mỗi lần chịu ST đều sẽ gây ST cho kẻ tấn công.",
    ["BuffDes_550061201"]="Ở trạng thái <color=#7ACEFF>Tự Động Phòng Thủ</color>, trong thời gian duy trì hiệu ứng, miễn dịch <color=#7ACEFF>%s</color> lần ST Tầm Xa, sau mỗi lần miễn dịch ST Tầm Xa đều khiến Buff ST Cuối của kẻ tấn công giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_550061202"]="Buff ST Cuối của bản thân giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_550061401"]="Ở trạng thái <color=#7ACEFF>Tự Động Phản Kích</color>, trong thời gian duy trì hiệu ứng, Giảm ST Cuối tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_550061701"]="Ở trạng thái <color=#7ACEFF>Tấn Công Bỏ Qua Phòng Thủ</color>, trong thời gian duy trì hiệu ứng, tấn công bỏ qua <color=#7ACEFF>%s%%</color> Phòng Thủ của mục tiêu.",
    ["BuffDes_550061901"]="Ở trạng thái <color=#7ACEFF>Thẩm Phán Anubis</color>, trong thời gian duy trì hiệu ứng, thể hình tăng <color=#7ACEFF>20%%</color>, mỗi lần Đánh Thường Cận Chiến kèm thêm ST Hệ Thây Ma và tăng Tốc Chạy.",
    ["BuffDes_550062201"]="Ở trạng thái <color=#7ACEFF>Kích Hoạt Nhanh Chóng</color>, trong thời gian duy trì hiệu ứng, Tốc Đánh Cuối tăng <color=#7ACEFF>%s%%</color>, phần trăm ST Bạo Kích kèm tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_550062301"]="Ở trạng thái <color=#7ACEFF>Lời Nguyền Ác Quỷ</color>, trong thời gian duy trì hiệu ứng, hồi chiêu kỹ năng tăng <color=#7ACEFF>%s</color> giây, thời gian vận công tăng <color=#7ACEFF>%s</color> giây.",
    ["BuffDes_550062401"]="Ở trạng thái <color=#7ACEFF>Hồ Ly Mê Hoặc</color>, trong thời gian duy trì hiệu ứng, Buff ST Cuối giảm <color=#7ACEFF>%s%%</color>, đồng thời ST từ nguồn Debuff phải chịu tăng <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_550062501"]="Ở trạng thái <color=#7ACEFF>Tinh Thần Phân Liệt</color>, trong thời gian duy trì hiệu ứng, mỗi lần thi triển kỹ năng sẽ chịu ST Hệ Hồn Ma bằng <color=#7ACEFF>%s%%</color> HP Max của bản thân.",
    ["BuffDes_55006262"]="Ở trạng thái <color=#7ACEFF>Ánh Trăng</color>, phần trăm Vật Phòng và phần trăm Pháp Phòng của bản thân giảm <color=#7ACEFF>%s%%</color>.",
    ["BuffDes_5501301"]="“Bay lên đi, các dũng sĩ trừ ma!” - Tổ Chức Bóng Tối",
    ["BuffDes_5501302"]="“Thỏa sức chiến đấu đi, các dũng sĩ trừ ma!” - Tổ Chức Bóng Tối",
    ["BuffDes_55102011"]="Trong trạng thái <color=#44afee>Bí Thuật-Tăng Cường Hệ Độc</color>, tăng <color=#44afee>%s%%</color> Tăng Hệ Độc trong thời gian hiệu ứng.",
    ["BuffDes_55102021"]="Trong trạng thái <color=#44afee>Bí Thuật-Kháng Độc</color>, giảm <color=#45afee>%s%%</color> ST quái vật hệ Độc hứng chịu trong thời gian hiệu ứng.",
    ["BuffDes_55102031"]="Trong trạng thái <color=#44afee>Bí Thuật-Công Kích Độc</color>, trong thời gian hiệu ứng sẽ chuyển thuộc tính Vũ Khí thành hệ Độc, tăng <color=#46afee>%s%%</color> Tăng Hệ Độc.",
    ["BuffDes_55102041"]="Trong trạng thái <color=#44afee>Bí Thuật-Giáp Hệ Độc</color>, trong thời gian hiệu ứng sẽ chuyển thuộc tính Giáp thành hệ Độc, giảm <color=#47afee>%s%%</color> ST quái vật hệ Độc hứng chịu.",
    ["BuffDes_55102051"]="Trong trạng thái <color=#44afee>Bí Thuật-Giải Độc</color>, miễn dịch Trúng Độc trong thời gian hiệu ứng.",
    ["BuffDes_55102151"]="Trong trạng thái <color=#44afee>Bí Thuật-Tăng Cường Hệ Hồn Ma</color>, tăng <color=#44afee>%s%%</color> Tăng Hệ Hồn Ma trong thời gian hiệu ứng.",
    ["BuffDes_55102152"]="TRONG<color=#44afee>Huyền bí: Không tăng cường thuộc tính</color>Trạng thái, thời gian hiệu ứng tăng lên<color=#44afee>%s%%</color>Không tăng cường thuộc tính.",
    ["BuffDes_55102161"]="Trong trạng thái <color=#44afee>Bí Thuật-Kháng Hệ Hồn Ma</color>, giảm <color=#45afee>%s%%</color> ST quái vật hệ Hồn Ma hứng chịu trong thời gian hiệu ứng.",
    ["BuffDes_55102171"]="Trong trạng thái <color=#44afee>Bí Thuật-Công Kích Hệ Hồn Ma</color>, trong thời gian hiệu ứng sẽ chuyển thuộc tính Vũ Khí thành hệ Hồn Ma, tăng <color=#46afee>%s%%</color> Tăng Hệ Hồn Ma.",
    ["BuffDes_55102181"]="Trong trạng thái <color=#44afee>Bí Thuật-Giáp Hệ Hồn Ma</color>, trong thời gian hiệu ứng sẽ chuyển thuộc tính Giáp thành hệ Hồn Ma, giảm <color=#47afee>%s%%</color> ST quái vật hệ Hồn Ma hứng chịu.",
    ["BuffDes_55102191"]="Trong trạng thái <color=#44afee>Bí Thuật-Rào Chắn Trắng</color>, giảm <color=#47afee>%s%%</color> sát thương hứng chịu bất kỳ ngoài hệ Hồn Ma trong thời gian hiệu ứng.",
    ["BuffDes_55102251"]="Trong trạng thái <color=#44afee>Đặc Kỹ-Nhà Ngục Trắng</color>, tăng <color=#47afee>%s%%</color> ST hệ Hồn Ma khác do chủ nhân và Pet thi triển trong thời gian hiệu ứng.",
    ["BuffDes_55102281"]="Trong trạng thái <color=#44afee>Đặc Kỹ-Nhịp Đập Napalm</color>, hồi HP, hồi HP sau 5s, hiệu ứng thuốc HP, hiệu ứng nhận trị liệu giảm <color=#47afee>%s%%</color> trong thời gian hiệu ứng.",
    ["BuffDes_55102321"]="Trong trạng thái <color=#44afee>Da Cực Độc </color>, khi bị tấn công sẽ gây 1 lớp Trúng Độc lên người thi triển trong thời gian hiệu ứng.",
    ["BuffDes_55102331"]="Trong trạng thái <color=#44afee>Chớp Hồn</color>, tăng <color=#FFA500>%s%%</color> Né Cuối và Phòng Bạo Cuối trong thời gian hiệu ứng.",
    ["BuffDes_55102361"]="Trong trạng thái <color=#44afee>Vết Thương Chưa Lành</color>, hồi HP, hồi HP sau 5s, hiệu ứng thuốc HP, hiệu ứng nhận trị liệu giảm <color=#47afee>%s%%</color> trong thời gian hiệu ứng.",
    ["BuffDes_55102391"]="Trong trạng thái <color=#44afee>Cầu Nguyện Ánh Trăng</color>, không chịu Debuff nào (ngoài một số Debuff quái vật cấp Boss và Debuff được ghi rõ không thể xóa bỏ hay miễn dịch) trong thời gian hiệu ứng, mỗi giây sẽ hồi <color=#44afee>%s%%</color> HP Max của bản thân.",
    ["BuffDes_55102411"]="Trong trạng thái <color=#44afee>Khiên Băng Chống Đỡ</color>, thi triển 1 lớp Hàn Sương lên người tấn công khi bị tấn công trong thời gian hiệu ứng, mỗi lớp Hàn Sương sẽ giảm <color=#FFA500>%s%%</color> Tốc Đánh Cuối và <color=#FFA500>%s%%</color> Cấp Tốc Cuối của mục tiêu.",
    ["BuffDes_55102412"]="Trong trạng thái <color=#44afee>Hàn Sương</color>, giảm <color=#FFA500>%s%%</color> Tốc Đánh Cuối và <color=#FFA500>%s%%</color> Cấp Tốc Cuối trong thời gian hiệu ứng.",
    ["BuffDes_55102421"]="Trong trạng thái <color=#44afee>Da Tính Kháng</color>, tăng <color=#FFA500>%s%%</color> Giảm Vật Thương Cuối PVP và Giảm Pháp Thương Cuối PVP trong thời gian hiệu ứng.",
    ["BuffDes_55118301"]="Vào trạng thái <color=#7ACEFF>Suy Yếu</color>, trong thời gian duy trì hiệu ứng sát thương phải chịu tăng 10%, trị liệu nhận được giảm 10%, hiệu ứng này tối đa cộng dồn 20 lớp",
    ["BuffDes_55118302"]="Bị ngọn lửa của Ác Quỷ đốt cháy, mỗi giây mất 10% HP Max. Ngọn lửa Ác Quỷ có thể lan đến những đồng đội khác trong phạm vi 4m xung quanh.",
    ["BuffDes_55130305"]="Sức mạnh của bạn đang bị Thanatos hấp thu liên tục",
    ["BuffDes_55130306"]="Khí độc ăn mòn tâm trí, kích hoạt hiệu ứng Chết Ngay sau khi tích lũy cộng dồn 20 lớp.",
    ["BuffDes_551600101"]="TRONG<color=#44afee>Bí thuật · Tăng cường thuộc tính thần thánh</color>Trạng thái, hiệu ứng tăng trong thời gian hiệu lực<color=#44afee>%s%%</color>Thuộc tính thánh được tăng cường.",
    ["BuffDes_551600201"]="TRONG<color=#44afee>Bí ẩn·Kháng thuộc tính thần thánh</color>Trạng thái, giảm trong thời gian hiệu ứng<color=#47afee>%s%%</color>Thiệt hại do quái vật thuộc tính thánh gây ra.",
    ["BuffDes_551600301"]="TRONG<color=#44afee>Tấn công thuộc tính thần bí và thánh thiện</color>Trạng thái, trong thời gian hiệu lực, thuộc tính vũ khí sẽ được thay đổi thành thuộc tính thánh và thuộc tính sẽ được cải thiện.<color=#44afee>%s%%</color>Thuộc tính thánh được tăng cường.",
    ["BuffDes_551600401"]="TRONG<color=#44afee>Bí thuật·Áo giáp thuộc tính thần thánh</color>Trạng thái, trong thời gian hiệu lực, thuộc tính áo giáp sẽ được chuyển thành thuộc tính thánh, giảm<color=#47afee>%s%%</color>Thiệt hại do quái vật thuộc tính thánh gây ra.",
    ["BuffDes_551600501"]="TRONG<color=#44afee>Nghệ thuật bí mật · Angel Strike</color>Trạng thái, sát thương lên quỷ và sinh vật xác sống được tăng lên trong thời gian hiệu ứng.<color=#47afee>%s%%</color>.",
    ["BuffDes_551600601"]="TRONG<color=#44afee>Bí thuật ·Kỹ thuật cầu nguyện</color>Trạng thái, miễn nhiễm với mọi trạng thái tiêu cực trong suốt thời gian hiệu lực.",
    ["BuffDes_55177301"]="Năng lượng mà chỉ robot mới có thể sử dụng. Có thể dùng để tiêu hao kỹ năng sau khi biến hình thành robot, tối đa 3 lớp.",
    ["BuffDes_55230306"]="Năng lượng Yixin quý giá nhưng cũng nguy hiểm! Hãy đến tháp pháo để phá hủy lá chắn của [Beth Wave] trong vòng 30 giây, nếu không nó sẽ nổ cực kỳ nghiêm trọng!",
    ["BuffDes_55230311"]="Bị Bethbo giam giữ trong viên pha lê (không thể di chuyển, sử dụng kỹ năng và đạo cụ, không thể hồi phục HP và SP), đồng thời chịu sát thương thực sự bằng 5% máu tối đa mỗi giây. Nó có thể được giải phóng khi bị va chạm bởi những người chơi khác.",
    ["BuffDes_55230314"]="Mỗi giây lấy 1% máu tối đa của bạn thành sát thương chuẩn, có thể cộng dồn. Cứ sau 5 lớp thu được, sẽ nhận được thêm một lớp [Armor Melting], kéo dài 20 giây.",
    ["BuffDes_55230316"]="Phòng thủ kép giảm 20%, có thể cộng dồn",
    ["BuffDes_552600301"]="TRONG<color=#44afee>Kỹ năng đóng thế·Đôi Thánh Quang</color>Trạng thái, hiệu ứng kéo dài mỗi giây đối với kẻ địch trong phạm vi 3 mét.<color=#44afee>%s%%</color>Sát thương thích ứng thuộc tính thánh.",
    ["BuffDes_553600201"]="TRONG<color=#44afee>Bí ẩn·Ánh sáng thiên thần</color>Trạng thái, thời gian hiệu ứng tăng lên<color=#44afee>%s</color>Chỉ ra để chống lại trạng thái tiêu cực.",
    ["BuffDes_553600301"]="TRONG<color=#44afee>Bí ẩn·Đôi Thánh Quang</color>Trạng thái, hiệu ứng kéo dài mỗi giây đối với kẻ địch trong phạm vi 3 mét.<color=#44afee>%s%%</color>Sát thương thích ứng thuộc tính thánh, sát thương gây ra cho cùng một mục tiêu tăng lên mỗi lần<color=#44afee>%s%%</color>.",
    ["BuffDes_553600401"]="TRONG<color=#44afee>Bí ẩn·Cuộc tấn công trừ tà chéo</color>Trạng thái, thời gian hiệu ứng giảm<color=#44afee>%s</color>Nhấp vào kháng trạng thái tiêu cực PVP.",
    ["BuffDes_55406302"]="Nhận được chúc phúc của người dân rắc đậu trừ ma, tăng 20% Vật Phòng",
    ["BuffDes_55406303"]="Nhận được chúc phúc của người dân rắc đậu trừ ma, tăng 20% Phép Phòng",
    ["BuffDes_55406304"]="Nhận được chúc phúc của người dân rắc đậu trừ ma, tăng 20% Vật Công",
    ["BuffDes_55406305"]="Nhận được chúc phúc của người dân rắc đậu trừ ma, tăng 20% Pháp Công",
    ["BuffDes_58030301"]="Hiệu ứng Trị Liệu nhận được giảm 50%",
    ["BuffDes_58030302"]="Mỗi giây nhận Pháp Thương Hệ Lửa của Người Thi Triển (20% Pháp Công) và kèm theo hiệu ứng giảm 50% hiệu ứng Trị Liệu nhận được.",
    ["BuffDes_60000032"]="Tăng <color=#44afee>%s%%</color> Giảm Sát Thương Cuối. Hiệu lực khi Bạn Đời tổ đội và ở trong tầm nhìn cùng map cùng kênh.",
    ["BuffDes_60000042"]="Tăng <color=#44afee>%s%%</color> EXP diệt quái nhận được. Hiệu lực khi Bạn Đời tổ đội và ở trong tầm nhìn cùng map cùng kênh.",
    ["BuffDes_60000052"]="Tăng <color=#44afee>%s%%</color> Zeny diệt quái nhận được. Hiệu lực khi Bạn Đời tổ đội và ở trong tầm nhìn cùng map cùng kênh.",
    ["BuffDes_6001"]="Chúc Phúc Sức Mạnh: Tăng 5% Buff Vật Thương. BUFF này chỉ hiệu lực trong Tháp Vô Tận, hiệu ứng BUFF có thể cộng dồn.",
    ["BuffDes_6002"]="Chúc Phúc Pháp Thuật: Tăng 5% Buff Pháp Thương. BUFF này chỉ hiệu lực trong Tháp Vô Tận, hiệu ứng BUFF có thể cộng dồn.",
    ["BuffDes_6003"]="Chúc Phúc Tốc Độ: Tăng 5% Tốc Chạy. BUFF này chỉ hiệu lực trong Tháp Vô Tận, hiệu ứng BUFF có thể cộng dồn.",
    ["BuffDes_6004"]="Chúc Phúc Thiên Sứ: Chống lại Nguyền Rủa của Deviling, tăng 5% lực hồi HP và MP. BUFF này chỉ hiệu lực trong Tháp Vô Tận, hiệu ứng BUFF có thể cộng dồn.",
    ["BuffDes_6005"]="Cấp trung bình của nhóm cứ cao hơn cấp quái vật lớp này 1 cấp, nhận được một lớp ban phúc của Angeling Cứ có một lớp ban phúc của Angeling, tăng 2% Buff Sát Thương",
    ["BuffDes_6006"]="Cấp trung bình của nhóm cứ cao hơn cấp quái vật lớp này 1 cấp, nhận được một lớp Nguyền Rủa của Deviling. Cứ có một lớp nguyền rủa của Deviling, giảm 2% Buff Sát Thương, 2% Giảm Sát Thương phải chịu",
    ["BuffDes_6007"]="Tháp Vô Tận bị Deviling nguyền rủa, lực hồi HP bản thân giảm 100%, không thể dùng thuốc.\nKhi cấp trung bình của đội thấp hơn cấp quái vật lớp này, thì sẽ chịu hiệu ứng nguyền rủa mạnh hơn và giảm khả năng hồi phục.",
    ["BuffDes_6008"]="Tháp Vô Tận bị Baphomet thiêu cháy, lực hồi HP bản thân giảm 100%, không thể dùng thuốc, khi cấp trung bình của đội thấp hơn cấp quái vật lớp này, thì sẽ chịu hiệu ứng nguyền rủa mạnh hơn và giảm khả năng hồi phục.",
    ["BuffDes_60103061"]="Giảm <color=#44afee>%s%%</color> hiệu ứng Vật Phòng Cuối của bản thân.",
    ["BuffDes_60103101"]="ST bản thân chịu từ thành viên đội Người Thi Triển Buff tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_60103121"]="Giảm <color=#44afee>%s%%</color> hiệu ứng Vật Phòng Cuối của bản thân.",
    ["BuffDes_60103161"]="Mỗi lớp hiệu ứng <color=#44afee>Thẩm Phán</color> sẽ khiến ST <color=#44afee>Thánh Thập Tự Thẩm Phán</color> gây ra tăng <color=#44afee>%s%%</color>. Khi cộng dồn đến <color=#44afee>6</color> lớp, mỗi lần Thánh Thập Tự Thẩm Phán có <color=#44afee>50%%</color> xác suất gây thêm Vật Thương Hệ Thánh bằng <color=#44afee>%s%%</color> x Vật Công lên mục tiêu.",
    ["BuffDes_60105081"]="ST phải chịu từ Người Thi Triển Buff tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_60105101"]="Tăng <color=#44afee>%s%%</color> Giảm Pháp Thương Cuối của bản thân.",
    ["BuffDes_60105121"]="Mỗi lớp khiến ST <color=#44afee>Hồng Liên Vương</color> gây ra tăng thêm <color=#44afee>%s%%</color>.",
    ["BuffDes_60105171"]="Tăng <color=#44afee>%s</color> điểm Tốc Chạy và miễn dịch trạng thái <color=#44afee>Giảm Tốc</color> và <color=#44afee>Định Thân</color>.",
    ["BuffDes_60105181"]="Mỗi lớp tăng thêm <color=#44afee>%s%%</color> phần trăm Tương Thích Tấn Công của bản thân.",
    ["BuffDes_60106011"]="Tăng <color=#44afee>%s%%</color> ST Bạo Kích kèm theo của bản thân.",
    ["BuffDes_60106021"]="Tăng <color=#44afee>%s%%</color> Bạo Kích Cuối của bản thân.",
    ["BuffDes_60106031"]="Tăng <color=#44afee>%s%%</color> Bạo Kích Cuối và <color=#44afee>%s%%</color> ST Bạo Kích kèm theo cho bản thân.",
    ["BuffDes_60106061"]="Cứ mỗi 50 điểm Nhanh Nhẹn của bản thân tăng thêm <color=#44afee>%s</color> điểm Vật Thương kèm theo và <color=#44afee>%s%%</color> Bạo Kích Cuối.",
    ["BuffDes_60106071"]="Tăng <color=#44afee>%s%%</color> ST Bạo Kích kèm theo và <color=#44afee>%s%%</color> Chính Xác Cuối.",
    ["BuffDes_60106091"]="Mỗi lớp tăng <color=#44afee>%s%%</color> Chính Xác Cuối và <color=#44afee>%s</color> điểm Vật Thương kèm theo cho bản thân.",
    ["BuffDes_60106101"]="ST do Đánh Thường gây ra tăng <color=#44afee>%s%%</color>, tiêu hao một lớp sau mỗi lần Đánh Thường gây ST.",
    ["BuffDes_60107041"]="Tăng <color=#44afee>%s%%</color> Xuyên Vật Phòng Cuối của bản thân.",
    ["BuffDes_60107091"]="Tăng <color=#44afee>%s</color> điểm Vật Thương kèm theo.",
    ["BuffDes_60107101"]="Tăng <color=#44afee>%s</color> điểm Vật Thương kèm theo và <color=#44afee>%s%%</color> Chính Xác Cuối của bản thân.",
    ["BuffDes_60107131"]="Tăng <color=#44afee>%s%%</color> Giảm ST Cuối và <color=#44afee>2</color> điểm Tốc Chạy của bản thân.",
    ["BuffDes_60107141"]="Tăng thêm <color=#44afee>%s%%</color> phần trăm Vật Công của bản thân.",
    ["BuffDes_60107161"]="Mỗi lớp Thịnh Nộ tăng <color=#44afee>%s%%</color> Xuyên Vật Phòng Cuối của bản thân.",
    ["BuffDes_6011"]="Mỗi cấp chúc phúc tăng 3% HP Max và Giảm DMG",
    ["BuffDes_6012"]="Mỗi cấp chúc phúc tăng 20% lượng nhận Đá Tháp",
    ["BuffDes_6013"]="Mỗi cấp chúc phúc tăng 10% xác suất nhận phẩm chất chúc phúc lần sau",
    ["BuffDes_6014"]="Khi mỗi cấp chúc phúc tăng 2% tỉ lệ tử vong sẽ có xác suất kích hoạt hiệu ứng Bất Tử, trong 3s miễn dịch với tử vong, HP Min bằng 1, tăng 100% tốc chạy, 100% hút HP",
    ["BuffDes_61031010"]="Giới hạn giờ tăng xác suất thăng cấp Yểm Bùa ở chỗ Lil' Kitty.",
    ["BuffDes_6104"]="Ở trạng thái <color=#44afee>Kyrie Eleison-Ca Tụng</color>, trong thời gian duy trì hiệu ứng sẽ dùng khiên phòng thủ để chống đỡ sát thương, khiên phòng thủ tối đa chống đỡ được <color=#7ACEFF>2</color> lần sát thương hoặc lượng sát thương bằng <color=#7ACEFF>10%</color> HP tối đa, một trong hai vượt quá giới hạn sẽ mất khiên.",
    ["BuffDes_6106"]="Ở trạng thái <color=#44afee>Khát Máu</color>, nhận được hiệu ứng <color=#44afee>100%</color> hút HP và <color=#44afee>100%</color> tốc chạy",
    ["BuffDes_6110103"]="Vào trạng thái <color=#44afee>Cuồng Kích II</color> gây trạng thái giảm phòng, trong thời gian duy trì hiệu ứng giảm hiệu ứng Vật Phòng Cuối <color=#44afee>%s%%</color>, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_6110105"]="Vào trạng thái <color=#44afee>Bá Thể I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Phản Đòn Vật Lý và <color=#44afee>%s%%</color> Phản Đòn Pháp Thuật, hết Bá Thể sẽ hết hiệu ứng.",
    ["BuffDes_6110107"]="Vào trạng thái <color=#44afee>Bá Thể II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Phản Đòn Vật Lý và <color=#44afee>%s%%</color> Phản Đòn Pháp Thuật, và tăng <color=#44afee>%s%%</color> giảm Vật Thương Cuối PVP và <color=#44afee>%s%%</color> giảm Pháp Thương Cuối PVP, hết hiệu lực sau khi xóa Bá Thể.",
    ["BuffDes_6110109"]="Vào trạng thái <color=#44afee>Cuồng Nộ I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Buff Trị Liệu nhận.",
    ["BuffDes_6110110"]="Vào trạng thái <color=#44afee>Thắp Sáng Sinh Mệnh I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> HP Max.",
    ["BuffDes_6110111"]="Vào trạng thái <color=#44afee>Cuồng Nộ II</color>, trong thời gian duy trì hiệu ứng, tăng <color=#44afee>%s%%</color> Buff Trị Liệu nhận, đồng thời tăng <color=#44afee>%s%%</color> Hút Máu Vật Lý.",
    ["BuffDes_6110112"]="Ở trạng thái <color=#44afee>Thắp Sáng Sinh Mệnh II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> HP Max, đồng thời tăng cho bản thân <color=#44afee>%s</color> điểm Giảm Trạng Thái Debuff PVP và <color=#44afee>%s</color> điểm Kháng Trạng Thái Debuff PVP.",
    ["BuffDes_61103161"]="Khi ở trạng thái <color=#44afee>Trang Bị Shadow-Khiên Thần Phù Văn</color>, trong thời gian duy trì hiệu ứng sẽ tăng cho bản thân <color=#44afee>%s%%</color> Giảm Vật Thương PVP Cuối và Giảm Pháp Thương PVP Cuối.",
    ["BuffDes_61103541"]="Ở trạng thái <color=#FFA500>Nện Khiên II</color>, giảm <color=#FFA500>%s%%</color> Kháng Choáng và <color=#FFA500>%s</color> điểm Kháng Trạng Thái Debuff PVP của bản thân.",
    ["BuffDes_61103571"]="Ở trạng thái <color=#FFA500>Khiên Phản Kích II</color>, giảm <color=#FFA500>%s</color> điểm Giảm Trạng Thái Debuff PVP của bản thân.",
    ["BuffDes_61103591"]="Ở trạng thái <color=#FFA500>Khiên Ánh Sáng I</color>, giảm <color=#FFA500>%s%%</color> sát thương vật lý tầm xa bản thân phải chịu.",
    ["BuffDes_61103601"]="Ở trạng thái <color=#FFA500>Đòn Đánh Mặt Đất I</color>, tăng <color=#FFA500>%s%%</color> Vật Thương Cuối Kèm.",
    ["BuffDes_61103611"]="Ở trạng thái <color=#FFA500>Khiên Ánh Sáng II</color>, giảm <color=#FFA500>%s%%</color> sát thương vật lý tầm xa bản thân phải chịu, đồng thời <color=#FFA500>%s%%</color> sát thương bản thân phải chịu chuyển thành trị liệu người thi triển.",
    ["BuffDes_61103621"]="Ở trạng thái <color=#FFA500>Đòn Đánh Mặt Đất II</color>, tăng <color=#FFA500>%s%%</color> Vật Thương Cuối PVP kèm theo của bản thân.",
    ["BuffDes_61103651"]="Ở trạng thái <color=#FFA500>Hy Sinh</color>, tăng <color=#FFA500>%s%%</color> Giảm Sát Thương Cuối.",
    ["BuffDes_61103661"]="Ở trạng thái <color=#FFA500>Vua Bảo Vệ</color>, tăng <color=#FFA500>%s%%</color> Giảm Vật Thương Cuối PVP của bản thân.",
    ["BuffDes_6111"]="Mỗi cấp chúc phúc hy sinh 3% HP Max tăng 1% Buff Sát Thương",
    ["BuffDes_6112"]="Mục tiêu gây sát thương cho bản thân mỗi cấp chúc phúc có 1% xác suất gây 1 lớp hiệu ứng Trúng Độc, duy trì 5s    ",
    ["BuffDes_6113"]="Mỗi cấp chúc phúc tăng 3% chống trạng thái bất thường cơ bản",
    ["BuffDes_6114"]="Khi đánh thường mỗi cấp chúc phúc sẽ tăng 1% tỉ lệ thi triển Bức Tường An Toàn, tất cả thành viên trong khu vực miễn dịch ST vật lý cận chiến, duy trì 5s, chống đỡ tối đa 3 lần",
    ["BuffDes_6121"]="Hy sinh 3% HP Max tăng 2% Buff Sát Thương",
    ["BuffDes_6122"]="Mục tiêu gây sát thương cho bản thân mỗi cấp chúc phúc có 3% xác suất gây 2 lớp hiệu ứng Trúng Độc, duy trì 5s",
    ["BuffDes_6123"]="Mỗi cấp chúc phúc tăng 5% chống trạng thái bất thường cơ bản",
    ["BuffDes_6124"]="Khi đánh thường mỗi cấp chúc phúc sẽ tăng 1.2% tỉ lệ thi triển Bức Tường An Toàn, tất cả thành viên trong khu vực miễn dịch ST vật lý cận chiến, duy trì 5s, chống đỡ tối đa 3 lần",
    ["BuffDes_6130101"]="Vào trạng thái <color=#44afee>Ý Chí Chiến Đấu I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Vật Thương Cuối kèm theo, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_6130102"]="Vào trạng thái <color=#44afee>Tăng Tốc Kiếm I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Tốc Đánh Cuối.",
    ["BuffDes_6130103"]="Vào trạng thái <color=#44afee>Ý Chí Chiến Đấu II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Vật Thương Cuối PVP kèm theo, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_6130104"]="Ở trạng thái <color=#44afee>Tăng Tốc Kiếm II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Hút Máu Vật Lý và <color=#44afee>%s</color> điểm Kháng Trạng Thái Debuff PVP.",
    ["BuffDes_6130105"]="Vào trạng thái <color=#44afee>Kiếm Linh Khí I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Bạo Kích Cuối và <color=#44afee>%s%%</color> Chính Xác Cuối.",
    ["BuffDes_6130107"]="Vào trạng thái <color=#44afee>Kiếm Linh Khí II</color>, trong thời gian duy trì hiệu ứng, tăng <color=#44afee>%s%%</color> Sát Thương Bạo Kích kèm theo và <color=#44afee>%s%%</color> Chính Xác Cuối.",
    ["BuffDes_6130110"]="Vào trạng thái <color=#44afee>Dồn Sát Thương I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Vật Thương Cuối kèm theo.",
    ["BuffDes_6130112"]="Ở trạng thái <color=#44afee>Dồn Sát Thương II</color>, trong thời gian duy trì hiệu ứng, tăng <color=#44afee>%s%%</color> Vật Thương Cuối PVP kèm theo và Giảm Vật Phòng Cuối PVP, <color=#44afee>%s%%</color> Giảm Hiệu Ứng Debuff PVP.",
    ["BuffDes_6130302"]="Vào trạng thái <color=#44afee>Đâm Liên Tiếp I</color> gây trạng thái giảm thủ, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Giảm Vật Thương Cuối.",
    ["BuffDes_6130303"]="Vào trạng thái <color=#44afee>Giáo Xuyên Kích II</color> gây trạng thái hồi phục chậm, trong thời gian duy trì hiệu ứng, hiệu quả trị liệu giảm <color=#44afee>%s%%</color> (bao gồm hiệu ứng hút Máu).",
    ["BuffDes_6130304"]="Vào trạng thái <color=#44afee>Đâm Liên Tiếp II</color> gây trạng thái giảm thủ, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Giảm Vật Thương PVP cuối.",
    ["BuffDes_6130306"]="Vào trạng thái <color=#44afee>Đâm Xoắn Ốc I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Vật Thương Cuối kèm theo, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_6130307"]="Vào trạng thái <color=#44afee>Ném Giáo II</color> gây trạng thái giảm phòng, trong thời gian duy trì hiệu ứng hiệu ứng vật phòng cuối giảm <color=#44afee>%s%%</color>.",
    ["BuffDes_6130308"]="Vào trạng thái <color=#44afee>Đâm Xoắn Ốc II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Vật Thương Cuối PVP kèm theo, tối đa cộng dồn <color=#44afee>4</color> lớp.",
    ["BuffDes_61303161"]="Ở trạng thái <color=#44afee>Lửa Tối</color>, mỗi lớp tăng <color=#44afee>%s%%</color> Chính Xác Cuối, <color=#44afee>%s%%</color> Bạo Kích Cuối và <color=#44afee>%s%%</color> Vật Thương Cuối PVP kèm theo.",
    ["BuffDes_61303162"]="Ở trạng thái <color=#44afee>Kiếm Trận Lửa</color>, đánh thường trúng mục tiêu trong thời gian duy trì sẽ cộng dồn một lớp hiệu ứng <color=#44afee>Lửa Tối</color> cho thành viên đội trong vòng <color=#44afee>30</color>m. Mỗi lớp <color=#44afee>Lửa Tối</color> tăng <color=#44afee>%s%%</color> Chính Xác Cuối, <color=#44afee>%s%%</color> Bạo Kích Cuối và <color=#44afee>%s%%</color> Vật Thương Cuối PVP Kèm, cộng dồn tối đa <color=#44afee>12</color> lớp.",
    ["BuffDes_61303511"]="Ở trạng thái <color=#FFA500>Đòn Chém Lốc Xoáy I</color>, mỗi lớp tăng <color=#FFA500>%s%%</color> Vật Thương Cuối Kèm.",
    ["BuffDes_61303521"]="Ở trạng thái <color=#FFA500>Tăng Tốc Vũ Khí I</color>, tăng <color=#FFA500>%s%%</color> Tốc Đánh Cuối.",
    ["BuffDes_61303531"]="Ở trạng thái <color=#FFA500>Đòn Chém Lốc Xoáy II</color>, mỗi lớp tăng <color=#FFA500>%s%%</color> Vật Thương Cuối PVP Kèm.",
    ["BuffDes_61303532"]="Giảm Vật Thương Cuối PVP của bản thân tăng <color=#44afee>%s%%</color>,",
    ["BuffDes_61303541"]="Ở trạng thái <color=#FFA500>Tăng Tốc Vũ Khí II</color>, tăng <color=#FFA500>%s%%</color> Hút Máu Vật Lý.",
    ["BuffDes_61303551"]="Ở trạng thái <color=#FFA500>Chiến Ý I</color>, tăng <color=#FFA500>%s%%</color> Bạo Kích Cuối và tăng <color=#FFA500>%s%%</color> Chính Xác Cuối.",
    ["BuffDes_61303561"]="Ở trạng thái <color=#FFA500>Liều Mình Tấn Công I</color>, tăng <color=#FFA500>%s%%</color> HP Max của bản thân.",
    ["BuffDes_61303571"]="Ở trạng thái <color=#FFA500>Chiến Ý II</color>, tăng <color=#FFA500>%s%%</color> Sát Thương Bạo Kích Kèm và tăng <color=#FFA500>%s%%</color> Chính Xác Cuối.",
    ["BuffDes_61303581"]="Ở trạng thái <color=#FFA500>Liều Mình Tấn Công II</color>, tăng <color=#FFA500>%s%%</color> HP Max của bản thân, đồng thời tăng <color=#FFA500>%s</color> điểm Giảm Trạng Thái Debuff PVP và Kháng Trạng Thái Debuff PVP của bản thân.",
    ["BuffDes_61303601"]="Ở trạng thái <color=#FFA500>Đòn Đánh Dũng Cảm I</color>, tăng <color=#FFA500>%s%%</color> hiệu ứng Vật Thương Cuối Kèm.",
    ["BuffDes_61303621"]="Ở trạng thái <color=#FFA500>Đòn Đánh Dũng Cảm II</color>, tăng <color=#FFA500>%s%%</color> hiệu ứng Vật Thương Cuối PVP Kèm.",
    ["BuffDes_61303631"]="Ở trạng thái <color=#FFA500>Chà Đạp</color>, khiến HP Max của bản thân tăng <color=#FFA500>%s%%</color>.",
    ["BuffDes_61303651"]="Ở trạng thái <color=#FFA500>Lời Thề Sinh Mệnh</color>, giảm <color=#FFA500>%s%%</color> Giảm Vật Thương Cuối của bản thân.",
    ["BuffDes_61303661"]="Ở trạng thái <color=#FFA500>Thánh Linh Cảm Nhận-Suy Yếu</color>, mỗi lớp giảm <color=#FFA500>%s%%</color> Vật Thương Cuối PVP Kèm của bản thân.",
    ["BuffDes_61303662"]="Ở trạng thái <color=#FFA500>Thánh Linh Cảm Nhận</color>, mỗi lớp tăng <color=#FFA500>%s%%</color> Giảm Vật Thương Cuối PVP của bản thân.",
    ["BuffDes_61305141"]="Thời gian CD tất cả kỹ năng của bản thân giảm <color=#44afee>1,5</color> giây.",
    ["BuffDes_61305531"]="Ở trạng thái <color=#FFA500>Thánh Thập Tự Tấn Công II</color>, giảm <color=#FFA500>%s%%</color> Xuyên Vật Phòng Cuối của bản thân.",
    ["BuffDes_61305541"]="Ở trạng thái <color=#FFA500>Thánh Thập Tự Thẩm Phán II</color>, giảm <color=#FFA500>%s%%</color> Tốc Chạy của bản thân.",
    ["BuffDes_61305571"]="Ở trạng thái <color=#FFA500>Uy Lực Thần Thánh II</color>, Kháng Trạng Thái Debuff của bản thân giảm <color=#FFA500>%s</color>.",
    ["BuffDes_61305581"]="Ở trạng thái <color=#FFA500>Súng Trận-Trăng Tròn II</color>, Kháng Trạng Thái Debuff PVP của bản thân giảm <color=#FFA500>%s</color>.",
    ["BuffDes_61305651"]="Ở trạng thái <color=#FFA500>Súng Trận-Thập Tự Máu</color>, giảm <color=#FFA500>%s%%</color> Kháng Đổ Máu của bản thân",
    ["BuffDes_6131"]="Hy sinh 3% HP Max tăng 3% Buff Sát Thương",
    ["BuffDes_6132"]="Mục tiêu gây sát thương cho bản thân mỗi cấp chúc phúc có 5% xác suất gây 3 lớp hiệu ứng Trúng Độc, duy trì 5s",
    ["BuffDes_6133"]="Mỗi cấp chúc phúc tăng 10% chống trạng thái bất thường cơ bản",
    ["BuffDes_6134"]="Khi đánh thường mỗi cấp chúc phúc sẽ tăng 1.5% tỉ lệ thi triển Bức Tường An Toàn, tất cả thành viên trong khu vực miễn dịch ST vật lý cận chiến, duy trì 5s, chống đỡ tối đa 3 lần",
    ["BuffDes_6199901"]="Vào trạng thái <color=#44afee>Hồi Phục Cấp Tốc</color>, thành viên đội đều nhận được hiệu ứng [Hồi Phục Cấp Tốc] này, trong thời gian duy trì hiệu ứng sẽ hồi phục <color=#44afee>4%%</color> HP Max, hiệu ứng này hiệu lực thêm cho bản thân.",
    ["BuffDes_6199902"]="Vào trạng thái <color=#44afee>Tim Thép</color>, thành viên đội đều nhận được hiệu ứng [Tim Thép] này, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Phản Đòn Vật Lý và <color=#44afee>%s%%</color> Phản Đòn Pháp Thuật.",
    ["BuffDes_6199903"]="Vào trạng thái <color=#44afee>Đòn Xung Phong</color>, trong thời gian duy trì hiệu ứng, mỗi lần dùng cộng dồn <color=#44afee>%s%%</color> PVP Vật Thương Cuối kèm theo cho bản thân, tối đa cộng dồn <color=#44afee>%s</color> lớp.",
    ["BuffDes_6199904"]="Vào trạng thái <color=#44afee>Tập Trung Tấn Công</color>, trong thời gian duy trì hiệu ứng thành viên đội miễn khống chế.",
    ["BuffDes_62001511"]="Ở trạng thái <color=#FFA500>Uy Danh I</color>, tăng <color=#FFA500>%s%%</color> HP Max của bản thân.",
    ["BuffDes_62001521"]="Ở trạng thái <color=#FFA500>Thuật Trị Liệu Thánh</color>, tăng <color=#FFA500>%s%%</color> Né Cuối, <color=#FFA500>%s%%</color> Kháng Bạo Cuối của bản thân.",
    ["BuffDes_62001541"]="Ở trạng thái <color=#FFA500>Uy Danh II</color>, tăng <color=#FFA500>%s%%</color> sát thương đánh thường của bản thân.",
    ["BuffDes_62001551"]="Ở trạng thái <color=#FFA500>Uy Danh I</color>, tăng <color=#FFA500>%s%%</color> Giảm Vật Thương Cuối của bản thân.",
    ["BuffDes_62001581"]="Ở trạng thái <color=#FFA500>Uy Danh II</color>, tăng <color=#FFA500>%s%%</color> Vật Thương Cuối Kèm của bản thân.",
    ["BuffDes_62001591"]="Ở trạng thái <color=#FFA500>Thuật Trị Liệu Thánh</color>, tăng <color=#FFA500>%s%%</color> Giảm Vật Thương Cuối PVP của bản thân.",
    ["BuffDes_6210304"]="Vào trạng thái <color=#44afee>Ánh Sáng Thiên Sứ II</color> gây trạng thái giảm phòng, trong thời gian duy trì hiệu ứng hiệu ứng giảm <color=#44afee>%s%%</color> hiệu ứng Pháp Phòng Cuối.",
    ["BuffDes_6210401"]="Vào trạng thái <color=#44afee>Thiên Sứ Ban Phúc I</color>, trong thời gian duy trì hiệu ứng tăng thêm cho bản thân <color=#44afee>%s%%</color> Tốc Đánh Cuối.",
    ["BuffDes_6210403"]="Vào trạng thái <color=#44afee>Thiên Sứ Ban Phúc II</color>, trong thời gian duy trì hiệu ứng tăng thêm cho bản thân <color=#44afee>%s%%</color> Tốc Đánh Cuối và <color=#44afee>%s%%</color> Vật Thương Cuối kèm theo.",
    ["BuffDes_6210405"]="Vào trạng thái <color=#44afee>Bài Ca May Mắn I</color>, trong thời gian duy trì hiệu ứng tăng thêm cho bản thân <color=#44afee>%s%%</color> Bạo Kích Cuối.",
    ["BuffDes_6210407"]="Vào trạng thái <color=#44afee>Bài Ca May Mắn II</color>, trong thời gian duy trì hiệu ứng, tăng <color=#44afee>%s%%</color> Bạo Kích Cuối và <color=#44afee>%s%%</color> Sát Thương Bạo Kích kèm theo.",
    ["BuffDes_62106161"]="Khi ở trạng thái <color=#44afee>Trang Bị Shadow-Búa Thánh Kêu Gọi</color>, trong thời gian duy trì hiệu ứng, mỗi lớp hiệu ứng Búa Thánh Kêu Gọi sẽ tăng cho bản thân <color=#44afee>%s%%</color> Vật Thương PVP Cuối kèm theo.",
    ["BuffDes_6210702"]="Vào trạng thái <color=#44afee>Ca Tụng Thánh Mẫu I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Pháp Thương Cuối kèm theo.",
    ["BuffDes_6210704"]="Vào trạng thái <color=#44afee>Ca Tụng Thánh Mẫu II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Pháp Thương Cuối PVP kèm theo.",
    ["BuffDes_6210705"]="Vào trạng thái <color=#44afee>Chướng Ngại Thiên Sứ I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> hiệu ứng Vật Phòng Cuối và <color=#44afee>%s%%</color> hiệu ứng Pháp Phòng Cuối.",
    ["BuffDes_6210706"]="Vào trạng thái <color=#44afee>Cầu Phúc Hiến Tế I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Xuyên Vật Phòng Cuối và <color=#44afee>%s%%</color> Xuyên Pháp Phòng Cuối.",
    ["BuffDes_6210707"]="Vào trạng thái <color=#44afee>Chướng Ngại Thiên Sứ II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Giảm Vật Thương Cuối và <color=#44afee>%s%%</color> Giảm Pháp Thương Cuối.",
    ["BuffDes_6210708"]="Vào trạng thái <color=#44afee>Cầu Phúc Hiến Tế II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Sát Thương Cuối tăng thêm và <color=#44afee>%s%%</color> Giảm Sát Thương Cuối.",
    ["BuffDes_6210710"]="Ở trạng thái <color=#44afee>Ánh Sáng Trị Liệu I</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s</color> điểm Giảm Trạng Thái Debuff và <color=#44afee>%s</color> điểm Kháng Trạng Thái Debuff.",
    ["BuffDes_6210712"]="Ở trạng thái <color=#44afee>Ánh Sáng Trị Liệu II</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s</color> điểm Giảm Trạng Thái Debuff PVP và <color=#44afee>%s</color> điểm Kháng Trạng Thái Debuff PVP.",
    ["BuffDes_62109161"]="Khi ở trạng thái <color=#44afee>Trang Bị Shadow-Thánh Linh Đến</color>, trong thời gian duy trì hiệu ứng sẽ tăng <color=#44afee>%s%%</color> Giảm Vật Thương PVP Cuối và Giảm Pháp Thương PVP Cuối.",
    ["BuffDes_6211"]="Mỗi cấp chúc phúc tăng 2% Tốc Chạy",
    ["BuffDes_6212"]="Khi thi triển kỹ năng, mỗi cấp chúc phúc có 1% xác suất làm mới ngay thời gian chờ kỹ năng hiện tại",
    ["BuffDes_6213"]="Mỗi cấp Chúc Phúc nâng cao 2% tỉ lệ bạo kích cuối và sát thương bạo kích kèm",
    ["BuffDes_6214"]="Cứ đánh bại một quái vật, mỗi cấp chúc phúc sẽ tăng 0.3% Buff Sát Thương, tăng N% Buff Thể Hình, được cộng dồn hiệu ứng Buff, hiệu ứng duy trì 3s, sau khi đánh bại quái vật sẽ cài lại thời gian duy trì",
    ["BuffDes_6221"]="Mỗi cấp chúc phúc tăng 3% Tốc Chạy",
    ["BuffDes_6222"]="Khi thi triển kỹ năng, mỗi cấp chúc phúc có 2% xác suất làm mới ngay kỹ năng hiện tại",
    ["BuffDes_6223"]="Mỗi cấp Chúc Phúc nâng cao 3% tỉ lệ bạo kích cuối và sát thương bạo kích kèm",
    ["BuffDes_6224"]="Cứ đánh bại một quái vật, mỗi cấp chúc phúc sẽ tăng 0.4% Buff Sát Thương, tăng N% Buff Thể Hình, được cộng dồn hiệu ứng Buff, hiệu ứng duy trì 3s, sau khi đánh bại quái vật sẽ cài lại thời gian duy trì, mỗi cấp chúc phúc tăng N% tốc đánh",
    ["BuffDes_6231"]="Mỗi cấp chúc phúc tăng 5% Tốc Chạy",
    ["BuffDes_6232"]="Khi thi triển kỹ năng, mỗi cấp chúc phúc có 3% xác suất làm mới ngay kỹ năng hiện tại",
    ["BuffDes_6233"]="Mỗi cấp Chúc Phúc nâng cao 5% tỉ lệ bạo kích cuối và sát thương bạo kích kèm",
    ["BuffDes_6234"]="Cứ đánh bại một quái vật, mỗi cấp chúc phúc sẽ tăng 0.5% Buff Sát Thương, tăng N% Buff Thể Hình, được cộng dồn hiệu ứng Buff, hiệu ứng duy trì 3s, sau khi đánh bại quái vật sẽ cài lại thời gian duy trì, mỗi cấp chúc phúc tăng N% tốc đánh",
    ["BuffDes_6299902"]="Vào trạng thái <color=#44afee>Làm Chậm</color> gây trạng thái hành động chậm chạp, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Tốc Đánh Cuối và <color=#44afee>%s%%</color> Cấp Tốc Cuối.",
    ["BuffDes_6299904"]="Vào trạng thái <color=#44afee>Chướng Ngại Sáng Tối</color>, trong thời gian duy trì hiệu ứng tăng <color=#44afee>%s%%</color> Sát Thương Cuối tăng thêm và <color=#44afee>%s%%</color> Giảm Sát Thương Cuối.",
    ["BuffDes_6310303"]="Vào trạng thái <color=#44afee>Thuật Sét Đánh II</color> gây giảm phòng ngự, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> hiệu ứng Vật Phòng Cuối và <color=#44afee>%s%%</color> hiệu ứng Pháp Phòng Cuối.",
    ["BuffDes_6310304"]="Vào trạng thái <color=#44afee>Mũi Tên Băng II</color> gây giảm công kích, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Vật Thương Cuối kèm và <color=#44afee>%s%%</color> Pháp Thương Cuối kèm theo.",
    ["BuffDes_63105151"]="Khi ở trạng thái <color=#44afee>Trang Bị Shadow-Bão Hỗn Loạn</color>, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Giảm Pháp Thương PVP Cuối.",
    ["BuffDes_63109051"]="Mỗi giây hồi phục cho bản thân <color=#44afee>%s%%</color> HP",
    ["BuffDes_63109052"]="Nhận được khiên, tổng cộng đỡ được lượng ST bằng <color=#44afee>%s%%</color> HP Max",
    ["BuffDes_63109071"]="Mỗi giây hứng chịu (Pháp Công người thi triển*<color=#44afee>%s%%</color>*Số lớp) Pháp Thương hệ lửa",
    ["BuffDes_63109081"]="Tăng cho bản thân <color=#44afee>%s%%</color> Giảm DMG Cuối và <color=#44afee>%s%%</color> Kháng Debuff PVP",
    ["BuffDes_63109082"]="Giảm <color=#44afee>%s%%</color> Kháng Choáng và <color=#44afee>%s%%</color> Kháng Debuff PVP cho bản thân",
    ["BuffDes_63109101"]="Tăng <color=#44afee>%s%%</color> Xuyên Pháp Phòng Cuối và <color=#44afee>%s%%</color> Pháp Thương Cuối kèm",
    ["BuffDes_63109111"]="Tăng cho bản thân <color=#44afee>%s%%</color> Giảm Vật Thương Cuối PVP và <color=#44afee>%s%%</color> Giảm Pháp Thương Cuối PVP, mỗi lần bản thân chịu ST tầm xa sẽ phản kích lại người tấn công gây Pháp Thương tầm xa hệ đất bằng Pháp Công bản thân*<color=#44afee>%s%%</color>, và có <color=#44afee>%s%%</color> tỉ lệ khiến mục tiêu choáng <color=#44afee>1</color>s",
    ["BuffDes_63109122"]="Tăng thêm <color=#44afee>2</color> Tốc Chạy, cứ <color=#44afee>5</color>s nếu bản thân chịu sát thương tích lũy vượt quá <color=#44afee>30%%</color> HP Max, sẽ hồi phục ngay <color=#44afee>%s%%</color> HP; trong thời gian duy trì mỗi lần đánh thường sẽ gây lên thêm mục tiêu Pháp Công*<color=#44afee>%s%%</color> Pháp Thương cận chiến hệ lửa",
    ["BuffDes_6311"]="Sau khi chịu sát thương, mỗi cấp chúc phúc có 1% xác suất hồi ngay 10% HP bị mất",
    ["BuffDes_6312"]="Mỗi cấp chúc phúc tăng 1% Phản Đòn Sát Thương",
    ["BuffDes_6313"]="Mỗi cấp chúc phúc có 1% ngăn sát thương cận chiến, 2% ngăn sát thương tầm xa",
    ["BuffDes_6314"]="Sau khi chịu sát thương, mỗi cấp chúc phúc tăng 1% tỉ lệ thi triển Ca Tụng, thêm hiệu ứng Kyrie Eleison cho tất cả thành viên tiểu đội, Kyrie Eleison tối đa chống đỡ được 2 lần sát thương, duy trì 3s, khi sát thương chống đỡ đạt 10% HP Max của người được lợi, khiên sẽ vô hiệu trước hạn",
    ["BuffDes_6321"]="Sau khi chịu sát thương, mỗi cấp chúc phúc có 1,5% xác suất hồi ngay 15% HP bị mất",
    ["BuffDes_6322"]="Mỗi cấp chúc phúc tăng 2% Phản Đòn Sát Thương",
    ["BuffDes_6323"]="Mỗi cấp chúc phúc có 2% ngăn sát thương cận chiến, 3% ngăn sát thương tầm xa",
    ["BuffDes_6324"]="Sau khi chịu sát thương, mỗi cấp chúc phúc tăng 1.5% tỉ lệ thi triển Ca Tụng, thêm hiệu ứng Kyrie Eleison cho tất cả thành viên tiểu đội, Kyrie Eleison tối đa chống đỡ được 2 lần sát thương, duy trì 3s, khi sát thương chống đỡ đạt 10% HP Max của người được lợi, khiên sẽ vô hiệu trước hạn",
    ["BuffDes_6330603"]="Vào trạng thái <color=#44afee>Thuật Tên Lửa II</color> gây trạng thái hồi phục chậm, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Buff Trị Liệu nhận.",
    ["BuffDes_6330604"]="Vào trạng thái <color=#44afee>Thuật Rạn Nứt II</color> gây trạng thái hành động chậm chạp, trong thời gian duy trì hiệu ứng giảm <color=#44afee>%s%%</color> Tốc Đánh Cuối và <color=#44afee>%s%%</color> Cấp Tốc Cuối.",
    ["BuffDes_63308501"]="Kháng Đất của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_63308502"]="Kháng Lửa của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_63308503"]="Kháng Nước của bản thân tăng <color=#44afee>%s%%</color>",
