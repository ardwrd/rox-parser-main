    ["ActualVoiceTips_1"]="Đang vào phòng chat thoại",
    ["ActualVoiceTips_10"]="Hủy cấm chat",
    ["ActualVoiceTips_11"]="Tắt tính năng ẩn tất cả các chat thoại trong thời gian thực và thử lại",
    ["ActualVoiceTips_12"]="Chat thoại thời gian thực đã được bật, tạm không thể chuyển sang chat các kênh khác",
    ["ActualVoiceTips_2"]="Bạn đã bị cấm chat",
    ["ActualVoiceTips_3"]="Vui lòng tắt toàn bộ thành viên cấm chat và thử lại",
    ["ActualVoiceTips_4"]="Đã vào phòng chat thoại",
    ["ActualVoiceTips_5"]="Vào chat thoại đội thất bại, vui lòng đợi tự động kết nối lại hoặc nhấn nút kết nối để thử lại",
    ["ActualVoiceTips_6"]="Mạng hiện không ổn định, vui lòng đợi để tự động kết nối lại với chat thoại hoặc bấm vào nút kết nối lại để thử lại",
    ["ActualVoiceTips_7"]="Chưa có quyền sử dụng microphone, không thể tham gia chat thoại thời gian thực",
    ["ActualVoiceTips_8"]="Chat thoại đội có lỗi chưa xác định: %s",
    ["ActualVoiceTips_9"]="Cấm chat",
    ["AddBlackTips"]="Đưa người chơi này vào list đen?",
    ["AddPoint_MaxLevel"]="Không thể vượt qua cấp lớn nhất của phiên bản hiện tại!",
    ["AddPoint_NotEnough"]="Điểm còn lại không đủ, không thể phân bổ theo phương án",
    ["AdvanceQuestGetTitleTips1"]="Đạt đến sẽ nhận Danh Hiệu %s ",
    ["AdvanceQuestGetTitleTips2"]="Nhận Danh Hiệu %s và %s",
    ["AdvanceQuestGetTitleTips3"]="Đạt thành tựu này sẽ nhận %s",
    ["AdvancedInheritedTips"]="Có tiêu hao <color=#CA2E0AFF>%s</color> Kim Cương để kế thừa thuốc tính không?",
    ["AdvancedPetTips_001"]="Trong quá trình kế thừa nâng cao,<color=#ff0000>bên phải</color>Quá trình phát triển của thú cưng sẽ được quyết định bởi<color=#ff0000>bên trái</color>vật nuôi được thừa kế, và<color=#ff0000>Xóa tiến trình thú cưng ở bên phải</color>.\n<color=#ff0000>Tài nguyên phát triển thú cưng ban đầu ở bên trái sẽ không được trả lại.</color>",
    ["AdvancedPetTips_003"]="Kế thừa cao cấp chỉ dành cho <color=#05fc06>Pet cùng Độ Hiếm</color>",
    ["AdvancedPetTips_004"]="Đặt trước",
    ["AdvancedPetTips_005"]="Loại Bồi Dưỡng",
    ["AdvancedPetTips_006"]="Có thể kế thừa không",
    ["AdvancedPetTips_007"]="Pet được kế thừa (Bên trái)",
    ["AdvancedPetTips_008"]="Pet được kế thừa (Bên phải)",
    ["AdvancedPetTips_009"]="sự thân mật của thú cưng",
    ["AdvancedPetTips_010"]="Cấp Sao Pet (Điểm Tư Chất)",
    ["AdvancedPetTips_011"]="Trình độ kỹ năng của thú cưng\nTrạng thái kích hoạt kỹ năng thú cưng",
    ["AdvancedPetTips_012"]="Đặc tính làm sạch tủy của thú cưng",
    ["AdvancedPetTips_013"]="Huy chương Chất lượng Thú cưng",
    ["AdvancedPetTips_014"]="Tinh Lực Pet",
    ["AdvancedPetTips_015"]="√",
    ["AdvancedPetTips_016"]="×",
    ["AdvancedPetTips_017"]="Có được sự thân mật của thú cưng được thừa kế",
    ["AdvancedPetTips_018"]="Nhận được xếp hạng sao và giá trị tiêu chuẩn của thú cưng được thừa kế",
    ["AdvancedPetTips_019"]="Có được trạng thái kích hoạt kỹ năng và cấp độ kỹ năng của thú cưng được kế thừa\n(Nhận ngẫu nhiên bất kỳ kỹ năng nào từ thư viện kỹ năng thú cưng hiện tại)",
    ["AdvancedPetTips_020"]="Chỉ định ngẫu nhiên",
    ["AdvancedPetTips_021"]="Không thể kế thừa",
    ["AdvancedPetTips_022"]="Duy trì",
    ["AdvancedPetTips_023"]="khởi tạo",
    ["AdventureQuestButtonTips"]="Cấp Base hiện chưa đạt yêu cầu kiểm tra Thám Hiểm, không thể trả lời câu hỏi",
    ["AdventureQuestTips_1"]="Kiểm tra thám hiểm Lv.%s",
    ["AdventureQuestTips_10"]="Nhà Thám Hiểm thân mến, thật đáng tiếc",
    ["AdventureQuestTips_11"]="Xong hết rồi! Mau nộp bài và xem kết quả!",
    ["AdventureQuestTips_2"]="Tổng %s câu hỏi, phải trả lời đúng hết mới qua được bài kiểm tra đấy\nKhi gặp câu không biết, hãy vào <color=#CA2E0AFF>Sổ Tay Học Viện</color> để <color=#CA2E0AFF>xem tài liệu</color> nhé\nTrong lúc trả lời mà thoát ra, thì tiến độ trả lời sẽ được lưu lại",
    ["AdventureQuestTips_3"]="Cấp Thám Hiểm đạt Lv.%s",
    ["AdventureQuestTips_4"]="Tổng cộng trả lời sai %s câu",
    ["AdventureQuestTips_5"]="Đã trả lời (%s/%s)",
    ["AdventureQuestTips_6"]="Xem câu sai",
    ["AdventureQuestTips_7"]="Kiểm tra lại",
    ["AdventureQuestTips_8"]="Bạn đã hiểu hết về RO chưa? \n Hãy thử thách chính mình nhé?",
    ["AdventureQuestTips_9"]="Nhà Thám Hiểm thân mến, chúc mừng bạn",
    ["AdventureQuestion10_1"]="Hiệu ứng nào dưới đây do thời tiết đặc biệt là nắng nóng mang lại?",
    ["AdventureQuestion10_10"]="Phần thưởng mở khóa cho danh hiệu \"Hành Trình Theo Đuổi Ước Mơ\" là gì?",
    ["AdventureQuestion10_10A"]="A. HP Max +10",
    ["AdventureQuestion10_10B"]="B. SP Max +10",
    ["AdventureQuestion10_10C"]="C. SP Max +5",
    ["AdventureQuestion10_10D"]="D. Sức Mạnh +5",
    ["AdventureQuestion10_11"]="Hoàn thành sự kiện nào sau đây không thể nhận được phần thưởng Độ sôi nổi?",
    ["AdventureQuestion10_11A"]="A. Ủy Thác Thương Hội",
    ["AdventureQuestion10_11B"]="B. Đố Vui OX",
    ["AdventureQuestion10_11C"]="C. Tháp Vô Tận",
    ["AdventureQuestion10_11D"]="D. Đơn Hội",
    ["AdventureQuestion10_12"]="Phương pháp tổ đội nào sau đây sẽ mang lại buff EXP cao nhất cho quái vật có chênh lệch cấp độ cơ bản nhỏ hơn 3 khi treo máy?",
    ["AdventureQuestion10_12A"]="A. Đội 3 người 3 nghề",
    ["AdventureQuestion10_12B"]="B. Đội 5 người 1 nghề",
    ["AdventureQuestion10_12C"]="C. Đội 4 người 2 nghề",
    ["AdventureQuestion10_12D"]="D. Đội 5 người 2 nghề",
    ["AdventureQuestion10_13"]="Đạo cụ nào sau đây không thể nhận được thông qua Đơn Hội?",
    ["AdventureQuestion10_13A"]="A. Pha Lê",
    ["AdventureQuestion10_13B"]="B. Cống Hiến Công Hội",
    ["AdventureQuestion10_13C"]="C. Zeny",
    ["AdventureQuestion10_13D"]="D. Quỹ Công Hội",
    ["AdventureQuestion10_14"]="Quái vật \"Sứa\" có thể được tìm thấy ở những địa điểm nào sau đây?",
    ["AdventureQuestion10_14A"]="A. Tháp Chuông B2",
    ["AdventureQuestion10_14B"]="B. Hang Đáy Biển",
    ["AdventureQuestion10_14C"]="C. Núi Mjolnir",
    ["AdventureQuestion10_14D"]="D. Rừng Goblin",
    ["AdventureQuestion10_15"]="Quái vật nào sau đây không phải là MVP?",
    ["AdventureQuestion10_15A"]="A. Ghosting",
    ["AdventureQuestion10_15B"]="B. Ong Chúa",
    ["AdventureQuestion10_15C"]="C. Tử Linh",
    ["AdventureQuestion10_15D"]="D. Morroc",
    ["AdventureQuestion10_16"]="EXP Nghề không thể nhận được bằng cách nào sau đây?",
    ["AdventureQuestion10_16A"]="A. Bảng Ủy Thác",
    ["AdventureQuestion10_16B"]="B. Phó Bản Ngày",
    ["AdventureQuestion10_16C"]="C. Trò Chơi Tửu Quán",
    ["AdventureQuestion10_16D"]="D. Đố Vui OX",
    ["AdventureQuestion10_17"]="Có thể nhận được loại Xu nào dưới đây bằng cách hoàn thành Ủy Thác Thương Hội?",
    ["AdventureQuestion10_17A"]="A. Xu Công Hội",
    ["AdventureQuestion10_17B"]="B. Pha Lê",
    ["AdventureQuestion10_17C"]="C. Xu Pet",
    ["AdventureQuestion10_17D"]="B. Xu Valkyrie",
    ["AdventureQuestion10_18"]="Cách nào dưới đây có thể tăng độ thân mật của Pet?",
    ["AdventureQuestion10_18A"]="A. Cho ăn",
    ["AdventureQuestion10_18B"]="B. Tương tác",
    ["AdventureQuestion10_18C"]="C. Ra trận",
    ["AdventureQuestion10_18D"]="D. Bồi dưỡng",
    ["AdventureQuestion10_19"]="Debuff sau đây sẽ không ngăn nhân vật di chuyển, tấn công hoặc thi triển kỹ năng trong thời gian duy trì?",
    ["AdventureQuestion10_19A"]="A. Choáng",
    ["AdventureQuestion10_19B"]="B. Nguyền Rủa",
    ["AdventureQuestion10_19C"]="C. Ngủ",
    ["AdventureQuestion10_19D"]="D. Đóng Băng",
    ["AdventureQuestion10_1A"]="A. Hồi HP -10%",
    ["AdventureQuestion10_1B"]="B. Cấp Tốc Cuối +10%",
    ["AdventureQuestion10_1C"]="C. Hồi SP +10%",
    ["AdventureQuestion10_1D"]="D. Sát Thương Hệ Gió gây ra +5%",
    ["AdventureQuestion10_2"]="Trang Bị phẩm nào sau đây không thể nhận được bằng Máy Quay Trang Bị?",
    ["AdventureQuestion10_20"]="Hệ số sử dụng Công Kích Lửa tấn công quái vật thường hệ nước là bao nhiêu?",
    ["AdventureQuestion10_20A"]="A. 150%",
    ["AdventureQuestion10_20B"]="B. 100%",
    ["AdventureQuestion10_20C"]="C. 75%",
    ["AdventureQuestion10_20D"]="D. 90%",
    ["AdventureQuestion10_21"]="Thay thế kiểu tóc cần nguyên liệu nào dưới đây?",
    ["AdventureQuestion10_21A"]="A. Phiếu Làm Tóc",
    ["AdventureQuestion10_21B"]="B. Phiếu Làm Mặt",
    ["AdventureQuestion10_21C"]="C. Kim Loại Cường Hóa Phòng Cụ",
    ["AdventureQuestion10_21D"]="D. Elunium Chúc Phúc",
    ["AdventureQuestion10_22"]="MVP/Minis nào dưới đây sẽ không xuất hiện trong Hành Lang Vực Sâu?",
    ["AdventureQuestion10_22A"]="A. Ong Chúa Vực Sâu",
    ["AdventureQuestion10_22B"]="B. Tù Trưởng Orc Vực Sâu",
    ["AdventureQuestion10_22C"]="C. Pharaoh Vực Sâu",
    ["AdventureQuestion10_22D"]="D. Mastering",
    ["AdventureQuestion10_23"]="Khi tìm lại phần thưởng, có thể tìm lại tối đa phần thưởng lối chơi chưa hoàn thành trong mấy ngày trước đó?",
    ["AdventureQuestion10_23A"]="A. 3 ngày",
