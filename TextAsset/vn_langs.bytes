    ["aside19390201"]="Rời khỏi... kẻ xâm nhập...",
    ["aside19390301"]="Xin chào, vị khách đến từ Dị Giới.",
    ["aside19390401"]="Bây giờ, hãy mời những vị khách của chúng ta cố gắng nhớ lại hình dạng của nó...",
    ["aside19390501"]="Thành công rồi!",
