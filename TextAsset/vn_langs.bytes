    ["ui_GVE_001"]="Độ Khó",
    ["ui_GVGNewRules_1"]="● Quy tắc tham gia GVG Chiến Trường Vương Thành:\n\u{3000}\u{3000}Công Hội đủ điều kiện tham gia vào Chiến Trường Vương Thành thông qua điểm dịch chuyển Cờ Chiến Vương Thành. Mỗi chiến trường sẽ gặp nhiều nhất 3 Công Hội có thực lực ngang nhau để tranh tài xếp hạng. Các phe giữa các Công Hội độc lập với nhau, mỗi Công Hội có thể vào tối đa 70 người. Khi điểm dịch chuyển xuất hiện sẽ có giai đoạn chuẩn bị 15 phút để vào Chiến Trường Vương Thành chuẩn bị, giai đoạn chiến đấu kéo dài 45 phút.\n● Quy tắc chiến thắng trong Vương Thành:\n\u{3000}\u{3000}Nhà Thám Hiểm cần phá vỡ Kim Loại trong trận hoặc Kim Loại Rực Rỡ của các Công Hội khác càng nhiều càng tốt, sau đó biến chúng thành Năng Lượng của phe mình. Kim Loại càng lớn thì càng tốn nhiều Năng Lượng, càng nhiều Năng Lượng thì càng nhận được nhiều điểm trên một đơn vị thời gian. Hết thời gian chiến đấu sẽ xếp hạng theo điểm từ cao xuống thấp, cùng điểm sẽ xếp theo thứ tự thời gian.\n\u{3000}\u{3000}Công Hội nào đạt 3000 điểm trước sẽ giành chiến thắng và tổng kết.\n\u{3000}\u{3000}Tử trận liên tiếp trong chiến trường cũng bị ảnh hưởng của hình phạt debuff tương tự như GVG.\n● Thông tin Kim Loại:\n\u{3000}\u{3000}Kim Loại Rực Rỡ - Năng Lượng 1 - HP 2000\n\u{3000}\u{3000}Kim Loại Hoàn Hảo - Năng Lượng 2 - HP 4000\n\u{3000}\u{3000}Kim Loại Óng Ánh - Năng Lượng 3 - HP 6000\n\u{3000}\u{3000}Kim Loại Mộng Ảo - Năng Lượng 5 - HP 10000\nChiến đấu tới giây phút cuối cùng vì danh dự của Công Hội, quyết định Công Hội đứng đầu thực sự!",
    ["ui_GVGRules_001"]="Hướng dẫn sự kiện GVG",
    ["ui_GVGRules_002"]="Giới thiệu sự kiện",
    ["ui_GVGRules_003"]="Quy tắc tham gia",
    ["ui_GVGRules_004"]="Thời gian mở: <color=#338dc3>%s</color> thứ Bảy hàng tuần mở Công Hội Chiến",
    ["ui_GVGRules_005"]="Tư cách tham gia: Nhà Thám Hiểm có Cấp Base ≥<color=#338dc3>Lv.35</color> và đã vào công hội",
    ["ui_GVGRules_006"]="Cổng vào",
    ["ui_GVGRules_007"]="Sự kiện lần này mở <color=#338dc3>8</color> thành trì cứ điểm để các Nhà Thám Hiểm tranh đoạt",
    ["ui_GVGRules_008"]="Nhà Thám Hiểm có thể đến cổng vào nhanh thông qua tính năng [Chỉ Đường] trong chiến báo GVG.",
    ["ui_GVGRules_009"]="Sau khi rời Công Hội, trong 7 ngày không thể tham gia chiến trường GVG.",
    ["ui_GVGRules_010"]="Giới thiệu tính năng",
    ["ui_GVGRules_011"]="Hỡi những Nhà Thám Hiểm của Midgard, ánh sáng của Pha Lê Đẹp đang chiếu rọi, thời khắc thể hiện bản lĩnh đã đến! Hãy cầm vũ khí lên tranh đoạt Pha Lê, chiếm lĩnh cứ điểm! Hãy cùng đồng đội trong công hội chiến đấu vì vinh quang!",
    ["ui_GVGRules_012"]="Công hội đầu tiên phá vỡ Pha Lê Đẹp trong cứ điểm sẽ nhận được <color=#338dc3>quyền phòng thủ</color> cứ điểm",
    ["ui_GVGRules_013"]="Chiến trường kết thúc, công hội có <color=#338dc3>quyền phòng thủ</color> cứ điểm sẽ <color=#338dc3>giành chiến thắng</color> và nhận <color=#338dc3>quyền sở hữu</color> cứ điểm.",
    ["ui_GVGRules_014"]="Chế độ chiến trường",
    ["ui_GVGRules_015"]="<color=#338dc3>Chế độ Công Thành Chiến</color>",
    ["ui_GVGRules_016"]="Khi lần đầu mở GVG, cứ điểm bị quái chiếm lĩnh sẽ nằm ở trung tâm.",
    ["ui_GVGRules_017"]="Công hội đầu tiên vượt được quái và phá vỡ Pha Lê Đẹp sẽ nhận được <color=#338dc3>quyền phòng thủ</color> cứ điểm và bước vào chế độ <color=#338dc3>Tranh Đoạt Chiến</color>",
    ["ui_GVGRules_018"]="<color=#338dc3>Chế độ Tranh Đoạt Chiến</color>",
    ["ui_GVGRules_019"]="Chế độ sẽ duy trì trong <color=#338dc3>30</color> phút và chia 2 phe công và thủ",
    ["ui_GVGRules_020"]="Công hội nắm <color=#338dc3>quyền phòng thủ</color> cứ điểm sẽ là phe thủ, bên còn lại là phe công.",
    ["ui_GVGRules_021"]="Phe công: Công Hội phá vỡ Pha Lê Đẹp trong <color=#338dc3>30</color> phút sẽ nhận <color=#338dc3>quyền phòng thủ</color> cứ điểm, thời gian Tranh Đoạt Chiến <color=#338dc3>được cài lại</color>",
    ["ui_GVGRules_022"]="Phe thủ: Bảo vệ Pha Lê Đẹp không bị phá vỡ trong vòng <color=#338dc3>30</color> phút sẽ <color=#338dc3>chiến thắng</color> chiếm lĩnh cứ điểm, cổng cứ điểm sẽ đóng",
    ["ui_GVGRules_023"]="<color=#338dc3>Chế độ Thủ Thành</color>",
    ["ui_GVGRules_024"]="Khi trận GVG tiếp theo mở, công hội chiếm lĩnh cứ điểm sẽ trở thành phe thủ.",
    ["ui_GVGRules_025"]="Chế độ duy trì trong <color=#338dc3>45 phút</color> và chia 2 phe công và thủ",
    ["ui_GVGRules_026"]="Phe công: Công hội phá vỡ Pha Lê Đẹp trong <color=#338dc3>45</color> phút sẽ nhận <color=#338dc3>quyền phòng thủ</color> cứ điểm, thời gian Tranh Đoạt Chiến <color=#338dc3>được cài lại</color>.",
    ["ui_GVGRules_027"]="Phe thủ: Bảo vệ Pha Lê Đẹp không bị phá vỡ trong vòng <color=#338dc3>45</color> phút sẽ <color=#338dc3>chiến thắng</color> chiếm lĩnh cứ điểm, cổng cứ điểm sẽ đóng.",
    ["ui_GVGRules_028"]="Chiến thắng",
    ["ui_GVGRules_029"]="Khi sự kiện kết thúc, sẽ tiến hành phân định quyền sở hữu dựa theo chế độ chiến trường",
    ["ui_GVGRules_030"]="Chế độ Bị Chiếm Lĩnh: Phe chiếm thành sẽ nhận quyền sở hữu thành",
    ["ui_GVGRules_031"]="Chế độ Tranh Đoạt Chiến: Công hội phòng thủ thành sẽ nhận quyền sở hữu thành",
    ["ui_GVGRules_032"]="Chế độ Phòng Thủ Chiến: Công hội phòng thủ thành sẽ nhận quyền sở hữu thành",
    ["ui_GVGRules_033"]="Chế độ Công Thành Chiến: Duy trì trạng thái trung lập",
    ["ui_GVGRules_034"]="Giới hạn sự kiện",
    ["ui_GVGRules_035"]="Trong chiến trường không thể dùng Cánh Ruồi và Cánh Bướm",
    ["ui_GVGRules_036"]="Trong chiến trường không thể dùng Quả Yggdrasil/Hạt Yggdrasil/Thuốc PVE",
    ["ui_GVGRules_037"]="Trong chiến trường, liên tục tử trận 2 lần trong vòng 60 giây sẽ bị trừng phạt, khi hồi sinh sẽ bị suy yếu",
    ["ui_GVGRules_038"]="Cho phép chiếm nhiều cứ điểm tại các khu khác nhau, cùng khu chỉ được chiếm <color=#338dc3>1</color> cứ điểm",
    ["ui_GVGRules_039"]="Thưởng sự kiện",
    ["ui_GVGRules_040"]="Thưởng Chiến Tích",
    ["ui_GVGRules_041"]="Đạt chiến tích chỉ định trong chiến trường sẽ nhận được Chiến Tích",
    ["ui_GVGRules_042"]="Loại chiến tích",
    ["ui_GVGRules_043"]="Diệt người chơi",
    ["ui_GVGRules_044"]="Hồi sinh đồng đội",
    ["ui_GVGRules_045"]="Tạo 1 điểm DMG lên PL.Đẹp",
    ["ui_GVGRules_046"]="Tạo 1 điểm điều trị lên PL.Đẹp",
    ["ui_GVGRules_047"]="Diệt Pha Lê Đẹp",
    ["ui_GVGRules_048"]="Thời gian chiến đấu",
    ["ui_GVGRules_049"]="Thưởng Chiến Tích",
    ["ui_GVGRules_050"]="15",
    ["ui_GVGRules_051"]="10",
    ["ui_GVGRules_052"]="2",
    ["ui_GVGRules_053"]="1",
    ["ui_GVGRules_054"]="500",
    ["ui_GVGRules_055"]="16/phút",
    ["ui_GVGRules_056"]="giới hạn nhận huy chương SK",
    ["ui_GVGRules_057"]="750",
    ["ui_GVGRules_058"]="300",
    ["ui_GVGRules_059"]="750",
    ["ui_GVGRules_060"]="600",
    ["ui_GVGRules_061"]="1000",
    ["ui_GVGRules_062"]="600",
    ["ui_GVGRules_063"]="Khi sự kiện kết thúc, ủy ban Công Hội Chiến sẽ trao tặng huân chương phẩm chất khác nhau dựa theo cống hiến Chiến Tích của Nhà Thám Hiểm.",
    ["ui_GVGRules_064"]="Huân chương được gửi qua thư",
    ["ui_GVGRules_065"]="Phạm vi điểm Chiến Tích: ",
    ["ui_GVGRules_066"]="500-999",
    ["ui_GVGRules_067"]="1000-1499",
    ["ui_GVGRules_068"]="≥1500",
    ["ui_GVGRules_069"]="Cấp huân chương",
    ["ui_GVGRules_070"]="Huân Chương Đồng",
    ["ui_GVGRules_071"]="Huân Chương Bạc",
    ["ui_GVGRules_072"]="Huân Chương Vàng",
    ["ui_GVGRules_073"]="Thưởng",
    ["ui_GVGRules_074"]="Rương Tham Gia GVG x1",
    ["ui_GVGRules_075"]="Rương Tham Gia GVG x2",
    ["ui_GVGRules_076"]="Rương Tham Gia GVG x5",
    ["ui_GVGRules_077"]="Thưởng Chiếm Thành",
    ["ui_GVGRules_078"]="Khi sự kiện kết thúc, công hội sở hữu thành sẽ được ủy ban Công Hội Chiến gửi phần thưởng chiếm thành GVG qua thư.",
    ["ui_GVGRules_079"]="Đối tượng thưởng",
    ["ui_GVGRules_080"]="Tất cả thành viên công hội sở hữu thành GVG",
    ["ui_GVGRules_081"]="Giới hạn nhận",
    ["ui_GVGRules_082"]="Chiến Tích trận ≥200",
    ["ui_GVGRules_083"]="Thưởng",
    ["ui_GVGRules_084"]="Rương Thành Chủ GVG",
    ["ui_GVGRules_085"]="Chỉ Dẫn Sự Kiện",
    ["ui_GVGRules_086"]="Trợ Công Tiêu Diệt",
    ["ui_GVGRules_087"]="1",
    ["ui_GVGRules_088"]="100",
    ["ui_GVGRules_101"]="Hành Lang Vực Sâu",
    ["ui_GVGRules_102"]="Quy tắc tham gia",
    ["ui_GVGRules_103"]="Tư cách tham gia: Công hội giành quyền sở hữu cứ điểm thành chính trong GVG sẽ nhận tư cách vào Hành Lang Vực Sâu",
    ["ui_GVGRules_104"]="Thời gian mở: <color=#338dc3>22:00-23:00</color> hàng ngày có thể vào",
    ["ui_GVGRules_105"]="Cổng vào: Cổng dịch chuyển cờ cứ điểm, chỉ thành viên thuộc công hội sở hữu cứ điểm mới nhìn thấy",
    ["ui_GVGRules_106"]="Giới thiệu tính năng",
    ["ui_GVGRules_107"]="Công hội chiếm lĩnh 8 thành trì cứ điểm sẽ tranh đoạt tài nguyên cao cấp trong Hành Lang Vực Sâu",
    ["ui_GVGRules_108"]="Công hội trong Hành Lang Vực Sâu sẽ thiết lập quan hệ kẻ địch",
    ["ui_GVGRules_109"]="10\\30\\50 phút sau khi mở Hành Lang Vực Sâu, MVP chế độ Vực Sâu ngẫu nhiên sẽ xuất hiện. Sau khi đánh bại, kho báu vực sâu sẽ rơi ra.",
    ["ui_GVGRules_110"]="Quái vật chế độ Vực Sâu xuất hiện định kỳ trong Hành Lang Vực Sâu, sau khi đánh bại sẽ có xác suất rơi hàng hóa bí ẩn",
    ["ui_GVGRules_111"]="Giao hàng hóa",
    ["ui_GVGRules_112"]="Sau khi nhặt được hàng hóa bí ẩn hoặc kho báu vực sâu, hãy vận chuyển đến W của khu an toàn để giao hàng có thể nhận được nhiều phần thưởng như Tinh Hoa Vực Sâu",
    ["ui_GVGRules_113"]="Trong quá trình vận chuyển, tốc độ di chuyển trở nên thấp hơn, không thể tàng hình. Nếu bị quân địch đánh bại, hàng hóa sẽ rơi tại chỗ",
    ["ui_GVGRules_114"]="Thông báo tình bạn",
    ["ui_GVGRules_115"]="Hàng Hóa Bí Ẩn và Báu Vật Vực Sâu chỉ có thể giao tối đa 6 lần một ngày, thưởng hộ tống có thể nhận tối đa 3 lần một ngày",
    ["ui_GVGRules_116"]="Thu thập Tinh Hoa Vực Sâu có thể đổi danh hiệu hiệu ứng đặc biệt giúp nâng cao khả năng chiến đấu của GVG và chế độ Vực Sâu tại Thương Gia Công Hội trong phạm vi Công Hội",
    ["ui_GVGRules_117"]="Giới thiệu Tế Đàn Chiến Thần",
    ["ui_GVGRules_118"]="Tế Đàn Chiến Thần xuất hiện trong map trong chế độ <color=#338dc3>Thủ Thành</color>, <color=#338dc3>Tranh Đoạt</color>",
    ["ui_GVGRules_119"]="Nếu phe tấn công hoặc phe phòng thủ có thành viên vào khu vực tế đàn, tiến độ của tế đàn sẽ được tăng lên",
    ["ui_GVGRules_120"]="Sau khi chiếm lĩnh tế đàn thành công, tăng hiệu ứng Chúc Phúc Chiến Thần và xóa hình phạt hồi sinh cho các thành viên cùng phe trong tế đàn",
    ["ui_GVGRules_121"]="Hộ tống đồng đội giao hàng có thể nhận thêm 1 thưởng hộ tống (Trong phạm vi hộ tống 30m)",
    ["ui_GVGRules_122"]="Thưởng XH Chiến Tích Công Hội",
    ["ui_GVGRules_123"]="Phạm vi XH Chiến Tích",
    ["ui_GVGRules_124"]="1~3",
    ["ui_GVGRules_125"]="4~10",
    ["ui_GVGRules_126"]="11~30",
    ["ui_GVGRules_127"]="≥31",
    ["ui_GVGRules_128"]="Lưu ý: Người chơi có Chiến Tích 500 trở lên tham gia xếp hạng",
    ["ui_GVGRules_129"]="Công Hội của vòng loại GVG Liên Server sẽ được xếp hạng theo Điểm GVG, 4 Công Hội có điểm cao nhất trong chu kỳ sẽ đủ điều kiện tham gia GVG Liên Server",
    ["ui_GVGRules_130"]="Điểm GVG hàng tháng = Tổng điểm GVG hàng tuần",
    ["ui_GVGRules_131"]="Điểm GVG hàng tuần = Tổng điểm chiến tích mà người tham chiến nhận được x2 + Tổng điểm Cống Hiến Công Hội mà các thành viên Công Hội nhận được trong chu kỳ x15 + Số lượng thành trì chiếm lĩnh của Công Hội Chiến GVG trong chu kỳ x10.000",
    ["ui_GVGRules_132"]="Sau mỗi lần tổng kết GVG, điểm vòng loại GVG Liên Server mới nhất sẽ được làm mới, điểm sẽ bị khóa sau lần tổng kết GVG cuối cùng của tháng này",
    ["ui_GVGRules_133"]="Lưu ý: Số lượng Công Hội tham gia Công Hội Chiến GVG phải lớn hơn hoặc bằng 10, nếu không, tổng số chiến tích mà những người tham gia đạt được trong tuần sẽ không được tính vào điểm GVG",
    ["ui_GVGRules_134"]="GVG Liên Server sẽ được mở vào 21:30 Chủ Nhật cuối cùng của mỗi tháng, nếu có tình huống đặc biệt, vui lòng xem thông báo của game",
    ["ui_GVGSetup_001"]="Cài đặt chiến trường GVG",
    ["ui_GVGSetup_002"]="30 người",
    ["ui_GVGSetup_003"]="40 người",
