    ["SlimeTask2_008"]="Sử dụng %s/%s bất kỳ loại xúc xắc nào trong Chuyến Thám Hiểm Của Rimuru",
    ["SlimeTask2_009"]="Kích hoạt %s/%s sự kiện Kỳ Ngộ trong Chuyến Thám Hiểm Của Rimuru",
