    ["ItemDes_10803216"]="Lấy Nước Suối từ suối Vườn Hoa Thanh Bình",
    ["ItemDes_10803217"]="Thuốc có thể khiến người ta nói sự thật, uống vào sẽ rõ",
    ["ItemDes_10803218"]="Ấn chú thần bí có công dụng trấn hồn",
