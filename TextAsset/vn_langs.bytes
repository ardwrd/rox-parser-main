    ["DialogueOption20867071"]="ai là người giới thiệu",
    ["DialogueOption20867081"]="…Ta hiểu rồi",
    ["DialogueOption20868011"]="(nhìn Aimu)",
    ["DialogueOption20868021"]="???",
    ["DialogueOption20868051"]="Chỉ cần chờ một phút...",
    ["DialogueOption20868071"]="Để tôi!",
    ["DialogueOption20869021"]="Chất liệu mà bạn đã sử dụng là gì?",
    ["DialogueOption20869031"]="...",
    ["DialogueOption20869101"]="? !",
    ["DialogueOption20870011"]="Ôi~",
    ["DialogueOption20870031"]="Nhưng bị mắc kẹt trong...",
