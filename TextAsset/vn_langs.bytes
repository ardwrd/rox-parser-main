    ["DialogueBubble662491098"]="T",
    ["DialogueBubble662491099"]="3x+5y=134\n2x-3y=-31",
    ["DialogueBubble662491100"]="Matured fÓr years and impÓrted\n IntÓ my glass yÓu pÓured it",
    ["DialogueBubble662491101"]="W2",
    ["DialogueBubble662491102"]="Tiếp theo, tôi sắp phát mã rồi, hãy chú ý lắng nghe nhé!",
    ["DialogueBubble662491103"]="W3",
    ["DialogueBubble662491104"]="X\nX",
    ["DialogueBubble662491105"]="SÙppose iṭ stands ṭo reason\n That you woÙld ṭurn on me",
    ["DialogueBubble662491106"]="Suppose iṭ staṄds to reasoṄ\n Suppose it staṄds ṭo reason",
    ["DialogueBubble662491107"]="◤",
