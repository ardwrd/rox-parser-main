    ["TeamBattleMode04"]="Đại Chiến Cướp Poring",
    ["TeamBattleModeDesc01"]="Đoạt cờ về trận địa của mình",
    ["TeamBattleModeDesc02"]="Chiếm điểm tài nguyên để đoạt tài nguyên",
