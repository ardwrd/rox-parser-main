    ["MoonFestivalTips_001"]="<color=#fcb248>Xác suất tiến hóa Huân Chương Phẩm Chất trong thời gian sự kiện tăng <color=#60fff9>50</color>%%</color>",
    ["MoonFestivalTips_002"]="<color=#fcb248>%sTỷ lệ tiến hóa thành công Huân Chương Phẩm Chất Pet trong thời gian đó tăng <color=#60fff9>50</color>%%</color>",
    ["MoonFestivalTips_003"]="Xiên Nướng Bách Vị",
