    ["DialogueBubble610801123"]="0",
    ["DialogueBubble610801129"]="5",
    ["DialogueBubble610801142"]="Hãy chú ý lắng nghe, tôi đã chuyển nhạc nền!",
    ["DialogueBubble610801158"]="Tiếp theo, tôi phải phát mã rồi, hãy chú ý lắng nghe nhé!",
    ["DialogueBubble610801203"]="3",
    ["DialogueBubble610801208"]="8",
    ["DialogueBubble610801909"]="10 chữ cái được xếp như hàng rào... vậy mỗi dòng sẽ có 5 chữ cái!",
    ["DialogueBubble610803001"]="●●-●",
    ["DialogueBubble610803002"]="●-",
    ["DialogueBubble610803003"]="●-●",
    ["DialogueBubble610803004"]="●●●-",
    ["DialogueBubble610803005"]="●",
    ["DialogueBubble610803006"]="●-●●",
    ["DialogueBubble610903101"]="Tiệm Tạp Hóa của ta thứ gì cũng có, nhưng không có Kẹo cho các bạn nhỏ.",
    ["DialogueBubble610963101"]="Đừng bỏ lỡ bữa tối giới hạn của lễ Halloween",
    ["DialogueBubble611383101"]="Khẩu Trang Đinh Sắt là trang sức hot của mùa Halloween năm nay.",
    ["DialogueBubble611722101"]="Chỉ cần tin vào khả năng vô hạn của tương lai, thì điều tốt đẹp sẽ xảy ra mỗi ngày!",
    ["DialogueBubble611722201"]="Được yêu thương chính là may mắn! Cuộc gặp gỡ của chúng ta cũng là điều kỳ diệu!",
    ["DialogueBubble611722301"]="Đừng để đáy vực tạm thời ngăn cản bước tiến của cậu!",
    ["DialogueBubble611722401"]="Mỗi chặng đường trong đời đều đáng khen ngợi, dù không ai cổ vũ cho cậu, cũng phải nhớ tự cổ vũ mình!",
    ["DialogueBubble611722501"]="Chuyện vui phải chia sẻ với mọi người!",
    ["DialogueBubble611722601"]="Tuy ta có nhiều fan, nhưng lần đầu thấy người can đảm như cậu.",
    ["DialogueBubble611722701"]="Hôm nay cũng phải vui vẻ!",
    ["DialogueBubble630710101"]="Phía trước nguy hiểm, cấm vào!",
    ["DialogueBubble6310701"]="\"Búp bê nhồi bông, ngốc nghếch khờ khạo. Thích ăn mật ong, sợ chi ong chích.\"",
    ["DialogueBubble6310702"]="Đoán xem là loài vật gì?",
    ["DialogueBubble6311001"]="\"Cái đuôi dài, có bờm lông, biết kéo xe, chạy rất khỏe.\"",
    ["DialogueBubble6311002"]="Đoán xem là loài vật gì?",
    ["DialogueBubble6311101"]="\"Cái mõm dài, đuôi xoăn tít, tròn trùng trục, rất lề mề, đứng cuối cùng trong 12 con giáp.\"",
    ["DialogueBubble6311102"]="Đoán xem là loài vật gì?",
    ["DialogueBubble640012101"]="Chào mừng đến Học Viện Criatura!",
    ["DialogueBubble640052101"]="Hãy nhìn những Nhà Thám Hiểm trẻ trung và tràn đầy năng lượng này!",
    ["DialogueBubble640062101"]="Ở trong Thư Viện! Cấm làm ồn!",
    ["DialogueBubble640382101"]="He he he, tuy ta là Thương Gia Nấu Ăn, nhưng giờ không có gì để bán cả...",
    ["DialogueBubble640382201"]="Mong chờ món ăn của ta sao? Cảm ơn nha, ha ha, ít nhất ta biết làm gà rán!",
    ["DialogueBubble640392101"]="Hả? Cậu muốn làm trang bị? Đi tìm Hollgrehenn đó... Ủa, vậy chúng ta tồn tại có ý nghĩa gì?",
    ["DialogueBubble640392201"]="Vì có ta mà thị trấn trở nên sôi động hơn? Tuy không biết cậu đang nói gì, nhưng dễ chịu hơn nhiều rồi, cảm ơn",
    ["DialogueBubble640402101"]="Mua bán trang bị trong thành hãy tìm Thợ Rèn Hollgrehenn, cậu nói với bọn ta làm gì? Ta cũng không biết, ý....",
    ["DialogueBubble640402201"]="Sẽ có ngày ta phát huy tác dụng? Ha hah, cảm ơn cậu cổ vũ",
    ["DialogueBubble6601411"]="Yahoo~ Xem kỹ năng bắn ná của tôi đây!",
    ["DialogueBubble6601611"]="Chỉ, chỉ cần là miễn là lệnh của đội trưởng Altyna, tôi đều sẵn lòng...",
    ["DialogueBubble662491001"]="●-●\n●",
    ["DialogueBubble662491002"]="▥▣▣▣",
    ["DialogueBubble662491003"]="H\nH",
