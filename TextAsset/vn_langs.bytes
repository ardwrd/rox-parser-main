    ["QixiTask_016"]="Chơi Trò Chơi Tửu Quán %s/%s lần",
    ["QixiTask_017"]="Tích lũy nạp Kim Cương đến %s/%s",
    ["QixiTask_018"]="Tích lũy số tiền Pha Lê ở Quầy Giao Dịch đến %s/%s",
    ["QixiTask_019"]="Tích lũy tiến hành Dung Luyện Trang Bị %s/%s lần",
