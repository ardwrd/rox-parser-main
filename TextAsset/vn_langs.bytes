    ["ChristmasTip_009"]="Loại vũ khí hiện tại không thể dùng chiến đấu tự động",
    ["ChristmasWorldTaskTips_01"]="Có một sứ mệnh thế giới đang được tiến hành ở khu vực hiện tại -<color=#ec8a5a>%s</color>, tổng tiến độ hiện tại:<color=#ec8a5a>%s</color>, thời gian còn lại:<color=#ec8a5a>%s</color>. Tham gia vào nhiệm vụ?",
    ["ChristmasWorldTaskTips_02"]="Đóng góp cá nhân của bạn đã đạt đến mức cao nhất và bạn sẽ không còn tích lũy tiến độ nếu tiếp tục tham gia vào các nhiệm vụ.",
    ["ChristmasWorldTaskTips_03"]="Tiến độ tích lũy hoàn thành các sự kiện thế giới đã được hoàn thành ngày hôm nay:%s",
