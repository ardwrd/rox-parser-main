    ["DialogueOption20807031"]="À thì...",
    ["DialogueOption20807041"]="Không có gì.",
    ["DialogueOption20807051"]="Cô có nhìn thấy...",
    ["DialogueOption20807061"]="Cảm ơn!",
    ["DialogueOption20808051"]="(Mắt tròn mắt dẹt) !!!",
    ["DialogueOption20808091"]="Phù... hình như không sao?",
    ["DialogueOption20809011"]="Tôi chỉ là chân sai vặt...",
    ["DialogueOption20809021"]="Tôi sẽ đi theo...",
    ["DialogueOption20809031"]="Đây là...?",
    ["DialogueOption20809061"]="(Cảm kích) Cảm ơn cô!",
    ["DialogueOption20810011"]="...?",
    ["DialogueOption20810031"]="Không ngờ lại còn có người lừa được anh.",
    ["DialogueOption20810041"]="... Là người quen của ngươi sao?",
