    ["SEA_Achievement_Name_580295"]="Lì Xì Giáng Trần",
    ["SEA_Achievement_Name_580302"]="VIP Siêu Cấp",
    ["SEA_AnniversaryCommand"]="Nhập <color=#ffc982>\"Happy 3rd Anniversary\"</color> vào kênh chính thức để kích hoạt thưởng khẩu lệnh",
    ["SEA_AnniversaryCommand_CommandLock"]="Nhập khẩu lệnh rồi nhận nhé",
    ["SEA_AnniversaryCommand_Day1"]="1day",
    ["SEA_AnniversaryCommand_Day2"]="2days",
    ["SEA_AnniversaryCommand_Day3"]="3days",
    ["SEA_AnniversaryCommand_Day4"]="4days",
    ["SEA_AnniversaryCommand_Day5"]="5days",
    ["SEA_AnniversaryCommand_Day6"]="6days",
    ["SEA_AnniversaryCommand_Day7"]="7days",
    ["SEA_AnniversaryCommand_Day8"]="8days",
    ["SEA_AnniversaryCommand_EndTime"]="Thời gian đợt này đến: 30/06",
    ["SEA_AnniversaryCommand_Help01_01"]="Giới thiệu Chúc Phúc Mỗi Ngày:\n1. Trong thời gian sự kiện mừng sinh nhật lần này, tích lũy đăng nhập số ngày chỉ định, sẽ nhận được [Thưởng điểm danh]\n2. Vào ngày mừng sinh nhật 18/6 mở khẩu lệnh, vào kênh chính thức nhập khẩu lệnh sẽ mở được [Thưởng khẩu lệnh]\n3. Sau khi mở khẩu lệnh, dùng trước khi kết thúc sự kiện mừng sinh nhật, đều mở được [Thưởng khẩu lệnh]\n4. Số lượng [Thưởng khẩu lệnh] có thể nhận sẽ bằng với số ngày đăng nhập đã tích lũy",
    ["SEA_AnniversaryCommand_Lock"]="Chờ phần thưởng được mở rồi vào nhận nhé",
    ["SEA_AnniversaryFuncDesc1"]="Thưởng được nhận",
    ["SEA_AnniversaryFuncDesc2"]="Nhập Thành Tựu để nhận thưởng",
    ["SEA_AnniversaryFuncDesc3"]="Thưởng được nhận",
    ["SEA_AnniversaryFuncDesc4"]="Mua Thời Trang",
    ["SEA_Anniversary_Duration"]="Thời gian sự kiện: %s/%s/%s ~ %s/%s/%s",
    ["SEA_Anniversary_WorldKVM"]="Mở Cuộc Chiến Thần Chọn II \n<size=20>20/06/2022</size>",
    ["SEA_Year2MemoirDes1_004"]="\nGhế VIP của Kafra đang chờ bạn.",
    ["SEA_Year2MemoirDes1_010"]="\nTin vào mắt nhìn của bạn,",
    ["SEA_Year2MemoirDes1_011"]="Đã hướng về con đường chuyển đa nghề.",
    ["SEA_Year2MemoirDes1_017"]="\nNhà Thám Hiểm, hãy đánh thức Shadow của bạn đi.",
    ["SEA_Year2MemoirDes1_018"]="\nVà tham gia trận chiến MVP & MINI,",
    ["SEA_Year2MemoirDes1_019"]="Và phải đột phá kỷ lục số lần Phó Bản \"0\",",
    ["SEA_Year2MemoirDes1_021"]="Và phải leo lên Tháp Vô Tận,",
    ["SEA_Year2MemoirDes1_023"]="Và phải bảo vệ vinh quang Công Hội của KVM.",
    ["SEA_Year2MemoirDes1_024"]="\nNhư vậy,",
    ["SEA_Year2MemoirDes1_025"]="Mới có thể tạo ra chí lớn cho người dũng cảm.",
    ["SEA_Year2MemoirDes1_026"]="\nTận hưởng sự độc thân hoặc nói lời yêu trong im lặng,",
    ["SEA_Year2MemoirDes1_027"]="Tất cả đều hành động theo tình hình.",
    ["SEA_Year2MemoirDes1_028"]="\nMột mình đi khắp thế gian, hoặc thích ứng trong mọi tình cảnh,",
    ["SEA_Year2MemoirDes1_029"]="Đều làm theo ý muốn.",
    ["SEA_Year2MemoirDes1_032"]="\nMột người thành nhóm, hoặc hai ba người đồng hành,",
    ["SEA_Year2MemoirDes1_033"]="Đều hành động theo trái tim.",
    ["SEA_Year2MemoirDes1_036"]="\nCánh cửa lớn của Quầy Giao Dịch đã mở,",
    ["SEA_Year2MemoirDes1_037"]="Hãy giao dịch đơn hàng đầu tiên nhé!",
    ["SEA_Year2MemoirDes1_038"]="\nChọn vật phẩm để lên kệ,",
    ["SEA_Year2MemoirDes1_039"]="Kiếm đủ thùng vàng đầu tiên của bạn.",
    ["SEA_Year2MemoirDes1_040"]="\nGiao dịch bằng Pha Lê,",
    ["SEA_Year2MemoirDes1_041"]="Mua vật phẩm yêu thích.",
    ["SEA_Year2MemoirDes1_042"]="\nGiao dịch bằng Kim Cương,",
    ["SEA_Year2MemoirDes1_043"]="Làm trống giỏ hàng của bạn.",
    ["SEA_Year2MemoirDes1_044"]="\nAi mà từ chối được",
    ["SEA_Year2MemoirDes1_045"]="Niềm vui mua hàng chứ!",
    ["SEA_Year2MemoirDes1_053"]="\nChỉ để chọn đồng đội tốt nhất!",
    ["SEA_Year2MemoirDes1_055"]="\nThêm Trang Phục,",
    ["SEA_Year2MemoirDes1_056"]="Lấp đầy Tủ Áo trống rỗng của bạn!",
    ["SEA_Year2MemoirDes1_057"]="\nTăng động tác,",
    ["SEA_Year2MemoirDes1_058"]="Tìm phong cách xã giao của chính mình!",
    ["SEA_Year2MemoirDes1_059"]="\nMua Thú Cưỡi,",
    ["SEA_Year2MemoirDes1_060"]="Đi khắp đại lục cùng nó!",
    ["SEA_Year2MemoirDes_001"]="Xin chào <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_002"]="Từ <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_003"]="Bạn đã trải qua <color=#c69d46>%s</color> ngày thám hiểm ở Midgarts,",
    ["SEA_Year2MemoirDes_004"]="và trở thành VIP của Kafra vào <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_005"]="\nThời gian như sợi chỉ, năm tháng như ngọc,\nchúng ta cùng đếm\nhuyền thoại nhân danh bạn lưu lại.",
    ["SEA_Year2MemoirDes_006"]="Vào <color=#c69d46>%s</color>, bạn đã chuyển Nghề I thành <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_007"]="Sau <color=#c69d46>%s</color> ngày, chuyển Nghề II thành công,",
    ["SEA_Year2MemoirDes_008"]="Sau <color=#c69d46>%s</color> ngày, tiến cấp Nghề II,",
    ["SEA_Year2MemoirDes_009"]="Sau <color=#c69d46>%s</color> ngày trở thành Nhà Thám Hiểm Nghề III vinh quang.",
    ["SEA_Year2MemoirDes_010"]="Bạn đã kích hoạt <color=#c69d46>%s</color> lớp nghề,\nđể thế giới thấy được thiên phú của Nhà Thám Hiểm toàn năng.",
    ["SEA_Year2MemoirDes_011"]="\nđể thế giới thấy được thiên phú của Nhà Thám Hiểm toàn năng",
    ["SEA_Year2MemoirDes_012"]="<color=#c69d46>%s</color> lần cường hóa,",
    ["SEA_Year2MemoirDes_013"]="<color=#c69d46>%s</color> lần Tinh Luyện đến <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_014"]="<color=#c69d46>%s</color> lần Yểm Bùa đến <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_015"]="<color=#c69d46>%s</color> tấm thẻ ghi lại con đường bồi dưỡng của Thần Trang.",
    ["SEA_Year2MemoirDes_016"]="Odin, ngài vẫn còn <color=#c69d46>%s</color> Thẻ Vàng!",
    ["SEA_Year2MemoirDes_017"]="Thành công tăng cấp Shadow <color=#c69d46>%s</color> lần,",
    ["SEA_Year2MemoirDes_018"]="<color=#c69d46>%s</color> lần chiến đấu với MVP & Mini,",
    ["SEA_Year2MemoirDes_019"]="<color=#c69d46>%s</color> lần phó bản mạo hiểm,",
    ["SEA_Year2MemoirDes_020"]="<color=#c69d46>%s</color> lần nhấn thích phó bản.",
    ["SEA_Year2MemoirDes_021"]="Leo lên Tháp Vô Tận tầng <color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_022"]="<color=#c69d46>%s</color> lần vượt Phó Bản Nhóm,",
    ["SEA_Year2MemoirDes_023"]="<color=#c69d46>%s</color> lần Huyết Chiến KVM.\nTrái tim rực lửa của người dũng cảm rèn từ búa.",
    ["SEA_Year2MemoirDes_024"]="\nBạn đã dùng võ thuật vô tận,",
    ["SEA_Year2MemoirDes_025"]="Trái tim rực lửa của người dũng cảm rèn từ búa.",
    ["SEA_Year2MemoirDes_026"]="<color=#c69d46>%s</color>, bạn và người ấy đã ký kết khế ước ngọt ngào.",
    ["SEA_Year2MemoirDes_027"]="Bạn và người ấy đã ký kết hiệp ước ngọt ngào.",
    ["SEA_Year2MemoirDes_028"]="<color=#c69d46>%s</color>,",
    ["SEA_Year2MemoirDes_029"]="Bạn đã gia nhập <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_030"]="\nNăm tháng trôi qua, mọi thứ thay đổi,",
    ["SEA_Year2MemoirDes_031"]="Bây giờ bạn là <color=#c69d46>%s</color> - <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_032"]="Bạn đã kết bạn với <color=#c69d46>%s</color> bạn bè, mong rằng bông hoa tình bạn không bao giờ khô héo.",
    ["SEA_Year2MemoirDes_033"]="Mong rằng bông hoa tình bạn không bao giờ khô héo.",
    ["SEA_Year2MemoirDes_034"]="Bạn đã tặng quà cho bạn bè tổng cộng <color=#c69d46>%s</color> lần,",
    ["SEA_Year2MemoirDes_035"]="Một chút tâm ý, tất cả đều quý giá.",
    ["SEA_Year2MemoirDes_036"]="\nBạn là khách quen của Quầy Giao Dịch,",
    ["SEA_Year2MemoirDes_037"]="\nBạn là khách quen của Quầy Giao Dịch, đã giao dịch xong <color=#c69d46>%s</color> đơn hàng.",
    ["SEA_Year2MemoirDes_038"]="\nLà người bán,",
    ["SEA_Year2MemoirDes_039"]="\nLà người bán, bạn kiếm được <color=#c69d46>%s</color> Pha Lê trong Quầy Giao Dịch.",
    ["SEA_Year2MemoirDes_040"]="Là người mua Pha Lê,",
    ["SEA_Year2MemoirDes_041"]="Là người mua Pha Lê, bạn tiêu hao <color=#c69d46>%s</color> Pha Lê trong Quầy Giao Dịch.",
    ["SEA_Year2MemoirDes_042"]="Là người mua Kim Cương,",
    ["SEA_Year2MemoirDes_043"]="Là người mua Kim Cương, bạn tiêu hao <color=#c69d46>%s</color> Kim Cương trong Quầy Giao Dịch.\nGiao dịch công bằng, trao đổi ngang giá, bạn đã quen thuộc với quy luật của thị trường.",
    ["SEA_Year2MemoirDes_044"]="\nGiao dịch công bằng, trao đổi ngang giá,",
    ["SEA_Year2MemoirDes_045"]="Bạn đã quen thuộc với quy luật của thị trường.",
    ["SEA_Year2MemoirDes_046"]="Câu Cá <color=#c69d46>%s</color> lần,",
    ["SEA_Year2MemoirDes_047"]="Thăng cấp Câu Cá lên <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_048"]="Làm Vườn <color=#c69d46>%s</color> lần,",
    ["SEA_Year2MemoirDes_049"]="Thăng cấp Làm Vườn lên <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_050"]="Đào Mỏ <color=#c69d46>%s</color> lần,",
    ["SEA_Year2MemoirDes_051"]="Thăng cấp Đào Mỏ lên <color=#c69d46>%s</color>.",
    ["SEA_Year2MemoirDes_052"]="Nghiêm túc bắt Pet <color=#c69d46>%s</color> lần,",
    ["SEA_Year2MemoirDes_053"]="Cuối cùng hiện tại cũng có <color=#c69d46>%s</color> Pet đồng hành,",
    ["SEA_Year2MemoirDes_054"]="Tiến độ thu thập Pet của bạn là <color=#c69d46>%s</color>%%",
    ["SEA_Year2MemoirDes_055"]="<color=#c69d46>%s</color> món trang phục, định hình phong cách thời trang vĩnh hằng.",
    ["SEA_Year2MemoirDes_056"]="định hình phong cách thời trang vĩnh hằng.",
    ["SEA_Year2MemoirDes_057"]="<color=#c69d46>%s</color> động tác, thắp sáng ngôi sao xã giao.",
    ["SEA_Year2MemoirDes_058"]="Thắp sáng ngôi sao xã giao.",
    ["SEA_Year2MemoirDes_059"]="<color=#c69d46>%s</color> Thú Cưỡi, trải qua bốn mùa xuân, thu, đông và hạ.",
    ["SEA_Year2MemoirDes_060"]="Trải qua bốn mùa xuân, thu, đông và hạ.",
    ["SEA_Year2MemoirDes_061"]="\nCho dù thời gian rỉ sét,",
    ["SEA_Year2MemoirDes_062"]="Ký ức của chúng ta vẫn bất diệt.",
    ["SEA_Year2MemoirShareDes1_003"]="Bắt đầu từ số 0, học hỏi kiến ​​thức giao dịch và cố gắng kiếm được thùng Pha Lê đầu tiên.",
    ["SEA_Year2MemoirShareDes_001"]="<color=#c69d46>%s</color>, Nhà Thám Hiểm <color=#c69d46>%s</color> đến lục địa Midgarts nào!",
    ["SEA_Year2MemoirShareDes_002"]="Bắt đầu từ số 0, cường hóa <color=#c69d46>%s</color> lần, Tinh Luyện <color=#c69d46>%s</color> lần, Yểm Bùa <color=#c69d46>%s</color> lần,",
    ["SEA_Year2MemoirShareDes_003"]="Bắt đầu từ số 0, học hỏi kiến thức giao dịch, kiếm <color=#c69d46>%s</color> Pha Lê,",
    ["SEA_Year2MemoirShareDes_004"]="Hãy để Trang Bị và Pha Lê lấp lánh này,",
    ["SEA_Year2MemoirShareDes_005"]="Trở thành minh chứng <color=#c69d46>%s</color> ngày không bao giờ lãng phí!",
    ["SEA_YearMemoirDes_001"]="%s, bạn đến Vương Quốc Rune với danh nghĩa %s.",
    ["SEA_YearMemoirDes_002"]="%s, bạn có được hữu nghị với công ty Kafra.",
    ["SEA_YearMemoirDes_003"]="Trải qua <color=#ecc993>%s</color> ngày thám hiểm, bạn đã mạnh mẽ hơn nhiều.",
    ["SEA_YearMemoirDes_004"]="Giờ đây, bạn đã trở thành Nhà Thám Hiểm Chuyển Nghề II <color=#ecc993>%s</color> ngày,",
    ["SEA_YearMemoirDes_005"]="Nhà Thám Hiểm Nghề II Tiến Cấp ngày %s,",
    ["SEA_YearMemoirDes_006"]="Nhà Thám Hiểm Chuyển Nghề III ngày <color=#ecc993>%s</color>.",
    ["SEA_YearMemoirDes_021"]="\nBạn có chút ít thành tựu trong dưỡng thành Trang Bị,",
    ["SEA_YearMemoirDes_022"]="<color=#ecc993>%s</color> lần Cường Hoá, <color=#ecc993>%s</color> lần Tinh Luyện, <color=#ecc993>%s</color> lần Yểm Bùa,",
    ["SEA_YearMemoirDes_023"]="Cuối cùng bạn đã chế tạo được <color=#ecc993>%s</color> cấp Tinh Luyện <color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_024"]="Cấp Yểm Bùa cao nhất của bạn cũng đạt được <color=#ecc993>%s</color>.",
    ["SEA_YearMemoirDes_031"]="\nMuốn nhận Trang Bị mạnh nhất sao?\nHãy tìm Hollgrehenn đi,\nHắn sẽ nói cho bạn bí mật dưỡng thành trang bị.\nCó điều, phải bình tĩnh.",
    ["SEA_YearMemoirDes_041"]="\nBạn là thợ săn quái vật thiên tài,",
    ["SEA_YearMemoirDes_042"]="Tác chiến MVP&MINI <color=#ecc993>%s</color> lần,",
    ["SEA_YearMemoirDes_043"]="<color=#ecc993>%s</color> lần gõ vang hồi chuông báo tử cuối cùng cho quái vật.",
    ["SEA_YearMemoirDes_044"]="Đã hoàn thành <color=#ecc993>%s</color> lần Phó Bản rèn luyện,",
    ["SEA_YearMemoirDes_045"]="<color=#ecc993>%s</color> lượt bấm thích là nhân chứng cho phong thái nhiệt huyết của bạn",
    ["SEA_YearMemoirDes_051"]="\nChiến đấu là liều thuốc tăng hương vị cho thám hiểm,\nHãy thử với Thỏ Điên Lam ngoài Vương Thành?\nCảm giác sờ vào lông nhung nhất định rất tuyệt~",
    ["SEA_YearMemoirDes_061"]="\nNhà Thám Hiểm may mắn nhất, sẽ gặp được đồng hành và người yêu.",
    ["SEA_YearMemoirDes_062"]="Vào %s đã hẹn ước trăm năm,",
    ["SEA_YearMemoirDes_063"]="Vào %s gia nhập %s,",
    ["SEA_YearMemoirDes_064"]="Thời gian dần trôi, bạn đã là <color=#ecc993>%s</color> <color=#ecc993>%s</color>.",
    ["SEA_YearMemoirDes_065"]="Đã kết nối được với <color=#ecc993>%s</color> người bạn,",
    ["SEA_YearMemoirDes_071"]="\nDường như bạn trân quý tự do một mình hơn,\nHoặc có lẽ vận mệnh vẫn đang lựa chọn đồng hành cho bạn.\nĐừng vội vàng,\nDù một mình độc hành hay là hai người sóng bước thì,\nPhong cảnh vẫn đang chờ bạn.",
    ["SEA_YearMemoirDes_081"]="\nBạn là khách quen của Quầy Giao Dịch,",
    ["SEA_YearMemoirDes_082"]="Đã giao dịch thành công <color=#ecc993>%s</color> lần ở Quầy Giao Dịch,",
    ["SEA_YearMemoirDes_083"]="Kiếm được <color=#ecc993>%s</color> Pha Lê,",
    ["SEA_YearMemoirDes_084"]="Tiêu <color=#ecc993>%s</color> Pha Lê, <color=#ecc993>%s</color> Kim Cương,",
    ["SEA_YearMemoirDes_091"]="Nghe âm thanh êm tai của đồng tiền rơi xuống đất chưa?\nĐến Quầy Giao Dịch ngay đi,\nĐể nó rơi vào tay bạn nào~",
    ["SEA_YearMemoirDes_101"]="\nNgoài thám hiểm, đời sống thường ngày của bạn cũng rất thú vị,",
    ["SEA_YearMemoirDes_102"]="Câu cá <color=#ecc993>%s</color> lần sẽ là đại sư câu cá cấp <color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_103"]="Đào mỏ <color=#ecc993>%s</color> lần sẽ là chuyên gia đào mỏ cấp <color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_104"]="Làm vườn <color=#ecc993>%s</color> lần sẽ là đại sư làm vườn cấp <color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_105"]="Bắt Pet <color=#ecc993>%s</color> lần sẽ giúp <color=#ecc993>%s</color> người bạn nhỏ trưởng thành cùng bạn,",
    ["SEA_YearMemoirDes_106"]="Độ thu thập Pet của bạn là <color=#ecc993>%s%%</color>.",
    ["SEA_YearMemoirDes_111"]="\nMuốn thử khám phá niềm vui cuộc sống không?\nSau khi dừng bước thám hiểm,\nThế giới vẫn rộng lớn.",
