    ["ui_OSADeposit_016"]="Sự kiện này chỉ giới hạn cho người dùng tham gia thử nghiệm xóa dữ liệu nhận được thời trang tham gia ",
    ["ui_OdinBlessing_001"]="Đến tượng Odin",
    ["ui_OdinBlessing_002"]="Chúc phúc tượng đạt tối đa",
    ["ui_OdinBlessing_003"]="Chênh lệch cấp quái với Cấp Base của người chơi và số thành viên đội sẽ ảnh hưởng đến lượng EXP nhận được.",
    ["ui_OdinBlessing_004"]="Điểm huấn luyện tiến cử",
    ["ui_OdinBlessing_005"]="Chúc Phúc Odin",
    ["ui_OdinBlessing_006"]="Tốn Chúc Phúc Odin khi diệt quái dã ngoại sẽ nhận hiệu quả sau",
    ["ui_OdinBlessing_007"]="Zeny x5",
    ["ui_OdinBlessing_008"]="EXP x5",
    ["ui_OdinBlessing_009"]="Rơi x5",
    ["ui_OdinBlessing_010"]="Mở Chúc Phúc Odin diệt quái sẽ nhận thêm nhiều phần thưởng.\nKhi diệt quái sẽ tự động tiêu hao 1 Nhỏ, 2 Vừa và 3 Lớn.\nDiệt quái chênh lệch với người chơi trong 6 cấp mới có thể tiêu hao Chúc Phúc Odin, hãy lưu ý cấp quái.\nNhà Thám Hiểm Chúc Phúc Odin khi tiêu hao chúc phúc sẽ nhận được thể lực.",
    ["ui_OdinBlessing_011"]="Sự khác biệt giữa cấp quái, cấp người chơi và số người trong đội sẽ ảnh hưởng đến EXP nhận được.",
    ["ui_OdinBlessing_012"]="Nhận Chúc Phúc",
    ["ui_OdinBlessing_013"]="Ủy thác ngày",
    ["ui_OdinBlessing_014"]="Prontera",
    ["ui_OdinBlessing_015"]="Hoàn thành ủy thác ngày sẽ nhận nhiều Chúc Phúc Odin!",
    ["ui_OdinBlessing_016"]="Hãy hoàn thành ủy thác ngày, xác suất làm mới quái sẽ gia tăng!",
    ["ui_OdinBlessing_017"]="Đến bảng ủy thác",
    ["ui_OdinBlessing_018"]="Khi ở Prontera, cách {0} giây sẽ nhận {1} Chúc Phúc Odin",
    ["ui_OdinBlessing_019"]="<color=#f6723e>12:00</color> và <color=#f6723e>20:00</color> mỗi ngày, sẽ được nhiều Chúc Phúc tại Prontera!",
    ["ui_OdinBlessing_020"]="Đến thành chính",
