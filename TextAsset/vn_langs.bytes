    ["Re0_Dungeon_EnchantsName132"]="Khắc chế thể hình",
    ["Re0_Dungeon_JobDeDes001"]="Tốc độ tấn công nhanh, CD kỹ năng ngắn, chủ yếu là kỹ năng hỗ trợ",
    ["Re0_Dungeon_JobDeDes002"]="Tốc độ tấn công cao, kiềm chế thuộc tính thánh, tính linh hoạt và cơ động",
    ["Re0_Dungeon_JobDeDes003"]="DMG cận chiến, có thể kháng, có thể hồi phục",
    ["Re0_Dungeon_JobDeDes004"]="Càng chiến đấu càng dũng cảm, tiêu hao ít và hiệu quả cao, kiểm soát cá nhân",
    ["Re0_Dungeon_JobDeDes005"]="Khống chế, sát thương liên tục",
    ["Re0_Dungeon_JobDeDes006"]="Tự động niệm chú, bùa phép tấn công cơ bản, tăng sát thương nguyên tố",
    ["Re0_Dungeon_JobDeDes007"]="Dựa vào các đòn chém, đòn chí mạng và kỹ năng kết hợp để tạo ra vụ nổ",
    ["Re0_Dungeon_JobDeDes008"]="Giỏi tấn công lén lút và đánh lén, với khả năng thu hoạch mạnh mẽ",
    ["Re0_Dungeon_JobDeDes009"]="Cảm giác vận hành tốt và đầu ra ổn định",
    ["Re0_Dungeon_JobDeDes010"]="Tăng cường thể chất, lĩnh vực di chuyển, tăng nhóm",
    ["Re0_Dungeon_JobDeDes011"]="Tăng cường yếu tố, trường di chuyển, tăng nhóm",
    ["Re0_Dungeon_JobDeDes012"]="Tấn công cao, kỹ năng chi viện là chính",
    ["Re0_Dungeon_JobDeDes013"]="Anh ta giỏi vượt qua giới hạn bằng cách tăng cường sức mạnh cho bản thân và có khả năng cận chiến mạnh mẽ.",
    ["Re0_Dungeon_JobDeDes014"]="Các đòn đánh cơ bản có độ xuyên thấu cao kết hợp với kỹ năng có thể gây ra rất nhiều sát thương cho kẻ địch.",
    ["Re0_Dungeon_JobDeDes015"]="Dựa vào tốc độ tấn công và hiệu ứng sát thương nổ cao để chiến đấu",
    ["Re0_Dungeon_JobDeDes016"]="Thành thạo các kỹ thuật dùng kiếm của Ninja và giỏi sử dụng sát thương vật lý để thu hoạch chiến trường.",
    ["Re0_Dungeon_JobDeDes017"]="Thành thạo các kỹ thuật dùng kiếm của Ninja và giỏi sử dụng sát thương vật lý để thu hoạch chiến trường.",
    ["Re0_Dungeon_JobDeDes018"]="Sở hữu kỹ năng chân tuyệt vời, giỏi khống chế và gây sát thương cực mạnh lên kẻ thù",
    ["Re0_Dungeon_JobName001"]="Kỵ Sĩ Phù Văn",
    ["Re0_Dungeon_JobName002"]="Vệ Sĩ Hoàng Gia",
