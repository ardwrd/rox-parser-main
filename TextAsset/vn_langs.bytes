    ["DialogueOption20876011"]="Làm sao cậu biết được?",
    ["DialogueOption20876021"]="Giới thiệu về Regenbeile...",
    ["DialogueOption20876031"]="Vậy cậu…",
    ["DialogueOption20876041"]="Đặt giá",
    ["DialogueOption20876051"]="Bạn muốn cái này để làm gì?",
    ["DialogueOption20877011"]="Phần thưởng của bạn?",
    ["DialogueOption20877021"]="?",
    ["DialogueOption20877041"]="...",
    ["DialogueOption20877071"]="(Rơi vào trầm tư)",
    ["DialogueOption20877081"]="? !",
    ["DialogueOption20877082"]="Hãy trả lại trái tim rồng cho tôi! ! !",
    ["DialogueOption20878011"]="Thực ra…",
    ["DialogueOption20878021"]="(chia sẻ thông tin)",
    ["DialogueOption20878031"]="Nếu như…",
    ["DialogueOption20879011"]="Ồ!",
    ["DialogueOption20879021"]="Bạn đang theo dõi tôi hả?",
    ["DialogueOption20879022"]="Cậu làm sao vậy?",
    ["DialogueOption20879051"]="Ta đến để...",
    ["DialogueOption20879071"]="Tôi sẽ giúp bạn hỏi?",
    ["DialogueOption20890011"]="Còn rất nhiều……",
    ["DialogueOption20890051"]="Hãy giao cho ta đi.",
    ["DialogueOption20891011"]="Còn việc lựa chọn chủ đề của bạn thì sao?",
    ["DialogueOption20892011"]="Sao thế?",
    ["DialogueOption20892021"]="Hàng hóa gì?",
    ["DialogueOption20892041"]="(đặt câu hỏi)",
    ["DialogueOption20892051"]="Tôi sẽ đi cùng bạn!",
    ["DialogueOption20893081"]="Bạn muốn bao nhiêu?",
    ["DialogueOption20894011"]="Ba bộ phận phát triển?",
    ["DialogueOption20895011"]="(Nói rõ thân phận)",
    ["DialogueOption20896011"]="Lẽ nào bạn cũng?",
    ["DialogueOption20896021"]="Có thể xin quyền cho bạn",
    ["DialogueOption20896022"]="Chờ về tới Prontera",
    ["DialogueOption20896031"]="...",
    ["DialogueOption20896041"]="Là ý gì vậy?",
    ["DialogueOption20896051"]="(Bán tín bán nghi)",
    ["DialogueOption20896061"]="Để tôi tới Geffen giúp bạn",
    ["DialogueOption20896062"]="Mới là mục đích của bạn",
    ["DialogueOption20896081"]="Hứa như vậy nhé!",
    ["DialogueOption20897031"]="(Giải thích ngọn nguồn)",
    ["DialogueOption20897071"]="???",
    ["DialogueOption20898011"]="Bạn không sao chứ?",
    ["DialogueOption20898021"]="Có gì khác biệt sao",
    ["DialogueOption20898041"]="Tôi đột nhiên cảm thấy",
    ["DialogueOption20898042"]="Lúc nãy không cần tôi cứu",
    ["DialogueOption20900011"]="Tại sao?!",
    ["DialogueOption20900021"]="Bạn muốn tôi <color=#CA2E0AFF>đi theo</color> chúng?",
    ["DialogueOption20901011"]="Tôi cõng bạn đi!",
    ["DialogueOption20901012"]="Tôi sẽ đuổi theo một mình!",
    ["DialogueOption20901051"]="Dừng lại",
    ["DialogueOption20902011"]="Phải tách ra hợp tác sao",
    ["DialogueOption20902031"]="Đây là do bạn cài đặt phải không",
    ["DialogueOption20903011"]="(Kể chuyện đã trải qua)",
    ["DialogueOption20903021"]="(Chỉ ra tất cả vị trí)",
    ["DialogueOption20903031"]="Sao vậy?",
    ["DialogueOption20904011"]="Đã xảy ra chuyện gì vậy",
    ["DialogueOption20904021"]="Bên phía Morroc thì sao",
    ["DialogueOption20904041"]="(Nhìn đôi mắt thâm quầng của anh ấy)",
    ["DialogueOption20904061"]="(Chuyển lời của Sun Euin)",
    ["DialogueOption20906051"]="Cái gì?!",
    ["DialogueOption20969021"]="Đó có phải là phiến đá của Shikodi không?",
    ["DialogueOption20970011"]="Tôi có cần phải làm gì không?",
    ["DialogueOption20971031"]="Có phải họ không?",
    ["DialogueOption20972011"]="(Nói lý do đến)",
    ["DialogueOption20972021"]="Đúng vậy.",
    ["DialogueOption20972061"]="Hãy giao cho ta đi.",
    ["DialogueOption20974011"]="Bạn……",
    ["DialogueOption20975011"]="Điều gì đã xảy ra với phiến đá?",
    ["DialogueOption20975021"]="Tôi lập tức tới thành phố cổ",
    ["DialogueOption20976021"]="Nhưng tôi đang ở thời điểm hiện tại",
    ["DialogueOption20976022"]="Có lý do để trở nên mạnh mẽ hơn",
    ["DialogueOption20976031"]="Tương lai không phải của riêng tôi",
    ["DialogueOption20976032"]="Nó thuộc về rất nhiều người",
    ["DialogueOption20976071"]="Ta hiểu rồi!",
    ["DialogueOption20977011"]="Phải làm gì đây?",
    ["DialogueOption20977021"]="Đúng<color=#CA2E0AFF>Học viện Kritula</color>…",
    ["DialogueOption20977031"]="<color=#CA2E0AFF>Người cố vấn nghề nghiệp lần đầu tiên</color>…",
    ["DialogueOption20978021"]="(Nói lý do đến)",
    ["DialogueOption20978031"]="Đó là gì?",
    ["DialogueOption20978061"]="…Ta hiểu rồi",
    ["DialogueOption20979011"]="(Nói lý do đến)",
    ["DialogueOption20979021"]="Nó là người bạn đồng hành quan trọng của tôi",
    ["DialogueOption20981021"]="Bạn cũng sẽ ở đó chứ?",
    ["DialogueOption20983021"]="Tất cả chúng sinh?",
    ["DialogueOption20987011"]="(kể lại kinh nghiệm)",
    ["DialogueOption21025011"]="Kẻ thù từ thế giới khác?",
    ["DialogueOption21025041"]="Ta hiểu rồi!",
    ["DialogueOption21026011"]="đây rồi....",
    ["DialogueOption21026021"]="Đây là một thế giới khác với thế giới của bạn. ",
    ["DialogueOption21026031"]="Hãy nói với nữ thần",
    ["DialogueOption21026041"]="Lắc Đầu",
    ["DialogueOption21026051"]="Để tôi giúp",
    ["DialogueOption21026061"]="Đó là sự hướng dẫn của nữ thần",
    ["DialogueOption21027011"]="Không có gì nhiều xảy ra ngày hôm nay!",
    ["DialogueOption21027021"]="Gì cơ?",
    ["DialogueOption21027022"]="Đương nhiên!",
    ["DialogueOption21027041"]="Không chắc chắn...",
    ["DialogueOption21027042"]="Nhưng...",
    ["DialogueOption21027051"]="Tôi có thể giúp bạn có được công việc của người đó",
    ["DialogueOption21027061"]="Phải mất một chút nỗ lực.",
    ["DialogueOption21028011"]="Tôi đang tìm...",
    ["DialogueOption21028021"]="Rất tốt?",
    ["DialogueOption21028031"]="Được rồi!",
    ["DialogueOption21028041"]="Sao thế?",
    ["DialogueOption21028051"]="Được rồi...",
    ["DialogueOption21029011"]="thức dậy...",
    ["DialogueOption21029021"]="Tôi ở đây...",
    ["DialogueOption21029031"]="nắm đấm",
    ["DialogueOption21029041"]="Tôi không muốn cuộc sống vĩnh cửu...",
    ["DialogueOption21029042"]="Tôi chỉ muốn có một tập thơ...",
    ["DialogueOption21030011"]="Tôi nghĩ...",
    ["DialogueOption21030021"]="Nó như thế này...",
    ["DialogueOption21030031"]="Tôi sẽ chịu trách nhiệm!",
    ["DialogueOption21030041"]="bọc nó cho tôi",
    ["DialogueOption21030101"]="Lạ thật, sao lại có người tìm được đến đây...",
    ["DialogueOption21030201"]="Chà, khá lắm…",
    ["DialogueOption21030301"]="Chà, khá lắm…",
    ["DialogueOption21030401"]="Tốt lắm, tốt lắm!",
    ["DialogueOption21030501"]="Đầu... chóng mặt quá... khó chịu...",
    ["DialogueOption21030601"]="Sắc xong rồi, thuốc còn nóng, mau rót ra đi!",
    ["DialogueOption21031011"]="Không cần!",
    ["DialogueOption21031101"]="Ôi! Bị phát hiện rồi!",
    ["DialogueOption21031201"]="Oh... Cô dâu của ta trở về rồi!",
    ["DialogueOption21031301"]="Ọe, mấy thứ này gớm ghiếc quá... Odin à, mùi này...",
    ["DialogueOption21031401"]="Tất cả đều vì tình yêu... Ọe... Ta sắp nghẹt thở rồi...",
    ["DialogueOption21031501"]="Mong là Heflee sẽ thích... Ọe!",
    ["DialogueOption21031601"]="Ai? Kẻ nào to gan dám xúc phạm đến tôn nghiêm của ngài Osiris!",
    ["DialogueOption21031701"]="Á, tiêu rồi tiêu rồi, trên này toàn là nước miếng của Cáo Đen...",
    ["DialogueOption21031801"]="Ồ, cảm ơn rất nhiều! Cậu xem, ngón tay này vẫn đang run run nè!",
    ["DialogueOption21031901"]="Trái tim nóng bỏng đập thình thịch này... thuộc về ngài Osiris!",
    ["DialogueOption21032001"]="Hãy nhìn vầng trán cong này xem, thật cao quý biết bao!",
    ["DialogueOption21032011"]="Bài thơ...",
    ["DialogueOption21032101"]="Vậy thì, chúng ta nên tiếp tục ngủ vùi... Nhà Thám Hiểm, hy vọng không gặp lại cậu.",
    ["DialogueOption21032201"]="Nào nào——tiếp tục khuấy theo chiều kim đồng hồ, cho đến khi nước thuốc sủi bọt lên …",
    ["DialogueOption21032301"]="Tiếp tục——khuấy nó ngược chiều kim đồng hồ, tất cả thành thứ quý giá …",
    ["DialogueOption21033011"]="Vâng, nội dung là...",
    ["DialogueOption21034011"]="Gì cơ?",
    ["DialogueOption21034021"]="Tiểu yêu tinh?",
    ["DialogueOption21034022"]="Đó là cái gì vậy?",
    ["DialogueOption21034041"]="Thành phố phép thuật...",
    ["DialogueOption21034051"]="Cứ Giao nó cho tôi!",
    ["DialogueOption21035011"]="Hãy giải thích ý định của bạn...",
    ["DialogueOption21035031"]="Vui lòng!",
    ["DialogueOption21035032"]="Hãy có sức chứa!",
    ["DialogueOption21035051"]="Tôi sẽ thử nó!",
    ["DialogueOption21036011"]="kể chuyện gì đã xảy ra",
    ["DialogueOption21036021"]="Trừ khi?",
    ["DialogueOption21036022"]="Có chỗ nào để điều động không?",
    ["DialogueOption21036031"]="cô ấy là...",
    ["DialogueOption21036032"]="Nữ thần đã tiên đoán...",
    ["DialogueOption21037011"]="Cảm ơn bạn đã khen ngợi!",
    ["DialogueOption21037021"]="Cảm ơn!",
    ["DialogueOption21038011"]="Thực ra...",
    ["DialogueOption21038031"]="Một chút nỗ lực...",
    ["DialogueOption21039011"]="Tôi ở đây...",
    ["DialogueOption21039021"]="Tôi đi ngay đây!",
    ["DialogueOption21039022"]="Cá khô đã bán hết!",
    ["DialogueOption21039041"]="Được rồi.",
    ["DialogueOption21040021"]="cái đó...",
    ["DialogueOption21040031"]="Hãy giải thích ý định của bạn...",
    ["DialogueOption21040041"]="Một con cá?",
    ["DialogueOption21040051"]="Thế là xong à?",
    ["DialogueOption21041011"]="kể chuyện gì đã xảy ra",
    ["DialogueOption21041021"]="Không hẳn...",
    ["DialogueOption21041022"]="Anh ấy chỉ muốn mua một con cá...",
    ["DialogueOption21041041"]="Hãy để tôi cho bạn thấy kỹ năng của tôi!",
    ["DialogueOption21042021"]="Không có gì.",
    ["DialogueOption21042031"]="Tôi đến giúp cậu!",
    ["DialogueOption21042032"]="Cứ Giao nó cho tôi!",
    ["DialogueOption21050301"]="Ờ ờ, đúng rồi, chính là cái này!",
    ["DialogueOption21050401"]="Bạn cũ của ta, lại đến lúc kề vai chiến đấu rồi.",
    ["DialogueOption23010101"]="Thật là chậm quá... chậm quá!",
    ["DialogueOption23010201"]="(Bong bóng emo ngạc nhiên)",
    ["DialogueOption23010301"]="Oa, cảm ơn rất nhiều!",
    ["DialogueOption23010401"]="Odin ơi, đám thỏ này sao điên khùng vậy?",
    ["DialogueOption23010501"]="Oa, cảm ơn rất nhiều!",
    ["DialogueOption23020101"]="A... đau quá, đau quá!!!",
    ["DialogueOption23020201"]="Oh~ những loại thảo dược này có thể chữa lành vết thương của ta sao?",
    ["DialogueOption23020301"]="Cần phải nhớ rằng, ong thợ là những con quái vật rất nhạy cảm!",
    ["DialogueOption23020401"]="(Bong bóng emo tình yêu)",
    ["DialogueOption23020501"]="(Bong bóng emo ngạc nhiên)",
    ["DialogueOption23020601"]="Mặt đất bị Chùy Thần Sấm nện xuống, dãy núi nứt toạc ra nên được gọi là Mjolnir~♪",
    ["DialogueOption23020602"]="Khu rừng bị bao phủ bởi pháp thuật không gian, là ai đã phá vỡ phong ấn ngàn năm~♪",
    ["DialogueOption23020603"]="Ma lực ngưng tụ cuối cùng sẽ lan tỏa, khiến những loài côn trùng khôn ngoan bị biến dị~♪",
    ["DialogueOption23020604"]="Vị vua mới thống lĩnh quần tộc, xuất hiện dưới sự giám sát của các vị thần~♪",
    ["DialogueOption23020701"]="Cái gì... có chuyện như vậy sao?!",
    ["DialogueOption23020702"]="Ah~ Ah, rõ ràng thật khó tin!",
    ["DialogueOption23020801"]="Có vẻ như nó... sắp chia tách ra rồi?",
    ["DialogueOption23020802"]="Chờ đã, trong đó... nó không phải ong thợ bình thường!",
    ["DialogueOption23030101"]="Nhà Thám Hiểm, chúng tôi có thể nói chuyện chút không?",
    ["DialogueOption23030201"]="Chuyện này... làm sao có thể chứ!",
    ["DialogueOption23030301"]="(Bong bóng emo ngạc nhiên)",
    ["DialogueOption23030401"]="Ta tuyệt đối không cho phép... cậu nuốt chửng tộc người của ta nữa!",
    ["DialogueOption23030501"]="Hu——hu hu hu!!!",
    ["DialogueOption23030601"]="Kể từ hôm nay, ta sẽ dẫn dắt đế chế Ai Cập phát triển thịnh vượng!",
    ["DialogueOption23030602"]="Cùng với nữ hoàng của ta, Eassis!",
    ["DialogueOption23030701"]="Ngài Osiris...",
    ["DialogueOption23030801"]="Cầu mong Anubis phù hộ cho Pharaoh! Bảo vệ nữ hoàng!",
    ["DialogueOption23030901"]="(Bong bóng emo chảy nước miếng)",
    ["DialogueOption23031001"]="Mở mắt ra đi, Pharaoh mê mờ.",
    ["DialogueOption23031002"]="Thể xác đã về với cát bụi, nhưng linh hồn sẽ bất tử!",
    ["DialogueOption23031101"]="Cậu là…",
    ["DialogueOption23031102"]="Thần Bóng Đêm...",
    ["DialogueOption23040101"]="Tất cả là lỗi của ta... ai có thể giúp ta đây...",
    ["DialogueOption23040201"]="Ồ, Bàn Đất Sét này thật sâu!",
    ["DialogueOption23040301"]="Cái... cái gì thế này?",
    ["DialogueOption23040401"]="(Sợ bong bóng emo)",
    ["DialogueOption23040501"]="Nhìn kìa, nó ăn rất vui vẻ~",
    ["DialogueOption23040601"]="(Bong bóng emo vui vẻ)",
    ["DialogueOption23040701"]="Cậu sao vậy?",
    ["DialogueOption23040702"]="Á!",
    ["DialogueOption23040801"]="(Bong bóng emo giận dữ)",
    ["DialogueOption23040901"]="Rosie... tất cả là lỗi của ta...",
    ["DialogueOption23040902"]="Nếu... nếu mọi thứ có thể làm lại...",
    ["DialogueOption23041001"]="Chuyện này... tại sao lại như vậy?!",
    ["DialogueOption23041002"]="Phillas, cầu xin ta!",
    ["DialogueOption23041003"]="Không... Phillas... cứu...",
    ["DialogueOption23041101"]="(Bong bóng emo giận dữ)",
    ["DialogueOption23041201"]="...",
    ["DialogueOption28030101"]="Vậy nhờ cậu nhé!",
    ["DialogueOption28030201"]="(Bong bóng emo nghi ngờ)",
    ["DialogueOption28040101"]="Bây giờ, chúng ta sẽ dâng lên máu của nữ đồng này...",
    ["DialogueOption28040201"]="Vì Ma Thần vĩ đại——ngài Morroc!",
    ["DialogueOption28040301"]="Hu hu... anh ơi...",
    ["DialogueOption28060101"]="(Bong bóng emo vui vẻ)",
    ["DialogueOption30005061"]="Bạn cũ?",
    ["DialogueOption30005071"]="Đây là cái gì?",
    ["DialogueOption30005081"]="Hừm!",
    ["DialogueOption30006041"]="Không ai có thể từ chối Zeny!",
