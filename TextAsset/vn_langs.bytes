    ["GoodsDes3201130"]="Ngọc tròn màu tối, làm lộ rõ đường vân cánh của Ruồi Chúa.",
    ["GoodsDes3201131"]="Trang sức Ruồi Chúa làm bằng ngọc bích, làm lộ rõ vết máu.",
    ["GoodsDes4101019"]="Mũ vành rộng có thể che nắng",
    ["GoodsDes4101027"]="Ngoại hình đầu, chim hót vui trên cành.",
    ["GoodsDes4101037"]="Ngoại hình đầu, mũ đen học sinh hay đội.",
    ["GoodsDes4101057"]="Ngoại hình đầu, mũ của những người lính đồ chơi, đội vào sẽ muốn hành quân.",
    ["GoodsDes4101063"]="Ngoại hình đầu, búp Bê được làm theo ngoại hình của một con mèo rừng điên.",
    ["GoodsDes4101128"]="Mũ mô phòng hình dạng Thần Ếch",
    ["GoodsDes4101129"]="Mũ búp bê rùa dễ thương",
    ["GoodsDes4101184"]="Lắc qua lắc lại rất sinh động",
    ["GoodsDes4101265"]="Tốt nghiệp vui vẻ",
    ["GoodsDes4102004"]="Ngoại hình mặt, trong truyền thuyết, Mặt Nạ Vàng của nữ hoàng từng đeo.",
    ["GoodsDes4102009"]="Mắt kính thợ lặn chuyên dụng",
    ["GoodsDes4102009_001"]="Ngoại hình trên mặt, mắt kính chuyên dụng của thợ lặn. Khi mang trên mặt đất, mọi người sẽ cho rằng bạn bị điên.",
    ["GoodsDes4102022"]="Ngoại hình mặt, khi mắt bị thương dùng để bảo vệ mắt, che mắt đeo trên mắt.",
    ["GoodsDes4102050"]="Tia Hào Quang",
    ["GoodsDes4102051"]="Râu Dài",
    ["GoodsDes4103002"]="Ngoại hình miệng, cá đặc chế có thể dùng miệng ngậm, tỏa ra mùi tanh, nhưng nó đã được gia công đặc biệt, nên sẽ không bị hư.",
    ["GoodsDes4103004"]="Ngoại hình miệng, Pacifier dùng để dỗ dành em bé, nếu nhân vật trẻ em trang bị nó chắc sẽ rất dễ thương!",
    ["GoodsDes4103006"]="Ngoại hình miệng, cánh hoa nhỏ, khi ngậm trong miệng có cảm giác lãng mạn hạnh phúc.",
    ["GoodsDes4107040"]="Bí Điển Học Viện",
    ["GoodsDes_10202323"]="9999 viên đạn thường được Xạ Thủ Thần sử dụng",
    ["GoodsDes_10216168"]="Mở khoá trang trí Đèn Xe Deviruchi của Mô Tô",
    ["GoodsDes_10216169"]="Mở khoá trang trí Đèn Xe Bí Ngô của Mô Tô",
    ["GoodsDes_10216170"]="Mở khoá trang trí Lốp Xe Deviruchi của Mô Tô",
    ["GoodsDes_10216171"]="Mở khoá trang trí Lốp Xe Bí Ngô của Mô Tô",
    ["GoodsDes_10216174"]="Mở khóa phục trang Cuộn Nhẫn Thuật của Cóc Ninja",
    ["GoodsDes_10216175"]="Mở khóa phục trang Kiếm Ninja của Cóc Ninja",
    ["GoodsDes_10216176"]="Mở khóa phục trang Trang Phục Ninja của Cóc Ninja",
    ["GoodsDes_10216177"]="Mở khóa phục trang Dây Buộc Ninja của Cóc Ninja",
    ["GoodsDes_10216230"]="Mở khóa phục trang Mũ Giáp Ngọc May Mắn của Giải Trãi",
    ["GoodsDes_10216231"]="Mở khóa phục trang Mũ Giáp Mắt Quỷ của Giải Trãi",
    ["GoodsDes_10216232"]="Mở khóa phục trang Vòng Như Ý của Giải Trãi",
    ["GoodsDes_10216233"]="Mở khóa phục trang Vòng Rắn Đỏ của Giải Trãi",
    ["GoodsDes_10216243"]="Mở khóa Mũ Thiên Long được trang trí bằng Thiên Long",
    ["GoodsDes_10216244"]="Mở khóa trang phục Mũ Thiên Long Dixin",
    ["GoodsDes_10216245"]="Mở khóa Yên ngựa thánh hiến Thiên Long được trang trí",
    ["GoodsDes_10216246"]="Mở khóa Yên ngựa Trung tâm Trái đất Tianlong được trang trí",
    ["GoodsDes_10216250"]="Mở khóa trang phục Mũ Bạc Phantom Sói Quỷ Gió",
    ["GoodsDes_10216251"]="Mở khóa chiếc mũ vàng của Sói Quỷ Gió",
    ["GoodsDes_10216252"]="Mở khóa Yên ngựa ma thuật sói quỷ gió mặc trang phục",
    ["GoodsDes_10216253"]="Mở khóa yên vàng của Sói Quỷ Gió",
