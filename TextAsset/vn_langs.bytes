    ["ItemDes_10802042"]="Thơ ca ngợi buồn nôn",
    ["ItemDes_10802043"]="Mũi tên gãy nhuốm máu",
    ["ItemDes_10802044"]="Áo lưới tỏa ra ánh sáng kỳ lạ",
    ["ItemDes_10802045"]="Tinh hoa bóng tối tỏa ra hào quang bí ẩn",
    ["ItemDes_10802051"]="Tảo Hôi Hám",
    ["ItemDes_10802052"]="Tuyến Thể Nhầy",
    ["ItemDes_10802053"]="Món ăn Martistine muốn ăn",
    ["ItemDes_10803001"]="Chất lỏng lấy từ cánh hoa Mandragora, là chất dẫn Pháp Thuật rất tốt.",
    ["ItemDes_10803002"]="Nhánh cây có sức mạnh Pháp Thuật, thúc đẩy Ma Cây hành động.",
    ["ItemDes_10803003"]="Bờm lông của Heo Rừng Nhỏ, rất mềm mượt.",
    ["ItemDes_10803004"]="Cỏ non mịn, trông rất ngon.",
    ["ItemDes_10803005"]="Chất độc trên Nấm Quỷ Độc, nghe nói có thể gây ảo giác.",
    ["ItemDes_10803006"]="Lông của Sói Con Sa Mạc, là nguyên liệu da thượng hạng.",
    ["ItemDes_10803007"]="Mật ong của Creamy thu thập, sau khi lên men trong người Creamy có vị rất ngon.",
    ["ItemDes_10803008"]="Quả Thông trong tay con Sóc, tại sao nó lại hủy diệt thế giới?",
    ["ItemDes_10803009"]="Lá cây trông rất bình thường, tại sao lại thu thập nó?",
    ["ItemDes_10803010"]="Lông màu trắng trông rất đẹp.",
    ["ItemDes_10803011"]="Sách ghi lại cách tìm quặng, chỉ có Giearth đọc hiểu được.",
    ["ItemDes_10803012"]="Xúc tua của Hải Quỳ, lấy làm món ăn chắc chỉ có thần ăn được.",
    ["ItemDes_10803013"]="Mảnh Rìu Cùn, trông rất cũ kỹ.",
    ["ItemDes_10803014"]="Mảnh Dao Găm Cùn, trông rất cũ kỹ.",
    ["ItemDes_10803015"]="Thứ trông không nổi bật, thực ra có kịch độc.",
    ["ItemDes_10803016"]="Lõi của Myst, rốt cuộc ẩn chứa bí mật gì?",
    ["ItemDes_10803017"]="Đôi lúc rất khó hiểu được suy nghĩ của những nhà ẩm thực.",
    ["ItemDes_10803018"]="Thứ này sao mà sống được vậy?",
    ["ItemDes_10803019"]="Mảnh vải bình thường, rốt cuộc hoạt động thế nào",
    ["ItemDes_10803020"]="Nghe nói có lịch sử ngàn năm...úi, mùi này khó chịu quá.",
    ["ItemDes_10803021"]="Nghe nói là món ngon được công nhận, chả trách cua lại ghét con người.",
    ["ItemDes_10803022"]="Cốc, cốc...chà, quả nhiên cứng thật.",
    ["ItemDes_10803023"]="Những đôi cánh này...cảm giác như là bị tháo ra chứ không phải cắt? Sao vậy?",
    ["ItemDes_10803024"]="Nón bảo hiểm tượng trưng cho vinh quang Ai Cập Cổ, phải tôn trọng chủ nhân của nó.",
    ["ItemDes_10803025"]="Đây là vây cá sao????",
    ["ItemDes_10803026"]="Cứng nhưng không nặng, đúng là nguyên liệu thần kỳ.",
    ["ItemDes_10803027"]="Nếu không cẩn thận đụng vào sẽ rất khó rửa sạch đó.",
