    ["ultranman_BP_Tips01"]="Tăng %s cấp Sách Quý Ánh Sáng",
    ["ultranman_BP_Tips02"]="Xác nhận mua tăng %s cấp Sách Quý Ánh Sáng không",
    ["ultranman_BP_Tips03"]="Vui lòng xác nhận có mua Sách Quý Ánh Sáng không",
    ["ultranman_BP_Tips04"]="Có xác nhận mua Sách Quý Ánh Sáng không \nHãy lưu ý cấp hiện tại để tránh bị thừa",
    ["ultranman_BP_Tips05"]="Bạn đã mua thành công <color=#e7bb22>Sách Quý Ánh Sáng</color>",
    ["ultranman_BP_Tips06"]="Bạn đã mua thành công <color=#e7bb22>Sách Quý Rực Rỡ</color>, và tăng lên %s cấp",
    ["ultranman_BP_Tips07"]="Sách Quý Ánh Sáng đã đạt cấp tối đa, không cần tiếp tục mua",
    ["unactivatedFuBen"]="Người chơi <color=#e7bb22>%s</color> chưa kích hoạt phó bản hiện tại",
    ["unlockBossTips"]="Đã tắt khóa góc nhìn",
    ["wangpai_ui_tips_001"]="Sự kiện tạm chưa mở",
    ["wangpai_ui_tips_002"]="Không trong thời gian sự kiện, không thể tham gia",
    ["wangpai_ui_tips_003"]="Hiện đang trong trạng thái tổ đội, không thể tham gia sự kiện Thợ Săn Vương Bài",
    ["wangpai_ui_tips_004"]="Đã chủ động thoát sự kiện Thợ Săn Vương Bài, sẽ chịu phạt, trong <color=#75A9E7FF>%s</color>s không thể tham gia lại sự kiện",
    ["wangpai_ui_tips_005"]="Đồng ý thoát Đấu Tranh Bá Thợ Săn Vương Bài?",
    ["wangpai_ui_tips_006"]="Thoát chiến trường trong giai đoạn thi đấu sẽ chịu phạt, trong 10 phút không thể tham gia lại sự kiện",
    ["wangpai_ui_tips_010"]="Đã hết lượt tham gia trong ngày, không thể vào sự kiện",
    ["weathertips0"]="Mây Đen",
    ["weathertips1"]="Kẻ Diệt Cương Thi",
    ["weathertips10"]="Trời Trong",
    ["weathertips11"]="Trời Trong",
    ["weathertips12"]="Trời Xanh",
    ["weathertips13"]="Trời Xanh",
    ["weathertips14"]="Nóng Bức",
    ["weathertips15"]="Nóng Bức",
    ["weathertips16"]="Kẻ Diệt Cương Thi",
    ["weathertips17"]="Lốc Xoáy Cát",
    ["weathertips18"]="Mây Đen",
    ["weathertips19"]="Sấm Chớp",
    ["weathertips2"]="Kẻ Diệt Cương Thi",
    ["weathertips20"]="Mưa Giông",
    ["weathertips21"]="Sấm Điện",
    ["weathertips22"]="Mưa Nhỏ",
    ["weathertips23"]="Mây Đen",
    ["weathertips3"]="Sương Dày",
    ["weathertips4"]="Sương Mờ",
    ["weathertips5"]="Sương Mù",
    ["weathertips6"]="Sương Mù",
    ["weathertips7"]="Kẻ Diệt Cương Thi",
    ["weathertips8"]="Kẻ Diệt Cương Thi",
    ["weathertips9"]="Trời Trong",
    ["worldKVM2_rule_001"]="Step1-Tạo đội",
    ["worldKVM2_rule_002"]="Dùng Pha Lê tạo đội hoặc gia nhập đội khác, sẽ có quyền tham gia Đấu Xếp Hạng",
    ["worldKVM2_rule_003"]="Step2-Đấu Xếp Hạng",
    ["worldKVM2_rule_004"]="Tham gia Đấu Xếp Hạng trong thời gian quy định để nhận điểm, top 64 đội có điểm đứng đầu trong toàn server sẽ có quyền tham gia đấu loại",
    ["worldKVM2_rule_005"]="Step 3-Đấu loại cụm đấu",
    ["worldKVM2_rule_006"]="Các đội thăng hạng của toàn server sẽ được chia vào các cụm đấu khác nhau để đấu loại, xác định đội xuất sắc của cụm đấu",
    ["worldKVM2_rule_008"]="Step 4-Loại kép top 8",
    ["worldKVM2_rule_009"]="Trận top 8 áp dụng thể thức loại kép, đội thua một trận sẽ vào nhánh thua, vẫn có cơ hội giành vô địch",
    ["worldKVM2_rule_01"]="Lưu trình giải đấu",
    ["worldKVM2_rule_011"]="Step5-Hiển thị vinh dự",
    ["worldKVM2_rule_012"]="Công bố thông tin thành viên của đội quán quân và danh sách tuyển thủ MVP các chỉ số",
    ["worldKVM2_rule_014"]="Giai đoạn tạo đội & báo danh",
    ["worldKVM2_rule_015"]="Điều kiện tham gia sự kiện: Cấp Base ≥Lv.45",
    ["worldKVM2_rule_016"]="Có thể dùng Pha Lê để tạo đội Thần Chọn trong giai đoạn tổ đội, Nhà Thám Hiểm phù hợp điều kiện khác có thể gia nhập đội đã tạo để tham gia giải đấu",
    ["worldKVM2_rule_017"]="Sau khi tạo đội, được chiêu mộ đồng đội trong 3 ngày, mỗi đội tối đa có 8 người, khi đội có ít nhất 5 thành viên và tất cả các thành viên đã sẵn sàng báo danh, đội trưởng có thể gửi báo danh theo cách thủ công hoặc hệ thống có thể tự động xác nhận báo danh sau khi kết thúc thời gian báo danh. Nếu số lượng thành viên của đội ít hơn 5, đội sẽ không báo danh được",
    ["worldKVM2_rule_018"]="Đấu Xếp Hạng",
    ["worldKVM2_rule_019"]="Đội thắng điểm cao sẽ nhận được ít điểm hơn, đội thua điểm thấp sẽ mất ít điểm hơn\nĐội thua điểm cao sẽ mất nhiều điểm hơn, đội thắng điểm thấp sẽ được nhiều điểm hơn",
    ["worldKVM2_rule_019A"]="Tăng điểm",
    ["worldKVM2_rule_019B"]="Chiến thắng",
    ["worldKVM2_rule_019C"]="Thắng liền 3 trận nhận thêm",
    ["worldKVM2_rule_019D"]="Thua liền 3 trận bảo đảm thêm",
    ["worldKVM2_rule_019E"]="Thay đổi động",
    ["worldKVM2_rule_019F"]="+10 điểm",
    ["worldKVM2_rule_019G"]="Không trừ điểm",
    ["worldKVM2_rule_019H"]="Tính lại sau khi kích hoạt",
    ["worldKVM2_rule_019I"]="Tính lại sau khi kích hoạt",
    ["worldKVM2_rule_019J"]="Giảm điểm",
    ["worldKVM2_rule_019K"]="Thất bại",
    ["worldKVM2_rule_019L"]="Thoát đấu sau khi ghép đấu và vào trận",
    ["worldKVM2_rule_019M"]="Thay đổi động",
    ["worldKVM2_rule_019N"]="-100 điểm",
    ["worldKVM2_rule_02"]="Quy tắc",
    ["worldKVM2_rule_020"]="Thưởng sẽ được phát theo thứ bậc sau khi kết thúc sự kiện, xem thêm nội dung chi tiết trong Thưởng Giải Đấu",
    ["worldKVM2_rule_020A"]="Bậc",
    ["worldKVM2_rule_020B"]="Phạm vi điểm",
    ["worldKVM2_rule_020C"]="Thiên Thạch",
    ["worldKVM2_rule_020D"]="0-1299",
    ["worldKVM2_rule_020E"]="Đồng",
    ["worldKVM2_rule_020F"]="1300-1599",
    ["worldKVM2_rule_020G"]="Bạc",
    ["worldKVM2_rule_020H"]="1600-1999",
    ["worldKVM2_rule_020I"]="Vàng",
    ["worldKVM2_rule_020J"]="≥2000",
    ["worldKVM2_rule_020K"]="Vương Giả",
    ["worldKVM2_rule_020L"]="≥600",
    ["worldKVM2_rule_021"]="Sau khi kết thúc sự kiện, Top 64 đội có điểm cao nhất toàn server sự kiện nhận được tư cách tham gia Đấu Loại",
    ["worldKVM2_rule_022"]="Đối chiến giải đấu",
    ["worldKVM2_rule_023"]="● Quy tắc Trận Ghép Xếp Hạng\n1. Trong thời gian sự kiện, vào thời gian chỉ định hàng ngày, sử dụng tính năng ghép cặp để tiến hành đấu đối kháng đội, phát thưởng và trừ điểm theo kết quả thắng thua\n2. Giải đấu cần đăng nhập server giải đấu liên server tương ứng để tham gia trận đấu tại thời điểm mở trận đấu ghép cặp\n3. Đấu Xếp Hạng cho phép chế độ Tổ Đội và Đoàn Đội, người tham gia có thể chọn chế độ tổ đội theo số lượng đồng đội\n4. Thành viên đội ≥5 người và đều là thành viên cùng đội Thần Chọn, đội trưởng có thể gửi Ghép\n",
    ["worldKVM2_rule_024"]="● Danh sách Đấu Loại\n  1. Top 64 đội Đấu Xếp hạng toàn server sẽ vào Đấu Loại\n  \n  ● Quy tắc đấu vòng tròn\n  1. Quy tắc đấu vòng tròn nhóm nhỏ: Tất cả các đội Đấu Loại được chia ngẫu nhiên thành 8 khu vực thi đấu, ghép ngẫu nhiên đấu cặp, các đội quán quân mỗi nhóm nhỏ sẽ thi đấu chung kết để xác định Quán Quân mùa giải\n  2. Hình thức chiến đấu giống như Đấu Ghép Xếp Hạng, khi bắt đầu trận chiến, cần đăng nhập vào server liên server tương ứng để tham gia trận đấu trước khi kết thúc thời gian chuẩn bị, nếu không sẽ coi như cá nhân từ bỏ thi đấu vòng này\n  \n  ● Thể thức\n  1. Đấu nhóm nhỏ của cụm đấu 1-8 áp dụng thể thức ba ván thắng hai, đội nào thắng 2 hiệp trước sẽ thắng\n  2. Trận top 8 áp dụng thể thức năm ván thắng ba, và mỗi đội có cơ hội thua kép, đội nào thắng 3 hiệp trước sẽ thắng, đội thắng vào vòng tiếp theo, đội thua vào nhóm thua\n  3. Các đội trong nhóm thua sẽ đấu với các đội thua khác, áp dụng thể thức năm ván thắng ba, đội thắng sẽ vào vòng tiếp theo của nhóm thua, đội thua sẽ trực tiếp bị loại\n  \n  ● Gộp dữ liệu nhân vật\n  1. Trước trận đấu, có thể đồng bộ hóa dữ liệu của bản thân với Server Giải Đấu từ Sứ Giả Cuộc Chiến Thần Chọn \"Sigrdrifa\" trên server có nhân vật, có thể đồng bộ tối đa 2 lần một ngày\n  2. Không thể sử dụng đồng bộ hóa dữ liệu 75 phút trước trận đấu và trong trận đấu, những thời gian khác đều có thể sử dụng, bạn có thể đăng nhập vào Server Giải Đấu 45 phút trước khi trận đấu bắt đầu để chuẩn bị cho trận đấu\n  3. Thay đổi dữ liệu nhân vật ở Server Giải Đấu sẽ không ảnh hưởng đến dữ liệu ở server thường, nhưng ngoại trừ tiêu hao Kim Cương. Vui lòng chú ý tránh thao tác tiêu hao Kim Cương ở Server Giải Đấu, thao tác của người chơi dẫn đến tiêu hao Kim Cương do người chơi hoàn toàn chịu trách nhiệm\n  4. Không thể sử dụng một số đạo cụ Món Ăn trong Server Giải Đấu\n  5. Nếu người chơi tham gia thi đấu có bất kỳ ý kiến nào về thông tin của các nhân vật tham gia thi đấu, vui lòng liên hệ với CSKH kịp thời\n  \n  ● Luật chơi\n  1. Tất cả các trận đấu (bao gồm cả trận xếp hạng và vòng đấu loại trực tiếp), mỗi hiệp có thời gian chiến đấu là 5 phút. Trong thời gian này, 2 hiệp cột đá nhỏ và 1 hiệp trụ đá trung tâm sẽ được kích hoạt. bằng cách tiêu diệt/mở các cột đá. Cuối cùng, bên nào có điểm cao hơn sẽ thắng trò chơi.\n  2. Mỗi lần tiêu diệt được 10 điểm, mỗi trụ nhỏ mở được 100 điểm, mỗi trụ trung tâm mở được 200 điểm.\n  3. Liên quan đến cột đá nhỏ: 3 lần kích hoạt ngẫu nhiên được kích hoạt từ 8 điểm mỗi lần trong 60 giây. Các cột đá chưa được mở sau đó sẽ trở về trạng thái không hoạt động, đồng thời chỉ được phép mở một cột đá. thời gian là 5 giây.\n  4. Liên quan đến cột đá trung tâm: Cột đá trung tâm sẽ được kích hoạt ở vòng cuối cùng và tồn tại cho đến khi kết thúc trận chiến, đồng thời chỉ một người chơi được mở cột đá, thời gian mở là 5 giây.\n  5. Tấn công năng động: Thỉnh thoảng, nếu tổng số lần tiêu diệt của cả hai bên thấp, hiệu ứng tăng sát thương sẽ được trao cho cả hai bên.\n  6. Điểm sinh của cả hai bên cung cấp một khu vực an toàn (cột đá trung tâm sẽ bị loại bỏ sau khi được mở). Cả hai bên sẽ tự động hồi sinh trong khu vực an toàn 10 giây sau khi chết, sức khỏe sẽ đầy. khu vực sẽ mang lại khả năng bất khả chiến bại, cấm tấn công và hiệu ứng phục hồi liên tục. Người chơi rời khỏi Vùng an toàn vẫn có 2 giây bất khả chiến bại.\n  7. Chỉ có thể chuyển đổi kế hoạch đa chuyên nghiệp trong giai đoạn lựa chọn và mỗi ký tự được giới hạn 10 lần.\n  \n  ●Quy tắc đặc biệt cho trận chiến\n  1. Tăng sát thương cuối cùng của tất cả người chơi, tăng giới hạn dưới của ngưỡng sát thương cuối cùng (30%) và tăng ngưỡng trên của hiệu ứng xuyên thấu cuối cùng (700%)\n  Giải thích bổ sung (lấy vật lý làm ví dụ, áp dụng tương tự cho phép thuật):\n  Sự khác biệt giữa tỷ lệ phần trăm chuyển đổi giá trị cố định của khả năng xuyên thấu vật lý của kẻ tấn công + tỷ lệ thâm nhập vật lý cuối cùng của kẻ tấn công – tỷ lệ phần trăm chuyển đổi giá trị cố định của phòng thủ vật lý của bên bị tấn công – tỷ lệ hiệu ứng phòng thủ vật lý cuối cùng của bên bị tấn công nhiều nhất là 700%.\n  2. Những nhân vật có giới hạn sinh mệnh cao hơn 300 triệu sẽ chịu nhiều sát thương hơn khi bị tấn công và mỗi sát thương sẽ được cộng thêm (máu mục tiêu - 300 triệu)/75 sát thương chuẩn.\n  3. Làm suy yếu hiệu ứng hồi máu trong 5 giây (75%) và hiệu ứng hút máu (50%)\n  4. Khi bật cột đá, hiệu ứng \"chúa tể\" và \"miễn dịch với trạng thái tiêu cực\" của chính nó sẽ tạm thời vô hiệu và \"khả năng chống lại trạng thái tiêu cực\" sẽ giảm đi rất nhiều, với giá trị giảm là 1000%.\n  5. Tăng thời gian CD của nghề dịch vụ [Hồi sinh] lên 10 giây và loại bỏ hiệu ứng điểm yếu ban đầu của việc hồi sinh.\n  6. Hiệu ứng chiến đấu của việc trang bị [Sách bí mật vực thẳm] tăng CD tích hợp và thời gian CD là 3 giây.\n  7. Sức mạnh tổng thể của kỹ năng Wind Escape Thunder Cloud của nghề Ninja (bao gồm cả trang bị bóng tối) đã được điều chỉnh thành 40%.\"",
    ["worldKVM2_rule_025"]="● Dự đoán thắng thua\n1. Trong giai đoạn đấu loại, có thể dự đoán kết quả của trận chiến sắp tới, dự đoán cần tiêu hao Huân Chương Thần Chọn\n- Nếu đội dự đoán thua, người dự đoán sẽ mất tiền đặt cược\n- Khi đội dự đoán thắng, người dự đoán sẽ nhận được tiền đặt cược và chia sẻ tổng thu nhập của bên thua, tỷ lệ chia sẻ bằng tổng thưởng của bên thắng/số tiền dự đoán cá nhân\n2. Khi một giải đấu cụ thể phải tái đấu hoặc dừng do các trường hợp đặc biệt, đơn vị tổ chức giải đấu có quyền dừng đặt cược dự đoán cho trận đấu này và trả lại tiền gốc đặt cược\n3. Sau khi trận đấu kết thúc, tạm thời đóng tính năng dự đoán, hoạt động nhận thưởng và vòng cược tiếp theo sẽ được mở vào lúc 12:00 ngày tiếp theo của trận đấu\n\n●Tranh chấp giải đấu\n1. Nếu có bất kỳ sai sót chính thức hoặc tình huống đặc biệt nào trong một giải đấu hoặc giải đấu tổng thể (tức là sự kiện Cuộc Chiến Thần Chọn), thì đơn vị tổ chức có quyền điều chỉnh thời gian giải đấu hoặc tái đấu\n- Tái đấu, các giải đấu tranh chấp bị ảnh hưởng sẽ bị vô hiệu và tiền cược của các giải đấu có vấn đề sẽ được trả lại\n- Thời gian giải đấu được thay đổi, các đội tham gia, quy tắc thi đấu và các giải đấu đã diễn ra sẽ không thay đổi. Vui lòng chú ý đến thông báo chính thức về việc điều chỉnh thời gian cụ thể\n2. Nếu người tham gia thi đấu theo phương thức hoặc chế độ chơi không phù hợp, nhà phát hành có quyền hủy tư cách thi đấu của đội tranh chấp và giải đấu tranh chấp, đồng thời trả lại tiền đặt cược và thưởng của giải đấu tranh chấp\n3. Nhà phát hành có quyền xử phạt các đội gây ảnh hưởng rõ ràng đến việc kiểm soát kết quả trận đấu",
    ["worldKVM2_rule_028"]="Đấu Xếp Hạng",
    ["worldKVM2_rule_029"]="Sau khi kết thúc sự kiện, các phần thưởng có giá trị khác nhau sẽ được phát theo điểm số",
    ["worldKVM2_rule_03"]="Thưởng giải đấu",
    ["worldKVM2_rule_030"]="Quán Quân Một Server",
    ["worldKVM2_rule_031"]="Khi kết thúc Trận Ghép Xếp Hạng, điểm là hạng 1 toàn server (Thưởng Thú Cưỡi không thể nhận nhiều lần)",
    ["worldKVM2_rule_032"]="Đấu loại liên SV",
    ["worldKVM2_rule_033"]="Vào mỗi vòng thành công có thể nhận được thưởng tương ứng (Thưởng Thú Cưỡi không thể nhận nhiều lần)",
    ["worldKVM2_rule_034"]="Mùa giải MVP",
    ["worldKVM2_rule_035"]="Kết thúc sự kiện, đánh giá MVP các nghề",
    ["worldKVM2_rule_036"]="Điểm: %s",
    ["worldKVM2_rule_037"]="● Thời gian mở sự kiện: 21:30-22:30 hàng ngày\n● Trong thời gian sự kiện, các đội đối kháng theo tính năng ghép, phát thưởng và trừ điểm theo kết quả thắng thua\n● Quy tắc tổ đội:\n1. Đấu Xếp Hạng cho phép chế độ Tổ Đội và Đoàn Đội, người tham gia có thể chọn chế độ tổ đội theo số lượng đồng đội\n2. Thành viên đội ≥5 người và đều là thành viên <color=#ff646f>cùng đội Thần Chọn</color>, đội trưởng có thể phát động Ghép\n3. Trận chiến ghép cặp cần tiến hành trong Server Giải Đấu độc quyền",
    ["worldKVM2_rule_038"]="Đấu Xếp Hạng",
    ["worldKVM2_rule_039"]="Giai đoạn công khai",
    ["worldKVM2_rule_040"]="Số lượng Huân Chương có: %s",
    ["worldKVM2_rule_041"]="Cụm đấu %s",
    ["worldKVM2_rule_042"]="Đang ghép Thần Chọn",
    ["worldKVM2_rule_043"]="Dùng %s Huân Chương để cược không!",
    ["worldKVM2_rule_044"]="Tải lên dữ liệu thành công, vui lòng vào server giải đấu để kiểm tra dữ liệu của bản thân",
    ["worldKVM2_rule_045"]="Top 4 đấu tranh vé",
    ["worldKVM2_rule_046"]="Á quân đấu tranh vé",
    ["worldKVM2_rule_047"]="Quán quân Đấu Xếp Hạng",
    ["worldKVM2_rule_048"]="Top 4 đấu nhóm nhỏ",
    ["worldKVM2_rule_049"]="Á quân đấu nhóm nhỏ",
    ["worldKVM2_rule_050"]="Quán quân đấu nhóm nhỏ",
    ["worldKVM2_rule_051"]="Top 4 giải đấu liên SV",
    ["worldKVM2_rule_052"]="Á quân giải đấu liên SV",
    ["worldKVM2_rule_053"]="Quán quân giải đấu liên SV",
    ["worldKVM2_rule_054"]="fmvp",
    ["worldKVM2_rule_055"]="Vua Tiêu Diệt",
    ["worldKVM2_rule_056"]="Vua Sinh Tồn",
    ["worldKVM2_rule_057"]="Vua Điều Trị",
    ["worldKVM2_rule_058"]="Số lượng hiện có: %s",
    ["worldKVM2_rule_059"]="Huân Chương Thần Chọn",
    ["worldKVM2_rule_060"]="Nhận được Huân Chương Thần Chọn",
    ["worldKVM2_rule_061"]="Trong thời gian sự kiện Thần Chọn, tham gia các sự kiện dưới đây sẽ nhận được Huân Chương Thần Chọn",
    ["worldKVM2_rule_062"]="1. Trong thời gian trận đấu<color=#ff646f> (cho đến khi kết thúc chung kết) </color>cứ tiêu hao 1 điểm Chúc Phúc Odin sẽ có 33% xác suất (bao gồm Bonus xác suất rơi Chúc Phúc Odin) nhận được 1 Huân Chương Thần Chọn. Mỗi ngày tối đa nhận được 333 chiếc, cài lại vào 05:00 hàng ngày\n2. Tham gia dự đoán trận đấu, nhận được Huân Chương",
    ["worldKVM2_rule_063"]="2. Độ sôi nổi Lễ Hội mỗi ngày đạt 100, thưởng 70 Huân Chương Thần Chọn",
    ["worldKVM2_rule_064"]="3. Tham gia cách chơi KVM, tích điểm mỗi tuần đạt giá trị chỉ định, sẽ thưởng số lượng Huân Chương Thần Chọn nhất định",
    ["worldKVM2_rule_065"]="Hạng tuần",
    ["worldKVM2_rule_066"]="Số lượng Huân Chương thưởng",
    ["worldKVM2_rule_067"]="1",
    ["worldKVM2_rule_068"]="400",
    ["worldKVM2_rule_069"]="2",
    ["worldKVM2_rule_070"]="350",
    ["worldKVM2_rule_071"]="3",
    ["worldKVM2_rule_072"]="300",
    ["worldKVM2_rule_073"]="4~10",
    ["worldKVM2_rule_074"]="250",
    ["worldKVM2_rule_075"]="11~30",
    ["worldKVM2_rule_076"]="200",
    ["worldKVM2_rule_077"]="31~60",
    ["worldKVM2_rule_078"]="150",
    ["worldKVM2_rule_079"]="61~100",
    ["worldKVM2_rule_080"]="100",
    ["worldKVM2_rule_081"]="101~999",
    ["worldKVM2_rule_082"]="50",
    ["worldKVM2_rule_083"]="4. Tham gia cách chơi Thợ Săn Vương Bài, nhận thưởng số lượng Huân Chương Thần Chọn chỉ định theo bậc mỗi tuần",
    ["worldKVM2_rule_084"]="Hạng tuần",
    ["worldKVM2_rule_085"]="Số lượng Huân Chương thưởng",
