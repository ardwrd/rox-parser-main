    ["BagTips_1"]="Đừng sắp xếp nhiều lần",
    ["BarrageTips_001"]="Không thể gửi bình luận liên tục, hãy đợi chút nhé!",
    ["BarrageTips_002"]="Số chữ quá nhiều, không thể bình luận",
    ["Barrage_001"]="Midgarts! Tui đến rồi đây! ",
    ["Barrage_002"]="Sắp có chuyện hay đấy!",
    ["Barrage_003"]="Thử xíu!",
    ["Barrage_004"]="2333333",
    ["Barrage_005"]="Bình luận đầy màn hình luôn! ",
    ["Barrage_006"]="Ý! Ngộ ghê …",
    ["Barrage_007"]="Trong sách sẽ có sách vàng!",
    ["Barrage_008"]="Búp bê cấm",
    ["Barrage_009"]="Đây là sách bay mà ha ha ha ha",
    ["Barrage_010"]="Thượng lưu~",
    ["Barrage_011"]="Poring nhảy đẹp lắm!!!",
    ["Barrage_012"]="Thật dễ thương hhh",
    ["Barrage_013"]="Kaki chạy đua ~~",
    ["Barrage_014"]="Poring ô nhiễm môi trường = =",
    ["Barrage_015"]="Cái ngoái đầu nhìn lại này! Awsl",
    ["Barrage_016"]="Poring già này không có tay sao mà cầm được gậy phép?",
    ["Barrage_017"]="Người đẹp trai xuất hiện rồi đây",
    ["Barrage_018"]="Đang muốn dùng ngôi sao nện chết ta sao?",
    ["Barrage_019"]="Poring Quốc Vương đã giận đỏ mắt rồi ha ha ha",
    ["Barrage_020"]="Ta không biết gì cả!",
    ["Barrage_021"]="Tên trộm hóa ra là chính ta hhhh",
    ["Barrage_022"]="Ai da, ném lệch rồi~",
    ["Barrage_023"]="Đón tốt lắm quạ đen!",
    ["Barrage_024"]="Quản bao nước thẳm non xa...",
    ["Barrage_025"]="Bò lên không mệt chết sao",
    ["Barrage_026"]="Hiệu ứng này丶đẹp mắt",
    ["Barrage_027"]="A a a mắt của ta!!!",
    ["Barrage_028"]="Ồ Mắt Kính Poring này to quá",
    ["Barrage_029"]="Đừng đập vào vai ta!",
    ["Barrage_030"]="Thuyền trưởng này trông quá quỷ dị",
    ["Barrage_031"]="Đúng vậy, thuyền trưởng đầu bò hhh",
    ["Barrage_032"]="Ồ... có hơi hùng vĩ",
    ["Barrage_033"]="Ta mãi thích Cenia!!!",
    ["Barrage_034"]="Thứ được đặc biệt làm ra này rất đẹp!",
    ["Barrage_035"]="Góc nhìn thứ nhất tuyệt vời của hải âu",
    ["Barrage_036"]="Lại là một thuyền trưởng đầu bò",
    ["Barrage_037"]="Thuật đại triệu hồi!!",
    ["Barrage_038"]="Phép ánh sáng này tuyệt quá ha ha ha",
    ["Barrage_039"]="Cuối cùng cũng chạy xong lưu trình rồi...",
    ["Barrage_040"]="Hoài niệm quá",
    ["Barrage_041"]="Gì mà đủ điều kiện chứ, ta là chuyên nghiệp đấy.",
    ["Barrage_042"]="Nhiều tóc xanh lá quá ha ha",
    ["Barrage_043"]="Người chơi cũ: Bạn còn cách biệt lắm!!!",
    ["Barrage_044"]="Gom bảy viên ngọc rồng",
    ["Barrage_045"]="Đi thám hiểm! Đi chiến đấu! Rồi ăn đòn",
    ["Barrage_046"]="Prontera, ta tới đây!",
    ["Barrage_047"]="Hội nhảy dù vương bài xin xuất chiến!",
    ["Barrage_048"]="Nhảy năm, sống sót một",
    ["Barrage_049"]="You jump! I jump!",
    ["Barrage_050"]="Bay lên! Ù hú~",
    ["Barrage_051"]="Cú đáp tuyệt đẹp, xứng đáng là ta.",
    ["Barrage_052"]="Ha ha ha ha bay xa không ổn đâu",
    ["Barrage_053"]="Hai người này lén lút nhìn đã biết không phải người tốt",
    ["Barrage_054"]="Nói thì thầm gì đó, cho ta nghe với",
    ["Barrage_055"]="Râu dài này được lắm",
    ["Barrage_056"]="Ta lại là anh hùng hiện diện",
    ["Barrage_057"]="Thì ra là ngươi dẫn Ma Cây vào thôn",
    ["Barrage_058"]="Câu chuyện này cho chúng ta biết rằng không nên ngân nga bừa bãi",
    ["Barrage_059"]="Thần Odin sẽ không cứu ngươi, nhưng ta có thể",
    ["Barrage_060"]="Tay nhân vật chính to như vậy, che hết nửa người rồi",
    ["Barrage_061"]="Hào quang nhân vật chính thật sự...",
    ["Barrage_062"]="Chạy, ngươi chạy nữa đi",
    ["Barrage_063"]="Bọ Hoàng Kim có vàng trên người sao? Có bán được không?",
    ["Barrage_064"]="Bánh phu thê có vợ không?",
    ["Barrage_065"]="Chơi trò này không lẽ chưa kết hôn sao? Không phải chứ?",
    ["Barrage_066"]="???",
    ["Barrage_067"]="Tiếng cười này ngông cuồng quá rồi",
    ["Barrage_068"]="Đúng vậy chính là ta, đừng khách sáo",
    ["Barrage_069"]="Ta đã từ bỏ việc trở thành Bọ Hoàng Kim!!",
    ["Barrage_070"]="Không thể nào! Chuyện này không hợp lý!",
    ["Barrage_071"]="Trái Tim Ymir không thất bại, là ngươi đã thất bại",
    ["Barrage_072"]="Thể khí xanh bốc mùi, tiền bối Paul",
    ["Barrage_073"]="Đoàn Kỵ Sĩ Hoàng Gia Hải Lộ Không hh",
    ["Barrage_074"]="Đầu của Đoàn Trưởng này được gắn lên à",
    ["Barrage_075"]="Nhìn đôi mắt to long lanh này đi",
    ["Barrage_076"]="Cháy hay lắm! Cháy tuyệt lắm!",
    ["Barrage_077"]="Nóng quá đi mất~",
    ["Barrage_078"]="Như chúng ta đã biết, bộ xương lửa",
    ["Barrage_079"]="Thuyền trưởng vịt cạp cạp cạp",
    ["Barrage_080"]="Bộ xương không có phổi làm sao hút thuốc",
    ["Barrage_081"]="Đá không gian?",
    ["Barrage_082"]="Thuyền anh ấy siêu to, mời chúng ta đi xem thử",
    ["Barrage_083"]="A a a Cenia ta bị nhập thể rồi",
    ["Barrage_084"]="Biểu cảm vạn năm không đổi",
    ["Barrage_085"]="Cenia không phải là Kiếm Sĩ mà",
    ["Barrage_086"]="Evelyn? Thì ra là Cenia bị góa phụ nhập thể ha ha",
    ["Barrage_087"]="Evelyn này có chút đồ",
    ["Barrage_088"]="Ma nữ kiêu ngạo ha ha ha",
    ["Barrage_089"]="Còn cả hải chiến sao",
    ["Barrage_090"]="Ngươi nghĩ nhiều quá rồi, sao có thể chứ",
    ["Barrage_091"]="Một con bạch tuộc lớn!!",
    ["Barrage_092"]="Bữa tối có rồi, sẽ ăn bạch tuộc",
    ["Barrage_093"]="Trả lại chiếc thuyền của ta TAT",
    ["Barrage_094"]="Ta khóc đấy",
    ["Barrage_095"]="Đại Phó đẹp trai quá!!!",
    ["Barrage_096"]="Bạch tuộc xoắn",
    ["Barrage_097"]="Ta đi một bước rất tốt ha ha ha ha",
    ["Barrage_098"]="Hồn Ma Trắng này khá đáng yêu",
    ["Barrage_099"]="Bạng phụ luộc rồi TAT",
    ["Barrage_100"]="Thuật chuyển sinh đất bẩn!",
    ["Barrage_101"]="A... không biết nói gì sẽ tốt",
    ["Barrage_102"]="Hu hu hu hu về chung một nhà",
    ["Barrage_103"]="Phải, ngươi phải biến mất rồi",
    ["Barrage_104"]="Hả? Hết rồi sao?",
    ["Barrage_105"]="Ta còn nghĩ thuyền trưởng sẽ phản kháng một chút đấy...",
    ["Barrage_106"]="Những chú lùn nhỏ này hài hước quá ha ha ha ha",
    ["Barrage_107"]="Ngủ rồi còn hút thuốc được sao...",
    ["Barrage_108"]="A nhìn hũ rượu này vừa to vừa trắng",
    ["Barrage_109"]="Ha ha ha bị phát hiện rồi ha ha ha ha ha ha ha ha",
    ["Barrage_110"]="Người lùn: Đừng động vào ta a đồ khốn!",
    ["Barrage_111"]="?? Sao lại xúc phạm nhân phẩm của mình",
    ["Barrage_112"]="Thôi bỏ đi, vẫn nên trả mảnh vỡ về lại",
    ["Barrage_113"]="Cô ấy là vợ của ngươi đó!!",
    ["Barrage_114"]="Cứu với, mưu sát vợ rồi, giết người diệt khẩu rồi!",
    ["Barrage_115"]="Một loạt điển hình của việc không đánh không tỉnh ngộ",
    ["Barrage_116"]="Chồng không nghe lời? Đánh một trận là được",
    ["Barrage_117"]="Osiris cứ mãi mặt dày",
    ["Barrage_118"]="Bởi vì mắt cô ấy không tốt",
    ["Barrage_119"]="Ngươi... ngươi bị mù rồi",
    ["Barrage_120"]="Sao ta đi được, cô ấy bơi được/doge",
    ["Barrage_121"]="A a a a phát kẹo rồi!!",
    ["Barrage_122"]="Chúc hai người bền lâu",
    ["Barrage_123"]="Đây thực sự không phải là Thần Sấm sao?",
    ["Barrage_124"]="Ồ, nói chuyện không hợp liền mở điện.",
    ["Barrage_125"]="Thuật Sĩ Luyện Kim đều đeo kính ha ha ha",
    ["Barrage_126"]="Đại Lang, đã đến lúc uống thuốc rồi",
    ["Barrage_127"]="Thì ra là Paul, a ha ha ha, bảo sao ta thấy giống như vậy",
    ["Barrage_128"]="Chương trước mưu sát vợ mình, chương này mưu sát con gái mình",
    ["Barrage_129"]="Boss đều hơi không tỉnh táo!",
    ["Barrage_130"]="Cha mau tỉnh lại đi!!",
    ["Barrage_131"]="Hả? Xảy ra chuyện gì vậy???",
    ["Barrage_132"]="Chương này không phải là kẹo????",
    ["Barrage_133"]="Đáng ghét! Lại là một con dao!!!",
    ["Barrage_134"]="Trả Lucia lại cho ta!!!",
    ["Barrage_135"]="Paul: Chuồn mau",
    ["Barrage_136"]="Nói thật nhé, những quái vật này khá dễ thương",
    ["Barrage_137"]="Các quái vật đã dùng chiến thuật đám đông!",
    ["Barrage_138"]="Ồ, chúng ta cũng là chiến thuật đám đông, vậy thì không sao rồi.",
    ["Barrage_139"]="Paul gây chuyện hàng ngày",
    ["Barrage_140"]="Đừng mà chị hai ơi! Đừng mà thống lĩnh ơi!",
    ["Barrage_141"]="Qi Euin tiêu diệt hắn đi!!",
    ["Barrage_142"]="Trả chị hai lại cho ta T-T",
    ["Barrage_143"]="Baroshev thật kinh tởm...",
    ["Barrage_144"]="Ha ha lại thất bại lần nữa rồi, Paul sẽ trở lại.",
    ["Barrage_145"]="Mau bắn hắn đi! Nhìn thấy mặt hắn là khó chịu.",
    ["Barrage_146"]="Mỗi lần Paul đều có thể tốc biến chạy mất...",
    ["Barrage_147"]="Thống lĩnh hít phải khí không xác định/hài hước",
    ["Barrage_148"]="Một khuôn mặt thật buồn cười ha ha",
    ["Barrage_149"]="Soái ca là ai vậy?",
    ["Barrage_150"]="Trả thù? Xem ta đánh cái đầu chó của anh ta doge",
    ["Barrage_151"]="Orc máu xanh là huyết thống cao quý sao",
    ["Barrage_152"]="Tà không thắng chính!",
    ["Barrage_153"]="Orc Hero tuyên chiến vì sao ta ra trận nhỉ/Cười lăn",
    ["Barrage_154"]="Có khói đen, có định luật con dao",
    ["Barrage_155"]="Mỗi chương của câu chuyện đều tăm tối...",
    ["Barrage_156"]="A... người thân chia xa",
    ["Barrage_157"]="Dracula trông giống như Chú Hề ha ha",
    ["Barrage_158"]="A a, ngươi đánh phụ nữ sao",
    ["Barrage_159"]="Chị gái bị một đòn đánh bay",
    ["Barrage_160"]="Được, tổ đội đánh quái thôi!",
    ["Barrage_161"]="Dracula: Các ngươi ăn gian!!!",
    ["Barrage_162"]="Dracula xinh đẹp đã chết!!!",
    ["Barrage_163"]="Ký ức đau đớn",
    ["Barrage_164"]="Quốc Vương này trông giống như một kẻ xấu",
    ["Barrage_165"]="Đừng uống nó chứ Hermes!!",
    ["Barrage_166"]="Ồ, Quốc Vương này là kẻ biến thái nhỉ",
    ["Barrage_167"]="Tâm tình đang tốt.",
    ["Barrage_168"]="Mau nhìn xem! Biến thái xuất hiện rồi!!!",
    ["Barrage_169"]="Nhát dao này xuống...",
    ["Barrage_170"]="Quan tư lệnh nhìn có vẻ ngây ngốc",
    ["Barrage_171"]="Barr Venter u buồn",
    ["Barrage_172"]="Mau đánh chết tên biến thái này đi!",
    ["Barrage_173"]="Ở ác gặp dữ a ha ha",
    ["Barrage_174"]="Sao Quốc Vương này còn chưa chết?",
    ["Barrage_175"]="Hóa ra Nữ Võ Thần có mắt khác màu",
    ["Barrage_176"]="Thật sự rất tối tăm...",
    ["Barrage_177"]="Không phải, phải tàn sát hàng loạt dân trong thành sao?",
    ["Barrage_178"]="Biến hình này bắt mắt quá!",
    ["Barrage_179"]="Hermes đầu óc không tỉnh táo",
    ["Barrage_180"]="Một người nhìn khá đặc biệt...",
    ["Barrage_181"]="Sắc mặt nhợt nhạt",
    ["Barrage_182"]="Có được không đấy Thanatos?",
    ["Barrage_183"]="Nam nữ kết hợp diệt quái không mệt",
    ["Barrage_184"]="Tại sao thứ này lại xuất hiện rồi",
    ["Barrage_185"]="Rốt cuộc đâu mới là Boss cuối",
    ["Barrage_186"]="Star Ương Ca",
    ["Barrage_187"]="Giận quá đi Raymond",
    ["Barrage_188"]="Thợ máy?",
    ["Barrage_189"]="Mau thả anh ấy ra!!",
    ["Barrage_190"]="Con dao trên tay Raymond khá đẹp, cho hỏi mua ở đâu vậy",
    ["Barrage_191"]="Lại một người khác không sợ chết",
    ["Barrage_192"]="Raymond tìm chỗ chết ha ha",
    ["Barrage_193"]="Tự làm tự chịu",
    ["Barrage_194"]="Da bụng con rối quỷ lớn quá a ha ha",
    ["Barrage_195"]="Đừng chạy mà Raymond, ngươi sợ gì vậy",
    ["Barrage_196"]="Ta chỉ cần chống đỡ được là xong chuyện rồi.",
    ["Barrage_197"]="Người đâu!! Có sát thủ",
    ["Barrage_198"]="Sát thủ này trông thích thú quá a ha ha",
    ["Barrage_199"]="Trông rất ngọt ngào!",
    ["Barrage_200"]="T-T Ta cũng muốn một đám cưới như thế",
    ["Barrage_201"]="Chúc phúc họ!",
    ["Barrage_202"]="Thả em gái đó ra!!",
    ["Barrage_203"]="Đến lượt anh hùng cứu mỹ nhân của ta rồi",
    ["Barrage_204"]="Bạn tốt bên nhau suốt đời",
    ["Barrage_205"]="Cảm động trái tim hu hu hu",
    ["Barrage_206"]="Lucy bị sao vậy!!",
    ["Barrage_207"]="Ôi trời, hóa ra là quái vật máy...",
    ["Barrage_208"]="Ồ làm ta sợ quá, mặt nạ này lỏng lẻo quá",
    ["Barrage_209"]="Ta thấy Barr Venter mới là chính cung của Thanatos",
    ["Barrage_210"]="Ha ha ha Lucy ghen rồi!",
    ["Barrage_211"]="Ala... darabeng nhỉ?",
    ["Barrage_212"]="Tín đồ ngu ngốc...",
    ["Barrage_213"]="Tiếng chim gì đây chứ ha ha ha",
    ["Barrage_214"]="Người này không bị thiêu chết chứ?...",
    ["Barrage_215"]="Phong cách hài hước",
    ["Barrage_216"]="Cha ngươi tới rồi!!",
    ["Barrage_217"]="Mau dạy dỗ đứa con bất hiếu này đi.",
    ["Barrage_218"]="Loli nhỏ dễ thương quá!",
    ["Barrage_219"]="A Vĩ chết rồi!!!",
    ["Barrage_220"]="Cuối cùng cũng đoàn tụ...",
