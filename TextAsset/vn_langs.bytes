    ["Re0_Dungeon_WeaponShortName074"]="Phần trăm máu mục tiêu giảm",
    ["ReNameCD"]="Trong 3 ngày chỉ được đổi tên 1 lần!",
    ["ReasoningDialogue7001"]="Sử dụng những manh mối có được để suy luận về sự kiện",
    ["ReasoningDialogue7002"]="Giữa làng Einberg và máy móc<color=#CA2E0AFF>mâu thuẫn</color>Đã lâu lắm rồi, trời cũng không lạnh như một ngày...",
    ["ReasoningDialogue7003"]="Dân làng ghét máy móc và sợ hãi sức mạnh của nó. Ngay cả chính họ cũng nghĩ như vậy.<color=#CA2E0AFF>Nhân loại cuối cùng sẽ được thay thế</color>…",
    ["ReasoningDialogue7004"]="<color=#CA2E0AFF>Những cỗ máy có tính cách độc lập cố gắng thống trị con người</color>, đây không phải là điều vô nghĩa. Bác sĩ Miriam, tôi đã kể cho ông nghe chuyện này...",
    ["ReasoningDialogue7005"]="Nhưng sau nhiều năm đau khổ, con người dường như đã<color=#CA2E0AFF>Mất động lực chiến đấu</color>, đặc biệt là ngôi làng Ayinbehe, ở mức thấp nhất...?",
    ["ReasoningDialogue7006"]="Không, đó không phải là điều đã xảy ra. Hãy nghĩ lại xem.",
    ["ReasoningDialogue7007"]="Vâng, thế thôi",
    ["ReasoningDialogue8002"]="Tuy nhiên, máy móc, trong môi trường như vậy, dần dần<color=#CA2E0AFF>thấm vào toàn bộ cuộc sống con người</color>…",
    ["ReasoningDialogue8003"]="Nếu kế hoạch thất bại, viện sẽ không cho bạn và dân làng đi mà sẽ chia sẻ khó khăn với bạn...?",
    ["ReasoningDialogue8004"]="140 hy vọng trở thành người bạn đồng hành của nhân loại nhưng chưa bao giờ được công nhận. Bạn mơ hồ lo lắng, liệu anh ấy có cảm thấy bực bội vì điều này không?",
    ["ReasoningDialogue8005"]="Trong trái tim của 140, kẻ thù thực sự của anh là ai...? !",
