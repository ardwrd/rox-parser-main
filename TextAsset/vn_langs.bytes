    ["SEA_YearMemoirShareDes_001"]="%s, tôi đến Vương Quốc Rune với danh nghĩa %s...",
    ["SEA_YearMemoirShareDes_002"]="Tinh Luyện tổng cộng <color=#ecc993>%s</color> lần, hiện cấp cao nhất là Tinh Luyện +<color=#ecc993>%s</color>",
    ["SEA_YearMemoirShareDes_003"]="<color=#ecc993>%s</color> lần MVP&MINI, <color=#ecc993>%s</color> lần Phó Bản, trở thành thợ săn quái vật huyền thoại!",
    ["SEA_YearMemoirShareDes_004"]="Đã làm quen được <color=#ecc993>%s</color> nhà thám hiểm trong ROX.",
