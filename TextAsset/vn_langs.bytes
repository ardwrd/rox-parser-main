    ["Album_tips1"]="Hiện chưa mở chức năng này",
    ["Album_tips2"]="Có muốn xóa tấm ảnh này không?",
    ["AlreadyDeposited"]="Đã có trang bị trùng tên trong tủ áo.",
    ["AlreadyDie"]="Trong trạng thái tử vong không thể thoát Phó Bản",
    ["AlreadyHavePendant"]="Bạn đã có mặt dây chuyền này rồi!",
    ["AlreadyInGuildTerritory"]="Bạn đã ở trong lãnh địa Công Hội",
