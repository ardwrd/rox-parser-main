    ["DialogueOption35502051"]="Tại sao lại là mười?",
    ["DialogueOption35503011"]="Không có",
    ["DialogueOption35503012"]="có!",
    ["DialogueOption35602011"]="Ta nghĩ…",
    ["DialogueOption35602021"]="bạn có thể giúp tôi được không?",
    ["DialogueOption35702021"]="!!!",
    ["DialogueOption35702041"]="A???",
    ["DialogueOption35703011"]="(Kể chuyện đã trải qua)",
    ["DialogueOption35703021"]="(giơ vũ khí)",
    ["DialogueOption35802021"]="(Explain why you came.)",
    ["DialogueOption35802031"]="Then...?",
    ["DialogueOption35803011"]="(Proudly) Well, I am...",
    ["DialogueOption35803021"]="(Embarrassed, scratching your head)",
    ["DialogueOption35803022"]="(Stand with your hands on the hips, full of pride)",
    ["DialogueOption35803051"]="Of course! I...",
    ["DialogueOption35804011"]="So...?",
    ["DialogueOption35901021"]="So...?",
    ["DialogueOption35902011"]="No, I still...",
    ["DialogueOption35902021"]="Could it be...?",
    ["DialogueOption35902041"]="So you want me to...?",
    ["DialogueOption35902051"]="How do I find the spirit?",
    ["DialogueOption35902052"]="How do I unseal the spirit?",
    ["DialogueOption35902071"]="Creator?",
    ["DialogueOption35902072"]="Protector?",
    ["DialogueOption35902073"]="Destroyer?",
    ["DialogueOption35902091"]="(Nod) Got it.",
    ["DialogueOption35903011"]="Hello?",
    ["DialogueOption35903021"]="... What do you mean?",
    ["DialogueOption35903041"]="(Pick it up) This is...?",
    ["DialogueOption36002011"]="... What?",
    ["DialogueOption36002021"]="... Stop messing around.",
    ["DialogueOption36002031"]="I want to become...",
    ["DialogueOption36002041"]="A real death...?",
    ["DialogueOption36002042"]="A fake death...?",
    ["DialogueOption36003021"]="Rogue's determination!",
    ["DialogueOption36003031"]="Probably??",
    ["DialogueOption36004011"]="Are you... Zorser?",
    ["DialogueOption36004021"]="What do you want?",
    ["DialogueOption36005011"]="???",
    ["DialogueOption36005021"]="... Not interested.",
    ["DialogueOption36102011"]="You are so dramatic...",
    ["DialogueOption36102031"]="(Whack him with the harp)",
    ["DialogueOption36102032"]="(Lash him with the whip)",
    ["DialogueOption3610301"]="It's been a while, Adventurer. I can tell your skill has improved a lot.",
    ["DialogueOption36103031"]="A bard must first tell their own tale...?",
    ["DialogueOption36103032"]="A dancer must find joy in themselves...?",
    ["DialogueOption36103081"]="You mean...?",
    ["DialogueOption36103091"]="(Lost in thought)",
    ["DialogueOption36103101"]="... I'll give it a try.",
    ["DialogueOption36107031"]="... Blank page?",
    ["DialogueOption36107032"]="(Realizing something) I got it!",
    ["DialogueOption36107041"]="Thank you, Kiki!",
    ["DialogueOption36108011"]="I want to be...",
    ["DialogueOption36108012"]="A blank page, always.",
    ["DialogueOption36108021"]="Because...",
    ["DialogueOption36108071"]="(Eagerly) So I...?",
    ["DialogueOption36202011"]="Hi there!",
    ["DialogueOption36202021"]="???",
    ["DialogueOption36202041"]="... Not interested.",
    ["DialogueOption36203011"]="(Nod)",
    ["DialogueOption36203021"]="Evolution Potion?",
    ["DialogueOption36203041"]="... Why?",
    ["DialogueOption36203051"]="What's the second rule?",
    ["DialogueOption36203071"]="Of course!",
    ["DialogueOption36205031"]="(Nod)",
    ["DialogueOption36205032"]="(Shake head)",
    ["DialogueOption36205051"]="What about the class advancement...?",
    ["DialogueOption36205071"]="!!!",
    ["DialogueOption36205081"]="Thank you!",
    ["DialogueOption36302021"]="(Proudly) I've already...",
    ["DialogueOption36302041"]="I'm going now!",
    ["DialogueOption36303021"]="So...?",
    ["DialogueOption36303031"]="Bring it on!",
    ["DialogueOption36304011"]="... Meaning those Buddha statues?",
    ["DialogueOption36304021"]="And then?",
    ["DialogueOption36305011"]="(Show the Flame of Exorcism.)",
    ["DialogueOption36305021"]="Who exactly are they...?",
    ["DialogueOption36305031"]="!!!",
    ["DialogueOption36305051"]="I will!",
    ["DialogueOption38801011"]="Cô nhi viện?",
    ["DialogueOption38801021"]="Đã xảy ra chuyện gì vậy?",
    ["DialogueOption38801031"]="Không thành vấn đề.",
    ["DialogueOption38801051"]="(Gật đầu)",
    ["DialogueOption38801061"]="Được, cảm ơn anh.",
    ["DialogueOption38802011"]="(Nghi ngờ) Ông là...?",
    ["DialogueOption38802021"]="(Gật đầu) Đúng là tôi.",
    ["DialogueOption38802031"]="Ở đây.",
    ["DialogueOption38803011"]="À thì, nghe nói...?",
    ["DialogueOption38803021"]="... Cô bé đã mất tích bao lâu rồi?",
    ["DialogueOption38804011"]="Sao, sao vậy?!",
    ["DialogueOption38804021"]="Tôi không phải là...",
    ["DialogueOption38804031"]="Cô nghe tôi giải thích...",
    ["DialogueOption38804041"]="Cô gặp khó khăn gì?",
    ["DialogueOption38804042"]="Tôi đều sẵn sàng giúp đỡ.",
    ["DialogueOption38804061"]="(Gật đầu) Nhìn thấy rồi.",
    ["DialogueOption38804071"]="Những thứ này đâu thể ăn được?",
    ["DialogueOption38805011"]="(Do dự) Những thứ này...",
    ["DialogueOption38805031"]="Cô biết cô bé ở đâu ư?",
    ["DialogueOption38805051"]="Petra là...?",
    ["DialogueOption38806011"]="Anh có thể chơi cùng không?",
    ["DialogueOption38806031"]="(Mỉm cười) Được.",
    ["DialogueOption38807021"]="(Mỉm cười) Cảm ơn em!",
    ["DialogueOption38807041"]="Không được ăn!!!",
    ["DialogueOption38807061"]="Ở đây anh có đồ ăn ngon.",
    ["DialogueOption38808021"]="Anh cũng muốn làm bạn với em.",
    ["DialogueOption38808022"]="Vậy nên...",
    ["DialogueOption38808041"]="... Các em rất ghét em ấy sao?",
    ["DialogueOption38808061"]="Vậy bây giờ cô bé ấy...?",
    ["DialogueOption38809011"]="Tại sao em lại bắt nạt người khác?",
    ["DialogueOption38809021"]="Em rất thông minh nhỉ?",
    ["DialogueOption38809031"]="Martistine nói...?",
    ["DialogueOption38809041"]="(Hỏi) Em...",
    ["DialogueOption38809051"]="... (Giơ nắm đấm)",
    ["DialogueOption38810011"]="Sau này còn dám không...",
    ["DialogueOption38810021"]="Ghế bập bênh cũng phải cùng chơi.",
    ["DialogueOption38810031"]="Cũng không được bắt nạt người khác nữa.",
    ["DialogueOption38810041"]="... Ai nói vậy?",
    ["DialogueOption38810051"]="(Buông tay ra)",
    ["DialogueOption38810052"]="Ông ta nói sai rồi.",
    ["DialogueOption38810061"]="Đọc nhiều sách sẽ hiểu.",
    ["DialogueOption38810071"]="Em biết cô bé ở đâu ư?",
    ["DialogueOption38810081"]="...?",
    ["DialogueOption38811011"]="(Nói lý do đến)",
    ["DialogueOption38811021"]="...?",
    ["DialogueOption38811051"]="Và rồi cô bé biến mất?",
    ["DialogueOption38811081"]="(Thở dài) Để tôi thử xem.",
    ["DialogueOption38901091"]="(Kéo Andre lại)",
    ["DialogueOption38901111"]="Chuyện này...",
    ["DialogueOption38902011"]="Lời của Lyra...",
    ["DialogueOption38902031"]="Vậy vừa rồi anh còn...",
    ["DialogueOption38902041"]="?",
    ["DialogueOption38902061"]="Anh còn đọc cả sách sao?",
    ["DialogueOption38902062"]="Kết luận là gì?",
    ["DialogueOption38903021"]="(Nói lý do đến)",
    ["DialogueOption38903041"]="Gì cơ?",
    ["DialogueOption38903051"]="Cứ giao cho tôi.",
    ["DialogueOption38904011"]="Không thể truy tìm nguồn gốc ư?",
    ["DialogueOption38904031"]="(Rơi vào suy tư)",
    ["DialogueOption38904041"]="Vẫn muốn xin chỉ bảo thêm",
    ["DialogueOption38904042"]="Ý nghĩa của các ký tự",
    ["DialogueOption38904061"]="Tôi còn có một câu...",
    ["DialogueOption38904062"]="Về thần lực Ymir…",
    ["DialogueOption38905011"]="(Nói lý do đến)",
    ["DialogueOption38905021"]="Juno cũng có sao?",
    ["DialogueOption38905041"]="Tới xem văn tự trong Thành Phố Juno",
    ["DialogueOption38905051"]="Đã suy nghĩ kỹ rồi.",
    ["DialogueOption38906011"]="Sao vậy?",
    ["DialogueOption38906021"]="Về ba bức ảnh đó...",
    ["DialogueOption38906031"]="Ý ông là...",
    ["DialogueOption38906051"]="(Rơi vào suy tư)",
    ["DialogueOption38906061"]="Ý ông là?",
    ["DialogueOption38906081"]="... Ý nghĩa của ký tự",
    ["DialogueOption38906082"]="Có lẽ là thần lực Ymir",
    ["DialogueOption38907061"]="!!!",
    ["DialogueOption38908061"]="Bây, bây giờ?",
    ["DialogueOption38909031"]="(Nói sự thật)",
    ["DialogueOption38909032"]="(Có phần che giấu)",
    ["DialogueOption38909061"]="Ngài...",
    ["DialogueOption38910031"]="Vậy nên mọi người...",
    ["DialogueOption38910061"]="(Hỏi về giếng của Trang Viên)",
    ["DialogueOption38910071"]="Vậy ngài định làm thế nào?",
    ["DialogueOption38910081"]="Bộ Tình Báo cũng đang điều tra.",
    ["DialogueOption38910091"]="Đúng vậy.",
    ["DialogueOption38910101"]="Ý của ngài là?",
    ["DialogueOption39001011"]="(Nghi ngờ)",
    ["DialogueOption39001012"]="(Lắc đầu)",
    ["DialogueOption39001041"]="Tôi có thể giúp gì không?",
    ["DialogueOption39002041"]="Trong đất có gì...?",
    ["DialogueOption39002101"]="Xác nhận thân phận",
    ["DialogueOption39002102"]="Rửa sạch thi thể",
    ["DialogueOption39003011"]="Lẽ nào...?",
    ["DialogueOption39004061"]="(Dùng sức đá chân anh ta)",
    ["DialogueOption39004071"]="Vậy bọn họ giờ đang ở đâu?",
    ["DialogueOption39004081"]="(Thăm dò) Hay là...?",
    ["DialogueOption39004101"]="(Gật đầu)",
    ["DialogueOption39005071"]="(Lắc đầu)",
    ["DialogueOption39005072"]="Nhưng tôi có thể giúp các người.",
    ["DialogueOption39005091"]="... Hiểu rồi.",
    ["DialogueOption39006041"]="... Tôi?",
    ["DialogueOption39006051"]="Nhưng tôi còn...",
    ["DialogueOption39006061"]="... Được thôi.",
    ["DialogueOption39007011"]="Danh sách đồ dùng",
    ["DialogueOption39007012"]="Tải ảnh lên",
    ["DialogueOption39007051"]="Không thành vấn đề!",
    ["DialogueOption39009011"]="Người đó là...?",
    ["DialogueOption39009031"]="Bảng điều động của Quân Cảnh Vệ ư?",
    ["DialogueOption39010011"]="Nhắc mới nhớ, hôm nay...",
    ["DialogueOption39010021"]="(Gật đầu) Hơn nữa...",
    ["DialogueOption39010031"]="Cho nên tôi nghi ngờ...",
    ["DialogueOption39010041"]="Ngài nghĩ tới điều gì?",
    ["DialogueOption39010051"]="(Tỉnh ngộ) Chúng muốn...",
    ["DialogueOption39010061"]="Vậy chúng ta phải làm sao?",
    ["DialogueOption39010081"]="Được.",
    ["DialogueOption39011021"]="...?!",
    ["DialogueOption39012011"]="(Gật đầu)",
    ["DialogueOption39012021"]="Chúng ta có nên...?",
    ["DialogueOption39012041"]="Vậy ý của ngài là...?",
    ["DialogueOption39012051"]="... Chất độc trên người Aronst ư?",
    ["DialogueOption39012061"]="...?!",
    ["DialogueOption39012071"]="Vậy nên ngài cho rằng...?",
    ["DialogueOption39012081"]="(Gật đầu)",
    ["DialogueOption39012082"]="(Lắc đầu)",
    ["DialogueOption39101011"]="Hướng dẫn Chuyển Nghề...?",
