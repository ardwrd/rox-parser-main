    ["ui_OdinRevisionInstruction_005"]="Khu hiệu lực Chúc Phúc Odin",
    ["ui_OdinRevisionInstruction_006"]="Chỉ số Buff",
    ["ui_OdinRevisionInstruction_007"]="Đạo cụ rơi khi bật Chúc Phúc Odin diệt quái sẽ không bị ảnh hưởng bởi suy giảm cấp độ.\nĐạo cụ rơi khi diệt quái dưới trạng thái thường bị hạn chế từ việc suy giảm cấp độ.",
    ["ui_OdinRevisionInstruction_008"]="Sửa đổi EXP",
    ["ui_OdinRevisionInstruction_009"]="Số lượng nghề",
    ["ui_OfferToBuyPanel_001"]="Vật phẩm có hiệu lực ngay sau khi mua, không thể rút hoặc hoàn lại tiền mặt. \n(Kim Cương trả phí sẽ được tiêu hao trước)",
    ["ui_OfferToBuyPanel_002"]="Mô Tả Vật Phẩm",
    ["ui_OfferToBuyPanel_003"]="Giá Vật Phẩm",
    ["ui_OnePunchManPuzzle_001"]="Khắp lục địa đã xuất hiện Quái Nhân xâm nhập, hãy triệu tập các Anh Hùng để tiêu diệt tai họa",
    ["ui_OnePunchManPuzzle_002"]="\"Có trực giác chiến đấu như dã thú, tốc độ và sức mạnh rất lớn, có đặc điểm bảo vệ lãnh thổ của mình. Có thể tự mình bảo vệ toàn bộ thành phố nơi nó ở. Một khi Quái Nhân đi ra khỏi phạm vi thế lực, sẽ bị bỏ rơi và truy sát.\"",
    ["ui_OnePunchManPuzzle_003"]="Sau khi Chụp Ảnh Check-in",
    ["ui_OnePunchManPuzzle_004"]="Có thể nhận hộp quà do Cảnh Khuyển Nhân chuẩn bị",
    ["ui_OnePunchManPuzzle_005"]="Làm mới lúc 05:00 hàng ngày",
    ["ui_OnePunchManPuzzle_006"]="Điểm Check-in",
    ["ui_OnePunchManPuzzle_007"]="12:00 - 22:00",
    ["ui_OnePunchManPuzzle_008"]="Tổ đội hoặc cá nhân tham gia thoát khỏi phòng thí nghiệm, né nguy hiểm, đến Khu An Toàn, sống sót đến cuối cùng",
    ["ui_OnePunchManPuzzle_009"]="Mặc định mang theo số lượng đạo cụ tối đa",
    ["ui_OnePunchManPuzzle_010"]="Anh Hùng Tập Sự",
    ["ui_OnePunchManPuzzle_011"]="Anh Hùng Hiệp Hội",
    ["ui_OnePunchManPuzzle_012"]="Xác suất nhận",
    ["ui_OpenSystem_001"]="Mở khóa %s",
    ["ui_OriginalHeartGift_001"]="Bảo Hộ Tân Thủ",
    ["ui_OriginalHeartGift_002"]="Quà Có Hạn Tân Thủ",
    ["ui_PVP_001"]="Đối Đầu Vô Hạn",
    ["ui_PVP_002"]="Chọn chế độ số người",
    ["ui_PVP_003"]="2V2",
    ["ui_PVP_004"]="3V3",
    ["ui_PVP_005"]="6V6",
    ["ui_PVP_006"]="Yêu cầu phòng",
    ["ui_PVP_007"]="Nhấp để chọn lối chơi bạn muốn tắt, lối chơi này sẽ giảm xác suất xuất hiện ngẫu nhiên. Càng nhiều người chọn tắt lối chơi này, xác suất lối chơi này xuất hiện ngẫu nhiên càng thấp.",
    ["ui_PVP_008"]="Phòng",
    ["ui_PVP_009"]="Rời phòng",
    ["ui_PVP_010"]="Không thể dùng",
    ["ui_PVP_011"]="Thời gian chiến đấu",
    ["ui_PVP_012"]="Phe ta",
    ["ui_PVP_013"]="Phe địch",
    ["ui_PVP_014"]="Càng nhiều người chọn tắt lối chơi này, xác suất lối chơi này xuất hiện ngẫu nhiên càng thấp",
    ["ui_PVP_015"]="Quy tắc tắt",
    ["ui_PVP_016"]="Lối chơi chờ tắt",
    ["ui_PVP_017"]="Mối Nguy Tài Nguyên",
    ["ui_PVP_018"]="Anh Hùng Đoạt Cờ",
    ["ui_PVP_019"]="Gấp Đôi Poring",
    ["ui_PVP_020"]="Huyết Chiến Đến Cùng",
    ["ui_PVP_021"]="Chiếm trạm tài nguyên để nhận tài nguyên",
    ["ui_PVP_022"]="Đoạt cờ đến điểm giao cờ phe ta",
    ["ui_PVP_023"]="Mau nhặt Poring Nhỏ",
    ["ui_PVP_024"]="Đánh bại đối thủ",
    ["ui_PVP_025"]="Chế\u{0020}\u{0020}Độ\u{0020}\u{0020}Đối\u{0020}\u{0020}Chiến",
    ["ui_PVP_026"]="Phòng Đối Đầu Vô Hạn đang diễn ra",
    ["ui_PVP_027"]="Giới thiệu sự kiện",
    ["ui_PVP_028"]="Giới thiệu lối chơi",
    ["ui_PVP_029"]="Giới thiệu bản đồ",
    ["ui_PVP_030"]="Quy tắc Đối Đầu Vô Hạn",
    ["ui_PVP_031"]="Thời gian mở: Cả ngày",
    ["ui_PVP_032"]="Cấp tham gia: Cấp cơ bản >= cấp 40",
    ["ui_PVP_033"]="Chế độ tham gia: Ghép đơn/đội, phòng tùy chỉnh",
    ["ui_PVP_034"]="Số lần tham gia mỗi ngày: Không giới hạn",
    ["ui_PVP_035"]="1. Một mình hoặc tổ đội đều có thể tham gia.",
    ["ui_PVP_036"]="2. Lối chơi và bản đồ là ngẫu nhiên.",
    ["ui_PVP_037"]="3. Sau khi ghép thành công, có thể chọn tắt một lối chơi. Lối chơi bị tắt sẽ giảm xác suất ngẫu nhiên.",
    ["ui_PVP_038"]="4. Bản đồ khác nhau sẽ có cơ chế map riêng biệt.",
    ["ui_PVP_039"]="5. Đáp ứng điều kiện thắng của mỗi lối chơi sẽ chiến thắng.",
    ["ui_PVP_040"]="Thời gian tham gia: Các trận đấu vòng loại được tổ chức từ 20:00-21:00 vào thứ Hai, thứ Tư và thứ Sáu hàng tuần trong suốt mùa giải và các trận đấu miễn phí diễn ra cả ngày.",
    ["ui_PVP_041"]="Vào phòng",
    ["ui_PVP_042"]="1. Tranh đoạt cờ ở trung tâm map.",
    ["ui_PVP_043"]="2. Đưa cờ đoạt được đến điểm giao cờ của phe ta, sẽ được tính 1 lần giao cờ thành công.",
    ["ui_PVP_044"]="3. Điểm giao cờ của phe ta ở trong doanh trại của đối phương.",
    ["ui_PVP_045"]="4. Phe giao cờ ba lần trước giành chiến thắng.",
    ["ui_PVP_046"]="1. Đánh bại thành viên phe đối phương nhận điểm.",
    ["ui_PVP_047"]="2. Phe đạt số điểm mục tiêu trước giành chiến thắng.",
    ["ui_PVP_048"]="1. Trong map sẽ có băng trôi lạnh lẽo, hãy cẩn thận.",
    ["ui_PVP_049"]="1. Trong map có rất nhiều bẫy bắn tia laser, hãy cẩn thận.",
    ["ui_PVP_050"]="1. Quỷ Hút Máu trong lâu đài sẽ thi triển Giọt Máu, hãy cẩn thận.",
    ["ui_PVP_051"]="Xin lỗi, không tìm thấy phòng trống",
    ["ui_PVP_052"]="đến",
    ["ui_PVP_053"]="Chọn chế độ đối đầu",
    ["ui_PVP_054"]="Đấu Xếp Hạng",
    ["ui_PVP_055"]="Đối Đầu Vô Hạn",
    ["ui_PVP_056"]="Cả ngày",
    ["ui_PVP_057"]="7. Không nên tham gia các sự kiện ngoài Đối Đầu Vô Hạn dưới hình thức đội 6 người. Nếu đội có 6 người tham gia sự kiện khác, hiệu ứng liên quan không thể có hiệu lực cho người thứ sáu.",
    ["ui_PVP_058"]="BXH Bạn Bè",
    ["ui_PVP_059"]="BXH Liên Server",
    ["ui_PVP_060"]="Bậc",
    ["ui_PVP_061"]="Cách hạng trên còn",
    ["ui_PVP_062"]="Bậc yêu cầu:",
    ["ui_PVP_063"]="Nhấp vào vị trí bất kỳ để tiếp tục",
    ["ui_PVP_064"]="Đã kế thừa xong bậc mùa giải trước",
    ["ui_PVP_065"]="Xem thưởng bậc",
    ["ui_PVP_066"]="Xem thưởng mùa giải",
    ["ui_PVP_067"]="Quy tắc chế độ Đấu Xếp Hạng",
    ["ui_PVP_068"]="1. Đấu Xếp Hạng chỉ mở ghép trong thời gian sự kiện của mỗi mùa giải, không thể ghép trong thời gian tạm nghỉ tổng kết.",
    ["ui_PVP_069"]="2. Chu kỳ mùa: Thời vụ được quyết toán hàng tháng, bắt đầu từ lúc 5 giờ ngày đầu tiên hàng tháng, ngày cuối cùng của tháng là ngày quyết toán, không nằm trong lịch trình.",
    ["ui_PVP_070"]="3. Chế độ số người: Chia thành 2V2, 3V3, 6V6, luân phiên mỗi ngày, Đấu Xếp Hạng kỳ đó chỉ cho phép ghép khi tham gia chế độ số người.",
    ["ui_PVP_071"]="4. Quy tắc ghép: Ghép liên server được tiến hành trên toàn server dựa theo thực lực của người chơi, số trận càng nhiều, thực lực của những người chơi được ghép càng tương đồng nhau",
    ["ui_PVP_072"]="5. Lối chơi BAN: Khi ghép thành công, mỗi người chơi có thể chọn BAN để loại 1 trong các lối chơi được phép, xác suất bị lối chơi BAN chọn ngẫu nhiên sẽ giảm đi",
    ["ui_PVP_073"]="6. Các giai đoạn của lối chơi: Được chia thành giai đoạn chuẩn bị, giai đoạn chiến đấu và giai đoạn kết thúc. Nếu đáp ứng các điều kiện chiến thắng của lối chơi, lối chơi sẽ được tổng kết trước. Để biết chi tiết về từng lối chơi, vui lòng xem tab \"Giới thiệu lối chơi\".",
    ["ui_PVP_074"]="7. Quy tắc tổng kết:\nBậc dưới Chiến Thần: Thắng nhận được Sao Vàng x1, thua bị trừ Sao Vàng x1 (ngoại trừ bậc đảm bảo hoặc đạo cụ đặc biệt có hiệu lực).\nBậc Chiến Thần: Không nhận thêm hoặc trừ Sao Vàng nữa, mà trừ số lượng Sao Lam nhất định dựa theo kết quả thắng hoặc thua.",
    ["ui_PVP_075"]="8. Bậc lớn mùa giải: Tích lũy Sao Vàng có thể tăng bậc, được chia thành: Tinh Anh, Vương Bài, Quán Quân, Sử Thi, Truyền Kỳ, Vương Giả, Chiến Thần. Đạt bậc Chiến Thần sẽ tiến hành xếp hạng toàn server dựa theo số Sao Lam",
    ["ui_PVP_076"]="9. Quy tắc trừng phạt trốn chạy:\nNgười chơi ghép thành công nhưng chưa sẵn sàng sẽ bị cấm thi đấu 2 phút.\nNgười chơi vào map trận đấu nhưng thoát ra sớm trước khi tổng kết sẽ bị coi là thua và sẽ bị cấm thi đấu trong 2 phút.",
    ["ui_PVP_077"]="Quy tắc chế độ Đối Đầu Vô Hạn",
    ["ui_PVP_078"]="1. Chơi chế độ Đối Đầu Vô Hạn không bị giới hạn theo mùa giải, mỗi lối chơi/map hoàn toàn giống với Đấu Xếp Hạng.",
    ["ui_PVP_079"]="2. Tổng kết các trận đấu ở chế độ Đối Đầu Vô Hạn sẽ không ảnh hưởng gì đến Đấu Xếp Hạng",
    ["ui_PVP_080"]="1. Có ba điểm tài nguyên trong map.",
    ["ui_PVP_081"]="2. Chiếm giữ điểm tài nguyên có thể liên tục nhận được tài nguyên.",
    ["ui_PVP_082"]="3. Các điểm tài nguyên bị chiếm giữ vẫn sẽ bị các phe khác cướp và chiếm.",
    ["ui_PVP_083"]="4. Ưu tiên phe nào nhận được một lượng tài nguyên nhất định trước sẽ thắng.",
    ["ui_PVP_084"]="1. Mastering sẽ ngẫu nhiên triệu hồi Poring Nhỏ trong map.",
    ["ui_PVP_085"]="2. Tiếp cận Poring Nhỏ là có thể nhặt.",
    ["ui_PVP_086"]="3. Nhặt Poring Nhỏ với số lượng nhất định trong một khoảng thời gian có thể giành chiến thắng.",
    ["ui_PVP_087"]="1. Rìa map và dung nham trong map rất nguy hiểm",
    ["ui_PVP_088"]="10. Để biết chi tiết thưởng, vui lòng xem tab \"Xem trước thưởng\" trên giao diện chính của Đấu Xếp Hạng. Thưởng xếp hạng sẽ được phát qua thư khi đạt bậc, thưởng mùa giải sẽ được phát qua thư khi tổng kết mùa giải.",
    ["ui_PVP_089"]="11. Quy tắc kế thừa bậc mùa giải mới:\nKhi thời gian sự kiện của mùa giải cũ kết thúc, bậc sẽ được tổng kết và kế thừa sang mùa giải mới theo quy tắc nhất định.",
    ["ui_PVP_090"]="3. Trong chế độ Đối Đầu Vô Hạn, có thể tạo phòng tùy chỉnh và chiêu mộ đồng đội cũng như đối thủ để so tài trong server\nChúc mọi người chơi vui vẻ!",
    ["ui_PVP_091"]="Lưu ý: Không mở ở chế độ số người 2V2",
    ["ui_PVP_092"]="(Không phải người chơi server này)",
    ["ui_PVP_093"]="Dữ liệu đội",
    ["ui_PVP_094"]="Daily 1st Win",
    ["ui_PVP_095"]="Nhấp vào vị trí bất kỳ để đóng giao diện",
    ["ui_PVP_096"]="1. Thưởng thắng lần đầu: Tham gia chế độ Đấu Xếp Hạng của Đối Đầu Vô Hạn thắng lần đầu mỗi ngày có thể nhận thưởng.",
    ["ui_PVP_097"]="2. Thưởng EXP: Tham gia chế độ bất kỳ của Đối Đầu Vô Hạn đều có thể nhận thưởng EXP, có giới hạn mỗi ngày.",
    ["ui_PVP_098"]="3. Xu Dũng Sĩ:\nTham gia chế độ Đấu Xếp Hạng của Đối Đầu Vô Hạn có thể nhận Xu Dũng Sĩ, có giới hạn mỗi tuần.\nXu Dũng Sĩ có thể đổi vật phẩm ở Tiệm Dũng Sĩ (Mùa giải mới sẽ làm mới số lần đổi).",
    ["ui_PVP_099"]="4. Thưởng đạt bậc: Lần đầu đạt yêu cầu bậc nào đó ở mùa giải hiện tại sẽ nhận thưởng tương ứng.",
    ["ui_PVP_100"]="5. Thưởng mùa giải: Khi mùa giải hiện tại kết thúc, phát thưởng tương ứng dựa theo bậc hiện tại.",
