    ["BuffDes_81300101"]="Ở trạng thái Đổ Máu, mỗi giây phải chịu Vật Thương Hệ Trung Tính bằng <color=#44afee>%s%%</color> HP Max của người thi triển.",
    ["BuffDes_81300701"]="Tăng <color=#44afee>%s%%</color> Pháp Thương Cuối kèm và <color=#44afee>%s%%</color> Giảm Pháp Thương Cuối cho bản thân.",
    ["BuffDes_81300801"]="Tăng <color=#44afee>%s%%</color> Vật Thương Cuối kèm và <color=#44afee>%s%%</color> Giảm Vật Thương Cuối cho bản thân.",
    ["BuffDes_81301201"]="Ở trạng thái Đổ Máu, mỗi giây phải chịu Vật Thương Hệ Trung Tính bằng <color=#44afee>%s%%</color> Vật Công của người thi triển.",
    ["BuffDes_81301301"]="Ở trạng thái Đốt Cháy, mỗi giây phải chịu Pháp Thương Hệ Lửa bằng (SP Max của bản thân x <color=#44afee>%s%%</color> + Pháp Công của người thi triển x <color=#44afee>%s%%</color>), đồng thời mỗi giây giảm SP bằng (SP Max của bản thân x <color=#44afee>%s%%</color>).",
    ["BuffDes_81301501"]="Tăng <color=#44afee>%s%%</color> Hút Máu Vật Lý và <color=#44afee>%s%%</color> Tăng Cường Hệ Trung Tính cho bản thân.",
    ["BuffDes_81301902"]="Giảm Pháp Thương Cuối của bản thân tăng <color=#44afee>%s%%</color>, phần trăm Pháp Công tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_813020011"]="Pháp Phòng và Vật Phòng của bản thân giảm <color=#44afee>%s%%</color>, Kháng Hắc Ám, Kháng Đóng Băng, Kháng Giảm Tốc tăng <color=#44afee>%s%%</color>. Giảm ST Cuối tăng <color=#44afee>%s%%</color>, Buff ST Cuối tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_81302002"]="Giảm Vật Thương Cuối của bản thân tăng <color=#44afee>%s%%</color>, phần trăm Vật Công tăng <color=#44afee>%s%%</color>.",
    ["BuffDes_813020021"]="Giảm mức tăng phần trăm HP tối đa theo cấp độ%s%%;\nTấn công vật lý và phép thuật tăng theo cấp độ%s%%;\nMỗi lớp thâm nhập trạng thái tiêu cực tăng lên%s;\nSát thương cuối cùng theo cấp độ tăng lên.%s%%.",
    ["BuffDes_81302201"]="Kháng Trạng Thái Debuff của bản thân giảm <color=#44afee>%s</color>.",
    ["BuffDes_81302301"]="Ở trạng thái <color=#44afee>Đổ Máu</color>, mỗi giây phải chịu Vật Thương Hệ Trung Tính bằng <color=#44afee>%s%%</color> Vật Công của người thi triển, Vật Công và Tốc Đánh của bản thân giảm <color=#7ACEFF>25%%</color>, HP và SP không thể tự phục hồi.",
    ["BuffDes_81302401"]="Ở trạng thái Đốt Cháy, mỗi giây phải chịu Vật Thương Hệ Lửa bằng <color=#44afee>%s%%</color> Vật Công của người thi triển.",
    ["BuffDes_81302501"]="Ở trạng thái <color=#44afee>Đổ Máu</color>, mỗi giây phải chịu Vật Thương Hệ Hồn Ma bằng <color=#44afee>%s%%</color> Vật Công của người thi triển, Vật Công và Tốc Đánh của bản thân giảm <color=#7ACEFF>25%%</color>, HP và SP không thể tự phục hồi.",
