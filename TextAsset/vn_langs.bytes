    ["homestead_num"]="Số lượng: %s",
    ["homesteadforge_getItem"]="Nhận được <color=#e7bb22>%s x%s</color>",
    ["injurytext"]="Phản Đòn sát thương",
    ["itemDes_10202212"]="Dùng xong tăng EXP treo máy diệt quái Odin gấp 3 lần, duy trì 3 giờ",
    ["itemDes_10202213"]="Dùng xong tăng EXP treo máy diệt quái Odin gấp 5 lần, duy trì 3 giờ",
    ["itemDes_10219481"]="Mở để nhận tất cả vật phẩm sau:\nHộp Thánh Odin Óng Ánh *1,\nCống Hiến Công Hội *5,\nXu Kỷ Niệm Ánh Sáng *5",
    ["itemDes_10219482"]="Mở để nhận tất cả vật phẩm sau:\nThẻ EXP x3 (3 giờ) *1,\nCống Hiến Công Hội *10,\nXu Kỷ Niệm Ánh Sáng *20",
    ["itemDes_10219483"]="Mở để nhận tất cả vật phẩm sau:\nThẻ EXP x5 (3 giờ) *1,\nCống Hiến Công Hội *45,\nXu Kỷ Niệm Ánh Sáng *50",
    ["itemDes_10219484"]="Mở ra được chọn một trong:  \n Huy Chương I*12,\n Bản Dập I*6,\n Trang Thư I*3,\n Dấu Khắc I*2,\n Kẹp Sách I*1",
    ["itemName_10202212"]="Thẻ EXP x3 (3 giờ)",
    ["itemName_10202213"]="Thẻ EXP x5 (3 giờ)",
    ["itemName_10219481"]="Gói Tăng Tốc Trưởng Thành I",
    ["itemName_10219482"]="Gói Tăng Tốc Trưởng Thành II",
    ["itemName_10219483"]="Gói Tăng Tốc Trưởng Thành III",
    ["itemName_10219484"]="Túi Nguyên Liệu Shadow Tự Chọn III",
    ["jobDescription1012"]="Tân Thủ Toàn Năng sử dụng thành thạo các kỹ năng nghề khác, kết hợp kỹ năng tự do có thể đối phó hoàn hảo với các tình huống khác nhau.",
    ["jobDescription1111"]="Bảo vệ hòa bình của vùng đất bằng áo giáp mạnh nhất, Kỵ Sĩ có năng lực phòng thủ tuyệt vời, và sẽ luôn là người tiên phong trong đoàn đội",
    ["jobDescription1121"]="Họ thề với Odin sẽ mãi giữ vững trái tim dũng cảm và tinh thần cống hiến. Lấy thân làm khiên, quán triệt đường lối tín ngưỡng",
    ["jobDescription1211"]="Cầu nguyện cho tất cả những người yêu chuộng hòa bình trên thế giới với niềm tin chân thành nhất, sức mạnh của vòng sáng không chỉ có thể chữa lành những tâm hồn bị tổn thương mà còn có thể trục xuất tất cả những sinh vật Thây Ma đen tối.",
    ["jobDescription1221"]="Mang trái tim nhân từ và hành động như sấm sét. Võ Tăng là chuyên gia chiến đấu dũng mãnh và quả cảm, cũng là bậc thầy chính nghĩa với tấm lòng ôm cả thiên hạ.",
    ["jobDescription1311"]="Nắm vững bí thuật sâu sắc nhất trên thế giới, bất kỳ thuộc tính nào của vạn vật trong trời đất đều khuất phục trước sức mạnh pháp thuật của Trí Giả",
    ["jobDescription1321"]="Người ký khế ước của Tinh Linh nguyên tố, người đối địch với sứ giả nguyên tố sẽ phải hứng chịu cơn giận vô tận của Tinh Linh nguyên tố",
    ["jobDescription1411"]="Hãy che giấu hơi thở của bản thân, giáng đòn chí mạng vào mục tiêu trong bóng tối, chỉ có vũ khí và chất độc mới là những người bạn đồng hành đáng tin cậy nhất",
    ["jobDescription1421"]="Ẩn mình trong bóng tối, giáng một đòn chí mạng vào một kẻ địch, năng lực sát thương đơn mạnh mẽ khiến hắn thuận buồm xuôi gió trong các trận khiêu chiến đơn lẻ.",
    ["jobDescription1511"]="Không một sinh vật sống nào có thể thoát khỏi sự săn đuổi của mắt đại bàng, dây cung kéo căng là sự tôn trọng cao nhất đối với con mồi",
    ["jobDescription1521"]="Bậc thầy âm nhạc có thể hạ bút thành văn bất kỳ ca khúc nào. Khi hợp tác với vũ công lang thang, có thể tạo ra kỳ tích cải tử hồi sinh.",
    ["jobDescription1531"]="Vũ công có thể thành thạo bất kỳ loại vũ điệu nào. Khi hợp tác với Nhạc Sư Cung Đình, có thể tạo ra điều kỳ diệu khiến người chết sống lại.",
    ["jobDescription1611"]="Xe Đẩy và Zeny là những người bạn tốt nhất. Ngoài chiến đấu, Tiệm cũng là nơi tốt nhất có thể ghé đến",
    ["jobDescription1621"]="Thuật Sĩ Luyện Kim sử dụng nhiều đạo cụ kỳ diệu để chiến đấu, có thể triệu hồi Cơ Thể Sống để sát cánh chiến đấu.",
    ["jobDescription1711"]="Với tất cả các loại vũ khí chiến tranh, bạn có thể tiêu diệt mọi thứ trước mặt bằng cách phóng hỏa lực áp đảo trên chiến trường",
    ["jobDescription1811"]="Sát thủ sử dụng thành thạo Kiếm Ninja và Ninpou, đồng thời giỏi sử dụng nhiều phương pháp khác nhau để tiêu diệt mục tiêu một cách linh hoạt",
    ["jobDescription1821"]="Sát thủ sử dụng thành thạo Kiếm Ninja và Ninpou, đồng thời giỏi sử dụng nhiều phương pháp khác nhau để tiêu diệt mục tiêu một cách linh hoạt",
    ["jobDescription1911"]="Có các kỹ thuật chân linh hoạt, áp chế kẻ địch trên chiến trường bằng những tổ hợp kỹ thuật chân khác nhau",
    ["jobInstanceTips1"]="Trước khi chọn nghề lần đầu cần hoàn thành <color=#CA2E0AFF>Thí Luyện Chiến Đấu</color> của Thầy Hướng Dẫn",
