    ["ui_Artifacts_030"]="Linh Khí",
    ["ui_Artifacts_031"]="Đột phá",
    ["ui_Artifacts_032"]="Cùng lúc chỉ được làm 1 nhiệm vụ thức tỉnh Shadow, nếu bỏ nhiệm vụ sẽ ko lưu tiến độ",
    ["ui_Artifacts_033"]="Dùng ngoại hình Shadow thay thế ngoại hình vũ khí hiện tại",
    ["ui_Artifacts_034"]="Đã xong",
    ["ui_Artifacts_035"]="Chưa nhận",
    ["ui_Artifacts_036"]="Trong thời gian Thi Triển Quyền Cước, có thể trực tiếp thức tỉnh mà không cần hoàn thành nhiệm vụ",
    ["ui_AttackOnTitanGift_001"]="Túi Chi Viện",
    ["ui_AttackOnTitanGift_002"]="Gói Quà Chi Viện",
    ["ui_AttackOnTitan_001"]="Sự kiện nhân vật",
    ["ui_AttackOnTitan_002"]="Trận Chiến Tự Do",
    ["ui_AttackOnTitan_003"]="Lệnh Chi Viện",
    ["ui_AttackOnTitan_004"]="Thu thập \"Mảnh Ký Ức\" trong Trận Chiến Tự Do, hoàn thành sự kiện nhân vật, nhận được nhiều \"Bí Kíp Tác Chiến\", và đổi được phần thưởng trong Tiệm Huấn Luyện của Eren Yeager",
    ["ui_AttackOnTitan_005"]="Hiện có",
    ["ui_AttackOnTitan_006"]="Hoàn thành sự kiện trước sẽ mở khóa",
    ["ui_AttackOnTitan_007"]="Xem thưởng",
    ["ui_AttackOnTitan_008"]="Tình báo hiện có thể công khai",
    ["ui_AttackOnTitan_009"]="Nhiệm vụ Chi Viện",
    ["ui_AttackOnTitan_010"]="Nhấp màn hình để thoát tổng kết",
    ["ui_AttackOnTitan_011"]="Một lần mua vượt quá 5 cấp, được mua Gói Thăng Cấp bên phải với giá ưu đãi hơn~",
    ["ui_AttackOnTitan_012"]="Thẻ Thông Hành tối đa đạt Lv.20",
    ["ui_AttackOnTitan_013"]="Kích hoạt Thẻ Huấn Luyện Lv.1-20\nCấp Thẻ Thông Hành tăng đến Lv.5",
