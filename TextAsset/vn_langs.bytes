    ["OXExam_Info_7"]="Vui lòng xếp hàng khi rời đi, đếm ngược thời gian rời phó bản: <color=#e7bb22>%ds</color>",
    ["OXExam_Info_8"]="Công bố đáp án",
    ["OXExam_Info_9"]="<color=#e7bb22>Câu sau</color>",
    ["OXExam_Question001"]="Trong RO, người khổng lồ đã tạo ra thế giới là <color=#F2C730FF>Người Khổng Lồ Pangu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question001_1"]="Người khổng lồ tạo ra thế giới là Ymir",
    ["OXExam_Question002"]="Trong RO, người khổng lồ đã tạo ra thế giới là <color=#F2C730FF>Ymir</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question003"]="Cốt truyện RO chủ yếu phát sinh ở <color=#F2C730FF>Midgarts</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question004"]="Cốt truyện RO chủ yếu xảy ra ở <color=#F2C730FF>Dị Giới</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question004_1"]="Xảy ra ở Midgarts",
    ["OXExam_Question005"]="Tên đầy đủ của RO là <color=#F2C730FF>Ragnarok Online</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question006"]="Tên đầy đủ của RO là <color=#F2C730FF>Regolark Online</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question006_1"]="Ragnarok Online",
    ["OXExam_Question007"]="Chỉ có <color=#F2C730FF>Prontera</color> mới có nhân viên phục vụ Kafra, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question007_1"]="Tất cả thành phố đều có",
    ["OXExam_Question008"]="Cenia sau khi chuyển nghề thì nghề mới là <color=#F2C730FF>Kiếm Sĩ</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question009"]="Cenia sau khi chuyển nghề thì nghề mới là <color=#F2C730FF>Ma Pháp Sư</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question009_1"]="Kiếm Sĩ",
    ["OXExam_Question010"]="Thuyền trưởng phụ trách di chuyển trên biển đến Đảo Izlude tên là <color=#F2C730FF>Carew</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question011"]="Thuyền trưởng phụ trách di chuyển trên biển đến Đảo Izlude tên là <color=#F2C730FF>Kahn</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question011_1"]="Carew",
    ["OXExam_Question012"]="Tăng <color=#F2C730FF>Sức Mạnh STR</color> có thể tăng Vật Công, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question013"]="Tăng <color=#F2C730FF>Sức Mạnh STR</color> có thể tăng Vật Công và Pháp Công, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question013_1"]="Sức Mạnh STR sẽ ảnh hưởng đến Vật Công",
    ["OXExam_Question014"]="Tăng <color=#F2C730FF>Sức Mạnh STR</color> có thể tăng Vật Công và Vật Phòng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question014_1"]="Sức Mạnh STR sẽ ảnh hưởng đến Vật Công",
    ["OXExam_Question015"]="Tăng <color=#F2C730FF>Nhanh Nhẹn AGI</color> có thể tăng Tốc Đánh và Né, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question016"]="Tăng <color=#F2C730FF>Nhanh Nhẹn AGI</color> có thể tăng Cấp Tốc, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question016_1"]="Linh Hoạt DEX sẽ ảnh hưởng đến Cấp Tốc",
    ["OXExam_Question017"]="Tăng <color=#F2C730FF>Nhanh Nhẹn AGI</color> có thể tăng Tốc Chạy, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question017_1"]="Thú cưỡi sẽ ảnh thưởng Tốc Chạy của nhân vật",
    ["OXExam_Question018"]="Tăng <color=#F2C730FF>Thể Chất VIT</color> có thể tăng Vật Phòng và Pháp Phòng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question018_1"]="Trí Lực INT sẽ ảnh hưởng đến Pháp Phòng",
    ["OXExam_Question019"]="Tăng <color=#F2C730FF>Thể Chất VIT</color> có thể tăng HP Max và SP Max, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
    ["OXExam_Question019_1"]="Trí Lực INT sẽ ảnh hưởng đến SP Max",
    ["OXExam_Question020"]="Tăng <color=#F2C730FF>Thể Chất VIT</color> có thể tăng Vật Phòng, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>? ",
