    ["ui_AceHunterRules_001"]="Quy tắc Tranh Bá",
    ["ui_AceHunterRules_002"]="Tư cách tham gia",
    ["ui_AceHunterRules_003"]="Luật Thợ Săn Vương Bài",
    ["ui_AceHunterRules_004"]="Tony Chir sẽ gửi thư mời đến người chơi đủ tư cách tham gia qua thư",
    ["ui_AceHunterRules_005"]="Người chơi có thư mời được phép báo danh tham gia thi đấu, sau khi báo danh, thư mời sẽ bị thu hồi",
    ["ui_AceHunterRules_006"]="Thư mời chỉ có hiệu lực trong ngày, nếu không sử dụng sẽ mất hiệu lực vào hôm sau",
    ["ui_AceHunterRules_007"]="Quy tắc báo danh",
    ["ui_AceHunterRules_008"]="Ngày diễn ra: 10/11 - 17/11",
    ["ui_AceHunterRules_009"]="Thời gian: 21:00-21:25",
    ["ui_AceHunterRules_010"]="Báo danh: 21:00-21:03",
    ["ui_AceHunterRules_011"]="Vào sân: 21:00-21:03",
    ["ui_AceHunterRules_012"]="Cần dùng thư mời để báo danh, khi mở báo danh, người chơi sẽ nhận được thông báo và nhắc nhở.",
    ["ui_AceHunterRules_013"]="Quy trình báo danh",
    ["ui_AceHunterRules_014"]="Vào thư nhận thư mời",
    ["ui_AceHunterRules_015"]="Báo danh",
    ["ui_AceHunterRules_016"]="Báo danh thành công",
    ["ui_AceHunterRules_017"]="Vào đấu trường",
    ["ui_AceHunterRules_018"]="Quy tắc hối lộ",
    ["ui_AceHunterRules_019"]="Người chơi không nhận được thư mời có thể hối lộ Tony Chir để nhận tư cách tham gia.",
    ["ui_AceHunterRules_020"]="Hối lộ chỉ tính 10 vị trí đầu tiên và xếp thứ tự theo giá cả hối lộ.",
    ["ui_AceHunterRules_021"]="Hối lộ tối thiểu 10000 Zeny, không giới hạn tối đa",
    ["ui_AceHunterRules_022"]="Khi kết thúc báo danh, trò chuyện với Tony Chir để nhận kết quả hối lộ, Nhà Thám Hiểm không nhận được tư cách tham gia sẽ được hoàn trả một nửa tiền hối lộ sau khi trò chuyện kết thúc",
    ["ui_AceHunterRules_023"]="Quy trình hối lộ",
    ["ui_AceHunterRules_024"]="Trò chuyện với NPC",
    ["ui_AceHunterRules_025"]="Dùng Zeny hối lộ",
    ["ui_AceHunterRules_026"]="Xác nhận kết quả hối lộ",
    ["ui_AceHunterRules_027"]="Quy tắc trước khi thi đấu",
    ["ui_AceHunterRules_028"]="Người thi đấu cần vào đấu trường trước khi bắt đầu thi đấu",
    ["ui_AceHunterRules_029"]="Sau khi vào map, người thi đấu sẽ tự động hủy trạng thái tổ đội",
    ["ui_AceHunterRules_030"]="Sau khi kết thúc đếm ngược, người chơi chưa vào đấu trường sẽ không thể vào map nữa, và xem như từ bỏ tư cách thi đấu.",
    ["ui_AceHunterRules_031"]="Quy tắc phòng chờ",
    ["ui_AceHunterRules_032"]="Trong thời gian báo danh sẽ mở 30 trận, mỗi trận tối đa 30 người tham gia",
    ["ui_AceHunterRules_033"]="Trong thời gian chuẩn bị được phép rời đấu trường hiện tại",
    ["ui_AceHunterRules_034"]="Quy tắc thi đấu",
    ["ui_AceHunterRules_035"]="Sau khi bắt đầu thi đấu, người thi đấu được phép chủ động rời sân, nhưng tư cách thi đấu xem như hủy bỏ",
    ["ui_AceHunterRules_036"]="Người thi đấu offline trong thời gian thi đấu sẽ được bảo lưu hình tượng, đồng thời ghi chép lại HP bị tấn công và sát thương tấn công",
    ["ui_AceHunterRules_037"]="Người chơi bị tiêu diệt sẽ mất tư cách thi đấu",
    ["ui_AceHunterRules_038"]="Người thi đấu sẽ vào trạng thái xem chiến dưới tư cách khán giả",
    ["ui_AceHunterRules_039"]="Người thi đấu sau khi tử vong sẽ rời đấu trường, nhưng vẫn được vào lại với tư cách khán giả.",
    ["ui_AceHunterRules_040"]="Quy tắc khán giả",
    ["ui_AceHunterRules_041"]="Sau khi bắt đầu, Nhà Thám Hiểm được phép vào đấu trường xem chiến dưới tư cách khán giả.",
    ["ui_AceHunterRules_042"]="Khán giả được phép tùy ý vào đấu trường khi trận đấu đang diễn ra",
    ["ui_AceHunterRules_043"]="Khán giả sẽ ở trạng thái ẩn thân, người thi đấu sẽ không nhìn thấy.",
    ["ui_AceHunterRules_044"]="Người thi đấu sau khi bị loại sẽ tự động trở thành khán giả",
    ["ui_AceHunterRules_045"]="Người thi đấu không thể vào đấu trường với tư cách khán giả",
    ["ui_AceHunterRules_046"]="Quy tắc kết thúc Vòng Đầu",
    ["ui_AceHunterRules_047"]="Khi trận đấu chỉ còn lại 1 Nhà Thám Hiểm duy nhất, phòng đấu xem như hoàn thành vòng đầu.",
    ["ui_AceHunterRules_048"]="15 giây sau khi kết thúc vòng đầu, người chiến thắng sẽ được chuyển đến phòng chung kết",
    ["ui_AceHunterRules_049"]="Khán giả sẽ không được dịch chuyển đến phòng chung kết",
    ["ui_AceHunterRules_050"]="30 giây sau khi kết thúc thi đấu, đấu trường sẽ bị xóa",
    ["ui_AceHunterRules_051"]="Người thi đấu hoàn thành vòng đầu và sống sót sẽ được dịch chuyển đến phòng chung kết",
    ["ui_AceHunterRules_052"]="Người tham gia được tùy ý rời phòng trước khi bắt đầu, chỉ cần trò chuyện lại với NPC sẽ được dịch chuyển đến phòng chung kết.",
    ["ui_AceHunterRules_053"]="Quy tắc chung kết",
    ["ui_AceHunterRules_054"]="2 phút sau khi kết thúc toàn bộ vòng đầu sẽ bắt đầu chung kết",
    ["ui_AceHunterRules_055"]="Trận chung kết sẽ bắt đầu sau khi kết thúc toàn bộ vòng đầu, người thi đấu sẽ được trực tiếp dịch chuyển vào đấu trường chung kết",
    ["ui_AceHunterRules_056"]="Trước khi bắt đầu đấu chung kết, người thăng cấp được tùy ý rời phòng, thời gian chuẩn bị kéo dài 2 phút",
    ["ui_AceHunterRules_057"]="Sau khi thời gian chuẩn bị kết thúc, nếu vẫn chưa vào lại đấu trường chung kết sẽ bị hủy tư cách thi đấu",
    ["ui_AceHunterRules_058"]="Người thăng cấp sau khi rời đấu trường đều có thể trò chuyện lại với Tony Chir để vào lại, hoặc vào thông qua nút [Tham Chiến] trong giao diện Đấu Trường.",
    ["ui_AceHunterRules_059"]="Quy tắc kết thúc chung kết",
    ["ui_AceHunterRules_060"]="Sự kiện kết thúc khi đấu trường chỉ còn lại một người tham gia hoặc thời gian đếm ngược kết thúc.",
    ["ui_AceHunterRules_061"]="Người sống sót cuối cùng sẽ trở thành Đấu Sĩ Ace và nhận phần thưởng cao nhất.",
    ["ui_AceHunterRules_062"]="Sau 30 giây đếm ngược kết thúc, phòng đấu sẽ bị xóa",
    ["ui_AceHunterRules_063"]="Nhận thưởng",
    ["ui_AceHunterRules_064"]="Người chơi sau khi bị diệt sẽ xuất hiện giao diện tổng kết",
    ["ui_AceHunterRules_065"]="Quy tắc hiển thị danh sách xếp hạng: Hiển thị theo thứ tự giảm dần, những người chơi chưa tử vong sẽ không hiển thị xếp hạng.",
    ["ui_AceHunterRules_066"]="Phần thưởng được phát trực tiếp cho người chơi, đồng thời cũng hiển thị trên giao diện tổng kết.",
    ["ui_AceHunterRules_067"]="Vòng đầu",
    ["ui_AceHunterRules_068"]="Chung kết",
    ["ui_AceHunterRules_069"]="Hướng dẫn phần thưởng",
    ["ui_AceHunterRules_070"]="Thưởng tham gia",
    ["ui_AceHunterRules_071"]="Thưởng thăng cấp",
    ["ui_AceHunterRules_072"]="Thưởng tham gia chung kết",
    ["ui_AceHunterRules_073"]="Hạng 3",
    ["ui_AceHunterRules_074"]="Hạng 2",
    ["ui_AceHunterRules_075"]="Hạng 1",
    ["ui_AceHunterRules_076"]="Huy Hiệu Phù Thủy",
    ["ui_AceHunterRules_077"]="Huy Hiệu Mèo Đen",
    ["ui_AceHunterRules_078"]="Huy Hiệu Xương Khô",
    ["ui_AceHunterRules_079"]="Huy Hiệu Ánh Trăng",
    ["ui_AceHunterRules_080"]="Hạng 2-30 vòng đầu",
    ["ui_AceHunterRules_081"]="Hạng 1 vòng đầu",
    ["ui_AceHunterRules_082"]="Hạng 4-30 chung kết",
    ["ui_AceHunterRules_083"]="Hạng 3 vòng đầu",
    ["ui_AceHunterRules_084"]="Hạng 2 vòng đầu",
    ["ui_AceHunterRules_085"]="Hạng 1 vòng đầu",
    ["ui_AceHunterRules_086"]="5",
    ["ui_AceHunterRules_087"]="1",
    ["ui_AceHunterRules_088"]="2",
    ["ui_AceHunterRules_089"]="3",
    ["ui_AceHunterRules_090"]="Huy Hiệu Halloween Thường",
    ["ui_AceHunterRules_091"]="Hướng dẫn thư mời",
    ["ui_AceHunterRules_092"]="Dựa trên sự nhiệt tình của các Nhà Thám Hiểm khi tham gia Săn MVP&MINI dã ngoại, Đấu Trường sẽ cấp [Thư Mời Đấu Thợ Săn Vương Bài] cho những Nhà Thám Hiểm xuất sắc.",
    ["ui_AceHunterRules_093"]="Chỉ những Nhà Thám Hiểm có thư mời mới đủ điều kiện báo danh tham gia Thợ Săn Vương Bài, nhưng mỗi lần Tony Chir luôn bí mật giữ lại một số thư mời",
    ["ui_AceHunterRules_094"]="Quy tắc phát thư mời",
    ["ui_AceHunterRules_095"]="Tổng có 890 thư mời sẽ được phát, theo thứ tự ưu tiên sau:",
    ["ui_AceHunterRules_096"]="Tham gia Săn MVP&MINI và lập được đội đầu tiên đủ thành viên",
    ["ui_AceHunterRules_097"]="Nhà Thám Hiểm tham gia Săn MVP&MINI và nhận được phần thưởng tổng kết",
    ["ui_AceHunterRules_098"]="Nếu số người đáp ứng được điều kiện trên vượt quá 890 người, thư mời sẽ được phát theo thứ tự cấp bậc giảm dần.",
    ["ui_AceHunterRules_099"]="Nếu số người đáp ứng được điều kiện trên không vượt quá 890 người, thư mời sẽ được phát cho Nhà Thám Hiểm chưa tham gia Săn MVP&MINI theo thứ tự cấp bậc giảm dần để bổ sung đủ số người.",
    ["ui_AceHunterRules_100"]="Cách phát thư mời",
    ["ui_AceHunterRules_101"]="Tony Chir sẽ gửi thư mời qua thư cho những người chơi nhận được tư cách tham gia.",
    ["ui_AceHunterRules_102"]="Thư mời",
