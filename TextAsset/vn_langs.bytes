    ["ui_SongkranFestival2023_013"]="Lễ Hội Té Nước Vui Vẻ",
    ["ui_SongkranFestival_001"]="Lễ Hội Té Nước",
    ["ui_SongkranFestival_002"]="Vòng Quanh Quần Đảo",
    ["ui_SongkranFestival_003"]="Đại Chiến Bắn Nước",
    ["ui_SongkranFestival_004"]="Vua Lễ Hội",
    ["ui_SongkranFestival_005"]="Thần Biển Ban Phúc",
    ["ui_SongkranFestival_006"]="Tiệm Kỳ Nghỉ",
    ["ui_SongkranFestival_007"]="Thưởng cuối",
    ["ui_SongkranFestival_008"]="Tiến độ du lịch",
    ["ui_SongkranFestival_009"]="Tiến lên",
    ["ui_SongkranFestival_010"]="Bắt đầu",
    ["ui_SongkranFestival_011"]="Đá khỏi đội",
    ["ui_SongkranFestival_012"]="Thắng đầu mỗi ngày nhận Nước Sạch",
    ["ui_SongkranFestival_013"]="Thưởng xếp hạng",
    ["ui_SongkranFestival_014"]="Sau khi sự kiện kết thúc, người chơi xếp hạng cao nhất\n<color=#CA2E0AFF>có thể nhận được Thú Cưỡi Tuyệt Đẹp!</color>",
    ["ui_SongkranFestival_015"]="Thưởng của tôi",
    ["ui_SongkranFestival_016"]="Nhắc đổi",
    ["ui_SongkranFestival_017"]="Trong thời gian sự kiện, mỗi ngày có thể nhận thêm XXX Chúc Phúc Odin, dùng Chúc Phúc Odin đánh bại quái vật sẽ có xác suất nhận được nguyên liệu đổi sự kiện!",
    ["ui_SongkranFestival_018"]="Nhận Chúc Phúc Odin",
    ["ui_SongkranFestival_019"]="Cầu Rama VIII",
    ["ui_SongkranFestival_020"]="Phố Người Hoa",
    ["ui_SongkranFestival_021"]="Hoàng Cung",
    ["ui_SongkranFestival_022"]="MahaNakhon",
    ["ui_SongkranFestival_023"]="Chùa Arun",
    ["ui_SongkranFestival_024"]="Tượng Đài Chiến Thắng",
    ["ui_SongkranFestival_025"]="Đu Quay Băng Cốc",
    ["ui_SongkranFestival_026"]="Lại lần nữa",
    ["ui_SongkranFestival_027"]="Đang ghép:",
    ["ui_SongkranFestival_028"]="Hủy",
    ["ui_SongkranFestival_029"]="Nhận được nhiên liệu",
    ["ui_SpringFestivalActivity2023_021"]="Pháo Hoa",
    ["ui_SpringFestivalActivity2023_022"]="Pháo Nổ",
    ["ui_SpringFestivalActivity2023_042"]="Trong thời gian Tết, tiêu diệt càng nhiều quái vật ngoài bản đồ, càng dễ xuất hiện Bé Niên Thú ẩn. \nĐồng thời khi Payon xuất hiện Niên Thú, cũng sẽ triệu hồi rất nhiều Bé Niên Thú.",
    ["ui_SpringFestivalActivity2023_043"]="Thỏ Điên Lam đã đến Payon, các Nhà Thám Hiểm có thể nhận nhiệm vụ đánh lui MVP/mini trên Bảng Ủy Thác, giúp Thỏ Điên Lam bảo vệ rừng xanh, nhận được \"Huy Hiệu Người Bạn Rừng Xanh\", và đến Tiệm Huy Hiệu của Thỏ Điên Lam để đổi thưởng!",
    ["ui_SpringFestivalActivity2023_044"]="Pháo phá hủy Giáp của Niên Thú rất hiệu quả\nSau khi Giáp của Niên Thú bị phá hủy sẽ rơi rất nhiều thưởng, pháo sẽ phát huy uy lực rất lớn\nSau khi Niên Thú cảm thấy bị đe dọa sẽ trốn đến khu vực khác.",
    ["ui_SpringFestivalActivity2023_045"]="Dùng đạo cụ độc quyền đặc biệt của Thỏ Điên Lam \"Cà Rốt Của Thỏ Điên Lam\" để triệu hồi Thỏ Điên Lam, đồng thời bỏ qua Khiên và gây ST lớn lên Niên Thú!",
    ["ui_SpringFestivalActivity2023_046"]="Nhiệm vụ 1: Giúp Thỏ Điên Lam, diệt quái vật rục rịch",
    ["ui_SpringFestivalActivity2023_047"]="Nhiệm vụ 2: Niên Thú trở nên mạnh hơn",
    ["ui_SpringFestivalActivity2023_048"]="Người chơi tham gia cần ≥ Cấp 30",
    ["ui_SpringFestivalActivity2023_049"]="Linh Hổ Tầm Bảo",
    ["ui_SpringFestivalActivity2023_050"]="Bộ Trang Sức Năm Hổ",
    ["ui_SpringFestivalActivity2023_051"]="Bắt đầu từ đêm giao thừa, nhập lệnh đặc biệt \"<size=20><color=#ffe86a>Happy Lunar New Year 2023!</color></size>\"\n sẽ nhận được Hộp Quà Giao Thừa x1",
    ["ui_SpringFestivalActivity2023_052"]="Sau khi mở <color=#FFE3A7FF>chắc chắn</color> nhận được một lượng Pha Lê và một món trang sức vị trí ngẫu nhiên trong Trở Về Năm Mới, có cơ hội nhận được thú cưỡi hiếm Trở Về Năm Mới <color=#FFE3A7FF>\"Linh Hổ Tầm Bảo\"</color> hoặc một trang sức Thú Cưỡi xuân mới nghề ngẫu nhiên",
    ["ui_SpringFestivalActivity2023_053"]="Thẻ Trang Sức Năm Mới có thể đổi <size=20><color=#FFE3A7FF>Cài Tóc Năm Mới</color></size> trong Tiệm Huy Hiệu của Thỏ Điên Lam!",
    ["ui_SpringFestivalActivity2023_054"]="Phúc lợi năm mới! Đăng nhập mỗi ngày, nói chuyện với Thỏ Điên Lam, thắng trò chơi Vận Chuyển Cà Rốt, nhận ngay thưởng hàng ngày!",
    ["ui_SpringFestivalActivity2023_055"]="Ngày",
    ["ui_SpringFestivalActivity2023_056"]="Đón Xuân",
    ["ui_SpringFestivalActivity2023_057"]="nghi thức lễ hội mùa xuân",
    ["ui_SpringFestivalActivity2023_058"]="Đón Giao Thừa",
    ["ui_SpringFestivalActivity2023_059"]="Trang sức Thú Cưỡi độc quyền năm mới",
    ["ui_SpringFestivalActivity2023_060"]="Nhiệm vụ đặc biệt Bảng Ủy Thác",
    ["ui_SpringFestivalActivity2023_061"]="Lông Nhung Của Thỏ Điên Lam",
    ["ui_SpringFestivalActivity2023_062"]="Hộp Quà Năm Mới",
    ["ui_SpringFestivalActivity2023_063"]="Thú Cưỡi Năm Mới",
    ["ui_SpringFestivalActivity2023_064"]="PK Lưng Năm Mới",
    ["ui_SpringFestivalActivity2023_065"]="Trang Phục Năm Mới",
    ["ui_SpringFestivalActivity2023_066"]="PK Đuổi Năm Mới",
    ["ui_SpringFestivalActivity2023_067"]="Đạo Cụ Năm Mới",
    ["ui_SpringFestivalActivity2023_068"]="Tham gia đánh lui Niên Thú",
    ["ui_SpringFestivalActivity2023_069"]="Chứng Nhận Thủ Vệ",
    ["ui_SpringFestivalActivity2023_070"]="Nhiều Huy Hiệu\nNgười Bạn Rừng Xanh",
    ["ui_SpringFestivalActivity2023_071"]="Cà Rốt Của Thỏ Điên Lam",
    ["ui_SpringFestivalActivity2023_072"]="Nhấp nhận",
    ["ui_SpringFestivalActivity2023_073"]="*Phá vỡ Giáp Niên Thú/Dùng Odin có cơ hội nhận \"Huy Hiệu Người Bạn Rừng Xanh\" và \"Cà Rốt của Thỏ Điên Lam\"",
    ["ui_SpringFestivalActivity2023_074"]="Đánh bại Niên Thú sẽ có xác suất rơi Thú Cưỡi Năm Mới!",
    ["ui_SpringFestivalActivity2023_075"]="Vào Game",
    ["ui_SpringFestivalActivity2023_076"]="Tới Mini Game và Tiệm Huy Hiệu Thỏ Điên Lam, nhấn vào đây~",
    ["ui_SpringFestivalActivity2023_099"]="Happy Lunar New Year 2023!",
    ["ui_SpringFestivalActivity2023_100"]="ID đã sao chép, hãy mau dán đi nhé!",
    ["ui_SpringFestivalActivity2024_001"]="Nghênh Đón Tân Xuân",
    ["ui_SpringFestivalActivity2024_002"]="Niên Thú Bao Vây",
    ["ui_SpringFestivalActivity2024_003"]="Niên Thú Đột Nhập",
    ["ui_SpringFestivalActivity2024_004"]="Phúc Lợi Tết",
    ["ui_SpringFestivalActivity2024_005"]="Nội Thất Tết",
    ["ui_SpringFestivalActivity2024_006"]="Nhận được",
    ["ui_SpringFestivalActivity2024_007"]="Đăng nhập có thưởng",
    ["ui_SpringFestivalActivity2024_008"]="Hình dạng khuôn mặt độc quyền",
    ["ui_SpringFestivalActivity2024_009"]="Cống hiến tích luỹ",
    ["ui_SpringFestivalActivity2024_010"]="Tham gia toàn server",
    ["ui_SpringFestivalActivity2024_011"]="Cơ chế cường hóa",
    ["ui_SpringFestivalActivity2024_012"]="Nhiều thưởng hơn",
    ["ui_SpringFestivalActivity2024_013"]="Mở khoá hộp quà",
    ["ui_SpringFestivalActivity2024_014"]="Nhiệm vụ thăng cấp",
    ["ui_SpringFestivalActivity2024_015"]="Bất ngờ nhân đôi",
    ["ui_SpringFestivalActivity2024_016"]="Uỷ Thác Đặc Biệt",
    ["ui_SpringFestivalActivity2024_017"]="Trang phục giới hạn",
    ["ui_SpringFestivalActivity2024_018"]="Ưu đãi riêng",
    ["ui_SpringFestivalActivity2024_019"]="Sao chép",
    ["ui_SpringFestivalActivity2024_020"]="Giao thừa đang đến gần, đoàn quân trinh sát gần đây đã phát hiện lượng lớn Bé Niên Thú khắp các Thành Chính, thậm chí có Ảo Ảnh Niên Thú với các nguyên tố khác nhau, gây hoảng sợ cho các cư dân của Thành Chính!",
    ["ui_SpringFestivalActivity2024_021"]="10:00 đến 24:00 mỗi ngày, cứ 2 tiếng sẽ có ngẫu nhiên một Thành Chính xuất hiện sự kiện này, mỗi vòng sự kiện kéo dài 1 giờ (10:00 làm mới trận đầu, 24:00 làm mới trận cuối)",
    ["ui_SpringFestivalActivity2024_022"]="Điểm đóng góp",
    ["ui_SpringFestivalActivity2024_023"]="Tiến độ loại trừ ở vòng này",
    ["ui_SpringFestivalActivity2024_024"]="Niên Thú lại đến tập kích",
    ["ui_SpringFestivalActivity2024_025"]="Niên Thú lại nổi dậy, tập kích Payon!",
    ["ui_SpringFestivalActivity2024_026"]="Tiêu hao Chúc Phúc Odin nhận đạo cụ",
    ["ui_SpringFestivalActivity2024_027"]="Sử dụng Odin có thể nhận được Spirit Snake Mark*5, có thể nhận được tối đa 5 lần một ngày.",
    ["ui_SpringFestivalActivity2024_028"]="Nạp tiền và nhận phong bì màu đỏ kim cương",
    ["ui_SpringFestivalActivity2024_029"]="During the event, the limited Year of the Snake Diamond Red Envelope will be granted when recharging for the specified tier of Diamonds.",
    ["ui_SpringFestivalActivity2024_030"]="Sự kiện nhân đôi mở hạn giờ",
    ["ui_SpringFestivalActivity2024_031"]="Mở thưởng EXP và Zeny nhân đôi mỗi ngày\n(12:00 - 14:00, 19:00 - 21:00)",
    ["ui_SpringFestivalActivity2024_032"]="Làm mới Uỷ Thác Đặc Biệt mỗi ngày",
    ["ui_SpringFestivalActivity2024_033"]="Có thể nhận nhiệm vụ đặc biệt mỗi ngày trên Bảng Ủy Thác, giới hạn hoàn thành trong ngày",
    ["ui_SpringFestivalActivity2024_034"]="Trong thời gian sự kiện, chat thế giới câu \"<color=#FDD4A3>Happy Lunar New Year 2024!</color>\"",
    ["ui_SpringFestivalActivity2024_035"]="Mốc hiện tại",
    ["ui_SpringFestivalActivity2024_036"]="Điểm hiện tại",
    ["ui_SpringFestivalActivity2024_037"]="Phúc lợi năm mới! Đăng nhập mỗi ngày có thể nhận thưởng!",
    ["ui_SpringFestivalActivity2024_038"]="Nhiều hơn sau khi đăng nhập tổng cộng 7 ngày<color=#FCF497>Hình dạng khuôn mặt độc quyền cho năm con Rắn</color>!",
    ["ui_SpringFestivalActivity2024_039"]="Happy Lunar New Year 2024!",
    ["ui_SpringFestivalActivity2024_040"]="Xem nhà mẫu",
    ["ui_SpringFestivalActivity2024_041"]="Nhấp vào nút bên dưới, đến map tương ứng tiêu diệt Bé Niên Thú và Ảo Ảnh Niên Thú",
    ["ui_SpringFestivalActivity2024_042"]="Ảo Ảnh Niên Thú có nhiều loại thuộc tính, nhận được lực kháng cực cao đối với thuộc tính không khắc chế, nhưng cũng sẽ chịu ST thuộc tính khắc chế cao hơn",
    ["ui_SpringFestivalActivity2024_043"]="Có được khi tham gia tiêu diệt Nian Beast Baby<color=#FFF4A6>30</color>Điểm đóng góp có được bằng cách tham gia tiêu diệt Bóng ma Nian Beast.<color=#FFF4A6>300</color>Điểm cống hiến, lập tổ đội sẽ nhận được nhiều điểm cống hiến hơn",
    ["ui_SpringFestivalActivity2024_044"]="Pháo Nổ có thể trực tiếp tiêu diệt Bé Niên Thú, có thể phá vỡ khiên mở sau khi Ảo Ảnh Niên Thú còn một nửa HP, khiến Niên Thú rơi vào trạng thái Choáng mất lực kháng thuộc tính tạm thời",
    ["ui_SpringFestivalActivity2024_045"]="Mỗi ngày có thể nhận thưởng các mốc khác nhau dựa theo Điểm Cống Hiến nhận được",
    ["ui_SpringFestivalActivity2024_046"]="Khi tiến độ tiêu diệt mỗi vòng đạt 100%, có thể nhận Món Ăn đặc biệt <color=#FFF4A6>Tiền Bạc Dư Dả</color>, sau khi ăn sẽ tăng ST với quái vật hệ Niên Thú",
    ["ui_SpringFestivalActivity2024_047"]="Dựa theo báo cáo của Quân đoàn trinh sát, lần này Nian thú cứ mỗi nửa phút sẽ phát ra các màu sắc khác nhau và chuyển đổi thuộc tính của mình, sử dụng thuộc tính kiềm chế để tấn công!",
    ["ui_SpringFestivalActivity2024_048"]="Ngoài ra, Nian Beast cũng đã phát triển khả năng kháng pháo nên nên sử dụng<color=#FEE274>Pháo nổ</color>[s s=40.0 url=Icons/Item/10202163]và đạo cụ mới<color=#FEE274>Răng nanh rắn</color>[s s=40.0 url=Icons/Item/10202484]!",
    ["ui_SpringFestivalActivity2024_049"]="Pháo có thể phá vỡ lá chắn của Nian Beast, và răng nanh của Spirit Snake có thể gây ra rất nhiều sát thương khi phá vỡ lá chắn!",
    ["ui_SpringFestivalActivity2024_050"]="Độ khó tăng lên đồng thời thưởng Niên Thú cũng sẽ phong phú hơn, trong mỗi trận đấu, người chơi chịu ST xuất sắc và Trị Liệu xuất sắc đều có cơ hội nhận <color=#FEE274>thưởng hiếm</color>, mỗi người giới hạn một lần mỗi ngày!",
    ["ui_SpringFestivalActivity2024_051"]="Kích hoạt nhiệm vụ và hộp quà",
    ["ui_SpringFestivalActivity2024_052"]="Lưu điểm nâng cấp hộp quà",
    ["ui_SpringFestivalActivity2024_053"]="Sử dụng Odin để nhận được vảy rắn hoàn hảo*1, có thể nhận được tối đa 1 lần mỗi ngày.",
    ["ui_SpringFestivalActivity2024_054"]="Adventurers can claim Bound Diamonds daily from the Year of the Snake Diamond Red Envelopes, with any excess converting into Crystals.",
    ["ui_SpringFestivalActivity2024_055"]="Ngày giao thừa sẽ mở tất cả phúc lợi nhân đôi\n(00:00 - 24:00)",
    ["ui_SpringFestivalActivity2024_056"]="Hoàn thành nhiệm vụ đặc biệt để nhận được vảy rắn hoàn hảo, răng nanh rắn tâm linh và các đạo cụ sự kiện khác",
    ["ui_SpringFestivalActivity2025_001"]="Cấp độ ≥ <color=#FDF7C9>30</color>",
    ["ui_SpringFestivalActivity2025_002"]="Trong thời gian diễn ra sự kiện, nhập lệnh cụ thể vào hộp trò chuyện thế giới",
    ["ui_SpringFestivalActivity2025_003"]="Dragon Soars Away, Serpent Brings Fortune",
    ["ui_SpringFestivalActivity2025_004"]="Sau khi hộp quà vào giai đoạn thu thập, bạn không thể hoàn thành nhiệm vụ để kiếm điểm nữa",
    ["ui_SpringFestivalActivity2025_005"]="Xác suất rớt ra Dấu Ấn Rắn Thần (sau khi tính tỉ lệ rớt 5x của Odin):\nQuái vật nhỏ 1,0000% Quái vật trung bình 2,0000% Quái vật lớn 3,0000%\n5 giọt mỗi lần, giới hạn 5 giọt mỗi ngày\n\nXác suất rơi vảy rắn hoàn hảo (sau khi tính tỷ lệ rơi 5x của Odin):\nQuái vật nhỏ 0,1000% Quái vật trung bình 0,2000% Quái vật lớn 0,3000%\nMỗi lần 1 giọt, giới hạn 1 giọt mỗi ngày",
    ["ui_SpringFestivalActivity_001"]="Sự kiện năm mới",
    ["ui_SpringFestivalActivity_002"]="Quà Hội Tay Mèo",
    ["ui_SpringFestivalActivity_003"]="Quà Giao Thừa",
    ["ui_SpringFestivalActivity_004"]="MVP Niên Thú Tấn Công",
    ["ui_SpringFestivalActivity_005"]="Gửi Nhà Thám Hiểm: Mỗi dịp năm mới, Niên Thú Tấn Công sẽ tàn phá làng của Payon. Lạng bị Niên Thú và Bé Niên Thú chiếm đóng sẽ trở nên hoang tàn...",
    ["ui_SpringFestivalActivity_006"]="Nhiệm vụ 1: Ngăn chặn Bé Niên Thú!",
    ["ui_SpringFestivalActivity_007"]="Tình Báo 1: Trong thời gian sự kiện, diệt quái vật Lv.40 trở lên sẽ có tỉ lệ xuất hiện Bé Niên Thú.",
    ["ui_SpringFestivalActivity_008"]="Tình Báo 2: Khi Niên Thú Khổng Lồ xuất hiện tại Payon sẽ triệu hồi thêm nhiều Bé Niên Thú.",
    ["ui_SpringFestivalActivity_009"]="Diệt Bé Niên Thú sẽ nhận được Hộp Quà Năm Mới! Mở sẽ nhận tối đa 888888 Zeny, Lì Xì , Nấu Ăn Năm Mới...",
    ["ui_SpringFestivalActivity_010"]="Hoàn thành Bảng Ủy Thác ngày sẽ xuất hiện Treo Thưởng diệt Niên Thú, hoàn thành sẽ nhận được Túi Phú Năm Mới, Pháo Nổ và Pháo Hoa...",
    ["ui_SpringFestivalActivity_011"]="Nhiệm vụ 2: Diệt Niên Thú MVP!",
    ["ui_SpringFestivalActivity_012"]="Tình Báo 1: Niên Thú xuất hiện tại Payon với khả năng phòng thủ cao, Pháo Hoa rất hiệu quả trong việc phá vỡ áo giáp Niên Thú.",
    ["ui_SpringFestivalActivity_013"]="Tình Báo 2: Khi áo giáp Niên Thú bị vỡ sẽ rơi phần thưởng, dùng Pháo Nổ vào lúc này sẽ phát huy uy lực cực lớn.",
    ["ui_SpringFestivalActivity_014"]="Tình Báo 3: Niên Thú sẽ xảo quyệt chạy đến khu vực khác nếu cảm nhận được sự uy hiếp",
    ["ui_SpringFestivalActivity_015"]="Chiến thắng Niên Thú sẽ có tỉ lệ nhận được Thú Cưỡi Năm Mới, Thẻ Thú Cưỡi, Túi Lộc...",
    ["ui_SpringFestivalActivity_016"]="Rớt chính",
    ["ui_SpringFestivalActivity_017"]="Bé Niên Thú",
    ["ui_SpringFestivalActivity_018"]="Hộp Quà Năm Mới",
    ["ui_SpringFestivalActivity_019"]="Hộp quà thưởng",
    ["ui_SpringFestivalActivity_020"]="Túi Lộc",
    ["ui_SpringFestivalActivity_021"]="Pháo Hoa",
    ["ui_SpringFestivalActivity_022"]="Pháo Nổ",
    ["ui_SpringFestivalActivity_023"]="Sủi Cảo Năm Mới",
    ["ui_SpringFestivalActivity_024"]="Bánh Gạo Năm Mới",
    ["ui_SpringFestivalActivity_025"]="Nhiều Zeny",
    ["ui_SpringFestivalActivity_026"]="Niên Thú",
    ["ui_SpringFestivalActivity_027"]="Phá giáp",
    ["ui_SpringFestivalActivity_028"]="Nhiều Túi Phúc",
    ["ui_SpringFestivalActivity_029"]="(Mỗi ngày tối đa nhận được 10 lần)",
    ["ui_SpringFestivalActivity_030"]="Thêm phần thưởng hiếm",
    ["ui_SpringFestivalActivity_031"]="Gấu Trúc Afu",
    ["ui_SpringFestivalActivity_032"]="Pháo Hoa Sư Tử",
    ["ui_SpringFestivalActivity_033"]="Máy Quay",
    ["ui_SpringFestivalActivity_034"]="Thưởng thêm",
    ["ui_SpringFestivalActivity_035"]="Danh sách thời trang Niên Thú",
    ["ui_SpringFestivalActivity_036"]="Trang Sức Thú Cưỡi Năm Mới",
    ["ui_SpringFestivalActivity_037"]="Nguyên liệu trưởng thành trang bị",
    ["ui_SpringFestivalActivity_038"]="Danh sách phần thưởng",
    ["ui_SpringFestivalActivity_039"]="Diệt sẽ rớt",
    ["ui_SpringFestivalActivity_040"]="Đổi thưởng",
    ["ui_SpringFestivalActivity_041"]="Nhà Thám Hiểm có Cấp Base ≥ 30 được đổi trong Prontera, kết thúc vào 5:00 1/3",
    ["ui_SpringFestivalActivity_042"]="Khi Niên Thú dần thức tỉnh, những con quái vật trên đại lục đã rục rịch hơn!",
    ["ui_SpringFestivalActivity_043"]="Cọp Chúa đã đến Payon, các Nhà Thám Hiểm có thể nhận nhiệm vụ đánh lui MVP/mini trên Bảng Ủy Thác, giúp Cọp Chúa bảo vệ rừng xanh, nhận được \"Huy Hiệu Người Bạn Rừng Xanh\", và đến Tiệm Huy Hiệu của Cọp Chúa để đổi phần thưởng!",
    ["ui_SpringFestivalActivity_044"]="Niên Thú sẽ trở nên mạnh mẽ hơn sau một năm dưỡng sức tích lực!",
    ["ui_SpringFestivalActivity_045"]="Dùng đạo cụ đặc biệt chuyên dùng của Cọp Chúa là \"Nắm Đấm Cọp Chúa\", để triệu hồi Cọp Chúa, đồng thời bỏ qua Khiên Chắn và gây sát thương lớn lên Niên Thú!",
    ["ui_SpringFestivalActivity_046"]="Nhiệm vụ 1: Giúp Cọp Chúa, diệt quái vật rục rịch",
    ["ui_SpringFestivalActivity_047"]="Nhiệm vụ 2: Niên Thú trở nên mạnh hơn",
    ["ui_SpringFestivalActivity_048"]="Người chơi tham gia cần ≥Lv.30",
    ["ui_SpringFestivalActivity_049"]="Linh Hổ Tầm Bảo",
    ["ui_SpringFestivalActivity_050"]="Bộ Trang Sức Niên Thú",
    ["ui_SpringFestivalActivity_051"]="Trong thời gian sự kiện, Nhà Thám Hiểm chat thế giới câu \"<size=20><color=#ffe86a>Happy Lunar New Year 2022!</color></size>\" sẽ nhận được \"Hộp Quà Giao Thừa\"x1",
    ["ui_SpringFestivalActivity_052"]="Mở <color=#FFE3A7FF>chắc chắn</color> nhận được một lượng Pha Lê và một món trang sức vị trí ngẫu nhiên trong món quà năm mới, có tỉ lệ nhận được thú cưỡi hiếm xuân mới <color=#FFE3A7FF>\"Gấu Mèo Afu\"</color> và <color=#FFE3A7FF>\"Pháo Hoa Sư Tử\"</color>, hoặc một trang sức Thú Cưỡi xuân mới nghề ngẫu nhiên.",
    ["ui_SpringFestivalActivity_053"]="Thẻ Trang Sức Năm Hổ có thể đổi được <size=20><color=#FFE3A7FF>Cài Tóc năm Hổ</color></size> trong Tiệm Huy Hiệu của Cọp Chúa đấy!",
    ["ui_SpringFestivalActivity_054"]="Phúc lợi năm mới! Đăng nhập mỗi ngày, nói chuyện với Cọp Chúa, thắng Trò Chơi Đoán Mũ, sẽ nhận ngay thưởng hàng ngày!",
    ["ui_SpringFestivalActivity_055"]="Ngày Thứ",
    ["ui_SpringFestivalActivity_056"]="Năm Hổ Phúc Lộc",
