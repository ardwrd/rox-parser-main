    ["StarRankTargetName_004"]="Bán vật phẩm trong Quầy Giao Dịch Pha Lê",
    ["StarRankTargetName_005"]="Mua vật phẩm trong Quầy Giao Dịch Pha Lê",
    ["StarRankTargetName_006"]="Bán vật phẩm trong Quầy Giao Dịch Kim Cương",
