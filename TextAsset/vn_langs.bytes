    ["ShadowWeapon_001"]="Hiện chưa mặc trang bị tương ứng, không có hiệu lực",
    ["ShadowWeapon_002"]="Tr.bị cần:",
    ["ShadowWeapon_003"]="Nhận Ngủ Say %s",
    ["ShadowWeapon_004"]="Shadow chỉ có hiệu lực khi dùng trang bị cùng loại",
    ["ShadowWeapon_005"]="Cần Shadow Lv.%s",
    ["ShadowWeapon_006"]="Cần Shadow Lv.%s",
    ["ShadowWeapon_007"]="Thăng cấp kỹ năng thành công",
    ["ShadowWeapon_008"]="Thăng cấp kỹ năng cần tốn những vật phẩm sau, lần thăng cấp này có tỉ lệ thành công là <color=#CA2E0AFF>%s%%</color>, bạn chắc chắn muốn thăng cấp?",
    ["ShadowWeapon_009"]="Kích hoạt kỹ năng cần tiêu hao những đạo cụ sau, bạn chắc chắn muốn kích hoạt?",
    ["ShadowWeapon_010"]="Đang thức tỉnh Shadow khác",
    ["ShadowWeapon_011"]="Hiện chưa thức tỉnh Shadow này",
    ["ShadowWeapon_012"]="Bạn chắc chắn muốn hủy thức tỉnh Shadow này? Sau khi hủy sẽ nhận lại Shadow, nhưng không lưu tiến độ nhiệm vụ.",
    ["ShadowWeapon_013"]="Thăng cấp Shadow",
    ["ShadowWeapon_014"]="Kích hoạt kỹ năng",
    ["ShadowWeapon_015"]="Thăng cấp kỹ năng",
    ["ShadowWeapon_016"]="Mở kỹ năng",
    ["ShadowWeapon_017"]="Thăng cấp Shadow cần tốn những vật phẩm sau, lần thăng cấp này có tỉ lệ thành công là <color=#CA2E0AFF>%s%%</color>, bạn chắc chắn muốn thăng cấp?",
    ["ShadowWeapon_018"]="Mở tạm thời kỹ năng thần khí cần tốn những vật phẩm sau, bạn chắc chắn muốn mở? Thời gian duy trì <color=#CA2E0AFF>3</color> ngày.",
    ["ShadowWeapon_019"]="Nguyên liệu hoặc xu không đủ",
    ["ShadowWeapon_020"]="<color=#ff7b7b>%s</color>",
    ["ShadowWeapon_021"]="Sau khi cấp Shadow đạt Lv.%s sẽ vĩnh viễn đột phá thành Thần Khí.",
    ["ShadowWeapon_022"]="Chưa đủ điều kiện",
    ["ShadowWeapon_023"]="Chưa đủ điều kiện cấp Shadow",
    ["ShadowWeapon_024"]="Cấp Shadow đạt Lv.%s sẽ mở kỹ năng này",
    ["ShadowWeapon_025"]="Thức tỉnh Shadow cần tiêu hao những đạo cụ sau, bạn chắc chắn muốn thức tỉnh?",
    ["ShadowWeapon_026"]="Thăng cấp thành công",
    ["ShadowWeapon_027"]="Thăng cấp thất bại",
    ["ShadowWeapon_028"]="Thức tỉnh Shadow",
    ["ShadowWeapon_029"]="Thức tỉnh Shadow thành công",
    ["ShadowWeapon_030"]="Cần %s đạt Lv.%s",
    ["ShadowWeapon_031"]="Hiệu ứng hiện tại:",
    ["ShadowWeapon_032"]="Hiệu ứng cấp sau:",
    ["ShadowWeapon_033"]="Cần %s đạt Lv.%s",
    ["ShadowWeapon_034"]="Cần Shadow Lv.%s, cấp %s Lv.%s",
    ["ShadowWeapon_035"]="Kỹ năng vĩnh viễn mở:",
    ["ShadowWeapon_036"]="Hiện chưa mở, xin hãy chờ",
    ["ShadowWeapon_037"]="Phiên bản hiện chưa mở, xin hãy chờ",
    ["ShadowWeapon_038"]="Đã đạt cấp cao nhất",
    ["ShadowWeapon_039"]="Hoàn thành %s nhiệm vụ bất kỳ để thức tỉnh",
    ["ShadowWeapon_040"]="Tính năng này chưa mở",
    ["ShadowWeapon_041"]="Phương án hiện chưa được mở trang phục tương ứng",
    ["ShadowWeapon_042"]="Để mở phương án lưu Khí Linh, Shadow tương ứng cần đạt Lv.7 ",
    ["ShadowWeapon_043"]="%s<color=#ffae00>+%s</color>",
    ["ShadowWeapon_044"]="Max",
    ["ShadowWeapon_tips_001"]="Tỷ lệ thăng cấp thành công: <color=#5b9c5c>%s%%</color>",
    ["ShadowWeapon_tips_002"]="Lần trước thất bại +<color=#5b9c5c>%s%%</color>",
    ["ShadowWeapon_tips_003"]="(<color=#d97657>Thẻ Đặc Quyền tăng thêm %s%%</color>)",
    ["ShadowWeapon_tips_004"]="Tỉ lệ thành công+<color=#5b9c5c>%s%%</color>(đặc quyền +<color=#5b9c5c>%s%%</color>)",
    ["ShadowWeapon_tips_005"]="Thẻ Đặc Quyền tăng thêm <color=#5b9c5c>%s%%</color>",
    ["ShadowWeapon_tips_006"]="Sau khi chọn đạo cụ Chúc Phúc, có thể tăng tỷ lệ thành công, thăng cấp thất bại có thể tăng tỷ lệ thành công lần sau. Sau khi kích hoạt Thẻ Đặc Quyền, có thể tăng thêm tỷ lệ thành công",
    ["ShadowWeapon_tips_007"]="Có hủy sử dụng đạo cụ Chúc Phúc không, sau khi hủy, lần này sẽ không được hưởng buff tỷ lệ thành công của đạo cụ, tỷ lệ thành công thất bại tích lũy trước đó sẽ bị xóa về 0",
    ["ShadowWeapon_tips_008"]="Có hủy sử dụng đạo cụ Chúc Phúc không, sau khi hủy, lần này sẽ không được hưởng buff tỷ lệ thành công của đạo cụ",
    ["ShadowWeapon_tips_009"]="Không có buff Thẻ Đặc Quyền",
    ["ShadowWeapon_tips_010"]="(<color=#5b9c5c>+%s%%</color>)",
    ["ShadowWeapon_tips_030"]="Hiệu ứng hiện tại: %s",
    ["ShadowWeapon_tips_031"]="Hiệu ứng sau khi kế thừa: %s",
    ["ShadowWeapon_tips_032"]="Có tiến hành kế thừa Shadow hay không. Sau khi kế thừa, cấp của hai Shadow sẽ được hoán đổi, cấp kỹ năng của ô kỹ năng tương ứng cũng được hoán đổi, các kỹ năng của Shadow đã mặc sẽ bị gỡ, cần phải mặc lại",
    ["ShadowWeapon_tips_033"]="Cấp hiện tại: %s",
    ["ShadowWeapon_tips_034"]="Cấp sau khi kế thừa: %s",
    ["ShadowWeapon_tips_035"]="Hiệu ứng hiện tại:\n%s \nHiệu ứng sau khi kế thừa:\n<color=#e07338>%s</color>\nCấp hiện tại:\n%s \nCấp sau khi kế thừa:\n<color=#e07338>%s</color>",
    ["ShadowWeapon_tips_036"]="Giảm %s%%",
    ["ShadowWeapon_tips_037"]="<size=12>Giảm</size>\n%s%%",
    ["ShadowWeapon_tips_038"]="Trả lại thiết bị tạo bóng và vật liệu đa năng",
    ["ShadowWeapon_tips_039"]="Cấp độ của trang bị bóng, chữ khắc và cọ xát được thay đổi về cùng cấp độ, tùy theo cấp độ nào cao hơn cấp độ trước đó của nhà thám hiểm.\nCác thiết bị bóng tối được phát triển còn lại sẽ được trả lại dưới dạng nguyên liệu dựa trên mức tiêu thụ dự kiến.",
    ["ShadowWeapon_tips_040"]="Tài liệu đã được trả lại, vui lòng kiểm tra chúng ~",
    ["ShadowWeapon_tips_041"]="Không có vật liệu thiết bị bóng tối tương ứng trong ba lô",
    ["She"]="Cô ấy",
