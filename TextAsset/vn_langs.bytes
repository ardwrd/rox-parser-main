    ["worldKVM2_rule_095"]="50",
    ["worldKVM2_rule_096"]="5. Tham gia cách chơi GVG, nhận thưởng số lượng Huân Chương Thần Chọn chỉ định theo Chiến Tích mỗi tuần",
    ["worldKVM2_rule_097"]="Huân Chương Chiến Tích",
    ["worldKVM2_rule_098"]="Số lượng Huân Chương thưởng",
    ["worldKVM2_rule_099"]="Bạc",
    ["worldKVM2_rule_100"]="100",
    ["worldKVM2_rule_101"]="Vàng",
    ["worldKVM2_rule_102"]="50",
    ["worldKVM2_rule_103"]="Đồng",
    ["worldKVM2_rule_104"]="30",
    ["worldKVM2_rule_105"]="Công dụng Huân Chương Thần Chọn",
    ["worldKVM2_rule_106"]="Huân Chương Thần Chọn sẽ không bị xóa sau khi kết thúc sự kiện, có thể tiếp tục sử dụng khi mở sự kiện tiếp theo. Công dụng như sau:\n1. Tham gia dự đoán giải đấu\n2. Đổi vật phẩm trong Tiệm Thần Chọn",
    ["worldKVM2_rule_107"]="Lượt MVP: %s",
    ["worldKVM2_rule_108"]="Lượt ra trận: %s",
    ["worldKVM2_rule_109"]="Tổng số tử trận: %s",
    ["worldKVM2_rule_110"]="Tổng số tiêu diệt: %s",
    ["worldKVM2_rule_111"]="Sau khi kết thúc giải đấu, cách 13 giờ có thể nhận thưởng",
    ["worldKVM2_rule_112"]="Hiện không có phần thưởng để nhận",
    ["worldKVM2_rule_113"]="Quán quân server Đấu Xếp Hạng",
    ["worldKVM2_rule_114"]="Vào Đấu Loại",
    ["worldKVM2_rule_115"]="Vào top 4 cụm đấu",
    ["worldKVM2_rule_116"]="Vào top 2 cụm đấu",
    ["worldKVM2_rule_117"]="Vào top 8",
    ["worldKVM2_rule_118"]="Top 4 (Đội thắng từ 4 chọn 2 và đội thắng lượt 2 từ đội thua)",
    ["worldKVM2_rule_119"]="Top 2 (Đội thắng từ 2 chọn 1 và đội thắng lượt 4 từ đội thua)",
    ["worldKVM2_rule_120"]="Quán Quân",
    ["worldkvm_newtips1"]="<color=#ec8a5a>Cùng một tài khoản</color> có thể chọn tối đa <color=#ec8a5a>1 nhân vật</color> để tham gia thi đấu. Không thể thay đổi nhân vật sau khi đăng ký. Vui lòng xác nhận có sử dụng nhân vật này để đăng ký tham gia thi đấu hay không?",
    ["worldkvm_newtips2"]="Ghép cần tổ đội để tham gia <color=#ec8a5a>Server Giải Đấu</color> độc quyền, và sẽ mở <color=#ec8a5a>21h</color> hàng ngày, xác nhận có quay lại đăng nhập vào Server Giải Đấu không?",
    ["worldkvm_newtips3"]="Không có dữ liệu sự kiện, vui lòng kiểm tra sau!"
}