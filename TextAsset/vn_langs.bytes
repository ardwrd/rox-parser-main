    ["ResonateTextDesc_1705"]="Điều kiện thức tỉnh:\n \nGửi <color=#ffc821>1</color> <color=#ffc821>5</color> thú cưng sao và <color=#ffc821>2</color> <color=#ffc821>7</color> thú cưng sao ",
    ["ResonateTextDesc_1706"]="Điều kiện thức tỉnh:\n \nGửi ra <color=#ffc821>2</color> <color=#ffc821>7</color> thú cưng sao và <color=#ffc821>1</color> <color=#ffc821>8</color> sao Thú cưng",
    ["ResonateTextDesc_1707"]="Điều kiện thức tỉnh:\n \nGửi ra <color=#ffc821>2</color> <color=#ffc821>7</color> thú cưng sao và <color=#ffc821>1</color> <color=#ffc821>9</color> sao Thú cưng",
    ["ResonateTextDesc_1708"]="Điều kiện thức tỉnh:\n \nGửi ra <color=#ffc821>2</color> <color=#ffc821>7</color> vật nuôi sao và <color=#ffc821>2</color> <color=#ffc821>9</color> sao Thú cưng",
