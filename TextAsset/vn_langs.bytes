    ["BuffDes_10202422"]="<color=#44afee>Giảm Vật Thương Cuối PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202423"]="<color=#44afee>Giảm Vật Thương Cuối PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202424"]="<color=#44afee>Giảm Pháp Thương Cuối PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202425"]="<color=#44afee>Giảm Pháp Thương Cuối PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202426"]="<color=#44afee>ST kỹ năng</color> bản thân phải chịu giảm <color=#44afee>%s%%</color>",
    ["BuffDes_10202427"]="<color=#44afee>ST kỹ năng</color> bản thân phải chịu giảm <color=#44afee>%s%%</color>",
    ["BuffDes_10202428"]="<color=#44afee>Xuyên Thấu Trạng Thái Debuff PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202429"]="<color=#44afee>Xuyên Thấu Trạng Thái Debuff PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202430"]="<color=#44afee>Giảm Trạng Thái Debuff PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202431"]="<color=#44afee>Giảm Trạng Thái Debuff PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202432"]="<color=#44afee>Kháng Trạng Thái Debuff PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202433"]="<color=#44afee>Kháng Trạng Thái Debuff PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202434"]="<color=#44afee>Tăng Cường Trạng Thái Debuff PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202435"]="<color=#44afee>Tăng Cường Trạng Thái Debuff PVP</color> của bản thân tăng <color=#44afee>%s%%</color>",
    ["BuffDes_10202436"]="<color=#44afee>Kháng Hệ Trung Tính</color> của bản thân tăng <color=#44afee>%s%%</color>",
