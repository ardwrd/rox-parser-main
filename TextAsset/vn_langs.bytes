    ["ui_TransformProfession_005"]="Shadow",
    ["ui_TransformProfession_006"]="Đã chuyển đổi thành công và kích hoạt phương án tác chiến tương ứng với lớp chuyển nghề này\nChuyển đổi lần đầu sẽ cần cài đặt lại những nội dung sau",
    ["ui_TransformProfession_007"]="Tiêu hao kích hoạt:",
    ["ui_TransformProfession_008"]="Hãy chọn lớp nghề, tương ứng mỗi hệ nghề có nhiều lớp nghề",
    ["ui_TransformProfession_009"]="Hãy chọn lớp nghề, chỉ chuyển đổi được lớp nghề đã kích hoạt",
