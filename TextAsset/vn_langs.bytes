    ["SkillSketch9999005"]="Thiệt hại xung quanh mình",
    ["SkillSketch9999006"]="Thời gian hồi chiêu quan trọng của kỹ năng",
    ["SkillSketch9999007"]="tăng thuộc tính riêng",
