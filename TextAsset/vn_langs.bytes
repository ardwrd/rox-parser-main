    ["ui_GVG_032"]="Cẩm nang sự kiện",
    ["ui_GVG_033"]="Cứ điểm %s đã đạt số người tối đa, cần xếp hàng vào\nHiện ở vị trí <color=#f6723e>%s</color>",
    ["ui_GVG_034"]="Hủy xếp hàng thành công",
