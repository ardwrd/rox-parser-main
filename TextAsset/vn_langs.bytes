    ["DialogueBubble662491046"]="M2\nS21",
    ["DialogueBubble662491047"]="RoyÀl CanÀdiÀn blended\n The spicy Àroma hÀd mended me",
    ["DialogueBubble662491048"]="▤▣▣▣",
    ["DialogueBubble662491049"]="H\nU",
    ["DialogueBubble662491050"]="3x+5y=97\n2x-3y=-24",
