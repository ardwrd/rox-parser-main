    ["SongGanJie2023_15"]="Happy Songkran Festival",
    ["SongGanJie2023_16"]="Giai đoạn ghép đối thủ, không thể điều chỉnh đạo cụ",
    ["SongkranFestivalTask_001"]="Tham gia Phó Bản %s/%s lần",
    ["SongkranFestivalTask_002"]="Tham gia và tiêu diệt MINI%s/%s lần",
