    ["WeaponSelectionTips01"]="<color=#ffd9db>Dịch chuyển nhanh, có thể kháng, kéo quái, khống chế</color>",
    ["WeaponSelectionTips02"]="<color=#ffd9db>Tốc đánh nhanh, CD ngắn, chi viện</color>",
    ["WeaponSelectionTips03"]="<color=#ffd9db>CD dài, combo gây DMG, sát thương</color>",
    ["WeaponSelectionTips04"]="<color=#ffedc9>Giải trừ, thi triển hiệu ứng Debuff</color>",
    ["WeaponSelectionTips05"]="<color=#ffedc9>DMG cận chiến, có thể kháng, có thể hồi phục</color>",
    ["WeaponSelectionTips06"]="<color=#ffedc9>Thi triển các loại hiệu ứng buff</color>",
    ["WeaponSelectionTips07"]="<color=#e9f5ff>Khống chế, sát thương liên tục</color>",
    ["WeaponSelectionTips08"]="<color=#e9f5ff>Giảm tốc, duy trì tốn</color>",
    ["WeaponSelectionTips09"]="<color=#e9f5ff>Vận công ngắn, tự phòng thủ</color>",
    ["WeaponSelectionTips10"]="<color=#e5d1ff>Kỹ năng combo Bạo Kích phẳng bộc phát</color>",
    ["WeaponSelectionTips11"]="<color=#e5d1ff>Ẩn thân gần kẻ địch gây DMG tức thời</color>",
    ["WeaponSelectionTips12"]="<color=#e5d1ff>Gần Độc tiến hành sát thương duy trì</color>",
    ["WeaponSelectionTips13"]="<color=#edffe96>Đặt nhiều bẫy, chạy thả diều</color>",
    ["WeaponSelectionTips14"]="<color=#edffe96>Vận công ngắn, sát thương bình ổn</color>",
    ["WeaponSelectionTips15"]="<color=#edffe96>Kèm sát thương hệ Ác Quỷ, tăng DMG tức thời</color>",
    ["WeaponSelectionTips16"]="<color=#e9fffc>Xe Đẩy gây DMG, tính cơ động mạnh</color>",
    ["WeaponSelectionTips17"]="<color=#e9fffc>Tấn công cao, kỹ năng chi viện là chính</color>",
    ["WeaponSelectionTips18"]="<color=#e9fffc>Uy lực lớn, gây DMG cao trong thời gian ngắn</color>",
    ["WeaponSelectionTips19"]="Tốc Đánh cao, Bạo Kích cao, gây ST liên tục",
