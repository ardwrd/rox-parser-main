    ["LiquorPartyMini_End_loseText"]="Thi Uống Rượu lần này đã uống %s ly và say khướt...",
    ["LiquorPartyMini_End_text"]="Thi Uống Rượu lần này đã uống %s ly mà không say!",
    ["LiquorPartyMini_Normal_beginText"]="Tiếp theo, %s chọn trước, lần này cần uống Bia. Xin hỏi bạn uống hay đối thủ uống?",
    ["LiquorPartyMini_Normal_changeText1"]="Để %s",
