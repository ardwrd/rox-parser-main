    ["RuneLabelDesc_101"]="Sát thương nhận từ quái vật [Fanatical] giảm 15%",
    ["RuneLabelDesc_102"]="Xác suất bị bật lại bởi [Thorns] giảm xuống còn 8,5%",
    ["RuneLabelDesc_103"]="Sát thương nhận từ quái vật [vô hình] giảm 15%",
    ["RuneLabelDesc_104"]="Sát thương nhận được từ [Khiên chống chấn thương] không vượt quá 15% MaxHP.",
    ["RuneLabelDesc_105"]="Các đòn tấn công và kỹ năng cơ bản gây thêm 1 sát thương cho [Khiên chữa bệnh]",
    ["RuneLabelDesc_106"]="Giảm hiệu ứng giảm của [Sương mù giảm sát thương] 15%, tối đa 10%",
    ["RuneLabelDesc_1101"]="Sát thương nhận từ quái vật [Fanatical] giảm 30%",
    ["RuneLabelDesc_1102"]="Xác suất bị bật lại bởi [Thorns] giảm xuống còn 7%",
    ["RuneLabelDesc_1103"]="Sát thương nhận từ quái vật [vô hình] giảm 30%",
    ["RuneLabelDesc_1104"]="Sát thương nhận được từ [Khiên chống chấn thương] không vượt quá 10% MaxHP.",
    ["RuneLabelDesc_1105"]="Các đòn tấn công thông thường gây thêm 1 sát thương cho [Khiên chữa bệnh] và các kỹ năng gây thêm 3 sát thương cho [Khiên chữa lành].",
    ["RuneLabelDesc_1106"]="Giảm hiệu ứng giảm của [Sương mù giảm sát thương] đi 30%, tối đa là 10%",
    ["RuneLabelDesc_1201"]="Hiệu quả điều trị của [Virus] giảm xuống 70% và sát thương do chất độc giảm xuống 12%.",
    ["RuneLabelDesc_1202"]="Xác suất bị mù bởi [Tầm nhìn hạn chế] giảm xuống còn 14%",
    ["RuneLabelDesc_1203"]="Hiệu quả của [Hấp thụ ma thuật] giảm xuống 20%",
    ["RuneLabelDesc_1204"]="Sát thương nhận được trên mỗi lớp [Đốt] giảm xuống còn 5,3%",
    ["RuneLabelDesc_1205"]="Hiệu ứng của mỗi lớp [Không khí lạnh] giảm 30% và số lớp tối đa tăng lên 7.",
    ["RuneLabelDesc_1206"]="Xác suất bị ảnh hưởng bởi [Ăn mòn] giảm xuống 20%",
    ["RuneLabelDesc_1301"]="Thời gian nhận [Sốc] giảm xuống còn 3 giây",
    ["RuneLabelDesc_1302"]="Nhận được hiệu ứng kéo miễn dịch 0,8 giây cứ sau 1 giây trong phạm vi [Vortex]",
    ["RuneLabelDesc_1303"]="Thiệt hại nhận được từ [Kết nối tử thần] giảm xuống 20%",
    ["RuneLabelDesc_1304"]="Thời gian bị [gặp rắc rối] giảm xuống còn 4 giây",
    ["RuneLabelDesc_1305"]="Thời gian bị ảnh hưởng bởi [Không thể cưỡng lại] giảm xuống còn 4 giây.",
    ["RuneLabelDesc_1306"]="Sát thương nhận được từ [Hình phạt sấm sét] giảm 30%",
    ["RuneLabelDesc_1401"]="Khi được gọi bởi [Poison Pool], có 30% khả năng Poison Pool sẽ không được tạo ra.",
    ["RuneLabelDesc_1402"]="Sát thương nhận từ [Vỉ] giảm xuống 70%",
    ["RuneLabelDesc_1403"]="Sát thương nhận từ [Polar Charge] giảm xuống 70%",
    ["RuneLabelDesc_1404"]="Khi [Sickle Hell] có hiệu lực, nó sẽ tăng tốc độ của chính nó (có thể gắn nó và tốc độ chiến đấu sẽ tăng thêm 1, nếu không sẽ tăng thêm 2) trong 5 giây.",
    ["RuneLabelDesc_1405"]="Khi [Đạn Sức Sống] có hiệu lực, nó sẽ tăng tốc độ của bản thân (có thể tăng tốc độ thêm 1 khi cưỡi ngựa, nếu không sẽ tăng thêm 2), kéo dài trong 5 giây.",
    ["RuneLabelDesc_1406"]="Hiệu quả điều trị của [Bào tử truyền nhiễm] giảm xuống 70%",
    ["RuneLabelDesc_1501"]="Khi [Fire Gold Insect] có hiệu lực, tốc độ của bản thân nó sẽ được tăng lên (có thể cưỡi nó và tốc độ chiến đấu sẽ tăng thêm 1, nếu không sẽ tăng thêm 2), kéo dài 7 giây.",
    ["RuneLabelDesc_1502"]="Sát thương gây ra cho quái vật trong phạm vi của [Bảng đá giảm sát thương] tăng lên 15%.",
    ["RuneLabelDesc_1503"]="Sát thương nhận từ [Evil Heart] giảm xuống 70%",
    ["RuneLabelDesc_1504"]="Sát thương nhận được từ [Phiên đá lửa] giảm xuống 20%",
    ["RuneLabelDesc_1505"]="Sát thương được chuyển thành hiệu ứng hồi máu khi chặn [Life Connection]",
    ["RuneLabelDesc_1506"]="Thời gian làm mù của [Đá mù] giảm xuống còn 2 giây và hiệu ứng giảm đòn đánh giảm xuống 20%.",
    ["RuneLabelDesc_1601"]="Sát thương nhận được từ [Thời tiết sấm sét] giảm xuống 28%",
    ["RuneLabelDesc_1602"]="Sát thương nhận được từ [Whirlwind] giảm xuống 21% và thời gian giảm tốc giảm xuống còn 3 giây.",
    ["RuneLabelDesc_1603"]="Sát thương nhận được từ [Sóng ánh sáng chéo] giảm xuống 14%",
    ["RuneLabelDesc_1604"]="Thời gian bị bất động bởi [Xiềng xích thời gian] giảm xuống còn 3 giây.",
    ["RuneLabelDesc_1605"]="Sát thương nhận được từ [Thiên thạch rơi từ trên trời] giảm xuống 35% và miễn nhiễm với hiệu ứng đẩy lùi",
    ["RuneLabelDesc_1606"]="Thiệt hại nhận được từ [Mỏ hẹn giờ] giảm xuống 35%",
    ["RuneLabelDesc_201"]="Hiệu quả điều trị của [Virus] giảm xuống còn 85% và sát thương do chất độc giảm xuống còn 14%.",
    ["RuneLabelDesc_202"]="Xác suất bị mù bởi [Tầm nhìn hạn chế] giảm xuống 22%",
    ["RuneLabelDesc_203"]="Hiệu quả của [Hấp thụ ma thuật] giảm xuống 25%",
    ["RuneLabelDesc_204"]="Sát thương nhận được trên mỗi lớp của [Burn] giảm xuống còn 6,6%",
    ["RuneLabelDesc_205"]="Hiệu ứng của mỗi lớp [Không khí lạnh] giảm 15% và số lớp tối đa tăng lên 6.",
    ["RuneLabelDesc_206"]="Xác suất bị ảnh hưởng bởi [Ăn mòn] giảm xuống 25%",
    ["RuneLabelDesc_2101"]="Sát thương nhận từ quái vật [Fanatical] giảm 15% (30% sau khi đạt cấp tối đa)",
    ["RuneLabelDesc_2102"]="Xác suất bị bật lại bởi [Thorns] giảm xuống còn 8,5% (7% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2103"]="Sát thương nhận từ quái vật [Vô hình] giảm 15% (10% sau khi đạt cấp tối đa)",
    ["RuneLabelDesc_2104"]="Sát thương nhận được từ [Khiên chống thương tích] không vượt quá 15% MaxHP (10% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2105"]="Các đòn tấn công và kỹ năng cơ bản gây thêm 1 sát thương cho [Khiên chữa bệnh] (3 lần đối với các kỹ năng sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2106"]="Giảm hiệu ứng giảm của [Sương mù giảm sát thương] đi 15% (30% sau khi đạt cấp tối đa), xuống tối đa 10%",
    ["RuneLabelDesc_2201"]="Hiệu quả điều trị của [Virus] giảm xuống 85% (70% sau khi đạt cấp đầy đủ) và sát thương do chất độc giảm xuống 14% (12% sau khi đạt cấp đầy đủ).",
    ["RuneLabelDesc_2202"]="Xác suất bị mù bởi [Tầm nhìn hạn chế] giảm xuống 22% (14% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2203"]="Hiệu ứng của [Hấp thụ ma thuật] giảm xuống 25% (20% sau khi đạt cấp độ đầy đủ)",
    ["RuneLabelDesc_2204"]="Sát thương nhận được trên mỗi lớp [Đốt] giảm xuống còn 6,6% (5,3% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2205"]="Hiệu ứng của mỗi lớp [Không khí lạnh] giảm 15% (30% sau khi đạt cấp đầy đủ) và số lớp tối đa tăng lên 6 (7 lớp sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2206"]="Xác suất bị ảnh hưởng bởi [Ăn mòn] giảm xuống 25% (20% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2301"]="Thời gian nhận [Sốc] giảm xuống còn 4 giây (3 giây sau khi đạt cấp độ đầy đủ)",
    ["RuneLabelDesc_2302"]="Nhận được hiệu ứng kéo miễn dịch 0,5 giây cứ sau 1 giây trong phạm vi [Vortex] (0,8 giây sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2303"]="Thiệt hại nhận được từ [Kết nối tử thần] giảm xuống 25% (20% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2304"]="Thời gian bị [gặp rắc rối] giảm xuống còn 5 giây (4 giây sau khi đạt cấp độ đầy đủ)",
    ["RuneLabelDesc_2305"]="Thời gian [không thể kháng cự] giảm xuống còn 5 giây (4 giây sau khi đạt cấp tối đa)",
    ["RuneLabelDesc_2306"]="Sát thương nhận được từ [Hình phạt sấm sét] giảm 15% (30% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2401"]="Khi được gọi bởi [Poison Pool], có 15% khả năng một bể độc sẽ không được tạo ra (30% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2402"]="Sát thương nhận được từ [Vỉ] giảm xuống 85% (70% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2403"]="Sát thương nhận được từ [Polar Charge] giảm xuống 85% (70% sau khi đạt cấp tối đa)",
    ["RuneLabelDesc_2404"]="Khi [Sickle Hell] phát huy tác dụng, nó sẽ tăng tốc độ của bản thân (có thể gắn lên và tốc độ chiến đấu sẽ tăng thêm 1, nếu không sẽ tăng thêm 2), tồn tại trong 3 giây (5 giây sau khi đạt cấp độ tối đa) .",
    ["RuneLabelDesc_2405"]="Khi [Vitality Bullet] có hiệu lực, nó sẽ tăng tốc độ của bản thân (có thể tăng tốc độ thêm 1 khi cưỡi ngựa, nếu không sẽ tăng thêm 2), kéo dài trong 3 giây (5 giây sau khi đạt cấp độ đầy đủ).",
    ["RuneLabelDesc_2406"]="Hiệu quả của việc cấm điều trị bằng [Bào tử truyền nhiễm] giảm xuống 85% (70% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2501"]="Khi [Fire Gold Insect] có hiệu lực, tốc độ của bản thân nó sẽ được tăng lên (có thể cưỡi nó và tốc độ chiến đấu sẽ tăng thêm 1, nếu không sẽ tăng thêm 2), kéo dài 5 giây (7 giây sau khi đạt cấp độ tối đa)",
    ["RuneLabelDesc_2502"]="Sát thương gây ra cho quái vật trong phạm vi của [Bảng đá giảm sát thương] tăng lên 15% (30% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2503"]="Sát thương nhận từ [Evil Heart] giảm xuống 85% (70% sau khi đạt cấp tối đa)",
    ["RuneLabelDesc_2504"]="Sát thương nhận được từ [Phiên đá lửa] giảm xuống 25% (20% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2505"]="Không còn nhận sát thương khi chặn [Life Connection] (sát thương sẽ được chuyển thành hồi máu sau khi đạt cấp tối đa)",
    ["RuneLabelDesc_2506"]="Thời gian làm mù của [Đá mù] giảm xuống còn 2,5 giây (2 giây sau khi đạt cấp độ tối đa) và hiệu ứng giảm đòn đánh giảm xuống 25% (20% sau khi đạt cấp độ tối đa).",
    ["RuneLabelDesc_2601"]="Sát thương nhận được từ [Thời tiết sấm sét] giảm xuống 34% (28% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2602"]="Sát thương nhận được từ [Tornado] giảm xuống 25% (20% sau khi đạt cấp tối đa) và thời gian giảm tốc giảm xuống còn 4 giây (3 giây sau khi đạt cấp tối đa).",
    ["RuneLabelDesc_2603"]="Sát thương nhận được từ [Sóng ánh sáng chéo] giảm xuống 17% (14% sau khi đạt cấp đầy đủ)",
    ["RuneLabelDesc_2604"]="Thời gian bị bất động bởi [Xiềng xích thời gian] giảm xuống còn 4 giây (3 giây sau khi đạt cấp độ đầy đủ)",
    ["RuneLabelDesc_2605"]="Sát thương nhận được từ [Thiên thạch rơi từ bầu trời] giảm xuống 42% (35% sau khi đạt cấp độ tối đa) và hiệu ứng đẩy lùi giảm xuống còn 5 mét (nó miễn nhiễm với đòn đánh bật lại sau khi đạt cấp độ tối đa).",
    ["RuneLabelDesc_2606"]="Thiệt hại nhận được từ [Mỏ hẹn giờ] giảm xuống 42% (35% sau khi đạt cấp đầy đủ)",
