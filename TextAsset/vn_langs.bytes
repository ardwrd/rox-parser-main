    ["ui_ChooseProfessionNew_006"]="<color=#FFFFFFFF>Thời gian Vận Công: </color>",
    ["ui_ChooseProfessionNew_007"]="Vào Thí Luyện Chiến Đấu",
    ["ui_ChooseProfessionNew_008"]="Xem trước tiến cấp",
    ["ui_ChooseProfessionNew_009"]="Miêu tả",
    ["ui_Christmas2022_001"]="Ú Òa Giáng Sinh",
    ["ui_Christmas2022_002"]="Bảo vệ Xưởng Đồ Chơi",
    ["ui_Christmas2022_003"]="Sửa Xe Trượt Tuyết",
    ["ui_Christmas2022_004"]="Hôm nay\nđã nhận",
    ["ui_Christmas2022_005"]="Tiến độ sửa",
    ["ui_Christmas2022_006"]="Xe trượt tuyết của ông già Noel bị Garm phá hỏng rồi! Mọi người hãy cùng giúp đỡ sửa chữa nhé!",
    ["ui_Christmas2022_007"]="\u{3000}\u{3000}<color=#b3f56d>Đầu Người Bánh Xanh</color> mỗi ngày đều ủy thác Nhà Thám Hiểm xử lý <color=#a0edfe>sự cố đột nhập</color> của Garm Baby, hoàn thành nhiệm vụ có thưởng hậu hĩnh đấy nhé!",
    ["ui_Christmas2022_008"]="Mô tả lối chơi:",
    ["ui_Christmas2022_009"]="\u{3000}\u{3000}<color=#b3f56d>Garm</color> dạo này suốt ngày đột nhập xưởng! Nghe nói chỉ có <color=#a0edfe>biến hình</color> mới thoát khỏi phép thuật của nó. Hãy cùng bảo vệ xưởng nhé!",
    ["ui_Christmas2022_010"]="Tiến độ cá nhân",
    ["ui_Christmas2022_011"]="Xác suất nhận được",
    ["ui_Christmas2022_012"]="Nguyên liệu cần",
    ["ui_Christmas2022_013"]="Hàng ngày đến map Giáng Sinh để tìm Chú Hề nấp trong đó. Chỉ cần bạn tìm thấy anh ta, bạn sẽ được thưởng!!",
    ["ui_ChristmasActivity_001"]="Hộp Nội Thất cần <color=#fffaaf>mở khoá tính năng Gia Viên</color> mới có thể sử dụng!",
    ["ui_ChristmasActivity_002"]="Hôm nay không tham gia",
    ["ui_ChristmasActivity_003"]="Phụ lục tuần này:",
    ["ui_ChristmasActivity_004"]="Xếp hạng ngày hôm nay",
    ["ui_ChristmasActivity_005"]="pháo hoa nhẹ",
    ["ui_ChristmasActivity_006"]="tinh thể năng lượng",
    ["ui_ChristmasActivity_007"]="Tiến bộ cá nhân:",
    ["ui_ChristmasGift_001"]="Gói Vui Mùa Noel",
    ["ui_ChristmasMagic_001"]="Chế độ Shot",
    ["ui_ChristmasMagic_002"]="Sự kiện Halloween",
    ["ui_ChristmasMagic_003"]="Đại Chiến Noel",
    ["ui_ChristmasMagic_004"]="Mua tại Tiệm Noel ở Geffen\nĐạo cụ giới hạn cần có: Ná",
    ["ui_ChristmasMagic_005"]="Tốn Odin để có Đạn Ph.Thuật\n\nPhẩm đạn cao, đạn càng mạnh!",
    ["ui_ChristmasMagic_006"]="Dùng Ná hoặc đến gần bệ pháo để bắn, nhắm và bắn vỡ bóng để nhận Quà. Bóng càng lớn, thưởng càng ngon!",
    ["ui_ChristmasMagic_007"]="Geffen, đang diễn ra lễ hội Bóng Noel Ma Lực",
    ["ui_ChristmasMagic_008"]="Bắn trúng bóng sẽ được Quà Noel tuyệt đẹp!",
    ["ui_ChristmasMagic_009"]="Đổi Noel",
    ["ui_ChristmasMagic_010"]="Bóng Angeling Vàng",
    ["ui_ChristmasMagic_011"]="Bắn vỡ rơi",
    ["ui_ChristmasMagic_012"]="Thú cưỡi Xe Trượt Tuyết Gấu Tuyết",
    ["ui_ChristmasMagic_013"]="Thú cưỡi Nôi Chuông Lắc",
    ["ui_ChristmasMagic_014"]="Thời trang Noel ngẫu nhiên",
    ["ui_ChristmasMagic_015"]="Huân Chương Người Tuyết",
    ["ui_ChristmasMagic_016"]="Huân Chương Ngôi Nhà Tuyết",
    ["ui_ChristmasMagic_017"]="Được đổi",
    ["ui_ChristmasMagic_018"]="Huân Chương Kẹo Bơ Cứng",
    ["ui_ChristmasMagic_019"]="Huân Chương Xe Lửa Nhỏ",
    ["ui_ChristmasMagic_020"]="Huân Chương Người Bánh Gừng",
    ["ui_ChristmasMagic_021"]="Huân Chương Mũ Noel",
    ["ui_ChristmasMagic_022"]="Thời trang Noel-Mặt Trời Mùa Đông",
    ["ui_ChristmasMagic_023"]="Thời trang Noel-Lời Sao Chúc Phúc",
    ["ui_ChristmasMagic_024"]="Thú cưỡi Noel-Thân",
    ["ui_ChristmasMagic_025"]="Huân Chương Cây Thông Noel",
    ["ui_ChristmasMagic_026"]="Huân Chương Tất Quà",
    ["ui_ChristmasMagic_027"]="Huân Chương Chuông",
    ["ui_ChristmasMagic_028"]="Huân Chương Tuần Lộc",
    ["ui_ChristmasMagic_029"]="Trang sức Noel-Thiên Sứ Băng Tuyết",
    ["ui_ChristmasMagic_030"]="Thú cưỡi Noel-Đầu",
    ["ui_ChristmasMagic_031"]="Nhắc nhở: Bắn vỡ bóng không những rơi vật phẩm chính, còn có tỉ lệ rơi quà tặng Noel khác!",
    ["ui_ChristmasMagic_032"]="Danh sách thưởng",
    ["ui_ChristmasMagic_033"]="Vào Tiệm Noel trong Thành Geffen\n Mua đạo cụ cần thiết",
    ["ui_ChristmasMagic_034"]="Nhận bằng cách tiêu Odin, tham gia MVP hoặc khiêu chiến Bệ Trái Tim, rương độ sôi nổi và Tiệm Noel",
    ["ui_ChristmasMagic_035"]="Phẩm chất đạn càng cao, uy lực bắn càng mạnh~",
    ["ui_ChristmasMagic_036"]="Vào góc nhìn bắn Dùng Ná Tuần Lộc, \nngắm chuẩn bóng bay, bắn dứt khoát\n sẽ nhận được",
    ["ui_ChristmasMagic_037"]="Bóng bay càng to thưởng càng nhiều",
    ["ui_ChristmasMagic_038"]="Ná Tuần Lộc phiên bản giới hạn~",
    ["ui_ChristmasMagic_039"]="Ná Pháp Thuật",
    ["ui_ChristmasMagic_040"]="Quà Noel",
    ["ui_CoCoActivity_001"]="Tiệm Trà Sữa CoCo",
    ["ui_CoCoActivity_002"]="Vui Đùa RO",
    ["ui_CoCoActivity_003"]="Uống COCO",
    ["ui_CoCoActivity_004"]="Sự kiện kỳ này đã kết thúc, mau đi đổi thưởng nào",
    ["ui_CoCoActivity_005"]="Sức mạnh thế giới khác đã đến lục địa Midgard, các Nhà Thám Hiểm đi thu thập Sức Mạnh Trời Sao CoCo nào!",
    ["ui_CoCoActivity_006"]="Sức Mạnh Trời Sao COCO có thể đổi quà, còn có cơ hội nhận Phiếu Đổi Đồ Uống ở Tiệm COCO ngoài đời.",
    ["ui_CoCoActivity_007"]="Vật phẩm này chỉ được dùng ở tiệm trong phạm vi Đài Loan, có muốn đổi?",
    ["ui_CoCoActivity_008"]="Xác nhận",
    ["ui_CoCoActivity_009"]="Hủy",
    ["ui_CoCoActivity_010"]="Số lần còn toàn server:",
    ["ui_CoCoActivity_011"]="Số lần đổi:",
    ["ui_CoCoActivity_012"]="Đổi",
    ["ui_CoCoActivity_013"]="1. 5:00:00 30/4/2021—5:00:00 10/5/2021, có thể hoàn thành nhiệm vụ ngày nhận Sức Mạnh Trời Sao COCO\n2. Trạng thái thưởng và nhiệm vụ sẽ cài lại vào 5:00 sáng mỗi ngày, thưởng chưa nhận sau khi cài lại sẽ không giữ lại, thời gian đổi Sức Mạnh Trời Sao COCO sẽ kết thúc vào 5:00:00 14/5/2021.\n3. Phiếu Đồ Uống CoCo chỉ có 9500 phần trong thời gian sự kiện, dựa vào thời gian đổi trước sau để tiến hành đổi, khi số lượng còn về 0 sẽ không thể đổi\n4. Trước 21:00 25/5/2021, có thể đến tiệm CoCo ở Đài Loan để đổi đồ uống, hết hạn sẽ khong thể đổi (Thời gian kết thúc đổi dựa vào thời gian mở cửa của tiệm)\n5. Trong thời gian sự kiện hỏi nhân viên để dùng Phiếu Đồ Uống CoCo, nhận ngay 1 ly đồ uống Nho Trời Sao trị giá 75 Đài Tệ, không thể đổi đồ uống khác và thêm topping\n6. Một số tiệm không hỗ trợ sự kiện đổi, Nhà Thám Hiểm cần hỏi nhân viên trước, rồi hãy dùng đạo cụ Phiếu Đồ Uống CoCo, dùng đạo cụ trước khi xác nhận sẽ không bồi thường\n7. Đạo cụ đổi Sức Mạnh Trời Sao COCO sau khi sự kiện kết thúc sẽ tự động thu hồi, hãy đổi thưởng kịp thời để tránh mất mát\n8. Ragnarok X: Thế Hệ Mới & CoCo có quyền điều chỉnh nội dung sự kiện tặng đồ uống",
