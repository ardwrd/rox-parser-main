    ["mount_cant_fight"]="Ko cưỡi lúc đánh",
    ["mount_desc_80001"]="Chim Pecopeco có phải là thứ bạn yêu thích nhất không?",
    ["mount_desc_80002"]="Alpaca ngốc nghếch khiến hành trình của bạn trở lên hoàn hảo",
    ["mount_desc_80003"]="Khí thế thần thánh của Cửu Vĩ Hồ đang trào dâng",
    ["mount_desc_80004"]="Trên thân có khắc chữ: Goblin chế tạo để đối phó Geffen",
