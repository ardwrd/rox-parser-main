    ["DialogueOption39712031"]="Đúng vậy",
    ["DialogueOption39712041"]="...Chẳng lẽ là <color=#CA2E0AFF>Sai Yilian</color> sao?",
    ["DialogueOption39713011"]="(Gật đầu)",
    ["DialogueOption39713021"]="Ta hiểu rồi",
    ["DialogueOption39718011"]="Tất nhiên",
    ["DialogueOption39801021"]="Đúng vậy",
    ["DialogueOption39901011"]="... Quyết định gì??",
    ["DialogueOption39901021"]="Ta không hiểu những gì ngươi đang nói...",
    ["DialogueOption39901051"]="Ta…?",
    ["DialogueOption39902011"]="Đợi một chút! Ta…",
    ["DialogueOption39902021"]="(Gật đầu lia lịa)",
    ["DialogueOption39902031"]="Nhưng ta...",
    ["DialogueOption39902041"]="(Suy nghĩ) Dường như...",
    ["DialogueOption39902051"]="Có thể...?",
    ["DialogueOption39903011"]="Xin chào~",
    ["DialogueOption39903012"]="Các ngươi đang nói chuyện gì vậy?",
    ["DialogueOption39903051"]="(Ngạc nhiên) Các ngươi...",
    ["DialogueOption39904011"]="Ta sắp... nghẹt thở rồi!",
