    ["OXExam_Question083_1"]="Ngôn ngữ hoa của Anh Túc Trắng là lãng quên",
    ["OXExam_Question084"]="<color=#F2C730FF>Hoa Hồng Trắng</color> tượng trưng cho <color=#F2C730FF>mối tình đầu</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question084_1"]="Hoa Hồng Trắng tượng trưng cho sự thuần khiết",
    ["OXExam_Question085"]="<color=#F2C730FF>Hoa Bỉ Ngạn</color> tượng trưng cho <color=#F2C730FF>biệt ly</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question086"]="Mùa đông đổ nước nóng vào <color=#F2C730FF>cốc thủy tinh dày</color> càng dễ bị <color=#F2C730FF>vỡ</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question087"]="Dùng <color=#F2C730FF>khăn lông khô</color> nhẹ nhàng nhấn vào tóc ẩm, có tác dụng <color=#F2C730FF>dưỡng tóc</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question088"]="Trong đội phục vụ Kafra có một người sử dụng <color=#F2C730FF>giấm trong bữa ăn</color> để xóa đi <color=#F2C730FF>mùi của gạo</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question089"]="Người nghiên cứu quái vật gần đây <color=#F2C730FF>khứu giác</color> càng ngày càng kém, nguyên nhân là do <color=#F2C730FF>chức năng gan</color> bị suy giảm, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question089_1"]="Chức năng phổi suy nhược",
    ["OXExam_Question090"]="Talyn gần đây có chút <color=#F2C730FF>nóng trong người</color>, nguyên nhân là do ăn quá nhiều <color=#F2C730FF>Vải</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question091"]="<color=#F2C730FF>Miêu Nữ</color> của quán rượu Foulon vì <color=#F2C730FF>lưỡi</color> rất mẫn cảm, nên trước giờ không ăn đồ ăn <color=#F2C730FF>nóng</color>, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
    ["OXExam_Question092"]="<color=#F2C730FF>Đá Khô</color> là do <color=#F2C730FF>nước</color> ngưng đọng mà thành, đúng <color=#64b4ff>(O)</color> hay sai <color=#ff6481>(X)</color>?",
