    ["ui_WhiteValentineDayActivity_001"]="Tình Nhân Thành Đôi",
    ["ui_WhiteValentineDayActivity_002"]="Hạc Giấy Chung Tình",
    ["ui_WhiteValentineDayActivity_003"]="Mỗi ngày Sứ Giả Trong Sáng sẽ đợi các Nhà Thám Hiểm ở cổng Nhà Thờ Lớn Prontera\nSau khi nhận nhiệm vụ, hãy tổ đội với người mình yêu mến đến Khu Vui Chơi Cổng Nam~\nHoàn thành nhiệm vụ để nhận Hộp Quà Khoảnh Khắc Yêu Thương và Hạc Giấy Trắng",
    ["ui_WhiteValentineDayActivity_004"]="Thần Tình Yêu Cupid dành tặng mọi người phiếu giảm giá <size=28>50%</size>, chỉ được nhận và dùng trong thời gian sự kiện thôi nhé~",
    ["ui_WhiteValentineDayActivity_005"]="Trong thời gian sự kiện, Nhà Thám Hiểm không chỉ có thể nhận được Hộp Quà Năm Tháng Yêu Thương trong các nhiệm vụ, mà còn có thể mua chúng trong Quà Tặng Bạn Bè!\nTặng Hộp Quà Năm Tháng Yêu Thương cho người trong lòng, không chỉ có thể tăng cao Độ Thiện Cảm, mà người nhận được hộp quà còn nhận được Nấu Ăn Đặc Biệt, Hộp Cookie Vàng hoặc Hộp Cookie Bạc",
    ["ui_WhiteValentineDayActivity_006"]="Nghe nói những Nhà Thám Hiểm không cùng chúc phúc Cookie đến gần và cùng làm động tác bắn tim sẽ gọi ra được chúc phúc của <color=#D39FEFFF>Thần Tình Yêu Cupid</color>, đồng thời còn rơi ra Hạc Giấy Trắng\nCó thêm xác suất rơi <color=#FD97B6FF>Hạc Giấy Hồng</color> nữa đấy",
    ["ui_WhiteValentineDayActivity_007"]="Sau khi cùng bạn đời gọi ra chắc chắn sẽ rơi <size=24>Hạc Giấy Hồng</size>, đổi được phần thưởng hiếm",
    ["ui_WhiteValentineDayActivity_008"]="Sự kiện Valentine Trắng",
    ["ui_WhiteValentineDayActivity_009"]="Giới hạn",
    ["ui_WineCelebration_001"]="Mời bạn gia nhập",
    ["ui_WineCelebration_002"]="Thêm Rượu",
    ["ui_WineCelebration_003"]="Mời Trực Tiếp",
    ["ui_WineCelebration_004"]="Say Rượu",
    ["ui_WineCelebration_005"]="Từ Bỏ",
    ["ui_WineCelebration_006"]="Nguyên Liệu Món Ăn",
    ["ui_WineCelebration_007"]="Hoàn thành việc chuẩn bị các món ăn, có thể nhận món quà của bà chủ",
    ["ui_WineCelebration_008"]="Giao Nguyên Liệu",
    ["ui_WineCelebration_009"]="Đồng Bộ Món Ăn",
    ["ui_WineCelebration_010"]="Tạm không có lịch sử",
    ["ui_WineCelebration_011"]="Không có lời mời tiệc rượu",
    ["ui_WineCelebration_012"]="Không có yêu cầu tổ đội tiệc rượu",
    ["ui_WineCelebration_013"]="Không có yêu cầu tiệc rượu",
    ["ui_WineCelebration_014"]="Hàng ngày",
    ["ui_WineCelebration_015"]="Lời mời tiệc rượu",
    ["ui_WineCelebration_016"]="Xin nhập cuộc",
    ["ui_WorldKvmInvitedInfo_1"]="Mời tổ đội",
    ["ui_WorldKvmInvitedInfo_2"]="%s mời bạn vào đội %s trong Cuộc Chiến Thần Chọn, (*^▽^*)",
    ["ui_WorldKvmRule_1"]="Cẩm nang giải đấu",
    ["ui_WorldKvmRule_10"]="Đấu Xếp Hạng",
    ["ui_WorldKvmRule_11"]="Các đội ở mỗi server đã được bỏ phiếu thăng hạng sẽ đấu với nhau theo thể lệ đấu vòng tròn theo xếp hạng.\nQuy tắc đấu vòng tròn:\nHạng 1VS8, hạng 2VS7, hạng 3VS6, hạng 4VS5\nHình thức chiến đấu 5V5, lúc bắt đầu chiến đấu, cần đến chỗ NPC chỉ định, để dịch chuyển đến chiến trường thi đấu, đội trưởng chọn tối đa 5 người để thi đấu, tối đa 3 người dự bị, mỗi trận đấu có 3 lượt, đội thắng 2 lượt sẽ thăng hạng vào vòng sau, thua sẽ bị loại, nếu số hiệp thắng của 2 bên bằng nhau, sẽ quyết định thắng thua dựa vào số liệu chiến đấu của hiệp quyết thắng, số liệu cao sẽ thắng, mức độ ưu tiên như sau: Số người còn sống>Tổng sát thương>Tổng số diệt>Tổng số trị thương",
    ["ui_WorldKvmRule_12"]="Đấu loại",
    ["ui_WorldKvmRule_13"]="Đội quán quân đấu tranh vé mỗi server được vào đấu vòng loại, những suất khác sẽ được bổ sung theo thời gian mở server, số lượng danh sách cụ thể sẽ xem trong “Danh sách đăng ký server”\nQuy tắc đấu vòng tròn:\nTất cả các đội trong đấu vòng loại được chia ngẫu nhiên vào 8 cụm đấu, ghép đấu ngẫu nhiên theo vòng tròn, hạng một mỗi cụm đấu sẽ được vào tranh giải quán quân chung kết\nHình thức chiến đấu giống với đấu tranh vé, lúc bắt đầu chiến đấu, cần đăng nhập trong thời gian chỉ định để tham gia thi đấu ở trận đấu SV liên tương ứng, các dữ liệu như trang bị của người chơi sẽ được tự động đồng bộ vào máy chủ của trận đấu 3 tiếng trước khi bắt đầu trận đấu, hãy chú ý điều chỉnh nhân vật của bạn trước lúc này, để tránh nhân vật trong trận đấu bất thường.\nNgười chơi không vào máy chủ trận đấu trong thời hạn, sẽ xem như cá nhân từ bỏ thi đấu vòng này",
    ["ui_WorldKvmRule_14"]="Dự đoán thắng thua",
    ["ui_WorldKvmRule_15"]="Ở GĐ đấu tranh vé và đấu vòng loại đều mở dự đoán thắng thua, dùng Pha Lê để tham gia dự đoán\nDự đoán sai sẽ mất hết Pha Lê đặt cược, dự đoán đúng sẽ trả lại Pha Lê đặt cược, đồng thời nhận được Pha Lê của bên dự đoán sai theo tỷ lệ Pha Lê mình dự đoán. Phần lợi ích này sẽ thu 10% phí thủ tục. Thưởng cần nhận bằng tay trong trang \"Dự Đoán Của Tôi\", lợi ích sinh ra trong ngày sẽ được nhận vào 05:00 ngày hôm sau.",
    ["ui_WorldKvmRule_16"]="Thưởng giải đấu",
    ["ui_WorldKvmRule_17"]="Thưởng đấu tranh vé",
    ["ui_WorldKvmRule_18"]="Thưởng tham gia đấu tranh vé",
    ["ui_WorldKvmRule_19"]="Thưởng quán quân đấu tranh vé",
    ["ui_WorldKvmRule_2"]="Chuẩn bị tham gia",
    ["ui_WorldKvmRule_20"]="Thưởng đấu loại",
    ["ui_WorldKvmRule_21"]="Thưởng quán quân cụm đấu đấu loại",
    ["ui_WorldKvmRule_22"]="Thưởng Quán Quân Cuối",
    ["ui_WorldKvmRule_23"]="Tên SV này",
    ["ui_WorldKvmRule_24"]="Dựa theo thời gian mở của máy chủ, mỗi máy chủ có số lượng tham gia đấu loại khác nhau, ví dụ máy chủ chỉ có 1 suất thì quán quân của đấu tranh vé sẽ tham gia đấu loại, nếu máy chủ có 2 suất thì quán quân và á quân đều có thể tham gia đấu loại, số lượng cụ thể như sau:",
    ["ui_WorldKvmRule_25"]="Tên máy chủ",
    ["ui_WorldKvmRule_26"]="Số lượng",
    ["ui_WorldKvmRule_27"]="Thể chế tham gia đấu tranh vé",
    ["ui_WorldKvmRule_28"]="Bấm vào Avatar để đến <color=#f65050>Sigrdrifa</color>và vào trận đấu.\nLưu ý thời gian vào sân đấu hợp lệ là trong vòng <color=#f65050>5 phút</color> sau khi bắt đầu trận đấu, nếu quá thời gian vào sẽ bị hủy tư cách tham gia trận này",
    ["ui_WorldKvmRule_29"]="Thể chế tham gia đấu loại",
    ["ui_WorldKvmRule_3"]="Quy tắc tham gia",
    ["ui_WorldKvmRule_30"]="Trước khi trận đấu bắt đầu<color=#f65050> 3 tiếng </color>sẽ đồng bộ dữ liệu nhân vật với máy chủ giải đấu. Lúc đó, người chơi phải bấm chọn [Server giải đấu] trong danh sách server rồi nhấp vào nhân vật để vào trận đấu.\nNgười tham gia hãy vào máy chủ giải đấu trước để xem dữ liệu nhân vật, nếu có vấn đề hãy báo lại kịp thời",
    ["ui_WorldKvmRule_31"]="Thể chế giải đấu",
    ["ui_WorldKvmRule_4"]="Nhà Thám Hiểm có Cấp Base≥45 đều có thể tham gia cả quá trình giải đấu: GĐ. Chuẩn Bị→GĐ. Bỏ Phiếu→Đấu tranh vé→Đấu loại→Sảnh Vinh Dự",
    ["ui_WorldKvmRule_5"]="Tạo đội",
    ["ui_WorldKvmRule_6"]="Chỉ những Nhà Thám Hiểm đã nhận được vật phẩm [Chứng Nhận Thần Chọn] trong hoạt động Thần Chọn Bị Chiến mới có thể tạo đội Thần Chọn riêng, Nhà Thám Hiểm đủ điều kiện khác có thể tham gia vào đội đã tạo để tham gia giải đấu.\nSau khi tạo đội, có 5 ngày để chiêu mộ đồng đội, mỗi đội có tối đa 8 người, khi đội có ít nhất 5 người và tất cả đội viên đã sẵn sàng đăng ký, đội trưởng có thể tự gửi đăng ký thủ công hoặc tự động đăng ký sau khi kết thúc thời gian đăng ký, nếu số lượng thành viên dưới 5, đội sẽ không thể đăng ký, sẽ không thể thay đổi thành viên đội sau khi đăng ký.",
    ["ui_WorldKvmRule_7"]="Bỏ phiếu thăng hạng",
    ["ui_WorldKvmRule_8"]="Tất cả Nhà Thám Hiểm trong server này đều có thể bỏ phiếu cho đội mình yêu thích, 8 đội đứng đầu sẽ được vào tham gia đấu tranh vé.\nCó bốn cấp độ phiếu bầu, trong đó phiếu Lv.1 có thể nhận được trong hoạt động Thần Chọn Bị Chiến, phiếu bầu này không thể giao dịch, có thể mở thẻ VIP hoặc dùng thẻ VIP đã có để nhận được số phiếu Lv.2-Lv.4 nhất định trong thời gian hoạt động Thần Chọn Bị Chiến, các phiếu bầu này có thể giao dịch trong Quầy Giao Dịch, tất cả phiếu bầu sẽ bị xóa sau khi kết thúc giai đoạn bỏ phiếu, chú ý sử dụng",
    ["ui_WorldKvmRule_9"]="Đối chiến giải đấu",
    ["ui_WorldKvmVote_001"]="Tổng %s điểm phiếu bầu",
    ["ui_quickBuy"]="Mua nhanh",
