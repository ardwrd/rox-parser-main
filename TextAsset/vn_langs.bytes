    ["MoonFestivalTips_018"]="Nông Trường Hoang Dã",
    ["MoonFestivalTips_019"]="Rừng Trúc Núi Xa",
    ["MoonFestivalTips_020"]="<color=#fffad6>Chợ Của Tôi</color>",
    ["MoonFestivalTips_021"]="Có dùng đạo cụ Đèn Cầu Nguyện không, dùng có thể nhận thưởng độc quyền",
    ["MoonFestivalTips_022"]="Không đủ số lượng Xiên Nướng Bách Vị",
    ["MoonFestivalTips_023"]="Không đủ số lượng có thể nhận",
    ["MoonFestivalTips_024"]="Sử dụng nguyên liệu sự kiện để làm Xiên Nướng Bách Vị",
    ["MoonFestivalTips_025"]="Chọn Pet Thám Hiểm",
    ["MoonFestivalTips_026"]="Thời gian sự kiện: %s",
    ["MoonFestivalTips_027"]="Thời hạn nhận thưởng: %s",
    ["MoonFestivalTips_028"]="Chưa sở hữu đạo cụ này",
    ["MoonFestivalTips_029"]="Bán Xiên Nướng Bách Vị nhận",
    ["MoonFestivalTips_030"]="Số lượng có thể bán cho chợ này: %s",
    ["MoonFestivalTips_031"]="Số lượng có thể thu mua tại chợ này không đủ",
    ["MoonFestivalTips_032"]="X.suất: %s%%",
    ["MoonFestivalTips_033"]="Tỷ lệ xuất hàng: %s%%",
    ["MoonFestivalTips_034"]="Chưa nhập UID hoặc định dạng sai",
    ["MoonFestivalTips_035"]="Mô tả quy tắc:\nTrong sự kiện này, hãy thu thập các vật liệu sự kiện để làm xiên Baiwei và bán chúng cho mọi người trong chợ để nhận xu của đảng, có thể đổi lấy thời trang quý hiếm, phụ kiện trở lại, hiệu ứng dịch chuyển tức thời và đuôi di động tại cửa hàng trao đổi ~ Hãy thử tìm một loại có giá mua cao nhất Bán trong chợ để nhận thêm Party Coin!\nSử dụng Đèn Cầu Nguyện để có xác suất nhận được Pet và Thú Cưỡi hiếm!\nSự kiện được chia thành thời gian sự kiện và thời gian nhận thưởng, tham gia sự kiện trong thời gian nhận thưởng sẽ không được tính nữa, chỉ có thể đổi vật phẩm trong Tiệm.\n\n- Xiên Nướng\nTrong thời gian sự kiện, sử dụng nguyên liệu sự kiện có thể làm Xiên Nướng Bách Vị\n\n- Chợ Đêm Vui Vẻ\nTrong thời gian sự kiện, có thể đến Chợ Đêm của người chơi khác hoặc bán Xiên Nướng Bách Vị tại Chợ Đêm của mình để nhận nguyên liệu đổi trong Tiệm\nGiá thu mua được làm mới hàng ngày\nSố lượng tối đa có thể thu mua hàng ngày cho mỗi Chợ Đêm là 250, giới hạn này được chia đều cho tất cả người chơi\nSố lượng bán tối đa của mỗi người chơi ở mỗi Chợ Đêm là 50\nCó thể ghé thăm Chợ Đêm của bạn bè hoặc thành viên Công Hội của mình\nLối chơi Chợ Đêm là lối chơi liên server, có thể nhập UID của người chơi tương ứng để trực tiếp ghé thăm Chợ Đêm tương ứng\nKhi có người chơi bán thành công 1 đạo cụ ở Chợ Đêm của mình, sẽ được hoàn 1 đạo cụ đổi\nTự bán ở Chợ Đêm của mình sẽ không được hoàn\n\n- Thí Luyện Hương Vị\nTiến độ của nhiệm vụ hàng ngày sẽ được làm mới mỗi ngày, nếu hoàn thành nhiệm vụ tích lũy, có thể nhận được Điểm Bếp Trưởng tương ứng, đạt điểm có thể nhận được thưởng\n\n- Hành Trình Khám Phá Tươi Ngon\nĐối với Pet thám hiểm, sau khi chọn Pet thám hiểm có thể thực hiện thám hiểm. Thám hiểm có thể nhận thưởng, mỗi địa điểm sẽ làm mới Pet tiến cử mỗi ngày. Sử dụng Pet tiến cử để thám hiểm, ngoài việc chắc chắn nhận được thưởng cố định ra, còn nhận được thưởng thêm\n\n- Pháo Hoa Ban Phúc\nTrong thời gian sự kiện, kích hoạt Chúc Phúc Odin và tiêu diệt quái vật, có thể rơi nguyên liệu và Đèn Cầu Nguyện\nThịt thì là, rau tươi và xiên tre để cầu nguyện\nNhỏ 3,50% 3,50% 1,33% 0,67% 0,01%\nVừa 7,00% 7,00% 2,67% 1,33% 0,02%\nLớn 10,50% 10,50% 4,00% 2,00% 0,03%\nGiới hạn hàng ngày 210 210 80 40 1\nCó khóa không - Không khóa - Không khóa - Không khóa - Không khóa - Khóa\nTrong thời gian diễn ra sự kiện, tỷ lệ thành công khi nâng cấp thú cưng lên chất lượng A/S sẽ tăng 50%.\nSử dụng Đèn Cầu Nguyện sẽ tiến hành ngẫu nhiên trong kho địa điểm, sau khi tới nơi, nhấp vào Dùng sẽ nhận được thưởng",
    ["MountBagHideTips"]="Khi cưỡi thú cưỡi này, vật trang trí phía sau bị ẩn đi",
    ["MountBagShowTips"]="Khi cưỡi thú cưỡi này, vật trang trí phía sau sẽ được hiển thị",
    ["MountBattleJob"]="Nghề cưỡi khi đánh: %s",
    ["MountFightLimit"]="Thú cưỡi thường không thể cưỡi khi chiến đấu",
    ["MountLuaInfo_1"]="Người",
    ["MountPartDes_158010101"]="Là một bước cải tiến nhỏ, nhưng cũng là một bước tiến lớn.​",
    ["MountPartDes_158010201"]="Với tư thế của một nhà vô địch, phun sương nước tự do.",
    ["MountPartDes_162010101"]="Đèn xe được cải tạo rất phổ biến trong tộc Ác Quỷ.",
    ["MountPartDes_162010201"]="Khi được thắp sáng vào giữa đêm, có thể khiến mọi người sợ hãi.",
    ["MountPartDes_162010301"]="Trang trí Mô Tô mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Lễ Giáng Sinh.",
    ["MountPartDes_162010401"]="Đèn xe bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_162010501"]="Phúc khí tận trời, ai thấy sẽ phát tài!",
    ["MountPartDes_162020101"]="Đồ trang trí bánh xe kèm theo ma thuật của tộc Ác Quỷ.",
    ["MountPartDes_162020201"]="Công suất quá tải có thể biến thành bí ngô luộc ngon miệng.",
    ["MountPartDes_162020301"]="Lốp xe cơ giới với kiểu dáng kinh điển nhất.",
    ["MountPartDes_162020401"]="Trang trí Mô Tô mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Lễ Giáng Sinh.",
    ["MountPartDes_162020501"]="Bánh xe bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_174010101"]="Cuộn bí ẩn chứa Nhẫn Thuật",
    ["MountPartDes_174010201"]="Kiếm Ninja uy phong lẫm liệt",
    ["MountPartDes_174010301"]="Yên màu xám có độ ổn định tốt",
    ["MountPartDes_174010401"]="Trang trí Cóc Ninja mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Lễ Giáng Sinh.",
    ["MountPartDes_174010501"]="Cuộn bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_174010601"]="Phúc khí tận trời, ai thấy sẽ phát tài!",
    ["MountPartDes_174020101"]="Trang phục Ninja hiên ngang",
    ["MountPartDes_174020201"]="Dây buộc quấn quanh toàn bộ cơ thể có tác dụng bảo vệ tuyệt vời",
    ["MountPartDes_174020301"]="Giáp vai màu đỏ có tác dụng bảo vệ rất tốt",
    ["MountPartDes_174020401"]="Trang trí Cóc Ninja mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Lễ Giáng Sinh.",
    ["MountPartDes_174020501"]="Trang phục Ninja bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_180010101"]="Dũng mãnh trung thành, là đồng đội tuyệt vời của thợ săn.",
    ["MountPartDes_180010201"]="Màu lông độc đáo có thể khiến mặt tuyết trở thành trường săn tuyệt nhất.",
    ["MountPartDes_200010101"]="Chế tạo bằng kỹ thuật kế thừa ngàn năm, chứa đựng sức mạnh bí ẩn.",
    ["MountPartDes_200010201"]="Mũ giáp được điêu khắc bằng ngọc may mắn, nghe nói có thể phá giải mọi lời nguyền tà ác.",
    ["MountPartDes_200010301"]="Một mắt đỏ không bao giờ nhắm lại, vĩnh viễn chờ đợi tai ương giáng xuống.",
    ["MountPartDes_200020101"]="Lắc tay được đan bằng dây ngũ sắc, phát ra âm thanh \"leng keng\" theo gió.",
    ["MountPartDes_200020201"]="Dây chuyền ngọc khảm vàng nặng trĩu, có ý nghĩa phù hộ mọi sự thuận lợi.",
    ["MountPartDes_200020301"]="Dây chuyền hình rắn sặc sỡ, toả ra hơi thở cao quý mà nguy hiểm.",
    ["MountPartDes_201010101"]="Nhẹ như mây, tinh khiết như tuyết.",
    ["MountPartDes_201010201"]="Có lẽ tham ăn hạt dẻ sẽ biến thành màu của nó?",
    ["MountPartDes_215020201"]="Trong biển cát vô hạn, mỗi một hạt bụi đều có thể làm dậy cơn sóng.",
    ["MountPartDes_216010101"]="Hoa Tú Cầu sinh trưởng theo gió, hương thơm nồng nàn bay theo hướng xuân.",
    ["MountPartDes_216010201"]="Bồ Công Anh sinh trưởng theo gió, hương thơm nồng nàn bay theo hướng xuân.",
    ["MountPartDes_218020201"]="Điện tích loé ra ánh sáng tím, không ngừng biến đổi cực trường.",
    ["MountPartDes_222020201"]="Khát máu, che giấu bóng tối.",
    ["MountPartDes_232010101"]="Múa cùng rồng, cùng mừng xuân mới!",
    ["MountPartDes_238010101"]="Áo giáp xương động vật cứng.",
    ["MountPartDes_238010201"]="Chiếc mũ đội đầu được Chúa ban phước.",
    ["MountPartDes_238010301"]="Khai thác dung nham sâu trong lõi trái đất giống như một chiếc mũ đội đầu bằng những ngọn lửa đông đặc.",
    ["MountPartDes_238020101"]="Yên xương động vật cứng.",
    ["MountPartDes_238020201"]="Khai thác dung nham sâu trong lõi trái đất giống như một ngọn lửa đã đông cứng.",
    ["MountPartDes_238020301"]="Khai thác dung nham sâu trong lõi trái đất giống như một ngọn lửa đã đông cứng.",
    ["MountPartDes_241010101"]="Áo giáp xương động vật cứng.",
    ["MountPartDes_241010201"]="Một chiếc mũ đội đầu màu bạc hoàn hảo trong mơ.",
    ["MountPartDes_241010301"]="Những chiếc áo giáp đắt tiền thường được những người có địa vị cao sử dụng.",
    ["MountPartDes_241020101"]="Yên xương động vật cứng.",
    ["MountPartDes_241020201"]="Một chiếc yên giấc mơ màu bạc hoàn hảo.",
    ["MountPartDes_241020301"]="Những chiếc yên đắt tiền thường được những người có địa vị cao sử dụng.",
    ["MountPartDes_250010101"]="An exquisite silver helmet, engraved with the proud emblem of the Royal Chivalry.",
    ["MountPartDes_250010201"]="Infused with Odin's power, this sacred helmet is a gift for fearless champions.",
    ["MountPartDes_250010301"]="Runes of ancient power are inscribed within the helmet, with magic flowing like living flames.",
    ["MountPartDes_250020101"]="An exquisite silver saddle, engraved with the proud emblem of the Royal Chivalry.",
    ["MountPartDes_250020201"]="Infused with Odin's power, this sacred saddle is a gift for fearless champions.",
    ["MountPartDes_250020301"]="Runes of ancient power are inscribed within the saddle, with magic flowing like living flames.",
    ["MountPartDes_80015"]="Đến gặp người đổi màu thú cưỡi Prontera để đổi màu.",
    ["MountPartDes_815010101"]="Trang phục phong cách Thương Gia màu xanh lam, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815010102"]="Trang phục phong cách Thương Gia màu cam, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815010103"]="Trang phục phong cách Thương Gia màu đỏ, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815010104"]="Trang phục phong cách Thương Gia màu xanh lục, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815010105"]="Trang phục phong cách Thương Gia màu xanh nâu, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815010201"]="Phục trang Heo Rừng đầy vui tươi, khiến mọi người cảm thấy ấm áp trong mùa đông.",
    ["MountPartDes_815010301"]="Hóa trang phú quý, hóa trang năm mới với tông màu nền đỏ viền vàng, quý phái và sang trọng.",
    ["MountPartDes_815010401"]="Mũ Xe Đẩy Quà Tặng",
    ["MountPartDes_815010501"]="Mũ Xe Mãnh Hổ",
    ["MountPartDes_815010601"]="Trang trí Heo Rừng mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_815010701"]="Một trong những bộ trang phục của Trư Bát Giới sau khi quy y cửa Phật, dường như lớn hơn mũ của nhà sư bình thường.",
    ["MountPartDes_815010801"]="Mũ giáp bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_815010901"]="Phúc khí tận trời, ai thấy sẽ phát tài!",
    ["MountPartDes_815020101"]="Trang phục phong cách Thương Gia màu xanh lam, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815020102"]="Trang phục phong cách Thương Gia màu cam, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815020103"]="Trang phục phong cách Thương Gia màu đỏ, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815020104"]="Trang phục phong cách Thương Gia màu xanh lục, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815020105"]="Trang phục phong cách Thương Gia màu xanh nâu, có trang bị đầy đủ đồ cho chuyến đi dài.",
    ["MountPartDes_815020201"]="Bộ đồ thám hiểm tiện lợi màu xanh lam, thuận tiện khi phải đương đầu với hoàn cảnh khắc nghiệt.",
    ["MountPartDes_815020202"]="Bộ đồ thám hiểm tiện lợi màu cam, thuận tiện khi phải đương đầu với hoàn cảnh khắc nghiệt.",
    ["MountPartDes_815020203"]="Bộ đồ thám hiểm tiện lợi màu đỏ, thuận tiện khi phải đương đầu với hoàn cảnh khắc nghiệt.",
    ["MountPartDes_815020204"]="Bộ đồ thám hiểm tiện lợi màu xanh lục, thuận tiện khi phải đương đầu với hoàn cảnh khắc nghiệt.",
    ["MountPartDes_815020205"]="Bộ đồ thám hiểm tiện lợi màu xanh nâu, thuận tiện khi phải đương đầu với hoàn cảnh khắc nghiệt.",
    ["MountPartDes_815020501"]="Giá Hàng Xe Đẩy Quà Tặng",
    ["MountPartDes_815020601"]="Yên Xe Mãnh Hổ",
    ["MountPartDes_815020701"]="Trang trí Heo Rừng mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_815020801"]="Một trong những bộ trang phục của Trư Bát Giới sau khi quy y cửa Phật, sau khi mặc sẽ lộ ra cái rốn dễ thương.",
    ["MountPartDes_815020901"]="Giáp lưng bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_816010101"]="Kính bảo hộ gắn động cơ màu xanh lam, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816010102"]="Kính bảo hộ gắn động cơ màu cam, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816010103"]="Kính bảo hộ gắn động cơ màu đỏ, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816010104"]="Kính bảo hộ gắn động cơ màu xanh lục, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816010105"]="Kính bảo hộ gắn động cơ màu xanh nâu, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816010201"]="Phục trang Đà Điểu đầy vui tươi, khiến mọi người cảm thấy ấm áp trong mùa đông.",
    ["MountPartDes_816010301"]="Hóa trang diều đỏ, hóa trang năm mới với tông màu nền đỏ viền vàng, quý phái và sang trọng.",
    ["MountPartDes_816010401"]="Mũ Vệ Binh Lễ Hội",
    ["MountPartDes_816010501"]="Trang Trí Cầm Sư Đắc Chí",
    ["MountPartDes_816010601"]="Trang trí Đà Điểu mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_816010701"]="Một trong những bộ trang phục của Sa Ngộ Tĩnh sau khi quy y cửa Phật, tuy bề ngoài xấu xa nhưng trong lòng có Phật.",
    ["MountPartDes_816010801"]="Mũ giáp bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_816010901"]="Phúc khí tận trời, ai thấy sẽ phát tài!",
    ["MountPartDes_816020101"]="Kính bảo hộ gắn động cơ màu xanh lam, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816020102"]="Kính bảo hộ gắn động cơ màu cam, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816020103"]="Kính bảo hộ gắn động cơ màu đỏ, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816020104"]="Kính bảo hộ gắn động cơ màu xanh lục, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816020105"]="Kính bảo hộ gắn động cơ màu xanh nâu, khi hành động càng trở lên nhanh nhẹn.",
    ["MountPartDes_816020201"]="Khăn choàng giữ ấm màu xanh lam.",
    ["MountPartDes_816020202"]="Khăn choàng giữ ấm màu cam.",
    ["MountPartDes_816020203"]="Khăn choàng giữ ấm màu đỏ.",
    ["MountPartDes_816020204"]="Khăn choàng giữ ấm màu xanh lục.",
    ["MountPartDes_816020205"]="Khăn choàng giữ ấm màu xanh nâu.",
    ["MountPartDes_816020501"]="Đồng Phục Vệ Binh Lễ Hội",
    ["MountPartDes_816020601"]="Áo Khoác Cầm Sư Đắc Chí",
    ["MountPartDes_816020701"]="Trang trí Đà Điểu mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_816020801"]="Một trong những bộ trang phục của Sa Ngộ Tĩnh sau khi quy y cửa Phật, chiếc vòng cổ đầu lâu trên ngực đã được chuyển thành chuỗi tràng hạt.",
    ["MountPartDes_816020901"]="Giáp lưng bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_817010101"]="Giáp kim loại hạng nặng màu xanh lam, khí thế kinh người.",
    ["MountPartDes_817010102"]="Giáp kim loại hạng nặng màu cam, khí thế kinh người.",
    ["MountPartDes_817010103"]="Giáp kim loại hạng nặng màu đỏ, khí thế kinh người.",
    ["MountPartDes_817010104"]="Giáp kim loại hạng nặng màu xanh lục, khí thế kinh người.",
    ["MountPartDes_817010105"]="Giáp kim loại hạng nặng màu xanh nâu, khí thế kinh người.",
    ["MountPartDes_817010201"]="Phục trang Linh Cẩu đầy vui tươi, khiến mọi người cảm thấy ấm áp trong mùa đông.",
    ["MountPartDes_817010301"]="Hóa trang thú vị, hóa trang năm mới với tông màu nền đỏ viền vàng, quý phái và sang trọng.",
    ["MountPartDes_817010401"]="Mũ Scrooge",
    ["MountPartDes_817010501"]="Mũ Đầu Bếp Giao Thừa",
    ["MountPartDes_817010601"]="Trang trí Linh Cẩu mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_817010701"]="Hai sừng của Ngưu Ma Đại Vương, trừ tai diệt họa, vô cùng sắc bén.",
    ["MountPartDes_817010801"]="Mũ giáp bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_817010901"]="Phúc khí tận trời, ai thấy sẽ phát tài!",
    ["MountPartDes_817020101"]="Giáp kim loại hạng nặng màu xanh lam, khí thế kinh người.",
    ["MountPartDes_817020102"]="Giáp kim loại hạng nặng màu cam, khí thế kinh người.",
    ["MountPartDes_817020103"]="Giáp kim loại hạng nặng màu đỏ, khí thế kinh người.",
    ["MountPartDes_817020104"]="Giáp kim loại hạng nặng màu xanh lục, khí thế kinh người.",
    ["MountPartDes_817020105"]="Giáp kim loại hạng nặng màu xanh nâu, khí thế kinh người.",
    ["MountPartDes_817020201"]="Trang phục phong cách hung ác màu xanh lam.",
    ["MountPartDes_817020202"]="Trang phục phong cách hung ác màu cam.",
    ["MountPartDes_817020203"]="Trang phục phong cách hung ác màu đỏ.",
    ["MountPartDes_817020204"]="Trang phục phong cách hung ác màu xanh lục.",
    ["MountPartDes_817020205"]="Trang phục phong cách hung ác màu xanh nâu.",
    ["MountPartDes_817020501"]="Thảm Treo Scrooge",
    ["MountPartDes_817020601"]="Xửng Hấp Đầu Bếp Giao Thừa",
    ["MountPartDes_817020701"]="Trang trí Linh Cẩu mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_817020801"]="Bộ giáp vàng của Ngưu Ma Đại Vương, nước, lửa, đao, thương đều không thể xuyên thủng.",
    ["MountPartDes_817020901"]="Giáp lưng bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_818010101"]="Trang phục của sát thủ dị quốc màu xanh lam, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818010102"]="Trang phục của sát thủ dị quốc màu cam, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818010103"]="Trang phục của sát thủ dị quốc màu đỏ, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818010104"]="Trang phục của sát thủ dị quốc màu xanh lục, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818010105"]="Trang phục của sát thủ dị quốc màu xanh nâu, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818010201"]="Phục trang Cửu Vĩ Hồ đầy vui tươi, khiến mọi người cảm thấy ấm áp trong mùa đông.",
    ["MountPartDes_818010301"]="Hóa trang hoa đỏ, hóa trang năm mới với tông màu nền đỏ viền vàng, quý phái và sang trọng.",
    ["MountPartDes_818010401"]="Mũ Gậy Băng Tuyết",
    ["MountPartDes_818010501"]="Mũ Linh Hổ Uy Phong",
    ["MountPartDes_818010601"]="Trang trí Cửu Vĩ Hồ mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_818010701"]="Đôi sừng của Đông Hải Long Vương trong Thuỷ Tinh Cung, có khả năng hô mưa gọi gió.",
    ["MountPartDes_818010801"]="Mũ giáp bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_818010901"]="Phúc khí tận trời, ai thấy sẽ phát tài!",
    ["MountPartDes_818020101"]="Trang phục của sát thủ dị quốc màu xanh lam, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818020102"]="Trang phục của sát thủ dị quốc màu cam, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818020103"]="Trang phục của sát thủ dị quốc màu đỏ, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818020104"]="Trang phục của sát thủ dị quốc màu xanh lục, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818020105"]="Trang phục của sát thủ dị quốc màu xanh nâu, hãy cẩn thận với những lọ thuốc và mấy con dao bay.",
    ["MountPartDes_818020201"]="Trang phục hộ vệ Cửu Vĩ Hồ màu xanh lam.",
    ["MountPartDes_818020202"]="Trang phục hộ vệ Cửu Vĩ Hồ màu cam.",
    ["MountPartDes_818020203"]="Trang phục hộ vệ Cửu Vĩ Hồ màu đỏ.",
    ["MountPartDes_818020204"]="Trang phục hộ vệ Cửu Vĩ Hồ màu xanh lục.",
    ["MountPartDes_818020205"]="Trang phục hộ vệ Cửu Vĩ Hồ màu xanh nâu.",
    ["MountPartDes_818020501"]="Áo Khoác Gậy Băng Tuyết",
    ["MountPartDes_818020601"]="Nút Dây Linh Hổ Uy Phong",
    ["MountPartDes_818020701"]="Trang trí Cửu Vĩ Hồ mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_818020801"]="Giáp vảy của Đông Hải Long Vương trong Thuỷ Tinh Cung, trước ngực có vảy ngược, động vào đó sẽ nổi cơn thịnh nộ.",
    ["MountPartDes_818020901"]="Giáp lưng bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_819010101"]="Trang phục phong cách du khách màu xanh lam.",
    ["MountPartDes_819010102"]="Trang phục phong cách du khách màu cam.",
    ["MountPartDes_819010103"]="Trang phục phong cách du khách màu đỏ.",
    ["MountPartDes_819010104"]="Trang phục phong cách du khách màu xanh lục.",
    ["MountPartDes_819010105"]="Trang phục phong cách du khách màu xanh nâu.",
    ["MountPartDes_819010201"]="Phục trang Alpaca đầy vui tươi, khiến mọi người cảm thấy ấm áp trong mùa đông.",
    ["MountPartDes_819010301"]="Hóa trang cầu phúc, hóa trang năm mới với tông màu nền đỏ viền vàng, quý phái và sang trọng.",
    ["MountPartDes_819010401"]="Mũ Tuyết Trắng Đêm Đông",
    ["MountPartDes_819010501"]="Mũ Hổ Vàng Tài Lộc",
    ["MountPartDes_819010601"]="Trang trí Alpaca mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_819010701"]="Mũ Tì Lư hình hoa sen, một trong những đồ vật của Huyền Trang Đại Sư khi sang Tây trúc lấy kinh.",
    ["MountPartDes_819010801"]="Mũ giáp bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_819010901"]="Phúc khí tận trời, ai thấy sẽ phát tài!",
