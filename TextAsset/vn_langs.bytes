    ["RE0_answer_01"]="Thuộc tính phép thuật của Emilia là gì?",
    ["RE0_answer_02"]="Lửa",
    ["RE0_answer_03"]="Nước",
    ["RE0_answer_04"]="Gió",
    ["RE0_answer_05"]="trái đất",
    ["RE0_answer_06"]="Rem là bộ tộc nào?",
    ["RE0_answer_07"]="bộ tộc mèo",
    ["RE0_answer_08"]="bộ tộc chó",
    ["RE0_answer_09"]="Lizardman",
    ["RE0_answer_10"]="Tộc ma",
    ["RE0_answer_11"]="Natsuki Subaru giỏi cái gì?",
    ["RE0_answer_12"]="lộn nhào",
    ["RE0_answer_13"]="ảo thuật",
    ["RE0_answer_14"]="đọc tốc độ",
    ["RE0_answer_15"]="Câu Cá",
    ["RE0_answer_16"]="Hợp đồng Elf Parker của Emilia dành cho Emilia?",
    ["RE0_answer_17"]="Mẹ",
    ["RE0_answer_18"]="Bố",
    ["RE0_answer_19"]="chị gái",
    ["RE0_answer_20"]="anh trai",
    ["RE0_answer_21"]="Rem đã làm công việc gì ở dinh thự Roswaal?",
    ["RE0_answer_22"]="Quét dọn vệ sinh",
    ["RE0_answer_23"]="quần áo sạch",
    ["RE0_answer_24"]="Nấu nướng",
    ["RE0_answer_25"]="Mọi việc nhà",
    ["RE0_answer_26"]="Natsuki Subaru thường mặc trang phục gì?",
    ["RE0_answer_27"]="áo khoác thể thao",
    ["RE0_answer_28"]="Bộ đồ",
    ["RE0_answer_29"]="áo tắm",
    ["RE0_answer_30"]="đồng phục chiến đấu",
    ["RE0_npc_01"]="Nhân vật chính là người ngu dốt, bất tài và bất lực.",
    ["RE0_npc_02"]="Đột nhiên được triệu hồi đến một thế giới khác, anh rơi vào một tình thế tiến thoái lưỡng nan không thể giải quyết được.",
    ["RE0_npc_03"]="Với tính cách không biết sợ hãi và làn da dày bẩm sinh, dù bị nản lòng trước nghịch cảnh, anh vẫn dũng cảm đối mặt với số phận khắc nghiệt.",
    ["RE0_npc_04"]="\"Mụ phù thủy ghen tị\" từng suýt hủy diệt thế giới là một cô gái nửa yêu tinh xinh đẹp với mái tóc bạc và đôi mắt xanh tím.",
    ["RE0_npc_05"]="Cô ấy tốt bụng và hay giúp đỡ, nhưng vì lý do nào đó lại miễn cưỡng thừa nhận điều đó một cách công khai.",
    ["RE0_npc_06"]="Bên cạnh anh là Parker, một yêu tinh trong hình dạng một chú mèo con. Cô là một trong những ứng cử viên trở thành vị vua tiếp theo của Vương quốc Lugnica.",
    ["RE0_npc_07"]="Một người giúp việc phụ trách công việc tại dinh thự của Roswaal.",
    ["RE0_npc_08"]="Hoạt động bình thường của trang viên gần như phụ thuộc hoàn toàn vào khả năng của cô.",
    ["RE0_npc_09"]="Cô là một người sống sót của tộc ma có sức mạnh to lớn và rất yêu thương người chị song sinh Ram.",
    ["ROXicDialog_00"]="Vì vinh quang!",
    ["ROXicDialog_01"]="Chào mừng đến với Đấu Trường Của Thần, bạn có thể chuyển đổi giới tính và chuyển nghề trước ở khu vực này, nếu không có nhu cầu, hãy đến khu vực bồi dưỡng",
    ["ROXicDialog_02"]="Đoạt lấy vinh quang này, bạn đã sẵn sàng chưa?",
