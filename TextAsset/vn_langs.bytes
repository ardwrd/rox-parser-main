    ["GVEAwardTips_1"]="Vòng %s",
    ["GVEBattle_1"]="Giai đoạn chuẩn bị <color=#ff6f76>[Cổng Dị Giới]</color> <color=#df4f52>%s</color>",
    ["GVEBattle_10"]="Thời gian thoát: %s",
    ["GVEBattle_11"]="Thí luyện kết thúc, trong giai đoạn này những quái vật chưa bị tiêu diệt vẫn có thể tiếp tục diệt, trong giai đoạn này sẽ không làm mới quái vật, vui lòng chờ hội trưởng phân chia phần thưởng!",
    ["GVEBattle_12"]="Thưởng cá nhân vòng này: ",
    ["GVEBattle_13"]="Thưởng Công Hội vòng này: ",
    ["GVEBattle_14"]="Toàn bộ quái vật đã bị tiêu diệt, thí luyện kết thúc, vui lòng thoát ra đợi hội trưởng phân chia phần thưởng!",
    ["GVEBattle_2"]="Giai đoạn chiến đấu <color=#ff6f76>[Cổng Dị Giới]</color> <color=#df4f52>%s</color>",
    ["GVEBattle_3"]="Giai đoạn thoát <color=#ff6f76>[Cổng Dị Giới]</color> <color=#df4f52>%s</color>",
    ["GVEBattle_4"]="Đếm ngược thời gian mở thí luyện: %s",
    ["GVEBattle_5"]="Chuẩn bị ra trận: %s %s",
    ["GVEBattle_6"]="T/g còn: %s",
    ["GVEBattle_7"]="Thời gian BOSS sắp xuất hiện: %s",
    ["GVEBattle_8"]="Vòng hiện tại: Vòng %s",
    ["GVEBattle_9"]="Chiến đấu hiện tại: %s %s",
    ["GVERules_1"]="Giai đoạn thu thập",
    ["GVERules_1_1"]="Sau khi Công Hội đạt cấp 2, giao đơn hàng Công Hội sẽ nhận được Năng Lượng Dị Giới, thứ cần dùng để mở sự kiện Cổng Dị Giới ",
    ["GVERules_1_2"]="Khi năng lượng Dị Giới đạt đủ điều kiện, sự kiện sẽ được mở",
    ["GVERules_1_3"]="Thành viên mới gia nhập Công Hội, tính từ lúc vào trong 72h nộp đơn Công Hội, không thể nhận được năng lượng Dị Giới",
    ["GVERules_1_4"]="Năng lượng Dị Giới sau khi đạt 100000, nếu tiếp tục nộp đơn sẽ không thể nhận thêm năng lượng, hãy chú ý mở sự kiện kịp thời",
    ["GVERules_2"]="Mở chiến đấu",
    ["GVERules_2_1"]="Sau khi đủ điều kiện mở, hội trưởng có thể đến gặp NPC tương ứng để đặt lịch chiến đấu vào ngày hôm sau",
    ["GVERules_2_2"]="Sau khi đặt lịch thành công, sẽ khấu trừ số năng lượng Dị Giới tương ứng, trận chiến sẽ bắt đầu theo thời gian đã đặt trước",
    ["GVERules_3"]="Giai đoạn chiến đấu",
    ["GVERules_3_1"]="Khi bắt đầu giai đoạn chiến đấu, sẽ lập tức xuất hiện BOSS đầu tiên. Chiến đấu BOSS sẽ tiến hành luân phiên, mỗi lần tiêu diệt 1 con BOSS, con BOSS tiếp theo sẽ xuất hiện sau 10s",
    ["GVERules_3_2"]="Mỗi lần tiêu diệt 1 con BOSS sẽ nhận được thưởng cá nhân và Công Hội tương ứng",
    ["GVERules_3_3"]="Sau khi kết thúc giai đoạn chiến đấu, con BOSS chưa bị tiêu diệt sẽ tồn tại cho đến khi kết thúc giai đoạn thoát ra (Sau khi kết thúc giai đoạn chiến đấu 5 phút), trong thời gian này tiêu diệt BOSS vẫn sẽ nhận được phần thưởng",
    ["GVERules_3_4"]="Thành viên mới gia nhập Công Hội, tính từ lúc gia nhập trong vòng 72h không thể tham gia chiến đấu ở Cổng Dị Giới",
    ["GVERules_4"]="Phân chia thưởng",
    ["GVERules_4_1"]="Thưởng chiến đấu chia làm thưởng cá nhân và thưởng Công Hội",
    ["GVERules_4_2"]="Thưởng cá nhân sẽ nhận được ngay mỗi khi tiêu diệt 1 con BOSS",
    ["GVERules_4_3"]="Thưởng Công Hội mỗi khi tiêu diệt 1 con BOSS sẽ lập tức được chuyển vào kho Công Hội, hội trưởng có thể tiến hành phân chia thưởng",
    ["GVERules_5"]="Chọn Độ Khó",
    ["GVERules_5_1"]="Hội trưởng có thể chọn độ khó của Boss muốn khiêu chiến trước khi hẹn trước chiến đấu, độ khó khác nhau tương ứng với thưởng khác nhau.",
    ["GVERules_5_2"]="Sau khi hoàn thành thời gian hẹn trước chiến đấu, không thể thay đổi độ khó khiêu chiến.",
    ["GVERules_5_3"]="Nếu bạn muốn khiêu chiến độ khó mới, cần phải vượt qua tất cả Boss của độ khó trước đó.",
    ["GVE_1"]="T/g còn: ",
    ["GVE_2"]="Hãy mau chóng trở về lãnh địa Công Hội tham gia chiến đấu!",
    ["GVE_2008"]="Chưa mở khóa Cổng Dị Giới, hãy thăng cấp Công Hội lên Lv.2",
    ["GVE_2009"]="Tiến độ chưa đủ điều kiện để mở, vui lòng đạt đủ điều kiện để mở sự kiện",
    ["GVE_2011"]="Cổng Dị Giới đã mở, hãy chú ý tham gia chiến đấu",
    ["GVE_3"]="Công Hội đạt %s cấp sẽ mở khóa",
    ["GVE_4"]="Hôm nay: %s",
    ["GVE_5"]="Ngày mai: %s",
    ["GVE_6"]="Chọn thời gian mở thành công, Cổng Dị Giới vòng này sẽ mở vào ngày mai lúc %s",
    ["GVE_7"]="Chuẩn bị chiến đấu",
    ["GVE_8"]="Giai đoạn chiến đấu",
    ["GVGTips_1"]="Đếm ngược chiến đấu: %s",
    ["GVGTips_2"]="T/g còn: %s",
    ["GVGTips_3"]="Bạn đã hỗ trợ tiêu diệt %s của Công Hội %s, nhận được %s Chiến Tích",
    ["GVGTips_4"]="Đạt %s điểm trước sẽ giành chiến thắng",
