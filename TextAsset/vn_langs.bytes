    ["MountPartDes_834020501"]="Áo Giáp Đại Tướng Tiếu Hổ",
    ["MountPartDes_834020601"]="Trang trí Sói Quỷ mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_834020701"]="Giáp Chân Võ của Nhị Lang Chân Quân, treo Cờ Hiển Thánh Chân Quân, đeo thanh kiếm hai lưỡi ba ​​đầu, bách chiến bách thắng, bất khả chiến bại.",
    ["MountPartDes_834020801"]="Giáp lưng bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_836010101"]="Giáp Da",
    ["MountPartDes_836010201"]="Mũ Giáp Thép",
    ["MountPartDes_836010301"]="Trang trí Griffin mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_836010401"]="Được làm bằng lông gà con dài năm thước, tương truyền khi đại náo thiên cung, cái đuôi đã từng tát vào mặt tất cả tiên nhân.",
    ["MountPartDes_836010501"]="Mũ giáp bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
