    ["ItemDes_10801162"]="Thư bí ẩn từ Đại Thống Lĩnh",
    ["ItemDes_10801163"]="Hạt của cây Trắc Bách, nếu pha trà có tác dụng an thần, sảng khoái tinh thần.",
    ["ItemDes_10801164"]="Nước từ tuyết trên núi cao tan chảy, mát lạnh sảng khoái",
    ["ItemDes_10801165"]="Trà có tác dụng an thần, tỏa ra hương thơm",
    ["ItemDes_10801166"]="Một bức ảnh có manh mối",
    ["ItemDes_10801167"]="Dây chuyền lắp ráp Android bị bỏ hoang",
    ["ItemDes_10801168"]="Bảng Điều Khiển Dữ Liệu",
    ["ItemDes_10801169"]="Hàng Hóa Của Hội Eden",
    ["ItemDes_10801170"]="Bộ Khuếch Đại Tín Hiệu",
    ["ItemDes_10801171"]="Tàn Tích Hỗn Loạn",
    ["ItemDes_10801172"]="Giếng Cạn Bí Ẩn",
    ["ItemDes_10801184"]="Dấu vết do sói quỷ Karen để lại có thể được chuyển cho NPC Evelin trong sự kiện [Theo dõi bóng sói] để thúc đẩy tiến độ của nhiệm vụ.",
    ["ItemDes_10802001"]="Sách cầu nguyện rách nát, trông có vẻ đã cũ lắm rồi.",
    ["ItemDes_10802002"]="Vải để làm quần áo chuyển nghề.",
    ["ItemDes_10802003"]="Khoáng thạch phát ra ánh sáng lấp lánh, rất cứng.",
    ["ItemDes_10802004"]="Lõi vận động của Myst, tràn đầy ma lực.",
    ["ItemDes_10802005"]="Mảnh vải của Hồn Ma Trắng, sau khi tịnh hóa rất thuần khiết.",
    ["ItemDes_10802006"]="Da của Chuột Marmot, giữ ấm tốt.",
    ["ItemDes_10802007"]="Xương của Chiến Binh Xương Khô, tỏa ra âm khí đáng sợ.",
    ["ItemDes_10802008"]="Quần áo thành phẩm của Thợ Rèn, có thể mua trực tiếp",
    ["ItemDes_10802009"]="Ngón Tay Bongun",
