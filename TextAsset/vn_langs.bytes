    ["CommercialChamberTips_4"]="Bán được %s x %s",
    ["CommercialChamberTips_5"]="Có bán <color=#6799ff>{1}</color> chiếc <color=#6799ff>{2}</color> với giá <color=#6799ff>{0}</color> Zeny không? ",
