    ["SkillSketch_1000105"]="Bắt được Pet",
    ["SkillTips_1"]="Ở trạng thái chiến đấu không thể dùng đạo cụ này",
    ["SkillTips_2"]="Tôi cần một mục tiêu",
    ["SkillTips_3"]="Chưa tốn điểm kỹ năng, không thể cài lại",
