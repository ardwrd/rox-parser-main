    ["ui_Jobber035"]="Theo dõi",
    ["ui_Jobber036"]="Tôi muốn mua",
    ["ui_Jobber037"]="Tôi muốn bán",
    ["ui_Jobber038"]="Ghi chép",
    ["ui_Jobber039"]="Trang Bị Hiếm",
    ["ui_Jobber040"]="Quần áo",
    ["ui_Jobber041"]="Giày",
    ["ui_Jobber042"]="Áo Khoác",
    ["ui_Jobber043"]="VK Tay Chính",
    ["ui_Jobber044"]="VK Tay Phụ",
    ["ui_Jobber045"]="VK 2 Tay",
    ["ui_Jobber046"]="Áo Khoác",
    ["ui_Jobber047"]="Thời trang",
    ["ui_Jobber048"]="Thẻ",
    ["ui_Jobber049"]="Mảnh Thẻ",
    ["ui_Jobber050"]="Giám Định Hiếm",
    ["ui_Jobber051"]="Trang Bị",
    ["ui_Jobber052"]="Hãy chọn vật phẩm muốn bán（#￣▽￣#）",
    ["ui_Jobber053"]="Nhấp vào chữ ký bên trái để mua (>▽<)",
    ["ui_Jobber054"]="Quá giờ",
    ["ui_Jobber055"]="Kim Cương",
    ["ui_Jobber056"]="Hướng dẫn Quầy Giao Dịch",
    ["ui_Jobber057"]="Mua Pha Lê sẽ được nhận luôn, nhận trong Ghi chép giao dịch\nVới Kim Cương, được mua tối đa 5000 KC/ngày và 30000 KC/tháng",
    ["ui_Jobber058"]="Quy tắc mua:",
    ["ui_Jobber059"]="Vật phẩm có thể bán sẽ được hệ thống tự động hiển thị lên danh sách bày bán\nCó thể điều chỉnh giá bán khi bày bán vật phẩm, tăng hoặc giảm theo mốc hệ thống quy định.\nVật phẩm bày bán thành công sẽ có thời gian bán, nếu quá giờ sẽ xem như quá hạn và hoàn trả đạo cụ\nSau khi bán thành công sẽ nhận Pha Lê, đồng thời hệ thống sẽ khấu trừ thuế giao dịch",
    ["ui_Jobber060"]="Quy tắc bán:",
    ["ui_Jobber061"]="Người chơi tham gia đấu giá sẽ chia làm 3 giai đoạn: [Đấu Giá Công Khai], [Đấu Giá Bí Mật] và [Đấu Giá PK]\nMỗi lần đấu giá, giá khởi điểm là 100 và không giới hạn\nKhi đấu giá, sẽ khấu trừ Kim Cương của giá đấu, số Kim Cương này sẽ lưu vào [Kho Đấu Giá] \nXem hoặc rút từ [Kho Đấu Giá], Kim Cương vẫn sẽ hoàn trả qua thư sau khi đấu giá kết thúc",
    ["ui_Jobber062"]="Quy tắc mua:",
    ["ui_Jobber063"]="Nếu vật phẩm bán thuộc loại Đồ Hiếm (Bao gồm: Trang bị hiếm, cài tóc, thẻ, v.v được giao dịch bằng Kim Cương), hệ thống sẽ tự động đổi sang chế độ [Đấu Giá]\nNhập giá muốn bán khi bày bán vật phẩm, giá bán không được thấp hơn mức giá quy định tối thiểu\nTrong vòng 6 tiếng sau khi vào đấu giá, nếu không có người chơi nào ra giá, vật phẩm xem như chưa bán và sẽ được hoàn trả cho người bán.\nSau khi giao dịch thành công, người bạn vào [Nhật Ký Giao Dịch] để nhận lợi nhuận, Kim Cương nhận được sẽ chuyển thành Pha Lê với cùng giá trị\nVào 1:00-7:00 mỗi ngày là thời gian nghỉ ngơi của sàn giao dịch Kim Cương. Những đơn hàng trong thời gian này sẽ tiếp tục đếm ngược khi sàn mở lại.",
    ["ui_Jobber064"]="Quy tắc bán:",
    ["ui_Jobber065"]="Giao dịch thành công",
    ["ui_Jobber066"]="Đấu giá vật phẩm",
    ["ui_Jobber067"]="Bày bán vật phẩm",
    ["ui_Jobber068"]="Quy trình đấu giá:",
    ["ui_Jobber069"]="Đồ thường",
    ["ui_Jobber070"]="Đồ hiếm",
    ["ui_Jobber071"]="Đang bán: ",
    ["ui_Jobber072"]="Nhập đồ vật",
    ["ui_Jobber073"]="Chưa nhận",
    ["ui_Jobber074"]="Bùa",
    ["ui_Jobber075"]="Đang bán",
    ["ui_Jobber076"]="Pet Hiếm",
    ["ui_Jobber077"]="Lồng Pet",
    ["ui_Jobber078"]="Pet Hệ Nước",
    ["ui_Jobber079"]="Pet Hệ Lửa",
    ["ui_Jobber080"]="Pet Hệ Gió",
    ["ui_Jobber081"]="Pet Hệ Đất",
    ["ui_Jobber082"]="Pet Hệ Độc",
    ["ui_Jobber083"]="Pet Hệ Thánh",
    ["ui_Jobber084"]="Pet Hệ Bóng Tối",
    ["ui_Jobber085"]="Pet Hệ Hồn Ma",
    ["ui_Jobber086"]="Pet Hệ Thây Ma",
    ["ui_Jobber087"]="Sách Kỹ Năng Pet",
    ["ui_Jobber088"]="Cơ chế thuế thấp:",
    ["ui_Jobber089"]="Người chơi mặc định có 500000 Pha Lê được tính thuế thấp, Thẻ VIP Kafra sẽ được tăng hạn mức.\nNếu tổng doanh thu tuần < mức thuế thấp thì thuế giao dịch thấp\nNếu tổng doanh thu tuần > mức thuế thấp, sẽ dựa vào phạm vi thuế suất của tổng doanh thu tuần để khấu trừ\nphí giao dịch với tỉ lệ khác nhau.\nTổng doanh thu tuần sẽ bị xóa vào 5:00 thứ hai hàng tuần để bắt đầu thống kê tổng doanh thu của tuần tiếp theo.",
    ["ui_Jobber090"]="Tiến cấp Pet",
    ["ui_Jobber091"]="Sách Pet",
    ["ui_Jobber092"]="Đấu Giá PK",
    ["ui_Jobber093"]="Bán chạy",
    ["ui_Jobber094"]="Lượng giao dịch",
    ["ui_Jobber095"]="Biên độ tăng",
    ["ui_Jobber096"]="Biên độ giảm",
    ["ui_Jobber097"]="Tổng doanh thu tuần: ",
    ["ui_Jobber098"]="Mức thuế thấp:",
    ["ui_Jobber099"]="Thuế suất giai đoạn: ",
    ["ui_Jobber100"]="GD thành công",
    ["ui_Jobber101"]="Khán giả",
    ["ui_Jobber102"]="Đấu Giá",
    ["ui_Jobber103"]="Chờ bán",
    ["ui_Jobber104"]="Kho Đấu Giá",
    ["ui_Jobber105"]="Đấu giá công khai: ",
    ["ui_Jobber106"]="Giai đoạn đấu giá đầu tiên, người chơi sẽ chọn vật phẩm tiến hành ra giá, \n chỉ những người chơi đã tham gia đấu giá công khai mới được vào [Đấu Giá Bí Mật].\nThời gian đấu giá công khai kéo dài 5 giờ 30 phút",
    ["ui_Jobber107"]="Đấu Giá Bí Mật: ",
    ["ui_Jobber108"]="Đấu giá công khai kết thúc sẽ vào giai đoạn [Đấu Giá Bí Mật].\nNgười chơi trong đấu giá bí mật sẽ chỉ nhìn thấy giá của chính mình, không thể thấy giá của người chơi khác. \nGiá ra phải cao hơn giá lần trước tối thiểu 100.\nĐấu giá bí mật có giới hạn về mặt giá cả, vật phẩm đấu giá bí mật có giới hạn về mặt ra giá, giá ra cao nhất trong giai đoạn này\n bằng 1.5 lần giá ra cao nhất trong giai đoạn đấu giá công khai.\nKhi đấu giá bí mật kết thúc, nếu chỉ có một người ra giá cao nhất thì người chơi đó sẽ nhận được vật phẩm\nĐấu giá bí mật kéo dài 30 phút",
    ["ui_Jobber109"]="Đấu Giá PK: ",
    ["ui_Jobber110"]="Nếu [Đấu Giá Bí Mật] kết thúc, nếu có nhiều người ra giá cao nhất, trong 60 giây sau sẽ vào [PK Đấu Giá].\n[PK Đấu Giá] có giao diện đấu giá hoàn toàn mới, quá trình đấu giá sẽ được Livestream trên toàn server, giai đoạn này \ntrong Quầy Giao Dịch sẽ xuất hiện tab PK Đấu Giá, người chơi có thể vào PK Đấu Giá đang diễn ra ở đây\n[PK Đấu Giá, người chơi có tổng 5 lần ra giá, mỗi lần ra giá sẽ cài lại đếm ngược kết thúc, khi hết \n thời gian, người ra giá cao nhất sẽ nhận được vật phẩm này.\nNgười xem có thể tặng quà để tăng Nổi Tiếng cho người chơi, nếu người đấu giá được ủng hộ giành phần thắng, sẽ nhận được phần thưởng đặt cược\nChú ý: Chỉ khi có Thẻ VIP Kafra đã kích hoạt mới được tặng quà.",
    ["ui_Jobber111"]="Đấu Giá Bí Mật",
    ["ui_Jobber112"]="(Đấu Giá)",
    ["ui_Jobber113"]="(Giao Dịch)",
    ["ui_Jobber114"]="Cơ chế đặt mua: ",
    ["ui_Jobber115"]="Nếu vật phẩm đã mở tính năng đặt mua, khi Quầy Giao Dịch hết hàng, sẽ xuất hiện tùy chọn đặt mua\nTính năng đặt mua giúp đặt mua trước vật phẩm trong Quầy Giao Dịch, khi vật phẩm được bày bán sẽ ưu tiên hoàn thành những đơn đặt mua.\nĐối với một vật phẩm, mỗi lần chỉ được đặt 1 đơn, những đơn đặt mua của các vật phẩm khác sẽ tính riêng\nĐơn đặt mua sẽ duy trì trong 48 giờ, khi đã gửi đơn sẽ không thể hủy\nNếu giá cao nhất của vật phẩm cao hơn giá đặt mua, đơn đặt mua sẽ bị đóng.\nĐơn đặt mua sau khi hoàn thành hoặc đóng, số dư sẽ được hoàn trả cho người chơi qua thư.\nGiao dịch đã hoàn thành có thể nhận trong ghi chép giao dịch, số dư sẽ được thanh toán khi đơn đặt mua đóng",
    ["ui_Jobber116"]="Thuế giao dịch Kim Cương: ",
    ["ui_Jobber117"]="Thuế giao dịch Kim Cương sẽ được thu theo từng giai đoạn dựa trên giá giao dịch cuối cùng.\nMức thuế cho mỗi khoảng thời gian là khác nhau, vui lòng xem bảng bên dưới để biết chi tiết (đơn vị: Kim Cương)",
    ["ui_Jobber118"]="Hình thức thuế: ",
    ["ui_Jobber119"]="Thuế dưới hạn",
    ["ui_Jobber120"]="Hướng dẫn Đào Mỏ",
    ["ui_Jobber121"]="Hướng dẫn Thu Thập",
    ["ui_Jobber122"]="Hướng dẫn Câu Cá",
    ["ui_Jobber123"]="Nuôi trang bị",
    ["ui_Jobber124"]="Buff chiến đấu",
    ["ui_Jobber125"]="Xu & Sự Kiện",
    ["ui_Jobber126"]="Đếm ngược nhận",
    ["ui_Jobber127"]="Quảng cáo giao dịch",
    ["ui_Jobber128"]="Ghép đơn",
    ["ui_Jobber129"]="Bạn đang treo bán vật phẩm cực hiếm, Quầy Giao Dịch cung cấp cho bạn dịch quảng cáo đầy ưu đãi!",
    ["ui_Jobber130"]="—Tiếp tân Quầy Giao Dịch",
    ["ui_Jobber131"]="Không quảng cáo",
    ["ui_Jobber132"]="Quảng cáo",
    ["ui_Jobber133"]="Đang mua...",
    ["ui_Jobber134"]="Xác nhận thanh toán: ",
    ["ui_Jobber135"]="Đặt mua",
    ["ui_Jobber136"]="Giá đặt mua",
    ["ui_Jobber137"]="Tiếp tân Quầy Giao Dịch",
    ["ui_Jobber138"]="Đến ngay!",
    ["ui_Jobber139"]="Quà",
    ["ui_Jobber140"]="Bồi dưỡng Shadow",
    ["ui_Jobber141"]="Thuế thường",
    ["ui_Jobber142"]="Thuế thẻ VIP",
    ["ui_Jobber143"]="Thuế trên hạn",
    ["ui_Jobber144"]="Thuế ",
    ["ui_Jobber145"]="Tư liệu",
    ["ui_Jobber146"]="Sắp hết hạn",
    ["ui_Jobber147"]="Lượng ghi chép giao dịch đã đạt giới hạn hiển thị, mời nhận rồi hãy xem ",
    ["ui_Jobber148"]="Đã ở dưới đáy rùi nhoa! ",
    ["ui_Jobber149"]="Pet",
    ["ui_Jobber150"]="Chọn nhanh",
    ["ui_Jobber151"]="Chọn nhận: ",
    ["ui_Jobber152"]="Trang Ghi chép giao dịch tăng thêm phần hiển thị lựa chọn, gồm: Toàn bộ đơn hàng; Đơn hàng mua; Đơn hàng bán. Sau khi chọn sẽ hiện những đơn hàng tương ứng. \nTrong Ghi chép giao dịch có thể chọn nhận những đơn hàng giao dịch, tăng thêm nút chọn nhanh, tối đa có thể chọn nhận 30 đơn hàng cùng lúc. \nNếu là đơn hàng gộp, sẽ căn cứ vào số lượng đơn hàng giao dịch gốc để tiến hàng phán đoán, nên sẽ có vài trường hợp xảy ra tình huống lượng chọn nhỏ hơn lượng đã định. ",
    ["ui_Jobber153"]="<size=18>7</size>Nếu bạn đạt mức trung bình hàng ngày, bạn có thể nhận được phần thưởng sự kiện (được làm mới vào lúc 0 giờ hàng ngày)",
    ["ui_Jobber154"]="Mô tả quy tắc:\n\n① Sự kiện này chỉ giới hạn ở<color=#56E795FF>nhà kinh doanh pha lê</color>; Việc mua kim cương và giao dịch đấu giá các mặt hàng quý hiếm không được bao gồm trong sự kiện này.\n② Số tiền bán hàng chỉ được tính<color=#56E795FF>Giao dịch và thu tiền trong sự kiện</color>đặt hàng\n③ Có giảm giá mua hàng và giảm thuế bán hàng trong sự kiện này<color=#56E795FF>giới hạn trên</color>\nKhi số tiền mua đạt<color=#56E795FF>500w</color>mặt sau,<color=#56E795FF>Không còn giảm giá</color>;Doanh số đạt<color=#56E795FF>300w</color>mặt sau,<color=#56E795FF>Không còn hoàn thuế</color>\n④ trong<color=#56E795FF>Thẻ hỗ trợ Capra có hiệu lực trong thời hạn hiệu lực</color>Tận hưởng đơn đặt hàng thành công<color=#56E795FF>8%</color>giảm giá khi mua hàng\nMức giảm giá cho các đơn hàng thành công được mua ngoài thời hạn hiệu lực là<color=#56E795FF>4%</color>\n⑤ Thuế suất Lễ tạ ơn là thuế suất sau khi tính giảm thuế bán hàng. Các đơn hàng bán hàng trong thời gian diễn ra sự kiện vẫn được khấu trừ theo thuế suất thông thường.\n(Mức thuế thẻ VIP Lễ Tạ ơn cần được chọn trong thẻ VIP<color=#56E795FF>Ngân hàng thương mại tăng hạn ngạch thuế thấp</color>đặc quyền)\n⑥ Nhiệm vụ đang hoạt động chỉ được tính<color=#56E795FF>Trong sự kiện</color>Lệnh mua và lệnh bán nhận được\n\nTổng số tiền hoàn thuế sẽ có sau khi sự kiện kết thúc\n",
    ["ui_Jobber155"]="Thời gian sự kiện: %s (Thời gian kết thúc nhận thưởng: %s)",
    ["ui_Jobber156"]="Đã đạt mức hoàn trả giới hạn",
    ["ui_Jobber157"]="Đã đạt mức hoàn thuế giới hạn",
    ["ui_Jobber158"]="钻石说明：",
    ["ui_Jobber159"]="Chỉ có thể lên kệ và bán Kim Cương không bị khóa. \nKhi mua các vật phẩm hiếm như Trang Bị Hiếm, Cài Tóc, Thẻ, ưu tiên tiêu hao Kim Cương không khóa.\nKim Cương vào giao dịch trong Quầy Giao Dịch chỉ có thể nhận được theo hình thức khóa.",
