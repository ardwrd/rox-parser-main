    ["LiquorPartyMini_Battle_waitPlayer"]="Chờ người chơi đối phương ngồi xuống...",
    ["LiquorPartyMini_Begin_text1"]="Lần này chúng ta đấu với hai tuyển thủ hạng nặng, mọi người vỗ tay hoan nghênh nhé.",
    ["LiquorPartyMini_Begin_text2"]="Cuộc thi sẽ bắt đầu giữa hai tuyển thủ trước mặt chúng ta, ai sẽ thắng, hãy chờ xem nhé.",
    ["LiquorPartyMini_Btn_change"]="Mời Trực Tiếp",
