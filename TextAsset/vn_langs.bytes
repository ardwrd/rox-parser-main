    ["UtramanQuest_96"]="Tham gia sự kiện Đối Đầu Raoh hoặc Quân Tiên Phong Tập Kích <color=#f6cf45>%s/%s</color>",
    ["VIPBuyDes_1"]="Khi thẻ cấp thấp còn hơn 30 ngày, có thể bù chênh lệch giá để đổi thành thẻ cấp cao.",
    ["VIPBuyDes_2"]="Sau khi mua thành công hoặc bù chênh lệch giá, thời hạn của thẻ cấp thấp sẽ tự động bị trừ và thời hạn tương ứng của thẻ đã chọn sẽ được tăng lên.",
    ["VIPBuyDes_3"]="Khi mua thẻ cùng cấp, thời gian mặc định mỗi lần tăng thêm 30 ngày.",
    ["VIPBuyTitle"]="Quy tắc mua",
    ["VIPCardOnSetDes_1"]="Mức thẻ sẽ có hiệu lực ngay lập tức sau khi mua thành công và bắt đầu tính thời gian. Xin đừng quên thiết lập đặc quyền.",
    ["VIPCardOnSetDes_2"]="Chỉ có 1 thẻ có hiệu lực cùng lúc: Khi có nhiều thẻ, thẻ cấp cao nhất sẽ mặc định có hiệu lực, thẻ cấp thấp sẽ tạm dừng và tự động có hiệu lực sau khi sử dụng hết thời gian của thẻ cao cấp.",
    ["VIPCardOnSetTitle"]="Quy tắc có hiệu lực",
    ["VIPCardPrivilege_1"]="Khi kích hoạt nhận danh hiệu <color=#86a42aff>\"{1}\"</color> <color=#86a42aff>{2}</color>",
    ["VIPCardPrivilege_10"]="Phần thưởng nhiệm vụ Sự kiện Trở về tăng <color=#86a42aff>{0}%</color> <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_11"]="Khi thăng cấp Shadow, tiêu hao đạo cụ <color=#86a42aff>{1}</color> được nhận thêm buff xác suất <color=#86a42aff>{2}</color>",
    ["VIPCardPrivilege_12"]="Thứ Hai hàng tuần nhận được <color=#86a42a>{0}</color> Chúc Phúc Odin <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_13"]="Mỗi ngày nhận được <color=#86a42a>{0}</color> điểm Thể Lực <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_14"]="Khi trang bị kế thừa cao cấp, tiêu hao Kim Cương cuối cùng giảm <color=#86a42a>{0}</color>% <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_15"]="Có thể tặng quà cho người chơi đấu giá khi xem đấu giá PK trong Quầy Giao Dịch <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_16"]="Khi trang bị kế thừa thường, tiêu hao Zeny giảm <color=#86a42a>{0}</color>% <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_17"]="Mỗi ngày nhận được <color=#86a42a>{0}</color> lượt Vuốt Ve Pet Ấm Áp <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_18"]="Có thể chọn tỷ lệ tiêu hao số lần thưởng vượt ải một lần Phó Bản Thường/Khó Bệ Trái Tim",
    ["VIPCardPrivilege_2"]="Sau khi tử trận ngoài bản đồ, mỗi ngày có thể hồi sinh tại chỗ <color=#86a42aff>{0}</color> lần <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_3"]="Trong Đố Vui OX, có thể <color=#86a42aff>biết trước câu trả lời chính xác</color> <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_4"]="Trong Tiệm Pha Lê, hàng ngày có thể mua đạo cụ: {1} x<color=#86a42aff>{0}</color> <color=#86a42aff>{2}</color>",
    ["VIPCardPrivilege_5"]="Giới hạn Độ Ngấy tăng lên <color=#86a42aff>{0}</color> <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_6"]="Mở khóa thêm <color=#86a42aff>{0}</color> <color=#86a42aff>ô kỹ năng kết hợp</color> <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_7"]="Trong lối chơi KVM, mỗi ngày có thể dùng <color=#86a42aff>{0}</color> lần điểm thất bại để khấu trừ <color=#86a42aff>{1}</color>",
    ["VIPCardPrivilege_8"]="Trong mỗi kỳ lối chơi Giải Thợ Săn Vương Bài, <color=#86a42aff>{0}</color> lần tham gia đầu có thể nhận thêm <color=#86a42aff>{1}</color> điểm <color=#86a42aff>{2}</color>",
    ["VIPCardPrivilege_9"]="Mỗi tháng tùy chọn <color=#86a42aff>{0}</color> mức nạp để nhận quà nạp đầu <color=#86a42aff>{1}</color>",
    ["VIPCardResetDes"]="Một số đặc quyền có cài lại hồi chiêu, sau khi chọn, cần giữ và có hiệu lực trên 30 ngày mới có thể cài lại đặc quyền này.",
    ["VIPCard_Hints1"]="Cần chọn <color=#e7bb22>%s</color> Đặc Quyền mới được kích hoạt",
    ["VIPCard_Hints10"]="Tốn <color=#86a42aff>%s</color> để tăng thời gian lên <color=#86a42aff>30 ngày</color>",
    ["VIPCard_Hints11"]="Tốn <color=#86a42aff>%s</color> để tăng thời gian lên <color=#86a42aff>7 ngày</color>",
    ["VIPCard_Hints12"]="Không thể bỏ chọn các Đặc Quyền có hiệu lực theo mặc định~",
    ["VIPCard_Hints13"]="Số lượng chọn Đặc Quyền đã đạt tối đa",
    ["VIPCard_Hints14"]="Lưu cài đặt Đặc Quyền",
    ["VIPCard_Hints15"]="Sau khi mua, tăng thời gian còn lại lên <color=#86a42aff>30 ngày</color>",
    ["VIPCard_Hints16"]="Đặc quyền đã chọn không thay đổi, không cần lưu",
    ["VIPCard_Hints17"]="Khi không cài đặt đặc quyền, chỉ có đặc quyền phúc lợi mới có hiệu lực. Có chắc chắn không cài đặt không?",
    ["VIPCard_Hints18"]="Đặc quyền hiện tại đang cài lại hồi chiêu, vui lòng đợi hồi chiêu kết thúc rồi hủy chọn~",
    ["VIPCard_Hints2"]="Cài đặt Đặc Quyền thành công",
    ["VIPCard_Hints3"]="%s tăng thời gian",
    ["VIPCard_Hints5"]="Tiêu tốn 1 lần đặt lại Đặc Quyền để lưu cài đặt hiện tại",
    ["VIPCard_Hints6"]="Tiêu hao <color=#86a42aff>%s</color> 30 ngày bù chênh lệch giá để thăng cấp mua",
    ["VIPCard_Hints8"]="Hiện tại có quyền cao cấp hơn đang có hiệu lực, sẽ tự động có hiệu lực sau khi quyền cao cấp hết hạn",
    ["VIPCard_Hints9"]="Sau khi mua sẽ ưu tiên có hiệu lực quyền cao cấp hơn",
    ["VIPCard_Name1"]="Quà Của W",
    ["VIPCard_Name2"]="Cổ Vũ Của Taylin",
    ["VIPCard_Name3"]="Báo Đáp Của Clarice",
    ["VIPCard_Tips11"]="Danh sách các đặc quyền tùy chọn: (%s)",
    ["VIPCard_Tips12"]="Xem Đặc Quyền",
    ["VIPCard_Tips13"]="Cài đặt Đặc Quyền",
    ["VIPCard_Tips14"]="+%s\n Thăng Cấp",
    ["VIPCard_Tips15"]="%s\nMua 30 ngày",
    ["VIPCard_Tips16"]="Cần %s 30 ngày",
    ["VIPCard_Tips17"]="Kích hoạt đạo cụ 30 ngày",
    ["VIPCard_Tips18"]="Kích hoạt đạo cụ 7 ngày",
    ["VIPCard_Tips20"]="Xác nhận",
    ["VIPCard_Tips21"]="Số lần cài lại còn lại: %s",
    ["VIPCard_Tips22"]="Đã cài đặt Đặc Quyền (%s)",
    ["VIPCard_Tips23"]="Danh sách Đặc Quyền",
    ["VIPCard_Tips27"]="Không thể cài đặt Đặc Quyền cho thẻ chưa kích hoạt",
    ["VIPCard_Tips28"]="K.hoạt 7 Đ.Quyền",
    ["VIPCard_Tips29"]="K.hoạt 10 Đ.Quyền",
    ["VIPCard_Tips30"]="K.hoạt 12 Đ.Quyền",
    ["VIPCard_Tips31"]="DS Đặc Quyền +5",
    ["VIPCard_Tips32"]="DS Đặc Quyền +5",
    ["VIPCard_Tips33"]="Các Đặc Quyền được cài đặt lần đầu không tiêu tốn số lần đặt lại",
    ["VIPCard_Tips34"]="%s đến hạn",
    ["VIPCard_Tips35"]="Số lần cài lại đã dùng hết, sẽ cập nhật sau %s ngày",
    ["VIPCard_Tips36"]="Số lần cài lại đã dùng hết,\nsẽ cập nhật sau %s",
    ["VIPCard_Tips4"]="Chưa mua",
    ["VIPCard_Tips5"]="Chưa kích hoạt",
    ["VIPCard_Tips6"]="Còn lại %s ngày",
    ["VIPCard_Tips7"]="Đang hiệu lực",
    ["VIPDesTitle"]="Mô Tả Thẻ VIP",
    ["VIPItemDes_1"]="Sau khi sử dụng Chuông Lắc của hầu gái, có thể triệu hồi 1 hầu gái ngoài bản đồ. Hầu gái cung cấp các dịch vụ tính năng như Tiệm Tạp Hóa, bán đạo cụ, Kho Từ Xa. Ngoài việc cung cấp thêm dịch vụ dịch chuyển tức thời, đồng đội của bạn cũng có thể sử dụng các dịch vụ tính năng của hầu gái cao cấp.",
    ["VIPItemDes_2"]="Đặc quyền Quà Nạp Đầu bắt đầu tính thời gian chu kỳ khi thẻ được kích hoạt lần đầu, cứ 30 ngày đặt lại một lần, không bị ảnh hưởng khi thay đổi cấp độ thẻ. Khi thẻ hết hiệu lực và được kích hoạt lại, chu kỳ sẽ được tính lại theo thời gian kích hoạt mới. Bạn có thể xem thông tin tương ứng trên giao diện Nạp.",
    ["VIPItemTitle"]="Nội dung đặc quyền",
    ["VIPListOnSetDes_1"]="Mỗi khi kích hoạt lại Thẻ sẽ mặc định có một lần cài đặt Đặc Quyền, có thể điều chỉnh Đặc Quyền theo nhu cầu",
    ["VIPListOnSetDes_2"]="Cứ cách 30 ngày, có thể hưởng ưu đãi cài lại thẻ VIP, số lượt chưa sử dụng sẽ không được lưu lại.",
    ["VIPListOnSetDes_3"]="Khi cài đặt đặc quyền, phải đạt đến số lượng lựa chọn đặc quyền trên thẻ hiện tại mới có thể lưu cài đặt đặc quyền.",
    ["VIPListOnSetDes_4"]="Đặc quyền được chia thành 3 loại: Đặc quyền phúc lợi, đặc quyền cần cài lại hồi chiêu và đặc quyền tùy chọn.",
    ["VIPListOnSetDes_5"]="Đặc quyền phúc lợi có hiệu lực theo mặc định khi thẻ được kích hoạt, không được tính vào số lượng đặc quyền tùy chọn, nhưng là quà tặng bổ sung.",
    ["VIPListOnSetDes_6"]="Đặc quyền cần cài lại hồi chiêu cần có hiệu lực và đủ 30 ngày trở lên sau khi thiết lập thành công mới được hủy bỏ cài đặt. Nếu đặc quyền chưa đủ 30 ngày khi thẻ hết hiệu lực, đặc quyền này sẽ được chọn theo mặc định sau khi kích hoạt thẻ mới, cho đến khi có hiệu lực sau 30 ngày có thể xóa đặc quyền này bằng cách cài lại đặc quyền.",
    ["VIPListOnSetDes_7"]="Cấp thẻ càng cao thì nội dung trong danh sách đặc quyền tùy chọn càng nhiều, số lượng có hiệu lực cũng càng nhiều.",
    ["VIPListOnSetTitle"]="Quy tắc Đặc Quyền",
    ["VIPPrivilegeReset_1"]="Cần cài lại hồi chiêu",
    ["VIPPrivilegeReset_2"]="Sau %s ngày có thể cài lại",
    ["VIPinheritShow"]="Giảm tiêu hao -%s",
    ["ValentineDayFestivaText_101"]="Lần này tổng cộng truyền vào <color=#ff6eaf>%s</color> năng lượng, đã tăng <color=#ff6eaf>%s</color> lần cơ hội rút thưởng.",
    ["ValentineDayFestivaText_102"]="Xác suất: %s",
    ["ValentineDayFestivaText_103"]="Không đủ số lần rút thưởng",
    ["ValentineDayFestivaText_104"]="%s đã nhận được <color=#ffe38f>%s</color> thông qua rút thưởng.",
    ["ValentineDayFestivaText_105"]="%s đã truyền vào <color=#ffe38f>%s</color> năng lượng.",
    ["ValentineDayFestivaText_106"]="Còn lại %s lần cơ hội rút thưởng",
    ["ValentineDayFestivaText_107"]="Không đủ số lượng còn lại",
    ["ValentineDayFestivaText_108"]="【活动说明】\n1、活动时间：%s\n2、兑换时间：%s\n3、活动条件：好友结对后才能参与活动，契约达成后不可取消，赶紧去寻找心仪的Ta吧~\n4、活动玩法-以爱之名：任务计数共享，双方完成数量可累加，获取更多积分去解锁各种奖励吧~\n5、活动玩法-星语星愿：消耗活动道具进行抽奖充能，结对的两个人共享充能进度，进度满了后两人可以各获得1次抽奖机会，随着抽奖次数的增加每次抽奖需要的能量会增加，快来和好友一起看看是谁的运气最好吧~\n6、活动玩法-甜蜜兑换：凑齐活动道具后，可在此处兑换心怡的礼物哦~\n7、活动玩法-奥丁祝福：结对后消耗奥丁击杀怪物才有几率掉落活动兑换道具~\n8、活动玩法-爱的赠礼：玩家每日都可为心仪的Ta赠送10个活动道具，卡普拉会员尊享更多次数哦~",
    ["ValentineDayFestivaText_109"]="[Giới thiệu sự kiện]\n1. Thời gian sự kiện: %s\n2. Thời gian đổi thưởng: %s\n3. Điều kiện sự kiện: Bạn bè kết đôi xong mới được tham gia sự kiện, sau khi đạt được khế ước sẽ không thể hủy bỏ, mau đi tìm một nửa của bạn đi!\n4. Ủy Thác An Ninh: Tính chung số nhiệm vụ, cả hai bên có thể tích lũy số lượng hoàn thành; tích lũy càng nhiều điểm để mở khóa các loại thưởng đi nào!\n5. Trò Chơi May Mắn: Tiêu hao đạo cụ sự kiện để rút thưởng nạp năng lượng. Hai người kết đôi chia sẻ tiến độ nạp năng lượng. Sau khi tiến độ đầy, hai người đều nhận được 1 cơ hội rút thưởng. Nếu Nhà Thám Hiểm chưa rút được thưởng lớn Bão Táp Đường Cùng <color=#ff6eaf>trong 300 lần rút</color> thì lần rút thứ 300 chắc chắn nhận được <color=#ff6eaf>Bão Táp Đường Cùng</color>. Khi số lần rút thưởng tăng lên, năng lượng cần cho mỗi lần rút sẽ tăng lên, số liệu thay đổi chi tiết như sau:\nLần 1-40, mỗi lần rút thưởng cần 60 năng lượng\nLần 41-80, mỗi lần rút thưởng cần 80 năng lượng\nLần 81-120, mỗi lần rút thưởng cần 100 năng lượng\nLần 121-160, mỗi lần rút thưởng cần 120 năng lượng\nLần 161-200, mỗi lần rút thưởng cần 150 năng lượng\nLần 201-250, mỗi lần rút thưởng cần 200 năng lượng\nLần 251-300, mỗi lần rút thưởng cần 250 năng lượng\nLần 301 trở lên, mỗi lần rút thưởng cần 300 năng lượng\n6. Tiệm Chiến Thắng: Sau khi thu thập đủ đạo cụ sự kiện, có thể đổi quà yêu thích tại đây!\n7. Quyết Đấu Cuối: Sau khi kết đôi, tiêu hao Chúc Phúc Odin tiêu diệt quái vật để có xác suất rơi đạo cụ đổi sự kiện!\n8. Quà Tình Yêu: Người chơi có thể tặng 10 đạo cụ sự kiện cho người mình thích mỗi ngày. Thành viên VIP Kafra có nhiều lượt tặng hơn đấy nhé!",
    ["ValentineDayFestivaText_110"]="Hiện có: %s",
    ["ValentineDayFestivaText_111"]="Còn lại %s lần truyền hôm nay",
    ["ValentineDayFestivaText_112"]="Hôm nay đã đạt giới hạn",
    ["ValentineText_101"]="Không đủ Xu",
    ["ValentineText_102"]="Đạo cụ không đủ",
    ["ValentinesDayText_001"]="Đã hết lượt Cầu Nguyện hôm nay, ngày mai lại đến~",
    ["ValentinesDayText_002"]="Kết Đôi trước rồi tham gia sự kiện này~",
    ["ValentinesDayText_003"]="Sự kiện đã kết thúc, mau đi đổi thưởng nào~",
    ["ValentinesDayText_004"]="[Giới thiệu sự kiện]\n1. Thời gian sự kiện: %s\n2. Thời gian đổi thưởng: %s\n3. Điều kiện sự kiện: Bạn bè Kết Đôi xong mới được tham gia sự kiện, sau khi thỏa thuận xong sẽ không thể hủy bỏ, mau đi tìm một nửa của bạn đi! \n4. Cách chơi sự kiện - Nhân Danh Tình Yêu: Dùng chung số lượt nhiệm vụ, cả hai bên có thể tích lũy sau khi hoàn thành số lượng; tích lũy càng nhiều điểm để mở khóa các loại phần thưởng đi nào! \n5. Cách chơi sự kiện - Lời Ước Sao Trời: Cầu nguyện có thể nhận đạo cụ đổi sự kiện, mỗi ngày 9 lần, lần 1~2 cần tốn Zeny, lần 3~5 cần tốn Pha Lê, lần 6~9 cần tốn Kim Cương, hãy chú ý nhé! \n6. Cách chơi sự kiện - Đổi Ngọt Ngào: Sau khi thu thập xong đạo cụ sự kiện, sẽ có thể đổi quà yêu thích tại đây.\n7. Cách chơi sự kiện - Chúc Phúc Odin: Sau khi Kết Đôi, tiêu hao Odin tiêu diệt quái vật để có cơ hội rơi vật phẩm đổi sự kiện.\n8. Cách chơi sự kiện - Quà Điểm: Cả hai bên sẽ nhận được điểm sau khi hoàn thành nhiệm vụ Cặp Trời Sinh, sau khi điểm tích lũy đạt đủ điều kiện có thể nhận được gói quà. \n9. Cách chơi sự kiện - Quà Tình Yêu: Mỗi ngày, người chơi có thể tặng 10 đạo cụ sự kiện cho người mình thích mỗi ngày. Hội viên VIP Kafra có nhiều lượt tặng hơn đấy nhé!",
    ["ValentinesDayText_005"]="[Mô tả sự kiện] \n1. Thời gian sự kiện: %s \n2. Thời gian đổi: %s \n3. Điều kiện sự kiện: Sau khi ghép đôi, bạn bè mới được tham gia sự kiện. Sau khi ghép đôi thành công, không thể hủy bỏ, hãy mau đi tìm bạn bè yêu thích của mình nhé~ \n4. Lối chơi sự kiện - Hành Động Sao Vì Bạn: Tổng số nhiệm vụ được chia sẻ, có thể tích lũy số lượng hoàn thành của hai bên. Nhận thêm điểm để mở khóa các phần thưởng khác nhau nhé~ \n5. Lối chơi sự kiện - Lời Thề Ánh Sao: Cầu phúc có thể nhận được đạo cụ đổi, mỗi ngày giới hạn 9 lần, lần 1~5 tiêu hao Zeny, lần 6~10 tiêu hao Pha Lê, lần 11~15 lần tiêu hao Kim Cương, hãy lưu ý~ \n6. Lối chơi sự kiện - Shop Ngôi Sao Xán Lạn: Sau khi thu thập đủ các đạo cụ sự kiện, có thể đổi để lấy món quà yêu thích tại đây~ \n7. Lối chơi sự kiện - Chiến Ca Sao Sáng: Sau khi ghép đôi, tiêu hao Odin để tiêu diệt quái vật mới có xác suất rơi đạo cụ đổi sự kiện~ \n8. Lối chơi sự kiện - Gói Quà điểm: Sau khi hoàn thành nhiệm vụ Hành Động Sao Vì Bạn, hai bên đều sẽ nhận được điểm. Sau khi điểm tích lũy đạt điều kiện, có thể nhận được Gói Quà~ \n9. Lối chơi sự kiện - Tặng Quà Cho Bạn: Người chơi có thể tặng 10 đạo cụ sự kiện cho bạn bè yêu thích mỗi ngày, thành viên Kafra có thể được nhiều lần hơn~",
