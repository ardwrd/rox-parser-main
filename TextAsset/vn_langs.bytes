    ["ui_LuckWheel_015"]="Quy tắc chọn số",
    ["ui_LuckWheel_016"]="Mỗi kỳ Lotto, mỗi Nhà Thám Hiểm được chọn tối đa 100 mã số may mắn để đặt cược.",
    ["ui_LuckWheel_017"]="Số may mắn có thể chọn trùng, và có thể chọn đặt cược số giống nhau.",
    ["ui_LuckWheel_018"]="Mỗi Nhà Thám Hiểm mỗi kỳ có thể nhận 1 lần đặt cược miễn phí.",
    ["ui_LuckWheel_019"]="Quy tắc mở thưởng",
    ["ui_LuckWheel_020"]="Rút thưởng vào 20:00 mỗi ngày, thưởng sẽ gửi qua Thư vào 22:00 mỗi ngày, mời chú ý nhận nha. ",
    ["ui_LuckWheel_021"]="Quý cô Kafra sẽ chọn ngẫu nhiên 1 số may mắn trong danh sách số đã đặt cược.",
    ["ui_LuckWheel_022"]="Số giống nhau bị đặt cược nhiều lần sẽ xuất hiện nhiều lần trong danh sách số, số lượng mua càng nhiều thì cơ hội trúng càng cao.",
    ["ui_LuckWheel_023"]="Tỷ lệ trúng thưởng của chọn số thủ công và hệ thống ngẫu nhiên là giống nhau, có thể chọn cách đặt cược theo sở thích.",
    ["ui_LuckWheel_024"]="Quy tắc thưởng",
    ["ui_LuckWheel_025"]="Con số và vị trí của số đặt cược và số may mắn giống nhau coi như đoán trúng.",
    ["ui_LuckWheel_026"]="Con số đoán trúng 2 chữ số trở lên có thể nhận thưởng.",
    ["ui_LuckWheel_027"]="Con số đoán trúng càng nhiều chữ số thì thưởng càng nhiều.",
    ["ui_LuckWheel_028"]="Nhà Thám Hiểm đầu tiên đặt cược và trúng toàn bộ chữ số sẽ nhận thêm thưởng may mắn.",
    ["ui_LuckWheel_029"]="Thưởng Lotto sẽ gửi qua thư sau khi số may mắn mỗi kỳ được công bố.",
    ["ui_LuckWheel_030"]="Quy tắc thể hiện",
    ["ui_LuckWheel_031"]="Giao diện sự kiện sẽ hiện Nhà Thám Hiểm trúng Thưởng May Mắn.",
    ["ui_LuckWheel_032"]="Khi thưởng kỳ đầu chưa mở thưởng sẽ hiện Nhà Thám Hiểm ngẫu nhiên.",
    ["ui_LuckWheel_033"]="Mỗi ngày có thể tiến hành Thích mô hình hiển thị 1 lần.",
    ["ui_LuckWheel_034"]="Mỗi ngày bấm Thích sẽ nhận 1 lần Túi Quà Thích.",
    ["ui_LuckWheel_035"]="Quy tắc Lotto May Mắn",
