    ["DialogueBubble662491175"]="E\nE",
    ["DialogueBubble662491176"]="◀‧",
    ["DialogueBubble662491177"]="SuppÓse it stands tÓ reasÓn\n That you wÓuld tyrn Ón me",
    ["DialogueBubble662491178"]="C\nU",
    ["DialogueBubble662491179"]="M1",
    ["DialogueBubble662491180"]="R",
    ["DialogueBubble662491181"]="Tiếp theo, tôi sắp phát mã rồi, hãy chú ý lắng nghe nhé!",
    ["DialogueBubble662491182"]="N\nH",
    ["DialogueBubble662491183"]="Tiếp theo, tôi sắp phát mã rồi, hãy chú ý lắng nghe nhé!",
    ["DialogueBubble662491184"]="5x/6−2=(x+4)/2",
    ["DialogueBubble662491185"]="And you are ṭhe oṄly reasoṄ\n AṄd you are ṭhe only reason",
    ["DialogueBubble662491186"]="K\nN",
    ["DialogueBubble662491187"]="7x+4y=181\n3x-2y=7",
    ["DialogueBubble662491188"]="Tiếp theo, tôi sắp phát mã rồi, hãy chú ý lắng nghe nhé!",
    ["DialogueBubble662491189"]="W1\nT22\nS11",
    ["DialogueBubble662491190"]="H\nS",
    ["DialogueBubble662491191"]="C\nF",
    ["DialogueBubble662491192"]="SuppÓse it stands tÓ reasÓn\n Thaṭ you would ṭurn on me",
    ["DialogueBubble662491193"]="AX\nXF",
    ["DialogueBubble662491194"]="H",
    ["DialogueBubble662491195"]="44",
    ["DialogueBubble662491196"]="K",
    ["DialogueBubble662491197"]="S22\nT22",
    ["DialogueBubble662491198"]="K\nR",
    ["DialogueBubble662491199"]="O\nS",
    ["DialogueBubble662491200"]="Tiếp theo, tôi sắp phát mã rồi, hãy chú ý lắng nghe nhé!",
    ["DialogueBubble662491201"]="A\nJ",
    ["DialogueBubble662491202"]="AD",
    ["DialogueBubble662491203"]="x/2-√(4x)=-2",
    ["DialogueBubble662491204"]="C\nO",
    ["DialogueBubble662491205"]="I\nA",
    ["DialogueBubble662491206"]="T22",
    ["DialogueBubble662491207"]="FX",
    ["DialogueBubble662491208"]="Z",
    ["DialogueBubble662491209"]="-●-●\n●●●●",
    ["DialogueBubble662491210"]="Tiếp theo, tôi sắp phát mã rồi, hãy chú ý lắng nghe nhé!",
    ["DialogueBubble670002101"]="Các cậu muốn nghe câu chuyện gì?",
    ["DialogueBubble670012101"]="Được, ta lấy điểm câu cá này làm bước đầu tiên, để thầy công nhận ta!",
    ["DialogueBubble670062101"]="Phía trước nguy hiểm, tự lượng sức mình.",
    ["DialogueBubble670072101"]="Soái ca!",
    ["DialogueBubble670082101"]="Ta chọn bài hát được không?",
    ["DialogueBubble670092101"]="Anh Morts!",
    ["DialogueBubble670422101"]="A... Ta cũng muốn đến Học Viện Criatura, trở thành Nhà Thám Hiểm...",
    ["DialogueBubble670432101"]="Không sao, sang năm còn cơ hội, ta sẽ ở đây đợi cậu!",
    ["DialogueBubble670442101"]="Nghe nói Thầy Hướng Dẫn của học viện rất nghiêm khắc...",
    ["DialogueBubble670452101"]="Yên tâm đi, chỉ cần chăm chỉ học hành, Thầy Hướng Dẫn chắc chắn sẽ công nhận cậu!",
    ["DialogueBubble670462101"]="Này này, cậu biết không, khóa này có một nam sinh rất đẹp trai!",
    ["DialogueBubble670462201"]="Cảm ơn cậu, ta thích Aronst",
    ["DialogueBubble670472101"]="Ờ ờ, cậu nói Aronst sao? Ta luôn thấy hắn rất quen...",
    ["DialogueBubble670472201"]="Cảm ơn, cậu là người tốt",
    ["DialogueBubble670482101"]="Này này, học sinh mới khóa này cậu có thấy ai đẹp không?",
    ["DialogueBubble670482201"]="Ú òa! Cậu... cậu nghe lén bọn ta nói chuyện?",
    ["DialogueBubble670492101"]="Hả? Không có, nhìn cứ thường thường, chẳng có hứng gì",
    ["DialogueBubble670492201"]="Nghe lén không phải thói quen tốt, đây là lời dạy của tiền bối nha!",
    ["DialogueBubble670502101"]="Sau này cậu cũng muốn đến đây làm Nhà Thám Hiểm sao?",
    ["DialogueBubble670512101"]="Hở? Ta muốn trở thành Nhà Thám Hiểm vĩ đại, giải cứu thế giới!",
    ["DialogueBubble670522101"]="Mỗi năm nhìn thấy cảnh tượng này đều khiến ta nhớ đến thời học sinh của mình. Đây cũng là nơi ta gặp nàng đó, bà lão à",
    ["DialogueBubble670522201"]="Ha ha ha, bà cũng cảm thấy duyên phận rất kỳ lạ đúng không?",
    ["DialogueBubble670532101"]="Đúng thế, cuộc đời này của chúng ta, cũng là nhờ học viện đó, ông lão à",
    ["DialogueBubble670532201"]="Duyên phận gì chứ, cứ như con nít á...",
    ["DialogueBubble670542101"]="Mẹ ơi, sau này con cũng đến đây học sao?",
    ["DialogueBubble670552101"]="Đương nhiên rồi, con nhà ta là giỏi nhất!",
    ["DialogueBubble670562101"]="Con muốn ăn gà rán...",
    ["DialogueBubble670572101"]="Phải ăn uống lành mạnh! Con hứa với mẹ phải ăn rau, mẹ mới mua cho con!",
    ["DialogueBubble670582101"]="Sống ở Đảo Izlude thật thuận tiện, ở quảng trường trung tâm có thể mua được tất cả đồ dùng sinh hoạt",
    ["DialogueBubble670582201"]="Ha ha, những người sống ở đây đều có nụ cười như cậu",
    ["DialogueBubble670592101"]="Cậu lại vừa nhìn về hướng của con mèo đó! Hả?",
    ["DialogueBubble670602101"]="Người khác chỉ cần trang điểm một chút đã trở nên xinh đẹp, sao nàng không học hỏi đi?",
    ["DialogueBubble670612101"]="Ôi, lúc nào cũng có người đố kỵ với sắc đẹp của ta, phiền chết được...",
    ["DialogueBubble670612201"]="Ha ha, cảm ơn tình yêu của cậu, nhưng ta sẽ không thích ai cả",
    ["DialogueBubble670622101"]="Thương Gia vũ khí và phòng cụ không bán trang bị, Thương Gia nấu ăn không bán món ăn, đảo này thật thú vị",
    ["DialogueBubble670622201"]="Úi da, ta chỉ nói sự thật thôi, đừng như thế mà",
    ["DialogueBubble670632101"]="Dạo này đang là mùa khai giảng của Criatura sao, tuổi trẻ tươi đẹp biết bao.",
    ["DialogueBubble670642101"]="Chào mừng đến sân tập! Huấn luyện Kiếm Sĩ là truyền thống của Đảo Izlude, hãy cảm nhận nhé!",
    ["DialogueBubble670652101"]="Có thể các cậu là tinh anh của học viện, nhưng đến đây chỉ là người mới thôi! Dốc toàn lực đi!",
    ["DialogueBubble670652201"]="Hở? Cậu cũng là người mới đến tập luyện sao? Trông cũng khá đấy, ta phá lệ cho cậu cùng tập!",
    ["DialogueBubble670662101"]="Grum! Ha!",
    ["DialogueBubble670672101"]="Mẹ ơi... Giáo Quan Ma Quỷ vẫn không thay đổi",
    ["DialogueBubble670672201"]="Cậu cũng thấy họ rất thảm sao...",
    ["DialogueBubble670682101"]="Ha ha ha, nhìn hắn thế thôi, ở trên chiến trường hắn đã bảo vệ biết bao nhiêu tính mạng rồi",
    ["DialogueBubble670682201"]="Cũng không phải là không biết tình cảm của cậu, dù sao người ngoài nhìn vào...",
    ["DialogueBubble670692101"]="Ta ta ta... ta không muốn đến chỗ Giáo Quan chịu tội!",
    ["DialogueBubble670702101"]="Ngu ngốc, muốn trở nên mạnh mẽ, cách nhanh nhất là được ông ấy hướng dẫn! Lẽ nào như thế cậu cũng bỏ cuộc sao!",
    ["DialogueBubble670712101"]="Phù, học xong tiết của Giáo Quan Ma Quỷ được nghỉ ngơi, thật là dễ chịu",
    ["DialogueBubble670722101"]="Chúng ta... đã trở nên mạnh mẽ chưa...",
    ["DialogueBubble670732101"]="Người đến báo danh hãy xếp hàng theo thứ tự!",
    ["DialogueBubble670732201"]="Dù là cậu... cũng phải xếp hàng sao?",
    ["DialogueBubble670742101"]="Hả? Chen hàng thì cút ra phía sau, đừng phiền ta làm việc",
    ["DialogueBubble670742201"]="Cậu còn như vậy, ta sẽ có người ở đây đánh cậu.",
    ["DialogueBubble670752101"]="Đông người quá...",
    ["DialogueBubble670762101"]="Dù sao Công Hội Kiếm Sĩ trên Đảo Izlude rất nổi tiếng",
    ["DialogueBubble670772101"]="Thật muốn trở nên mạnh hơn... Chỉ cần đừng đi theo Giáo Quan Ma Quỷ kia là được",
    ["DialogueBubble670792101"]="Thế giới này có thật không... Nó thực sự không phải do ai đó tạo ra chứ...",
    ["DialogueBubble670812101"]="Đây là trung tâm của Hoàng Cung, không có việc đặc biệt thì mau rời khỏi đây",
    ["DialogueBubble670822101"]="Nghe nói những tình nhân cùng ngồi trên Đu Quay Ngựa Gỗ ở ngoài thành Nam sẽ mãi mãi bên nhau.",
    ["DialogueBubble670832101"]="Woa, thật à, thật à, vậy chúng ta mau đi thôi!",
    ["DialogueBubble670842101"]="Vốn dĩ họ định dỡ chỗ này, làm một cái Đu Quay Ngựa Gỗ thật lớn. May là cuối cùng đặt ở ngoài thành, nếu không ta sống cũng không yên!",
    ["DialogueBubble670852101"]="Muốn lên <color=#CA2E0AFF>Đu Quay Ngựa Gỗ</color> chơi nhưng không biết cách? Ở góc trên bên phải trong <color=#CA2E0AFF>Thương Hội</color> có bán <color=#CA2E0AFF>vé</color> Đu Quay Ngựa Gỗ đó!",
    ["DialogueBubble670862101"]="Thật đáng tiếc...",
    ["DialogueBubble670872101"]="Ta muốn chụp ảnh ở Đu Quay Ngựa Gỗ!",
    ["DialogueBubble670882101"]="Nghe nói lúc trước ở đây có quy hoạch một cái Đu Quay Ngựa Gỗ, tại sao lại chuyển ra ngoài thành chứ...",
    ["DialogueBubble670892101"]="Thế mới nói! Ngồi Đu Quay Ngựa Gỗ ở Prontera lãng mạn biết bao!",
    ["DialogueBubble670902101"]="Các cậu bình tĩnh đi, không thấy khu vui chơi ở ngoài thành Nam cũng rất tuyệt à?",
    ["DialogueBubble670912101"]="Thịt heo! Thịt gà! Thịt bò! Đều là thịt thượng hạng! Mới giết mổ sáng nay!",
    ["DialogueBubble670912201"]="Ơ? Ai muốn xem xin mời!",
    ["DialogueBubble670922101"]="Trà mật ong hảo hạng, nguyên chất tự nhiên không có chất phụ gia, mua một tặng một, xin mời thưởng thức!",
    ["DialogueBubble670922201"]="Nhìn cậu thích thế, hay là mua 2 ly nhé, một ly tặng người khác!",
    ["DialogueBubble670932101"]="Rau tươi Prontera, không thuốc trừ sâu, tốt cho sức khỏe!",
    ["DialogueBubble670942101"]="Trái cây đã được thêm Bùa Tịnh Hóa, ăn luôn cũng được!",
    ["DialogueBubble670952101"]="Cậu xem thịt ta mua hôm nay, nhìn đã thấy ngon! Thế nào rồi? Có muốn chia cho cậu một ít không?",
    ["DialogueBubble670962101"]="Được không? Cảm ơn nhé, mấy trái nho này cho trẻ con nhà cậu đi, no quá rồi!",
    ["DialogueBubble670972101"]="Ở đây có lên được không... Thật tò mò không biết bên trên thế nào",
    ["DialogueBubble670982101"]="Không được, chẳng phải cha nghiêm cấm chúng ta lên sao",
    ["DialogueBubble671002101"]="Phía trước là đường hầm, hiện đang cấm người, không có việc gì thì mau rời khỏi",
    ["DialogueBubble671012101"]="Hi, có muốn uống một ly không?",
    ["DialogueBubble671012201"]="Hở? Thích chị rồi sao, đến quán rượu, chị cho cưng xem cái này hay lắm",
    ["DialogueBubble671022101"]="Ta... ta không say!... Ợ! Ngươi xem, ta... ta đang chèo thuyền! Thuyền!",
    ["DialogueBubble671032101"]="Miêu Nữ Lang của Prontera... đúng là danh bất hư truyền",
    ["DialogueBubble671032201"]="Cậu cũng thấy rất tuyệt đúng không!",
    ["DialogueBubble671042101"]="Cảm thấy có thể đến đây uống một ly để trò chuyện với họ!",
    ["DialogueBubble671042201"]="Cậu mới từ trong đó đi ra sao? Các em ấy rất đẹp đúng không?",
    ["DialogueBubble671052101"]="Cha ơi, sao chị ấy lại mặc giống con mèo?",
    ["DialogueBubble671052201"]="Cô Gái Mèo? Đó là gì?",
    ["DialogueBubble671062101"]="Ờ... Vì như vậy rất đáng yêu sao? Nhưng cậu còn nhỏ quá, không thể học theo họ?",
    ["DialogueBubble671062201"]="Tên này! Đừng mơ dạy hư con gái ta!",
    ["DialogueBubble671072101"]="Woa, đây chính là Prontera sao... Nên đi dạo ở đâu đây?",
    ["DialogueBubble671082101"]="Đương nhiên là đến quảng trường trung tâm mua đồ rồi!",
    ["DialogueBubble671092101"]="Ta muốn đi quảng trường hoàng cung!",
    ["DialogueBubble671102101"]="Mọi người đang nói gì vậy? Không đến Quán Rượu Hoa Hồng ở Prontera sẽ uổng phí chuyến đi này!",
    ["DialogueBubble671112101"]="Có nghĩa trang phía trước, xin đừng làm ồn",
    ["DialogueBubble671122101"]="Sẽ có một ngày, nơi này sẽ trở thành nghĩa trang...",
    ["DialogueBubble671132101"]="Cầu mong người đã khuất được bình yên...",
    ["DialogueBubble671142101"]="Huhuhu... Rupee... ta nhớ cậu quá...",
    ["DialogueBubble671142201"]="Cảm, cảm ơn cậu đã chia sẻ nỗi buồn với ta",
    ["DialogueBubble671152101"]="Vì đứa con ngủ vùi dưới lòng đất, ta sẽ sống thật tốt",
    ["DialogueBubble671152201"]="Cảm ơn người bạn trẻ, ta đã quen với cuộc sống không có con cái",
    ["DialogueBubble671162101"]="Đây là Nhà Thờ Lớn, một nơi yên tĩnh cho những người ngoan đạo",
    ["DialogueBubble671192101"]="Chào mừng đến với căn cứ của Đoàn Kỵ Sĩ Vương Quốc! Những ai muốn thực hiện ủy thác Đoàn Kỵ Sĩ hãy vào đây!",
    ["DialogueBubble671202101"]="Đừng lo lắng, ai cũng có cả!",
    ["DialogueBubble671202201"]="Hả? Cậu không phải là người của Đoàn Kỵ Sĩ nhỉ? Không thể ăn ở đây nhé?",
    ["DialogueBubble671212101"]="Ta muốn bánh mì tỏi!",
    ["DialogueBubble671222101"]="Có thể thêm cho ta một lát thịt xông khói được không, cảm ơn!",
    ["DialogueBubble671232101"]="Có táo không nhỉ~",
    ["DialogueBubble671242101"]="Chà không ngờ đồ ăn của Đoàn Kỵ Sĩ lại ngon đến vậy",
    ["DialogueBubble671252101"]="Tất nhiên rồi, Đoàn Kỵ Sĩ vào sinh ra tử vì nhân dân, đãi ngộ phải tốt chứ.",
    ["DialogueBubble671262101"]="Đặc biệt là đầu bếp của Đoàn Kỵ Sĩ, người sau càng giỏi hơn người trước",
    ["DialogueBubble671272101"]="Ợ, no bụng rồi, tiếc là không có rượu...",
    ["DialogueBubble671282101"]="Đồ ngốc, uống rượu vào người làm sao mà đánh nhau được!",
    ["DialogueBubble671292101"]="Thực sự muốn ngủ trưa quá...",
    ["DialogueBubble671302101"]="Chào mừng đến với Prontera, vui lòng đi dạo tự nhiên trên cơ sở tuân thủ quy tắc nhé",
    ["DialogueBubble671312101"]="Đừng chạy đi chạy lại ở đây! Sẽ gây rắc rối cho người khác!",
    ["DialogueBubble671312201"]="Xin, xin lỗi! Các con ta đã gây rắc rối cho cậu rồi!",
    ["DialogueBubble671342101"]="Kính viễn vọng khổng lồ ở trên đó là do đích thân ta thiết kế đấy! Có giỏi không!",
    ["DialogueBubble671352101"]="Được rồi, hôm nay đây là lần thứ 20 cậu nói chuyện này với các Nhà Thám Hiểm rồi",
    ["DialogueBubble671352201"]="He he he, ông ấy đã già rồi, giờ trở nên giống con nít hơn, chỉ biết khoe cái kính viễn vọng của mình.",
    ["DialogueBubble671362101"]="Mẹ ơi, có phải công chúa thực sự đang sống trong lâu đài to lớn đó không?",
    ["DialogueBubble671372101"]="Tất nhiên rồi, còn có cả một chàng hoàng tử đẹp trai nữa đó",
    ["DialogueBubble671382101"]="Bất kể khi nào tôi nhìn thấy cung điện Prontera, nó vẫn rất tráng lệ...",
    ["DialogueBubble672722101"]="Cạn ly chúc mừng chúng ta sắp trở thành Nhà Thám Hiểm!",
    ["DialogueBubble672732101"]="Đáng tiếc chúng ta chưa đủ tuổi uống rượu, cạn ly!",
    ["DialogueBubble672742101"]="Nước cam cũng ngon mà, cạn ly!",
    ["DialogueBubble672752101"]="Hôm nay là ngày điểm danh học viện, nước cam giảm nửa giá!",
    ["DialogueBubble672762101"]="Khu phía trước đã có người đặt, nếu không có thiệp mời không thể vào!",
    ["DialogueBubble672772101"]="Cần những gì? Tiến cử mạnh nước cam pha chế đặc biệt!",
    ["DialogueBubble672782101"]="Mỗi khi nghe biểu diễn ở quán rượu, trong lòng cảm thấy nhẹ nhõm hẳn!",
    ["DialogueBubble672792101"]="Đúng thế, đúng thế! Cậu muốn đi chọn bài hát sao?",
    ["DialogueBubble672802101"]="(Nhồm nhoàm nhồm nhoàm) Ngon, ngon quá!",
    ["DialogueBubble691001101"]="Bên trái? Bên phải? Có thể thấy được rương báu hay không là tùy thuộc vào sự lựa chọn của cậu đấy Nhà Thám Hiểm!",
    ["DialogueInMagic1"]="Lửa",
    ["DialogueInMagic2"]="Nước",
    ["DialogueInMagic3"]="Gió",
    ["DialogueInMagic4"]="Đất",
    ["DialogueInMagic5"]="Nhầm rồi, nhớ kỹ lại xem vừa rồi ta nói những gì, cần bổ sung nguyên tố nào vào lúc này?",
    ["DialogueOPtion30129011"]="Ta đã quyết định rồi!",
