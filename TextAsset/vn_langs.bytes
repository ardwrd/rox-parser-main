    ["DialogueOption20841041"]="Rốt cuộc đã xảy ra chuyện gì?",
    ["DialogueOption20843011"]="Bạn biết hết rồi à?",
    ["DialogueOption20843021"]="Bạn cần gì?",
    ["DialogueOption20844011"]="<color=#CA2E0AFF>\"Dũng cảm nói ra sự thật\"</color>",
    ["DialogueOption20844021"]="Chẳng lẽ anh ấy với Lucy...?",
    ["DialogueOption20844031"]="Bạn quen biết...?",
    ["DialogueOption20844061"]="Để tôi thử xem",
    ["DialogueOption20860011"]="Cậu muốn làm gì?",
    ["DialogueOption20860031"]="Mày thật ác độc!",
    ["DialogueOption20860041"]="Ai nói tôi phải rời đi?",
    ["DialogueOption20860042"]="Không có hoạt động nào khác à?",
    ["DialogueOption20860071"]="Suỵt, nhỏ giọng đi...",
    ["DialogueOption20860091"]="Nhưng…",
    ["DialogueOption20861011"]="Bạn có thấy Chen Liu không?",
    ["DialogueOption20861031"]="Bạn không muốn anh ấy quay lại?",
    ["DialogueOption20861041"]="...tôi có thể giúp chứ?",
    ["DialogueOption20863011"]="Vứt nó đi, vứt nó đi! ! !",
    ["DialogueOption20863012"]="Rửa tay sau khi vứt nó đi! ! !",
    ["DialogueOption20863031"]="Trần Liễu đâu?",
    ["DialogueOption20863041"]="Vì thế……?",
    ["DialogueOption20863051"]="nghe có vẻ tốt đấy",
    ["DialogueOption20863052"]="nghe có vẻ rất tệ",
    ["DialogueOption20864011"]="Trần Liễu đâu?",
    ["DialogueOption20864031"]="(Đe dọa) Bạn sẽ nói cho tôi biết chứ?",
    ["DialogueOption20864032"]="(thỏa hiệp) Làm ơn...",
    ["DialogueOption20865011"]="Bạn có thể nói cho tôi biết bây giờ không…",
    ["DialogueOption20865021"]="...",
    ["DialogueOption20866011"]="(Tư thế chiến đấu) Này!",
    ["DialogueOption20866021"]="Cơ thể giả? ? ?",
    ["DialogueOption20866041"]="Cô!!!",
    ["DialogueOption20867021"]="Tôi sẽ đưa Chen Liu trở lại",
    ["DialogueOption20867031"]="bạn chỉ muốn",
