    ["ui_Update_001"]="Khởi động lại ứng dụng để cập nhật!",
    ["ui_Update_002"]="Đã nâng cấp phiên bản, cài đặt phiên bản mới để vào game. Đến tải ngay!",
    ["ui_Update_003"]="Có cập nhật mới",
    ["ui_ValentineDayFestival_001"]="Cùng Dạo \nBiển Sao",
    ["ui_ValentineDayFestival_002"]="Nguyện Ước \nSông Sao",
    ["ui_ValentineDayFestival_003"]="Tiệm \nTình Sao",
    ["ui_ValentineDayFestival_004"]="Khúc \nDuyên Sao",
    ["ui_ValentineDayFestival_005"]="Nhận được thưởng",
    ["ui_ValentineDayFestival_006"]="Hành Động Sao Vì Bạn",
    ["ui_ValentineDayFestival_007"]="Lời Thề Ánh Sao",
    ["ui_ValentineDayFestival_008"]="Shop Ngôi Sao Xán Lạn",
    ["ui_ValentineDayFestival_009"]="Chiến Ca Sao Sáng",
    ["ui_ValentineDayFestival_010"]="Tặng Quà Cho Bạn",
    ["ui_ValentineDayFestival_011"]="Nghi Thức Bói Quẻ",
    ["ui_ValentineDayFestival_012"]="Bói Quẻ Tình Yêu",
    ["ui_ValentineDayFestival_013"]="Tiệm Vận Mệnh",
    ["ui_ValentineDayFestival_014"]="Mật Ngữ Odin",
    ["ui_ValentineDayFestival_015"]="Truyền Năng Lượng",
    ["ui_ValentineDayFestival_016"]="Rút Thưởng",
    ["ui_ValentineDayFestival_017"]="Gợi Ý Bói Quẻ",
    ["ui_ValentineDayFestival_018"]="Trong thời gian sự kiện, Nhà Thám Hiểm kết đôi tốn Chúc Phúc Odin diệt quái chỉ định nhận thưởng.",
    ["ui_ValentineDayFestival_019"]="星光推荐",
    ["ui_ValentineDayFestival_020"]="Ủy Thác An Ninh",
    ["ui_ValentineDayFestival_021"]="Trò Chơi May Mắn",
    ["ui_ValentineDayFestival_022"]="Tiệm Chiến Thắng",
    ["ui_ValentineDayFestival_023"]="Quyết Đấu Cuối",
    ["ui_ValentineDayFestival_024"]="Xem Quà Khủng",
    ["ui_ValentineDayFestival_025"]="Xem Thú Cưỡi",
    ["ui_ValentineDayFestival_026"]="Đề cử\nkết hợp",
    ["ui_ValentineDayFestival_028"]="Thử Thách Ăn Ý",
    ["ui_ValentineDayFestival_029"]="Nghe nói những Nhà Thám Hiểm nhận lời chúc phúc Cookie khác nhau tụ tập và làm động tác Cạn Ly\nSẽ gọi được lời chúc phúc của <color=#D39FEFFF>Thần Tình Yêu Cupid</color>, đồng thời còn rơi Hạc Giấy Trắng\nCó thêm xác suất rơi <color=#FD97B6FF>Hạc Giấy Hồng</color> nữa đấy",
    ["ui_ValentineDayFestival_030"]="Sau khi cùng bạn thân (Độ Thiện Cảm >=520) gọi ra chắc chắn rơi <color=#CF73AC>Hạc Giấy Hồng</color>, mau thử xem nào",
    ["ui_ValentineDayFestival_031"]="Trong thời gian sự kiện, tặng Hộp Chocolate cho bạn thân, không chỉ có thể tăng Độ Thiện Cảm, người nhận được quà còn nhận được Món Ăn đặc biệt ngẫu nhiên là Hộp Cookie Vàng hoặc Hộp Cookie Bạc\nCó thể trực tiếp mua tặng ở giao diện tặng quà, có giới hạn số lần mỗi ngày đó!",
    ["ui_ValentineDayFestival_032"]="Đến tham gia",
    ["ui_ValentineDayFestival_033"]="Mau đến tham gia Thử Thách Ăn Ý, trả lời đúng có thể nhận thưởng Hạc Giấy!\nHai người <color=#D39FEFFF>tổ đội tham gia</color>, nhận thêm Cookie Vàng và Bạc",
    ["ui_ValentineDayFestival_034"]="Cá nhân tham gia cũng có thể nhận thưởng tương ứng! Cá nhân tham gia nhớ tương tác với Bạn Bè Tương Lai",
    ["ui_ValentineDayFestival_035"]="Danh sách Bạn Bè Tương Lai",
    ["ui_ValentineDayFestival_036"]="Đến Tiệm",
    ["ui_ValentineDayFestival_037"]="Mời bạn bè",
    ["ui_ValentineDayFestival_038"]="Yêu cầu xử lý",
    ["ui_ValentineDayFestival_039"]="Đề cử kết hợp",
    ["ui_ValentineDayFestival_041"]="Sau khi kết đôi có thể nhận thêm mỗi ngày",
    ["ui_ValentineDayFestival_042"]="Dựa theo lựa chọn của bạn, hệ thống ghép cho bạn một nhóm Bạn Bè Tương Lai, hoàn thành tương tác chỉ định cùng họ có thể nhận thưởng",
    ["ui_ValentineDayFestival_043"]="Mất liên lạc với đồng đội, trả lời bị chấm dứt",
    ["ui_ValentineDayFestival_044"]="Hôm nay đã trả lời đúng toàn bộ, đã nhận tất cả thưởng, ngày mai lại đến nhé!",
    ["ui_ValentineDayFestival_045"]="Có thể nhận thêm mỗi ngày",
