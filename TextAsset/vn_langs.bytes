    ["ui_Gyotaku_001"]="BXH In Cá",
    ["ui_Gyotaku_002"]="Loại cá 1",
    ["ui_Gyotaku_003"]="Loại cá 2",
    ["ui_Gyotaku_004"]="Loại cá 3",
    ["ui_Gyotaku_005"]="<color=#FFFFFFFF>làm ra In Cá dài nhất, độ dài: </color>",
    ["ui_Gyotaku_006"]="Hạng",
    ["ui_Gyotaku_007"]="Người câu",
    ["ui_Gyotaku_008"]="Độ dài",
    ["ui_Gyotaku_009"]="Cập nhật 5 phút 1 lần, lấy dữ liệu lúc 5:00 giờ làm chuẩn!",
    ["ui_Gyotaku_010"]="Chưa có ai, tiếp tục cố gắng nào.",
    ["ui_Gyotaku_011"]="Tạo In Cá",
    ["ui_Gyotaku_012"]="Vừa câu được                dài ",
    ["ui_Gyotaku_013"]="Dùng Mồi Câu Pháp Thuật để làm In Cá?",
    ["ui_Gyotaku_014"]="Mỗi ngày, bảng xếp hạng của Xavier sẽ chọn ngẫu nhiên 3 loại cá để ghi chép dữ liệu In Cá.\nMỗi ngày, dùng Mồi Câu Pháp Thuật câu cá tại Izlude có thể chế tạo In Cá 1 lần và ghi chép dữ liệu.\nBảng xếp hạng mỗi ngày sẽ tổng kết 1 lần, top 50 Nhà Thám Hiểm đầu bảng sẽ nhận được phần thưởng.\nXếp hạng của 3 loại cá sẽ không phân chia thứ hạng, phần thưởng cũng giống nhau.",
    ["ui_Gyotaku_015"]="Cách chơi sự kiện",
    ["ui_Gyotaku_016"]="Thưởng BXH",
    ["ui_Gyotaku_017"]="Hướng dẫn Thi Câu Cá",
    ["ui_Hairdressing_001"]="Tóc đẹp",
    ["ui_Hairdressing_002"]="Ẩn cài tóc",
    ["ui_Hairdressing_003"]="Mắt đẹp",
    ["ui_HalfAnniversary_001"]="Mừng Tròn Nửa Năm",
    ["ui_HalfAnniversary_002"]="Túi Mừng Tròn Nửa Năm",
    ["ui_HalfAnniversary_003"]="Thời gian cài lại hạn mua mỗi ngày: 05:00",
    ["ui_HalfAnniversary_004"]="Hạn mua hôm nay",
    ["ui_HalfAnniversary_005"]="Nhấp vật phẩm để xem giới thiệu chi tiết",
    ["ui_HalfAnniversary_006"]="Mua",
    ["ui_HalfAnniversary_007"]="Số lượng hạn mua",
    ["ui_HalfAnniversary_008"]="Ưu Đãi Tròn Nửa Năm",
    ["ui_HalfYearCelebration_001"]="Bình Chính Thức",
    ["ui_HalfYearCelebration_002"]="Nhận và Ném",
    ["ui_HalfYearCelebration_003"]="Ném",
    ["ui_HalfYearCelebration_004"]="Chạm màn hình theo nhịp điệu để tăng điểm",
    ["ui_HalfYearCelebration_005"]="Chọn bài nhạc",
    ["ui_HalfYearCelebration_006"]="Giấc Mơ Năm Mới",
    ["ui_HalfYearCelebration_007"]="Mở Thưởng Trăm Triệu",
    ["ui_HalfYearCelebration_008"]="<size=24>2022</size> <color=#FFFFFFFF>người chơi VIP thưởng càng nhiều, xác suất càng cao</color>",
    ["ui_HalfYearCelebration_009"]="Mục tiêu được điểm",
    ["ui_HalloweenActivity_001"]="Sự kiện Halloween",
    ["ui_HalloweenActivity_002"]="Tiệc",
    ["ui_HalloweenActivity_003"]="Mật Mã Linh Hồn",
    ["ui_HalloweenActivity_004"]="Đến tiệc",
    ["ui_HalloweenActivity_005"]="Đến tiệm",
    ["ui_HalloweenActivity_006"]="Thời hạn đổi",
    ["ui_HalloweenActivity_007"]="hằng ngày<color=#72DB8B>18:00</color>Bắt đầu bằng<color=#72DB8B>Sứ giả tiệc máu</color>Nhận manh mối mật khẩu và khóa độc quyền từ mọi nơi\nGửi bạn trong cuộc trò chuyện thế giới<color=#72DB8B>mật khẩu bị bẻ khóa</color>Đúng rồi~ Bạn sẽ nhận được nếu mật khẩu đúng<color=#FDC130>Phần thưởng qua email</color>!\nsẽ có cơ hội nhận được<color=#FDC130>Thú cưỡi hiếm vĩnh viễn</color>Này!",
    ["ui_HalloweenActivity_008"]="Điểm hoạt động: ",
    ["ui_HalloweenCode_001"]="Bóng Tối Mất Dấu",
    ["ui_HalloweenCode_002"]="Bắt đầu giải mã",
    ["ui_HalloweenCode_003"]="Tổ chức Bóng Tối ẩn mình trong bóng tối, trái tim hướng về ánh sáng đã đưa ra thử thách giải mã cho thợ săn ma!",
    ["ui_HalloweenCode_004"]="Nhấn vào avatar để bắt đầu đuổi theo",
    ["ui_HalloweenCode_005"]="Danh sách sứ giả mật mã văn bản gốc",
    ["ui_HalloweenCode_006"]="Danh sách sứ giả mật mã khóa",
    ["ui_HalloweenCode_007"]="Thực hiện các động tác xã giao nhất định đối với <color=#40E9CF>sứ giả mật mã văn bản gốc</color>, nhận được <color=#40E9CF>manh mối giải mã!</color>\nThứ tự mật mã cũng giống với thứ tự sứ giả mật mã văn bản gốc, đều là <color=#40E9CF>từ trái sang phải</color>~",
    ["ui_HalloweenCode_008"]="Thực hiện các động tác xã giao nhất định đối với <color=#40E9CF>Sứ Giả Mật Mã Khóa</color>, nhận được <color=#40E9CF>Khóa Độc Quyền</color> gồm 3 chữ số!\nThứ tự khóa số giống với thứ tự sứ giả mật mã khóa, đều là <color=#40E9CF>từ trái sang phải</color>~\n(Khóa Độc Quyền của mỗi Nhà Thám Hiểm có thể không giống nhau~)",
    ["ui_HalloweenCode_009"]="<color=#CAE0EE>Hàng ngày bắt đầu từ <color=#40E9CF>18:00</color>, có thể nhận được Manh Mối Mật Mã và Chìa Khoá Độc Quyền ở chỗ <color=#40E9CF>Sứ Giả Yêu Tinh</color>\nHãy gửi <color=#40E9CF>mật mã giải mã</color> của bạn trong Chat TG nhé! Mật mã chính xác sẽ nhận được <color=#EF9A67>thưởng qua thư</color>! \nNhà Thám Hiểm gửi mật mã chính xác <color=#40E9CF>đầu tiên</color> sẽ nhận thêm <color=#EF9A67>thưởng hiếm đó!</color></color>",
    ["ui_HalloweenCode_010"]="Bóng Tối Mất Dấu",
    ["ui_HalloweenCode_011"]="Hướng Dẫn",
    ["ui_HalloweenCode_012"]="Mở giao diện sự kiện, nhận danh sách 9 sứ giả bóng tối trong ngày",
    ["ui_HalloweenCode_013"]="Nói chuyện với Jakk để nhận gợi ý giải mã trong ngày (loại mật mã, cách giải mã và số lượng từ)",
    ["ui_HalloweenCode_014"]="Thực hiện các hành động xã giao nhất định đối với sứ giả mật mã bóng tối để nhận manh mối giải mã!\n· 6 sứ giả mật mã văn bản gốc: Cung cấp văn bản gốc cần thiết để giải mã\n· 3 sứ giả mật mã độc quyền: Cung cấp chìa khóa độc quyền gồm 3 chữ số\n<color=#ffc1f6>(Ghi chú: Mỗi sứ giả mật mã bóng tối đều có sở thích riêng, hãy viết ra hành động xã giao mà họ thích nhé~)</color>",
    ["ui_HalloweenCode_015"]="<color=#85f8ff>Gửi mật mã đã giải mã của bạn trong Chat Thế Giới, nếu mật mã đúng, bạn sẽ nhận được phần thưởng qua thư~</color>\n<color=#ffc1f6>Định dạng: Mật mã - Chìa Khóa Độc Quyền (như CODE-888)</color>",
    ["ui_HalloweenCode_016"]="Nhà thám hiểm đầu tiên trên mỗi server đăng đúng mật mã + chìa khóa trên Kênh Thế Giới sẽ nhận được Thú Cưỡi hiếm vĩnh viễn <color=#ffc1f6>Yamata no Orochi</color>!",
    ["ui_HalloweenCode_017"]="Ở phút thứ <color=#40E9CF>8/23/35/47</color> trong quá trình Bách Quỷ Dạ Hành xuất hiện <color=#40E9CF>MVP, Mini và BOSS</color> trong 12 khu!",
    ["ui_HalloweenCode_018"]="Hàng ngày",
    ["ui_HalloweenCode_019"]="Định dạng mật mã:\nMật mã - Chìa Khóa Độc Quyền\n(như CODE-888)",
    ["ui_HalloweenCode_020"]="Đếm ngược Bách Quỷ Dạ Hành",
    ["ui_HalloweenCode_021"]="Điểm Cổ Tích:",
    ["ui_HalloweenCode_022"]="18:00 25/10~23:59 09/11",
    ["ui_HalloweenCode_023"]="10/25~11/08",
    ["ui_HalloweenCode_024"]="19:00~20:00",
    ["ui_HalloweenItem1115"]="Kiểu mặt (nam) - Nhạc khiêu vũ",
    ["ui_HalloweenItem1214"]="Kiểu mặt (nữ) - Nhạc khiêu vũ",
    ["ui_HalloweenItem2131"]="Kiểu tóc nam - Nhạc khiêu vũ",
    ["ui_HalloweenItem2230"]="Kiểu tóc nữ - Nhạc khiêu vũ",
    ["ui_HalloweenItem80114"]="Đổi màu Thú Cưỡi - Yuanjin",
    ["ui_HalloweenParty_001"]="Bách Quỷ Dạ Hành",
    ["ui_HalloweenParty_002"]="Thời gian sự kiện",
    ["ui_HalloweenParty_003"]="Tới Khiêu Chiến",
    ["ui_HalloweenParty_004"]="Quỷ môn u ám mở ra, bách quỷ dạ hành đêm trong đêm. Không biết bên cạnh là bạn, là ma hay là quái vật? Jakk nói rằng rắc đậu có thể đuổi ma. Ở nơi ma quái còn có kho báu bí mật. Nếu đã là khách thì cuối cùng cũng tới địa ngục!",
    ["ui_HalloweenParty_005"]="Thời gian sự kiện",
    ["ui_HalloweenParty_006"]="Tới khiêu chiến",
    ["ui_HalloweenParty_007"]="cao bồi,\nUống màu đỏ tươi trong cốc và cùng nhau bắt đầu bữa tiệc máu của bóng chạng vạng!\nSự kiện bắt đầu từ 19:00~20:00 mỗi ngày và kéo dài trong 1 giờ\nTiêu diệt quái vật và bạn sẽ nhận được vật liệu đổi thưởng sự kiện!\nNgoài ra còn có cơ hội nhận được thú cưỡi hiếm có Infernal Golem!",
    ["ui_HalloweenParty_008"]="Từ <color=#40E9CF>19:00~20:00</color> hàng tuần, sẽ xuất hiện cảnh tượng kỳ lạ Bách Quỷ Dạ Hành, duy trì <color=#40E9CF>1</color> giờ\nNhà Thám Hiểm có cấp Cơ bản <color=#40E9CF>≥31</color> có thể tìm thấy Jakk tại bức tượng Prontera Odin và tới ảo ảnh Bách Quỷ Dạ Hành để tham gia sự kiện trừ ma",
    ["ui_HalloweenParty_009"]="Tiêu diệt Quái Vật được rất nhiều EXP, còn có thể nhận được <color=#40E9CF>nguyên liệu đổi</color> và phần thưởng <color=#40E9CF>linh hồn</color> độc quyền Bách Quỷ Dạ Hành! Trong đó còn có rất nhiều đậu có thể sử dụng~ Sau khi ăn đậu sẽ có một số thay đổi bất ngờ!",
    ["ui_HalloweenParty_010"]="Ở phút thứ <color=#40E9CF>8/23/35/47</color> trong quá trình Bách Quỷ Dạ Hành, ảo ảnh sẽ xuất hiện rất nhiều <color=#40E9CF>MVP, Mini và BOSS</color>!\nTiêu diệt chúng không chỉ nhận được rất nhiều <color=#40E9CF>nguyên liệu đổi để đổi lấy đạo cụ trang phục, mà còn có thể nhận được đạo cụ siêu hiếm <color=#40E9CF>Mãng Xà Nuốt Trời Xanh</color>!\nĐồng thời còn xuất hiện <color=#40E9CF>Nekomata</color> nghịch ngợm, tấn công và tiêu diệt Nekomata cũng có thể nhận được phần thưởng phong phú~",
    ["ui_HalloweenParty_011"]="Hàng ngày khi kết thúc sự kiện, Jakk sẽ được xếp hạng dựa trên số lượng <color=#40E9CF>linh hồn</color> mà Nhà Thám Hiểm thu thập được. Người có biểu hiện xuất sắc sẽ nhận được thêm thưởng <color=#40E9CF>Hộp Báu</color>!\nTrong thời gian sự kiện, Jakk cũng sẽ thiết lập <color=#40E9CF>Tiệm Đổi</color> tại bức tượng Prontera Odin. Các nhà thám hiểm có thể dùng nguyên liệu đổi nhận được để đổi lấy nhiều phần thưởng độc quyền của Halloween! Sau khi sự kiện kết thúc, Tiệm Đổi của Jakk sẽ tiếp tục được giữ lại trong 7 ngày, hãy nhớ nhanh tay để đổi nhé!",
    ["ui_HalloweenParty_012"]="Mỗi ngày Jakk sẽ ở Prontera\nPhái 9 vị <color=#ADFDF8FF> Sứ Giả Mật Mã</color> đặc biệt, thông qua\nthực hiện các <color=#ADFDF8FF>động tác xã giao</color> đối với Sứ Giả Mật Mã có thể\nnhận được manh mối mật mã",
    ["ui_HalloweenParty_013"]="Tất nhiên chỉ biết đáp án chính xác thôi không đủ!\nNhà Thám Hiểm phải tìm được <color=#ADFDF8FF>Sứ Giả Riêng</color> của mình mỗi ngày, nhận được 3 chữ số <color=#ADFDF8FF>Chìa khóa riêng</color>!",
    ["ui_HalloweenParty_014"]="Thực hiện các động tác xã giao nhất định đối với <color=#56E795FF>Sứ Giả Mật Mã Chữ</color>, nhận được <color=#56E795FF>Manh Mối Mật Mã!</color>\nThứ tự chữ cái mật mã và thứ tự Sứ Giả Mật Mã Chữ trong giao diện là như nhau~\n(Đau đầu vì cách giải mật mã, chi bằng thử cố gắng giao lưu với các Sứ Giả không có trong danh sách)",
    ["ui_HalloweenParty_015"]="Thực hiện các động tác xã giao nhất định đối với <color=#56E795FF>Sứ Giả Mật Mã Khóa</color>, nhận được <color=#56E795FF>Manh Mối Mật Mã!</color> </color>\nThứ tự chìa khóa mật mã và thứ tự Sứ Giả Mật Mã Khóa trong giao diện là như nhau~\n(Sứ Giả riêng của mỗi Nhà Thám Hiểm có thể không giống nhau~)",
    ["ui_HalloweenParty_016"]="Mỗi ngày khi hoạt động bắt đầu có thể nhận manh mối bắt đầu giải mã~\nTrong kênh <color=#56E795FF>chat thế giới</color> gửi <color=#56E795FF>đáp án mật mã</color> của bạn (Cách thức: Mật mã-chìa khóa, ví dụ: CODE-888)\nMật mã chính xác có thể nhận được thưởng qua thư~ Nhà Thám Hiểm <color=#56E795FF>đầu tiên</color> gửi đáp án chính xác sẽ nhận được phần thưởng thần bí!",
    ["ui_HalloweenParty_017"]="T/g bắt đầu hoạt động: <color=#56E795FF>18:00 mỗi ngày</color>",
    ["ui_HalloweenParty_097"]="mỗi ngày<color=#40E9CF>19:00~20:00</color>Sẽ có những ảo ảnh kéo dài<color=#40E9CF>1</color>Giờ\nCấp cơ sở<color=#40E9CF>≥31</color>Các nhà thám hiểm có thể tìm thấy Mr. Pumpkin tại Tượng Prontera Odin và đến Dusk Shadow Blood Feast Fantasyland để tham gia sự kiện\nTiêu diệt quái vật để nhận Lễ hội Máu Hoàng hôn độc quyền<color=#40E9CF>Trao đổi tài liệu</color>Và<color=#40E9CF>tích phân</color>phần thưởng! Ngoài ra còn có nhiều loại đậu có thể sử dụng được ~ sau khi ăn đậu sẽ có một số thay đổi bất ngờ!\nTrong Lễ hội máu hoàng hôn<color=#40E9CF>20/10/35/50</color>Phút chốc, một lượng lớn người sẽ xuất hiện trong thế giới giả tưởng<color=#40E9CF>MVP, Mini và BOSS</color>!\nTiêu diệt chúng sẽ không chỉ thu được một số lượng lớn vật phẩm có thể đổi lấy vật phẩm mỹ phẩm mà còn<color=#40E9CF>Trao đổi tài liệu</color>, và bạn cũng có thể nhận được những vật phẩm cực hiếm<color=#40E9CF>Golem địa ngục</color>!\nCũng sẽ có người điên<color=#40E9CF>thợ làm mũ điên</color>, bạn cũng có thể nhận được phần thưởng hậu hĩnh bằng cách tấn công và tiêu diệt Mad Hatter~\nVào cuối sự kiện mỗi ngày, Mr. Pumpkin sẽ thu thập thông tin mà các nhà thám hiểm thu thập được.<color=#40E9CF>tích phân</color>Xếp theo số lượng, ai có thành tích xuất sắc sẽ được nhận thêm<color=#40E9CF>Vật liệu</color>phần thưởng!\nNguyên liệu trao đổi mà mỗi người đánh rơi khi tiêu diệt quái vật mỗi ngày là:<color=#40E9CF>Giới hạn số lần</color>:<color=#40E9CF>Quái thường: 20 lần, Mini: 4 lần, MVP: 4 lần, BOSS: 2 lần, Mad Hatter: 2 lần</color>\nÔng Bí Ngô cũng sẽ xuất hiện tại Tượng Prontera Odin trong sự kiện này<color=#40E9CF>cửa hàng trao đổi</color>, nhà thám hiểm có thể sử dụng nguyên liệu trao đổi mà họ có được để đổi lấy nhiều phần thưởng Halloween độc quyền khác nhau! Sau sự kiện, cửa hàng đổi quà của Mr. Pumpkin sẽ tồn tại trong 3 ngày, vì vậy hãy nhớ dành thời gian để đổi quà nhé!",
    ["ui_HalloweenParty_098"]="Thời gian sự kiện",
    ["ui_HalloweenParty_099"]="Bách Quỷ Dạ Hành",
