    ["ui_KvmLimitGift_001"]="Trợ Sức Vượt Bậc",
    ["ui_KvmLimitGift_002"]="Gói Quà Tăng Vọt",
    ["ui_LanternFestival_001"]="Sự kiện Tết Nguyên Tiêu",
    ["ui_LanternFestival_002"]="Lễ Hội Nguyên Tiêu",
    ["ui_LanternFestival_003"]="Nhân dịp Nguyên Tiêu, sân chơi tại Cổng Nam Prontera sẽ tổ chức lễ hội, Sứ Giả Nguyên Tiêu kính mời các Nhà Thám Hiểm cùng người ấy đến chung vui.",
    ["ui_LanternFestival_004"]="Nhiệm vụ Lễ Hội 1: ",
    ["ui_LanternFestival_005"]="Nhiệm vụ Lễ Hội 2: ",
    ["ui_LanternFestival_006"]="Nhiệm vụ Lễ Hội 3: ",
    ["ui_LanternFestival_007"]="Giải được Đố Đèn Nguyên Tiêu do Sứ Giả Nguyên Tiêu gửi, tìm và ngồi lên Ghế Xích Đu đầu tiên sẽ giành chiến thắng!",
    ["ui_LanternFestival_008"]="Đu Quay Ngựa Gỗ nào có thể dẫn bạn đến chiến thắng? Đáp án được ẩn giấu trong mộng cảnh tươi đẹp của Sứ Giả Nguyên Tiêu.",
    ["ui_LanternFestival_009"]="Hãy hẹn người ấy cùng ngồi xe du ngoạn Lễ Hội Nguyên Tiêu! \nMỗi ngày hoàn thành nhiệm vụ lễ hội sẽ nhận được Hộp Thánh Odin, Nấu Ăn Đặc Biệt, Nguyên Tiêu Thỏ Vàng hoặc Nguyên Tiêu Thỏ Bạc!",
    ["ui_LanternFestival_010"]="Hưởng thụ Nấu Ăn Nguyên Tiêu đặc biệt sẽ nhận được hiệu quả Chúc Phúc.\nTương truyền Thỏ Vàng và Thỏ Bạc hội ngộ sẽ thắp sáng Đèn Chúc Phúc.",
