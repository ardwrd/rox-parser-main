    ["areaname3010202"]="X",
    ["areaname4121103"]="<color=#ff5252>Điểm giao cờ phe Đỏ</color>",
    ["areaname4121104"]="<color=#528fff>Điểm giao cờ phe Xanh</color>",
    ["areaname4506202"]="Khu An Toàn",
    ["areaname4506250"]="Đến Tầng 1",
    ["areaname4506251"]="Đến Tầng 2",
    ["areaname5031"]="Trạm Kiểm Tra\nBiên Giới",
    ["areaname5041"]="Thung Lũng\nErmes",
    ["areaname6000201"]="Sảnh Công Hội",
    ["areaname6000202"]="Quảng Trường Công Hội",
    ["aside11000101"]="Này, này, đừng ngó nghiêng nữa! Tớ nói cậu đấy!",
    ["aside11000102"]="Chắc cậu cũng là Tân Thủ đến báo danh đúng không, đến đây nào!",
    ["aside11000201"]="Người đứng trước sân khấu là Jarod ư?!",
    ["aside11000202"]="Dù sao thì, đến hỏi thử xem...",
    ["aside11000301"]="Xem ra nếu không đáp ứng yêu cầu của Jarod, anh ta sẽ không nghe mình nói hết đâu...",
    ["aside11000401"]="Thế nào rồi? Bé ngoan đã tìm được bạn chưa?",
    ["aside11000501"]="Đi thôi đi thôi, cửa quán rượu ở đằng kia!",
    ["aside11000502"]="Ôi, Isabella xinh đẹp, chiêu sinh khóa sau ta sẽ lại đến!",
    ["aside11000601"]="Mấy người... lâu quá đi!",
    ["aside11000701"]="Đi dọc theo con đường này sẽ thấy Cổng Nam Prontera.",
    ["aside11000702"]="Chúng ta mau đi thôi.",
    ["aside11000801"]="Cô gái đó chính là Cenia... Cô ấy gặp rắc rối rồi!",
    ["aside11000802"]="Mau qua giúp cô ấy!",
    ["aside11000901"]="Cẩn thận, đám Poring này hình như phát điên rồi!",
    ["aside11001001"]="A ha, bây giờ đến lượt Người Hướng Dẫn ra tay rồi!",
    ["aside11001002"]="Tân Thủ, hãy cầm chắc Dao Găm của cậu!",
    ["aside11001101"]="Cái đám Poring này cứ dây dưa không dứt...",
    ["aside11001102"]="Đừng nương tay, hãy cho chúng một đòn nhớ đời!",
    ["aside11001201"]="Đợi đã, lại một tên nữa đang đến! Thật đúng là cứ mãi không thôi...",
    ["aside11001301"]="Tân Thủ, cậu hãy tránh xa kỹ năng của Vua Poring!",
    ["aside11001302"]="Tên này mạnh hơn đám Poring thường rất nhiều đấy!",
    ["aside11001401"]="Tân Thủ, cậu đã rất cố gắng rồi.",
    ["aside11001402"]="Bây giờ để ta dạy cậu kỹ năng thoát lui an toàn!",
    ["aside11001501"]="Dùng kỹ năng này có thể hồi phục thể lực!",
    ["aside11001601"]="Chúng ta chia nhau hành động thôi!",
    ["aside11001602"]="Hãy kiểm tra nơi vầng hào quang biến mất!",
    ["aside11001701"]="Đến phía trước tìm thử xem, biết đâu vẫn còn...",
    ["aside11001801"]="Phía trước lại có một chiếc lông!",
    ["aside11001901"]="Đến trước vách đá nhìn thử xem!",
    ["aside11002001"]="Hay là … bám vào dây leo để leo lên!",
    ["aside11002101"]="Quả nhiên tổ quạ ở trên này!",
    ["aside11002201"]="Tìm thấy rồi! Mang nó về cho Cenia thôi!",
    ["aside11002301"]="Thú cưỡi này có thể đưa người về!",
    ["aside11002401"]="Cuối cùng cậu cũng theo kịp rồi!",
    ["aside11002501"]="Làm xong rồi, mau đội vào thử xem!",
    ["aside11002601"]="Đến bến cảng rồi, cậu xem kìa, phía trước hình như là Cenia?",
    ["aside11002701"]="Đi chào hỏi <color=#CA2E0AFF>Thuyền Trưởng Carew</color> một tiếng nhé! Hành trình này dựa cả vào ông ấy đấy!",
    ["aside11002801"]="Thuyền cập bến rồi!",
    ["aside11002901"]="Ha ha ha, tạm biệt nhé, các bạn nhỏ!",
    ["aside11003001"]="Đây là Chợ Lam Champagne, là nơi các thương gia tại đảo Izlude hay tụ tập.",
    ["aside11003002"]="Bất kể là mua vũ khí, phòng cụ hay hỗ trợ, đều có thể đến đây!",
    ["aside11003101"]="Phía trước là công viên ven biển, các học viên thích tổ chức dã ngoại ở đây những lúc rảnh rỗi...",
    ["aside11003102"]="Ngắm hoa, câu cá, thật là thư thái!",
    ["aside11003201"]="Đi qua cánh cửa này chính là Học Viện Criatura rồi!",
    ["aside11003202"]="Viện Trưởng Mainz đang đợi ngươi ở Sảnh Chuyển Nghề, mau tới gặp ngài ấy đi!",
    ["aside11003301"]="Nhắm mắt lại và thư giãn nào. Sau khi thí luyện kết thúc, hãy cho ta biết lựa chọn của con.",
    ["aside11003401"]="Cuối cùng con cũng đến rồi! Mau theo ta nào.",
    ["aside11003501"]="Đừng vội đi nhé, cậu vẫn chưa nhận <color=#CA2E0AFF>Chứng Nhận Nghề I</color> đấy.",
    ["aside11003601"]="Muốn biết thêm nhiều câu chuyện về Trái Tim Ymir, hãy đi đến thư viện nhé.",
    ["aside11003602"]="Eason, quản lý thư viện, sẽ giúp con.",
    ["aside11003701"]="Sao cậu lại ở đây! Tớ tìm cậu rất lâu rồi đấy!",
    ["aside11003801"]="Mọi người đều tập trung ở quảng trường hết rồi, chúng ta cũng mau qua đó thôi!",
    ["aside11003901"]="Được, chúng ta đi ngay thôi!",
    ["aside11004001"]="Tốt lắm, tốt lắm, cứ thế mà làm!",
    ["aside11004301"]=" Hãy chú ý! Sau khi đã chọn một thầy hướng dẫn nghề nghiệp để trò chuyện, sẽ không thể chuyển sang nghề khác nữa! Hãy suy nghĩ kỹ!",
    ["aside11004302"]="Hoàn thành <color=#CA2E0AFF>Nhiệm Vụ chuỗi Chuyển Nghề I</color> để có thể tiếp tục nhiệm vụ chính",
    ["aside11010101"]="Phía dưới sân ga tàu bay? Qua đó xem thử!",
    ["aside11010201"]="Tốt lắm! Mệnh lệnh tiếp theo của ta chính là đi nói với <color=#CA2E0AFF>phi công</color>——",
    ["aside11010202"]="Nếu anh ta còn không xuất phát, ta sẽ dùng đôi ủng đá thật mạnh vào mông anh ta!",
    ["aside11010301"]="Suýt chút quên mất còn phải họp với Đoàn Trưởng Fitz... Đến chỗ đài phun nước trung tâm ngay!",
    ["aside11010401"]="Tập Sự, cuối cùng cậu cũng xuất hiện rồi!",
    ["aside11010501"]="Trước khi huấn luyện, cậu cần đến chỗ thợ rèn Hollgrehenn một chuyến.",
    ["aside11010502"]="Anh ấy sẽ khiến những viên đá cường hóa này phát huy tác dụng.",
    ["aside11010601"]="Đã xong! Trang bị của cậu đã kiên cố hơn trước rất nhiều!",
    ["aside11010602"]="Chỉ cần mang đủ đá cường hóa đến, ta sẽ khiến nó càng kiên cố hơn, ha ha ha!",
    ["aside11010701"]="Bây giờ phải về báo cáo Đoàn Trưởng Fitz rồi... Đợi đã, có tiếng kêu cứu ở đâu đó?",
    ["aside11010801"]="Đây là...? Mang về cho Đoàn Trưởng Fitz xem!",
    ["aside11010901"]="Tìm thấy rồi, mang nó về luôn vậy!",
    ["aside11011001"]="Kẻ nào?!",
    ["aside11011101"]="Bức thư trên đất này là...?",
    ["aside11011201"]="Nhờ vào cậu đấy!",
    ["aside11011301"]="Hai người kia trông rất đáng nghi... Mình đến lén nghe họ đang nói gì.",
    ["aside11011401"]="... Phải nói thế nào đây?",
    ["aside11011402"]="Này, Nhà Thám Hiểm kia, lại đây! ",
    ["aside11011501"]="Hắn uống say rồi, nhân cơ hội thăm dò tin tức!",
    ["aside11011601"]="Này, ấy cũng đến tìm kho báu à?",
    ["aside11011701"]="Quân Trưởng Bernard, ngài đến thật đúng lúc!",
    ["aside11011801"]="Đây là...?!",
    ["aside11011901"]="Sao trong kho báu cũng có quái vật chứ?!",
    ["aside11012001"]="Tiêu rồi, <color=#CA2E0AFF>Mảnh Trái Tim Ymir</color> đâu rồi?!",
    ["aside11012002"]="Đợi đã, chẳng lẽ là do <color=#CA2E0AFF>Thuật Sĩ Luyện Kim</color> kia...",
    ["aside11012101"]="Ở đây có <color=#CA2E0AFF>Giáp Kỵ Sĩ</color> nè... Hay là mặc nó vào, ngụy trang thành người của Đoàn Kỵ Sĩ?!",
    ["aside11012201"]="Cái gì, Mảnh Trái Tim Ymir? Nói nhỏ thôi... Cậu đang nói đến cái ở trong cung cách đây không lâu không cánh mà bay đấy hả?",
    ["aside11012202"]="Nghe nói quân phòng vệ Bernard đã thông đồng với thuật sĩ luyện kim để trộm nó, việc này ai cũng biết rồi, nhưng Đoàn Trưởng Hallam hình như vẫn cho rằng hắn vô tội...",
    ["aside11012301"]="Nghe nói đội thảo phạt tìm thấy một trang bị kỳ lạ ở dưới đường hầm...",
    ["aside11012401"]="Biết gì không? Trước đó không lâu, người của Quân Phòng Vệ muốn xông vào đường hầm đấy... Ở đó thì có thứ gì tốt chứ? Thật nghi ngờ mục đích của họ!",
    ["aside11012501"]="Đứng im! Nơi này đã bị Đoàn Kỵ Sĩ Hoàng Gia phong tỏa rồi!",
    ["aside11012601"]="Người của Đoàn Kỵ Sĩ chắc ở gần đây! Tìm thử xem.",
    ["aside11012701"]="Tôi bị bao vây rồi, cậu hãy làm sạch <color=#CA2E0AFF>Trứng Bọ Trộm</color> này trước đi!",
    ["aside11012801"]="...Hallam?!",
    ["aside11012802"]="Quân Trưởng Bernard, hãy nghe tôi giải thích.",
    ["aside11012901"]="Lại gặp nhau rồi, bạn của tôi!",
    ["aside11013001"]="Nơi này hình như có vết tích con người từng sinh sống...",
    ["aside11013101"]="Đây, đây là...!!!",
    ["aside11013201"]="Người đó chắc chắn là Tổng Giám Mục, mau nhờ ông ấy giúp đỡ.",
    ["aside11013301"]="Giờ hãy đứng dưới tượng thần và cầu nguyện, Odin sẽ đáp lại con bằng thần lực.",
    ["aside11013401"]="Đoàn Trưởng Hallam và Quân Trưởng Bernard đang đợi cậu dưới Tượng Odin!",
    ["aside11013402"]="Mau đến đó đi!",
    ["aside11013501"]="Nhân vật chính của lễ trao huân chương đã đến rồi, hãy cổ vũ cho Nhà Thám Hiểm xuất sắc này!",
    ["aside11013502"]="Đã nghe gì chưa? Nhà Thám Hiểm này đã dập tắt cuộc bạo loạn của quái vật thủ đô!",
    ["aside11013503"]="Không những thế, còn mang về Mảnh Trái Tim Ymir...",
    ["aside11013504"]="Nhờ có vị anh hùng này, mà nông trường của chúng ta lại được hòa bình...",
    ["aside11013601"]="Nhà Thám Hiểm, cậu đã chuẩn bị xong chưa? Hãy thể hiện trước mặt Odin.",
    ["aside11013701"]="...Người thừa kế huyết mạch Odin là cậu sao...",
    ["aside11013702"]="Ai đang nói thế?",
    ["aside11013801"]="Người thừa kế huyết mạch Odin, đây mới chỉ là sự khởi đầu...",
    ["aside11013901"]="Người thừa kế huyết mạch Odin, cậu mạnh đấy, nhưng chưa đủ đâu...",
    ["aside11014001"]="Tốt lắm... Hãy đến trước mặt ta.",
    ["aside11014101"]="Nữ Thần... biến mất rồi?",
    ["aside11019901"]="Baroshev... chạy mất rồi? Đợi đã, đó là...",
    ["aside11019902"]="Mảnh Trái Tim Ymir?!",
    ["aside11020101"]="Cậu muốn đi ra biển? Giờ không phải là lúc thích hợp.",
    ["aside11020201"]="Cạch cạch cạch cạch! Hòn đảo này sắp trở thành —— Vương quốc của cướp biển!",
    ["aside11020202"]="Ai đang nói thế?",
    ["aside11020301"]="Những quái vật đột nhiên xuất hiện này là sao? Rốt cuộc đã xảy ra chuyện gì!",
    ["aside11020302"]="Thì ra là cậu!",
    ["aside11020401"]="Nhờ cả vào cậu đấy.",
    ["aside11020501"]="Ủa? Sao cậu lại ở đây?",
    ["aside11020601"]="Cuối cùng cũng gặp người sống rồi, mau đến đây giúp... Sao cậu còn không mau qua đây?!",
    ["aside11020701"]="Này! Cậu đang nhìn ở đâu đấy, ông ở đây cơ mà!",
    ["aside11020801"]="Mọi người vất vả rồi, là mọi người đã bảo vệ đảo Izlude!",
    ["aside11020901"]="Nhà Thông Thái... lẽ nào là chỉ Kroneika? Chi bằng đi hỏi thử xem!",
    ["aside11021001"]="Nhà Thám Hiểm, nhờ cậu giúp tôi được không?",
    ["aside11021101"]="Đúng thế, chính là ở đây, cảm ơn cậu nhé!",
    ["aside11021201"]="Tránh ra, lũ ruồi đáng ghét! Cách xa ta ra!",
    ["aside11021301"]="Quả nhiên có dòng sông, đi đến bên kia cầu nhìn xem!",
    ["aside11021401"]="Dấu chân trên đất... có phải là của Nhà Thông Thái để lại?",
    ["aside11021501"]="Sao lại là cậu?!",
    ["aside11021601"]="Ta... sẽ... lại hồi sinh...",
    ["aside11021701"]="Đến đây, chúng ta có thể đến tệ xá Nhà Thông Thái bằng trận pháp dịch chuyển.",
    ["aside11021801"]="Giờ cho ta chút thời gian.",
    ["aside11021901"]="Tiền bối chính là Nhà Thám Hiểm mà cha nhắc đến sao?",
    ["aside11022001"]="Cậu quay lại thật đúng lúc, chúng ta có thể xuất phát rồi.",
    ["aside11022101"]="Nhà Thám Hiểm, cuối cùng con cũng đã trở về rồi!",
    ["aside11022201"]="Cứu, cứu tôi với!!! Có ai nghe thấy không?",
    ["aside11022301"]="Đây là...?",
    ["aside11022401"]="...Vậy mới nói, anh nhận nhầm người rồi!",
    ["aside11022402"]="Đó là... tiếng của Alice?",
    ["aside11022501"]="Làm tốt lắm, tôi sẽ đến phòng cầu nguyện để chuẩn bị trước!",
    ["aside11022601"]="Thuyền của ta... Sao trên thuyền của ta toàn quái vật thế kia?!",
    ["aside11022701"]="Trì hoãn lâu như vậy, chắc đã được rồi.",
    ["aside11022801"]="Đợi đã, xúc tu này...",
    ["aside11022901"]="Hãy... giúp ta...",
    ["aside11023001"]="Nhà Thám Hiểm, tôi biết là cậu sẽ đến mà.",
    ["aside11023101"]="Cẩn thận... Chúng đến rồi!",
    ["aside11023201"]="Ký hiệu đến đây là hết rồi, thuyền trưởng Hải Tặc chắc chắn ở sau cánh cửa này!",
    ["aside11023202"]="Cuối cùng đã đuổi kịp con!",
    ["aside11023301"]="...Người thừa kế huyết mạch Odin, cậu trở lại rồi...",
    ["aside11023401"]="Tìm thấy rồi, mắt của Kraken!",
    ["aside11023501"]="...Người thừa kế huyết mạch Odin, cậu trở lại rồi...",
    ["aside11023601"]="Mảnh thứ 3... ở vùng Morroc... hãy cẩn thận...",
    ["aside11023602"]="Sức mạnh nguyên tố Lửa của mảnh đã được kích hoạt... Điều này vô cùng nguy hiểm...",
    ["aside11030101"]="Lạ thật, sao lại có người tìm được đến đây...",
    ["aside11030201"]="Luồng khí hiếm có đang ở trước mặt.",
    ["aside11030301"]="Chính là ở đây... Phù, cát lại vùi lấp nó rồi.",
    ["aside11030401"]="Sắc xong rồi, thuốc còn nóng, mau rót ra đi!",
    ["aside11030501"]="...Cẩn thận!",
    ["aside11030601"]="Không... không ổn rồi, mặt đất đang sụp xuống!",
    ["aside11030701"]="Cái hố tử thần phía trước... liệu có phải Trisse đã rớt xuống đó không?",
    ["aside11030801"]="Khó quá, thật là khó quá đi...",
    ["aside11030901"]="Cô gái ngổ ngáo tùy tiện... lẽ nào là Trisse? Đi theo qua đó xem thử!",
    ["aside11031001"]="Khó quá, thật là khó quá đi...",
    ["aside11031101"]="Người yêu từ trên trời rơi xuống... hình như là Trisse, đi theo qua đó xem thử.",
    ["aside11031201"]="Khó quá, thật là khó quá đi...",
    ["aside11031301"]="Ôi! Bị phát hiện rồi!",
    ["aside11031401"]="Cục cưng, nàng đã quay về rồi!",
    ["aside11031501"]="Đến đây nào! Đặt Nguyên Thạch Đất vào Luồng Khí Của Gió đi.",
    ["aside11031601"]="Á... Cẩn thận phía trước!",
    ["aside11031701"]="Này... Cần nau chóng đem những thi thể quái vật này đến cho Thương Gia chợ đen.",
    ["aside11031801"]="Ọe, mấy thứ này gớm ghiếc quá... Odin à, mùi này...",
    ["aside11031901"]="Tất cả đều vì tình yêu... Ọe... Ta sắp nghẹt thở rồi...",
    ["aside11032001"]="Mong là Heflee sẽ thích... Ọe!",
    ["aside11032101"]="Ai? Kẻ nào to gan dám xúc phạm đến tôn nghiêm của ngài Osiris!",
    ["aside11032201"]="Có lẽ đã tìm về hết rồi, mau đem chúng đi gặp Eassis đi.",
    ["aside11032301"]="Á, tiêu rồi tiêu rồi, trên này toàn là nước miếng của Cáo Đen...",
    ["aside11032401"]="Ồ, cảm ơn rất nhiều! Cậu xem, ngón tay tôi vẫn đang run run nè!",
    ["aside11032501"]="Trái tim nóng bỏng đập thình thịch này... thuộc về ngài Osiris!",
    ["aside11032601"]="Hãy nhìn vầng trán cong này xem, thật cao quý biết bao!",
    ["aside11032701"]="Vậy, ta cũng nên đi ngủ tiếp rồi... Nhà Thám Hiểm, mong là không gặp lại cậu.",
    ["aside11032801"]="...Người thừa kế huyết mạch Odin, cậu trở lại rồi...",
    ["aside11040101"]="Ta chỉ có thể tiễn cậu đến đây thôi, chúc may mắn!",
    ["aside11040201"]="...Nhà Thám Hiểm ơi, xin hãy dừng bước?",
    ["aside11040301"]="Cứu với... Có ai cứu ta với...!",
    ["aside11040401"]="Xem như được cứu rồi... Cảm ơn thật nhiều!",
    ["aside11040501"]="Chúng ta đi ngay thôi!",
    ["aside11040601"]="Được rồi, thuốc trị thương đã xong.",
    ["aside11040602"]="Mau đưa cho ta!",
    ["aside11040701"]="Nếu đoán không lầm, thì đây chính là đầu lâu có bộ xương bằng vàng!",
    ["aside11040801"]="Dấu chân trên mặt đất... chắc chắn là Yorkshire để lại!",
    ["aside11040901"]="Ồ, tên đó chắc đang ở phía trước!",
    ["aside11041001"]="Hình như hắn đang nói chuyện với ai đó? Mau đến gần xem...",
    ["aside11041101"]="Cơn chấn động này... hình như truyền ra từ mặt đất!",
    ["aside11041102"]="...Là cậu giúp công chúa chạy trốn sao?",
    ["aside11041201"]="Đây... đây là!?",
    ["aside11041202"]="Thầy Tế Leona, không ổn rồi!",
    ["aside11041301"]="Đây là... ngài Nield!?",
    ["aside11041302"]="Ôi... A a a!!! Là kẻ nào... Ta phải giết ngươi!",
    ["aside11041303"]="...Tiêu rồi, ngài Nield phát điên rồi!",
    ["aside11041401"]="Gali từng nói, anh ấy muốn đưa Lucia đi xem phong cảnh sa mạc...",
    ["aside11041402"]="Xem ra muốn tìm ra công chúa Lucia, chắc phải đi sa mạc thử vận may!",
    ["aside11041501"]="Thật trùng hợp, chúng ta lại gặp nhau rồi!",
    ["aside11041601"]="Sắc xong rồi, thuốc còn nóng, mau rót ra đi!",
    ["aside11041701"]="...Cứu, cứu tôi với!",
    ["aside11041702"]="Được cứu rồi, cảm ơn cậu nhé!",
    ["aside11041901"]="Hu hu hu ...",
    ["aside11041902"]="Âm thanh này... hình như đến từ phía Tây!",
    ["aside11042001"]="Hu hu hu ... Cha ơi... Cha ở đâu...",
    ["aside11042002"]="Tìm thấy rồi!",
    ["aside11042101"]="Tiêu rồi, lối vào đã bị chặn hoàn toàn!",
    ["aside11042201"]="Thần dân đáy biển đều trở nên xa lạ... Lẽ nào cả cha cũng...",
    ["aside11042301"]="Đó là... Chúng ta cần phải giúp anh ấy!",
    ["aside11042401"]="Xem ra, tất cả đã kết thúc rồi.",
    ["aside11042501"]="...Người thừa kế huyết mạch Odin, cậu làm tốt lắm...",
    ["aside11050101"]="Đứng im!",
    ["aside11050201"]="Đến rồi, là chỗ này!",
    ["aside11050301"]="Đây chính là Hang Cương Thi mà bác đã nhắc đến.",
    ["aside11050302"]="Tiểu Thư Moon Euin, cẩn thận! Chúng lại đến rồi!",
    ["aside11050401"]="Đám cương thi này ngày càng hung dữ... phải làm sao đây...",
    ["aside11050402"]="Ờ, chúng ta nên quay về gặp bác trước đã.",
    ["aside11050501"]="Này, này! Nhà Thám Hiểm, qua đây nè ...",
    ["aside11050601"]="Trời ơi, giờ phải làm sao đây, làm sao đây...",
    ["aside11050701"]="Dưới gốc cây đằng kia hình như có Cỏ Băng Phách...",
    ["aside11050801"]="Sột soạt... sột soạt!!",
    ["aside11050802"]="Tiêu rồi, hình như nó rất tức giận!",
    ["aside11050901"]="Trong bụi cỏ đằng kia hình như có Nấm Bánh Thịt...",
    ["aside11051001"]="Sột soạt... sột soạt!!",
    ["aside11051002"]="Tiêu rồi, hình như nó rất tức giận!",
    ["aside11051101"]="Sư huynh, huynh về rồi!",
    ["aside11051201"]="Lạ thật, sao lại yên tĩnh vậy... Cẩn thận!!",
    ["aside11051301"]="Đám cương thi này... lẽ nào?",
    ["aside11051401"]="Ông cụ đứng trước nhà hình như là trưởng thôn, đến hỏi ông ấy tình hình xem sao!",
    ["aside11051501"]="Muốn biết rõ đã xảy ra chuyện gì, xem ra đành phải hỏi những người dân còn sống sót kia.",
    ["aside11051601"]="Bên giếng... Bác sĩ đi ngang qua?",
    ["aside11051602"]="Việc này thật quá kỳ lạ rồi, phải đi điều tra cái giếng kia!",
    ["aside11051701"]="Thôn trưởng nói có lẽ là cái giếng cổ này, mau điều tra xem!",
    ["aside11051801"]="Tôi về rồi đây!",
    ["aside11051901"]="Quả nhiên nó đột biến rồi!",
    ["aside11052001"]="Các cậu là ai?",
    ["aside11052101"]="Kết quả điều tra thế nào?",
    ["aside11052201"]="Quả nhiên ở đây khắp nơi đều là quái vật... Xem ra không dọn dẹp sạch sẽ thì không thể tiếp tục lên đường.",
    ["aside11052301"]="Ở đây sạch sẽ nhiều rồi, mau đến phía trước xem!",
    ["aside11052401"]="Đợi đã, mấy thứ trên mặt đất kia là gì?",
    ["aside11052501"]="Á... Người đang hôn mê kia là?",
    ["aside11052601"]="Luồng sức mạnh này... thật quen thuộc...",
    ["aside11052602"]="Ai đang nói chuyện thế?",
    ["aside11052701"]="Đám quái vật này... hình như chúng cũng bị bùa thu hút!",
    ["aside11052801"]="Được rồi, bây giờ có thể đào bùa ra.",
    ["aside11052901"]="Chỉ có 2 mảnh hình như không thể ghép hoàn chỉnh, mau đi tìm ở nơi khác xem.",
    ["aside11053001"]="Lại là quái vật... Chúng đến vì bùa sao?",
    ["aside11053101"]="Được rồi, bây giờ có thể đào bùa ra.",
    ["aside11053201"]="Cuối cùng cũng ghép xong rồi, mang chúng đi gặp đám Quỷ Lửa đi!",
    ["aside11053301"]="A, đúng rồi... chính là luồng sức mạnh này...",
    ["aside11053401"]="Tìm thấy rồi!",
    ["aside11053501"]="...Đây... đây là đâu?",
    ["aside11053601"]="Đại Tướng Quân!",
    ["aside11053701"]="Sao ngài lại ở đây?",
    ["aside11053801"]="Trưởng lão đó chắc là anh ấy nhỉ?",
    ["aside11053901"]="Đứng im! Nghĩa trang gia tộc Euin, há để người ngoài bước vào?",
    ["aside11054001"]="...Đủ rồi.",
    ["aside11054101"]="Bây giờ phải quay về gặp Đại Tướng Quân Qi Euin rồi.",
    ["aside11054201"]="Quái vật, đây không phải là nơi để các ngươi hỗn xược!",
    ["aside11054301"]="Cẩn thận, chúng lại đến rồi!",
    ["aside11054401"]="Đám quái vật này sao cứ dây dưa không dứt!",
    ["aside11054501"]="Các vị, xin đợi một lát.",
    ["aside11054601"]="Đây là...?!",
    ["aside11054701"]="...Chuyện gì vậy?!",
    ["aside11054801"]="Tôi tìm ra rồi... Thì ra đây chính là nguyên nhân cương thi xuất hiện!",
    ["aside11054901"]="Tiêu rồi tiêu rồi, huynh à... huynh không sao chứ?",
    ["aside11055001"]="Bác ơi, cẩn thận!",
    ["aside11055101"]="...Người thừa kế huyết mạch Odin, cậu làm tốt lắm...",
    ["aside11060101"]="Đây... đây là!?",
    ["aside11060102"]="Ý, lại đến nữa sao.",
    ["aside11060201"]="Ờ... Cô Jesqurienne ở phòng nào? Đi tìm người hỏi xem!",
    ["aside11060301"]="Nhìn xem, pháp khí vốn dĩ phải ở trên bàn!",
    ["aside11060401"]="Hơi thở này...",
    ["aside11060402"]="Ủa? Cậu cũng cảm nhận được sao?",
    ["aside11060501"]="Phía trước là...!",
    ["aside11060502"]="Chết tiệt, pháp khí là do cậu trộm sao?",
    ["aside11060601"]="Các ngươi ... cũng khá mạnh đấy...",
    ["aside11060701"]="Cẩn thận, mấy tên kia xông đến rồi!",
    ["aside11060801"]="Đừng nên buông lỏng cảnh giác, rắc rối vẫn chưa kết thúc đâu...",
    ["aside11060901"]="Đợi đã, gần đây hình như có động tĩnh gì đấy...",
    ["aside11061001"]="Tốt lắm, ở đây tạm thời an toàn rồi.",
    ["aside11061101"]="Hay là... mau báo cho đám Bairde biết tình hình đi!",
    ["aside11061201"]="Chính là loại quả này, đặt chúng trước doanh trại Goblin thử xem!",
    ["aside11061301"]="Goblin ơi, quả ngon quả ngọt đây!",
    ["aside11061302"]="Quả nhiên cắn câu rồi! Đặt thêm một ít nữa xem!",
    ["aside11061401"]="Goblin, còn nữa nè!!",
    ["aside11061402"]="Theo đến đây rồi, hãy thử dẫn nó đến trước Lá Chắn Pháp Thuật!",
    ["aside11061501"]="Goblin, Goblin, không cho ai hết, của cục cưng hết!",
    ["aside11061502"]="Làm tốt lắm Nhà Thám Hiểm, mau bắt lấy chúng!",
    ["aside11061601"]="Đừng đánh nữa, đừng đánh nữa... Ta... ta nhận thua Goblin!!",
    ["aside11061701"]="Đáng ghét, để tên ma cà rồng đó chạy mất rồi... Mau báo cáo tình hình cho Jesqurienne!",
    ["aside11061801"]="Thế nào rồi, tìm thấy pháp khí chưa?",
    ["aside11061901"]="Nhà Thám Hiểm, có một số việc cậu cần phải biết...",
    ["aside11062001"]="Thứ Thầy Hướng Dẫn nói đến chắc là cuốn sách này.",
    ["aside11062101"]="...Ta biết là cậu sẽ đến mà.",
    ["aside11062201"]="Orc già kia chắc là Shaman.",
    ["aside11062301"]="Thôi xong! Bị phát hiện rồi!",
    ["aside11062401"]="Đứng lại, đừng mong chạy thoát!",
    ["aside11062501"]="Những lời vừa rồi... phải nhanh chóng nói với Murloma!",
    ["aside11062601"]="Đến đây, cho các cậu đấu một trận công khai công bằng!",
    ["aside11062701"]="Nếu chiến đấu là điều chắc chắn xảy ra... vậy thì không cần nương tay nữa!",
    ["aside11062801"]="Cẩn thận! Bọn họ sắp xuất chiêu rồi——",
    ["aside11062901"]="Kết quả đã quá rõ ràng.",
    ["aside11063001"]="Được rồi, cũng phải đi đến nhà Tù Trưởng để gặp Joao rồi!",
    ["aside11063101"]="Nói mau! Rốt cuộc anh cả đã đi đâu rồi?!",
    ["aside11063201"]="Đi, đi đến phía trước xem thử!",
    ["aside11063301"]="Xong rồi, mau đưa chúng cho Joao thôi!",
    ["aside11063401"]="Đứng im! Ở đây cấm vào!",
    ["aside11063501"]="Woa woa woa!!!",
    ["aside11063502"]="Âm thanh này là... con trai Jofar của ta!",
    ["aside11063601"]="A a, muộn rồi, muộn rồi...",
    ["aside11063701"]="Ta biết bây giờ xin lỗi đã muộn rồi...",
    ["aside11063801"]="Cuối cùng các cậu cũng về rồi.",
    ["aside11063901"]="Trong chuyện này chắc chắn có gì kỳ lạ, hãy đi theo dấu chân tìm thử xem...",
    ["aside11064001"]="Ta hiểu suy nghĩ của cậu. Nhưng bây giờ buộc phải tập trung tinh thần để điều tra...",
    ["aside11064101"]="Xem ra đáp án ở trong doanh trại đó!",
    ["aside11064201"]="Thứ trên đất đó là...!",
    ["aside11064301"]="Đến phía trước tìm thử xem, biết đâu vẫn còn manh mối nào đó...",
    ["aside11064401"]="Đợi đã, phía trước vẫn còn 1 tên lính...",
    ["aside11064501"]="Những vệ binh tộc Búa này rõ ràng là đã... phải quay về báo cáo tộc trưởng thôi.",
    ["aside11064601"]="Đã tìm thấy tung tích của các vệ binh chưa?",
    ["aside11064701"]="Xong rồi, tiếp tục đi về phía trước thôi!",
    ["aside11064801"]="Quả nhiên hiệu nghiệm, đặt thêm một ít nữa xem!",
    ["aside11064901"]="Phía trước chính là doanh trại của Kobold Rìu To, nhất định phải cẩn thận!",
    ["aside11065001"]="Có gì thì nói đi... động tay làm gì?!",
    ["aside11065101"]="Chúng ta lại gặp nhau rồi, Nhà Thám Hiểm!",
    ["aside11065201"]="Nhà Thám Hiểm, cậu đã bình an quay về.",
    ["aside11065301"]="Đây... rốt cuộc là chuyện gì?!",
    ["aside11065401"]="Phía trước, ở ngay phía trước... chỉ cần đi xuống dốc núi này là có thể tìm thấy thứ cậu tìm kiếm...",
    ["aside11065402"]="...Âm thanh này là?",
    ["aside11065501"]="Đúng rồi, chính là chỗ này... chỉ cần đi tiếp về phía trước, nó sẽ xuất hiện thôi...",
    ["aside11065502"]="...Rốt cuộc là ai đang nói thế?",
    ["aside11065601"]="Ở đây sao lại xuất hiện Khe Nứt Thời Gian? Đợi đã, hình như có động tĩnh...",
    ["aside11065701"]="Cẩn thận... Khe nứt đang không ngừng nhả ra quái vật...",
    ["aside11065801"]="Đừng buông lỏng cảnh giác, chúng lại đến rồi...",
    ["aside11065802"]="Cậu rốt cuộc là...?",
    ["aside11065901"]="Tốt, cậu làm tốt lắm... Nếu muốn tìm thấy ta, hãy đến trước bia mộ...",
    ["aside11066001"]="Cuối cũng cũng gặp rồi, Nhà Thám Hiểm trẻ tuổi...",
    ["aside11066101"]="Giờ có thể dọn dẹp dây leo rồi!",
    ["aside11066201"]="Chúng ta đã gặp nhau rồi, Nhà Thám Hiểm trẻ tuổi...",
    ["aside11066301"]="Ồ...",
    ["aside11066401"]="Được rồi, mau đưa cho Katrina!",
    ["aside11066501"]="Thật là... làm phiền cậu quá.",
    ["aside11066601"]="Chúng ta đã gặp nhau rồi, Nhà Thám Hiểm trẻ tuổi...",
    ["aside11066701"]="...Người thừa kế huyết mạch Odin, cậu làm tốt lắm...",
    ["aside11070101"]="Kiến trúc hùng vĩ nhất... chắc là ở đây!",
    ["aside11070102"]="Mau đưa cho cô gái ấy nhìn xem!",
    ["aside11070201"]="Thảo Dược Đỏ Tía mọc gần cung điện... Mấy thứ đằng trước hình như là nó?",
    ["aside11070301"]="Bông hoa lam nhạt mọc ở góc thành phía Tây Nam... chắc là thứ này rồi!",
    ["aside11070401"]="Grum---",
    ["aside11070402"]="Tiêu rồi, bị đám quái vật ở gần phát hiện rồi!",
    ["aside11070501"]="Cuối cùng chỉ còn nước suối trong công viên Hoa Thanh Bình...",
    ["aside11070601"]="Được rồi, cứ giao cho cô hầu gái ấy đi!",
    ["aside11070701"]="Lớp đất dưới bụi hoa hình như có vẻ tơi xốp...",
    ["aside11070801"]="Nếu đoán không lầm thì đúng là nơi này rồi!",
    ["aside11070901"]="Cẩn thận... Hơi thở của quái vật trở nên mạnh hơn rồi!",
    ["aside11071001"]="Đúng rồi, chính là chỗ này...",
    ["aside11071101"]="Ở đây, ta còn nhớ mà...",
    ["aside11071201"]="...Tại sao lại thế này?",
    ["aside11071301"]="Đợi đã, đừng giết hắn!",
    ["aside11071401"]="Mấy kệ sách này trông có vẻ thích hợp để giấu giấy tờ...",
    ["aside11071501"]="Đặt xuống... Đặt xuống!",
    ["aside11071502"]="Tiêu rồi, có quái vật đang canh gác!",
    ["aside11071601"]="Đi chỗ khác tìm xem.",
    ["aside11071701"]="...Đây là?!",
    ["aside11071801"]="Mấy tờ giấy kẹp trong cuốn sách này nhìn có vẻ kỳ lạ...",
    ["aside11071901"]="Thật là may mắn, tiếp tục tìm kiếm xung quanh!",
    ["aside11072001"]="...Hình như có thứ gì rơi trên đất?",
    ["aside11072101"]="Nhiêu đây chắc đã đủ rồi, mau đưa cho Cassius xem!",
    ["aside11072201"]="Đi chỗ khác tìm xem.",
    ["aside11072301"]="Được rồi, đem về cho Cassius đi!",
    ["aside11072401"]="Odin ơi... Rốt cuộc bọn ta đã phạm phải tội gì chứ...!",
    ["aside11072501"]="Được rồi, đem mấy thứ này đặt trước tượng Kỵ Sĩ thử xem!",
    ["aside11072601"]="Đây chính là kho binh khí. Vậy, thứ có thể đại diện cho vinh quang của Kỵ Sĩ là...",
    ["aside11072701"]="Được rồi, mau đem cái này đặt trước tượng Kỵ Sĩ thử xem!",
    ["aside11072801"]="Cái này... thành công rồi sao? Quay về xem thử!",
    ["aside11072901"]="Nếu đoán không lầm thì đúng là nơi này rồi!",
    ["aside11073001"]="Tạm được rồi, lấy chút máu hiến cho Kỵ Sĩ này đi!",
    ["aside11073101"]="Được rồi, hãy đọc câu thơ mở đầu cho tượng Kỵ Sĩ nghe đi!",
    ["aside11073201"]="...Không thể tin được, thực sự không thể tin được!",
    ["aside11073301"]="Đợi đã,phía trước là...?",
    ["aside11073401"]="...Này, cậu đó, lại đây!",
    ["aside11073501"]="Được rồi, gần đây vẫn còn một bộ...",
    ["aside11073601"]="Đi nơi khác thử xem.",
    ["aside11073701"]="Đã xong, quay về báo cáo thôi!",
    ["aside11073801"]="Được rồi, nhiều thế này chắc đủ rồi.",
    ["aside11073901"]="...Miếng cơm của ta... lại bị cướp mất rồi sao?",
    ["aside11074001"]="Đồ đáng chết, chết cũng đáng!",
    ["aside11074101"]="Vậy, nhờ cả vào cậu nhé!",
    ["aside11074201"]="Lạ thật, trình tự thao tác chắc chắn không sai mà...",
    ["aside11074202"]="Tóm lại, mau báo cáo tình hình cho Darrens đi!",
    ["aside11074301"]="Cái nồi hơi còn lại... chắc là cái này nhỉ?",
    ["aside11074401"]="Ai? Lại dám trộm đồ... không muốn sống nữa sao?!",
    ["aside11074402"]="Tiêu rồi!",
    ["aside11074501"]="Được rồi, mau báo cáo tình hình cho Darrens đi!",
    ["aside11074601"]="Đây rốt cuộc là chuyện gì...?",
    ["aside11074701"]="...Đợi đã, sao không thấy vua Schmidt đâu nữa?!",
    ["aside11074801"]="Cứu với... Cứu ta với!! Ta bị bao vây rồi... Mau tìm ta!",
    ["aside11074901"]="Trong cánh cửa này hình như có tiếng gì...?",
    ["aside11075001"]="Phù, cuối cùng đã tự do rồi... Ta phải báo thù, báo thù!!",
    ["aside11075101"]="Đây không phải vua Schmidt... Rốt cuộc ngài ấy ở đâu?",
    ["aside11075201"]="Cứu với... Cứu ta với!! Ta bị bao vây rồi... Mau tìm ta!",
    ["aside11075301"]="Phù, cuối cùng đã tự do rồi... Ta phải báo thù, báo thù!!",
    ["aside11075401"]="Đây không phải vua Schmidt... Rốt cuộc ngài ấy ở đâu?",
    ["aside11075501"]="Cứu với... Cứu ta với!! Ta bị bao vây rồi... Mau tìm ta!",
    ["aside11075601"]="Phù, cuối cùng đã tự do rồi... Ta phải báo thù, báo thù!!",
    ["aside11075701"]="Đây không phải vua Schmidt... Rốt cuộc ngài ấy ở đâu?",
    ["aside11075801"]="Cứu với... Cứu ta với!! Ta bị bao vây rồi... Mau tìm ta!",
    ["aside11075901"]="Mau, mau đưa ta đi... Ta không muốn ở lại đây một phút nào nữa!",
    ["aside11076001"]="...Cảm giác kỳ lạ này... nghĩa là sao?",
    ["aside11076101"]="Phía trước chính là... tàn ảnh của Nữ Thần?",
    ["aside11076201"]="Nữ Thần biến mất rồi? Đi chỗ khác tìm xem.",
    ["aside11076301"]="Nữ Thần lại biến mất rồi... Mau đi xung quanh tìm xem.",
    ["aside11076401"]="Nhiêu đây chắc được rồi, quay về tìm vua Schmidt thôi!",
    ["aside11076501"]="...Phía trước là...?!",
    ["aside11076601"]="Đây là... quay về Thời-Không thực tại rồi sao?",
    ["aside11076602"]="Mau báo cáo tình hình điều tra được cho Rockley, giáo quan Hội Eden biết đi.",
    ["aside11076701"]="Mau bảo vệ người dân sơ tán! Các Kỵ Sĩ, hãy thể hiện dũng khí của các cậu!",
    ["aside11076702"]="...Là người của Đoàn Kỵ Sĩ!",
    ["aside11076801"]="Đợi đã, bên cạnh vẫn còn một chỗ...",
    ["aside11076901"]="Được rồi, đi tìm những người dân cơ cực đi!",
    ["aside11077001"]="Đánh hay lắm, Nhà Thám Hiểm!",
    ["aside11077101"]="Đây là... quay về Thành Cổ của Thời-Không lúc đó?",
    ["aside11077102"]="Tóm lại, mau đem Cát Thời Gian trả lại cho Fulkyn.",
    ["aside11077201"]="...Người thừa kế huyết mạch Odin, cậu làm tốt lắm...",
    ["aside11077301"]="Đây chắc là dấu chân của vua Schmidt, đi theo thử xem!",
    ["aside11077401"]="Chắc vua Schmidt rất sợ hãi, phải mau chóng tìm thấy ngài ấy!",
    ["aside11077501"]="Ơ... Lẽ nào anh ta đã chạy đến tầng tiếp theo?",
    ["aside11080101"]="Đây là... Thẻ Nhập Cảnh?",
    ["aside11080102"]="Chẳng lẽ vừa rồi là đồ lữ khách bị mất...",
    ["aside11080201"]="Cuộc tranh chấp giữa thương đội và bọn cướp đã xảy ra ở đây, lên trước xem thử!",
    ["aside11080301"]="Có vẻ có người đang vận chuyển vật nặng... chẳng lẽ là bọn cướp?",
    ["aside11080401"]="G.W... G.W.?! Chẳng lẽ là băng nhóm của Gotty!",
    ["aside11080501"]="Cái xác này là sao vậy?",
    ["aside11080601"]="Không được, tiếp tục nhìn thì... (Ọc...)",
    ["aside11080701"]="Lạ thật, quanh đây chẳng thấy ai giống bác sĩ cả.",
    ["aside11080702"]="Nhưng cảm giác quen thuộc này...",
    ["aside11080801"]="…Đây là?",
    ["aside11080901"]="Phía tây bắc sa mạc... đi đến đó xem thử đi!",
    ["aside110810001"]="…",
    ["aside11081001"]="Haiz, đúng là cái xác vẫn biết nghe lời hơn.",
    ["aside110810101"]="Dừng tay! Các ngươi đang làm gì đấy?",
    ["aside110810201"]="Aaron Milton - ra khỏi ngay!",
    ["aside110810301"]="Bây giờ cầm vũ khí lên, chứng minh thực lực mình đi!",
    ["aside110810401"]="Tốt lắm, nhưng còn lâu mới kết thúc.",
    ["aside110810501"]="Có chút tài năng đấy, vậy những thứ tiếp theo thì sao?",
    ["aside110810601"]="Sẵn sàng tiếp nhận thí luyện cuối cùng đi!",
    ["aside110810701"]="Ừm. Xem ra không thể nhìn mặt bắt hình dong...",
    ["aside110810801"]="Được rồi, bây giờ hãy đứng ở chính giữa địa điểm để kiểm tra sức chiến đấu.",
    ["aside110810901"]="...Đây, đây là sức mạnh của ta sao?!",
    ["aside110810902"]="Ừm. Bước đầu phù hợp với dự đoán. Bước vào lần kiểm tra tiếp theo.",
    ["aside110811001"]="Làm sao mà... sức mạnh lại không ngừng tuôn ra từ cơ thể vậy?!",
    ["aside110811002"]="Đúng vậy, không sai... xem ra sức mạnh hạng trung không phải là vấn đề...",
    ["aside11081101"]="Được rồi, mau đưa cho Wallace đi!",
    ["aside110811101"]="…Ôi! Đầu ta, đau quá... Có dừng lại một chút được không...",
    ["aside110811102"]="Ồ? Như vậy không sao chứ? Trừ phi là người ghép cặp hiếm hoi...",
    ["aside110811201"]="Rất tốt, vượt qua kiểm tra rồi. Vậy Arnold, tiếp theo sẽ nhờ vả ngươi.",
    ["aside110811301"]="Nhà Thám Hiểm, mau lùi lại!",
    ["aside110811401"]="Ối, cục cục...",
    ["aside110811501"]="...Người thừa hưởng dòng máu của Odin, ngươi đã làm rất tốt...",
    ["aside11081201"]="Nhân lúc này, cho chúng thấy sự lợi hại đi!",
    ["aside11081301"]="Ngươi, các ngươi đang muốn làm gì?",
    ["aside11081401"]="Hừm, có mùi đáng ngờ.",
    ["aside11081501"]="Đã xác nhận Thẻ Thông Hành - Chào mừng đến với Al De Baran!",
    ["aside11081601"]="Được rồi, bây giờ không phải là lúc để vui chơi...",
    ["aside11081602"]="Hãy đến địa điểm giao dịch được trong thư để xem đi!",
    ["aside11081701"]="Chính là ở đây. Khoan đã, đó là gì?!",
    ["aside11081801"]="Có tổng cộng 3 con quái vật canh gác, phải cẩn thận.",
    ["aside11081901"]="Nguy rồi, đã bị phát hiện!",
    ["aside11082001"]="Lạ thật, vẫn có 1 con quái vật tuần tra không xuất hiện...",
    ["aside11082002"]="Không hay rồi, số thùng hàng đó!",
    ["aside11082101"]="Đáng ghét, như vậy sẽ không có cách nào điều tra được...",
    ["aside11082201"]="Dầu máy... chẳng lẽ do con quái vật máy chạy thoát làm cháy sao?",
    ["aside11082202"]="Được lắm, bắt đúng kẻ rồi... xem ta giải quyết ngươi thế nào đi!",
    ["aside11082301"]="Xảy ra chuyện gì vậy... quái vật máy đi phóng hỏa sao?!",
    ["aside11082401"]="Phù, cảm ơn ngươi đã giúp đỡ...",
    ["aside11082501"]="Đây rốt cuộc là chuyện gì...?",
    ["aside11082601"]="...!!!",
    ["aside11082701"]="Ấy? Sao lại có thứ này chứ?",
    ["aside11082801"]="Được rồi, đưa nó cho Công Hội Thuật Sĩ Luyện Kim xem thử đi!",
    ["aside11082901"]="Hiện trường vụ cháy đầu tiên là ở đây.",
    ["aside11083001"]="Không còn thứ gì trong ​​đống đổ nát này nữa, tìm chỗ khác xem sao!",
    ["aside11083101"]="Xong rồi! Đến hiện trường vụ cháy tiếp theo thôi.",
    ["aside11083201"]="Thật may mắn, xem cái xác bên cạnh đi.",
    ["aside11083301"]="...Crắc, cạch...!",
    ["aside11083401"]="Không ngờ vẫn còn những xác máy chưa bị tiêu hủy hoàn toàn...",
    ["aside11083402"]="Đi xem thứ khác đi.",
    ["aside11083501"]="Còn sót lại một xác quái vật cuối cùng, qua đó xem thử đi!",
    ["aside11083601"]="...Crắc, cạch...!",
    ["aside11083701"]="Xong rồi, mau đưa chip cho Raymond đi!",
    ["aside11083801"]="Mã số thành viên RX-786D",
    ["aside11083802"]="Nhận được liên lạc từ Raymond Alberto của Công Hội Thuật Sĩ Luyện Kim.",
    ["aside11083901"]="Đứng lại! Không được phép đi qua đây!",
    ["aside11084001"]="Từ bây giờ, phải cẩn thận mọi lúc...",
    ["aside11084101"]="Tốt lắm. Bây giờ hãy đi theo sát ta.",
    ["aside11084201"]="Đây là phía dưới Tháp Chuông. Chúng ta phải đi về phía nam...",
    ["aside11084301"]="Con đường phía trước lại bị quái vật chặn lại rồi, phải dọn sạch trước.",
    ["aside11084401"]="Tốt lắm. Hãy tiếp tục đi theo ta.",
    ["aside11084501"]="Chà, những con quái vật này thật rắc rối...",
    ["aside11084601"]="Tốt lắm. Sắp đến rồi.",
    ["aside11084701"]="Nguy rồi, có quái vật máy canh giữ!",
    ["aside11084801"]="Đủ rồi! Vẫn chưa thể diệt nó được.",
    ["aside11084901"]="Dường như có một cuốn sách đang mở ở bên đó.",
    ["aside11085001"]="Lanster Milton?! Hóa ra là hắn...",
    ["aside11085101"]="Ở đây... sao toàn xác thối quái vật vậy?",
    ["aside11085102"]="Công ty không tìm được một nghĩa trang tốt hơn sao...",
    ["aside11085201"]="Cuối cùng thì cũng sạch sẽ. Phải tìm được trước khi mặt trời lặn...",
    ["aside11085301"]="Không, không phải cái này...",
    ["aside11085401"]="Cũng không phải. Phải tăng tốc lên.",
    ["aside11085501"]="...Đáng ghét, rốt cuộc ở đâu chứ!",
    ["aside11085601"]="Cuối cùng... là ở đây rồi.",
    ["aside11085701"]="Xì!",
    ["aside11085801"]="Không hay rồi, quái vật xuất hiện ngày càng nhiều. Phải mau lên!",
    ["aside11085901"]="Phù... bước đầu tiên, vẽ một trận pháp luyện kim trên chai...",
    ["aside11086001"]="Bước thứ hai, đặt Mảnh Trái Tim Ymir vào trong chai...",
    ["aside11086101"]="Bước cuối cùng, đặt miệng chai vào miệng tử thi...",
    ["aside11086201"]="Aaron, mong em tha thứ cho anh...",
    ["aside11086202"]="Anh... anh phải lấy linh hồn của em.",
    ["aside11086301"]="Ồ, những quái vật máy này đều đã được vẽ xong trận luyện kim rồi...",
    ["aside11086302"]="Tiếp theo chỉ cần đặt Mảnh Trái Tim Ymir vào đó.",
    ["aside11086401"]="Két... crắc... cạch...!!",
    ["aside11086501"]="...Ài, lại thất bại rồi sao.",
    ["aside11086502"]="Thí nghiệm số 84, tất cả tùy thuộc vào ngươi rồi.",
    ["aside11086601"]="Két, crắc... cạch...!!",
    ["aside11086701"]="...Nên nói gì đây. Nói rằng ta tê dại vì kết quả này sao?",
    ["aside11086801"]="Xí xí... rắc!!",
    ["aside11086901"]="Đáng ghét, rốt cuộc phải làm sao để dung hợp linh hồn vào cơ thể chứ?",
    ["aside11086902"]="Khoan đã, không chừng cuốn sách đó...!",
    ["aside11087001"]="Đúng rồi, chính là nó! Nhưng món đồ yêu thích...",
    ["aside11087002"]="Món đồ Aaron yêu thích nhất khi còn sống là gì?",
    ["aside11087101"]="Món đồ hứa hẹn... hay một món đồ chứa đựng những kỉ niệm...",
    ["aside11087102"]="Có lẽ có thể thử con búp bê máy cú đó?",
    ["aside11087201"]="Rốt cuộc anh ấy đi đâu mỗi đêm chứ, lần này chúng ta phải làm rõ!",
    ["aside11087301"]="Chính là nó, tìm men theo dấu vuốt đi.",
    ["aside11087401"]="...Phía trước là?",
    ["aside11087501"]="Chuyện này, là sao chứ? Tại sao lại có thi thể xuất hiện?",
    ["aside11087601"]="Nguyên nhân cái chết của những người này... chẳng lẽ là?!",
    ["aside11087701"]="Ô, anh... anh...",
    ["aside11087801"]="Hừm, để cho tên đó thoát mất rồi...",
    ["aside11087901"]="Không sai được, nhất định hắn ở gần đây!",
    ["aside11088001"]="Xong rồi, mau đưa cho Raymond đi!",
    ["aside11088101"]="Ơ? Raymond và Langston đi đâu rồi?",
    ["aside11088201"]="…Đây là! Đã xảy ra chuyện gì vậy?",
    ["aside11088301"]="Khoan đã! Đừng vội giết hắn ta...",
    ["aside11088401"]="Nơi này rất nguy hiểm, hãy theo sát ta...",
    ["aside11088501"]="(Gào thét...)",
    ["aside11088502"]="...Đây, đây là?!",
    ["aside11088601"]="...Thứ trên mặt đất là?",
    ["aside11088701"]="Tìm ra rồi, trang thứ hai!",
    ["aside11088801"]="Rào... xí...!",
    ["aside11088901"]="Tiến sĩ nói Quái Đồng Hồ đã tấn công hắn ta...",
    ["aside11088902"]="Không chừng mảnh thứ ba nằm trên người Quái Đồng Hồ?",
    ["aside11089001"]="Gom đủ rồi, mang đến cho tiến sĩ đi!",
    ["aside11089101"]="...Chuyện này, làm sao có thể chứ!",
    ["aside11089201"]="Hộp gỗ chạm khắc... chẳng lẽ là nó?",
    ["aside11089301"]="Ồ... tiết kiệm nhiều tiền như vậy chắc là đủ rồi nhỉ?",
    ["aside11089401"]="~Phù. Bây giờ chỉ còn lại một thứ cuối cùng...",
    ["aside11089501"]="…Ý? Phía trước là?",
    ["aside11089601"]="Anh trai cứ thích lo lắng... rõ ràng nói những lời này trực tiếp là được mà.",
    ["aside11089701"]="Ồ, tiếp theo là ảnh gia đình...",
    ["aside11089801"]="Được rồi! Đưa nó cho anh trai ngươi đi. Cũng không biết lần này anh ấy sẽ ở lại được bao lâu...",
    ["aside11089901"]="Khoan đã, người phía trước là anh trai! Vậy người còn lại là ai?",
    ["aside11090101"]="Đúng vậy, là ở đây.",
    ["aside11090201"]="Nhìn xem, dưới đất hình như có dấu gì đó.",
    ["aside11090301"]="...Vật lấp lánh bên cạnh là?",
    ["aside11090401"]="...Điều này thật sự vô cùng khả nghi.",
    ["aside11090501"]="...Lạ thật, những ngọn lửa này?",
    ["aside11090601"]="…?",
    ["aside11090701"]="Chuyện này... tại sao lại không có ích?!",
    ["aside11090801"]="!!!",
    ["aside11090802"]="...Nhà Thám Hiểm, hãy dừng tay.",
    ["aside11090901"]="Ơ... ngọn... ngọn lửa vô tận...",
    ["aside11091001"]="Ô... đôi cánh màu đỏ... che bầu trời...",
    ["aside11091101"]="...Tiến triển thế nào rồi?",
    ["aside11091201"]="...Mấy thứ dưới đất đó?",
    ["aside11091301"]="Tìm được rồi, mấy thứ này chắc cũng vậy!",
    ["aside11091401"]="Thật may mắn...",
    ["aside11091501"]="Chút chít...!!",
    ["aside11091601"]="Xong, hãy về giao cho Hardy!",
    ["aside11091701"]="Tiếp theo là Đội Thuyền Đóng Băng...",
    ["aside11091801"]="Được rồi, hãy giao tấm ảnh này cho Bronte!",
    ["aside11091901"]="Bây giờ, hãy đến phục mệnh Alexia!",
    ["aside11092001"]="Nhà Thám Hiểm, ta có thể nói chuyện với ngươi được không?",
    ["aside11092101"]="Trước tiên, chúng ta hãy bắt đầu từ đây.",
    ["aside11092201"]="Cuối cùng... cuối cùng! Ta cứ tưởng lần này chết chắc rồi chứ hi hi...",
    ["aside11092301"]="...Lần này bình yên rồi.",
    ["aside11092401"]="Ở đây tuy có một con đường nhỏ, nhưng với thể hình của Tộc Rồng thì chắc không qua được.",
    ["aside11092501"]="Đầm nước này sâu không thấy đáy, không có vẻ sẽ nối với hang ngầm.",
    ["aside11092601"]="Ở đây... khoan đã, mùi này là?!",
    ["aside11092701"]="Nhìn kìa! Phía dưới có gì kìa!",
    ["aside11092801"]="...Đây, đây là?!",
    ["aside11092901"]="Mau nhìn số trứng rồng này đi!",
    ["aside11093001"]="Chuyện này…!!",
    ["aside11093101"]="(Gào thét...)",
    ["aside11093102"]="Nguy rồi, quái vật bị đánh thức rồi!",
    ["aside11093201"]="...Alexia đại nhân! Không hay rồi!",
    ["aside11093301"]="Các vị... sự an nguy của Đảo Comodo hãy trông cậy vào chúng tôi!",
    ["aside11093401"]="Cẩn thận, mấy tên kia xông đến rồi!",
    ["aside11093501"]="Lại nữa, sao đến mãi vậy...",
    ["aside11093601"]="Đợi đã, gần đây hình như có động tĩnh gì đấy...",
    ["aside11093701"]="Cảm ơn ngươi, Nhà Thám Hiểm, lần này đã tạm an toàn rồi.",
    ["aside11093801"]="Nhờ cả vào ngươi đấy.",
    ["aside11093901"]="(Gào thét...)",
    ["aside11094001"]="Cứu với... có ai nghe không?!",
    ["aside11094101"]="Xong, hãy đến phục mệnh Sciaia!",
    ["aside11094201"]="Ồ... Ừm...",
    ["aside11094301"]="...Đứng lại! Các ngươi muốn gì?!",
    ["aside11094401"]="...Khoan đã, ngươi vừa nói gì?",
    ["aside11094501"]="Nhà Thám Hiểm kia, ngươi đến rồi.",
    ["aside11094601"]="Ôi, Nhà Thám Hiểm, chúng ta gặp lại nhau rồi, hi hi...",
    ["aside11094701"]="Grantham, cuối cùng ngươi cũng đã xuất hiện!",
    ["aside11094801"]="Đồ khốn, lấy mạng đền mạng.",
    ["aside11094901"]="Hi hi, tìm, được, rồi...",
    ["aside11095001"]="Ôi ôi, ngươi đang làm gì vậy?",
    ["aside11095101"]="Tên kia, ngươi hết đường trốn rồi...",
    ["aside11095201"]="Hi hi, ngươi thật là... quá tuyệt!",
    ["aside11095301"]="Nhà Thám Hiểm, cuối cùng ngươi đã đến.",
    ["aside11095401"]="Xong rồi, mau đưa cho Vendara.",
    ["aside11095501"]="Vậy, các vị... mong chiến thần Tyr sẽ phù hộ cho chúng ta!",
    ["aside11095601"]="Ha, địa điểm quen thuộc, tâm trạng thì khác!",
    ["aside11095701"]="Được rồi, giờ sẽ vào vấn đề chính.",
    ["aside11095801"]="Crắc... cạch...",
    ["aside11095901"]="...(Hít một hơi thật sâu).",
    ["aside11096001"]="Nhà Thám Hiểm, hãy dừng bước!",
    ["aside11096101"]="Cạch... a...",
    ["aside11096102"]="Cẩn thận, chúng lại đến rồi!",
    ["aside11096201"]="Bây giờ, hãy đặt thịt cá còn lại ở đây!",
    ["aside11096301"]="Cạch... a...",
    ["aside11096401"]="Nhưng trải qua bao nhiêu lần rồi, những gã này vẫn khiến người ta không thể thích ứng được.",
    ["aside11096501"]="Crắc... cạch...",
    ["aside11096601"]="...Nhà Thám Hiểm, đến đây!",
    ["aside11096701"]="(Gào thét...)",
    ["aside11096702"]="Nghe... nó đã trúng bẫy!",
    ["aside11096801"]="Ô... khụ, khụ...",
    ["aside11096901"]="(Thì thầm) Đến phía trước cầu, không thể bị phát hiện...",
    ["aside11097001"]="...Kết thúc rồi. Hãy đến báo cáo Alexia.",
    ["aside11097101"]="...Người kế thừa huyết mạch Odin, ngươi làm tốt lắm...",
    ["aside11141001"]="Chuyện này... nên đi đâu để tìm Phù Thủy đây?",
    ["aside11141101"]="Quên hỏi vị trí chính xác của Phù Thủy... khu rừng cũng rộng quá nhỉ?!",
    ["aside11141201"]="Đợi đã, phía trước đó là...?!",
    ["aside11141301"]="... Dừng tay!!",
    ["aside11141401"]="... Xin, xin ngươi đấy...",
    ["aside11141501"]="Những tinh thể này... chẳng lẽ là?!",
    ["aside11141601"]="Xin ngươi, hãy giúp chúng ta!",
    ["aside11141701"]="Úi úi... đau, đau...",
    ["aside11141801"]="Ai da, giết người rồi... giết người rồi!!",
    ["aside11141901"]="… Đây là?!",
    ["aside11142001"]="Xong rồi, còn Giọt Sương Mát Lạnh.",
    ["aside11142101"]="Bây giờ, hãy đưa chúng đến cho Phù Thủy đi!",
    ["aside11142201"]="Xin hãy đi đi, ta đã quyết định rồi...",
    ["aside11142301"]="Cây mẹ, lần này đến lượt chúng ta bảo vệ người...",
    ["aside11142401"]="Nguy rồi, không kịp nữa rồi!",
    ["aside11142501"]="Thủ lĩnh... xảy ra chuyện gì vậy?!",
    ["aside11142601"]="Ngươi, chẳng lẽ là...!",
    ["aside11142701"]="Chuyện này, phải nói cho Tatanka!",
    ["aside11142801"]="... Các ngươi... đã làm gì ta rồi?!",
    ["aside11142901"]="Bây giờ bắt đầu nghiệm chứng đi. Đầu tiên, cho bối mẫu lân quang vào hồ nước.",
    ["aside11143001"]="Không đúng sao. Vậy thì nhỏ máu của Khỉ Choco vào đi.",
    ["aside11143101"]="Thì ra là vậy, lần này đổi ta thử.",
    ["aside11143201"]="Đây là…!",
    ["aside11143301"]="Chính là nơi này rồi.",
    ["aside11143401"]="!!!",
    ["aside11143501"]="Rất bất thường, đúng không.",
    ["aside11143601"]="Đây là Rừng Kalala. Vậy tiếp theo...",
    ["aside11143701"]="… Con người? Ơ, cảm ơn...",
    ["aside11143801"]="…!!!",
    ["aside11143901"]="Này... chuyện không phải như những gì các ngươi nghĩ đâu!",
    ["aside11144001"]="... Những thứ này là!!",
    ["aside11144101"]="Két... cạch...",
    ["aside11144201"]="(Gào thét...!)",
    ["aside11144301"]="Xong rồi, đưa nó cho Phù Thủy đi.",
    ["aside11144401"]="Đừng, đừng đánh nữa... các ngươi mới là kẻ xâm nhập!",
    ["aside11144501"]="Thủ lĩnh hang động đến rồi... đợi đã, ngươi nhìn dấu vết đi!",
    ["aside11144601"]="Những dấu móng vuốt này, chắc chắn không phải của Quái Vật có thể hình bình thường...",
    ["aside11144701"]="... Liệu một sinh vật bình thường, thực sự có thể tạo ra những dấu vết như vậy sao?",
    ["aside11144801"]="A a a a...",
    ["aside11144901"]="... Nhà Thám Hiểm, cẩn thận!!",
    ["aside11145001"]="Đây là…!",
    ["aside11145101"]="Thế nào, không nên như vậy...",
    ["aside11145201"]="Không xong rồi... mau rút lui, mau rút lui!!!",
    ["aside11145301"]="Xảy ra chuyện gì thế?",
    ["aside11145401"]="Vòng cách ly... rốt cuộc chuyện này là sao?!",
    ["aside11145501"]="Cảm ơn... ta cứ nghĩ mình chết chắc rồi!",
    ["aside11145601"]="Nguy rồi, Tatanka gặp nguy hiểm!!",
    ["aside11145701"]="Chuyện gì thế, xảy ra chuyện gì vậy?",
    ["aside11145801"]="Gần đây hình như có động tĩnh gì đấy...",
    ["aside11145901"]="Đợi đã, vẫn chưa kết thúc...",
    ["aside11146001"]="... Những tiếng ầm vang này là?!",
    ["aside11146101"]="... Tìm thấy rồi! Mau tới gần ta đi!",
    ["aside11146201"]="… Ồ…",
    ["aside11146301"]="Khè khè...",
    ["aside11146401"]="Xong rồi, đưa nó cho Phù Thủy đi.",
    ["aside11146501"]="Nhà Thám Hiểm, mau tới xem vật chứa trong tay ta...",
    ["aside11146601"]="Cuối cùng ta đã biết sự thật về những thứ này rồi.",
    ["aside11146701"]="Tatanka... ngươi cũng đến rồi!",
    ["aside11146801"]="Được rồi, mang những thứ này đến cho Phù Thủy đi!",
    ["aside11146901"]="Các ngươi đang...",
    ["aside11147001"]="Bây giờ, hãy nghe ta nói.",
    ["aside11147101"]="Gì chứ, thì ra là người của mình!",
    ["aside11147201"]="Nhìn đi, chính là người đàn ông đó! Mau xử lý hắn đi!",
    ["aside11147301"]="Đủ rồi, đủ rồi~",
    ["aside11147401"]="Nhà Thám Hiểm, người tới đây một chút.",
    ["aside11147501"]="Phù... nguy hiểm quá.",
    ["aside11147601"]="Có lẽ chính là hai người đó.",
    ["aside11147701"]="Hầu nam và hầu gái của Hela... phải tìm được bọn họ.",
    ["aside11147801"]="Chính là hai người đó.",
    ["aside11147901"]="... Cuối cùng cũng rõ ràng rồi.",
    ["aside11148001"]="… Lạ thật.",
    ["aside11148101"]="Ha ha, chào hai người, đã chờ đây lâu rồi!",
    ["aside11148201"]="Với thực lực này mà cũng dám đột nhập vào địa bàn của ta?",
    ["aside11148301"]="Chào mừng đến với bữa tiệc! Đừng làm ta thất vọng đấy~",
    ["aside11148401"]="Ái chà, đối phó với Underling cũng gặp khó khăn sao?",
    ["aside11148501"]="Không xong rồi, không dùng được sức mạnh...",
    ["aside11148601"]="Với chừng này sức mạnh xem các ngươi gắng gượng được bao lâu.",
    ["aside11148701"]="Không được, dường như ngày càng yếu đi...",
    ["aside11148801"]="Xem ra, đã đến lúc kết thúc trận đấu rồi!",
    ["aside11148901"]="Dừng tay lại. Ai cho các ngươi lên?!",
    ["aside11149001"]="Nào, xem cái này.",
    ["aside11149101"]="Người giữ Thánh Vật đang ở phía trước, đi theo ta nào~",
    ["aside11149201"]="... Hela?!",
    ["aside11149301"]="Các ngươi đừng hòng được như ý!",
    ["aside11149401"]="Ấy... trận chiến đã dễ dàng hơn rồi?",
    ["aside11149501"]="Đợi đã, sức mạnh của ta... dường như khôi phục rồi?!",
    ["aside11149601"]="Chẳng lẽ là nhờ những Thuốc Thi Quỷ Mạnh đó...",
    ["aside11149701"]="... Ngươi đang lẩm bẩm gì vậy!!",
    ["aside11149801"]="Đừng vội... vẫn chưa kết thúc đâu!",
    ["aside11149901"]="… Nơi này là?!",
    ["aside11150001"]="... Trong đầu của Shibam.",
    ["aside11150101"]="Những thủ vệ Mê Cung này... làm phiền ngươi dọn dẹp nhé.",
    ["aside11150201"]="Đây chính là lối vào ký ức rồi.",
    ["aside11150301"]="Israel...",
    ["aside11150401"]="Đó là... Shibam?!",
    ["aside11150501"]="... Ta nghe tiếng ngươi rồi.",
    ["aside11150601"]="Ơ... a...",
    ["aside11150701"]="... Thầy ơi, cẩn thận!",
    ["aside11150801"]="... Chà, thật khiến người ta khó chịu.",
    ["aside11150901"]="... Thầy ơi, như vậy cũng được thật sao?",
    ["aside11151001"]="... Hừ, không ngờ chút vặt vãnh này ngươi cũng không chịu nổi.",
    ["aside11151101"]="Phía trước là... Hela?!",
    ["aside11151201"]="Ha ha ha, sức mạnh mới mẻ!",
    ["aside11151301"]="…",
    ["aside11151401"]="Những thủ vệ này, nhờ ngươi nhé.",
    ["aside11151501"]="Càng vào sâu trong Mê Cung, các thủ vệ càng mạnh...",
    ["aside11151601"]="Đây là lối vào ký ức giai đoạn hai của Shibam rồi.",
    ["aside11151701"]="… Tại sao…",
    ["aside11151801"]="Được rồi, mau cầm đi cho Laria ăn đi!",
    ["aside11151901"]="Sao có thể... sao có thể!",
    ["aside11152001"]="Chẳng lẽ đã quá muộn rồi sao...",
    ["aside11152101"]="Xin làm ơn... ta đang cạn kiệt kế sách rồi!",
    ["aside11152201"]="Hừ hừ…",
    ["aside11152301"]="… Cút!!",
    ["aside11152401"]="…",
    ["aside11152501"]="Những thủ vệ này... xem ra đã ở rất gần sự thật rồi.",
    ["aside11152601"]="Tới xem ký ức giai đoạn ba của Shibam đi.",
    ["aside11152701"]="Xin ngài hãy nghe ta nói...",
    ["aside11152801"]="Con đường phía trước bị quái vật chặn lại rồi, để ta...",
    ["aside11152901"]="Bên này, xin ngài hãy đi theo.",
    ["aside11153001"]="Yên tâm, ta sẽ xử lý ổn thỏa lũ Quái Vật này.",
    ["aside11153101"]="Có lẽ Đền Thần của Hela cách không xa nữa.",
    ["aside11153201"]="Ai dà, các ngươi là...?",
    ["aside11153301"]="... xiềng xích tươi đẹp, phải không?",
    ["aside11153401"]="…!",
    ["aside11153501"]="Cuối cùng…",
    ["aside11153601"]="Thầy giáo trả lại bức thư ta viết... chẳng lẽ?!",
    ["aside11153701"]="… Thầy giáo…",
    ["aside11153801"]="Đáng ghét. Lũ Quái Vật này chắn tầm nhìn của ta rồi...",
    ["aside11153901"]="Lần này thì nhìn rõ rồi. Chính là tên đó...",
    ["aside11154001"]="... Vậy mà nhàn nhã thật nhỉ.",
    ["aside11154101"]="…",
    ["aside11154201"]="Chuyện này... Mê Cung dường như đã thay đổi rồi?!",
    ["aside11154301"]="Đó chính là bản thể ý thức của Shibam.",
    ["aside11154401"]="Những chuỗi đó, dùng mật mã khóa vừa rồi có lẽ sẽ mở được...",
    ["aside11154501"]="Thầy ơi…",
    ["aside11154601"]="... Cuối cùng, cũng kết thúc rồi.",
    ["aside11154701"]="... Israel, đây là?!",
    ["aside11154801"]="Phù Thủy, sao ngươi...?",
    ["aside11154901"]="...Người kế thừa huyết mạch Odin, ngươi làm tốt lắm...",
    ["aside11155001"]="Ồ, chuyện này... nhưng W cũng...",
    ["aside11155101"]="Sức mạnh này... Lẽ nào là huyết mạch của Odin...",
    ["aside11160101"]="Người đó là...?",
    ["aside11160201"]="Philodis đại nhân?!",
    ["aside11160301"]="Sao lại như vậy?!",
    ["aside11160401"]="Chào mừng đến với Juno, Nhà Thám Hiểm!",
    ["aside11160501"]="Người đó chính là Andre?",
    ["aside11160601"]="... Hóa ra là vậy, ta hiểu rồi.",
    ["aside11160701"]="Từng này chắc đủ rồi chứ?",
    ["aside11160801"]="Cảm ơn đã chiếu cố!",
    ["aside11160901"]="Đã xong!",
    ["aside11161001"]="Cảm, cảm ơn... Ta đỡ hơn nhiều rồi.",
    ["aside11161101"]="Ngươi chẳng phải là... vừa nãy?!",
    ["aside11161201"]="Khụ... Cảm ơn, Nhà Thám Hiểm tốt bụng.",
    ["aside11161301"]="Cảm ơn ngươi, Nhà Thám Hiểm! Giúp đỡ ta được việc lớn!",
    ["aside11161401"]="Đau, đau quá!",
    ["aside11161501"]="Nhanh lên, vết thương của họ không thể chậm trễ được!",
    ["aside11161601"]="Nhẹ thôi... cái lưng của ta...",
    ["aside11161701"]="Ở đây, ở đây!",
    ["aside11161801"]="Hu... hu hu...",
    ["aside11161901"]="Rất tốt, đây là người cuối cùng rồi đúng không?",
    ["aside11162001"]="Làm tốt lắm, Nhà Thám Hiểm!",
    ["aside11162101"]="... Quả nhiên ngươi rất lợi hại.",
    ["aside11162102"]="Andre?!",
    ["aside11162201"]="Dừng, dừng! Không được đánh nữa!",
    ["aside11162301"]="Đúng, đúng, chính là như vậy!",
    ["aside11162401"]="Đứng lại! Không được bước tiếp nữa!",
    ["aside11162501"]="Ai ở bên đó thế?!",
    ["aside11162601"]="... Sao vậy? Là người?",
    ["aside11162701"]="Hình như đã giải quyết cũng tàm tạm rồi.",
    ["aside11162801"]="Được! Tiếp theo...",
    ["aside11162901"]="Cảm, cảm ơn... Đúng là ngàn cân treo sợi tóc.",
    ["aside11163001"]="Đây là... gì vậy...?!",
    ["aside11163101"]="... Sao lại mạnh vậy nhỉ...?",
    ["aside11163201"]="Quả nhiên ngươi không làm ta thất vọng.",
    ["aside11163301"]="Tốt lắm... chúng ta đi ngay thôi!",
    ["aside11163401"]="Có vẻ như có thể đi vào từ đây...?",
    ["aside11163501"]="... Đây là?!",
    ["aside11163601"]="... Khụ khụ...",
    ["aside11163701"]="Mô hình này...?!",
    ["aside11163801"]="Vậy... chúng ta gặp lại sau nhé, Nhà Thám Hiểm.",
    ["aside11163901"]="Cuối cùng ngươi cũng về rồi!",
    ["aside11164001"]="... Cảm ơn ngươi đã giữ lời, Nhà Thám Hiểm.",
    ["aside11164101"]="... Lẽ nào đây là?!",
    ["aside11164201"]="Cảm ơn ngươi đã ra tay trợ giúp, Nhà Thám Hiểm.",
    ["aside11164301"]="Hì hì...",
    ["aside11164302"]="Giọng nói này là...",
    ["aside11164401"]="Đã thu thập xong rồi đúng không?",
    ["aside11164501"]="Đã kiểm kê xong tất cả hàng hóa, cảm ơn rất nhiều!",
    ["aside11164601"]="Ây da, đây chẳng phải là Philodis đại nhân sao?",
    ["aside11164701"]="Vậy, đi theo ta nào, Nhà Thám Hiểm!",
    ["aside11164801"]="... Ây da, đây không phải điềm báo tốt.",
    ["aside11164901"]="Cuối cùng cũng đã sửa xong rồi.",
    ["aside11165001"]="Làm ơn... Hãy ráng thêm một chút nữa!",
    ["aside11165101"]="Cố lên! Sắp xong rồi!",
    ["aside11165201"]="Cảm giác này... lại đến rồi?!",
    ["aside11165202"]="Này! Mau tránh ra!",
    ["aside11165301"]="Ta ở đây, Nhà Thám Hiểm!",
    ["aside11165401"]="Các ngươi làm sao vậy?!",
    ["aside11165501"]="Cuối cùng các ngươi cũng về rồi!",
    ["aside11165601"]="Đúng vậy... chính là cái này.",
    ["aside11165701"]="Tốt lắm, tất cả các công việc chuẩn bị đã hoàn tất!",
    ["aside11165801"]="Một lũ vô dụng!",
    ["aside11165901"]="... Xằng bậy!",
    ["aside11166001"]="... Ha ha, giãy chết.",
    ["aside11166101"]="Ta khuyên ngài đừng ngoan cố chống cự nữa, Khayr các hạ.",
    ["aside11166201"]="... Ngươi, ngươi sao vậy, Thủ Hộ?!",
    ["aside11166301"]="Ta nói không sai chứ?",
    ["aside11166401"]="... Chúng ta phải đi thôi, Nhà Thám Hiểm.",
    ["aside11166501"]="Đứng lại!",
    ["aside11166601"]="... Cuối cùng đã gặp ngươi rồi, người kế thừa huyết mạch Odin.",
    ["aside11166701"]="... Đây không giống đòn tấn công quái vật thông thường.",
    ["aside11166801"]="Rốt cuộc những người này... đang làm gì vậy?",
    ["aside11166901"]="Chữ viết này... hình như ta đã thấy ở đâu rồi.",
    ["aside11167001"]="Ta chưa bao giờ phê duyệt cho họ sản xuất Android mẫu này!",
    ["aside11167101"]="Sao lại vậy nhỉ...?!",
    ["aside11167201"]="Rốt cuộc đây là gì...",
    ["aside11167301"]="... Đây chính là vũ khí bí mật chống lại Công Ty Reagan Baylor?!",
    ["aside11167401"]="... Nhà Thám Hiểm? Nhà Thám Hiểm!",
    ["aside11167402"]="... Ngươi làm sao vậy?",
    ["aside11167501"]="Đợi đã! Có chuyện!",
    ["aside11167601"]="... Được rồi! Tiếp tục tiến lên!",
    ["aside11167701"]="Cẩn thận! Phía trước có nhóm Người Bảo Vệ Di Tích đang chặn đường phía trước!",
    ["aside11167801"]="Hừm... nguy hiểm quá...",
    ["aside11170101"]="S-1028L...số lô này...?",
    ["aside11170201"]="Thông minh như bạn thì chắc chắn bạn đã nhìn thấy manh mối, phải không?",
    ["aside11170301"]="Đúng, chính là nó.",
    ["aside11170401"]="Chắc là gần xong rồi phải không?",
    ["aside11170501"]="……Huh? Tôi không ngờ lại gặp được những nhà thám hiểm ở đây...",
    ["aside11170601"]="Làm thế nào, làm thế nào? Bạn khỏe hơn chưa? nhà thám hiểm?",
    ["aside11170701"]="...Thật là một cái tên kì lạ.",
    ["aside11170801"]="...Đó là TL33019-SG! SG!",
    ["aside11170901"]="đó là……?",
    ["aside11171001"]=" với] cái gì thế này? !",
    ["aside11171002"]="Xin chào? Xin chào! Nhà thám hiểm? Chuyện gì đã xảy ra thế? !",
    ["aside11171101"]="Ah, đây thực sự là...một bức tranh graffiti đầy tính nghệ thuật!",
    ["aside11171201"]="TSK tsk! Một thời điểm quan trọng!",
    ["aside11171301"]="...Nhà thám hiểm? Nhà thám hiểm? Hãy trả lời nếu bạn nhận được nó!",
    ["aside11171401"]="...Có vẻ như chúng ta phải tìm cách khác.",
    ["aside11171501"]="Chào mừng đến với thiên đường của tôi, người thừa kế dòng máu Odin!",
    ["aside11171601"]="...Nhà thám hiểm? Bạn có thể nghe tôi không--",
    ["aside11171602"]="Yo ho~ Từ nay đường dây liên lạc này sẽ do tôi tiếp quản!",
    ["aside11171701"]="Bạn, bạn là một người tọc mạch!",
    ["aside11171801"]="Nhìn đây, nhà thám hiểm.",
    ["aside11171901"]="...May mắn thay bạn vẫn an toàn.",
    ["aside11172001"]="Từ đây chúng ta hãy đi theo những con đường riêng biệt.",
    ["aside11172101"]="Điều đó không được đâu, nhà thám hiểm.",
    ["aside11172201"]="Điều này trông dễ chịu hơn nhiều cho mắt.",
    ["aside11172301"]="…Việc còn lại hãy để cho những người có chuyên môn.",
    ["aside11172401"]="…Đúng lúc rồi đấy, nhà thám hiểm.",
    ["aside11172501"]="Hey hey Hey! Bạn đang làm gì thế? !",
    ["aside11172601"]="Bạn còn làm gì ở đây nữa?",
    ["aside11172701"]="Đây là...?",
    ["aside11172801"]="...khởi động lại...xong...",
    ["aside11172901"]="Trời sắp tối rồi, nhà thám hiểm.",
    ["aside11173001"]="Chào mừng trở lại, nhà thám hiểm.",
    ["aside11173101"]="Được rồi, đến gần hơn một chút đi, nhà thám hiểm.",
    ["aside11173102"]="Hãy lắng nghe những gì họ đang nói.",
    ["aside11173201"]="Đây là... kế hoạch của họ.",
    ["aside11173301"]="Ủa? Người đó là...?",
    ["aside11173401"]="Chờ đã, Nhà Thám Hiểm, bạn nhìn đằng kia đi...",
    ["aside11173402"]="Đi, đi nghe xem họ đang nói gì.",
    ["aside11173501"]="Bạn đang làm gì vậy?!",
    ["aside11173601"]="Nhân lúc này, chạy mau!",
    ["aside11173701"]="... Ở đây chắc là an toàn rồi.",
    ["aside11173801"]="Được, đủ rồi!",
    ["aside11173901"]="Ở đây chắc là được rồi.",
    ["aside11174001"]="... Ai đó!",
    ["aside11174101"]="Đủ rồi, Nhà Thám Hiểm. Đánh ngất chúng là được.",
    ["aside11174201"]="Được, còn con chip cuối cùng.",
    ["aside11174301"]="Sao lại là bạn?",
    ["aside11174401"]="Tốt lắm, như vậy là đủ rồi.",
    ["aside11174501"]="Thời gian rất thích hợp, Nhà Thám Hiểm.",
    ["aside11174601"]="... Tôi ở đây",
    ["aside11174701"]="Bên này, Nhà Thám Hiểm.",
    ["aside11174801"]="Đã được rồi đó, người trẻ tuổi.",
    ["aside11174901"]="Cẩn thận... Nồng độ khí đốt ở đây rất cao.",
    ["aside11175001"]="Được rồi, được rồi... Đánh nữa là báo hỏng đó.",
    ["aside11175101"]="... Ở bên đó, thấy chưa?",
    ["aside11175201"]="Khụ khụ... Nhanh lên, cái lưng của tôi sắp trụ hết nổi rồi...",
    ["aside11175301"]="Cuối cùng cũng đã đến rồi...",
    ["aside11175401"]="Rất tốt, đây là bậc cuối cùng rồi.",
    ["aside11175501"]="Thời gian rất thích hợp, Nhà Thám Hiểm.",
    ["aside11175601"]="Lạ lùng...Sao em vẫn chưa về...",
    ["aside11175701"]="…Melanie…",
    ["aside11175801"]="Ông chủ! Chuyến tàu đặc biệt của viện đã đến!",
    ["aside11175802"]="Được rồi, chuẩn bị dỡ hàng thôi!",
    ["aside11175901"]="…Được rồi, tiếp theo chúng ta hãy đi tìm người bán tạp hóa nhé.",
    ["aside11176001"]="Cảm ơn đã chiếu cố!",
    ["aside11176101"]="Bạn đã có đồ chưa, nhà thám hiểm?",
    ["aside11176201"]="…Tuyệt vời, nhà thám hiểm.",
    ["aside11176301"]="Tôi nên làm gì...",
    ["aside11176401"]="Được rồi, gặp lại sau, nhà thám hiểm!",
    ["aside11176501"]="Đã, đã cứu...",
    ["aside11176601"]="Dừng lại, dừng lại, dừng lại...đây rồi!",
    ["aside11176701"]="Vậy thì... sứ mệnh của chúng ta đã hoàn thành.",
    ["aside11176801"]="Không, không... Tôi không thể tiếp tục!",
    ["aside11176901"]="Sau đó... bạn chỉ cần đi theo đường hầm mỏ này đến cùng.",
    ["aside11177001"]="Nhà thám hiểm...Tôi nghĩ có gì đó không ổn.",
    ["aside11177101"]="Không phải ở đây...xa hơn một chút, nhà thám hiểm.",
    ["aside11177201"]="...đã rất gần rồi",
    ["aside11177301"]="Nhà thám hiểm, hãy nhìn đằng kia!",
    ["aside11177401"]="Di chuyển một cách nhanh chóng! Những con quái vật đã tập hợp lại!",
    ["aside11177501"]="Hừm, một miếng bánh!",
    ["aside11177601"]="Huh? Có vẻ như một con quái vật khác đang đến?",
    ["aside11177701"]="Xong rồi, nhà thám hiểm!",
    ["aside11177801"]="Được rồi, cái tiếp theo!",
    ["aside11177901"]="Thế là đủ rồi phải không?",
    ["aside11178001"]="Chúng ta nên luôn tin rằng bình minh sẽ đến, phải không?",
    ["aside11178101"]="…Dù kết quả thế nào thì tôi cũng đã cố gắng hết sức.",
    ["aside11178201"]="Uống... tốt nhất là say.",
    ["aside11178301"]="Tiếng ồn đã biến mất... Có lẽ bạn muốn nói chuyện một mình với tôi phải không?",
    ["aside11178401"]="Hmm...họ đã đến nhà kho bỏ hoang rồi à?",
    ["aside11178501"]="Chuyện gì đã xảy ra với họ vậy?",
    ["aside11178601"]="Mảnh giấy này là...?",
    ["aside11178701"]="Ối! Chúng ta phải đến hang Nokrorod nhanh lên!",
    ["aside11178801"]="...Đã phát hiện, kẻ xâm nhập.",
    ["aside11178901"]="Hãy tiếp tục...tiến về phía trước.",
    ["aside11178902"]="...?",
    ["aside11179001"]="... Không phát hiện được danh tính.",
    ["aside11179002"]="...Chương trình chặn, bật lên.",
    ["aside11179101"]="Cảm ơn nhà thám hiểm...",
    ["aside11179201"]="Dù con đường có dẫn đến vực thẳm...",
    ["aside11179202"]="...Bạn cũng sẽ dũng cảm tiến về phía trước chứ?",
    ["aside11179301"]="Ý chí của chúng tôi... được để lại cho bạn.",
    ["aside11179401"]="…Hừm, đấu tranh chết tiệt.",
    ["aside11179501"]="Đừng cứng đầu như vậy nữa.",
    ["aside11179601"]="Bạn không thể thắng được.",
    ["aside11179701"]="Tôi không cần phải đi vào chi tiết về những gì xảy ra tiếp theo, phải không?",
    ["aside11179801"]="Quý cô Ellumina? !",
    ["aside11179901"]="...Đừng sợ, ở đây an toàn.",
    ["aside11180001"]="Đây, đây là...?",
    ["aside11180101"]="Cậu nói gì?!",
    ["aside11180102"]="Âm thanh này là...?",
    ["aside11180201"]="nó ở đây……?",
    ["aside11180301"]="...Hình như còn có một lá thư khác?",
    ["aside11180401"]="Lý tưởng của bạn...Tôi chắc chắn sẽ hiện thực hóa nó cho bạn.",
    ["aside11180501"]="C-chuyện gì xảy ra với anh thế, nhà thám hiểm? !",
    ["aside11180601"]="Bạn đang lam cai quai gi thê? !",
    ["aside11180701"]="...Hãy trở về an toàn nhé.",
    ["aside11180801"]="...click click click...đang phân tích dữ liệu...",
    ["aside11180901"]="Tôi biết anh ấy ở đây!",
    ["aside11181001"]="... Rốt cuộc mọi người muốn làm gì?",
    ["aside11181101"]="Hãy đến đây, nhà thám hiểm.",
    ["aside12000101"]="Woa, đúng là một màn cảm động lòng người!",
    ["aside12000201"]="Phần sau của tập thơ đã bị xé rồi?! Việc này... phải làm thế nào?",
    ["aside12000301"]="Ồ, Parni thật đáng thương...",
    ["aside12000401"]="Cô ấy chắc là Parni đó, mau qua đó hỏi thử xem!",
    ["aside12000501"]="Đây là... bia mộ của ba vị Hoàng Tử Gia Tộc Gaebolg?",
    ["aside12000502"]="Nhưng tại sao ba vị Hoàng Tử lại chết cùng một ngày... thật kỳ lạ nhỉ?",
    ["aside12000503"]="Tóm lại, hãy quay về hỏi Parni xem!",
    ["aside12000601"]="Parni đâu?? Thứ trên đất đó là...?",
    ["aside12000701"]="Cậu đến rồi. Ta đang đợi cậu.",
    ["aside12000801"]="Chúng ta đến rồi.",
    ["aside12000901"]="Các cậu là ai?! Lại dám xông vào nghĩa trang hoàng tộc!",
    ["aside12001001"]="...Mau lén đi theo cô ấy!",
    ["aside12001101"]="Cậu là...?!",
    ["aside12001201"]="Nhà Thám Hiểm, đúng lúc ngài ấy đang rảnh để gặp cậu!",
    ["aside12001301"]="Chính là ở đây, đừng để ngài Walter đợi lâu đấy.",
    ["aside12001401"]="Nhà Thám Hiểm kia, mau qua đây",
    ["aside12001501"]="...Cậu đang làm gì thế?!",
    ["aside12001601"]="Hừ...Nhà Thám Hiểm...",
    ["aside12001701"]="Hở? Những quý tộc ấy hình như đang nói gì đó, lén qua nghe thử xem!",
    ["aside12001801"]="Có ai, có ai cứu ta với! Quỷ, có quỷ!!!!!",
    ["aside12001901"]="Á... Lại là kẻ sống ở đây trước kia sao...",
    ["aside12001902"]="Cậu, cậu có nghe thấy không?! Âm thanh vừa rồi?!",
    ["aside12002001"]="Trong hình là ai? Hình cô ấy ở khắp nơi, chụp lại cho Colorful xem!",
    ["aside12002101"]="Chữ trên huy hiệu... Đội Thân Vệ Nerius?!",
    ["aside12002102"]="Colorful là vương tộc Nerius?!",
    ["aside12002201"]="Trên bìa thư viết, thuyền trưởng: Colorful Nerius... Thì ra là thế!",
    ["aside12002202"]="Cảm thấy có một số thứ... không thích hợp nói với cô ấy.",
    ["aside12002301"]="Ta phát hiện ra rồi! Ở chỗ giống đàn tế kia có một đám lớn! Theo ta!",
    ["aside12002401"]="Sherry, đừng sợ, đừng sợ, cậu xem đám Nhện Nước kia rất thích cậu.",
    ["aside12002402"]="Đám... đám quái vật sống dưới đáy biển kia, thật sự không sao chứ?",
    ["aside12002403"]="Không sao, không sao cả, nào, sờ một cái thử xem!",
    ["aside12002501"]="Này, đợi đã, các cậu có phải đang nhiệt tình quá hay không... Sherry!? Sherry!?",
    ["aside12002502"]="Nhà Thám Hiểm, có gì đó không đúng lắm! Mau đến cứu chúng tôi!",
    ["aside12002601"]="Ha ha ha, ta cứ tập trung luyện tập, quên mất mấy thứ quan trọng...",
    ["aside12002701"]="Cảm thấy... Dinza cũng không xấu xa như ta tưởng?",
    ["aside12002702"]="He he, ta cũng cần học cách quan tâm đến những thứ khác ngoài việc tập luyện nữa!",
    ["aside12002801"]="Người Cá này răng sắc nhọn, nhưng hoàn toàn không độc ác...",
    ["aside12002802"]="Xem ra phải điều tra thôi, lẽ nào việc này có liên quan đến Thần Biển?",
    ["aside12002901"]="Không tìm thấy... Elliott đã trốn thoát thành công rồi sao? Hay là...",
    ["aside12003001"]="Có phải đã làm Cenia bị thương rồi không",
    ["aside12003101"]="Xin lỗi... Ta, ta đã gây rắc rối lớn cho các cậu...",
    ["aside12003102"]="Chúng ta đi thôi...",
    ["aside12003201"]="Cái bẫy này... thực sự không sao chứ? Goblin thực sự mắc bẫy sao?",
    ["aside12003301"]="Ờ... giả vờ như nó không sao à?",
    ["aside12003401"]="Đến rồi! Chính là chúng!",
    ["aside12003501"]="Không, các ngươi đừng qua đây!",
    ["aside12003502"]="Hở? Có người đang cầu cứu?",
    ["aside12003503"]="Giọng nói này là... Morts?!",
    ["aside12003601"]="Có lẽ không nên làm phiền họ nữa, để họ bình tĩnh lại đã.",
    ["aside12003701"]="Từ lúc nào ta thành trợ thủ của tên Dinza kia chứ...",
    ["aside12003801"]="Cảm giác này... có chút tàn nhẫn",
    ["aside12003901"]="Á! Tìm thấy rồi! Ta đi an ủi cô ấy đã!",
    ["aside12004001"]="Ta xem nào... ờ, trước hết đi về hướng bắc!",
    ["aside12004101"]="Đây là đường thẳng! Cứ đi theo đường này là được!",
    ["aside12004201"]="Đây là... dọc bờ sông rồi, đi về hướng Tây!",
    ["aside12004301"]="Cảm thấy chỉ là một bãi đá bình thường...",
    ["aside12004401"]="Vẫn chưa tới sao? Vậy chúng ta đợi một lát...",
    ["aside12004501"]="Cảm thấy... có gì đó không ổn?",
    ["aside12004601"]="Lần này được đón nhận nồng nhiệt, giỏi lắm!",
    ["aside12004701"]="Người thợ đều hay để ý \"hoàn mỹ\" là gì sao?",
    ["aside12004801"]="Trên đất có dấu chân mới? Ai?",
    ["aside12004901"]="Dấu chân đi vào trong rồi!",
    ["aside12005001"]="Hoa văn đáng yêu quá!",
    ["aside12005101"]="Bài hát sẽ biểu diễn cho quý vị sau đây là ca khúc mới chưa từng công bố!",
    ["aside12005102"]="Hãy mau rời khỏi đây...",
    ["aside12005201"]="Lông Thỏ Điên màu xanh... thì ra nguy hiểm vậy sao?",
    ["aside12005301"]="Ha ha ha, lại có người bị lừa rồi.",
    ["aside12005302"]="Thì ra có nhiều kẻ ngốc thế?",
    ["aside12005303"]="Bị lừa?... Hở? Bị lừa rồi?? Chết tiệt, ta phải dạy dỗ hắn mới được!",
    ["aside12005401"]="Người Hát Rong thực sự có thể tìm được cảm hứng từ việc thế này sao?",
    ["aside12005501"]="Cứu, cứu tôi với!!!",
    ["aside12005502"]="Quả nhiên là thế mà!",
    ["aside12005601"]="Tên này không vấn đề gì chứ...",
    ["aside12005701"]="Trong túi này chứa thứ gì thế, mà Chuột Bạch tranh giành nhau...",
    ["aside12005801"]="Đây đâu phải là Chất Dẫn! Rõ ràng đây là Chất Cuồng Bạo mà!",
    ["aside12005901"]="Tên này suýt chút hại chết ta rồi! Quay về tìm hắn tính sổ!",
    ["aside12006001"]="Thứ gớm ghiếc...",
    ["aside12006101"]="Những Trứng Bọ Trộm này nghĩa là sao?",
    ["aside12006102"]="Ta muốn đem mấy con Bọ Trộm nở từ trứng này làm thú cưng!",
    ["aside12006103"]="Đâu có thế được! Bọ Trộm là quái vật, làm sao đem vào trong thành nuôi dưỡng được!",
    ["aside12006104"]="Những Trứng Bọ Trộm này sẽ bị tiêu hủy, nể tình cậu lần đầu phạm tội, ta không truy cứu nữa!",
    ["aside12006201"]="Lần này chắc Frank bỏ cuộc rồi nhỉ...",
    ["aside12006301"]="Xuất hiện rồi! Hiệu nghiệm nhanh chóng thật!",
    ["aside12006401"]="Cảm thấy hơi xấu hổ khi đối mặt đầu bếp Dobbin... xem có thể giúp anh ấy cái gì không",
    ["aside12006501"]="Vậy mà lại dùng cách này để đuổi quái vật, quả thực có chút độc ác...",
    ["aside12006601"]="Đây... chắc không phải là thật chứ?",
    ["aside12006701"]="Đây đúng là... hương vị của tình yêu.",
    ["aside12006801"]="Những nguyên liệu này thực sự có thể chế ra thuốc sao?",
    ["aside12006901"]="Tuy không biết là nồi của ai... nhưng xin lỗi nhé!",
    ["aside12007001"]="Mở to miệng ta xem nào!",
    ["aside12007002"]="Xin hỏi... ta còn cứu được không?",
    ["aside12007003"]="Hả? Cậu đang nói gì?",
    ["aside12007004"]="Nếu việc ta biến thành Quỷ Hút Máu là không thể tránh khỏi, vậy hãy để ta...",
    ["aside12007005"]="Ai nói cậu sẽ biến thành Quỷ Hút Máu? Cậu chỉ bị cảm thôi!",
    ["aside12007006"]="Thật... thật sao?",
    ["aside12007007"]="Gạt cậu làm gì, ta kê cho cậu hai thang thuốc, về nhà nghỉ ngơi đi.",
    ["aside12007008"]="Có lẽ chỉ là hiểu lầm thôi, vậy ta yên tâm rồi.",
    ["aside12007101"]="Đúng là đứa trẻ cứ khiến người ta lo lắng...",
    ["aside12007201"]="Punk Mira... sao? Sau này ta sẽ chú ý nhiều hơn.",
    ["aside12007301"]="Mùi này... hơi tế nhị.",
    ["aside12007401"]="Hai người... quen nhau trước rồi sao?",
    ["aside12007501"]="Xem ra nhiệm vụ đầu tiên của anh ấy rất thuận lợi.",
    ["aside12007601"]="Cảm thấy Morts cũng không phải là tên cặn bã... hy vọng họ sẽ thuận lợi?",
    ["aside12007701"]="Vậy nhìn khắp nơi xem! Ta phát hiện ra chỗ chưa đánh dấu sẽ gọi cậu dừng lại!",
    ["aside12007801"]="Chính là ở đây! Vào giữa khu ấy đi, ta phải đánh dấu chỗ này lại!",
    ["aside12007901"]="Anh ấy thực sự không ý thức được ma nữ đang ở bên cạnh sao? Đợi đã, Punk?",
    ["aside12008001"]="Ú òa... Sói Hộ Vệ! Hãy đuổi kẻ làm phiền giấc mơ của chúng ta!",
    ["aside12008101"]="Ma nữ... thì ra trên thế giới còn có người như vậy sao",
    ["aside12008201"]="Hình như đã nhìn thấy một mặt giấu kín của Arlene...",
    ["aside12008301"]="Một đàn hải âu... Hình như ta đã nhìn thấy chúng lúc mới đến đảo Izlude?",
    ["aside12008401"]="Trang phục thuyền trưởng sừng hươu? Sao quen thế nhỉ?",
    ["aside12008501"]="Lacus... Lát nữa ta sẽ tìm, phải đem chuyện này kể cho Caslisse trước đã!",
    ["aside12008601"]="Muốn tìm chứng cứ cho Lacus, đành phải chụp ảnh hồn ma của thuyền trưởng Kahn.",
    ["aside12008701"]="Tuy rất tàn nhẫn... xin lỗi nhé! Lacus, ta phải cho cậu biết chân tướng!",
    ["aside12008801"]="Ở đây chỗ nào bán thuốc?! Đành phải đi hỏi Thương Gia tạp hóa thôi!",
    ["aside12008901"]="Không thể chậm trễ, mau xuất phát!",
    ["aside12009001"]="Nhà Thám Hiểm, sao cậu dẫn cô ấy đến nơi nguy hiểm như vậy?!",
    ["aside12009002"]="Ta không muốn nói lời từ biệt, nên ta cầu xin anh ấy mang ta theo.",
    ["aside12009003"]="Lacus, ta... à... bây giờ ngay cả việc ôm chàng ta cũng không làm được...",
    ["aside12009004"]="Xin lỗi, hôm ấy trước khi đi biển, ta nói chàng không lo được cho ta, không nuôi nổi gia đình...",
    ["aside12009005"]="Nếu hôm đó ta không nói vậy, chàng đã không mạo hiểm đi biển...",
    ["aside12009006"]="Vì tương lai của chúng ta, nếu cho ta chọn lựa lại, ta cũng sẽ đi biển.",
    ["aside12009007"]="Lúc đó ta đã quyết định, đi xong lần này, ta sẽ quay về sống cùng nàng những ngày còn lại.",
    ["aside12009008"]="Bây giờ, ờ... đây chính là thần trừng phạt những hành vi lỗ mãng của ta sao...",
    ["aside12009009"]="Ta muốn xin lỗi chàng, và... ta yêu chàng.",
    ["aside12009101"]="Công chúa vong linh sao... Thật muốn nhìn thấy cô ấy.",
    ["aside12009201"]="Trốn đi... Sợ ma vậy sao còn đến đây...",
    ["aside12009301"]="Á, lẽ nào đó là...",
    ["aside12009401"]="Ma sợ người, người sợ ma, rốt cuộc muốn làm thế nào!",
    ["aside12009501"]="Đuổi được Arlene rồi, có thể yên tâm gặp công chúa vong linh rồi!",
    ["aside12009601"]="Phòng sách của thuyền trưởng... Có nơi như vậy sao? Có lẽ ở tầng trên?",
    ["aside12009701"]="Đội Thân Vệ? Thân phận của Colorful xem ra không đơn giản?",
    ["aside12009801"]="Từ phản ứng của Colorful, ta thấy quyết định che giấu bớt sự thật là đúng đắn",
    ["aside12009901"]="Cài tóc này... hư mất rồi...",
    ["aside12010001"]="Hình như Cenia rất đau lòng... Ta có ý này!",
    ["aside12010101"]="Cảm ơn, bây giờ còn cần thêm Quặng Bạc và Quặng Vàng.",
    ["aside12010201"]="Tốt lắm, giờ chỉ còn thiếu Quặng Vàng thôi.",
    ["aside12010301"]="Ta nghĩ nhiêu đây đã đủ rồi!",
    ["aside12010401"]="Có Halmod ở đây, đám quái vật đó sẽ biết tay!",
    ["aside12010501"]="Ha ha! Không phải là đối thủ của ta!",
    ["aside12010601"]="Quả nhiên cậu đã đến, ta không nhìn nhầm người!",
    ["aside12010701"]="Cậu đi chậm thật đấy, bạn của tôi!",
    ["aside12010801"]="Cúc cu---",
    ["aside12010901"]="Đáng ghét... Tên bắt cóc chết tiệt!",
    ["aside12011001"]="Agnes?... Đợi đã, trên mặt đất là...?",
    ["aside12011101"]="...Ở đây tạm dừng một chút.",
    ["aside12011201"]="Bây giờ chúng ta trốn sang một bên, ta phải xem xem tên bắt cóc là ai!",
    ["aside12011301"]="Đến rồi!",
    ["aside12011401"]="Dừng tay! Đây chắc chắn là hiểu lầm!",
    ["aside12011501"]="Dùng Bom Tín Hiệu ở đây đi.",
    ["aside12011601"]="Cẩn thận đám kiến này!",
    ["aside12011701"]="Tiếp tục tiến lên, nhất định phải cảnh giác!",
    ["aside12011801"]="Tiêu rồi, Wulf đang gặp nguy hiểm! Mau đi cứu anh ấy!",
    ["aside12011901"]="Không sai, chính là loại thảo dược này!",
    ["aside12012001"]="Ở khía cạnh nào đó, Morts thật sự là một nhạc sĩ thuần túy.",
    ["aside12012002"]="Lúc đó ở Cổng Nam có thể giúp anh ấy, thật là tốt.",
    ["aside12013901"]="Công Hội Kiếm Sĩ, nhớ là ở phía Tây chỗ này? Đi xem thử nào!",
    ["aside12014001"]="Chợ trung tâm có vẻ rất náo nhiệt, đi chợ nào!",
    ["aside12014101"]="Nghe nói sân tập có thể rèn luyện sức chiến đấu! Nếu đã chuyển nghề rồi, chi bằng đi xem thử!",
    ["aside12020101"]="Lạ thật... Tấm thiệp mời biến đâu mất rồi?",
    ["aside12020201"]="Thì ra thiệp mời rơi vào tay vệ binh này!",
    ["aside12020301"]="Được rồi, được rồi, ta nhận thua!",
    ["aside12020401"]="Cô gái xinh xắn kia chắc chắn là Veronica, mau tặng quà cho cô ấy đi!",
    ["aside12020501"]="...Tiêu rồi tiêu rồi, lần này chắc chắn chị sẽ đau lòng!",
    ["aside12020601"]="Lại là cái sào huyệt quen thuộc này...",
    ["aside12020701"]="Hay quá, ở đây có hoa Veronica!",
    ["aside12020702"]="Cạch!!!",
    ["aside12020801"]="Phù, giờ có thể yên tâm hái hoa Veronica rồi.",
    ["aside12020901"]="...Cậu, cậu đã làm gì?!",
    ["aside12021001"]="Không... Bohr!!!",
    ["aside12021101"]="Đầu tiên là Lõi Quỷ Đất, đặt bên tay phải ngài Bohr.",
    ["aside12021201"]="Tiếp theo là Lõi Ma Nước, đặt bên tay trái ngài Bohr.",
    ["aside12021301"]="Tiếp theo là Lõi Quỷ Thây Ma, đặt dưới chân ngài Bohr.",
    ["aside12021401"]="Tốt lắm, giờ ta phải thi triển Pháp Thuật đây.",
    ["aside12021501"]="Được rồi, giờ ngài Bohr đã bình an vô sự.",
    ["aside12021601"]="Đủ rồi, đem độc tố này đút cho con Thỏ Điên ta mang đến xem sao.",
    ["aside12021701"]="Quả nhiên là thế, mau kiểm tra thi thể con Thỏ Điên kia!",
    ["aside12021801"]="Thôi xong! Bị phát hiện rồi!",
    ["aside12021901"]="Đừng hòng chạy!",
    ["aside12022001"]="Phải nhanh chóng quay về sân tập tìm ngài Bohr!",
    ["aside12022101"]="Akand, chúng tôi tìm được tung tích của Chino rồi!",
    ["aside12030101"]="Số hoa này chắc đã đủ rồi.",
    ["aside12030201"]="Quả nhiên ở đó có một cô gái, lẽ nào là cô ấy?",
    ["aside12030301"]="Đó là...",
    ["aside12030401"]="Lề mề quá! Lề mề quá!",
    ["aside12030501"]="Chính là ở đây!",
    ["aside12030601"]="Cô Kaitlyn, những thứ này chắc chắn cô sẽ thích!",
    ["aside12030701"]="Đó chắc chắn là Jurgen rồi!",
    ["aside12030801"]="Cậu muốn làm gì?!",
    ["aside12030901"]="Tìm thấy rồi!",
    ["aside12031001"]="Chuông trống ngọc ngà chưa đủ quý, mong chi tỉnh lại ước say dài! Ợ!",
    ["aside12031101"]="Tìm thấy rồi!",
    ["aside12040101"]="Những vệt phía trước là...?",
    ["aside12040201"]="Đến phía trước tìm thử xem, biết đâu vẫn còn...",
    ["aside12040301"]="Chủ nhân của vết máu này, chắc không phải là...?",
    ["aside12040401"]="Mau đến gốc cây nhìn xem!",
    ["aside12040501"]="Đứng im!!!",
    ["aside12040601"]="...Đám đạo chích đó ấy rốt cuộc là ai?",
    ["aside12040701"]="Để đồ xuống!!",
    ["aside12040801"]="Lạ thật, sao chúng biết \"Sổ Tay Merlin\" ở trong tay ta...",
    ["aside12040901"]="Hừ, đừng hòng qua!!",
    ["aside12041001"]="Thật đúng là dây dưa không dứt... Phải hành động cẩn thận mới được!",
    ["aside12041101"]="Khụ khụ! Cậu đến đúng lúc lắm!",
    ["aside12041201"]="Nithil từng nói đừng tin bất cứ ai, cẩn thận một chút!",
    ["aside12041301"]="Mau đi đến nơi ở của Nhà Thông Thái đi!",
    ["aside12041401"]="Tìm hiểu kỹ bên ngoài chưa? Hay là chụp tấm hình đi!",
    ["aside12041501"]="Tiếp theo hãy lục xem trên người hắn có thứ gì...",
    ["aside12041601"]="...Đây là? Đưa cho Kroneika xem đi!",
    ["aside12041701"]="...Ngài Nithil, thì ra ngài ở đây!",
    ["aside12041801"]="...Đừng đánh nữa, đừng đánh nữa!",
    ["aside12041901"]="Nhớ kỹ, lúc nào cũng phải cẩn thận.",
    ["aside12042001"]="Đến phía trước xem xem, nhớ là nhẹ nhàng thôi...",
    ["aside12042101"]="Hắn sắp đến thùng nước bên đây rồi, mau bỏ Thuốc Nói Thật vào!",
    ["aside12042201"]="Xong rồi, thử thăm dò hắn xem sao!",
    ["aside12042301"]="(Gầm gừ---)",
    ["aside12042302"]="Xem ra không xử lý xong mấy tên này thì không thể đi tiếp được...",
    ["aside12042401"]="Nơi nguy hiểm thế này, sứ giả phía sau làm sao đến được?",
    ["aside12042501"]="...Phía trước là?!",
    ["aside12042601"]="Đợi đã, hình như ven hồ có cái gì đó...",
    ["aside12042701"]="Rốt cuộc là ai ở đây...",
    ["aside12042702"]="Cậu cứ thích không mời mà đến nhỉ!",
    ["aside12042801"]="Cậu quay về rồi, Nhà Thám Hiểm.",
    ["aside12050101"]="Tiêu rồi, hai người này gặp nguy hiểm!",
    ["aside12050201"]="Được rồi, mau quay về Hoa Viên Pooler đi!",
    ["aside12050301"]="...Đợi đã, đây là?!",
    ["aside12050401"]="Đây là...!",
    ["aside12050501"]="...Quả nhiên là thế.",
    ["aside12050601"]="Đám sát thủ đó bị thương trong trận đấu, vết máu ấy chắc là của chúng...",
    ["aside12050701"]="Đến phía trước tìm thử xem, biết đâu vẫn còn...",
    ["aside12050801"]="Dấu bánh xe này là...?! Mau báo với bọn Eze đi!",
    ["aside12050901"]="Mau kiểm tra thùng hàng khác xem...",
    ["aside12051001"]="Đằng kia còn một số thùng hàng...",
    ["aside12051101"]="...Chết tiệt, Goblin đã bị phát hiện!",
    ["aside12051201"]="Đau quá... Ta đau quá a a a a!",
    ["aside12051301"]="Được rồi, giờ mau báo cáo tình hình điều tra được cho Eze đi!",
    ["aside12051401"]="Thế này... là được rồi chứ?",
    ["aside12051501"]="Nhà Thám Hiểm kia, mau qua đây...",
    ["aside12051601"]="Được rồi, mau đem những gì nghe được nói cho Eze đi.",
    ["aside12060101"]="Sứ đoàn đã rời đi, mau xem quanh đây còn để lại manh mối gì không!",
    ["aside12060201"]="Những thứ này không có ích gì cả... khoan đã, đó là gì?",
    ["aside12060301"]="...Ai đã để lại mấy câu này?",
    ["aside12060302"]="Tóm lại, hãy đến nơi tờ giấy đề cập đến trước đã.",
    ["aside12060401"]="Xác Ướp khổng lồ? Có lẽ các nhà Học Giả Khảo Cổ sẽ biết được điều gì đó.",
    ["aside12060501"]="Được rồi, bây giờ hãy cố gắng thuần phục nó đi.",
    ["aside12060601"]="Xong rồi! Bây giờ chỉ còn chờ đêm xuống...",
    ["aside12060701"]="Tốt lắm, giờ thì lén phun máu độc vào người chúng!",
    ["aside12060801"]="Tiếp theo, cho Xác Ướp ăn gai quỷ.",
    ["aside12060901"]="Lạ thật, vẫn không thấy bóng dáng của Quốc Vương đâu... tìm tiếp xem!",
    ["aside12061001"]="Ý? Đây là…!",
    ["aside12061101"]="Cái quái gì thế này... ai da!!!",
    ["aside12061201"]="Đây là... đá do ai ném vậy?",
    ["aside12061202"]="...Ọc!! Lại nữa?!",
    ["aside12061301"]="Nguy rồi, sứ đoàn quay lại rồi! Rút mau!",
    ["aside12061401"]="Phải rồi, mảnh giấy vừa nhặt được đó...",
    ["aside12061501"]="...Rốt cuộc là ai đã để lại những lời nhắc này?",
    ["aside12061502"]="Tóm lại, hãy đến nơi tờ giấy đề cập đến trước đã.",
    ["aside12061601"]="Nguy rồi, canh phòng xung quanh vật tư đã cẩn mật hơn rồi! Làm sao...",
    ["aside12061602"]="...A, Nhà Thám Hiểm, trùng hợp quá!",
    ["aside12061701"]="Thả ta ra... thả...",
    ["aside12061702"]="...Giọng nói này là?!",
    ["aside12061801"]="Này này... chỗ quặng đó là của ta! Giearth chết tiệt!",
    ["aside12061901"]="Mọi chuyện nhờ cả vào Nhà Thám Hiểm nhé!",
    ["aside12062001"]="Hu, ọc...",
    ["aside12062002"]="...Giọng nói này là?!",
    ["aside12062101"]="Cúc cu...!",
    ["aside12062201"]="Quanh đây đều là Golem, diệt sạch chúng trước đã!",
    ["aside12062301"]="Xong rồi. Bây giờ đặt những miếng thịt tươi lên...",
    ["aside12062401"]="Sao có thể... tại sao vẫn chưa có manh mối nào về Quốc Vương?",
    ["aside12062501"]="Đây... rốt cuộc là chuyện gì?",
    ["aside12062601"]="Chỉ còn một thùng hàng cuối cùng, chẳng lẽ...?!",
    ["aside12062701"]="...Người để lại mẩu giấy, cuối cùng cũng sắp lộ diện rồi.",
    ["aside12062801"]="Được rồi. Bây giờ nghĩ lại, người thanh niên tóc vàng đã nói gì...",
    ["aside12062901"]="Ta biết là ngươi nhất định sẽ đến!",
    ["aside12063001"]="Được rồi, đã làm xong chuyện đầu tiên hắn giao。",
    ["aside12063002"]="Tiếp theo, hắn còn nói những gì nhỉ?",
    ["aside12063101"]="Bây giờ, cũng đã làm xong chuyện thứ hai.",
    ["aside12063102"]="Người thanh niên đó cuối cùng còn nói những gì nhỉ?",
    ["aside12063201"]="Nhà Thám Hiểm, chúng ta gặp lại nhau rồi.",
    ["aside12063301"]="Ồ... tại sao người thanh niên sứ đoàn đó biến mất rồi?",
    ["aside12070101"]="Nhà Thám Hiểm, có thể đến đây một lát được không?",
    ["aside12070201"]="Ngươi... sao lại là ngươi?",
    ["aside12070301"]="Vậy, ngươi phải theo sát bước chân ta!",
    ["aside12070401"]="Đáng ghét. Con đường phía trước lại bị quái vật chặn lại rồi.",
    ["aside12070501"]="Tốt lắm. Nhưng Kiếm Dũng Sĩ chắc ở sâu hơn trong hang...",
    ["aside12070601"]="...Ở đây, thật phiền phức như trong lời đồn.",
    ["aside12070701"]="Ta nghĩ đã không còn xa Hang Rồng!",
    ["aside12070801"]="...Đây là?!",
    ["aside12070901"]="A...! Tránh, tránh ra!!",
    ["aside12071001"]="Không được, chúng còn mãi! Chúng ta rút thôi!",
    ["aside12071101"]="...Chuyện này rốt cuộc là...",
    ["aside12071201"]="...Chú ý, chú ý! Còn 5 phút nữa là đến phần trình diễn của Barbara!",
    ["aside12071202"]="...Này, tên này?!!",
    ["aside12071301"]="...Hi! Đừng giành! Ai cũng có phần mà!",
    ["aside12071401"]="Bây giờ, đã đến lúc đi gặp mỹ nhân này rồi!",
    ["aside12071501"]="...Hừ, có ma nó mới tin mấy lời này.",
    ["aside12071601"]="Sai khiến quái vật trộm khăn tay... Trước tiên, phải khóa mục tiêu!",
    ["aside12071701"]="Được rồi! Tiếp theo là rượu ngon dùng để hối lộ...",
    ["aside12071801"]="Lần này có thể tìm chim cánh cụt mà Spica nói!",
    ["aside12071901"]="...Ục???",
    ["aside12072001"]="Ục... ục, ục ục!!!",
    ["aside12072101"]="Xong, mau đi tìm Spica!",
    ["aside12072201"]="Ca... ca...!",
    ["aside12072301"]="Quả nhiên là vậy...",
    ["aside12072401"]="Grum...!",
    ["aside12072501"]="...!!!",
    ["aside12072601"]="Bây giờ, chúng ta cần đổi phương pháp.",
    ["aside12072701"]="Xong, hãy đi nói chuyện tiếp với Elena!",
    ["aside12072801"]="Văn hóa khiến người ta trở nên giàu có. Các bạn nhỏ, các bạn phải học thuộc những bài thơ này!",
    ["aside12072901"]="Cảm ơn, vừa rồi đúng là ngàn cân treo sợi tóc.",
    ["aside12073001"]="Lần này manh mối đã gần đủ rồi.",
    ["aside12073101"]="...Đây là!!!",
    ["aside12073201"]="Các ngươi... rốt cuộc muốn làm gì?!",
    ["aside12073301"]="Xin các ngươi... đừng ép ta nữa!",
    ["aside12073401"]="…",
    ["aside12080101"]="Phía trước đó! Phải giải quyết đám quái vật này đã!",
    ["aside12080201"]="Được rồi, tới gần xem họ đang nói gì đi!",
    ["aside12080301"]="Không xong rồi, ở đây cũng có quái vật...",
    ["aside12080401"]="Nghĩa trang... lẽ nào là ở kia?",
    ["aside12080501"]="... Đứng lại, ai vậy!?",
    ["aside12080601"]="Dừng lại, đây chẳng phải Nhà Thám Hiểm sao?",
    ["aside12080701"]="(Tiếng hí...)",
    ["aside12080801"]="Tiếp theo là sau khi cầu nguyện, hãy uống nước từ Đài Phun Nước Trung Tâm...",
    ["aside12080901"]="Cuối cùng, là thu thập Cành Cây Du và Cành Tần Bì...",
    ["aside12081001"]="Đã xong, đi báo cho Tổng Giám Mục đi!",
    ["aside12081101"]="Nực cười! Thật là nực cười ha ha ha!",
    ["aside12081201"]="... Ngươi đang làm gì vậy?!",
    ["aside12081301"]="Được, ngay cả ngươi cũng...!",
    ["aside12081401"]="Bây giờ, xin các vị hãy nghe tôi nói.",
    ["aside12081501"]="Nhưng, nhưng mà...",
    ["aside12081601"]="Không xong rồi, bọn chúng quá đông...",
    ["aside12081701"]="Chẳng lẽ những người này đều là...!",
    ["aside12081801"]="Sao vậy, giờ lại nhớ kỹ rồi sao?",
    ["aside12081901"]="Cậu... sao lại...",
    ["aside12082001"]="... Azer, đừng có dại dột nữa!",
    ["aside12082101"]="Hầy. Sao có thể xảy ra chuyện này...",
    ["aside12082201"]="Ở phía dưới, rõ ràng những hộ vệ đó đã bao vây Đại Điện...",
    ["aside12082301"]="Sao có thể, những người hầu yến tiệc đó đi đâu hết rồi?",
    ["aside12082401"]="... Không cần tìm nữa.",
    ["aside12090101"]="Lần này phải ngoan ngoãn nghe lời rồi chứ!",
    ["aside12090201"]="... Chuyện này là sao?",
    ["aside12090301"]="... Nguy hiểm quá.",
    ["aside12090401"]="Chúc mừng bạn đã hoàn thành nhiệm vụ, Nhà Thám Hiểm.",
    ["aside12090501"]="Đây là?!",
    ["aside12090601"]="Sao những thứ này đánh mãi không chết vậy?!",
    ["aside12090701"]="Cảnh báo, cảnh báo. Nguy hiểm, nguy hiểm...",
    ["aside12090801"]="Nhân lúc bây giờ, chúng ta tiếp tục tiến lên nào!",
    ["aside12090901"]="Cảnh báo, cảnh báo. Nguy hiểm, nguy hiểm...",
    ["aside12091001"]="Hình như chúng càng ngày càng mạnh...",
    ["aside12091002"]="... Hãy cẩn thận, kẻ đột nhập nhất định là ở phía trước.",
    ["aside12091101"]="Ráng lên! Nhà Thám Hiểm!",
    ["aside12091201"]="Ta ở đây, Nhà Thám Hiểm.",
    ["aside12091301"]="Cộc cộc... Phù phù... o(*////▽////*)",
    ["aside12091302"]="Hừm... chạy nhanh thật đấy!",
    ["aside12091401"]="Cộc cộc cộc... Σ (⊙▽⊙",
    ["aside12091402"]="Phù... phù... Rốt cuộc nó dùng năng lượng gì vậy...",
    ["aside12091501"]="Cuối cùng cũng bắt được ngươi rồi!",
    ["aside12091601"]="Lần này phải ngoan ngoãn nghe lời rồi chứ!",
    ["aside12091701"]="Lẽ nào...?!",
    ["aside12091801"]="Những điều này là đủ.",
    ["aside12091901"]="Khà! A ha ha! Khà! Khà! Khà! Nhóc con, lâu ngày vẫn khoẻ chứ!",
    ["aside12091902"]="Ar... gota...",
    ["aside12092001"]="Đây là... cảnh tượng lặp lại?",
    ["aside12092101"]="Kết thúc rồi. Nhưng Lucy à, sao bạn biết trong cơ thể chú của bạn có quái vật?",
    ["aside12092102"]="Tôi cũng không biết... Lạ thật, vì sao nhỉ?",
    ["aside12092201"]="Tôi nghĩ tôi nên đi theo bạn. Nhà Thám Hiểm, Thần Khí đã tái hiện lại thời không sau khi bị bóp méo.",
    ["aside12092202"]="Cẩn thận, thời không bên đó lần đầu xuất hiện bóng dáng của người thứ ba.",
    ["aside12092301"]="Là Lucy và... Barr Venter?",
    ["aside12092401"]="Ma Vương sắp chết, Nhà Thông Thái một ngày sắp đến, người yêu trước bình minh xin hãy lắng nghe trái tim tôi.",
    ["aside12092402"]="Màn đêm chưa từng vén lên, sương mù bao trùm tâm hồn tôi, không cần phải bày tỏ cảm xúc thật của mình, tôi chỉ tin vào bản thân.",
    ["aside12092403"]="Tiếng gì vậy?!",
    ["aside12092501"]="Khụ, khụ... linh hồn tàn tạ quá, Thanatos, bạn muốn báo thù cho cô ấy ư?",
    ["aside12092502"]="Có điều, bạn thực sự có tư cách báo thù sao?",
    ["aside12092503"]="Nhờ có bạn mà đèn kéo quân của cô gái này thú vị đến thế, ta thực sự không nỡ giữ nó cho riêng mình.",
    ["aside12092601"]="Hoá ra trước khi hiến tế, linh hồn của cô ấy chỉ còn lại tiếc nuối và khổ đau.",
    ["aside12092602"]="Nếu nói muốn báo thù, bạn cũng là một trong những đối tượng báo thù nhỉ?",
    ["aside12092603"]="Vậy thì để tôi báo thù cho bạn, để hắn vĩnh viễn không bao giờ quên lỗi lầm của hắn...",
    ["aside12092604"]="Không!!!",
    ["aside12092701"]="Click... click... Đã tái hiện xong, có dịch chuyển ngay lập tức không?",
    ["aside12092702"]="Huỷ dịch chuyển, trở lại thời không ban đầu.",
    ["aside12092801"]="Tốt lắm, đây đúng là mô hình tôi cần!",
    ["aside12092901"]="Đang tính toán... Tính toán sai!!!",
    ["aside12093001"]="Linh hồn, thí nghiệm, Lucy máy móc.",
    ["aside12093002"]="Đang tính toán...",
    ["aside12093003"]="Đang tính toán...",
    ["aside12093004"]="Mốc thời gian: Năm AW706; Toạ độ địa lý: Bộ phát triển đầu tiên của Rekenber",
    ["aside12093101"]="Tốt lắm... Để tôi xem mức độ nhiễu sóng của vùng đất này.",
    ["aside12093201"]="Cảm ơn... cảm ơn mọi người... Khụ khụ...",
    ["aside12093401"]="Tốt lắm... Để tôi xem mức độ nhiễu sóng của vùng đất này.",
    ["aside12093601"]="đừng đến! ! !",
    ["aside12093701"]="Sóng? Bobo! Polly~Polly~",
    ["aside12093801"]="(nhai) làn sóng? Sóng! ! !",
    ["aside12093901"]="bạn đang làm gì vậy? Hãy bỏ chiếc Android của tôi đi, Zeny có thể đưa nó cho bạn!",
    ["aside12093902"]="Buông Trần Lưu ra, chúng ta nói chuyện một mình đi!",
    ["aside12093903"]="Được rồi, cậu, cậu để anh ấy đi trước...",
    ["aside12094001"]="tại sao vậy bạn? Anh đã làm gì với bác sĩ Miriam?",
    ["aside12094002"]="Chúng ta sẽ nói về nó trên đường đi, vì vậy hãy theo tôi trước!",
    ["aside12094101"]="Nhà thám hiểm! Nhìn xem tôi vừa làm xong gì này...ah, anh Trần Lưu...",
    ["aside12094102"]="Anh ấy để nó cho bạn!",
    ["aside12094201"]="Aimu, ra ngoài đi! ! !",
    ["aside12094202"]="Thi hành mệnh lệnh—tiêu diệt—kẻ xâm nhập—",
    ["aside12094301"]="Đừng cãi nữa, đi gặp Trần Lưu!",
    ["aside12094401"]="Chuyện này... sao chuyện này có thể xảy ra được?",
    ["aside12094501"]="Cho nguyên liệu vào nồi và đưa cho Chen Liu sau khi nấu chín.",
    ["aside12094601"]="Nhà thám hiểm, đây, đây~",
    ["aside12094701"]="Trần Lưu, không phải ngươi nói muốn đánh nhau sao?",
    ["aside12094702"]="Cái gì cơ? ……Ah! ! !",
    ["aside12094801"]="Xin chào~nhà thám hiểm~",
    ["aside12094901"]="Lùi lại! Không ai được phép lại gần!",
    ["aside12095001"]="Nhà Thám Hiểm?",
    ["aside12095101"]="Vù vù! Điều tra con người bí mật của chúng ta! Vù vù!",
    ["aside12095201"]="Đợi đã!",
    ["aside12095301"]="Suỵt... Nhà Thám Hiểm, qua bên này.",
    ["aside12095401"]="Nhà Thám Hiểm, bạn đến tìm cha của tôi sao?",
    ["aside12095501"]="Quả nhiên là vậy sao...",
    ["aside12095601"]="Đây là... Bắc Đẩu Thất Tinh!",
    ["aside12101001"]="Người thừa kế dòng máu Odin, tôi cảm nhận được sự khao khát quyền lực của bạn.",
    ["aside12101002"]="Gặp lại anh, mong em còn nhớ phương hướng em đã xuất phát.",
    ["aside12101101"]="Hmm...đó là mùi của kẻ thù.",
    ["aside12101201"]="Đây là bộ giáp được chế tạo bởi thợ rèn giỏi nhất thành phố cổ vào thời điểm đó...",
    ["aside12101301"]="Đây chính là tấm khiên đã bảo vệ chúng ta vô số lần...",
    ["aside12101401"]="Đây là một chiếc nỏ hạng nặng có thể bắn xuyên qua thép...",
    ["aside12101501"]="Bạn có... đến đây để gặp tôi về Rune Slate không?",
    ["aside12101502"]="Hãy vào đi, bạn xứng đáng nhận được câu trả lời.",
    ["aside12101601"]="Ai dám đột nhập vào hang ổ của tộc rồng chúng ta!",
    ["aside12101701"]="Ôi, chiến binh hoàn thành thử thách đã trở lại...",
    ["aside12105801"]="Anh chàng Mortos này thực sự...",
    ["aside12105901"]="Có rượu và hôm nay tôi say rồi~",
    ["aside12106001"]="Đã lâu không gặp, nhà thám hiểm.",
    ["aside12106101"]="Nhà Thám Hiểm?",
    ["aside12106201"]="Làm thế nào để đến gần con mèo đó...",
    ["aside12106301"]="Ngươi về rồi à!",
    ["aside12106401"]="Chính là nó!",
    ["aside12106501"]="Người du hành đến từ thế giới khác...có lẽ là anh ta",
    ["aside13000101"]="Hầm mỏ to thế này, biết đi đâu tìm Pha Lê Mana đây?",
    ["aside13000102"]="Ý, đây có phải là cung điện của quái vật hầm mỏ Giearth không?",
    ["aside13000103"]="Bọn chúng chắc biết chỗ nào có thể tìm thấy Pha Lê Mana!",
    ["aside13000201"]="Ờ, hay là cho con Giearth này vài mảnh đi.",
    ["aside13000301"]="Những con Quái Thây Ma đều không đáng thương xót...",
    ["aside13000302"]="Những lời như vậy, thật tội nghiệp chúng...",
    ["aside13000401"]="Uh oh oh oh! ! ! ! ! Hồn Ma Trắng đáng ghét!!!",
    ["aside13000402"]="Ai? Hình như ông ta cần giúp đỡ... Nghe có vẻ là ở tầng khác?",
    ["aside13000403"]="Đi tìm xem!",
    ["aside13000501"]="Mục sư này... là vong linh chưa siêu thoát sao?",
    ["aside13000502"]="Ngay cả khi đã chết, vẫn khắc ghi sứ mệnh cầu nguyện với Odin.",
    ["aside13000503"]="Ông ấy rất giống với vong linh lương thiện tôi từng gặp, không nên bị tiêu diệt",
    ["aside13000504"]="Tuy có chút làm trái nhiệm vụ của Tổng Giám Mục, nhưng tôi vẫn muốn giúp ông ấy!",
    ["aside13000601"]="Chính là cuốn này!... Đã rách nát lắm rồi, xem ra đã rất...",
    ["aside13000701"]="Ọe... Cho dù là rượu ngon, nhưng thời gian lâu như vậy cũng...",
    ["aside13000702"]="Mình không muốn ngửi thấy mùi này nữa.",
    ["aside13000801"]="Biến mất rồi... Chắc ông ấy đã quay về bên cạnh Odin.",
    ["aside13000901"]="Hở? Ở đó có người đến trước rồi sao?",
    ["aside13001001"]="Đi tìm cây đàn của Người Hát Rong?... Đây rốt cuộc là chuyện gì?",
    ["aside13001002"]="Không biết nữa... Đi tìm người hỏi xem.",
    ["aside13001101"]="Đây là đàn của anh ấy sao? Nên đưa nó cho Công Hội Misha không?",
    ["aside13001102"]="Nhưng nó là thứ quan trọng nhất của Caslisse, nên trả về chủ cũ!",
    ["aside13001103"]="Ta không thể chỉ vì thi đậu mà làm những chuyện trái chính nghĩa thế này!",
    ["aside13001104"]="Ờ, cứ làm vậy đi!",
    ["aside13001201"]="Nhưng nếu thế thì kỳ thi của người đó phải làm sao...",
    ["aside13001202"]="Có cần giúp hắn không?",
    ["aside13001301"]="(Xem ra giúp đúng người rồi, Nhà Thám Hiểm này không phải là người xấu)",
    ["aside13001401"]="Phù, phù... Có vẻ được rồi, tay ta sắp gãy luôn rồi...",
    ["aside13001402"]="Không không, cậu thế này còn kém xa.",
    ["aside13001403"]="Là... là ai?",
    ["aside13001501"]="Chạy mất rồi... Đúng là tên kỳ cục...",
    ["aside13001502"]="Nhưng mà thực sự rất nóng, thứ này không có độc chứ...",
    ["aside13001601"]="Quặng này đúng là hơi khác khác...",
    ["aside13001701"]="Thánh Điện Bình Minh, nơi bắt đầu cuộc đời thám hiểm của ta...",
    ["aside13001801"]="Cảm nhận được ma lực dào dạt ở bên trong!",
    ["aside13001901"]="Tấm vải thế này, tịnh hóa xong lại trở thành áo của Mục Sư... Thật kỳ diệu",
    ["aside13002001"]="Lớp da này cũng gia công được, tay nghề của Payon quả thật thần kỳ...",
    ["aside13002101"]="Cảm giác lạnh lẽo thấu xương này... thật sự khó chịu",
    ["aside13002201"]="Chấn động này là!? Động đất sao!",
    ["aside13002202"]="Phong ấn trong mỏ khoáng Mjolnir... đã rất nguy hiểm rồi.",
    ["aside13002203"]="Không thể chậm trễ, mau xuất phát!",
    ["aside13002301"]="Cho dù chỉ còn một Giearth cuối cùng, Mumu Be cũng không bỏ cuộc!",
    ["aside13002302"]="Giọng nói này là... Giearth?",
    ["aside13002401"]="Đám Myst này... có gì đó kỳ lạ!",
    ["aside13002402"]="Cẩn thận! Bây giờ chúng rất mạnh!",
    ["aside13002501"]="Đến rồi! Đây chính là mỏ Pha Lê Mana đầu tiên!",
    ["aside13002601"]="Pha lê và khe hở cùng biến mất rồi! Nhà Thám Hiểm, cậu giỏi lắm!",
    ["aside13002602"]="Khi khe hở không có nguy hiểm, pha lê cũng sẽ không hiện ra sao...",
    ["aside13002603"]="Chúng ta tiếp tục tìm pha lê khác!",
    ["aside13002701"]="Đám quái vật này định phá hủy pha lê! Nhất định phải ngăn cản chúng!",
    ["aside13002801"]="Cái thứ 2! Còn 2 cái... A, a, a, động đất!",
    ["aside13002802"]="Còn nghiêm trọng hơn lúc nãy... Xảy ra chuyện gì thế?",
    ["aside13002901"]="Chết tiệt, viên pha lê này... chúng ta đến muộn rồi sao.",
    ["aside13003001"]="Không được... Không thể phục hồi được.",
    ["aside13003002"]="Chúng ta mau đi đến pha lê tiếp theo!",
    ["aside13003003"]="Cẩn thận! Nhìn mức độ của trận động đất vừa rồi...",
    ["aside13003004"]="Có lẽ chúng ta sẽ gặp một kẻ địch mạnh.",
    ["aside13003101"]="Này này... đang đùa đúng không?!",
    ["aside13003201"]="Đuổi kịp rồi!",
    ["aside13003202"]="Tuyệt quá! Mumu Be và Nhà Thám Hiểm cùng giải cứu thế giới!",
    ["aside13003203"]="Nhưng vẫn có một phong ấn bị phá rồi...",
    ["aside13003204"]="Tuy Mumu Be không hiểu pháp thuật",
    ["aside13003205"]="Nhưng tất cả pha lê và khe nứt đều biến mất rồi, chắc không sao chứ?",
    ["aside13003206"]="Dù là thế...",
    ["aside13003301"]="Lại một tên đến ngăn cản Pharaoh vĩ đại hồi sinh!",
    ["aside13003302"]="Chặn Nhà Thám Hiểm này lại!!",
    ["aside13003303"]="Hồi sinh Pharaoh? Moi thêm chút tin tức gì đó từ chúng đi!",
    ["aside13003401"]="Đừng, đừng đánh nữa! Bọn ta khai, bọn ta khai!",
    ["aside13003501"]="(Người mà hắn nói... chính là Nhà Thám Hiểm đó ư?)",
    ["aside13003502"]="Này, ê! Đừng chạy! Đứng im!",
    ["aside13003503"]="Tiếng con gái?... Đi xem thử nào?",
    ["aside13003601"]="Kẻ nào?! To gan dám cản trở kế hoạch hồi sinh Pharaoh!",
    ["aside13003602"]="Các cậu bị ác quỷ đó lợi dụng rồi! Mục đích thật sự của nó là...",
    ["aside13003603"]="To gan! Dám vu khống đồng minh trung thành của ngài Seti!",
    ["aside13003604"]="Giết ngay không tha! Vệ Binh! Ra tay!",
    ["aside13003605"]="Hết cách rồi... Để họ yên nghỉ đi.",
    ["aside13003701"]="Chấn động này là sao thế!",
    ["aside13003702"]="(Giống hệt lúc trong mỏ khoáng! Có lẽ nào...)",
    ["aside13003801"]="Không khí quen thuộc này...",
    ["aside13003802"]="Ai Cập... Không, Midgard, hoàng đế của các cậu đã quay về rồi!",
    ["aside13003803"]="Seti Bệ Hạ trường tồn vĩnh cửu! Đế quốc Ai Cập bất tử!",
    ["aside13003804"]="Mấy tên này... thật khó dây vào!",
    ["aside13003805"]="Đừng để ý mấy tên lính ấy! Đánh bại Pharaoh là xong mà!",
    ["aside13003901"]="Được, vậy hãy xem manh mối thứ nhất đi.",
    ["aside13003902"]="Tiền triều mồ phủ rêu xanh, cỏ xuân nam thổ nỡ đành hận ai... nam, mộ...",
    ["aside13003903"]="Á! Mộ ở phía Nam! Đi tìm xem có nơi nào như thế không!",
    ["aside13004001"]="Á! Những đốm sáng này cộng hưởng với huyết mạch Odin!",
    ["aside13004002"]="Quả nhiên là ở đây!",
    ["aside13004101"]="Tốt, nơi phong ấn đầu tiên đã xong... Ý?",
    ["aside13004102"]="Hình như có thứ gì đang nhìn ta?",
    ["aside13004201"]="Biến mất rồi... Baphomet? Không đúng, trông giống như một bóng ma.",
    ["aside13004202"]="Kệ đi, mau tìm nơi tiếp theo! Manh mối thứ hai là...",
    ["aside13004203"]="Phía tây cát trải sắc xanh, trước ngôi đình cổ dưới cành liễu kia",
    ["aside13004204"]="Theo kinh nghiệm trước đây, thì chính là ngôi đình dưới gốc cây liễu ở phía tây rồi!",
    ["aside13004301"]="Ha ha! Quá dễ quá dễ! Lần này cũng truyền thêm sức mạnh...",
    ["aside13004401"]="Đã xong! Nhưng có phải thuận lợi quá không?",
    ["aside13004402"]="Cũng không có trở ngại gì... Á! Baphomet Jr. lại đến rồi!",
    ["aside13004501"]="Lại biến mất rồi... Sao nó không tấn công ta? Mục đích của nó là gì?",
    ["aside13004502"]="Kệ đi... Còn một manh mối nữa, làm nốt cho xong!",
    ["aside13004503"]="Đằng đông sông ở trên cao, Qua tây trút xuống tuôn trào như mưa.",
    ["aside13004504"]="Ha ha, tuy không hiểu lắm, nhưng chắc là chỗ nào đó có nước ở phía Đông!",
    ["aside13004601"]="Thì ra nghĩa là thác nước sao... Hay lắm! Đi thôi đi thôi!",
    ["aside13004701"]="Đến cuối cùng vẫn không bị tấn công... cảm thấy hơi kỳ lạ.",
    ["aside13004702"]="Lần sau nhìn thấy con Baphomet Jr. đó ta phải... Á! Xuất hiện rồi!",
    ["aside13004801"]="Luôn có dự cảm không lành...",
    ["aside13004901"]="Phán đoán của ta... Xin lỗi, Nhà Thông Thái Kroneika",
    ["aside13004902"]="Ta không thể bỏ mặc Payon, ta sẽ quay lại nhanh thôi!",
    ["aside13004903"]="Mong là đừng xảy ra bất trắc gì...",
    ["aside13005001"]="Có một dự cảm không lành...",
    ["aside13005002"]="Ba phong ấn đều đã gia cố xong, đi tìm Thầy Hướng Dẫn Sky Euin thôi.",
    ["aside13005101"]="Chim Pecopeco xuất hiện rồi! Cứ lặng lẽ đến gần như thế...",
    ["aside13005201"]="Tốt lắm! Thành công lấy được Lông Vũ rồi!",
    ["aside13005301"]="Một cảnh tượng giống như địa ngục...",
    ["aside13005302"]="Mọi người không sao chứ! Ta phải mau đến quảng trường trung tâm xem sao!",
    ["aside13005401"]="Nhà Thám Hiểm! Bên này!",
    ["aside13005402"]="Là Đoàn Trưởng Fitz!",
    ["aside13005501"]="Chạy mất rồi... Hình như phía trước có nguy hiểm gì đó?",
    ["aside13005502"]="Đám Ác Linh đang tấn công người dân! Đoàn Trưởng Fitz đang bảo vệ họ!",
    ["aside13005601"]="Mọi người mau theo tôi! Đừng rời khỏi đội!",
    ["aside13005602"]="Quân Phòng Vệ sẽ bảo vệ mọi người an toàn đến hoàng cung! Đừng hoảng sợ!",
    ["aside13005901"]="Mọi người mau theo tôi! Đừng rời khỏi đội!",
    ["aside13005902"]="Quân Phòng Vệ sẽ bảo vệ mọi người an toàn đến hoàng cung! Đừng hoảng sợ!",
    ["aside13006001"]="Ố la la la, Đại Lục Midgard! Hãy đón nhận sợ hãi đi!",
    ["aside13006002"]="B... Baphomet!? Kẻ địch thế này...",
    ["aside13006003"]="Đừng hoảng sợ! Đây chỉ là ảo ảnh sức mạnh của Baphomet!",
    ["aside13006004"]="Ha ha ha, đối phó với đám tạp chủng như các ngươi, chỉ cần ảo ảnh cũng đủ rồi!",
    ["aside13006005"]="Các Chiến Binh! Đừng lùi bước! Đây là sự giãy chết cuối cùng của địch thôi!",
    ["aside13006006"]="Kiên trì đến cùng, chính là thắng lợi của chúng ta!",
    ["aside13006101"]="Không... không thể nào! Không thể nào!",
    ["aside13006102"]="Loài người tầm thường... Loài người tầm thường!!!",
    ["aside13006103"]="Đừng xem thường loài người! Quay về Khe Nứt Thời Gian của ngươi đi, Baphomet!",
    ["aside13006104"]="Ngã xuống rồi...",
    ["aside13006105"]="Mọi người ơi, chúng ta thắng rồi!",
    ["aside13006106"]="Chúng ta đã bảo vệ Prontera trong Đêm Tai Họa của Baphomet!",
    ["aside13006107"]="Lịch sử sẽ khắc ghi tinh thần anh dũng bất khuất của các cậu!",
    ["aside13006108"]="Uh oh oh oh! ! ! ! !",
    ["aside13010101"]="Tìm được rồi, đây chắc chắn là Drubby!",
    ["aside13010201"]="Ui da! Cứu với!!!",
    ["aside13010301"]="A, tìm thấy rồi, cái túi này chắc là...",
    ["aside13010401"]="Odin ơi, đám thỏ này sao điên khùng vậy?",
    ["aside13020101"]="Đám Ong Thợ lại đến rồi, xem ta cho chúng bài học đây!",
    ["aside13020201"]="Chạy mau, ta che chắn cho cậu!",
    ["aside13020301"]="Ui... Sao chúng cứ đuổi theo mãi thế?",
    ["aside13020401"]="Mau đi thôi, ở đây đáng sợ quá!",
    ["aside13020501"]="Phù, cuối cùng cũng đến... Đợi đã, lại đến nữa sao?!",
    ["aside13020601"]="Tanders, cậu đúng là rắc rối!",
    ["aside13020701"]="Hừ!",
    ["aside13020801"]="Cúc cu! Cúc cu!",
    ["aside13020802"]="Cứu với... À, ý ta là, mau đến tham gia trận chiến thần thánh này đi!",
    ["aside13020901"]="A ha, ta biết chắc sẽ thắng mà!",
    ["aside13021001"]="Mau lên, đi theo con Ong Thợ này!",
    ["aside13021101"]="Hừ!",
    ["aside13021102"]="Có vẻ ở đây an toàn rồi.",
    ["aside13021201"]="Đợi đã, để ta quan sát kỹ càng đã... Hình như không đúng lắm.",
    ["aside13021301"]="Được, để ta thắp sáng nó!",
    ["aside13021401"]="Creamy đến vì con nhộng... Chúng ta phải bảo vệ nó!",
    ["aside13021501"]="Ta nhìn nhầm ư... Con nhộng này hình như lớn hơn rồi?",
    ["aside13021502"]="Hừ!",
    ["aside13021601"]="Phù! Nó thế này trông ổn hơn.",
    ["aside13030101"]="Kẻ thấp kém kia, mau bỏ bàn tay bẩn thỉu của ngươi ra!",
    ["aside13030201"]="Lui lại, đừng động vào những thứ quý giá...",
    ["aside13030301"]="Đây là... chúng ta phải giúp ngài Osiris!",
    ["aside13030401"]="Là ai... đã giết sứ giả Thế Giới Bóng Đêm?",
    ["aside13030501"]="Ây da ây da! Ồn chết được!",
    ["aside13030601"]="Đi mau, lễ đăng cơ sắp bắt đầu rồi!",
    ["aside13030602"]="Lễ đăng cơ? Lẽ nào là...",
    ["aside13030701"]="Này! Xem tranh phải trả tiền đấy!",
    ["aside13030801"]="Cậu đã được ta chấp nhận, sức mạnh này ban cho cậu...",
    ["aside13030901"]="Các cậu đến rồi.",
    ["aside13040101"]="Ý, sao tự nhiên Rosie biến mất rồi?",
    ["aside13040102"]="Lạ thật, sao tự nhiên đầu óc choáng váng...",
    ["aside13040201"]="Rosie cũng không ở đây? Lạ thật...",
    ["aside13040202"]="Trên người cậu chắc còn dư 1 ít Hương Thảo, hãy đốt chúng!",
    ["aside13040301"]="Không, sao nó... nó được thả ra rồi?!",
    ["aside13040302"]="Loài người ngu ngốc! Ha ha ha ha ha!",
    ["aside13040401"]="...Cậu hãy nhìn cho kỹ, kẻ đứng trước mặt cậu là ai!",
    ["aside13040402"]="Cậu là...?! Sao đầu ta choáng váng thế này...",
    ["aside13040501"]="Quả nhiên Phillas ở đây!",
    ["aside13040601"]="Cuối cùng sức mạnh của ta cũng đã phục hồi rồi, ha ha ha ha!!",
    ["aside13040701"]="Ảo giác... lại biến mất rồi?",
    ["aside13050101"]="Quả nhiên hoa đã nở!",
    ["aside13050102"]="Mau hái một ít tặng cho Thần Biển.",
    ["aside13060101"]="Ngài Alson ở đây!",
    ["aside13060201"]="Cứu tôi với!!! Ai mau đuổi đám Hải Tặc Xương Khô này đi!",
    ["aside13060301"]="Cảm ơn rất nhiều!",
    ["aside13060401"]="Tránh ra... Tránh ra! Đám Hải Quỳ đáng ghét các ngươi!!",
    ["aside13060501"]="Hừ hừ, cuối cùng cũng sạch sẽ rồi.",
    ["aside13060601"]="Á á, cứu tôi với!!! Sao khắp nơi đều là hồn ma vậy?!",
    ["aside13060701"]="Cảm ơn nhiều lắm!",
    ["aside13060801"]="Cậu là...?!",
    ["aside13060901"]="A, Vết Nứt Kỳ Lạ ở đằng kia!",
    ["aside13070101"]="Thứ phát sáng trên đất chắc là Cát Thời Gian? Qua đó xem thử!",
    ["aside13070201"]="A, tìm thấy rồi!",
    ["aside13070301"]="Quay về tìm thanh niên kia thôi!",
    ["aside13070401"]="Đây... đây là gì vậy?!",
    ["aside13070501"]="Rốt cuộc... đã xảy ra chuyện gì!",
    ["aside13070502"]="Ờ, tóm lại cứ đưa Cát Thời Gian cho Fulkyn trước đã.",
    ["aside13070601"]="Thứ phát sáng trên đất chắc là Cát Thời Gian? Qua đó xem thử!",
    ["aside13070701"]="Luồng sức mạnh này... lẽ nào lại là?!",
    ["aside13070801"]="... Ờ, tóm lại cứ đưa Cát Thời Gian cho Fulkyn trước đã.",
    ["aside13070901"]="Ủa? Cậu là...",
    ["aside13071001"]="Đây... đây là...!?",
    ["aside13071101"]="... Đúng rồi, còn có Cát Thời Gian!",
    ["aside13080101"]="Gầm gừ gầm gừ!!",
    ["aside13080102"]="Woa, trông nó có vẻ hưng phấn!",
    ["aside13080201"]="Ôi... Đau đầu quá...",
    ["aside13080301"]="A... có người đến trước một bước rồi.",
    ["aside13080401"]="Ờ, còn cài tóc này nữa cậu hãy nhận đi.",
    ["aside13080501"]="Opps!!",
    ["aside13080502"]="Ồ, trông nó có vẻ đau khổ!",
    ["aside13080601"]="Ôi... Đau đầu quá...",
    ["aside13080701"]="Xì... pi pa... xì!!",
    ["aside13080702"]="Ồ, trông nó có vẻ gấp gáp!",
    ["aside13080801"]="Ôi... Đau đầu quá...",
    ["aside13090101"]="Ô ô---",
    ["aside13090102"]="Ý, hình như nó phát hiện ra cái gì?",
    ["aside13090201"]="Ô ô---",
    ["aside13090202"]="Phía trước là...?!",
    ["aside13090301"]="Làm rất tốt!",
    ["aside13090401"]="Cậu đi chậm quá.",
    ["aside13090501"]="(A...)",
    ["aside13090601"]="Bà đây... sẽ không bỏ qua cho các ngươi...",
    ["aside13090701"]="Rốt cuộc các cậu đã làm gì?",
    ["aside13090801"]="(U... u... u...)",
    ["aside13090802"]="Tiếng gì thế!",
    ["aside13090901"]="Dám làm bị thương người hầu của ta! Đi chết đi!",
    ["aside13091001"]="Đây... chính là mộ của ta...",
    ["aside13100101"]="Thầy Hướng Dẫn, thì ta người ở đây!",
    ["aside13100201"]="Ngài hãy đi theo ta, thứ ấy ở ngay phía trước.",
    ["aside13100301"]="Thứ trên đất đó là...?",
    ["aside13100401"]="... Thầy Hướng Dẫn, cẩn thận!",
    ["aside13100501"]="Ngài mau đi theo ta!",
    ["aside13100601"]="Hơi thở của vị pháp sư này...!",
    ["aside13100701"]="Này, này! Cậu %^@#￥*&-?!",
    ["aside13100801"]="A ha, ta ngửi thấy mùi cổ vật!",
    ["aside13100901"]="Ý, thực sự không động đậy...",
    ["aside13101001"]="Chắc đủ rồi, mau đưa nó cho Wyatt đi!",
    ["aside13101101"]="Đến phía trước tìm thử xem, biết đâu vẫn còn manh mối nào đó...",
    ["aside13101201"]="Những pháp sư này lẽ nào là bị cùng một người...",
    ["aside13101301"]="Chết tiệt, tên kia chạy mất rồi!",
    ["aside13101401"]="A ha, ta ngửi thấy mùi cổ vật!",
    ["aside13101501"]="Khe nứt này là...?",
    ["aside13101601"]="Đợi đã, hình như trên đất có thứ gì...",
    ["aside13101701"]="...Ưm, đầu, đau quá...",
    ["aside13101702"]="Đến đây... đến bên cạnh Dracula cao quý vĩ đại...",
    ["aside13101703"]="Chỉ cần đưa cho ta Mảnh Trái Tim Ymir...",
    ["aside13101704"]="Là sẽ có được pháp lực vô tận, và cuộc sống vĩnh hằng...",
    ["aside13101801"]="Giết hắn, giết hắn... Hắn không đáng thương xót...",
    ["aside13101901"]="...Thi thể này là?",
    ["aside13102001"]="Giết hắn, giết hắn... Hắn đố kỵ sức mạnh của cậu...",
    ["aside13102101"]="Á á...! Sao chúng lại biến thành con người rồi?!",
    ["aside13102201"]="Giết cô ta, giết cô ta... Cô ta muốn mê hoặc cậu...",
    ["aside13102301"]="Đây là...?! Ta... rốt cuộc đã giết ai?!",
    ["aside13102401"]="Haha, chào mừng ngươi, loài người đã tắm trong máu tươi mà đến!",
    ["aside13102501"]="Đợi đã, phía trước là...?",
    ["aside13102502"]="Ôi... A a a!!!",
    ["aside13102601"]="Ưm... Ta, đây là...",
    ["aside13110101"]="Đây chắc là chỗ ở của De'qeen. Không biết hắn có nhà không?",
    ["aside13110201"]="...Hay là không nghe thấy? Hay đi xung quanh kiểm tra một vòng.",
    ["aside13110301"]="Đợi đã, có thứ gì rơi ra...",
    ["aside13110401"]="Chuyện này là sao... Mau nói chuyện này cho Katrina biết.",
    ["aside13110501"]="Á, a, thật là khó hiểu!",
    ["aside13110601"]="Cái này chắc là Hộc Ký Sinh.",
    ["aside13110701"]="Loài người đáng chết, không được đụng vào những thứ trong rừng, Goblin!!",
    ["aside13110801"]="Đợi đã, hình như phía trước có tiếng người...",
    ["aside13110802"]="Lẽ nào là hổ phách bị chiếm hữu? Mau vứt bom choáng qua đó!",
    ["aside13110901"]="Thuật Sĩ Luyện Kim này lẽ nào là De'qeen? Mau thả bom choáng thử xem!",
    ["aside13111001"]="Ui chao, vẫn có người còn giữ thứ này.",
    ["aside13111101"]="Ờ, thật là bất ngờ.",
    ["aside13111201"]="Ơ... Đợi đã, cảm giác này...?!!",
    ["aside13111301"]="Bây giờ, hãy kể hết mọi chuyện cho Jesqurienne đi!",
    ["aside13120101"]="...Ý? Người đâu hết rồi?",
    ["aside13120201"]="Này, đợi đã... Có gì từ từ nói!",
    ["aside13120301"]="Nhìn kìa, phía trước chắc là thương đội vận chuyển nguyên liệu quý hiếm đó!",
    ["aside13120401"]="...A, sao lại là cậu!",
    ["aside13120402"]="A a... Làm sao đây, phải làm sao đây!!",
    ["aside13120501"]="Nhà kho thủ lĩnh thương đội nhắc đến, chắc là ở đây?",
    ["aside13120602"]="Đi, đi tìm hiểu một chút!",
    ["aside13120701"]="Những thứ này... cậu có cảm thấy kỳ lạ không?",
    ["aside13120801"]="Ây dô, ây dô... Hết rồi, hết rồi!!!",
    ["aside13120901"]="Đợi đã, phía trước là...?",
    ["aside13121001"]="Cái đó chắc là thảo dược... lẽ nào đám lưu manh nhảy vào Tổ Kiến Bí Mật rồi?",
    ["aside13121101"]="Nhìn xem, hình như trên đất lại rơi ra cái gì...",
    ["aside13121201"]="Biết đâu phía trước vẫn còn, mau đi xem!",
    ["aside13121301"]="Đợi đã, phía đằng kia là... thùng gỗ đựng thảo dược?!",
    ["aside13121401"]="Bạn của tôi, cậu phải hiểu rõ tình hình.",
    ["aside13121501"]="Hừ, thật rắc rối. Đi, chúng ta áp giải cô ta về Công Hội Sát Thủ!",
    ["aside13121601"]="...Chị...Chị Goldie?!",
    ["aside13121701"]="Đây là... Goldie? Goldie về rồi!",
    ["aside13121801"]="Tuyệt đối không thể... để ngươi mang đứa trẻ này đi...",
    ["aside13121901"]="Woa! Chị Goldie đến rồi!!",
    ["aside13122001"]="Hu hu, các ngươi ức hiếp người...",
    ["aside13122101"]="Không ổn rồi... cứu, cứu với!!",
    ["aside13122201"]="Blanche, Jean... Các cậu không sao chứ?!",
    ["aside13122301"]="Cái này chắc là con quái vật kia để lại, đến phía trước xem xem!",
    ["aside13122401"]="Nó chạy về hướng này, tìm nữa xem.",
    ["aside13122501"]="Tốt lắm, dấu chân này chắc nó ở không xa đâu!",
    ["aside13122601"]="Chết tiệt, nó lại chạy mất rồi, mau đuổi theo!",
    ["aside13122701"]="Đó là...?!",
    ["aside13122801"]="Nguy! Nó không những biến lớn hơn, mà sức mạnh cũng tăng...",
    ["aside13122901"]="Thế này vốn dĩ đánh không lại, phải thoát trận chiến nghĩ cách khác thôi!",
    ["aside13123001"]="Trong này có chuyện kỳ lạ, phải nói cho Laninster biết.",
    ["aside13123101"]="Được rồi, giờ đem tấm hình này cho Norten!",
    ["aside13123201"]="Phía trước là xác quái vật đã bị Chimera gặm nhấm...",
    ["aside13123301"]="Trên đó chắc còn dính nước bọt.",
    ["aside13123401"]="Xong rồi, mau đưa cho Norten!",
    ["aside13123501"]="Lớp bụi này... thử xem có lau sạch không!",
    ["aside13123601"]="Kẻ kích hoạt lời nguyền... là chỉ Hellas sao?",
    ["aside13123701"]="Mau nói cho anh ấy biết.",
    ["aside13123801"]="...Lời nguyền biến mất rồi? Mau đi tìm Chimera!",
    ["aside13140101"]="Đợi đã,phía trước là...?",
    ["aside13140201"]="Ờ, tình hình này...",
    ["aside13140301"]="...Không có phản ứng sao. Đổi nơi khác thử xem!",
    ["aside13140401"]="...Ơ? Phía bên kia thì sao?",
    ["aside13140501"]="Thì ra là thế, ta hiểu rồi.",
    ["aside13140601"]="Còn thiếu cây thủy sinh mềm, ra bờ sông chắc có đấy!",
    ["aside13140701"]="Được rồi, đưa chúng cho Sai Yilian!",
    ["aside13140801"]="...Lạ thật, Sai Yilian chưa quay về sao?",
    ["aside13140901"]="Xung quanh cũng không thấy bóng dáng anh ấy, đây rốt cuộc là...",
    ["aside13140902"]="...Cậu đến đúng lúc lắm!",
    ["aside13141001"]="Hình như trên tường có 1 viên gạch bị xê dịch...",
    ["aside13141101"]="Đây là... cơ quan đã bị kích hoạt? Quay về xem thử!",
    ["aside13141201"]="...Đau, đau quá!!",
    ["aside13141301"]="...Cái lá này là?!",
    ["aside13141401"]="Ở đây còn có lá đánh dấu... có vẻ đúng hướng rồi!",
    ["aside13141501"]="Ta cảm thấy Sai Yilian ở gần đây!",
    ["aside13141601"]="Tiêu rồi, Sai Yilian gặp nguy hiểm!",
    ["aside13141701"]="...Nhà Thám Hiểm, đủ rồi đấy!",
    ["aside13150101"]="Tinh linh sáng chói... chẳng lẽ là đốm sáng di động kia?",
    ["aside13150201"]="Được rồi, đưa nó cho Fulkyn đi!",
    ["aside13150301"]="Đây... đây là?!",
    ["aside13150401"]="Cảm giác kỳ lạ này...",
    ["aside13150402"]="...Nhà Thám Hiểm, đi cẩn thận!",
    ["aside13150501"]="Đã bắt đầu rồi sao...",
    ["aside13150601"]="Đợi đã, gần đây có tiếng động...",
    ["aside13150701"]="Hỏng rồi, Thanatos gặp nguy hiểm!",
    ["aside13150801"]="Lần này còn cho rằng ta điên nữa không?",
    ["aside13150901"]="Mấy sợi tóc này... mau đến phía trước tìm hiểu xem!",
    ["aside13151001"]="Lẽ nào chủ nhân dấu chân này đã vào Tu Viện? Mau đi xem thử!",
    ["aside13151101"]="Dana...tos...",
    ["aside13151201"]="...Ta đã đánh giá thấp cậu.",
    ["aside13151301"]="Đây là...?!",
    ["aside13151302"]="Kết thúc ở đây đi.",
    ["aside13151401"]="Đợi đã...",
    ["aside13151501"]="Đã lâu không gặp, Fulkyn...",
    ["aside13160101"]="Được rồi, mau mang những thứ này đến cho Tổng Giám Mục Wolmas đi.",
    ["aside13160201"]="Hãy dùng chất nhầy vẫn đục này thử lại xem.",
    ["aside13160301"]="...Đúng như dự đoán, ta biết rồi.",
    ["aside13160401"]="...Đây, đây là?!",
    ["aside13160501"]="Vậy thì nhờ ngươi nhé.",
    ["aside13160601"]="Đây, đây là...!!",
    ["aside13160701"]="Được rồi, bây giờ hãy cố gắng thuần phục nó đi.",
    ["aside13160801"]="Nhà Thám Hiểm, kết quả điều tra thế nào",
    ["aside13160901"]="...Này! Đứng lại!",
    ["aside13161001"]="Cách ăn mặc của những người này, đúng là rất giống phong cách của Vương Quốc...",
    ["aside13161101"]="1, 2, 3... có tổng cộng 11 thùng hàng?",
    ["aside13161102"]="Đây là một Sứ Đoàn quy mô nhỏ, nhưng lại có nhiều hàng hóa trao đổi vậy sao?",
    ["aside13161201"]="...Đợi đã! Không được đụng vào những thùng hàng này!",
    ["aside13161301"]="Hai người này vừa rồi... đã nhắc đến Quốc Vương sao?!",
    ["aside13161401"]="Chẳng lẽ người họ nói đến là... phải theo qua đó xem thử!",
    ["aside13161501"]="Nguy rồi, phía trước có nhiều quái vật quá...",
    ["aside13161601"]="Những thứ này rốt cuộc là?! Cần phải báo cáo cho chỉ huy Bohr!",
    ["aside13161701"]="Xong rồi, mau mang ảnh chụp đến cho Vera đi!",
    ["aside13161801"]="Được rồi, mang nguyên liệu may áo đến cho Vera đi.",
    ["aside13161901"]="Phía trước chính là nơi đóng trại của Sứ Đoàn. Thay đồ Giáo Quốc vào trước đã.",
    ["aside13162001"]="Bây giờ, mau nhân lúc không có ai để điều tra thùng hàng đi!",
    ["aside13162101"]="Những hàng hóa này trông rất bình thường... đi xem những thùng hàng khác xem sao.",
    ["aside13162201"]="Chíu... phốc!",
    ["aside13162202"]="...Nguy rồi!!!",
    ["aside13162301"]="...Vừa rồi là tiếng gì thế?",
    ["aside13170101"]="...Này! Đứng lại!",
    ["aside13170201"]="Cách ăn mặc của những người này thực sự trông không giống phong cách của vương quốc...",
    ["aside13170301"]="1, 2, 3... tổng cộng có 11 thùng hàng?",
    ["aside13170302"]="Sứ đoàn quy mô nhỏ như vậy, có nhiều vật tư để đổi vậy sao?",
    ["aside13170401"]="...Khoan đã! Đừng chạm vào những chiếc thùng này!",
    ["aside13170501"]="Hai người này vừa rồi... nhắc tới Quốc Vương?!",
    ["aside13170601"]="Chẳng lẽ người mà chúng nói là... phải đi theo xem thử!",
    ["aside13170701"]="Nguy rồi, phía trước nhiều quái vật quá...",
    ["aside13170801"]="Rốt cuộc những chuyện này là sao?! Phải mau báo cho quan chỉ huy Bohr!",
    ["aside13170901"]="Xong rồi, đưa bức ảnh cho Vera đi!",
    ["aside13171001"]="Được rồi, mang nguyên liệu may áo đến cho Vera đi.",
    ["aside13171101"]="Phía trước là nơi đóng quân của sứ đoàn. Mặc quần áo giáo quốc vào trước.",
    ["aside13171201"]="Bây giờ, nhân lúc không có ai mau đi điều tra các thùng vật tư đi!",
    ["aside13171301"]="Những vật tư này nhìn có vẻ bình thường... đi kiểm tra các thùng khác một chút.",
    ["aside13171401"]="Chíu... póc~!",
    ["aside13171402"]="...Nguy rồi!!!",
    ["aside13171501"]="...Vừa rồi là tiếng gì thế?",
    ["aside13180301"]="Này, ngươi lại đây, mau nhìn kìa...",
    ["aside13180401"]="Ối. Lại xuất hiện rồi sao...",
    ["aside13180601"]="...Này! Không được chạm vào lời nhắn của Thần Sứ để lại!",
    ["aside13180602"]="Giờ thì tạm ổn rồi. Đi giải hòa với chỉ huy đội bảo vệ đi!",
    ["aside13180901"]="Vừa rồi đúng là nghìn cân treo sợi tóc.",
    ["aside13181001"]="...Không ngờ lại là ngươi!",
    ["aside13190101"]="Những dấu chân này... đi theo xem thử.",
    ["aside13190201"]="Phải nhanh lên...",
    ["aside13190301"]="Ahhh...!!",
    ["aside13190401"]="Ahhh...!!",
    ["aside13190402"]="…",
