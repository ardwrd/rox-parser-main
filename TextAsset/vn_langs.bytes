    ["ui_Kingdom_014"]="Số trúng kỳ này: ",
    ["ui_Kingdom_015"]="Nhập số",
    ["ui_Kingdom_016"]="Dự đoán Sử Ký",
    ["ui_Kingdom_017"]="Nhận",
    ["ui_Kingdom_018"]="Chưa trúng",
    ["ui_Kingdom_019"]="Rút số May Mắn",
    ["ui_Kingdom_020"]="Người Ghi Chép sẽ dựa vào báo cáo của nhân viên để ghi chép lại những chuyện Vương Quốc đã xảy ra <color=#338dc3>trong tuần</color>.",
    ["ui_Kingdom_021"]="Thống kê dữ liệu sự kiện <color=#338dc3>kết thúc vào thứ bảy</color>, sự kiện phát sinh trong ngày CN sẽ không được ghi chép.",
    ["ui_Kingdom_022"]="<color=#338dc3>12:00 CN hàng tuần</color>, Người Ghi Chép Vương Quốc sẽ bốc số may mắn các loại sự kiện <color=#338dc3>khác nhau</color> <color=#338dc3>theo thứ tự ngẫu nhiên</color>.",
    ["ui_Kingdom_023"]="Nếu số trúng giải đặc biệt được nhiều Nhà Thám Hiểm cùng chọn, kết quả sẽ phán định dựa theo <color=#338dc3>thời gian đặt cược</color>, tối đa chỉ được <color=#338dc3>5</color> người cùng trúng.",
    ["ui_Kingdom_024"]="Số lượng giải may mắn được tạo ngẫu nhiên mỗi kỳ và tỉ lệ thuận với <color=#338dc3>tổng số</color> rút thăm may mắn.",
    ["ui_Kingdom_025"]="Người chơi có số trùng với số may mắn nhưng vượt quá số phần thưởng may mắn, <color=#338dc3>phần thưởng dự đoán</color> không đổi, nhưng không thể nhận thêm nhiệm vụ từ Người Ghi Chép Vương Quốc.",
    ["ui_Kingdom_026"]="Người Con Thiên Mệnh",
    ["ui_Kingdom_027"]="Nếu kỳ dự đoán xuất hiện nhiều Người Con Thiên Mệnh sẽ dựa vào <color=#338dc3>thời gian đặt cược</color> để chọn người trúng giải đầu tiên.",
    ["ui_Kingdom_028"]="Mỗi ngày được <color=#338dc3>Hobnob 1 lần</color>, sau khi may mắn sẽ nhận 1 phần quà từ Vua May Mắn.",
    ["ui_Kingdom_029"]="Mỗi ngày Hobnob sẽ giúp tăng <color=#338dc3>may mắn</color> cho bản thân!",
