    ["ui_Re0_018"]="Đã nhận",
    ["ui_Re0_019"]="Làm mới mức tiêu thụ:",
    ["ui_Re0_020"]="Chỉ có thể chọn một NPC để hoàn thành nhiệm vụ tương ứng mỗi ngày",
    ["ui_Re0_021"]="Gửi bạn:",
    ["ui_Re0_022"]="Bấm vào Emilia để quay lại",
    ["ui_Re0_023"]="Click Subaru Natsuki để quay lại",
    ["ui_Re0_024"]="Bấm vào Rem để quay lại",
    ["ui_Re0_025"]="Du khách đến từ thế giới khác",
    ["ui_Re0_026"]="Phần thưởng sẽ được phân phối sau khi sự kiện kết thúc",
    ["ui_Re0_027"]="Danh sách tổng thể của Emilia",
    ["ui_Re0_028"]="Danh sách tổng thể của Natsuki Subaru",
    ["ui_Re0_029"]="Xếp hạng Rem",
    ["ui_Re0_030"]="Emilia gửi cho bạn lời mời dự tiệc trà. Đăng nhập tổng cộng bảy ngày để nhận được phần thưởng hậu hĩnh.",
    ["ui_Re0_031"]="Trong thời gian sự kiện, đăng nhập tổng cộng 7 ngày để nhận tất cả phần thưởng.",
    ["ui_Re0_032"]="Đăng nhập và thu thập trong vòng 7 ngày\n<size=20><color=#F2D376>Trân trọng những phần thưởng</color></size>",
    ["ui_Re0_033"]="Đang chờ nhận phòng",
    ["ui_Re0_034"]="Hãy chọn một trong ba nghề nghiệp sau",
    ["ui_Re0_035"]="Lựa chọn trận đấu đã hoàn tất",
    ["ui_Re0_036"]="Bắt đầu khiêu chiến",
    ["ui_Re0_037"]="1. Mỗi lần vào trò chơi, bạn có thể chọn nghề nghiệp, thẻ bài, thú cưng, v.v. để tiến hành BD và tạo thành đội hình mạnh nhất để vượt qua cấp độ.",
    ["ui_Re0_038"]="2. Có 10 đợt quái vật trong trò chơi. Hãy cố gắng sống sót càng nhiều đợt càng tốt trước khi chết.",
    ["ui_Re0_039"]="3. Khi giải quyết, phần thưởng sẽ được giải quyết dựa trên cấp độ mà người chơi hiện đã hoàn thành.",
    ["ui_Re0_040"]="4. Bạn sẽ nhận được một phần thưởng sau mỗi 48 giờ và số lượng phần thưởng có thể được tích lũy lên tới 4 lần.",
    ["ui_Re0_041"]="Từ bỏ thiết lập lại",
    ["ui_Re0_042"]="Sự nghiệp mở trong tuần này",
    ["ui_Re0_043"]="Lớp",
