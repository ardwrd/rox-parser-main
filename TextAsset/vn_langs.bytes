    ["DialogueOption92202011"]="(Nói rõ tường tận)",
    ["DialogueOption92202021"]="Nhờ cậu đấy!",
    ["DialogueOption92204011"]="Có cách nào để giải quyết không?",
    ["DialogueOption92205021"]="Thành công rồi?",
    ["DialogueOption92205031"]="Cảm ơn cậu!",
    ["DialogueOption92301011"]="Chán hả?",
    ["DialogueOption92301021"]="Kích thích?",
    ["DialogueOption92301031"]="Trò chơi đáng sợ…",
    ["DialogueOption92302011"]="Những nơi này là…",
    ["DialogueOption92302031"]="Chọn xong chưa?",
    ["DialogueOption92302041"]="Vậy quyết định nhé?",
    ["DialogueOption92303011"]="Sợ chưa?",
    ["DialogueOption92304011"]="Sao vậy?",
    ["DialogueOption92304021"]="Phụt…",
    ["DialogueOption92304041"]="Ha ha ha ha!",
    ["DialogueOption92304061"]="Làm gì có, làm gì có",
    ["DialogueOption92401011"]="Được rồi, không sao rồi",
    ["DialogueOption92401021"]="(Thử ôm nó)",
    ["DialogueOption92402011"]="Được rồi, tới đây nào",
    ["DialogueOption92402021"]="Ý, đây là…",
    ["DialogueOption92403011"]="Làm gì đấy?",
    ["DialogueOption92403031"]="Chờ đã!",
    ["DialogueOption92404011"]="Muốn ta đi vào à…",
    ["DialogueOption92405021"]="Xem ra bạn cũng là…",
    ["DialogueOption92405041"]="Việc trước mắt là…",
    ["DialogueOption92405042"]="Phải sắp xếp cho bọn nó…",
    ["DialogueOption92405043"]="Rồi tìm chủ của chúng…",
    ["DialogueOption92406011"]="Là của bạn thì ổn rồi…",
    ["DialogueOption92406031"]="Trên đường đến đây?",
    ["DialogueOption92406041"]="Một thế giới khác?",
    ["DialogueOption92406042"]="Ngầu thế…",
    ["DialogueOption92406061"]="Ta có thể giúp bạn",
    ["DialogueOption92406071"]="Không thành vấn đề!",
    ["DialogueOption92501011"]="Ta có để ý thấy…",
    ["DialogueOption92501021"]="…Vậy phải làm sao",
    ["DialogueOption92501031"]="Ta nghĩ xem....",
    ["DialogueOption92501041"]="Hiểu rồi",
    ["DialogueOption92502031"]="Xem nơi này là một ngôi nhà khác",
    ["DialogueOption92502041"]="Sao thế?",
    ["DialogueOption92502061"]="Mũ Beret...",
    ["DialogueOption92502062"]="(Tên xe)…",
    ["DialogueOption92502101"]="…Cảm ơn cậu",
    ["DialogueOption92601011"]="Xảy ra chuyện gì?",
    ["DialogueOption92601021"]="Có biết lý do không?",
    ["DialogueOption92601041"]="Cậu đã nói thế rồi…",
    ["DialogueOption92601042"]="Ta giúp cậu hỏi xem sao…",
    ["DialogueOption92602031"]="Vậy cậu mau nói đi",
    ["DialogueOption92603011"]="Vậy phải làm sao",
    ["DialogueOption92603021"]="(Vẫy tay)",
    ["DialogueOption92603051"]="...Hả? ?",
    ["DialogueOption92604011"]="Thấy cậu đứng ở đây…",
    ["DialogueOption92604012"]="Muốn hỏi cậu bị làm sao…",
    ["DialogueOption92604021"]="Giấu?",
    ["DialogueOption92604031"]="? !",
    ["DialogueOption92604041"]="Quán Rượu Sa Mạc...",
    ["DialogueOption92604042"]="Vừa nói định cho cậu…",
    ["DialogueOption92701011"]="Làm sao thế?",
    ["DialogueOption92701021"]="Ồ…",
    ["DialogueOption92701031"]="Như vậy chẳng phải rất tốt à",
    ["DialogueOption92701041"]="Còn điều gì khó nói à?",
    ["DialogueOption92702011"]="Ta vừa đúng lúc….",
    ["DialogueOption92702031"]="Đến Payon trước…",
    ["DialogueOption92702032"]="Sau đó là Morroc…",
    ["DialogueOption92702033"]="Cuối cùng là Geffen…",
    ["DialogueOption92702041"]="Ta thấy khá ổn",
    ["DialogueOption92703011"]="Vui đến thế à?",
    ["DialogueOption92703031"]="Được",
    ["DialogueOption92704011"]="Muốn làm gì à?",
    ["DialogueOption92704031"]="Đây là...",
    ["DialogueOption92704061"]="Vậy không khách sáo nhé~",
    ["DialogueOption92801011"]="Sao thế?",
    ["DialogueOption92801041"]="Ta cố gắng vậy",
    ["DialogueOption92802011"]="Rowan anh ấy…",
    ["DialogueOption92802021"]="Có gì bất thường sao?",
    ["DialogueOption92803011"]="Cậu không sao chứ?!",
    ["DialogueOption92803021"]="...Hả?",
    ["DialogueOption92803031"]="...?",
    ["DialogueOption92803041"]="Đúng thế.",
    ["DialogueOption92803051"]="Được thôi…",
    ["DialogueOption92804011"]="Hắn nói là bạn của cậu",
    ["DialogueOption92804031"]="Hình như cậu ta đến từ…",
    ["DialogueOption92804032"]="Một thế giới khác…",
    ["DialogueOption92804091"]="Ta cũng gặp may thôi…",
    ["DialogueOption92901031"]="你可以去问问呀~",
    ["DialogueOption92902011"]="你好，天使小姐~",
    ["DialogueOption92902021"]="你来自异世界？",
    ["DialogueOption92902031"]="这里是米德加兹",
    ["DialogueOption92902051"]="我带你去见他！",
    ["DialogueOption92903021"]="（讲述原委）",
    ["DialogueOption92903051"]="别哭了别哭了",
    ["DialogueOption92903061"]="再哭打你哦",
    ["DialogueOption92903062"]="我替你抓鱼？",
    ["DialogueOption92904011"]="不要太过分哦",
    ["DialogueOption92905011"]="是异世界的客人",
    ["DialogueOption93001011"]="你怎么啦？",
    ["DialogueOption93001021"]="没有",
    ["DialogueOption93001041"]="我们一起找",
    ["DialogueOption93001051"]="交给我吧！",
    ["DialogueOption93002011"]="<color=#CA2E0AFF>奈斯在城外！</color>",
    ["DialogueOption93003011"]="（讲述原委）",
    ["DialogueOption93004011"]="你……",
    ["DialogueOption93004021"]="莱奥？",
    ["DialogueOption93004071"]="沃尔玛斯大主教……",
    ["DialogueOption93005021"]="可是……",
    ["DialogueOption93005031"]="是的",
    ["DialogueOption93006011"]="成功了！",
    ["DialogueOption93006012"]="或许没有……",
    ["DialogueOption93101031"]="《笑话大全》",
    ["DialogueOption93101032"]="《卢恩秘史》",
    ["DialogueOption93101051"]="我也要看！",
    ["DialogueOption93102011"]="你好？",
    ["DialogueOption93102041"]="（说明原委）",
    ["DialogueOption93103031"]="什么比赛？",
    ["DialogueOption93103141"]="（放下书）我也去！",
    ["DialogueOption93104011"]="（叙述原委）",
    ["DialogueOption93105021"]="诶？？？",
    ["DialogueOption93105031"]="（叙述原委）",
    ["DialogueOption93201011"]="开心",
    ["DialogueOption93201012"]="不开心",
    ["DialogueOption93201031"]="好呀好呀~",
    ["DialogueOption93201041"]="可以找忽克连！",
    ["DialogueOption93202021"]="我是来……",
    ["DialogueOption93202031"]="……",
    ["DialogueOption93202051"]="……",
    ["DialogueOption93301091"]="怎么啦？",
    ["DialogueOption93301121"]="不是说没问题？",
    ["DialogueOption93301131"]="那如果成功了呢？",
    ["DialogueOption93301141"]="希望是这样……",
    ["DialogueOption93301161"]="走吧~",
    ["DialogueOption93302021"]="你怎么了？",
    ["DialogueOption93302041"]="（看向金希澈）",
    ["DialogueOption93303011"]="你还好吗？",
    ["DialogueOption93304011"]="（说明来意）",
    ["DialogueOption93304051"]="您说？",
    ["DialogueOption93305011"]="你恢复了？",
    ["DialogueOption93305031"]="里面是什么？",
    ["DialogueOption93401011"]="喜欢！",
    ["DialogueOption93401012"]="不喜欢……",
    ["DialogueOption93401041"]="好呀",
    ["DialogueOption93402161"]="我们一起去吧",
    ["DialogueOption93403011"]="你这是？",
    ["DialogueOption93404011"]="千岁酿？",
    ["DialogueOption93404091"]="可是你一个人…",
    ["DialogueOption93405011"]="还没",
    ["DialogueOption93405021"]="看那边！",
    ["DialogueOption93501011"]="彩排？",
    ["DialogueOption93501021"]="你要表演什么？",
    ["DialogueOption93501031"]="好吧……",
    ["DialogueOption93501032"]="那我不看了……",
    ["DialogueOption93501061"]="玫瑰红酒馆？",
    ["DialogueOption93501062"]="花瓣？",
    ["DialogueOption93502011"]="（说明来意）",
    ["DialogueOption93502041"]="我有不好的预感",
    ["DialogueOption93502051"]="一言为定！",
    ["DialogueOption93504011"]="嗯嗯！",
    ["DialogueOption93504031"]="你怎么了？",
    ["DialogueOption93504041"]="还有不正常的？",
    ["DialogueOption93505051"]="润喉糖？",
    ["DialogueOption93505071"]="只买一颗！",
    ["DialogueOption93506011"]="好呀",
    ["DialogueOption93506021"]="好的！",
    ["DialogueOption93506031"]="然后呢",
    ["DialogueOption93506041"]="？？？",
    ["DialogueOption93506051"]="？？？",
    ["DialogueOption93506061"]="这就是你的节目？",
    ["DialogueOption93506071"]="那迎新典礼……",
    ["DialogueOption93506081"]="……",
    ["DialogueOption93601011"]="这是邀请吗？",
    ["DialogueOption93601031"]="你喜欢什么？",
    ["DialogueOption93601041"]="游戏机是什么？",
    ["DialogueOption93601051"]="……",
    ["DialogueOption93601061"]="绮丝克莉茵会长…",
    ["DialogueOption93601071"]="目前还不确定",
    ["DialogueOption93602011"]="（说明来意）",
    ["DialogueOption93603011"]="是的",
    ["DialogueOption93604011"]="（说明来意）",
    ["DialogueOption93605021"]="我明白了！只要在脑海里，把通关的游戏再二周目一次就可以了对吧！",
    ["DialogueOption93605031"]="啊……总之我会努力想着游戏机的，请您尽管施法吧~",
    ["DialogueOption93606021"]="<color=#CA2E0AFF>我的礼物呢~</color>",
    ["DiamondAmountTips"]="Tổng nguồn cung kim cương hiện tại:%d\nSố lượng kim cương mà nhà buôn không thể liệt kê:%d",
    ["DifferentEquipmentQuality"]="Trang bị khác phẩm chất không thể kế thừa thuộc tính Tinh Luyện.",
    ["Diolague31001"]="Thực ra cũng không có chuyện gì quan trọng, chỉ là hơi nhớ cậu thôi, nhìn cậu rất có tinh thần đó!",
    ["Disguised"]="Phương án này đã trang trí.",
    ["DismantleFirst"]="Sau khi tháo Đá Yểm Bùa, mới được khảm.",
    ["DisplayCase_EffectEmpty"]="Hãy thêm một món Thời Trang ngoại hình",
    ["DisplayCase_EffectTypeTips"]="Đã cài đặt hiệu ứng <color=#CA2E0AFF>%s</color> trong Tủ Trưng Bày, nếu cần cài đặt hiệu ứng khác, hãy xóa Thời Trang trong Tủ Trưng Bày.",
    ["DisplayCase_Empty"]="Hiện chưa nhận được Thời Trang ngoại hình, mau thu thập nào!",
    ["DisplayCase_EmptyTips"]="Hãy chọn một món Thời Trang ngoại hình",
    ["DisplayCase_FullTips"]="Chỉ được trưng bày <color=#CA2E0AFF>3</color> món Thời Trang trong Tủ Trưng Bày.",
    ["DisplayCase_Help01_01"]="Giới thiệu quy tắc Tủ Trưng Bày:\n1. Thời trang có [Hiệu ứng hiển thị] có thể được thêm vào [Tủ Trưng Bày]\n2. [Hiệu ứng hiển thị] của Thời trang ở vị trí đầu tiên trong [Tủ Trưng Bày] sẽ là hiệu ứng có thể kích hoạt\n3. Khi có 3 bộ Thời Trang trong [Tủ Trưng Bày], sẽ kích hoạt [Hiệu ứng hiển thị] cấp thấp nhất trong số 3 bộ\n4. Khi cần thay đổi hiệu ứng của [Tủ Trưng Bày], cần phải gỡ tất cả Thời Trang trong [Tủ Trưng Bày] xuống\n5. [Hiệu ứng Tủ Trưng Bày] được tự động kích hoạt, không cần thêm thao tác nào",
    ["DisplayCase_Name"]="Tủ Trưng Bày",
    ["DivorceTips001"]="Bạn Đời của bạn là <color=#338dc3>%s</color> đã gửi Hủy Khế Ước, từ đây đường ai nấy đi, bạn có đồng ý chấm dứt khế ước hôn nhân với Bạn Đời đời cũ, hủy bỏ mọi phúc lợi Bạn Đời liên quan, hủy quan hệ Bạn Đời?",
    ["DivorceTips002"]="Đồng ý",
    ["DivorceTips003"]="Từ chối",
    ["DivorceTips004"]="Bạn và <color=#338dc3>%s</color> đã bên nhau <color=#338dc3>%s</color> ngày. Căn cứ vào cấp Bạn Đời đôi bên, lần đăng nhập cuối, yếu tố cấp khác v.v, để giải trừ mối quan hệ này, bạn cần tốn <color=#338dc3>%s Pha Lê</color>, hủy quan hệ Bạn Đời?",
    ["DivorceTips005"]="Ôm Lấy Tự Do",
    ["DivorceTips006"]="Đổi ý",
    ["DivorceTips007"]="Đơn phương ly hôn",
    ["DivorceTips008"]="Thỏa thuận ly hôn",
    ["DivorceTips009"]="Thỏa thuận ly hôn là chuyện của cả hai người, mời tổ đội xong hãy lại đến nhé. ",
    ["DivorceTips010"]="Thành viên trong đội không phải Bạn Đời của bạn",
    ["DivorceTips011"]="Bạn đời của bạn hiện đang offline, thỏa thuận ly hôn thất bại ",
    ["DivorceTips012"]="Thao tác quá nhiều lần",
    ["DivorceTips013"]="Đã hủy quan hệ Bạn Đời với %s ",
    ["DivorceTips014"]="Cần hai bên đều chọn Đồng Ý mới có thể thành công tiến hành thỏa thuận hủy khế ước ",
    ["DivorceTips015"]="Đơn phương ly hôn thành công, mau vui mừng ôm lấy tự do đi nào! ",
    ["DownloadDonePushMessageBody"]="Ứng dụng đã được tải về",
    ["DownloadDonePushMessageSubTitle"]="Tải game",
    ["DownloadDonePushMessageTitle"]="Tải",
    ["Downshift_1"]="Xác nhận giảm mức",
    ["Downshift_2"]="Tốc độ chơi game hiện tại của bạn tương đối chậm, có tạm thời giảm chất lượng đồ họa không",
    ["Downshift_3"]="Đã tạm giảm đếm chất lượng đồ họa %s",
    ["Downshift_4"]="Đã tái hiện đến chất lượng đồ họa %s",
    ["DragonBoatFesDesc_001"]="Quy tắc sự kiện:\n1. Thời gian sự kiện\n<b>·</b>Trong thời gian rút thưởng có thể chơi mini game Bàn Cờ Đoan Ngọ, và diệt quái vật Lv.21 trở lên khi có Chúc Phúc Odin sẽ rơi ngẫu nhiên nguyên liệu đổi trong sự kiện\n<b>·</b>Vào thời gian đổi thưởng người chơi có thể đổi được đạo cụ ở Tiệm Đổi Đoan Ngọ của Prontera\n\n2. Tiêu hao trong rút thưởng mini game Bàn Cờ: \n<b>·</b>Khi có Vé Rút Thưởng sự kiện Đoan Ngọ, ưu tiên dùng Vé Rút Thưởng, mỗi lần đổ xúc xắc sẽ tốn 1 vé\n<b>·</b>Nếu chưa có Vé Rút Thưởng sự kiện Đoan Ngọ, có thể dùng Pha Lê để đổ xúc xắc, mỗi lần tốn <color=#CA2E0AFF>3600</color> Pha Lê, VIP Kafra được mua với giá giảm còn <color=#CA2E0AFF>20%</color>\n\n3. Cách nhận Vé Rút Thưởng: Trong sự kiện rút thưởng, ở phần thưởng Độ sôi nổi thêm mới của sự kiện [Lễ Hội]\n\n4. Phần thưởng mini game Bàn Cờ:\n<b>·</b>Poring đi đến ô có ký hiệu đạo cụ, sẽ nhận được phần thưởng ở ô được ký hiệu này\n<b>·</b>Mỗi lần đi qua ô [Bắt đầu], sẽ nhận thêm phần thưởng qua vòng\n<b>·</b>Tích lũy số vòng nhất định, có thể nhận phần thưởng mốc tương ứng    ",
    ["DragonBoatFesDesc_002"]="T/g hoạt động: %s\n(T/g ngừng đổi thưởng: %s)",
    ["DragonBoatFesDesc_003"]="Số lần dùng Pha Lê đổ xúc xắc hôm nay: %s",
    ["DragonBoatFesHint_001"]="Dùng <color=#CA2E0AFF>%s</color> Pha Lê để đổ xúc xắc không?",
    ["DragonBoatFesHint_002"]="Tốn <color=#CA2E0AFF>%s</color> Pha Lê để dùng xúc xắc? \nVIP Kafra có thể mua với giá chỉ <color=#CA2E0AFF>80%</color>",
    ["DragonBoatFesHint_003"]="Đang khởi tạo Bàn Cờ, vui lòng chờ để dùng xúc xắc",
    ["DragonBoatFesHint_004"]="Poring đang di chuyển, không thể dùng xúc xắc",
    ["DragonBoatFesHint_005"]="Đã kết thúc thời gian rút thưởng, không thể dùng xúc xắc",
    ["DragonBoatFesHint_006"]="Sự kiện tạm thời chưa mở, vui lòng đợi",
