    ["ui_ChildRen001"]="Vị thành niên có thể chơi: %s",
    ["ui_ChildrenDay_001"]="Đại Chiến Kẹo Ngọt",
    ["ui_ChildrenDay_002"]="Sự kiện Tết Thiếu Nhi",
    ["ui_ChildrenDay_003"]="Children's Day",
    ["ui_ChildrenDay_004"]="Mua trong Tiệm Eden trong Hội Eden\nĐạo cụ giới hạn ngày lễ: <color=#ff7430><size=18>Ná Kẹo</size></color>",
    ["ui_ChildrenDay_005"]="Đạn Ná nhận từ <color=#ff7430><size=18>dùng Odin</size></color> sẽ có phẩm chất cao hơn, uy lực bắn lớn hơn",
    ["ui_ChildrenDay_006"]="Dùng Ná Kẹo hoặc Bệ Pháo Tiếp Cận vào chế độ bắn, chuẩn bị ngắm bắn <color=#ff7430><size=18>Ong Nhỏ</size></color>,\nBắn dứt khoát, sau khi bắn hạ có thể đổi đạo cụ Trang Sức Tết Thiếu Nhi, Ong Nhỏ càng lớn thì phẩm chất đạo cụ càng cao",
    ["ui_ChildrenDay_007"]="Nhóm trưởng Hội Eden đang tập hợp Nhà Thám Hiểm đánh bại bọn Ong",
    ["ui_ChildrenDay_008"]="Đánh bại Ong Nhỏ sẽ nhận Quà Tết Thiếu Nhi!",
    ["ui_ChildrenDay_009"]="Tips: Sau khi bắn hạ Ong Chúa Hoàng Kim ngoài vật rơi chính, còn có xác suất nhỏ rơi quà khác.",
    ["ui_ChildrenDay_010"]="Đánh bại nhận",
    ["ui_ChildrenDay_011"]="Huân chương có thể đổi bộ Ong Nhỏ và Thú Cưỡi Ong Nhỏ",
    ["ui_ChildrenDay_012"]="Huân Chương Gấu Nhỏ",
    ["ui_ChildrenDay_013"]="Huân Chương Hỏa Tiễn Nhỏ",
    ["ui_ChildrenDay_014"]="Huân Chương Cầu Bảy Màu",
    ["ui_ChildrenDay_015"]="Bộ Ong Nhỏ",
    ["ui_ChildrenDay_016"]="Thú Cưỡi - Bình Mật Ong Vo Ve",
    ["ui_ChildrenDay_017"]="Đại Chiến Kẹo Ngọt",
    ["ui_ChildrenDay_018"]="Bay Cao Ngất Trời",
    ["ui_ChildrenDay_019"]="Quà Cầu Vồng",
    ["ui_ChildrenDay_020"]="<color=#fffbdd>5:00</color> hàng ngày sẽ làm mới tất cả nhiệm vụ",
    ["ui_ChildrenDay_021"]="BXH Bay Cao Ngất Trời",
    ["ui_ChildrenDay_022"]="Thời gian ngắn nhất trong lịch sử",
    ["ui_ChildrenDay_023"]="Vào đường đua cần tiêu hao đạo cụ Phiếu\nCó thể mua đạo cụ ở chỗ <color=#fed83c>Altyna</color> hoặc nhận được bằng cách tham gia <color=#fed83c>Quà Cầu Vồng</color>",
    ["ui_ChildrenDay_024"]="Các Nhà Thám Hiểm sẽ sử dụng Thú Cưỡi của mình xung quanh khu vui chơi để hoàn thành <color=#fed83c>hai vòng đua</color> theo tuyến đường và phương hướng được chỉ định. Trong trận đấu sẽ xuất hiện lon kỹ năng bí ẩn có thể nhặt và những <color=#fed83c>con ong độc ác</color> cản trở bạn",
    ["ui_ChildrenDay_025"]="Người chơi tham gia sự kiện sẽ nhận được thưởng Huân Chương. Người chơi <color=#fed83c>hạng 1</color> sẽ nhận thêm thưởng Huân Chương, càng có cơ hội vào <color=#fed83c>BXH</color> để nhận được thưởng cuối. Có thể tới chỗ <color=#fed83c>Altyna</color> để đổi Huân Chương lấy các thưởng như Trang Phục Tết Thiếu Nhi, Thú Cưỡi...",
    ["ui_ChildrenDay_026"]="Hạng hiện tại",
    ["ui_ChildrenDay_027"]="Đang ghép...",
    ["ui_ChildrenDay_028"]="Tham gia để nhận",
    ["ui_ChildrenDay_029"]="Đổi để nhận",
    ["ui_ChildrenDay_030"]="Tiêu hao Odin, tiêu diệt MVP ngoài bản đồ có xác suất nhận được <color=#F7B947>Huân Chương Hộp Âm Nhạc</color> và <color=#F7B947>Huân Chương Ong Mật</color>~",
    ["ui_ChildrenDay_031"]="Đến Hội Eden ở Cổng Nam Prontera tham gia sự kiện Bay Cao Ngất Trời, nhớ mang theo Thú Cưỡi nhanh nhất của bạn!",
    ["ui_ChildrenDay_032"]="Kho thưởng Quán Quân",
    ["ui_ChildrenDay_033"]="Danh sách thưởng",
    ["ui_ChildrenDay_034"]="Lần đầu tới mỗi ngày được nhận miễn phí",
    ["ui_ChildrenDay_035"]="Kết thúc sự kiện, Top 3 nhận được thưởng sau",
    ["ui_ChildrenDay_036"]="Tiệc Đường Mật (giới hạn 1 ngày)",
    ["ui_ChildrenDay_037"]="Lao Nhanh Cấp Tốc",
    ["ui_ChildrenDay_038"]="Nhiệm vụ Lao Lên",
    ["ui_ChildrenDay_039"]="Đến ngay",
    ["ui_ChildrenDay_040"]="Xem xếp hạng",
    ["ui_ChildrenDay_041"]="1 giờ",
    ["ui_ChildrenDay_042"]="Nhấn để xem tất cả thưởng",
    ["ui_ChildrenDay_043"]="Sau khi kết thúc sự kiện sẽ gửi thưởng xếp hạng qua thư",
    ["ui_ChildrenDay_044"]="Thăng cấp để nhận",
    ["ui_ChildrenDay_045"]="Quà Cầu Vồng",
    ["ui_ChildrenDay_046"]="Bay Cao Ngất Trời",
    ["ui_ChildrenDay_047"]="Có thể thăng cấp thành",
    ["ui_ChildrenDay_048"]="Tiêu hao Chúc Phúc Odin, tiêu diệt MVP ngoài bản đồ có xác suất nhận được Huân Chương Hộp Âm Nhạc và Huân Chương Cầu Vồng.",
    ["ui_ChildrenDay_049"]="Thưởng xếp hạng sẽ được phát qua thư vào lúc 5h sáng hàng ngày",
    ["ui_ChildrenDay_050"]="Tốc Độ Đỉnh Cao",
    ["ui_ChildrenDay_051"]="Quà Tốc Độ",
    ["ui_ChildrenDay_052"]="Chạy bộ thông minh",
    ["ui_ChooseAffirm_001"]="Thông Báo",
    ["ui_ChooseProfessionNew_001"]="<color=#FFFFFFFF>Thời gian hồi: </color>",
    ["ui_ChooseProfessionNew_002"]="<color=#FFFFFFFF>Tốn: </color>",
    ["ui_ChooseProfessionNew_003"]="Độ khó:",
    ["ui_ChooseProfessionNew_004"]="<color=#FFFFFFFF>Cự li thi triển: </color>",
