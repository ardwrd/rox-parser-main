    ["en_InstanceNameGVG"]="GVG",
    ["energyicon"]="<color=#97BCF8FF>Điểm Thể Lực:</color>\n\nNgười chơi thực hiện các hành vi đời sống cần tốn Điểm Thể Lực nhất định\n\nHành vi đời sống gồm: \n \nCâu Cá: Câu cá trong khu chỉ định, được nhận nguyên liệu cần cho đời sống\nĐào Mỏ: Đào mỏ ở khu chỉ định, được nhận nguyên liệu cần cho đời sống\nLàm Vườn: Làm vườn ở khu chỉ định, được nhận nguyên liệu cần cho đời sống\nBắt Pet: Người chơi có thể dùng đạo cụ tương ứng để bắt Quái Vật\nNấu Ăn: Người chơi có thể tạo món ăn có hiệu quả buff\nChế Tạo: Thương Gia có thể tạo ra đạo cụ cần cho các nghề\nĐúc: Người chơi có thể tạo ra nguyên liệu để cường hóa, cải tiến trang bị\n\nCứ tốn 1 điểm Chúc Phúc Odin được nhận 1 điểm Thể Lực\nSau khi Điểm Thể Lực đầy, tốn Odin cũng không nhận thêm Điểm Thể Lực nữa\n\n",
    ["equipmentType_100"]="Vũ Khí-Dao Găm Cơ Bản",
    ["equipmentType_101"]="Vũ Khí-Kiếm Một Tay",
    ["equipmentType_102"]="Vũ Khí-Rìu Một Tay",
    ["equipmentType_103"]="Vũ Khí-Trượng Một Tay",
    ["equipmentType_104"]="Vũ Khí-Chùy",
