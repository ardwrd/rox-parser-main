    ["AchievementGet"]="Nhận được thành tựu %s",
    ["AchievementGroupName_1"]="Phó bản",
    ["AchievementGroupName_2"]="Hợp tác",
    ["AchievementGroupName_3"]="Thi đấu",
    ["AchievementGroupName_4"]="MVP",
    ["AchievementMainMenu_1"]="Nhân Vật",
    ["AchievementMainMenu_2"]="Chiến Đấu",
    ["AchievementMainMenu_3"]="Thám Hiểm",
    ["AchievementMainMenu_4"]="Trang Bị",
    ["AchievementMainMenu_5"]="Đời Sống",
    ["AchievementMainMenu_6"]="Nhiệm Vụ",
    ["AchievementMainMenu_7"]="Bạn Đời",
    ["AchievementMainMenu_8"]="Lì Xì",
    ["AchievementSecContent_1"]="Vẻ đẹp của cuộc sống nằm ở sự phiêu lưu\n                    ---\"Học Viện Criatura\"---",
    ["AchievementSecContent_10"]="Mọi mong ước đều được thỏa mãn không hẳn là điều tốt\n                     ---Thầy Đạo Chích Moxie---",
    ["AchievementSecContent_11"]="Đừng khóc vì sữa đã đổ\n                              ---Công ty Kafra W---",
    ["AchievementSecContent_12"]="Cho tôi con tuấn mã, cưỡi nó vượt bóng tối. \nNó giải trừ tà ma tránh bùa ngải, nhảy qua ngọn lửa ngút trời.",
    ["AchievementSecContent_13"]="Diều hâu lượn lờ trên bầu trời, chính là để bắt cá bơi trên đỉnh núi.",
    ["AchievementSecContent_14"]="Khắc nên những kỳ diệu của thế giới.",
    ["AchievementSecContent_15"]="Ngọc không mài không sáng. \n                      ---Châm ngôn Vương quốc Dragon",
    ["AchievementSecContent_16"]="Nữ Thần May Mắn đang mỉm cười.",
    ["AchievementSecContent_17"]="Trăng chưa mọc núi rừng lạnh lẽo, tiếng ngỗng bay vang vọng mây xanh.",
    ["AchievementSecContent_18"]="Nếu muốn có mồi câu phải đi tìm người chăn, sao chút kiến thức này cũng không biết.",
    ["AchievementSecContent_19"]="Khiến người mệt mỏi không phải là mỏ quặng vô tận, mà là hạt cát nhỏ trong quặng.",
    ["AchievementSecContent_2"]="Nhà Thám Hiểm, hãy để chúng ta trở thành huyền thoại và truyền cảm hứng cho đời sau",
    ["AchievementSecContent_20"]="Vừa điên cuồng uống rượu, vừa cãi nhau không ngừng. \n                                      ---\"Bài hát Siegfried\"",
    ["AchievementSecContent_21"]="Những thứ chúng ta yêu quý cũng thể hiện chúng ta là ai.",
    ["AchievementSecContent_22"]="Cuộc sống cũng giống như cái đe vậy, càng bị đánh, càng tóe ra tia lửa. \n                                            ---Hollgrehenn",
    ["AchievementSecContent_23"]="Bắt buộc phải dùng vạc lớn này để nấu rượu. \n                                     ---\"Bài hát Siegfried\"",
    ["AchievementSecContent_24"]="Kẻ theo đuổi cái bóng, bản thân chỉ là cái bóng.",
    ["AchievementSecContent_25"]="Say rồi chẳng biết trời trong nước, thuyền đầy mộng đẹp dưới trời sao. \n                                ---\"Đồng dao Lạc Dương\"",
    ["AchievementSecContent_26"]="Cây tần bì lớn xanh tốt quanh năm, che chở bên giếng nước suối thiêng của vận mệnh.",
    ["AchievementSecContent_27"]="Có người nợ tiền binh khí vẫn chưa trả, tôi phải đến để đòi nợ.",
    ["AchievementSecContent_28"]="Những lúc ta cần người, người luôn có mặt.",
    ["AchievementSecContent_29"]="Vượt xa ngàn dạm đến bên người.",
    ["AchievementSecContent_3"]="Mỗi ngày 300 con quái vật, không ngại làm người Payon lâu dài",
    ["AchievementSecContent_30"]="Như thể muốn đốt cháy ngọn lửa của bản thân.",
    ["AchievementSecContent_31"]="Tôi sẵn sàng chọn ngôi sao sáng nhất cho bạn.",
    ["AchievementSecContent_32"]="Cho đến khi cái chết chia lìa đôi ta.",
    ["AchievementSecContent_33"]="Người là cuộc sống của tôi.",
    ["AchievementSecContent_34"]="            Âm thanh tuyệt nhất trên thế gian,\n        Là tiếng Zeny và Pha Lê va chạm nhau.",
    ["AchievementSecContent_35"]="Tiền tài chỉ là vật ngoài thân, có thể sẽ chia với mọi người mới là niềm vui vô tận.",
    ["AchievementSecContent_36"]="Sức hút của tiền bạc đúng là rất khó để cưỡng lại!\n                         -Thương Gia Pha Lê Sinclair",
    ["AchievementSecContent_37"]="                 Đôi tay có lẽ được Nữ Thần hôn,\n        Lòng bàn tay luôn phát ra ánh sáng lấp lánh.",
    ["AchievementSecContent_38"]="Tích tiểu thành đại.",
    ["AchievementSecContent_39"]="Quái vật đến từ Dị Giới, đều phải bị tiêu diệt tận gốc.",
    ["AchievementSecContent_4"]="Trước kia bão tố và sói dữ hoành hành, từ rất lâu trước khi thế giới diệt vong.          ",
    ["AchievementSecContent_40"]="         Niềm tin như mũi đao hướng về phía trước, quyết tâm không bao giờ thất bại,\n         Đều là những lý do đáng để tôn trọng.",
    ["AchievementSecContent_41"]="Có qua có lại mới toại lòng nhau.",
    ["AchievementSecContent_5"]="Lưỡi kiếm sắc đang đầy nhiệt huyết, thanh đao nặng đang cất tiếng ca.",
    ["AchievementSecContent_6"]="Ngươi đã từng nghe đến chuyện này, hay còn biết thêm gì khác. \n                                            ---Dòng chữ mờ trên bệ Trái Tim",
    ["AchievementSecContent_7"]="Nhắc yến nhạn rằng đừng có vội, còn có trời cao nghìn dặm kia.",
    ["AchievementSecContent_8"]="Năm tháng trôi qua, đồi núi cũng dần xa.",
    ["AchievementSecContent_9"]="Ta vượt qua núi cao ngàn dặm, mới nhận ra không kẻ đợi chờ.",
