    ["TaskQuestion320006"]="Hãy Sục Sôi!",
    ["TaskQuestion320007"]="Câu Hỏi Của W",
    ["TaskQuestion320008"]="Thề Trước Odin",
    ["TaskQuestion320010"]="Chứng minh quyết tâm với Jin Vô Song",
    ["TaskQuestion320011"]="Chứng minh quyết tâm với Kroneika",
    ["TaskQuestion320012"]="Chứng minh quyết tâm của ngươi với Gallagher",
    ["TaskQuestion330001"]="Đố Đèn Vọng Nguyệt",
    ["TaskQuestion340001"]="Câu hỏi của Mainz",
    ["TaskQuestion350001"]="Kỵ Sĩ Tử Linh",
    ["TaskQuestion360001"]="Câu hỏi chuyển nghề Lưu Manh",
    ["TaskQuestion370001"]="Thuật Sĩ Luyện Kim",
    ["TaskQuestion380001"]="海伊的提问",
    ["TaskQuestion390001"]="Câu Hỏi của Nenna",
    ["TaskQuestion400001"]="Câu hỏi của Tanders",
    ["TaskQuestion410001"]="Vấn đề của Giáo Quan Miller",
    ["TaskQuestion420001"]="Lập Lời Thề Ninja",
    ["TaskQuestion430001"]="Trả lời câu hỏi của Robot",
    ["TaskQuestion440003"]="Câu hỏi của Shikoti",
    ["TaskQuestion450001"]="Hỏi nguyện vọng thuở đầu về võ đạo",
    ["TaskQuestionTitle3100011"]="Bạn sẽ không hối hận về lựa chọn lúc này chứ?",
    ["TaskQuestionTitle3100012"]="Bạn thề giương cao vũ khí bảo vệ nhân dân vùng đất này?",
    ["TaskQuestionTitle3100013"]="Dù gặp bao khó khăn bạn vẫn sẽ can đảm tiến về phía trước?",
    ["TaskQuestionTitle3100021"]="Khi gặp nguy nan, bạn sẽ không đầu hàng bỏ chạy?",
    ["TaskQuestionTitle3100022"]="Bạn chỉ biết dùng nắm đấm, không biết sử dụng trí não?",
    ["TaskQuestionTitle3100023"]="Bạn sẽ giúp đỡ thay vì bỏ rơi đồng hành?",
    ["TaskQuestionTitle3100031"]="Thời gian bầu chọn vua mới là bảy ngày, có tất cả bảy vị ứng cử viên kế thừa tham gia.",
    ["TaskQuestionTitle3100032"]="Vị vua mới được bầu bằng cách bỏ phiếu, kết quả bỏ phiếu bao gồm hai phần, một cuộc bỏ phiếu công dân và một cuộc bỏ phiếu của quý tộc.",
    ["TaskQuestionTitle3100033"]="Trong lúc bầu chọn vua mới, lá phiếu của Quan Kiểm Duyệt sẽ chiếm hai mươi phần trăm trên tổng số phiếu.",
    ["TaskQuestionTitle3200011"]="Bạn có bằng lòng dùng hết sức lực để bảo vệ đồng đội?",
    ["TaskQuestionTitle3200012"]="Bạn sẽ không tranh đoạt kho báu, độc chiếm thành quả của đồng đội?",
    ["TaskQuestionTitle3200013"]="Bạn sẽ yêu thương, bảo vệ và xem động vật như người bạn đồng hành?",
    ["TaskQuestionTitle3200021"]="Pháp Thuật Nguyên Tố muôn hình muôn vẻ, là một môn khoa học thoải mái, bạn nghĩ sao?",
    ["TaskQuestionTitle3200022"]="Cách ứng dụng Pháp Thuật Nguyên Tố mạnh nhất là tối đa hóa gây sát thương và phá hoại, bạn nghĩ sao?",
    ["TaskQuestionTitle3200023"]="Chỉ cần tập trung vào một thuộc tính của pháp thuật, sẽ có thể đối phó với mọi nguy hiểm, bạn nghĩ sao?",
    ["TaskQuestionTitle3200031"]="Thề với Odin, bạn sẽ xem cái ác như kẻ thù, và gửi tất cả Sinh Vật Thây Ma đến cạnh Nữ Thần Chết. Bạn đã giác ngộ chưa?",
    ["TaskQuestionTitle3200032"]="Thề với Odin, bạn sẽ đem lòng đức độ, cùng đồng đội kề vai chiến đấu dưới phúc âm của Odin. Bạn đã giác ngộ chưa?",
    ["TaskQuestionTitle3200033"]="Thề với Odin, bạn đã hoàn thành và cống hiến phần đời còn lại để giác ngộ đức tin của Odin?",
    ["TaskQuestionTitle3200041"]="Hoa tươi và tiếng hò reo vây quanh, bạn là người nổi bật nhất, bạn có mong đợi một cuộc sống thám hiểm thế này không?",
    ["TaskQuestionTitle3200042"]="Những mũi tên sắc nhọn và những chiếc bẫy bí mật sẽ giúp bạn trở thành tử thần trên chiến trường, bạn có mong đợi một cuộc sống thám hiểm thế này không?",
    ["TaskQuestionTitle3200043"]="Trên chiến trường, Ưng Săn sẽ luôn bảo vệ phía sau và cùng bạn kề vai chiến đấu, bạn sẽ không bao giờ đơn độc. Bạn có mong đợi một cuộc sống thám hiểm thế này không?",
    ["TaskQuestionTitle3200051"]="Bạn có đề cao tinh thần ngay thẳng và cởi mở không?",
    ["TaskQuestionTitle3200052"]="Bạn đã sẵn sàng dấn thân vào bóng tối và chuẩn bị cho đòn chí mạng chưa?",
    ["TaskQuestionTitle3200053"]="Bạn sẽ gạt bỏ những nghi vấn, vu khống của người khác và kiên định với chính nghĩa của chính bạn chứ?",
    ["TaskQuestionTitle3200061"]="Cơ bắp, cơ thể và tinh thần mạnh mẽ là hũ vàng đầu tiên dẫn đến sự giàu có! Bạn đồng ý chứ?",
    ["TaskQuestionTitle3200062"]="Xe Đẩy là công cụ, vũ khí và đồng hành của chúng ta! Bạn thấy đúng chứ!",
    ["TaskQuestionTitle3200063"]="Wowwwwww!!!! Hãy để chúng ta được khoe cơ thể khỏe mạnh, đổ mồ hôi và bầu bạn bên ngọn lửa!",
    ["TaskQuestionTitle3200071"]="Tổng bộ của Kafra có phải ở Alberta?",
    ["TaskQuestionTitle3200072"]="Dịch vụ của Kafra có gồm bán Xe Đẩy không?",
    ["TaskQuestionTitle3200073"]="Kafra là công ty vận chuyển mà bạn thích nhất?",
    ["TaskQuestionTitle3200081"]="Dù xảy ra chuyện gì, ngươi đều sẽ giữ lòng tin với Odin sao?",
    ["TaskQuestionTitle3200082"]="Đối với ngươi, vinh quang cá nhân cao hơn tất cả?",
    ["TaskQuestionTitle3200083"]="Ngươi có sẵn sàng hy sinh mọi thứ để bảo vệ đồng đội của mình không?",
    ["TaskQuestionTitle3200101"]="Ngươi có sẵn sàng chịu đựng nỗi đau rèn luyện gân cốt, tái tạo máu thịt để nâng cao võ học không?",
    ["TaskQuestionTitle3200102"]="Ngươi có sẵn sàng chịu đựng sự huấn luyện khô khan một ngày như mười năm, mười năm như một ngày để nâng cao võ học không?",
    ["TaskQuestionTitle3200103"]="Khi thành tích võ học của ngươi xếp hàng đầu, ngươi có hướng về thiên hạ, thương xót chúng sinh không?",
    ["TaskQuestionTitle3200111"]="Trong quá trình học pháp thuật, ngươi đã phát hiện ra năng khiếu của mình chưa?",
    ["TaskQuestionTitle3200112"]="Tri thức giống như đại dương vô tận, khi bước chân vào nghề Nhà Thông Thái xa lạ từ Ma Pháp Sư, liệu mình có đủ dũng khí để bắt đầu lại không?",
    ["TaskQuestionTitle3200113"]="Sau khi trở thành Nhà Thông Thái, có phải sẽ quên đi thiện ý trong lòng vĩnh viễn không, không hổ danh là \"Nhà Thông Thái\"?",
    ["TaskQuestionTitle3200121"]="Kể từ bây giờ, ngài có sẵn sàng giữ sự bao dung nho nhã, không giả tạo trước tất cả khán giả không?",
    ["TaskQuestionTitle3200122"]="Kể từ thời điểm này, ngài bằng lòng giữ tình yêu bền bỉ và tinh thần cầu tiến với những tác phẩm không?",
    ["TaskQuestionTitle3200123"]="Khi kỹ năng chiến đấu và thành tích biểu diễn của ngài đạt đến đỉnh cao, ngài có sẵn sàng truyền lại mọi thứ cho thế hệ sau, không chút dè dặt như bây giờ ta đang làm không?",
    ["TaskQuestionTitle3300011"]="\"Nguyên Tiêu\" đầu tiên còn được gọi là \"Trôi Nước\"",
    ["TaskQuestionTitle33000110"]="Câu nói \"cây mơ trắng như đường, không hạt không vỏ\" là chỉ Nguyên Tiêu.",
    ["TaskQuestionTitle3300012"]="\"Đêm Rằm\" là tên gọi của Tết Nguyên Tiêu.",
    ["TaskQuestionTitle3300013"]="Ngắm trăng, đoán câu đố, ăn bánh ú đều là tập tục của Tết Nguyên Tiêu.",
    ["TaskQuestionTitle3300014"]="\"Trôi Nước\" và \"Nguyên Tiêu\" là hai loại đồ ăn khác nhau.",
    ["TaskQuestionTitle3300015"]="Tập tục Hoa Đăng bắt đầu từ nhà Tần và phát triển mạnh vào nhà Đường.",
    ["TaskQuestionTitle3300016"]="Đèn lồng Nguyên Tiêu cũng có ngụ ý cầu \"sinh con trai\".",
    ["TaskQuestionTitle3300017"]="Câu đố, gợi ý và đáp án là ba yếu tố của câu đố đèn.",
    ["TaskQuestionTitle3300018"]="Câu tiếp theo của \"cây đỏ nở hoa trắng\" là \"trăng đuổi người cùng đến\".",
    ["TaskQuestionTitle3300019"]="Người đầu tiên chế tạo đèn lồng tên là Cổ Tự Đạo.",
    ["TaskQuestionTitle3400011"]="Trở thành Thầy Hướng Dẫn đồng nghĩa với việc kết thúc việc học, việc tìm hiểu kiến ​​thức sẽ chậm chân lại.",
    ["TaskQuestionTitle3400012"]="Đối với những học viên nghi ngờ Thầy Hướng Dẫn, tình yêu thương vô bờ là cách dạy dỗ duy nhất.",
    ["TaskQuestionTitle3400013"]="Nếu thành tích của học viên hơn cả Thầy Hướng Dẫn, Thầy Hướng Dẫn nên vui mừng chứ không phải ghen tị.",
    ["TaskQuestionTitle3400014"]="Mỗi học viên đều có ưu khuyết điểm của mình, vì vậy cần áp dụng cách dạy phù hợp.",
    ["TaskQuestionTitle3400015"]="Mỗi Thầy Hướng Dẫn nên cố gắng hết sức để hướng học sinh đến điều tốt, vì vậy cần trừng phạt Thầy Hướng Dẫn của những kẻ làm việc ác.",
    ["TaskQuestionTitle3500011"]="Bạn đã bao giờ làm hại người khác vì những ham muốn ích kỷ của bản thân chưa?",
    ["TaskQuestionTitle3500012"]="Bạn có sẵn sàng giúp đỡ những người đang gặp khó khăn không?",
    ["TaskQuestionTitle3500013"]="Bạn sẽ kiên định với chính nghĩa trong tim mình, ngay cả khi phải hy sinh gì đó?",
    ["TaskQuestionTitle3600011"]="Bạn có phong thái của lưu manh không?",
    ["TaskQuestionTitle3600012"]="Bạn có khí chất của lưu manh không?",
    ["TaskQuestionTitle3600013"]="Bạn có thái độ của lưu manh không?",
    ["TaskQuestionTitle3700011"]="Bạn có tôn kính và tôn trọng sinh mệnh không?",
    ["TaskQuestionTitle3700012"]="Đối mặt với cấm kỵ và cám dỗ, bạn có còn kiên định với giới hạn của thiện ác không?",
    ["TaskQuestionTitle3700013"]="Bạn có sẵn sàng viết một cuốn sách để truyền lại cho hậu thế một cách trọn vẹn không?",
    ["TaskQuestionTitle3800011"]="在演员的整体素质中，先天的因素起着决定性的作用。",
    ["TaskQuestionTitle3800012"]="表演的信念与真实感是不可分离的。",
    ["TaskQuestionTitle3800013"]="演员只需按照导演要求直译式扮演角色。",
    ["TaskQuestionTitle3900011"]="Alphoccio là thầy giáo của Trinity.",
    ["TaskQuestionTitle3900012"]="Giữa hai người, người tỏ tình trước là Alphoccio.",
    ["TaskQuestionTitle3900013"]="Alphoccio từng sống ẩn cư trên Đảo Comodo cùng Trinity.",
    ["TaskQuestionTitle4000011"]="Ngươi sẽ không hối hận về lựa chọn lúc này chứ?",
    ["TaskQuestionTitle4000012"]="Ngươi thề giương cao vũ khí bảo vệ nhân dân vùng đất này?",
    ["TaskQuestionTitle4000013"]="Dù có gặp bao khó khăn, ngươi vẫn sẽ can đảm tiến về phía trước?",
    ["TaskQuestionTitle4100011"]="Nhân cách của chúng ta sẽ luôn cao quý.",
    ["TaskQuestionTitle4100012"]="Máu của chúng ta sẽ luôn nóng rực.",
    ["TaskQuestionTitle4100013"]="Chính nghĩa của chúng ta sẽ mãi mãi bất hủ!",
    ["TaskQuestionTitle4200011"]="Câu 1: Hãy giữ im lặng, bởi đó là ngôn ngữ của Ninja.",
    ["TaskQuestionTitle4200012"]="Câu 2: Hãy giữ khoảng cách, bởi đó là khoảng cách sinh tồn.",
    ["TaskQuestionTitle4200013"]="Câu 3: Hãy tỉnh táo, bởi đó là ngọn nến trong đêm vô tận.",
    ["TaskQuestionTitle4300011"]="Bầu trời có màu xanh biếc.",
    ["TaskQuestionTitle4300012"]="Cún con kêu meo meo.",
    ["TaskQuestionTitle4300013"]="Tất cả động vật có cánh đều biết bay.",
    ["TaskQuestionTitle4300014"]="Tôi có hai quả táo, ăn mất một quả, còn một quả.",
    ["TaskQuestionTitle4300015"]="Thấy có người thất thố, cách lịch sự nhất chính là cười to.",
    ["TaskQuestionTitle4400031"]="Trong tương lai, khi bạn đã thay đổi công việc thành công, liệu bạn có thể giữ vững ý định ban đầu của mình, bảo vệ kẻ yếu và không bao giờ khuất phục trước cái ác không?",
    ["TaskQuestionTitle4400041"]="Trong tương lai việc chuyển việc thất bại, liệu bạn có thể kiên trì, vượt qua trở ngại và luôn bước đi trên con đường tươi sáng?",
    ["TaskQuestionTitle4500011"]="Tôi sẽ dốc sức theo đuổi võ đạo, không sợ gian khổ!",
    ["TaskQuestionTitle4500012"]="Tôi luôn giữ trái tim chính nghĩa, tuyệt đối không sa vào tà đạo!",
    ["TaskQuestionTitle4500013"]="Tôi sẽ khắc sâu ơn thầy, tuyệt đối không vong ơn bội nghĩa!",
