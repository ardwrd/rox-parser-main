    ["MountPartDes_819020701"]="Trang trí Alpaca mô phỏng phong cách đồ chơi của người lính, khá phù hợp với không khí Giáng Sinh.",
    ["MountPartDes_819020801"]="Áo cà sa dệt bằng chỉ vàng ngọc trai, một trong những đồ vật của Huyền Trang Đại Sư khi sang Tây trúc lấy kinh.",
    ["MountPartDes_819020901"]="Giáp lưng bị băng tuyết bao phủ, có ánh sáng pháp thuật trên đó.",
    ["MountPartDes_820010101"]="Trang phục phong cách thị vệ màu xanh lam, uy phong lẫm liệt.",
    ["MountPartDes_820010102"]="Trang phục phong cách thị vệ màu cam, uy phong lẫm liệt.",
