    ["DialogueOption39904051"]="(Ghi lại lời của họ)",
    ["DialogueOption39904052"]="(Rồi lẻn đi)",
    ["DialogueOption39906011"]="(Véo mũi) Ngươi là ai",
    ["DialogueOption39906101"]="Ta đi cùng ngươi nhé",
