    ["DialogueOption20801031"]="Nói dễ hiểu hơn đi!",
    ["DialogueOption20801041"]="Ảnh chính là ảnh!",
    ["DialogueOption20802011"]="Phát nổ?!",
    ["DialogueOption20802021"]="Vậy phải làm sao?",
    ["DialogueOption20802041"]="Tôi hiểu rồi.",
    ["DialogueOption20803011"]="Anh không sao chứ?",
