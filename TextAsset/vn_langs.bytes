    ["MountSystem_020"]="Vui lòng xuống khỏi ghế phụ Thú Cưỡi Đôi và thử lại",
    ["MountSystem_021"]="Mời cùng cưỡi",
    ["MountSystem_022"]="%s mời bạn cùng cưỡi, đồng ý không?",
    ["MountSystem_023"]="Đối phương cần đạt Lv.8 mới được cùng cưỡi",
    ["MountSystem_024"]="Cách quá xa, không thể cùng cưỡi",
    ["MountSystem_025"]="Bạn không phải người điều khiển Thú Cưỡi nhiều người, không thể mời",
    ["MountSystem_026"]="Thú Cưỡi nhiều người đã đầy, không thể mời cùng cưỡi",
    ["MountSystem_027"]="Trạng thái hiện tại không thể mời người khác cùng cưỡi",
    ["MountSystem_028"]="Thành viên cùng đội mới có thể cùng cưỡi",
    ["MountSystem_029"]="Map hiện tại không thể cùng cưỡi",
    ["MountSystem_030"]="Cần đạt Lv.8 mới được cùng cưỡi",
    ["MountSystem_031"]="Trạng thái hiện tại không thể đồng ý lời mời cùng cưỡi",
    ["MountSystem_032"]="Đối phương đang bận hoặc đã từ chối lời mời",
    ["MountSystem_033"]="Số ghế:",
    ["MountSystem_034"]="Trạng thái hiện tại không thể chấp nhận lời mời trên mạng xã hội",
    ["MountSystem_035"]="Không thể cưỡi thú cưỡi khi chiến đấu",
    ["MountSystem_036"]="Sau khi cho thuê, vật phẩm <color=#FF0000>%s</color> sẽ hủy trạng thái cho thuê. Cần cho thuê lại để tái sử dụng Tiếp tục không?",
    ["MountSystem_037"]="Tốc độ PVP:",
    ["MountTips_001"]="Thú Cưỡi này đã hết hạn, mời chọn Thú Cưỡi khác",
    ["MountTips_2005"]="Hiệu ứng đặc biệt: %s",
    ["MountUseJob"]="Nghề cưỡi: %s",
    ["Mount_SkillCastingLimit_83080"]="Trạng thái hiện tại không thể sử dụng kỹ năng này.",
    ["MultipleJobTips_001"]="Nhánh này tạm chưa mở",
    ["MultipleJobTips_002"]="%s\n (Chưa đủ điều kiện)",
    ["MultipleJobTips_003"]="Dùng <color=#FF4500>Sách Traver</color> kích hoạt nhánh nghề-<color=#FF4500>%s</color> không?\nKích hoạt xong có thể chuyển về nhánh này miễn phí vĩnh viễn.",
    ["MultipleJobTips_004"]="Chuyển lớp nghề thành <color=#FF4500>{0}</color> không? Chuyển xong, tính năng chuyển nghề sẽ hồi chiêu trong <color=#FF4500>{1} phút</color>, lúc này không thể chuyển lớp nghề nữa. Sau khi chuyển, lớp nghề mới sẽ dùng phương án tác chiến tương ứng với nó.",
    ["MultipleJobTips_005"]="Thời gian CD:",
    ["MultipleJobTips_006"]="Tính năng chuyển nghề đang chờ",
    ["MultipleJobTips_007"]="Người chơi trong map chuyển nghề",
    ["MultipleJobTips_008"]="Hiện có thành viên trong map đặc biệt, không thể vào phó bản",
    ["MultipleJobTips_009"]="<color=#ff5d5d>%s x %s</color>",
    ["MultipleJobTips_010"]="<color=#bcff3a>%s x %s</color>",
    ["MultipleJobTips_012"]="%s",
    ["MultipleJobTips_013"]="Chuyển nhánh nghề thành <color=#FF4500>{0}</color> không? Chuyển xong tính năng chuyển nghề sẽ hồi chiêu trong <color=#FF4500>{1} phút</color>, trong thời gian này không thể chuyển nhánh nghề nữa. Sau khi chuyển, nhánh nghề mới sẽ dùng phương án tác chiến tương ứng với nó, đồng thời sẽ chuyển đổi giới tính nhân vật, trang phục giới hạn giới tính đã trang bị/đã mặc sẽ được cởi/gỡ xuống, và tiêu hao 1 tấm Thẻ Đổi Giới Tính.",
    ["MultipleJobTips_014"]="Thẻ Đổi Giới Tính không đủ, mua thêm ở Thương Gia Pha Lê",
