    ["DialogueOption20873041"]="...?",
    ["DialogueOption20873051"]="Bảng câu hỏi ở đâu?",
    ["DialogueOption20873071"]="Ta hiểu rồi.",
    ["DialogueOption20874011"]="dừng lại!",
    ["DialogueOption20874021"]="(Nói lý do đến)",
    ["DialogueOption20874031"]="Bạn điền vào bảng câu hỏi",
    ["DialogueOption20875011"]="Tôi vẫn muốn biết...",
