    ["BattlePass_17"]="Bạn đã mua <color=#e7bb22>Gói Ưu Đãi Vinh Dự</color> thành công, Thẻ Thông Hành đã tăng đến Lv.25",
    ["BattlePass_18"]="Xác nhận mua %s",
    ["BattlePass_19"]="Cấp Thẻ Thông Hành Cộng 30",
    ["BattlePass_2"]="Mua cấp",
    ["BattlePass_20"]="Cấp Thẻ Thông Hành Cộng 50",
    ["BattlePass_21"]="Làm xong nhiệm vụ trước đó sẽ mở",
    ["BattlePass_22"]="Cần mở khóa <color=#e7bb22>Thẻ Vinh Dự</color>",
    ["BattlePass_23"]="Làm mới (%s)",
    ["BattlePass_24"]="Vẫn còn nhiều ngày nữa trước khi nhiệm vụ hàng ngày được đặt lại:<color=#ff709f>%sGiờ%sđiểm</color>",
    ["BattlePass_25"]="Cài lại Nhiệm Vụ Tuần sau: %s ngày %s giờ",
    ["BattlePass_26"]="Cài lại Nhiệm Vụ Mùa Giải sau: %s ngày %s giờ",
    ["BattlePass_27"]="Cài lại Nhiệm Vụ Khiêu Chiến sau: %s ngày %s giờ",
    ["BattlePass_28"]="Tiêu hao %s Zeny làm mới Nhiệm Vụ Thẻ Thông Hành Mỗi Ngày chứ",
    ["BattlePass_29"]="Chưa hoàn thành toàn bộ nhiệm vụ ngày, không thể làm mới",
    ["BattlePass_3"]=" cấp",
    ["BattlePass_30"]="Hãy xác nhận mua Thẻ Vinh Dự",
    ["BattlePass_31"]="Hãy xác nhận mua Thẻ Vinh Dự\nHãy lưu ý cấp Thẻ Thông Hành hiện tại để tránh bị thừa",
    ["BattlePass_32"]="Hoàn thành tất cả nhiệm vụ nhận %s",
    ["BattlePass_33"]="Nhiệm vụ sẽ ở%sđặt lại sau",
    ["BattlePass_34"]="Đã nhận thưởng này",
    ["BattlePass_35"]="Tiêu hao <color=#CA2E0AFF> %s </color> Kim Cương mua cấp Thẻ Thông Hành đến Lv.<color=#CA2E0AFF>%s</color>?",
    ["BattlePass_36"]="Xác nhận mua Thẻ Thử Vinh Dự?\nMua xong sẽ mở khóa Thẻ Vinh Dự Lv.<color=#CA2E0AFF>1-25</color>\n<size=18>(Đồng thời hưởng ưu đãi Thẻ Thông Hành và giá Gói Đặc Biệt <color=#CA2E0AFF>1488</color> Kim Cương)</size>",
    ["BattlePass_37"]="Đã mua được <color=#e7bb22>Thẻ Thử Vinh Dự</color>",
    ["BattlePass_38"]="Thẻ Vinh Dự",
    ["BattlePass_39"]="Thẻ Thử Vinh Dự",
    ["BattlePass_4"]="EXP: %s/%s",
    ["BattlePass_40"]="Mời xác nhận mua Thẻ Vinh Dự \n<size=18>(Thẻ Vương Quốc còn %s ngày sẽ làm mới, mời xác nhận có mua không?) </size>",
    ["BattlePass_41"]="Mời xác nhận mua Gói Ưu Đãi Vinh Dự\n<size=18>(Thẻ Vương Quốc còn %s ngày sẽ làm mới, mời xác nhận có mua không?) </size>",
    ["BattlePass_42"]="Mời xác nhận có mua Thẻ Thử Vinh Dự không? \n<size=18>(Sau khi mua, giá cả của Thẻ Thông Hành và Gói Ưu Đãi sẽ ưu đãi thành <color=#CA2E0AFF>1488</color> Kim Cương)</size>\n<size=18>(Thẻ Vương Quốc còn %s ngày sẽ làm mới, mời xác nhận có mua không?) </size>",
    ["BattlePass_5"]="EXP tuần này: %s/%s",
    ["BattlePass_6"]="Nhiệm vụ tuần %s",
    ["BattlePass_7"]="Level %s",
    ["BattlePass_8"]="Kích hoạt Thẻ Vinh Dự\nĐạt cấp tối đa có thể giúp cả đội vượt Phó Bản nhận Túi Nấu Ăn",
    ["BattlePass_9"]="Kích hoạt Thẻ Vinh Dự\nCấp Thẻ Thông Hành tăng đến Lv.25",
    ["BattlePlan_1"]="Có tiêu hao %d Pha Lê để mở phương án mới?\n(Phương án mới sẽ cài lại điểm cộng, điểm kỹ năng, trang bị, thiết lập Huân Chương Thành Tựu Chiến Đấu)",
    ["BattlePlan_10"]="Kích hoạt hoàn hảo~",
    ["BattlePlan_11"]="Kích hoạt một phần thành công~",
    ["BattlePlan_12"]="Hiện tại không có thẻ để kích hoạt~",
    ["BattlePlan_13"]="liệu có nên<color=#FF0000>không ràng buộc</color>Thẻ kích hoạt vào thiết bị",
    ["BattlePlan_14"]="Hãy chuyển sang kế hoạch này trước nhé~",
    ["BattlePlan_2"]="Đang chiến đấu không thể đổi phương án",
    ["BattlePlan_3"]="Đang chiến đấu không thể tạo mới phương án",
    ["BattlePlan_4"]="Trên xe không thể đổi phương án",
    ["BattlePlan_5"]="Trên xe không thể tạo mới phương án",
    ["BattlePlan_6"]="Trạng thái hiện tại không thể đổi phương án chiến đấu",
    ["BattlePlan_7"]="Quy tắc thẻ:\n1. Nút kích hoạt: Nhấp để đồng bộ hóa gói thẻ với thiết bị của riêng bạn.\n2.Nút lưu: Nhấp để đồng bộ hóa thẻ thiết bị của bạn với gói\n3. Trạng thái kích hoạt: Khi gói phù hợp với thẻ của chính nó, gói thẻ sẽ hiển thị được kích hoạt\n4. Khi chuyển đổi gói, tự động lấy thông tin thẻ được lưu trong gói đã kích hoạt\n5. Khi thông tin thiết bị được cập nhật theo thời gian thực, trạng thái thẻ trong gói sẽ thay đổi~\n6. Nếu bạn thay đổi loại vũ khí, trạng thái lỗ hổng trong kế hoạch sẽ thay đổi ~",
    ["BattlePlan_8"]="Quy tắc hệ thống:\n1. Nút lưu: Bấm để lưu thẻ của chính người chơi vào kế hoạch chiến đấu\n2. Các thao tác như đục lỗ, lắp thẻ và tháo thẻ có thể được thực hiện trong giao diện.\n3. Click vào thẻ để hiển thị chi tiết thẻ\n4. Khi thông tin thiết bị được cập nhật theo thời gian thực, trạng thái thẻ trong gói sẽ thay đổi~",
    ["BattlePlan_9"]="Hiện tại tôi không có thiết bị nào để lắp thẻ vào~",
    ["BattlePrepareContending"]="Chuẩn bị tranh đoạt",
    ["BattleShowTip_1"]="Cầu Năng Lượng không đủ!",
    ["BattleShowTip_2"]="Điểm Nạp NL không đủ!",
    ["BattleShowTip_3"]="SP không đủ!",
