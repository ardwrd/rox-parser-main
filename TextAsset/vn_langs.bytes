    ["IceFishingMain_11"]="Đến xem",
    ["IceFishingMain_12"]="<size=16>Sự kiện Tranh Bá Vua Cá đã kết thúc, thời gian còn lại có thể tham gia sự kiện khác~</size>",
    ["IceFishingMain_2"]="Nhiệm Vụ Ngày",
    ["IceFishingMain_3"]="Ước Nguyện Hoa Tuyết",
    ["IceFishingMain_4"]="{0}\nSự kiện Câu Cá Băng mở hai lần mỗi ngày\nĐịa điểm: Thành Phố Bánh Gừng",
    ["IceFishingMain_5"]="Thời gian mở:\n {0}\n {1}",
    ["IceFishingMain_6"]="Xem hướng dẫn",
    ["IceFishingMain_7"]="Trong số cá câu được của mỗi người câu, 10 con cá dài nhất sau khi cộng độ dài lại có thể cạnh tranh xếp hạng bảng tổng, nhận nhiều thưởng!",
    ["IceFishingMain_8"]="BXH Tranh Bá Vua Cá",
