    ["ui_GVG_055"]="Tổng cống hiến Công Hội",
    ["ui_GashaponReward_001"]="Nhấp để tiếp tục",
    ["ui_GashaponRule_001"]="Truyền Thuyết",
    ["ui_GashaponRule_002"]="Sử Thi",
    ["ui_GashaponRule_003"]="Hiếm",
    ["ui_GashaponRule_004"]="Thường",
    ["ui_GashaponRule_005"]="Danh sách thưởng Quay Trứng",
    ["ui_GashaponRule_006"]="Toàn bộ thưởng có thể xuất hiện",
    ["ui_GashaponRule_007"]="Tỉ lệ xuất hiện tăng",
    ["ui_GashaponRule_008"]="Đây là vật phẩm trúng thưởng may mắn, người tiêu phí mua hoặc tham gia sự kiện không đồng nghĩa sẽ nhận được vật phẩm đặc biệt",
    ["ui_GashaponTips_001"]="Nhìn lại kỳ trước",
    ["ui_GashaponTips_002"]="Quy tắc rút thưởng:",
    ["ui_GashaponTips_003"]="1. Nhà Thám Hiểm mỗi tốn 1 Xu Quay Trứng sẽ nhận 1 điểm, điểm nhận được sẽ tự động tham gia sự kiện rút thưởng điểm của Máy Quay Thẻ vừa dùng. Điểm sẽ xóa sau khi mở thưởng lần này, không thể tích lũy cho lượt rút sau.",
    ["ui_GashaponTips_004"]="2. Khi tích đủ số điểm cho một lượt rút thưởng thì sẽ mở thưởng ngay, điểm cá nhân càng cao thì tỷ lệ trúng thưởng càng cao. Sau khi mở, thưởng sẽ được gửi đến Nhà Thám Hiểm may mắn qua Thư. Khi đó, mời các Nhà Thám Hiểm chú ý nhận thưởng.",
    ["ui_GashaponTips_005"]="Thưởng hiện tại",
    ["ui_GashaponTips_006"]="Thưởng lượt sau",
    ["ui_GashaponTips_007"]="Điểm: %s",
    ["ui_GashaponTips_008"]="Thời gian: %s",
    ["ui_GashaponTips_009"]="Lv.%s",
    ["ui_GashaponTips_010"]="3. Điểm nhận được từ một Máy Quay có giới hạn hàng ngày, (được cài lại vào lúc 5:00 sáng vào thời gian game hàng ngày), số điểm vượt quá sẽ không được tính.",
    ["ui_GashaponTips_011"]="4. Mỗi vòng rút thưởng của một Máy Quay đều có giới hạn nhận, số điểm vượt quá sẽ không được tính.",
    ["ui_GashaponTips_012"]="5. Mỗi ngày quỹ thưởng của một Máy Quay có thể rút và phát thưởng tối đa 2 lần, sau 2 lần, sẽ được tích lũy vào mở thưởng của ngày hôm sau (cài lại vào lúc 5:00 sáng vào thời gian game).",
    ["ui_GashaponTips_013"]="Giới hạn hàng ngày: %s",
    ["ui_GashaponTips_014"]="Giới hạn vòng này: %s",
    ["ui_GashaponTips_015"]="Mở thưởng còn lại hôm nay: %s lần",
    ["ui_GashaponTips_016"]="Nhà Thám Hiểm thân mến, hôm nay bạn không còn nhận được điểm khi rút thưởng nữa, bạn có muốn tiếp tục rút thưởng không?",
    ["ui_GashaponTips_017"]="Nhà Thám Hiểm thân mến, vòng này bạn không còn nhận được điểm khi rút thưởng nữa, bạn có muốn tiếp tục rút thưởng không?",
    ["ui_GashaponTips_018"]="Nhà Thám Hiểm thân mến, quỹ thưởng của Máy Quay đã đạt đến giới hạn số lần mở thưởng hôm nay, không thể nhận được điểm bằng cách rút thưởng. Bạn có tiếp tục rút thưởng không?",
    ["ui_Gashapon_001"]="Hiển thị đạo cụ",
    ["ui_Gashapon_002"]="Chi tiết",
    ["ui_Gashapon_003"]="Di chuyển ngón tay lên xuống theo hướng dẫn",
