    ["ui_SuperSniper_001"]="Nhiệm Vụ Khiêu Chiến",
    ["ui_SuperSniper_002"]="Tham gia sự kiện có thể nhận được thưởng nguyên liệu chuyển nghề Xạ Thủ Thần",
    ["ui_SuperSniper_003"]="Hoàn thành nhiệm vụ tặng phúc lợi chuyển nghề",
    ["ui_SuperSniper_004"]="Đăng nhập hàng ngày nhận thưởng chuyển nghề",
    ["ui_SwitchingLines_001"]="Vương Quốc quy định chỉ cho phép Thương Gia bán hàng ở kênh 1",
    ["ui_TaekwondoActivity_001"]="Tham gia sự kiện có thể nhận thưởng nguyên liệu chuyển nghề Taekwon. Trong thời gian sự kiện, thức tỉnh Shadow không cần hoàn thành nhiệm vụ",
