    ["DialogueOption39502031"]="Đúng vậy",
    ["DialogueOption39503011"]="…?",
    ["DialogueOption39504011"]="Trứng rồng?!",
    ["DialogueOption39504021"]="Không phải trứng rồng đã sớm...",
    ["DialogueOption39507011"]="Tất nhiên",
    ["DialogueOption39601011"]="Hướng dẫn Chuyển Nghề...?",
    ["DialogueOption39601021"]="(Gật đầu)",
    ["DialogueOption39601031"]="…?",
    ["DialogueOption39602011"]="(Chào hỏi)",
    ["DialogueOption39602012"]="(Có chuyện bàn bạc)",
    ["DialogueOption39602021"]="(Chống hông kiêu ngạo)",
    ["DialogueOption39602031"]="Nghi Thức Tế Thần?",
    ["DialogueOption39603011"]="Ngươi sợ không?",
    ["DialogueOption39603041"]="Vậy tín vật của Chuyển Nghề...?",
    ["DialogueOption39604011"]="…?",
    ["DialogueOption39606011"]="Còi sói...?",
    ["DialogueOption39606031"]="(Kiên định) Ta biết rồi",
    ["DialogueOption39607011"]="Tất nhiên",
    ["DialogueOption39701011"]="(Gật đầu)",
    ["DialogueOption39703011"]="(Ngạc nhiên) Nhiều như vậy sao?",
    ["DialogueOption39703021"]="(Lắc đầu) Ta chỉ…",
    ["DialogueOption39705011"]="(Nói ra sự thật)",
    ["DialogueOption39705021"]="(Do dự) Bởi vì...",
    ["DialogueOption39705031"]="Ta chỉ nghĩ rằng…",
    ["DialogueOption39705041"]="...??!!",
    ["DialogueOption39705071"]="(Im lặng)…",
    ["DialogueOption39706011"]="(Gật đầu chắc nịch)",
    ["DialogueOption39708011"]="(Vui mừng) Vậy ta...",
    ["DialogueOption39708031"]="Ý ngươi là…?",
    ["DialogueOption39711011"]="Hướng dẫn Chuyển Nghề...?",
