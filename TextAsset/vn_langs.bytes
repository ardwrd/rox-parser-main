    ["DialogueOption39101031"]="…?",
    ["DialogueOption39104011"]="???",
    ["DialogueOption39104021"]="(Mau đưa tay ra)",
    ["DialogueOption39104041"]="Thí luyện gì?",
    ["DialogueOption39105011"]="Quả đúng là cố ý!",
    ["DialogueOption39105021"]="(Nén giận)",
    ["DialogueOption39106011"]="Tất nhiên",
    ["DialogueOption39202011"]="(Gật đầu)",
    ["DialogueOption39202031"]="Vì vậy mong ngươi có thể...",
    ["DialogueOption39204021"]="Tiền bối của Sao Bí Thuật...?",
    ["DialogueOption39205011"]="Trái Tim Nguyên Tố?",
    ["DialogueOption39301011"]="Hướng dẫn Chuyển Nghề...?",
    ["DialogueOption39301021"]="(Gật đầu)",
    ["DialogueOption39301031"]="…?",
    ["DialogueOption39302011"]="Phù Văn Rune...",
    ["DialogueOption39302012"]="Chuyển Nghề mới...",
    ["DialogueOption39302021"]="…Truyền thuyết?",
    ["DialogueOption39302031"]="Tín vật Chuyển Nghề?",
    ["DialogueOption39303011"]="Ngươi đang làm gì đấy?",
    ["DialogueOption39303021"]="Vậy còn cần gì khác?",
    ["DialogueOption39303041"]="Ngươi có thể nói trọng tâm không",
    ["DialogueOption39303061"]="(Há hốc kinh ngạc)",
    ["DialogueOption39304011"]="(Tỏ lòng biết ơn)",
    ["DialogueOption39305011"]="Tất nhiên",
    ["DialogueOption39402011"]="(Hỏi về nghề mới)",
    ["DialogueOption39402021"]="…?",
    ["DialogueOption39403011"]="Sao vậy?",
    ["DialogueOption39403021"]="Tất nhiên không có vấn đề gì",
    ["DialogueOption39404011"]="Cuốn sách này rất quan trọng sao?",
    ["DialogueOption39405041"]="(Luống cuống) Ta...",
    ["DialogueOption39405051"]="Đây là…",
    ["DialogueOption39406011"]="Mảnh vỡ về lại tay dũng giả",
    ["DialogueOption39406012"]="Một cuộc thám hiểm mới lại bắt đầu",
    ["DialogueOption39406041"]="(Cất sách)",
    ["DialogueOption39406042"]="(Trả lại Alice)",
    ["DialogueOption39406071"]="(Hiểu lờ mờ)",
    ["DialogueOption39501011"]="Hướng dẫn Chuyển Nghề...?",
    ["DialogueOption39501021"]="(Gật đầu)",
    ["DialogueOption39501031"]="…?",
