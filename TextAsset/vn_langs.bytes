    ["ui_GVG_040"]="Chi tiết Chiến Đấu",
    ["ui_GVG_041"]="Xếp hạng điểm hiện tại",
    ["ui_GVG_042"]="Chỉ hiển thị người chơi Công Hội này",
    ["ui_GVG_043"]="Tử trận",
