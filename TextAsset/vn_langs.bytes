    ["ui_ReturnActivity_004"]="Ngày Thứ %s",
    ["ui_ReturnActivity_005"]="Sôi Nổi tích lũy",
    ["ui_ReturnActivity_006"]="Lần đầu về Vương Quốc",
    ["ui_ReturnActivity_007"]="Vào Tiên Cảnh",
    ["ui_ReturnActivity_008"]="Arm for Glory",
    ["ui_ReturnActivity_009"]="Thể Hiện Bản Lĩnh",
    ["ui_ReturnActivity_010"]="Dũng Sĩ Vương Quốc",
    ["ui_ReturnActivity_011"]="Chào mừng trở lại, Nhà Thám Hiểm:",
    ["ui_ReturnActivity_012"]="Bạn đã rời Midgard một khoảng thời gian rồi...\n Câu chuyện ở nơi này vẫn tiếp diễn từng ngày,\n mỗi cung bậc cảm xúc ở nơi này đều nhắc nhớ đến bạn,\n thật may vì bạn chưa đi quá xa! \nChúng tôi đặc biệt chuẩn bị Khiêu Chiến Trở Về và Quà Trở Về dành riêng cho bạn, ",
    ["ui_ReturnActivity_013"]="Chào mừng Nhà Thám Hiểm về nhà!",
    ["ui_ReturnActivity_014"]="—Nhóm dự án Thế Hệ Mới",
    ["ui_ReturnActivity_015"]="Mở Khiêu Chiến Trở Về",
    ["ui_ReturnActivity_016"]="Nền Tảng Hộ Quốc",
    ["ui_ReturnActivity_017"]="Khắc Tinh Tà Ác",
    ["ui_ReturnActivity_018"]="Thẻ Thông Hành Quay Về",
    ["ui_ReturnActivity_019"]="Mức miễn phí",
    ["ui_ReturnActivity_020"]="Mức trả phí",
    ["ui_Reward_001"]="Nhấp để tiếp tục",
    ["ui_RichMan_001"]="Tự động",
    ["ui_RichMan_002"]="Xác nhận thưởng",
    ["ui_RichMan_003"]="Nhận Ngay",
    ["ui_RichMan_004"]="Chơi Lại",
    ["ui_RichMan_005"]="Thắng Đầy Sao",
    ["ui_RichMan_006"]="Chọn điểm số",
    ["ui_RichMan_007"]="Hãy chọn điểm số",
    ["ui_RichMan_008"]="Tiệm Đổi",
    ["ui_RichMan_009"]="Bắt đầu khiêu chiến",
    ["ui_RichMan_010"]="Xem liên tục",
    ["ui_RichMan_011"]="Vui phơi phới",
    ["ui_RichMan_012"]="Va chạm vui vẻ",
    ["ui_RichMan_013"]="Shizue",
    ["ui_RichMan_014"]="Ramiris",
    ["ui_RichMan_015"]="Rimuru",
    ["ui_RichMan_016"]="Milim",
    ["ui_RichMan_017"]="Shuna",
    ["ui_RichMan_018"]="Shion",
    ["ui_RichMan_019"]="Hạng",
    ["ui_RichMan_020"]="Người chơi",
    ["ui_RichMan_021"]="Số vòng Xứ Thần Tiên",
    ["ui_RichMan_022"]="Tích lũy mua",
    ["ui_RichMan_023"]="Giá tính tổng",
    ["ui_RichMan_024"]="Người mua càng nhiều, giá quà sẽ càng thấp! \nNếu giá mua vượt giá tổng, sẽ hoàn trả phần vượt khi hết HĐ",
    ["ui_RichMan_025"]="Được nhận",
    ["ui_RichMan_026"]="Milim Nava",
    ["ui_RichMan_027"]="<color=#00000000>Trong</color> làn sóng giao động ma pháp, trên vùng đất Midgard đã xuất hiện điều kỳ diệu! Hãy đọc những quy tắc quan trọng trong \"Xứ Thần Tiên\"! Khi bước vào xứ sở thần kỳ này, có thể sẽ có những điều bất ngờ sẽ xảy ra. Khi bước vào Xứ Thần Tiên, có thể sẽ gây ảnh hưởng trực tiếp đến vật và việc trong xứ sở. Hoàn thành những minigame còn có thể nhận thưởng đấy! Hãy cùng đám người Rimuru cùng nhau khám phá Xứ Thần Tiên, đối đầu hiểm nguy và nhận những phần quà hấp dẫn nhé!",
    ["ui_RichMan_028"]="Tốn VIP Kafra để giảm giá <size=20>20</size>%",
    ["ui_RichMan_029"]="Ủy Thác Siêu Cute",
    ["ui_RichMan_030"]="Giá:",
    ["ui_RichMan_031"]="<color=#ff4855FF>%s</color>",
    ["ui_RichMan_032"]="<color=#FFFFFF>%s</color>",
    ["ui_RichMan_033"]="Điểm hiện tại: %s/%s",
    ["ui_RichMan_034"]="· Sau khi trò chơi bắt đầu, cần tranh thủ thời gian, ghi nhớ nhanh các hình ảnh thẻ\n· Lật liền hai tấm thẻ giống nhau, sẽ xóa được chúng và nhận điểm tương ứng\n· Nếu lật hai tấm thẻ khác nhau, sẽ lãng phí thời gian quý báu!",
    ["ui_RichMan_035"]="· Sau khi trò chơi bắt đầu, cần nhanh tay nhấp Poring để đuổi chúng đi\n· Ưu tiên đuổi mục tiêu là Deviling đi trước\n· Chú ý đừng đuổi Angeling và Poring Quốc Vương đi\n· Đuổi mục tiêu Slime đi sẽ chịu phạt",
    ["ui_RichMan_036"]="· Sau khi trò chơi bắt đầu, cần nhanh tay nhấp vào dấu hỏi để mở Xu Sao\n· Trong số 5 dấu hỏi bí ẩn mỗi vòng, chỉ có 1 dấu có Xu Sao\n· Nếu không hài lòng với vận may, có thể làm mới vào vòng sau ngay\n· Tối đa có thể tiến hành 10 vòng lật, mỗi vòng tối đa được thử 3 lần\n· Mỗi khi lật được thêm 1 sao, thưởng cuối cùng sẽ tăng thêm 1 Xu Vàng Xứ Thần Tiên",
    ["ui_RichMan_037"]="Vượt qua thử thách nhận đạo cụ để vui chơi Xứ Thần Tiên nào!",
    ["ui_RichMan_038"]="Nhắm chuẩn và đập Deviling và đồng bọn. Kiếm càng nhiều điểm trong %s giây! \nCẩn thận kẻo đập nhầm mục tiêu nha!",
    ["ui_RichMan_039"]="Búa dính %s giây",
    ["ui_RichMan_040"]="Về góc nhìn cũ",
    ["ui_RichMan_041"]="Học Viên Ưu Tú có thể nhận được thưởng SK Liên Kết - <color=#4099ff>Danh Hiệu Chuyên Thuộc</color> sau khi SK kết thúc đấy ~",
    ["ui_RichMan_042"]="(Làm mới số lần mua vào 5:00 hàng ngày)",
    ["ui_RichMan_055"]="Xúc Xắc Thường",
    ["ui_RichMan_056"]="Xúc Xắc Từ Xa",
