    ["GroupInstance_1"]="Đoàn %s người",
    ["GroupSceneTips1"]="Trong phó bản đơn không thể dịch chuyển!",
    ["GroupTaskname1"]="Nhóm nhiệm vụ phân nhóm Thuyền Đắm",
    ["GroupTaskname2"]="Nhiệm vụ kỳ ngộ Thuyền Đắm",
    ["GroupTaskstep1"]="Hoàn thành kỳ ngộ map Thuyền Đắm",
    ["GroupTaskstep2"]="Có 10 Mũi Tên Đóng Băng",
    ["GroupsInvitationContent"]="Gửi người bạn thân thiết nhất của tôi, tôi sắp kết hôn, tôi muốn chia sẻ niềm vui này với bạn. Vì vậy, chúng tôi chân thành mời bạn trở thành thành viên Nhóm Người Thân trong Đám Cưới của chúng tôi. Bạn đến được, chúng tôi sẽ rất vui, nếu có việc không đến được, chúng tôi cũng sẽ thông cảm. Mong sớm nhận được câu trả lời.",
    ["GuestsInvitationContent"]="Gửi người bạn thân thiết nhất của tôi, tôi sắp kết hôn, tôi muốn chia sẻ niềm vui này với bạn. Vì vậy, chúng tôi chân thành mời bạn trở thành thành viên Nhóm Khách trong Đám Cưới của chúng tôi. Bạn đến được, chúng tôi sẽ rất vui, nếu có việc không đến được, chúng tôi cũng sẽ thông cảm. Mong sớm nhận được câu trả lời.",
    ["GuideInfo1"]="Đang tìm chỉ dẫn…",
