    ["UI_ShadowInherit_003"]="Shadow phụ",
    ["UI_ShadowInherit_004"]="Kế thừa nhận được cấp Shadow phụ và cấp kỹ năng Shadow",
    ["UI_ShadowInherit_005"]="Sau khi kế thừa sẽ không tiêu hao Shadow phụ",
