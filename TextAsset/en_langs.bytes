    ["ItemDes_10204244"]="A kit containing Glistening Coats. Use it to obtain Glistening Coat x100.",
    ["ItemDes_10204245"]="A kit containing Concentrated Alcohol. Use it to obtain Concentrated Alcohol x100.",
    ["ItemDes_10204246"]="A kit containing Explosive Powder. Use it to obtain 100 Explosive Powder.",
    ["ItemDes_10204247"]="A kit containing Corrosion Potions. Use it to obtain Corrosion Potion x100.",
    ["ItemDes_10204248"]="A kit containing Oil Bottles. Use it to obtain Oil Bottle x100.",
    ["ItemDes_10204249"]="A kit containing Smoke Powder. Use it to obtain Smoke Powder x100.",
    ["ItemDes_10204250"]="A kit containing Tear Gas. Use it to obtain Tear Gas x100.",
