    ["BuffDes_50014021"]="The pet and its owner deal 20% more damage to Holy attribute targets and receive 20% less Holy damage for 60 seconds.",
    ["BuffDes_55002192"]="Received fire stat damage increased by<color=#44afee>50%%</color>",
