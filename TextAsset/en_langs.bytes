    ["SceneLineStateTips007"]="Switch to [Channel {0}]",
    ["SceneLineStateTips008"]="The law of the kingdom requires all merchants to run their shop in Channel 1 of their respective region.\nDo you want to go there and run a shop now?",
    ["SceneLineStateTips009"]="You cannot switch channels currently. Please try again later!",
    ["SceneLineStateTips010"]="Cannot change dimensions because you are currently in a battle. Please try again after leaving combat.",
