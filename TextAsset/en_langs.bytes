    ["DialogueOption30047031"]="Inner justice.",
    ["DialogueOption30047051"]="What's going on here?",
    ["DialogueOption30047071"]="Right!",
    ["DialogueOption30048011"]="Who are you?",
    ["DialogueOption30048031"]="Please tell me!",
    ["DialogueOption30049011"]="Are you kidding me?",
