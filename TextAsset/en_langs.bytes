    ["DialogueOption30078051"]="Leave it to me!",
    ["DialogueOption30078061"]="There's a seal!?",
    ["DialogueOption30079011"]="Leave it to me!",
    ["DialogueOption30080011"]="What happened here?",
    ["DialogueOption30080021"]="I shall seal the rift.",
    ["DialogueOption30080041"]="About the crystal...",
