    ["EnchantAttrDismantle"]="You need to use following items to remove an Enchantment Stone:",
    ["EnchantAttrLevelUp"]="Upgrade the enchantment to get the following stats:",
    ["EnchantAttrLv1"]="Stat preview Lv.1",
    ["EnchantAttrLv10"]="Stat preview Lv.10",
