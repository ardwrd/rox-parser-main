    ["ui_GVGRules_058"]="300",
    ["ui_GVGRules_059"]="750",
    ["ui_GVGRules_060"]="600",
    ["ui_GVGRules_061"]="1000",
    ["ui_GVGRules_062"]="600",
    ["ui_GVGRules_063"]="When the event ends, the Guild War Committee will give Merit Medals of varying qualities to adventurers according to their Merit contributions.",
    ["ui_GVGRules_064"]="Merit rewards will be issued via mail.",
    ["ui_GVGRules_065"]="Merit Point Ranges",
    ["ui_GVGRules_066"]="500-999",
    ["ui_GVGRules_067"]="1000-1499",
    ["ui_GVGRules_068"]="≥1500",
    ["ui_GVGRules_069"]="Medal Level",
    ["ui_GVGRules_070"]="Bronze Medal",
    ["ui_GVGRules_071"]="Silver Medal",
    ["ui_GVGRules_072"]="Gold Medal",
    ["ui_GVGRules_073"]="Reward Contents",
    ["ui_GVGRules_074"]="GVG Participation Chest x1",
    ["ui_GVGRules_075"]="GVG Participation Chest x2",
    ["ui_GVGRules_076"]="GVG Participation Chest x5",
    ["ui_GVGRules_077"]="City Occupation Reward",
    ["ui_GVGRules_078"]="The Guild War Committee will issue a GVG City Occupation Reward to the guild that has ownership of the city when the event ends via mail.",
    ["ui_GVGRules_079"]="Reward Target",
    ["ui_GVGRules_080"]="All guild members having ownership of the GVG City.",
    ["ui_GVGRules_081"]="Claim Restrictions",
    ["ui_GVGRules_082"]="Must obtain ≥ 200 Merit in the current round.",
    ["ui_GVGRules_083"]="Reward Contents",
    ["ui_GVGRules_084"]="GVG City Owner Chest",
    ["ui_GVGRules_085"]="Event Guide",
    ["ui_GVGRules_086"]="Kill Assist",
    ["ui_GVGRules_087"]="1",
    ["ui_GVGRules_088"]="100",
    ["ui_GVGRules_101"]="Abyssal Arcade",
    ["ui_GVGRules_102"]="Participation Rules",
    ["ui_GVGRules_103"]="Eligibility: Guilds that obtained base ownership during the GVG event will be eligible to enter the Abyssal Arcade.",
    ["ui_GVGRules_104"]="Available Time: Available to enter from <color=#338dc3>22:00 to 23:00 (UTC+7)</color> daily.",
    ["ui_GVGRules_105"]="Event Entrance: Portal at the base banner. Only guild members with base ownership can see it.",
    ["ui_GVGRules_106"]="Gameplay Description",
    ["ui_GVGRules_107"]="The 8 guilds that won bases will battle for resources in the Abyssal Arcade.",
    ["ui_GVGRules_108"]="Different guilds are hostile to each other within the Abyssal Arcade battlefield.",
    ["ui_GVGRules_109"]="A randomly generated MVP of the Abyssal Mode will appear 10/30/50 minutes after the Abyssal Arcade is activated, and Abyssal Treasure will be dropped once the MVP is defeated.",
    ["ui_GVGRules_110"]="There will be Abyssal Monsters appearing periodically in the Abyssal Arcade, and there is a chance for them to drop mysterious Cargo after being defeated.",
    ["ui_GVGRules_111"]="Submit Cargo",
    ["ui_GVGRules_112"]="Deliver Mysterious Cargo or Abyssal Treasure you picked up from Abyssal to W in the Safe Zone to receive huge rewards such as Abyssal Essence.",
    ["ui_GVGRules_113"]="During the transport, your speed will decrease, and you can't conceal yourself. The Cargo will be dropped on the ground if the enemy defeats you.",
    ["ui_GVGRules_114"]="Friendly Reminder",
    ["ui_GVGRules_115"]="You can only submit Mysterious Cargo or Abyssal Treasure up to 6 times EACH to claim rewards every day. Escort Rewards can only be claimed 3 times per day.",
    ["ui_GVGRules_116"]="Collect Abyssal Essence to exchange (from Guild Merchant on guild territory) for the special title that increases the combat ability in GVG and Abyssal Mode.",
    ["ui_GVGRules_117"]="Tyr Altar Intro",
    ["ui_GVGRules_118"]="Tyr Altar appears in the <color=#338dc3>Defensive War</color>, and <color=#338dc3>Clash of Champions</color> modes.",
    ["ui_GVGRules_119"]="The entering of Attackers and Defenders into the Tyr Altar increases its progress.",
    ["ui_GVGRules_120"]="Successfully capturing the Tyr Altar increases the Blessing of Tyr effect and expels the Resurrection Penalty of the same faction party members within the Altar.",
    ["ui_GVGRules_121"]="Get an additional Escort Reward when you escort teammates to submit cargo (The escort distance is within 30 meters)",
    ["ui_GVGRules_122"]="Guild Merit Ranking Rewards",
    ["ui_GVGRules_123"]="Merit Ranking Ranges",
    ["ui_GVGRules_124"]="1–3",
    ["ui_GVGRules_125"]="4–10",
    ["ui_GVGRules_126"]="11–30",
    ["ui_GVGRules_127"]="≥31",
    ["ui_GVGRules_128"]="Note: Participation in Ranking requires a Merit higher than 500",
    ["ui_GVGRules_129"]="The guilds in the Cross-Server GVG Qualifying Match will get ranked based on GVG Points. The top 4 guilds in terms of points in the cycle will be qualified to participate in the Cross-Server GVG.",
    ["ui_GVGRules_130"]="Monthly GVG Points = The sum of Weekly GVG Points",
    ["ui_GVGRules_131"]="Weekly GVG Points = Total Merit gained by participants x 2 + Total Guild Contribution gained by guild members during the cycle x 15 + Total number of occupied bases in the GVG Battles during the cycle x 10,000",
    ["ui_GVGRules_132"]="The points will be updated for the Cross-Server GVG Qualifier List after the settlement of each GVG. After the last GVG of the month, the points will be finalized.",
    ["ui_GVGRules_133"]="Note: A guild must have at least 10 members to participate in a GVG Battle. Otherwise, the Total Merit gained by the participants during the week will not be counted toward the GVG Points.",
    ["ui_GVGRules_134"]="Cross-Server GVG takes place on the last Sunday at 21:30 (UTC+7) of each month. Please refer to the in-game notice for special circumstances.",
