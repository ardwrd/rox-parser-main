    ["ui_LuckWheel_001"]="OK",
    ["ui_LuckWheel_002"]="Enter number",
    ["ui_LuckWheel_003"]="Past Name List",
    ["ui_LuckWheel_004"]="Draw",
    ["ui_LuckWheel_005"]="Bet on an Adventurer",
    ["ui_LuckWheel_006"]="Lucky Number",
    ["ui_LuckWheel_007"]="Betting Time",
    ["ui_LuckWheel_008"]="Reward Preview",
    ["ui_LuckWheel_009"]="Grand Prize",
    ["ui_LuckWheel_010"]="First Prize",
    ["ui_LuckWheel_011"]="Second Prize",
    ["ui_LuckWheel_012"]="Third Prize",
    ["ui_LuckWheel_013"]="Fourth Prize",
    ["ui_LuckWheel_014"]="Fifth Prize",
    ["ui_LuckWheel_015"]="Selection Rules",
    ["ui_LuckWheel_016"]="Each adventurer can select and place bets on up to 100 lucky numbers in each Lucky Lottery draw.",
    ["ui_LuckWheel_017"]="When placing bets, the same/repeated numbers can be selected.",
    ["ui_LuckWheel_018"]="Each adventurer gets one free chance to place a bet every time the event is held.",
    ["ui_LuckWheel_019"]="Draw Rules:",
    ["ui_LuckWheel_020"]="Draws happen daily at 20:00. Rewards are sent via Mail at 22:00.",
    ["ui_LuckWheel_021"]="The Kafra Lady will randomly pick one number to become the Lucky Number",
    ["ui_LuckWheel_022"]="If a number has been bet on multiple times, it will appear multiple times on the number list. The more you buy, the greater your chance of winning.",
    ["ui_LuckWheel_023"]="The chance of winning is the same whether you manually select numbers or get the system to select random numbers for you. Please place your bets in your preferred way.",
    ["ui_LuckWheel_024"]="Reward Rules:",
    ["ui_LuckWheel_025"]="The number and its position must both be identical to guess the number correctly.",
    ["ui_LuckWheel_026"]="Adventurers who guess two or more numbers correctly will win a reward.",
    ["ui_LuckWheel_027"]="The more numbers that are guessed correctly, the better the rewards.",
    ["ui_LuckWheel_028"]="The first adventurer to place their bet and get all the numbers right will get an extra lucky prize.",
    ["ui_LuckWheel_029"]="Lucky Lottery rewards will be distributed via mail after all the lucky numbers are revealed each time the draw is held.",
    ["ui_LuckWheel_030"]="Display Rules",
    ["ui_LuckWheel_031"]="Only adventurers who have won lucky prizes will be shown on the event screen.",
    ["ui_LuckWheel_032"]="Random adventurers will be shown before the first draw.",
    ["ui_LuckWheel_033"]="Adventurers can Like the displayed model once per day.",
    ["ui_LuckWheel_034"]="Get a Like Gift Pack every time you give a Like every day.",
    ["ui_LuckWheel_035"]="Lucky Lottery Rules",
    ["ui_MVPChallenge_001"]="Server Launch Event",
    ["ui_MVPChallenge_002"]="MVP Best Challenger",
