    ["ui_ChristmasActivity_007"]="Individual Progress:",
    ["ui_ChristmasGift_001"]="Christmas Carnival Pack",
    ["ui_ChristmasMagic_001"]="Shot Mode",
    ["ui_ChristmasMagic_002"]="Christmas Event",
    ["ui_ChristmasMagic_003"]="Christmas Shootout",
    ["ui_ChristmasMagic_004"]="Go to the Christmas Shop in Geffen to purchase.\nRequired Holiday-exclusive Item: Elk Slingshot",
    ["ui_ChristmasMagic_005"]="Use Odin's Blessing to get magic projectiles.\nThe higher the quality of the projectiles, the greater their power.",
    ["ui_ChristmasMagic_006"]="Use the Elk Slingshot or approach the battery to activate ranged attack view, and then aim at the balloons and fire away. Pop a balloon to get a Christmas Gift. The larger the balloon, the greater the reward!",
    ["ui_ChristmasMagic_007"]="Geffen, the City of Magic, is currently holding a Christmas Magic Ball Festival.",
    ["ui_ChristmasMagic_008"]="Hit the balloons to get exquisite Christmas Gifts!",
    ["ui_ChristmasMagic_009"]="Christmas Exchange",
