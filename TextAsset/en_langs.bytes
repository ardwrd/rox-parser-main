    ["ui_Login_035"]="<color=#5c903c>(Required)</color> I have read and agree to the \"Terms of Service.\"",
    ["ui_Login_036"]="<color=#5c903c>(Required)</color> I have read and agree to the \"Privacy Policy.\"",
    ["ui_Login_037"]="(Optional) Agree to receive event promotion during non-nighttime (8:00-21:00).",
    ["ui_Login_038"]="(Optional) Agree to receive event promotion during nighttime (21:00-8:00).",
    ["ui_Login_039"]="Details",
    ["ui_Login_040"]="Agreement",
    ["ui_Login_041"]="<color=#5c903c>(Required)</color> Underage Verification",
    ["ui_Login_056"]="Tips",
    ["ui_Login_058"]="Please select the third-party account you wish to data link.",
    ["ui_Login_059"]="Highest Level Character Info on the Account:",
    ["ui_Login_060"]="Dear Player, if you choose \"Disagree,\" you will not be able to play with your original characters on the Hong Kong, Macau, and Taiwan main servers.\nYou can create a new character in any other main server to continue playing.",
    ["ui_Login_061"]="Data linking, please wait...",
    ["ui_Login_062"]="Data link has been completed! You may now continue your journey!",
    ["ui_Login_063"]="Some of your characters failed to link. The system is retrying automatically. Please wait.\nYou can still log in using characters whose data link has been completed.\nUntil all characters finish linking, creating/deleting characters on the Hong Kong, Macau, and Taiwan main server is temporarily unavailable.\nWe're sorry for the inconvenience. If you have any issues, please contact in-game support.",
    ["ui_Login_064"]="Data Link",
    ["ui_Login_065"]="Agree",
    ["ui_Login_066"]="Disagree",
    ["ui_Login_067"]="Still Disagree",
    ["ui_Login_068"]="Confirm",
    ["ui_Login_069"]="Information Confirmation",
    ["ui_Login_070"]="To improve your gameplay experience, we're linking data across multiple regions. You'll soon meet Adventurers from even more places through features like the Exchange Center. By selecting \"Agree,\" you confirm that you've read and accepted the [a href=https://sf19-draftcdn-sg.ibytedtos.com/obj/ies-hotsoon-draft-sg/GSDK/768a3aa4-67ef-4bb1-9f46-9c65df047be9.html ]Data Link Notice[/a].",
    ["ui_LoiKratongFestival_001"]="Charming Lantern",
