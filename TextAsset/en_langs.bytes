    ["ResonateDesc_38"]="Awakening Criteria:\nIncrease the Refinement of 8 equipment to +13.",
    ["ResonateDesc_39"]="Awakening Criteria:\nIncrease the Refinement of 8 equipment to +14.",
    ["ResonateDesc_40"]="Awakening Criteria:\nIncrease the Refinement of 8 equipment to +15.",
    ["ResonateDesc_41"]="Awakening Criteria: Upgrade 8 pieces of equipment to Tier XI.\nWeapon: <color=#ffc821>+260</color>\nArmor: <color=#ffc821>+130</color>\nAccessory: <color=#ffc821>+65</color>",
    ["ResonateDesc_type489"]="Awakening Requirement: <color=#ffc821>Each weapon type</color> needs to have a weapon score greater than <color=#ffc821>%s</color>, and the total <color=#ffc821>number of weapon types</color> must reach <color=#ffc821>%s</color> (%s/%s).",
    ["ResonateTextDesc_1701"]="Awakening Condition:\nDeploy Pet (<color=#ffc821>3</color>-Star) x<color=#ffc821>2</color>.",
    ["ResonateTextDesc_1702"]="Awakening Condition:\nDeploy Pet (<color=#ffc821>3</color>-Star) x<color=#ffc821>1</color> and Pet (<color=#ffc821>5</color>-Star) x<color=#ffc821>1</color>.",
    ["ResonateTextDesc_1703"]="Awakening Condition:\nDeploy Pet (<color=#ffc821>5</color>-Star) x<color=#ffc821>2</color>.",
    ["ResonateTextDesc_1704"]="Awakening Condition:\nDeploy Pet (<color=#ffc821>5</color>-Star) x<color=#ffc821>1</color> and Pet (<color=#ffc821>7</color>-Star) x<color=#ffc821>1</color>.",
    ["ResonateTextDesc_1705"]="Awakening Condition:\nDeploy Pet (<color=#ffc821>5</color>-Star) x<color=#ffc821>1</color> and Pet (<color=#ffc821>7</color>-Star) x<color=#ffc821>2</color>.",
    ["ResonateTextDesc_1706"]="Awakening Condition:\nDeploy Pet (<color=#ffc821>7</color>-Star) x<color=#ffc821>2</color> and Pet (<color=#ffc821>8</color>-Star) x<color=#ffc821>1</color>.",
    ["ResonateTextDesc_1707"]="Awakening Condition:\nDeploy Pet (<color=#ffc821>7</color>-Star) x<color=#ffc821>2</color> and Pet (<color=#ffc821>9</color>-Star) x<color=#ffc821>1</color>.",
    ["ResonateTextDesc_1708"]="Awakening Condition:\nDeploy Pet (<color=#ffc821>7</color>-Star) x<color=#ffc821>2</color> and Pet (<color=#ffc821>9</color>-Star) x<color=#ffc821>2</color>.",
