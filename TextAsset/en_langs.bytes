    ["DemonSlayerBP_advanced"]="Trial Supply",
    ["DemonSlayerBP_advanced_desc"]="Purchase to claim <color=#CA2E0AFF>Daily Supply</color>\n and obtain <color=#CA2E0AFF>2,000</color> Trial EXP instantly.\nGrants <color=#CA2E0AFF>7,000</color> EXP at most during the event",
