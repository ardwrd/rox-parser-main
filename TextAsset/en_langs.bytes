    ["BattlePass_36"]="Are you sure you want to buy an Glory Trial Card?\nPurchasing this card will unlock your Glory Pass Lv.<color=#CA2E0AFF>1-25</color>.\n<size=18>(In addition, the price of Passes and Super Packs will be decreased by <color=#CA2E0AFF>1,300</color> Diamonds.)</size>",
    ["BattlePass_37"]="You have successfully purchased an <color=#e7bb22>Glory Trial Card</color>!",
    ["BattlePass_38"]="Glory Pass",
    ["BattlePass_39"]="Glory Trial Card",
    ["BattlePass_4"]="EXP: %s/%s",
    ["BattlePass_40"]="Are you sure you want to purchase an Glory Pass?\n<size=18>(There are still %s days left until your Kingdom Pass refreshes. Purchase anyway?)</size>",
    ["BattlePass_41"]="Are you sure you want to purchase an Glory Super Pack?\n<size=18>(There are still %s days left until your Kingdom Pass refreshes. Purchase anyway?)</size>",
    ["BattlePass_42"]="Are you sure you want to buy an Glory Trial Card?\nPurchasing this card will unlock your Glory Pass Lv.<color=#CA2E0AFF>1-25</color>.\n<size=18>(In addition, the price of Passes and Super Packs will be decreased by <color=#CA2E0AFF>1,488</color> Diamonds.)</size>\n<size=18>(There are still %s days left until your Kingdom Pass refreshes. Purchase anyway?)</size>",
    ["BattlePass_5"]="Current Week's EXP: %s/%s",
