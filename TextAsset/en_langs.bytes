    ["ResonateDesc_19"]="Awakening Tier IX Criteria: Upgrade 8 pieces of equipment to:\nWeapon <color=#ffc821>+220</color>\nArmor <color=#ffc821>+110</color>\nAccessory <color=#ffc821>+55</color>",
    ["ResonateDesc_2"]="When the sandstorm obstructs the vision of all living creatures,\nthe gray mist drenches the traveler's robe,\nthe resonance of the wind carries the gorgeous power of magic throughout the entire land.\nOh, successor of Odin's Bloodline, enchanting your equipment will invoke the power of the resonance of wind for you. Go forth and fulfill your duty.",
    ["ResonateDesc_20"]="Awakening Tier X Criteria: Upgrade 8 pieces of equipment to:\nWeapon <color=#ffc821>+240</color>\nArmor <color=#ffc821>+120</color>\nAccessory <color=#ffc821>+60</color>",
    ["ResonateDesc_21"]="Awakening Criteria:\nIncrease the Enchantment Level of 2 equipment to +18.",
    ["ResonateDesc_22"]="Awakening Criteria:\nIncrease the Enchantment Level of 4 equipment to +21.",
    ["ResonateDesc_23"]="Awakening Criteria:\nIncrease the Enchantment Level of 6 equipment to +24.",
