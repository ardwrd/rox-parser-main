    ["DialogueOption70163012"]="It'll be fine...",
    ["DialogueOption70163021"]="(Chuckles awkwardly.)",
    ["DialogueOption70163031"]="I'm counting on you!",
    ["DialogueOption70164011"]="Couldn't have done it without you.",
    ["DialogueOption70165011"]="I'm getting rich!",
