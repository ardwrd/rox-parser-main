    ["SeasonPassClosed"]="Currently Not Available",
    ["SeasonPassHint"]="All Kingdom Passes within the season will be <color=#eee09f>automatically activated</color> at the same time when activating the Season Pass. Kingdom Passes that cannot be activated (expired or activated already) will be converted into corresponding Pass Levels (8 levels/each) and added to the <color=#eee09f>current activated</color> Kingdom Pass.",
    ["SeasonPointMailDesc_1"]="Cross-Server GVG Top 4: %s",
    ["SeasonPointMailDesc_2"]="Cross-Server Infinite Showdown Top 120: %s",
