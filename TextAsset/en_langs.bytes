    ["ui_AnniversaryCeremonyKR_006"]="Enter message",
    ["ui_AnniversaryCeremonyKR_007"]="Random Message",
    ["ui_AnniversaryCeremonyKR_008"]="Send",
    ["ui_AnniversaryCeremonyKR_009"]="During the event, go to the designated area in Prontera between <color=#ffd800>%s to %s on the hour</color> to receive chests.",
    ["ui_AnniversaryCeremonyKR_010"]="1. Receive a Revelry Chest every ten seconds.",
    ["ui_AnniversaryCeremonyKR_011"]="2. Entering the designated area will automatically activate the dance action.",
    ["ui_AnniversaryCeremonyKR_012"]="3. Revelry Chest Grand Prize Claim Progress: %s/%s",
    ["ui_AnniversaryCeremonyKR_013"]="Today's Limit",
    ["ui_AnniversaryCeremonyKR_014"]="Converge Star Wish Coins to share a total of <size=26><color=#FEEF3C>400 Million</color></size> Crystals!",
    ["ui_AnniversaryCeremonyKR_015"]="Converge more Star Wish Coins to seize even more Crystals!",
