    ["ui_CrossRegionKVM_rule_006"]="Preliminary Phase → Preparation Phase → First Round of Contest → Preparation Phase → Second Round of Contest → Preparation Phase → Third Round of Contest → Contest Results",
    ["ui_CrossRegionKVM_rule_007"]="Preliminary Phase",
    ["ui_CrossRegionKVM_rule_008"]="Duration: 5 minutes, during which participants can freely enter and exit the contest",
    ["ui_CrossRegionKVM_rule_009"]="Party leaders can use the [Invite Members] feature to prompt party members to enter the contest.",
    ["ui_CrossRegionKVM_rule_010"]="Preparation Phase",
    ["ui_CrossRegionKVM_rule_011"]="Entrance to the Instance closed. Participants will not be able to enter this game.",
    ["ui_CrossRegionKVM_rule_012"]="The party leader decides the 5 party members to compete in the contest.",
    ["ui_CrossRegionKVM_rule_013"]="Winning Condition",
    ["ui_CrossRegionKVM_rule_014"]="The match is a best 2 out of 3 set, and the first party to score 2 points will be the winner.",
    ["ui_CrossRegionKVM_rule_015"]="Contest Restrictions",
    ["ui_CrossRegionKVM_rule_016"]="The use of Potion and Wings is prohibited.",
