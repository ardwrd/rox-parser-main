    ["StarRankTargetName_001"]="Give gifts to friends to receive Charm",
    ["StarRankTargetName_002"]="Increase your Base Level",
    ["StarRankTargetName_003"]="Increase your Job Level",
    ["StarRankTargetName_004"]="Selling items in Crystal Exchange Center",
