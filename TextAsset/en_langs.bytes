    ["CollegeEvent_1001"]="Player <color=#CA2E0AFF>%s</color> became <color=#CA2E0AFF>%s</color>'s student. Welcome to the Academy!",
    ["CollegeEvent_1002"]="Student <color=#CA2E0AFF>%s</color> completed all of the challenges and successfully graduated!",
    ["CollegeEvent_1003"]="Master <color=#CA2E0AFF>%s</color> was promoted to <color=#CA2E0AFF>%s</color>!",
    ["CollegeEvent_1004"]="Student <color=#CA2E0AFF>%s</color> reached <color=#CA2E0AFF>%s</color>!",
    ["CollegeEvent_1005"]="Student <color=#CA2E0AFF>%s</color> was made Star Pupil by their Master. Keep working hard, everyone!",
    ["CollegeEvent_1006"]="Current Influence has decreased by <color=#CA2E0AFF>%s</color> due to <color=#CA2E0AFF>%s</color> prolonged failure to instruct graduating students.",
    ["CollegeEvent_1007"]="Current Influence has increased by <color=#CA2E0AFF>{2}</color> this month as <color=#CA2E0AFF>{0}</color> has instructed <color=#CA2E0AFF>{1}</color> students to graduate this month.",
    ["CollegeEvent_1008"]="Successfully instructed a Student to graduate, and <color=#CA2E0AFF>%s</color>’s Influence has restored.",
