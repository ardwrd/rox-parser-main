    ["WeaponSelectionTips01"]="<color=#ffd9db>High mobility and defense, can pull aggro, crowd control</color>",
    ["WeaponSelectionTips02"]="<color=#ffd9db>High attack speed, short cooldowns, support</color>",
    ["WeaponSelectionTips03"]="<color=#ffd9db>Longer cooldowns, damage combos, DPS</color>",
    ["WeaponSelectionTips04"]="<color=#ffedc9>Has dispels and inflicts debuff effects</color>",
    ["WeaponSelectionTips05"]="<color=#ffedc9>Melee damage, good defense, has regen capabilities</color>",
    ["WeaponSelectionTips06"]="<color=#ffedc9>Casts a variety of buff effects</color>",
    ["WeaponSelectionTips07"]="<color=#e9f5ff>Crowd control and damage combos</color>",
    ["WeaponSelectionTips08"]="<color=#e9f5ff>Slows, sustained output</color>",
    ["WeaponSelectionTips09"]="<color=#e9f5ff>Short channeling time, capable of self-defense</color>",
    ["WeaponSelectionTips10"]="<color=#e5d1ff>Relies on basic attack crits and skill combos to deal burst damage</color>",
    ["WeaponSelectionTips11"]="<color=#e5d1ff>Gets close to the enemy using stealth, then deals instant damage</color>",
    ["WeaponSelectionTips12"]="<color=#e5d1ff>Uses poison to continuously deal damage</color>",
    ["WeaponSelectionTips13"]="<color=#edffe96>Able to set up multiple traps to kite and attack the enemy</color>",
    ["WeaponSelectionTips14"]="<color=#edffe96>Short channeling time, stable DPS</color>",
    ["WeaponSelectionTips15"]="<color=#edffe96>Damage output is instantly increased with additional Demon damage</color>",
    ["WeaponSelectionTips16"]="<color=#e9fffc>Relies on the pushcart to deal damage, high flexibility</color>",
    ["WeaponSelectionTips17"]="<color=#e9fffc>High attack, focused on support skills</color>",
    ["WeaponSelectionTips18"]="<color=#e9fffc>Powerful, can deal high damage within a short time</color>",
    ["WeaponSelectionTips19"]="High ASPD, High Crit, Sustained DPS",
