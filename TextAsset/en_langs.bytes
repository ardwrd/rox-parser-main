    ["DialogueOption10825011"]="(Inquire)",
    ["DialogueOption10825021"]="?!",
    ["DialogueOption10825031"]="Corpse Trade......",
    ["DialogueOption10825032"]="Fire in other places......",
    ["DialogueOption10825041"]="(Nod)",
    ["DialogueOption10825051"]="Thanks",
    ["DialogueOption10828011"]="Strange patterns......?",
    ["DialogueOption10828021"]="Could it be...",
    ["DialogueOption10829011"]="(Telling the truth)",
    ["DialogueOption10829021"]="...?",
    ["DialogueOption10829031"]="......What your plan",
    ["DialogueOption10829041"]="......Black market trade",
    ["DialogueOption10829042"]="......Ymir's Heart",
    ["DialogueOption10829051"]="?",
    ["DialogueOption10829061"]="(Nod) Of course",
    ["DialogueOption10829071"]="It’s alright, I don’t mind",
    ["DialogueOption10829081"]="(Nod)",
    ["DialogueOption10829091"]="In the warehouse of the eastern part of the city",
    ["DialogueOption10830011"]="......The real one?",
    ["DialogueOption10830012"]="And there is false one?",
    ["DialogueOption10830021"]="Huh?",
    ["DialogueOption10830031"]="?!",
    ["DialogueOption10830041"]="What do you mean?",
    ["DialogueOption10831011"]="Why did the prisoner......?",
    ["DialogueOption10831021"]="Do you have any clues?",
    ["DialogueOption10831031"]="A distinguished one?",
    ["DialogueOption10831032"]="A smart one?",
    ["DialogueOption10831061"]="......Soul Snatch?",
    ["DialogueOption10831071"]="Then we must find him",
    ["DialogueOption10831081"]="Goddess' Guide......",
    ["DialogueOption10831091"]="...?",
    ["DialogueOption10831111"]="Right, I'll be on my way",
    ["DialogueOption10834011"]="What's on the ground......?",
    ["DialogueOption10835071"]="This is...",
    ["DialogueOption10835081"]="It’s the Clock Tower!",
    ["DialogueOption10836031"]="?!",
    ["DialogueOption10836041"]="……",
    ["DialogueOption10837011"]="This is clearly a city......",
    ["DialogueOption10837012"]="Why monsters roaming in here?",
    ["DialogueOption10838011"]="I think I understand",
    ["DialogueOption10842011"]="Who is Ranst?",
    ["DialogueOption10842031"]="Is he the arsonist?",
    ["DialogueOption10842041"]="......What do you want to do?",
    ["DialogueOption10842051"]="......Then I will go",
    ["DialogueOption10847011"]="The souls in the suburban cemetery......",
    ["DialogueOption10847021"]="Stolen?",
    ["DialogueOption10848011"]="The mechanical contraption and alchemy circle.....",
    ["DialogueOption10848021"]="(Shake head)",
    ["DialogueOption10848031"]="......No",
    ["DialogueOption10854011"]="Owl toy......",
    ["DialogueOption10854041"]="(Hesitates) But...",
    ["DialogueOption10854051"]="There’s still something fishy about it......",
    ["DialogueOption10859021"]="(Frown)Don’t do this",
    ["DialogueOption10859041"]="(Alert)What about you?",
    ["DialogueOption10859051"]="......Wait for me come back",
    ["DialogueOption10861011"]="(Produce the herb)",
    ["DialogueOption10861021"]="We just stay together......",
    ["DialogueOption10861031"]="You do have the fragment",
    ["DialogueOption10861051"]="But I must find the fragment",
    ["DialogueOption10861052"]="Can’t let you make the same mistake",
    ["DialogueOption10862011"]="...?",
    ["DialogueOption10862021"]="......What should I do",
    ["DialogueOption10862031"]="Fine, I will be back soon",
    ["DialogueOption10863011"]="What is this......",
    ["DialogueOption10863021"]="......You made it",
    ["DialogueOption10863031"]="?!",
    ["DialogueOption10863051"]="...And then?",
    ["DialogueOption10865011"]="Accident?",
    ["DialogueOption10865021"]="(Think) Maybe......?",
    ["DialogueOption10865031"]="If......",
    ["DialogueOption10865041"]="...?",
    ["DialogueOption10866011"]="Alchemy circle......",
    ["DialogueOption10866021"]="If you don’t want to read the diary",
    ["DialogueOption10866022"]="Then I will do it",
    ["DialogueOption10870011"]="(Hesitate) Yaren......",
    ["DialogueOption10873011"]="(Nod)",
    ["DialogueOption10873021"]="(Try to comfort)",
    ["DialogueOption10875021"]="This is not your fault",
    ["DialogueOption10877011"]="Strange research",
    ["DialogueOption10877031"]="...?",
    ["DialogueOption10877041"]="Tortured......",
    ["DialogueOption10877042"]="Die with false accusation......",
    ["DialogueOption10877101"]="(Block in front of Ranst)",
    ["DialogueOption10878011"]="I will help you!",
    ["DialogueOption10878031"]="What did you say?",
    ["DialogueOption10878041"]="Alright!",
    ["DialogueOption10880011"]="?!",
    ["DialogueOption10880021"]="(Shake head) No way!",
    ["DialogueOption10880022"]="There must be another way",
    ["DialogueOption10880031"]="(Can not argue) I......",
    ["DialogueOption10880041"]="......(reluctantly nodded)",
    ["DialogueOption10881011"]="Even the Ymir's Heart",
    ["DialogueOption10881012"]="can’t save everyone",
    ["DialogueOption10881021"]="But if I......",
    ["DialogueOption10881041"]="......(Nod)",
    ["DialogueOption10901011"]="Is there...",
    ["DialogueOption10901041"]="T-That's too loud!",
    ["DialogueOption10901042"]="Oh don't be silly!",
    ["DialogueOption10901071"]="Why?",
    ["DialogueOption10901091"]="(Thinking) So...",
    ["DialogueOption10901101"]="Then...",
    ["DialogueOption10901121"]="Thank you!",
    ["DialogueOption10902011"]="Do you mean...",
    ["DialogueOption10902041"]="(Greeting)",
    ["DialogueOption10902051"]="About what you were discussing.",
    ["DialogueOption10902052"]="I believe it may be—",
    ["DialogueOption10903011"]="It’s alright.",
    ["DialogueOption10903012"]="I wanted to help!",
    ["DialogueOption10903021"]="Huh...?",
    ["DialogueOption10903031"]="Understood.",
    ["DialogueOption10904011"]="Have you ever seen a dragon?",
    ["DialogueOption10905011"]="The physical features match.",
    ["DialogueOption10905012"]="But there’s no decisive evidence.",
    ["DialogueOption10907031"]="What is it?",
    ["DialogueOption10909011"]="But why would the dragons...",
    ["DialogueOption10909012"]="Attack humans all of a sudden?",
    ["DialogueOption10909031"]="Alright.",
    ["DialogueOption10910011"]="(Nods)",
    ["DialogueOption10911031"]="What were the details of the pact...?",
    ["DialogueOption10914031"]="Understood.",
    ["DialogueOption10915011"]="(Explains the details)",
    ["DialogueOption10915021"]="Ores...?",
    ["DialogueOption10916011"]="Then you...",
    ["DialogueOption10916021"]="(Nods)",
    ["DialogueOption10916031"]="...",
    ["DialogueOption10917021"]="(Explains the details)",
    ["DialogueOption10917031"]="What do you propose...?",
    ["DialogueOption10917041"]="I’ll be right back.",
    ["DialogueOption10918011"]="Your home...?",
    ["DialogueOption10919011"]="Hello.",
    ["DialogueOption10919021"]="The leader says...",
    ["DialogueOption10919031"]="What do you need?",
    ["DialogueOption10919051"]="But...",
    ["DialogueOption10919061"]="I’ll go... I’ll go...",
    ["DialogueOption10920011"]="Now, can you please...",
    ["DialogueOption10921011"]="(Nods)",
    ["DialogueOption10921021"]="The dragons don’t...",
    ["DialogueOption10921022"]="Take humans as food.",
    ["DialogueOption10921041"]="You should...",
    ["DialogueOption10921071"]="Vendra, look up.",
    ["DialogueOption10921072"]="What will you have me do?",
    ["DialogueOption10921091"]="I’ll do as you say.",
    ["DialogueOption10922021"]="No problem.",
    ["DialogueOption10923011"]="Who is it?",
    ["DialogueOption10923021"]="Understood.",
    ["DialogueOption10924011"]="You know of me?",
    ["DialogueOption10924021"]="We just saved you...",
    ["DialogueOption10924031"]="You...!",
    ["DialogueOption10925021"]="(Hesitates)",
    ["DialogueOption10925022"]="(Looks over to Vendra)",
    ["DialogueOption10926021"]="(Cuts open the Poison Gland)",
    ["DialogueOption10926022"]="(Smashes the shell)",
    ["DialogueOption10926041"]="(Checks the color)",
    ["DialogueOption10926042"]="(Coats it with venom)",
    ["DialogueOption10926051"]="(Places it into the Dragon Flame)",
    ["DialogueOption10926061"]="Is it... Wind?",
    ["DialogueOption10926071"]="(Hesitant) We...",
    ["DialogueOption10927011"]="You always knew...",
    ["DialogueOption10927012"]="My identity?",
    ["DialogueOption10927041"]="(Shakes her hand)",
    ["DialogueOption10927051"]="What is it?",
    ["DialogueOption10927061"]="The marsh is the closest place?",
    ["DialogueOption10927071"]="This calls for an investigation.",
    ["DialogueOption10927081"]="(Nods) Let's go.",
    ["DialogueOption10928011"]="(Inspects the ground)",
    ["DialogueOption10928012"]="(Feels the wind)",
    ["DialogueOption10928041"]="But we don’t have any explosives.",
    ["DialogueOption10928051"]="No problem.",
    ["DialogueOption10930011"]="Looks like we have to <color=#CA2E0AFF>go down ourselves</color>.",
    ["DialogueOption10930021"]="Let’s go right now.",
    ["DialogueOption10930022"]="Go make preparations.",
    ["DialogueOption10931011"]="!?",
    ["DialogueOption10931031"]="Huh...?",
    ["DialogueOption10931041"]="They are dragons...?",
    ["DialogueOption10931051"]="What do they intend to do?",
    ["DialogueOption10932011"]="Frozen? How?",
    ["DialogueOption10932021"]="Without the Dragon Flame...",
    ["DialogueOption10932022"]="There’d be no new dragons?",
    ["DialogueOption10932031"]="Let’s take another look around.",
    ["DialogueOption10933011"]="What happened to these monsters?",
    ["DialogueOption10933031"]="(Looks around)",
    ["DialogueOption10933032"]="(Inspects the ground)",
    ["DialogueOption10934011"]="And the marking on the map.",
    ["DialogueOption10934031"]="Let’s report it right now.",
    ["DialogueOption10934032"]="Give me a moment.",
    ["DialogueOption10935011"]="(Explains in detail)",
    ["DialogueOption10935121"]="Calm down, Vendra!",
    ["DialogueOption10938041"]="I’m here to help.",
    ["DialogueOption10938061"]="Leave it to me!",
    ["DialogueOption10939021"]="(Help her)",
    ["DialogueOption10939022"]="(Ask her to go home)",
    ["DialogueOption10940011"]="I’ll tend to the wounded.",
    ["DialogueOption10941011"]="Then, about Vendra...",
    ["DialogueOption10941021"]="Why not let me go?",
    ["DialogueOption10942021"]="You’re hurt?",
    ["DialogueOption10942022"]="Let me take you back!",
    ["DialogueOption10942041"]="What do you mean?",
    ["DialogueOption10942051"]="I see...",
    ["DialogueOption10943061"]="I’ll read it.",
    ["DialogueOption10944021"]="(Gives her the letter)",
    ["DialogueOption10944051"]="Let’s go put the dragons down like the dogs they are!",
    ["DialogueOption10944052"]="Let’s go and protect our home, our Comodo!",
    ["DialogueOption10944061"]="(Nods) Of course.",
    ["DialogueOption10944081"]="Also the Hermit’s Village.",
    ["DialogueOption10945011"]="(Explains intentions)",
    ["DialogueOption10945021"]="Huh...?",
    ["DialogueOption10948011"]="What about you?",
    ["DialogueOption10948031"]="It's my duty to help a friend.",
    ["DialogueOption10949011"]="(Explains intentions)",
    ["DialogueOption10949021"]="(Scolds him)",
    ["DialogueOption10949041"]="What do you want in exchange?",
    ["DialogueOption10950011"]="What about my reward?",
    ["DialogueOption10950021"]="That's a tiny bottle...",
    ["DialogueOption10951011"]="(Explains intentions)",
    ["DialogueOption10951031"]="What do you want?",
    ["DialogueOption10952011"]="(Alerted)",
    ["DialogueOption10952021"]="How should this trap be made?",
    ["DialogueOption10953011"]="(Greeting)",
    ["DialogueOption10953021"]="???",
    ["DialogueOption10953031"]="What do you need...?",
    ["DialogueOption10954011"]="Can this thing really...",
    ["DialogueOption10954012"]="Resist Dragon Flame...?",
    ["DialogueOption10954021"]="Eww...",
    ["DialogueOption10955011"]="This is what I have from them...",
    ["DialogueOption10955041"]="(Nods) Must be.",
    ["DialogueOption10955091"]="(Nods)",
    ["DialogueOption10955121"]="...!",
    ["DialogueOption10957021"]="(Takes out the fire-proof manteau)",
    ["DialogueOption10957022"]="Allow me.",
    ["DialogueOption10957061"]="It's my duty.",
    ["DialogueOption10957071"]="Thank you, My Lady.",
    ["DialogueOption10958011"]="Are you not afraid...?",
    ["DialogueOption10958021"]="Change...?",
    ["DialogueOption10959011"]="Wait. There are dragon eggs.",
    ["DialogueOption10959021"]="What do we do?",
    ["DialogueOption10961011"]="Dragon eggs...",
    ["DialogueOption10961021"]="Okay...",
    ["DialogueOption10963011"]="I couldn't get this far without you.",
    ["DialogueOption10964011"]="You’re hurt?",
    ["DialogueOption10964051"]="Let me go in your stead...",
    ["DialogueOption10964061"]="I'm the best person for the job.",
    ["DialogueOption10964062"]="It's my duty.",
    ["DialogueOption10964101"]="I shall.",
    ["DialogueOption10965011"]="I am fine.",
    ["DialogueOption10965012"]="Where are the others?",
    ["DialogueOption10965041"]="(Show her the fragment)",
    ["DialogueOption10965061"]="(Ask about the dragons)",
    ["DialogueOption10965062"]="(Put the fragment away)",
    ["DialogueOption10966011"]="I saw...",
    ["DialogueOption10966012"]="Their desires...",
    ["DialogueOption10966021"]="My dreams...",
    ["DialogueOption10966022"]="Have never changed.",
    ["DialogueOption10966041"]="I see...",
    ["DialogueOption11001011"]="Are you talking about me?",
    ["DialogueOption11001031"]="You look like...",
    ["DialogueOption11001032"]="You want my help on something?",
    ["DialogueOption11001041"]="What is it?",
    ["DialogueOption11001061"]="(Nod)",
    ["DialogueOption11001062"]="(Look around)",
    ["DialogueOption11001101"]="(Nod) I'll do my best.",
    ["DialogueOption11002031"]="What are Crunchy Cocoons?",
    ["DialogueOption11002041"]="?!?!",
    ["DialogueOption11002051"]="(Straining not to upchuck)",
    ["DialogueOption11002061"]="Eww!",
    ["DialogueOption11002071"]="...",
    ["DialogueOption11002081"]="Well, W just told me...",
    ["DialogueOption11002101"]="(Identify self)",
    ["DialogueOption11002131"]="(Nod) That's my guess...",
    ["DialogueOption11002141"]="Why?",
    ["DialogueOption11002151"]="Let me give it a try.",
    ["DialogueOption11002181"]="I shall.",
    ["DialogueOption11003011"]="(Check for injury)",
    ["DialogueOption11003021"]="But you're injured...",
    ["DialogueOption11003031"]="I'll do that right now.",
    ["DialogueOption11004011"]="What can I do?",
    ["DialogueOption11004021"]="Your wings?!",
    ["DialogueOption11004022"]="I can offer money on your behalf.",
    ["DialogueOption11004041"]="(Ponder) Savior...",
    ["DialogueOption11004051"]="I see...",
    ["DialogueOption11005011"]="It's not for sale.",
    ["DialogueOption11005021"]="I want to trade for the Revival Potion.",
    ["DialogueOption11005031"]="Odd mask...?",
    ["DialogueOption11005051"]="That much?!",
    ["DialogueOption11005071"]="Got it.",
    ["DialogueOption11006011"]="(Look at Juicy Grapes)",
    ["DialogueOption11006021"]="Ta-Ta... You mean Tatanka?",
    ["DialogueOption11006031"]="I know Ta-Ta!",
    ["DialogueOption11006032"]="He wears a big mask!",
    ["DialogueOption11006041"]="(Shake head) Actually...",
    ["DialogueOption11006061"]="Thank you.",
    ["DialogueOption11007011"]="I saw...",
    ["DialogueOption11007021"]="(Threat) What do you think?",
    ["DialogueOption11007031"]="He'll be here soon!",
    ["DialogueOption11007032"]="Your days are numbered!",
    ["DialogueOption11007041"]="(Hold out a hand) Give me.",
    ["DialogueOption11008011"]="Do you know...",
    ["DialogueOption11009011"]="Why don't you just recover the Sacred Relic, then?",
    ["DialogueOption11009021"]="I just want to...",
    ["DialogueOption11009031"]="But the creatures in the forest...",
    ["DialogueOption11009032"]="They're innocent.",
    ["DialogueOption11009041"]="But you obviously are trying to...",
    ["DialogueOption11009061"]="(Keep trying to convince)",
    ["DialogueOption11009062"]="(Try to change the subject)",
    ["DialogueOption11009091"]="(Nod) Sure.",
    ["DialogueOption11010011"]="Water Heart?",
    ["DialogueOption11011031"]="What's going on?",
    ["DialogueOption11012011"]="?!",
    ["DialogueOption11012031"]="I'll help.",
    ["DialogueOption11012051"]="(Interrupt) I can identify.",
    ["DialogueOption11013021"]="(Plead) Can you...",
    ["DialogueOption11014051"]="What is it doing?",
    ["DialogueOption11014061"]="!!!",
    ["DialogueOption11015071"]="What are you trying to find out?",
    ["DialogueOption11015081"]="Huh? But I heard...",
    ["DialogueOption11015091"]="But she said Mirror Lake Water...",
    ["DialogueOption11015092"]="I can try it!",
    ["DialogueOption11016011"]="You know who I am?",
    ["DialogueOption11016031"]="Was that you...?",
    ["DialogueOption11016041"]="But why?",
    ["DialogueOption11016051"]="What do you mean?",
    ["DialogueOption11017011"]="What do you mean?",
    ["DialogueOption11017021"]="Actually, I...",
    ["DialogueOption11017031"]="(Tell the truth)",
    ["DialogueOption11017041"]="(Nod) She said...",
    ["DialogueOption11017051"]="What now?",
    ["DialogueOption11017071"]="What are you going to do?",
    ["DialogueOption11018021"]="She only did it for...",
    ["DialogueOption11018031"]="The prophecy of Mirror Lake?",
    ["DialogueOption11018051"]="...?",
    ["DialogueOption11021021"]="It would seem that way...",
    ["DialogueOption11021022"]="It's from an expensive outfit...",
    ["DialogueOption11021031"]="(Frown) But...",
    ["DialogueOption11021041"]="(Lost in thought)",
    ["DialogueOption11024021"]="That's the culprit's motive?",
    ["DialogueOption11025011"]="So you finally want to...",
    ["DialogueOption11025012"]="Find the Sacred Relic?",
    ["DialogueOption11025021"]="Compared to this...",
    ["DialogueOption11027021"]="What is this?!",
    ["DialogueOption11029021"]="We must do something.",
    ["DialogueOption11030011"]="What's wrong?",
    ["DialogueOption11033011"]="It what?",
    ["DialogueOption11033031"]="What should we do now?",
    ["DialogueOption11033041"]="I'll go check.",
    ["DialogueOption11034011"]="Oh no!",
    ["DialogueOption11035021"]="I got this.",
    ["DialogueOption11037021"]="You mean the culprit...",
    ["DialogueOption11037022"]="The culprit is also from the Realm of the Dead?",
    ["DialogueOption11038011"]="What is this...?",
    ["DialogueOption11038031"]="So your plan is...?",
    ["DialogueOption11038041"]="Of course not!",
    ["DialogueOption11038042"]="But how are we going to...?",
    ["DialogueOption11039011"]="(Recount in detail)",
    ["DialogueOption11039051"]="No problem.",
    ["DialogueOption11040011"]="What's this...?",
    ["DialogueOption11043011"]="We...",
    ["DialogueOption11043041"]="Grand Celeb... Ow!",
    ["DialogueOption11044041"]="Uh, I...",
    ["DialogueOption11044051"]="I, uh, overslept...?",
    ["DialogueOption11044071"]="QAQ...",
    ["DialogueOption11044091"]="o(╥﹏╥)o...",
    ["DialogueOption11045011"]="You were just trying to set me up, weren't you?",
    ["DialogueOption11045021"]="I think it's doable, but...",
    ["DialogueOption11045022"]="You owe me one for taunting me.",
    ["DialogueOption11047041"]="Where is the Archdemon?",
    ["DialogueOption11047042"]="(Get the Archdemon to explain.)",
    ["DialogueOption11047061"]="Woof?",
    ["DialogueOption11048021"]="Is that...",
    ["DialogueOption11048022"]="Someone crying?",
    ["DialogueOption11048041"]="It's getting louder...",
    ["DialogueOption11049011"]="What happened?",
    ["DialogueOption11049041"]="!!!",
    ["DialogueOption11050011"]="(Shake head) I'm just...",
    ["DialogueOption11050031"]="He mentioned a temple...",
    ["DialogueOption11051011"]="(Reluctant) But...",
    ["DialogueOption11051031"]="Okay.",
    ["DialogueOption11052011"]="(Stop going any farther)",
    ["DialogueOption11052012"]="(State suspicion)",
    ["DialogueOption11053031"]="(Glare at her)",
    ["DialogueOption11053032"]="(Try to free yourself)",
    ["DialogueOption11053121"]="Why you...!",
    ["DialogueOption11054051"]="Why you...!",
    ["DialogueOption11054071"]="Tatanka?!",
    ["DialogueOption11055021"]="(Question Hel)",
    ["DialogueOption11055022"]="(Question Tatanka)",
    ["DialogueOption11055051"]="You set it up from the start...?",
    ["DialogueOption11055081"]="Uh, I...",
    ["DialogueOption11058041"]="...?",
    ["DialogueOption11059011"]="Chirp?!",
    ["DialogueOption11059021"]="You had to, uh...",
    ["DialogueOption11059022"]="Find any living, breathing body?",
    ["DialogueOption11059041"]="Fine, I'll stop teasing.",
    ["DialogueOption11059042"]="Let's get serious, chirp?",
    ["DialogueOption11059051"]="You mean like Uba?",
    ["DialogueOption11059061"]="Uh, did your...",
    ["DialogueOption11059062"]="Personality change as well?",
    ["DialogueOption11060011"]="Actually, you...",
    ["DialogueOption11061011"]="Bishop, we...",
    ["DialogueOption11061021"]="Huh? Didn't I...?",
    ["DialogueOption11062011"]="Why is that?",
    ["DialogueOption11062021"]="What can we do?",
    ["DialogueOption11066011"]="Is that \"Ancient God\"...",
    ["DialogueOption11066012"]="Beelzebub?",
    ["DialogueOption11066031"]="You mean... use that orb?",
    ["DialogueOption11067011"]="Is she talking to me?",
    ["DialogueOption11067031"]="Yes, chirp!",
    ["DialogueOption11067041"]="I know, chirp!",
    ["DialogueOption11071011"]="Why didn't you...",
    ["DialogueOption11071021"]="So you mean...",
    ["DialogueOption11071031"]="What about now?",
    ["DialogueOption11075011"]="Uh, why did you...",
    ["DialogueOption11075012"]="Cover your own face?",
    ["DialogueOption11075021"]="So you want to...?",
    ["DialogueOption11075031"]="Let's give it a shot!",
    ["DialogueOption11078011"]="You know, you haven't been chirping for a while.",
    ["DialogueOption11079031"]="I got a question.",
    ["DialogueOption11083011"]="(Hesitate) You...",
    ["DialogueOption11083021"]="(While he's distracted...)",
    ["DialogueOption11083022"]="(Touch Israel)",
    ["DialogueOption11086031"]="Tell them about Hel's plot.",
    ["DialogueOption11086032"]="Trade identity with Tatanka.",
    ["DialogueOption11087011"]="(Stern) You are indeed...",
    ["DialogueOption11088021"]="Leave it to me!",
    ["DialogueOption11089011"]="This is what you should be doing.",
    ["DialogueOption11089021"]="But...",
    ["DialogueOption11089031"]="(Sigh) Okay.",
    ["DialogueOption11090011"]="Stop running.",
    ["DialogueOption11090021"]="You noticed the change in attitude.",
    ["DialogueOption11090022"]="You figured out the truth behind the ritual.",
    ["DialogueOption11090061"]="Actually...",
    ["DialogueOption11090071"]="(Recount in detail)",
    ["DialogueOption11091061"]="Until I showed up?",
    ["DialogueOption11091071"]="But you were just...",
    ["DialogueOption11092031"]="No...",
    ["DialogueOption11092032"]="It was because I trust you.",
    ["DialogueOption11092041"]="(What the Dragon Tail said)",
    ["DialogueOption11092042"]="(What the Choco said)",
    ["DialogueOption11093081"]="(Nod) Here it is.",
    ["DialogueOption11093091"]="Huh?",
    ["DialogueOption11093101"]="?!",
    ["DialogueOption11094011"]="So that means...",
    ["DialogueOption11094031"]="(Frown) Could it be...",
    ["DialogueOption11094032"]="The prophecy of Mirror Lake?",
    ["DialogueOption11201011"]="Are you F?",
    ["DialogueOption11201021"]="The Lord?!",
    ["DialogueOption11201031"]="What happened?",
    ["DialogueOption11202021"]="I know where she is.",
    ["DialogueOption11204011"]="(Nod)",
    ["DialogueOption11204031"]="??!!",
    ["DialogueOption11205011"]="Is this place... floating in the sky?",
    ["DialogueOption11205031"]="(Curious) This is...?",
    ["DialogueOption11205061"]="(Nod)",
    ["DialogueOption11206011"]="About androids?",
    ["DialogueOption11206041"]="Once they lose control...",
    ["DialogueOption11207011"]="Was it like this before?",
    ["DialogueOption11207021"]="But you said it just now...",
    ["DialogueOption11207031"]="Khayr Consortium?",
    ["DialogueOption11207051"]="Those citizens...",
    ["DialogueOption11207061"]="Sure.",
    ["DialogueOption11208011"]="Are you feeling better?",
    ["DialogueOption11208021"]="... Angelica?",
    ["DialogueOption11208031"]="Did she ever lose control before?",
    ["DialogueOption11208041"]="Should we...",
    ["DialogueOption11208061"]="But...",
    ["DialogueOption11208071"]="...Just take care of yourself.",
    ["DialogueOption11209011"]="...?",
    ["DialogueOption11209021"]="You are making me blush...",
    ["DialogueOption11209031"]="When the riot took place...",
    ["DialogueOption11209041"]="(Thinking) A switch...?",
    ["DialogueOption11209051"]="(Nod) Thank you.",
    ["DialogueOption11210011"]="Are you alright?",
    ["DialogueOption11210021"]="What happened?",
    ["DialogueOption11211011"]="(Tell the truth)",
    ["DialogueOption11211051"]="Allow me!",
    ["DialogueOption11212021"]="(Walk over and pick up the wounded member)",
    ["DialogueOption11213011"]="I was just doing what I could.",
    ["DialogueOption11213071"]="I will go!",
    ["DialogueOption11214011"]="(Walk over)",
    ["DialogueOption11214021"]="I am not a civilian!",
    ["DialogueOption11215011"]="I'm just doing my best.",
    ["DialogueOption11215031"]="Could it be...?!",
    ["DialogueOption11215051"]="No problem.",
    ["DialogueOption11216011"]="I'm just doing my best.",
    ["DialogueOption11216031"]="Could it be...?!",
    ["DialogueOption11216051"]="No problem.",
    ["DialogueOption11217041"]="Me???",
    ["DialogueOption11217051"]="Yes...",
    ["DialogueOption11218011"]="What is Mech Agreement?",
    ["DialogueOption11219031"]="What do you mean?",
    ["DialogueOption11219041"]="What is a Mech Core...?",
    ["DialogueOption11219051"]="The model tag just now?",
    ["DialogueOption11219061"]="Where is the blueprint...?",
    ["DialogueOption11220011"]="I am...",
    ["DialogueOption11220031"]="...Why is that?",
    ["DialogueOption11221011"]="(Shake head) It's alright.",
    ["DialogueOption11221021"]="I am...",
    ["DialogueOption11221031"]="Could you tell me...",
    ["DialogueOption11221041"]="...Why?",
    ["DialogueOption11221051"]="Are you saying...?",
    ["DialogueOption11221061"]="I want...",
    ["DialogueOption11222011"]="(Shake head)",
    ["DialogueOption11222021"]="I want...",
    ["DialogueOption11223011"]="(Introduce yourself)",
    ["DialogueOption11223021"]="What were you looking at just now?",
    ["DialogueOption11223031"]="...Weird how?",
    ["DialogueOption11223061"]="Sure.",
    ["DialogueOption11224011"]="I'm not...",
    ["DialogueOption11224021"]="You...",
    ["DialogueOption11224031"]="The monsters in the estate...",
    ["DialogueOption11224051"]="Monster density?",
    ["DialogueOption11224061"]="(Nod)",
    ["DialogueOption11225011"]="This well... What is this?",
    ["DialogueOption11225021"]="(Stand up)",
    ["DialogueOption11225022"]="(Walk toward the dry well)",
    ["DialogueOption11226011"]="(Shake head)",
    ["DialogueOption11226021"]="This riot is...",
    ["DialogueOption11226031"]="(Nod)",
    ["DialogueOption11227011"]="Philodis? This is...",
    ["DialogueOption11227021"]="So, you were testing me?",
    ["DialogueOption11227031"]="...Next phase?",
    ["DialogueOption11228011"]="So this letter could be...",
    ["DialogueOption11228021"]="The Lord...",
    ["DialogueOption11228031"]="What do you mean?",
    ["DialogueOption11228051"]="...You mean, me?",
    ["DialogueOption11228061"]="No, I robbed it from somebody...",
    ["DialogueOption11228071"]="(Suddenly enlightened) So you...",
    ["DialogueOption11228091"]="You were just...",
    ["DialogueOption11228092"]="Testing me.",
    ["DialogueOption11228101"]="Fine, but I have one request.",
    ["DialogueOption11228111"]="(Nod)",
    ["DialogueOption11228121"]="Then now what...?",
    ["DialogueOption11228141"]="Understood.",
    ["DialogueOption11229031"]="(Nod) Got it.",
    ["DialogueOption11230011"]="(Shake head) Actually...",
    ["DialogueOption11230021"]="(Surprised) Not you...",
    ["DialogueOption11232011"]="(Surprised) But...!",
    ["DialogueOption11232021"]="(Nod)",
    ["DialogueOption11232031"]="...Why?",
    ["DialogueOption11232041"]="But how did you...",
    ["DialogueOption11232051"]="You and Rekenber...",
    ["DialogueOption11232081"]="What should I do?",
    ["DialogueOption11232101"]="Understood.",
    ["DialogueOption11233011"]="Nothing...",
    ["DialogueOption11233012"]="It was abandoned...",
    ["DialogueOption11233021"]="Maybe, and we should...",
    ["DialogueOption11233031"]="Then I will...",
    ["DialogueOption11234011"]="I purposely...",
    ["DialogueOption11234021"]="Actually...",
    ["DialogueOption11236011"]="A data driver board...?",
    ["DialogueOption11236041"]="(Suddenly enlightened) So you...",
    ["DialogueOption11236101"]="Let's go then!",
    ["DialogueOption11237031"]="Let me help.",
    ["DialogueOption11239021"]="...You know who I am?",
    ["DialogueOption11239051"]="It's because...",
    ["DialogueOption11239071"]="Can I go?",
    ["DialogueOption11240011"]="This is...?",
    ["DialogueOption11241011"]="Those are...?",
    ["DialogueOption11241031"]="Sure.",
    ["DialogueOption11242011"]="We encountered...",
    ["DialogueOption11244011"]="(Nod)",
    ["DialogueOption11244012"]="Thanks to Rakylafitz.",
    ["DialogueOption11246091"]="Philodis?!",
    ["DialogueOption11248041"]="...What's your point here?",
    ["DialogueOption11248131"]="Testing and analysis?",
    ["DialogueOption11249011"]="What are you doing?",
    ["DialogueOption11251021"]="(Surprised) Fulkyn!",
    ["DialogueOption11251061"]="This is...?!",
    ["DialogueOption11251071"]="(Contemplating) Could it be...?",
    ["DialogueOption11251081"]="(Take out the photos)",
    ["DialogueOption11252021"]="What do they want?",
    ["DialogueOption11252081"]="...?",
    ["DialogueOption11252091"]="But the consortium...?",
    ["DialogueOption11252121"]="... Me?",
    ["DialogueOption11252141"]="What materials?",
    ["DialogueOption11254021"]="What is this...?",
    ["DialogueOption11254041"]="Could it be...?",
    ["DialogueOption11255011"]="(Shake head) I saw...",
    ["DialogueOption11255021"]="There was a dry well on the estate...",
    ["DialogueOption11255031"]="(Nod)",
    ["DialogueOption11255041"]="...Including you?",
    ["DialogueOption11255061"]="So...",
    ["DialogueOption11255062"]="Have you changed?",
    ["DialogueOption11255071"]="What did you say?",
    ["DialogueOption11301021"]="(Greet the Lord)",
    ["DialogueOption11302021"]="For the construction...?",
    ["DialogueOption11302041"]="What about the second document...?",
    ["DialogueOption11302051"]="But the Lord said...",
    ["DialogueOption11302071"]="You're saying...",
    ["DialogueOption11302072"]="They're manufacturing weapons under the table?",
    ["DialogueOption11302081"]="But we lack evidence.",
    ["DialogueOption11303011"]="This is...?",
    ["DialogueOption11303031"]="You're not coming with me?",
    ["DialogueOption11303061"]="Got it.",
    ["DialogueOption11303062"]="I'm off then!",
    ["DialogueOption11304011"]="(Softly) Cough...",
    ["DialogueOption11304021"]="(Holding back) Cough... Cough...",
    ["DialogueOption11304031"]="Cough, cough, cough... Cough, cough!",
    ["DialogueOption11304071"]="O-Okay... Cough!",
    ["DialogueOption11305021"]="(Change the subject)",
    ["DialogueOption11305031"]="Stop talking!",
    ["DialogueOption11305051"]="(Ask W)",
    ["DialogueOption11306011"]="(Greet)",
    ["DialogueOption11306021"]="I am...",
    ["DialogueOption11307011"]="(Touch cufflink) Cough, cough!",
    ["DialogueOption11307021"]="T-TL330...",
    ["DialogueOption11307031"]="(Nervous) 019...",
    ["DialogueOption11307041"]="S... E?",
    ["DialogueOption11307051"]="Err... SQ?",
    ["DialogueOption11307061"]="... SK!",
    ["DialogueOption11308021"]="SG! It's SG!",
    ["DialogueOption11308022"]="I got it mixed up!",
    ["DialogueOption11309011"]="Excuse me...",
    ["DialogueOption11310021"]="Hello? Hello!",
    ["DialogueOption11310031"]="(Rolling up sleeves) Let's do this!",
    ["DialogueOption11311021"]="I'm okay...",
    ["DialogueOption11311031"]="You cut off again!!!",
    ["DialogueOption11312021"]="The log shows...",
    ["DialogueOption11312031"]="Okay.",
    ["DialogueOption11313021"]="... It's not available.",
    ["DialogueOption11313061"]="Whaaaaat?",
    ["DialogueOption11313071"]="I didn't...",
    ["DialogueOption11313081"]="SHHHHHUT DOWN...?",
    ["DialogueOption11313082"]="Where's the power button?",
    ["DialogueOption11314011"]="I wasn't...",
    ["DialogueOption11314021"]="The comm again...",
    ["DialogueOption11315041"]="What do you mean?",
    ["DialogueOption11315051"]="You have no faith in me?",
    ["DialogueOption11315061"]="Okay.",
    ["DialogueOption11316041"]="Ahh!",
    ["DialogueOption11317011"]="(Holding your head) Buzzing...",
    ["DialogueOption11317021"]="Just stop talking...",
    ["DialogueOption11318011"]="Divine power? What are you...?",
    ["DialogueOption11318031"]="??!!",
    ["DialogueOption11318041"]="So... what's your purpose?",
    ["DialogueOption11318051"]="Did the book teach you...",
    ["DialogueOption11318052"]="Get straight to the point?",
    ["DialogueOption11318061"]="... What do you mean?",
    ["DialogueOption11318071"]="My memory?!",
    ["DialogueOption11318081"]="Are you threatening me?",
    ["DialogueOption11318101"]="You have what I want.",
    ["DialogueOption11318121"]="... What do you want in return?",
    ["DialogueOption11318131"]="(Suprise)... Why?",
    ["DialogueOption11318141"]="Because you're <color=#CA2E0AFF>not one of us</color>.",
    ["DialogueOption11318151"]="What kind of...",
    ["DialogueOption11318152"]="Weird books have you been reading?!",
    ["DialogueOption11318191"]="Fine, I will go.",
    ["DialogueOption11319021"]="(Facepalm) This is bad...",
    ["DialogueOption11319051"]="(Lost in thought)",
    ["DialogueOption11319061"]="I really appreciate it...",
    ["DialogueOption11319071"]="(Realizing) It was you!",
    ["DialogueOption11319081"]="I never said yes...!",
    ["DialogueOption11320021"]="Stop!",
    ["DialogueOption11320041"]="(Believe the big guy)",
    ["DialogueOption11320042"]="(Believe the little girl)",
    ["DialogueOption11320071"]="(Comfort the little girl)",
    ["DialogueOption11320081"]="(Look at the big guy)",
    ["DialogueOption11320091"]="Okay.",
    ["DialogueOption11321081"]="(Realizing) I have the antidote!",
    ["DialogueOption11322011"]="(Hesitating) I...",
    ["DialogueOption11322021"]="(Tell the truth)",
    ["DialogueOption11322031"]="So, you all...?",
    ["DialogueOption11322041"]="(Nod) So, are you all...",
    ["DialogueOption11322042"]="Willing to believe in it?",
    ["DialogueOption11322061"]="?!",
    ["DialogueOption11323011"]="This is...?",
    ["DialogueOption11323021"]="What's the password...?",
    ["DialogueOption11323031"]="I knew it!!!",
    ["DialogueOption11323041"]="(Facepalm) Open Sesame!",
    ["DialogueOption11324011"]="What's wrong?",
    ["DialogueOption11324081"]="What's your plan?",
    ["DialogueOption11324121"]="... What is this?",
    ["DialogueOption11325011"]="Methane and heat...",
    ["DialogueOption11325051"]="... Like what?",
    ["DialogueOption11325061"]="You mean... androids?",
    ["DialogueOption11325091"]="Let me help.",
    ["DialogueOption11326021"]="Okay.",
    ["DialogueOption11328011"]="(Nod)",
    ["DialogueOption11328041"]="Understood.",
    ["DialogueOption11330011"]="I...",
    ["DialogueOption11330021"]="Don't you want to help?",
    ["DialogueOption11330031"]="How much?",
    ["DialogueOption11330041"]="Hard drive...?",
    ["DialogueOption11330071"]="... Okay.",
    ["DialogueOption11331011"]="Why...?",
    ["DialogueOption11331041"]="Is it because...?",
    ["DialogueOption11331051"]="But do machines really...",
    ["DialogueOption11331052"]="Possess their own personalities?",
    ["DialogueOption11331061"]="You...?",
    ["DialogueOption11332011"]="Why did he...",
    ["DialogueOption11332012"]="Look so much in pain?",
    ["DialogueOption11332021"]="You could...",
    ["DialogueOption11332041"]="Understood.",
    ["DialogueOption11333031"]="Okay.",
    ["DialogueOption11334011"]="Milian and Faris...",
    ["DialogueOption11334031"]="There's an ancient saying...",
    ["DialogueOption11334041"]="... I'm not sure yet.",
    ["DialogueOption11334042"]="So I want to...",
    ["DialogueOption11334061"]="Then...?",
    ["DialogueOption11335011"]="They call you \"Hand of God\"...",
    ["DialogueOption11335012"]="What does that mean?",
    ["DialogueOption11335031"]="Which explanation do you like?",
    ["DialogueOption11335041"]="(Nod)",
    ["DialogueOption11335042"]="What happened next?",
    ["DialogueOption11336011"]="... Until she encountered danger?",
    ["DialogueOption11336031"]="... What is it?",
    ["DialogueOption11338031"]="... I take back what I said.",
    ["DialogueOption11338032"]="You're one of us.",
    ["DialogueOption11338051"]="What about tomorrow night...?",
    ["DialogueOption11339011"]="Kind of...",
    ["DialogueOption11339012"]="But I still want to hear more today.",
    ["DialogueOption11340011"]="What are you doing here?",
    ["DialogueOption11340031"]="It's because...",
    ["DialogueOption11340041"]="... What's wrong with you?",
    ["DialogueOption11340051"]="Have you known each other for a long time?",
    ["DialogueOption11340061"]="(Consoling him)",
    ["DialogueOption11340071"]="140 said...",
    ["DialogueOption11340091"]="Then we should—",
    ["DialogueOption11340111"]="That works.",
    ["DialogueOption11341031"]="Don't worry. Leave it to me.",
    ["DialogueOption11343021"]="(Thinking) Are you saying...?",
    ["DialogueOption11343031"]="I can disguise myself...?",
    ["DialogueOption11344011"]="(Greet to an old friend)",
    ["DialogueOption11344031"]="I am...",
    ["DialogueOption11344051"]="I don't have money, but...",
    ["DialogueOption11344071"]="Let's work together.",
    ["DialogueOption11344091"]="(Whisper) I don't have...",
    ["DialogueOption11344101"]="Down payment first?",
    ["DialogueOption11344111"]="Deal!",
    ["DialogueOption11345011"]="Cough, cough!",
    ["DialogueOption11345021"]="(Nodding furiously)",
    ["DialogueOption11345022"]="Should I... go now?",
    ["DialogueOption11346031"]="These potions...?",
    ["DialogueOption11346041"]="Okay.",
    ["DialogueOption11348011"]="(Shake head) I'm just...",
    ["DialogueOption11348012"]="These supplies...",
    ["DialogueOption11348031"]="(Whisper) Thank you.",
    ["DialogueOption11349011"]="(Nod)",
    ["DialogueOption11349031"]="(Recite accurately)",
    ["DialogueOption11350011"]="That's very generous of you to say, I...",
    ["DialogueOption11353031"]="Try a different job?",
    ["DialogueOption11353041"]="(Consoling him)",
    ["DialogueOption11354011"]="The old miner said...",
    ["DialogueOption11354021"]="Then why would you...",
    ["DialogueOption11354022"]="Help them?",
    ["DialogueOption11354041"]="Of course.",
    ["DialogueOption11356011"]="Yet you learned how to fight back.",
    ["DialogueOption11357021"]="Could it be...?",
    ["DialogueOption11357031"]="Did you decide back then...?",
    ["DialogueOption11358021"]="That's hardly an invite.",
    ["DialogueOption11358031"]="(Reach out right hand)",
    ["DialogueOption11358032"]="Glad you choose me.",
    ["DialogueOption11358041"]="I have one more question.",
    ["DialogueOption11360011"]="I haven't seen him today.",
    ["DialogueOption11360021"]="(Thinking) Nina...?",
    ["DialogueOption11360041"]="So why did you...?",
    ["DialogueOption11360061"]="(Tap on the headset)",
    ["DialogueOption11360081"]="(Attempt to reassure the village chief)",
    ["DialogueOption11360091"]="That's for later.",
    ["DialogueOption11360092"]="I'll <color=#CA2E0AFF>find Dave</color> first.",
    ["DialogueOption11361021"]="What are you talking about?",
    ["DialogueOption11361031"]="Where's your dad now?",
    ["DialogueOption11362011"]="(Walk closer slowly)",
    ["DialogueOption11362021"]="Today is...?",
    ["DialogueOption11362041"]="When this is all over...",
    ["DialogueOption11362061"]="(Nod)",
    ["DialogueOption11362081"]="No problem.",
    ["DialogueOption11363021"]="I'm really here to check the goods this time!",
    ["DialogueOption11363031"]="Ahem... Ahem, ahem!",
    ["DialogueOption11364011"]="There are things of mine inside.",
    ["DialogueOption11364031"]="I've got the password for the supply box.",
    ["DialogueOption11364051"]="(Recite accurately)",
    ["DialogueOption11365011"]="Can you teach me?",
    ["DialogueOption11365021"]="Let me try!",
    ["DialogueOption11367051"]="Okay.",
    ["DialogueOption11368011"]="Why did they attack you?",
    ["DialogueOption11369011"]="Mask... Antidote...?",
    ["DialogueOption11369021"]="Got it!",
    ["DialogueOption11370011"]="(Shake head) You don't need to pay me back.",
    ["DialogueOption11370021"]="(Reassuring) After tomorrow...",
    ["DialogueOption11370041"]="Don't think like that...",
    ["DialogueOption11371041"]="So that means...?!",
    ["DialogueOption11371051"]="Alright!",
    ["DialogueOption11372021"]="Alright!",
    ["DialogueOption11373011"]="That's nothing.",
    ["DialogueOption11373021"]="I'll take care of it.",
    ["DialogueOption11374011"]="You guys...?",
    ["DialogueOption11374031"]="It won't be.",
    ["DialogueOption11378021"]="About tomorrow's plan...",
    ["DialogueOption11378022"]="How confident are you?",
    ["DialogueOption11378041"]="Me...?",
    ["DialogueOption11378071"]="Not a funny joke.",
    ["DialogueOption11378101"]="What about you?",
    ["DialogueOption11378111"]="Of course.",
    ["DialogueOption11378131"]="See you tomorrow.",
    ["DialogueOption11379011"]="... Androids?",
    ["DialogueOption11379021"]="Take a look.",
    ["DialogueOption11384081"]="No... There were.",
    ["DialogueOption11384082"]="You just didn't have the guts to take it.",
    ["DialogueOption11385011"]="(Shaking head) Don't worry about it.",
    ["DialogueOption11385012"]="I'll find another way.",
    ["DialogueOption11385021"]="My memory?",
    ["DialogueOption11386071"]="(Smile) Well then...",
    ["DialogueOption11386072"]="Then I'll see you off here.",
    ["DialogueOption11387011"]="I need to return to Juno right away.",
    ["DialogueOption11387031"]="Come on! Send me back!",
    ["DialogueOption11388011"]="Just now...",
    ["DialogueOption11388012"]="Where are you guys going?",
    ["DialogueOption11388021"]="Looking for... me?",
    ["DialogueOption11388031"]="It's a long story...",
    ["DialogueOption11390011"]="Sorry, I...",
    ["DialogueOption11390021"]="It's a bit complicated...",
    ["DialogueOption11390022"]="When the comms got cut off...",
    ["DialogueOption11390051"]="(Nod) Sure.",
    ["DialogueOption11391011"]="Impossible!",
    ["DialogueOption11391012"]="Ymir's Heart has already...",
    ["DialogueOption11391081"]="It's Arunafeltz!",
    ["DialogueOption11391121"]="It's all my fault...",
    ["DialogueOption11391151"]="??!!",
    ["DialogueOption11391171"]="... Huh?",
    ["DialogueOption11391181"]="Martistine...?",
    ["DialogueOption11392011"]="(Sigh) Stop it...",
    ["DialogueOption11392021"]="I was dealing with something important...",
    ["DialogueOption11392041"]="(Apologize to her)",
    ["DialogueOption11392051"]="This is dangerous...",
    ["DialogueOption11392071"]="Then you have to promise...",
    ["DialogueOption11392072"]="When we're out, you do what I say.",
    ["DialogueOption11392091"]="Come on, let's go home!",
    ["DialogueOption11393021"]="(Shake head)",
    ["DialogueOption11393022"]="I'm just a bit tired.",
    ["DialogueOption11394021"]="It's me.",
    ["DialogueOption11394031"]="Are you ready?",
    ["DialogueOption11401021"]="It didn't work?",
    ["DialogueOption11401031"]="You think it's a trap?",
    ["DialogueOption11403011"]="What about this time?",
    ["DialogueOption11403021"]="But if she's already...",
    ["DialogueOption11501011"]="Should what?",
    ["DialogueOption11501021"]="You up to no good again?",
    ["DialogueOption11501031"]="What is Cloud Soufflé?",
    ["DialogueOption11501051"]="(Gulping)",
    ["DialogueOption11501061"]="(Check the time)",
    ["DialogueOption11501062"]="Hmm, seems like we're still early...",
    ["DialogueOption11501071"]="I'm in!",
    ["DialogueOption11502011"]="(Comfort)",
    ["DialogueOption11502012"]="(Retort)",
    ["DialogueOption11503041"]="Let's do this!",
    ["DialogueOption11504011"]="(Look at Martistine)",
    ["DialogueOption11504041"]="(Reject)",
    ["DialogueOption11504042"]="(Convince Martistine)",
    ["DialogueOption11505011"]="Whoa, no need for that!",
    ["DialogueOption11505021"]="Gilded... Rose?",
    ["DialogueOption11506011"]="(Ruffle her hair)",
    ["DialogueOption11506012"]="I'll take you back tomorrow to line up again.",
    ["DialogueOption11506021"]="I promise. But right now...",
    ["DialogueOption11506031"]="Then you...",
    ["DialogueOption11506041"]="Alright, alright, I got it.",
    ["DialogueOption11507011"]="Huh...?",
    ["DialogueOption11507061"]="But...?",
    ["DialogueOption11507071"]="?!",
    ["DialogueOption11508011"]="What do you mean?",
    ["DialogueOption11508031"]="... An alliance proposal?",
    ["DialogueOption11508051"]="Understood.",
    ["DialogueOption11508052"]="Then I'll...",
    ["DialogueOption11508071"]="Really!?",
    ["DialogueOption11508081"]="Thank you!",
    ["DialogueOption11509011"]="(Nod)",
    ["DialogueOption11509021"]="Of course.",
    ["DialogueOption11509031"]="We'll get one together after we return.",
    ["DialogueOption11509041"]="(Reach out) Pinky swear!",
    ["DialogueOption11510011"]="How did you know?",
    ["DialogueOption11510021"]="(Pull out the letter)",
    ["DialogueOption11510031"]="It's the seal from Lord's Mansion.",
    ["DialogueOption11510041"]="Such as?",
    ["DialogueOption11510051"]="... Why?",
    ["DialogueOption11510061"]="(Nod) Got it.",
    ["DialogueOption11510081"]="Understood. Anything else?",
    ["DialogueOption11510121"]="Got it.",
    ["DialogueOption11511011"]="Actually...",
    ["DialogueOption11511021"]="(Nod)",
    ["DialogueOption11511031"]="Have you been reinstated as a Priest?",
    ["DialogueOption11511041"]="(Consoling him)",
    ["DialogueOption11511081"]="(Look at Martistine)",
    ["DialogueOption11515011"]="(Shakes head) No... I didn't feel anything.",
    ["DialogueOption11515021"]="... What do you mean?",
    ["DialogueOption11515041"]="?!",
    ["DialogueOption11515061"]="(Realizing) So...",
    ["DialogueOption11515081"]="Then you...",
    ["DialogueOption11515091"]="(Hesitant) But I...",
    ["DialogueOption11515101"]="How did you know?",
    ["DialogueOption11515111"]="Do you know him?",
    ["DialogueOption11515121"]="What if...?",
    ["DialogueOption11515131"]="Got it.",
    ["DialogueOption11516011"]="... That place?",
    ["DialogueOption11516051"]="(Nod)",
    ["DialogueOption11518011"]="What do you mean?",
    ["DialogueOption11518031"]="... What do you mean?",
