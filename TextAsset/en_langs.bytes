    ["DialogueOption30022051"]="Thank you.",
    ["DialogueOption30024011"]="How did you know?",
    ["DialogueOption30024021"]="Is there anything I can do?",
    ["DialogueOption30024031"]="Thank you.",
    ["DialogueOption30025011"]="No thanks necessary.",
    ["DialogueOption30026011"]="How can we give it a try?",
    ["DialogueOption30026021"]="Why this order?",
    ["DialogueOption30026041"]="I think I've got it.",
    ["DialogueOption30026042"]="One more time.",
    ["DialogueOption30027011"]="Fire",
    ["DialogueOption30028011"]="Earth",
    ["DialogueOption30029011"]="Wind",
    ["DialogueOption30030011"]="Water",
    ["DialogueOption30031011"]="I've got the strangest feeling...",
    ["DialogueOption30031031"]="That crystal...",
    ["DialogueOption30033011"]="You... You are?",
    ["DialogueOption30033061"]="I-I'll take care of it.",
    ["DialogueOption30036011"]="Actually...",
    ["DialogueOption30036021"]="Sorry...",
    ["DialogueOption30036031"]="Huh? But...",
    ["DialogueOption30037011"]="General Qi Euin?",
    ["DialogueOption30037031"]="Here you go.",
    ["DialogueOption30038011"]="What did he do?",
    ["DialogueOption30038031"]="That day?",
    ["DialogueOption30038061"]="How...",
    ["DialogueOption30038071"]="Yes.",
    ["DialogueOption30038091"]="Isn't that obvious!?",
    ["DialogueOption30038121"]="Get back!",
    ["DialogueOption30040011"]="It was a piece of cake.",
    ["DialogueOption30040021"]="Just as it should be.",
    ["DialogueOption30041011"]="Caslisse?",
    ["DialogueOption30041021"]="Where did he go?",
    ["DialogueOption30042011"]="It's you!?",
    ["DialogueOption30042021"]="Give me back the lute!",
    ["DialogueOption30043011"]="Hahaha! That's not necessary!",
    ["DialogueOption30044011"]="Thieves also believe in justice.",
    ["DialogueOption30044021"]="I'm here to help you.",
    ["DialogueOption30044031"]="Let's make a lute.",
