    ["TreviFount_Ui_07"]="Collector's Wish Item (%s/%s)",
    ["TreviFount_Ui_08"]="You've reached the selection limit for this tier!",
    ["TreviFount_Ui_09"]="The item cannot be changed once selected. Do you wish to proceed?",
    ["TreviFount_Ui_10"]="The current wish requires Wish Coin x[s s=40.0 url=%s]%s.",
