    ["DialogueOption90703011"]="I'd be glad to.",
    ["DialogueOption90703012"]="I don't want it.",
    ["DialogueOption90703021"]="Just say what you want.",
    ["DialogueOption90801011"]="A little busy recently...",
    ["DialogueOption90801021"]="What is it?",
    ["DialogueOption90801031"]="Another champion?",
    ["DialogueOption90801041"]="Your ex-girlfriend?",
    ["DialogueOption90801051"]="Let me give it a try.",
    ["DialogueOption90802011"]="The hairstyle contest.",
    ["DialogueOption90802021"]="This is for you.",
    ["DialogueOption90803011"]="Serious?",
    ["DialogueOption90804011"]="You have an agreement?",
    ["DialogueOption90901011"]="What do you think this is?",
    ["DialogueOption90902011"]="How can I authenticate it?",
    ["DialogueOption90903011"]="Uh... And?",
    ["DialogueOption90903021"]="That... Crystal Authenticator?",
    ["DialogueOption90904011"]="Hmm...",
    ["DialogueOption90904021"]="There's hope?",
    ["DialogueOption90905031"]="You can have it!",
    ["DialogueOption90905041"]="Let's be friends.",
    ["DialogueOption91001011"]="What do you have?",
    ["DialogueOption91001021"]="This is... a treasure map?",
    ["DialogueOption91001031"]="Bertha and Norten?",
    ["DialogueOption91002011"]="This riddle?",
    ["DialogueOption91002021"]="I don't know.",
    ["DialogueOption91002031"]="That's it!",
    ["DialogueOption91003021"]="This riddle?",
    ["DialogueOption91003031"]="I just forgot.",
    ["DialogueOption91004011"]="A Sasquatch and a Vocal.",
    ["DialogueOption91004021"]="Why me?",
    ["DialogueOption91005011"]="No.",
    ["DialogueOption91005021"]="Norten said...",
    ["DialogueOption91101011"]="Uh... So?",
    ["DialogueOption91101021"]="What materials?",
    ["DialogueOption91101031"]="What does that matter?",
    ["DialogueOption91102011"]="The person you like?",
    ["DialogueOption91102021"]="It's not a husky?",
    ["DialogueOption91102031"]="What you can really do?",
    ["DialogueOption91103011"]="Again?",
    ["DialogueOption91104011"]="Uh... It seems like...",
    ["DialogueOption91105011"]="Ingael...",
    ["DialogueOption91106011"]="Don't kid yourself.",
    ["DialogueOption91106021"]="What feelings?",
    ["DialogueOption91201011"]="You didn't even let me speak.",
    ["DialogueOption91201021"]="So... What do you want me to do?",
    ["DialogueOption91202011"]="My friend is in love.",
    ["DialogueOption91202021"]="Thanks!",
    ["DialogueOption91203011"]="Thank you very much.",
    ["DialogueOption91203021"]="I didn't do anything to you.",
    ["DialogueOption91204011"]="So, we're even?",
    ["DialogueOption91204021"]="Good luck!",
    ["DialogueOption91301011"]="Of course!",
    ["DialogueOption91301021"]="It's no problem.",
    ["DialogueOption91302011"]="Jimmy Lin...",
    ["DialogueOption91302021"]="No need to thank me.",
    ["DialogueOption91302041"]="I'll ask him for you.",
    ["DialogueOption91303011"]="(Provide details)",
    ["DialogueOption91303031"]="Don't worry. I'll go ask.",
    ["DialogueOption91304011"]="He said it's not a problem!",
    ["DialogueOption91304021"]="But the performance outfit...",
    ["DialogueOption91304031"]="What do I need to prepare?",
    ["DialogueOption91305011"]="(Tell him what's needed)",
    ["DialogueOption91305021"]="What do you mean?",
    ["DialogueOption91305022"]="It's for Jimmy Lin...",
    ["DialogueOption91305041"]="What's up?",
    ["DialogueOption91305051"]="No problem!",
    ["DialogueOption91401011"]="Hello?",
    ["DialogueOption91401021"]="(Wave your hand)",
    ["DialogueOption91401031"]="You're working on a recipe?",
    ["DialogueOption91401041"]="Why'd you suddenly...",
    ["DialogueOption91401061"]="What is it?",
    ["DialogueOption91401071"]="What about me?",
    ["DialogueOption91402011"]="Rosemary Orchid...",
    ["DialogueOption91403011"]="How's it going?",
    ["DialogueOption91403021"]="Congratulations!",
    ["DialogueOption91404011"]="I'm not here to buy ingredients.",
    ["DialogueOption91404021"]="Look at this.",
    ["DialogueOption91405011"]="(Provide details)",
    ["DialogueOption91501011"]="Are these important to you?",
    ["DialogueOption91501021"]="What happened?",
    ["DialogueOption91501031"]="Don't lose heart yet.",
    ["DialogueOption91501041"]="Whitesmith Howard...",
    ["DialogueOption91501051"]="I can ask him to try.",
    ["DialogueOption91502011"]="(Provide details)",
    ["DialogueOption91502021"]="I'm counting on you.",
    ["DialogueOption91504011"]="Is there a way to fix it?",
    ["DialogueOption91505021"]="Did you succeed?",
    ["DialogueOption91505031"]="Thank you!",
    ["DialogueOption91601011"]="Of course, I would be happy to join.",
    ["DialogueOption91601012"]="I'm not interested.",
    ["DialogueOption91603011"]="An agreement...?",
    ["DialogueOption91701011"]="Huh?",
    ["DialogueOption91701021"]="Dinner? Mink fur?",
    ["DialogueOption91701031"]="......",
    ["DialogueOption91701041"]="Uh...",
    ["DialogueOption91702011"]="Jakdal...",
    ["DialogueOption91702021"]="The most expensive?",
    ["DialogueOption91702031"]="72 hours??",
    ["DialogueOption91702041"]="That's crazy...",
    ["DialogueOption91704011"]="Your custom outfit!",
    ["DialogueOption91704021"]="Surprise?",
    ["DialogueOption91801011"]="Is this important to you?",
    ["DialogueOption91801021"]="Important to it?",
    ["DialogueOption91801031"]="Then this shard...",
    ["DialogueOption91801041"]="Riddle Box?",
    ["DialogueOption91802011"]="...?",
    ["DialogueOption91802021"]="Eh... Don't mention it.",
    ["DialogueOption91802041"]="What do you need?",
    ["DialogueOption91803011"]="No problem!",
    ["DialogueOption91901011"]="Ah...",
    ["DialogueOption91901041"]="How do we see him?",
    ["DialogueOption91901051"]="I'll go find him.",
    ["DialogueOption91902011"]="(Provide details)",
    ["DialogueOption91902031"]="How exactly is it formulated?",
    ["DialogueOption91902041"]="I'll go ask him.",
    ["DialogueOption91903011"]="(Provide details)",
    ["DialogueOption91903021"]="It's the Magic Furnace's master...",
    ["DialogueOption91905021"]="(Provide details)",
    ["DialogueOption92000001"]="Divorce",
    ["DialogueOption92000002"]="I've already decided!",
    ["DialogueOption92000003"]="Let me think it over.",
    ["DialogueOption92000004"]="Uncontested divorce",
    ["DialogueOption92000005"]="Unilateral divorce",
    ["DialogueOption92000006"]="Pay the price.",
    ["DialogueOption92000007"]="Have a change of heart.",
    ["DialogueOption92001011"]="Of course!",
    ["DialogueOption92001021"]="No problem",
    ["DialogueOption92002011"]="Schumann…",
    ["DialogueOption92002021"]="No need to thank me.",
    ["DialogueOption92002041"]="I'll ask him for you.",
    ["DialogueOption92003011"]="(Provide details)",
    ["DialogueOption92003031"]="Don't worry. I'll go ask.",
    ["DialogueOption92004011"]="He said it's not a problem!",
    ["DialogueOption92004021"]="But the performance outfit...",
    ["DialogueOption92004031"]="What do I need to prepare?",
    ["DialogueOption92005011"]="(Tell him what's needed)",
    ["DialogueOption92005021"]="What do you mean?",
    ["DialogueOption92005022"]="It's Schumann…",
    ["DialogueOption92005041"]="What's up?",
    ["DialogueOption92005051"]="No problem",
    ["DialogueOption92101011"]="Hello?",
    ["DialogueOption92101021"]="(Wave your hand)",
    ["DialogueOption92101031"]="You're working on a recipe?",
    ["DialogueOption92101041"]="Why'd you suddenly...",
    ["DialogueOption92101061"]="What is it?",
    ["DialogueOption92101071"]="What about me?",
    ["DialogueOption92102011"]="Rosemary Orchid...",
    ["DialogueOption92103011"]="How did it go?",
    ["DialogueOption92103021"]="Congratulations!",
    ["DialogueOption92104011"]="I'm not here to buy ingredients.",
    ["DialogueOption92104021"]="Look at this.",
    ["DialogueOption92105011"]="(Provide details)",
    ["DialogueOption92201011"]="Are these important to you?",
    ["DialogueOption92201021"]="What happened?",
    ["DialogueOption92201031"]="Don't lose heart yet.",
    ["DialogueOption92201041"]="Mastersmith Howard...",
    ["DialogueOption92201051"]="I can ask him to try.",
    ["DialogueOption92202011"]="(Provide details)",
    ["DialogueOption92202021"]="Please",
    ["DialogueOption92204011"]="Is there a way to fix it?",
    ["DialogueOption92205021"]="Did you succeed?",
    ["DialogueOption92205031"]="Thank you!",
    ["DialogueOption92301011"]="Bored?",
    ["DialogueOption92301021"]="Excitement?",
    ["DialogueOption92301031"]="Horror games?",
    ["DialogueOption92302011"]="These places are...",
    ["DialogueOption92302031"]="Have you made up your mind yet?",
    ["DialogueOption92302041"]="Then it's settled?",
    ["DialogueOption92303011"]="Scared?",
    ["DialogueOption92304011"]="What's up?",
    ["DialogueOption92304021"]="Pfft...",
    ["DialogueOption92304041"]="Hahahaha!",
    ["DialogueOption92304061"]="My pleasure.",
    ["DialogueOption92401011"]="There, there.",
    ["DialogueOption92401021"]="(Try to hold it.)",
    ["DialogueOption92402011"]="It's okay. Come here!",
    ["DialogueOption92402021"]="Huh? This...",
    ["DialogueOption92403011"]="What is it?",
    ["DialogueOption92403031"]="Wait!",
    ["DialogueOption92404011"]="You want me to go inside?",
    ["DialogueOption92405021"]="You too...",
    ["DialogueOption92405041"]="The top priority now...",
    ["DialogueOption92405042"]="Is to take care of them...",
    ["DialogueOption92405043"]="And then to find their owner...",
    ["DialogueOption92406011"]="I'm just glad to see you're reunited.",
    ["DialogueOption92406031"]="On the way here?",
    ["DialogueOption92406041"]="Another world?",
    ["DialogueOption92406042"]="Cool...",
    ["DialogueOption92406061"]="I can help you.",
    ["DialogueOption92406071"]="No problem!",
    ["DialogueOption92501011"]="Yes, I have.",
    ["DialogueOption92501021"]="... Then what should we do?",
    ["DialogueOption92501031"]="Let me think...",
    ["DialogueOption92501041"]="Understood.",
    ["DialogueOption92502031"]="See this place as your second home.",
    ["DialogueOption92502041"]="What is it?",
    ["DialogueOption92502061"]="Beret...",
    ["DialogueOption92502062"]="(Vehicle name)...",
    ["DialogueOption92502101"]="... Thank you.",
    ["DialogueOption92601011"]="What happened?",
    ["DialogueOption92601021"]="Do you know why?",
    ["DialogueOption92601041"]="If you put it like that...",
    ["DialogueOption92601042"]="I'll ask around for you.",
    ["DialogueOption92602031"]="Tell me!",
    ["DialogueOption92603011"]="What should we do?",
    ["DialogueOption92603021"]="(Wave your hand.)",
    ["DialogueOption92603051"]="... Huh?",
    ["DialogueOption92604011"]="I saw you standing here...",
    ["DialogueOption92604012"]="May I ask what's wrong?",
    ["DialogueOption92604021"]="Hide?",
    ["DialogueOption92604031"]="?!",
    ["DialogueOption92604041"]="Desert Green Tavern...",
    ["DialogueOption92604042"]="I was about to tell you...",
    ["DialogueOption92701011"]="What's wrong?",
    ["DialogueOption92701021"]="Wow...",
    ["DialogueOption92701031"]="But isn't that a good thing?",
    ["DialogueOption92701041"]="That's easy though, isn't it?",
    ["DialogueOption92702011"]="I came precisely to...",
    ["DialogueOption92702031"]="First is Payon...",
    ["DialogueOption92702032"]="And then Morroc...",
    ["DialogueOption92702033"]="And lastly Geffen...",
    ["DialogueOption92702041"]="Not bad!",
    ["DialogueOption92703011"]="That happy, huh?",
    ["DialogueOption92703031"]="Alright.",
    ["DialogueOption92704011"]="What are you doing?",
    ["DialogueOption92704031"]="This...",
    ["DialogueOption92704061"]="I'll gladly take it. Thank you!",
    ["DialogueOption92801011"]="What's wrong?",
    ["DialogueOption92801041"]="I'll do my best.",
    ["DialogueOption92802011"]="It's about Rowan...",
    ["DialogueOption92802021"]="Is something wrong?",
    ["DialogueOption92803011"]="You're alright!",
    ["DialogueOption92803021"]="... Huh?",
    ["DialogueOption92803031"]="...?",
    ["DialogueOption92803041"]="Yes, there is.",
    ["DialogueOption92803051"]="... Alright.",
    ["DialogueOption92804011"]="He says he's your friend.",
    ["DialogueOption92804031"]="He seems to be from...",
    ["DialogueOption92804032"]="Another world...",
    ["DialogueOption92804091"]="It was just by chance...",
    ["DialogueOption92901031"]="你可以去问问呀~",
    ["DialogueOption92902011"]="你好，天使小姐~",
    ["DialogueOption92902021"]="你来自异世界？",
    ["DialogueOption92902031"]="这里是米德加兹",
    ["DialogueOption92902051"]="我带你去见他！",
    ["DialogueOption92903021"]="（讲述原委）",
    ["DialogueOption92903051"]="别哭了别哭了",
    ["DialogueOption92903061"]="再哭打你哦",
    ["DialogueOption92903062"]="我替你抓鱼？",
    ["DialogueOption92904011"]="不要太过分哦",
    ["DialogueOption92905011"]="是异世界的客人",
    ["DialogueOption93001011"]="你怎么啦？",
    ["DialogueOption93001021"]="没有",
    ["DialogueOption93001041"]="我们一起找",
    ["DialogueOption93001051"]="交给我吧！",
    ["DialogueOption93002011"]="<color=#CA2E0AFF>奈斯在城外！</color>",
    ["DialogueOption93003011"]="（讲述原委）",
    ["DialogueOption93004011"]="你……",
    ["DialogueOption93004021"]="莱奥？",
    ["DialogueOption93004071"]="沃尔玛斯大主教……",
    ["DialogueOption93005021"]="可是……",
    ["DialogueOption93005031"]="是的",
    ["DialogueOption93006011"]="成功了！",
    ["DialogueOption93006012"]="或许没有……",
    ["DialogueOption93101031"]="《笑话大全》",
    ["DialogueOption93101032"]="《卢恩秘史》",
    ["DialogueOption93101051"]="我也要看！",
    ["DialogueOption93102011"]="你好？",
    ["DialogueOption93102041"]="（说明原委）",
    ["DialogueOption93103031"]="什么比赛？",
    ["DialogueOption93103141"]="（放下书）我也去！",
    ["DialogueOption93104011"]="（叙述原委）",
    ["DialogueOption93105021"]="诶？？？",
    ["DialogueOption93105031"]="（叙述原委）",
    ["DialogueOption93201011"]="开心",
    ["DialogueOption93201012"]="不开心",
    ["DialogueOption93201031"]="好呀好呀~",
    ["DialogueOption93201041"]="可以找忽克连！",
    ["DialogueOption93202021"]="我是来……",
    ["DialogueOption93202031"]="……",
    ["DialogueOption93202051"]="……",
    ["DialogueOption93301091"]="怎么啦？",
    ["DialogueOption93301121"]="不是说没问题？",
    ["DialogueOption93301131"]="那如果成功了呢？",
    ["DialogueOption93301141"]="希望是这样……",
    ["DialogueOption93301161"]="走吧~",
    ["DialogueOption93302021"]="你怎么了？",
    ["DialogueOption93302041"]="（看向金希澈）",
    ["DialogueOption93303011"]="你还好吗？",
    ["DialogueOption93304011"]="（说明来意）",
    ["DialogueOption93304051"]="您说？",
    ["DialogueOption93305011"]="你恢复了？",
    ["DialogueOption93305031"]="里面是什么？",
    ["DialogueOption93401011"]="喜欢！",
    ["DialogueOption93401012"]="不喜欢……",
    ["DialogueOption93401041"]="好呀",
    ["DialogueOption93402161"]="我们一起去吧",
    ["DialogueOption93403011"]="你这是？",
    ["DialogueOption93404011"]="千岁酿？",
    ["DialogueOption93404091"]="可是你一个人…",
    ["DialogueOption93405011"]="还没",
    ["DialogueOption93405021"]="看那边！",
    ["DialogueOption93501011"]="彩排？",
    ["DialogueOption93501021"]="你要表演什么？",
    ["DialogueOption93501031"]="好吧……",
    ["DialogueOption93501032"]="那我不看了……",
    ["DialogueOption93501061"]="玫瑰红酒馆？",
    ["DialogueOption93501062"]="花瓣？",
    ["DialogueOption93502011"]="（说明来意）",
    ["DialogueOption93502041"]="我有不好的预感",
    ["DialogueOption93502051"]="一言为定！",
    ["DialogueOption93504011"]="嗯嗯！",
    ["DialogueOption93504031"]="你怎么了？",
    ["DialogueOption93504041"]="还有不正常的？",
    ["DialogueOption93505051"]="润喉糖？",
    ["DialogueOption93505071"]="只买一颗！",
    ["DialogueOption93506011"]="好呀",
    ["DialogueOption93506021"]="好的！",
    ["DialogueOption93506031"]="然后呢",
    ["DialogueOption93506041"]="？？？",
    ["DialogueOption93506051"]="？？？",
    ["DialogueOption93506061"]="这就是你的节目？",
    ["DialogueOption93506071"]="那迎新典礼……",
    ["DialogueOption93506081"]="……",
    ["DialogueOption93601011"]="这是邀请吗？",
    ["DialogueOption93601031"]="你喜欢什么？",
    ["DialogueOption93601041"]="游戏机是什么？",
    ["DialogueOption93601051"]="……",
    ["DialogueOption93601061"]="绮丝克莉茵会长…",
    ["DialogueOption93601071"]="目前还不确定",
    ["DialogueOption93602011"]="（说明来意）",
    ["DialogueOption93603011"]="是的",
    ["DialogueOption93604011"]="（说明来意）",
    ["DialogueOption93605021"]="我明白了！只要在脑海里，把通关的游戏再二周目一次就可以了对吧！",
    ["DialogueOption93605031"]="啊……总之我会努力想着游戏机的，请您尽管施法吧~",
    ["DialogueOption93606021"]="<color=#CA2E0AFF>我的礼物呢~</color>",
