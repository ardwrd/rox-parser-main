    ["ui_Update_001"]="Please restart the game to update!",
    ["ui_Update_002"]="Your version has been updated. You cannot enter the game until you install the newest version! Please download it now!",
    ["ui_Update_003"]="New update found.",
    ["ui_ValentineDayFestival_001"]="Sea of Stars",
    ["ui_ValentineDayFestival_002"]="Milky Way Wishes",
    ["ui_ValentineDayFestival_003"]="Star Love Shop",
    ["ui_ValentineDayFestival_004"]="Star Love Battle Song",
    ["ui_ValentineDayFestival_005"]="Get Rewards",
    ["ui_ValentineDayFestival_006"]="Shining Stars",
    ["ui_ValentineDayFestival_007"]="Starlit Wishes",
    ["ui_ValentineDayFestival_008"]="Starlit Shop",
    ["ui_ValentineDayFestival_009"]="Starlit Battle Song",
    ["ui_ValentineDayFestival_010"]="Starry Surprises",
    ["ui_ValentineDayFestival_011"]="Divination Ceremony",
    ["ui_ValentineDayFestival_012"]="Love Divination",
    ["ui_ValentineDayFestival_013"]="Destiny Store",
    ["ui_ValentineDayFestival_014"]="Odin's Secret Words",
    ["ui_ValentineDayFestival_015"]="Infuse With Energy",
    ["ui_ValentineDayFestival_016"]="Draw Rewards",
    ["ui_ValentineDayFestival_017"]="Recommended Divination",
    ["ui_ValentineDayFestival_018"]="During the event, pair up with other Adventurers and kill the specified monster by consuming Odin's Blessing to get rewards.",
    ["ui_ValentineDayFestival_019"]="星光推荐",
    ["ui_ValentineDayFestival_020"]="Guardian's Pact",
    ["ui_ValentineDayFestival_021"]="Game of Fate",
    ["ui_ValentineDayFestival_022"]="Triumph Vault",
    ["ui_ValentineDayFestival_023"]="Endgame Clash",
    ["ui_ValentineDayFestival_024"]="Reward Preview",
    ["ui_ValentineDayFestival_025"]="Mount Preview",
    ["ui_ValentineDayFestival_026"]="Suggested Partners",
    ["ui_ValentineDayFestival_028"]="Soulmate Test",
    ["ui_ValentineDayFestival_029"]="If Adventurers holding different Fortune Cookies gather together and perform the [Cheers] action,\n<color=#D39FEFFF>Cupid, the God of Love</color>, will bestow upon you his blessings, and you'll encounter White Paper Cranes as drops.\nIf you’re lucky, you might even see some <color=#FD97B6FF>Pink Paper Cranes</color>!",
    ["ui_ValentineDayFestival_030"]="Close Friends (>=520 Favor) will come across <color=#CF73AC>Pink Paper Crane</color> drops after performing the [Cheers] action together! Come on and give it a try!",
    ["ui_ValentineDayFestival_031"]="During the event, gifting [Chocolate Gift Boxes] to your Close Friends will not only increase your Favor with them—the recipient will also receive a random special treat of Golden Jar Cookies or Silver Jar Cookies!\nYou can also purchase gifts directly in the gift interface. Remember, there's a limit to how many times you can purchase gifts each day!",
    ["ui_ValentineDayFestival_032"]="Take Part Now",
    ["ui_ValentineDayFestival_033"]="Come and take part in the Soulmate Test! Answer correctly and you'll receive Paper Cranes as a reward!\nTwo friends can <color=#D39FEFFF>party up to participate</color> and receive extra Gold and Silver Jar Cookies!",
    ["ui_ValentineDayFestival_034"]="Take part solo and you'll also receive the corresponding rewards! After taking part, make sure you interact with your future friends!",
    ["ui_ValentineDayFestival_035"]="Future Friend List",
    ["ui_ValentineDayFestival_036"]="Go to Shop",
    ["ui_ValentineDayFestival_037"]="Invite Friends",
    ["ui_ValentineDayFestival_038"]="Request Management",
    ["ui_ValentineDayFestival_039"]="Recommended Friends",
    ["ui_ValentineDayFestival_041"]="Pair up to get extra daily rewards!",
    ["ui_ValentineDayFestival_042"]="You'll be matched with a group of future friends according to your preferences, and can earn rewards by completing specified interactions with them!",
    ["ui_ValentineDayFestival_043"]="You've fallen out of contact with your party member! The test has been terminated!",
    ["ui_ValentineDayFestival_044"]="You answered all of today's questions correctly! Your rewards have all been claimed—come back again tomorrow!",
    ["ui_ValentineDayFestival_045"]="Daily Bonus!",
