    ["OXExam_Question040"]="<color=#F2C730FF>Any class</color> can rent a <color=#F2C730FF>Pecopeco mount</color> as long as they meet the conditions. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question040_1"]="Only after changing class to Knight.",
    ["OXExam_Question041"]="<color=#F2C730FF>Swordsmen</color> can rent a <color=#F2C730FF>Pecopeco mount</color> as long as they meet the conditions. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question041_1"]="Only after changing class to Knight.",
    ["OXExam_Question042"]="<color=#F2C730FF>Knights</color> can rent a <color=#F2C730FF>Pecopeco mount</color> as long as they meet the conditions. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question043"]="<color=#F2C730FF>Any class</color> can rent a <color=#F2C730FF>Falcon</color> as long as they meet the conditions. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question043_1"]="Only after changing class to Hunter.",
    ["OXExam_Question044"]="<color=#F2C730FF>Archers</color> can rent a <color=#F2C730FF>Falcon</color> as long as they meet the conditions. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question044_1"]="Only after changing class to Hunter.",
    ["OXExam_Question045"]="<color=#F2C730FF>Hunters</color> can rent a <color=#F2C730FF>Falcon</color> as long as they meet the conditions. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question046"]="Izlude is located in the <color=#F2C730FF>southeast</color> of Prontera. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question047"]="Izlude is located in the <color=#F2C730FF>northwest</color> of Prontera. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question047_1"]="Izlude is located in the southeast of Prontera.",
    ["OXExam_Question048"]="Geffen is located in the <color=#F2C730FF>southeast</color> of Prontera. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question048_1"]="Geffen is located in the northwest of Prontera.",
    ["OXExam_Question049"]="Geffen is located in the <color=#F2C730FF>northwest</color> of Prontera. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question050"]="Payon is located in the <color=#F2C730FF>southeast</color> of Prontera. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question051"]="Payon is located in the <color=#F2C730FF>southwest</color> of Prontera. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question051_1"]="Payon is located in the southeast of Prontera.",
    ["OXExam_Question052"]="Morroc is located in the <color=#F2C730FF>southeast</color> of Prontera. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question052_1"]="Morroc is located in the southwest of Prontera.",
    ["OXExam_Question053"]="Morroc is located in the <color=#F2C730FF>southwest</color> of Prontera. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question054"]="You cannot sneeze with your eyes open. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question055"]="Humans share 50% of our DNA with bananas. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question056"]="Crocodiles can walk backwards. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question057"]="The brain is the fattiest organ. It is comprised of approximately 60% fat. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question058"]="Eating a big meal affects your hearing. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question059"]="Swordsman's skill <color=#F2C730FF>[Increase HP Recovery]</color> increases their HP Regen. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question060"]="Swordsman's skill <color=#F2C730FF>[Increase HP Recovery]</color> increases their HP Regen and SP Regen. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question060_1"]="[Increase HP Recovery] does not increase the character's SP Regen.",
    ["OXExam_Question061"]="Archer's skill <color=#F2C730FF>[Double Strafe]</color> is an active skill. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question062"]="Archer's skill <color=#F2C730FF>[Double Strafe]</color> is a passive skill. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question062_1"]="[Double Strafe] is an active skill.",
    ["OXExam_Question063"]="Acolyte's skill <color=#F2C730FF>[Blessing]</color> increases STR, DEX, and INT. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question064"]="Acolyte's skill <color=#F2C730FF>[Blessing]</color> increases Crit and Anti-Crit. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question064_1"]="[Blessing] increases STR, DEX, and INT.",
    ["OXExam_Question065"]="Mage's skill <color=#F2C730FF>[Increase SP Recovery]</color> increases their SP Regen. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question066"]="Mage's skill <color=#F2C730FF>[Increase SP Recovery]</color> increases their HP Regen and SP Regen. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question066_1"]="[Increase SP Recovery] does not increase HP Regen.",
    ["OXExam_Question067"]="Thief's skill <color=#F2C730FF>[Double Attack]</color> can be used when equipped with Daggers. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question068"]="Thief's skill <color=#F2C730FF>[Double Attack]</color> can be used when equipped with Katars. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question068_1"]="[Double Attack] can be used when equipped with Daggers.",
    ["OXExam_Question069"]="Novice's skill <color=#F2C730FF>[First Aid]</color> recovers their HP. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question070"]="Novice's skill <color=#F2C730FF>[First Aid]</color> recovers their HP and SP. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question070_1"]="[First Aid] does not restore the character's SP.",
    ["OXExam_Question071"]="Novice's skill <color=#F2C730FF>[Play Dead]</color> clears threat. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question072"]="Novice's skill <color=#F2C730FF>[Play Dead]</color> increases HP Regen and SP Regen. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question072_1"]="[Play Dead] does not restore the character's HP and SP.",
    ["OXExam_Question073"]="Legends say that there is an unethical coal tycoon at <color=#F2C730FF>Mjolnir Mine</color> named <color=#F2C730FF>Feng Yin</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question074"]="There was a kingdom of magic beneath the surface of <color=#F2C730FF>Geffen</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question075"]="You need to be in a party to enter <color=#F2C730FF>Endless Tower</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question076"]="<color=#F2C730FF>Geffen</color> is where the <color=#F2C730FF>Mage Guild</color> is based. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question077"]="As the <color=#F2C730FF>guild level</color> increases, the <color=#F2C730FF>maximum number of members</color> increases too. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question078"]="A legendary king of the past lived in seclusion in the <color=#F2C730FF>mountainous city</color> of <color=#F2C730FF>Payon</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question079"]="A <color=#F2C730FF>Magnolia</color> is the vengeful spirit of a cracked <color=#F2C730FF>Pecopeco Egg</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question080"]="The <color=#F2C730FF>Falcon</color> is exclusive to <color=#F2C730FF>hunters</color>; <color=#F2C730FF>other classes</color> cannot own it. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question081"]="The desert city of <color=#F2C730FF>Morroc</color> is a heaven for <color=#F2C730FF>knights</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question081_1"]="Morroc is a heaven for Assassins.",
    ["OXExam_Question082"]="<color=#F2C730FF>Panacea</color> can cure most <color=#F2C730FF>negative effects</color>. True <color=#64b4ff>(O)</color> or <color=#ff6481> False (X)</color>?",
    ["OXExam_Question083"]="In the <color=#F2C730FF>arm wrestling</color> minigame in the tavern, everyone uses their <color=#F2C730FF>left hand</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question083_1"]="You arm wrestle with your right hand",
    ["OXExam_Question084"]="<color=#F2C730FF>Moonlight Flower</color> has beautiful <color=#F2C730FF>yellow</color> pupils. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question084_1"]="Moonlight Flower has red pupils",
    ["OXExam_Question085"]="A soccer team can have <color=#F2C730FF>11</color> players on the field. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question086"]="A <color=#F2C730FF>thick glass</color> is more likely to <color=#F2C730FF>crack</color> than a thin one when hot water is poured into it during the winter. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question087"]="Toothpaste's mint flavor comes from <color=#F2C730FF>mint leaves</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question088"]="The Kafra Maids know this trick of removing the <color=#F2C730FF>burnt smell</color> of rice by <color=#F2C730FF>adding a few drops of vinegar</color> into it. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question089"]="The Monster Investigator is <color=#F2C730FF>losing their sense of smell</color> because their <color=#F2C730FF>liver</color> is failing. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question089_1"]="Their lungs are failing.",
    ["OXExam_Question090"]="Talyn feels <color=#F2C730FF>warmed up</color> because he ate too many <color=#F2C730FF>lychees</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question091"]="The <color=#F2C730FF>Kitty Girl</color> in Foulon Tavern has a sensitive <color=#F2C730FF>tongue</color>, so she never eats <color=#F2C730FF>hot</color> food. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question092"]="<color=#F2C730FF>Dry ice</color> is the solid form of <color=#F2C730FF>water</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question092_1"]="Dry ice is the solid form of carbon dioxide.",
    ["OXExam_Question093"]="The most abundant organism in the ocean is <color=#F2C730FF>Mutant Piranhas</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question093_1"]="The most abundant organism in the ocean is plankton.",
    ["OXExam_Question094"]="The <color=#F2C730FF>honeycomb cells</color> that Mistress makes are <color=#F2C730FF>circular</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question094_1"]="Honeycomb cells are hexagonal.",
    ["OXExam_Question095"]="Pencil lead is made using graphite. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question096"]="Indonesia's country calling code is <color=#F2C730FF>+62</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question097"]="The main function of the <color=#F2C730FF>windmill</color> at Prontera West Gate is to <color=#F2C730FF>drain water</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question098"]="The roman numeral XVIII equals <color=#F2C730FF>18</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question099"]="The world capital with the longest name is <color=#F2C730FF>Bangkok</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question100"]="You can sit on the long benches at Prontera South Gate for as long as you want. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question100_1"]="Everyone can only use the long benches for a limited time.",
    ["OXExam_Question101"]="<color=#F2C730FF>Poisons</color> are essential <color=#F2C730FF>consumables</color> for <color=#F2C730FF>archers</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question101_1"]="Poisons are essential consumables for Thieves.",
    ["OXExam_Question102"]="Having a good relationship with <color=#F2C730FF>Hollgrehenn</color> increases the success rate when <color=#F2C730FF>upgrading equipments</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question103"]="A lens that is <color=#F2C730FF>thicker</color> at the edges than it is in the middle is called a <color=#F2C730FF>convex lens</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question103_1"]="A lens that is thicker at the edges than it is in the middle is called a concave lens.",
    ["OXExam_Question104"]="The measure of speed for a boat is a <color=#F2C730FF>Knot</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question105"]="The lightest element is<color=#F2C730FF>hydrogen</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question106"]="The roman numeral M equals<color=#F2C730FF>1,000,000</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question106_1"]="M equals 1,000",
    ["OXExam_Question107"]="The Philippines' country calling code is <color=#F2C730FF>+63</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question108"]="The interior angles of a triangle always equal <color=#F2C730FF>180 degrees</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question109"]="Drake’s <color=#F2C730FF>crow</color> always stands on his <color=#F2C730FF>right shoulder</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question109_1"]="Drake's crow stands on his left shoulder",
    ["OXExam_Question110"]="The interior angles of a square always equal <color=#F2C730FF>360 degrees</color>. T、True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question111"]="MINI <color=#F2C730FF>Deviling</color> is a <color=#F2C730FF>large</color> monster. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question111_1"]="Deviling is a mid-size monster",
    ["OXExam_Question112"]="In Midgard, there are <color=#F2C730FF>9</color> different kinds of <color=#F2C730FF>Poring</color>.  True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question112_1"]="There are seven kinds of Poring",
    ["OXExam_Question113"]="There is a lovely <color=#F2C730FF>New Student Academy Recruiter</color> in Prontera, named <color=#F2C730FF>Qiqi</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question113_1"]="Her name is Kiki",
    ["OXExam_Question114"]="<color=#F2C730FF>Lotus root</color> is the <color=#F2C730FF>root</color> of a <color=#F2C730FF>lotus</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question114_1"]="It is the stem.",
    ["OXExam_Question115"]="The closest planet to the sun is <color=#F2C730FF>Mars</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question115_1"]="Mercury",
    ["OXExam_Question116"]="The color <color=#F2C730FF>black</color> absorbs all seven colors of the sunlight. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question117"]="<color=#F2C730FF>Sharks</color> are born from eggs. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question117_1"]="Sharks are born from wombs.",
    ["OXExam_Question118"]="<color=#F2C730FF>Clouds</color> and <color=#F2C730FF>mist</color> are essentially the same substance. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question119"]="Koko from Payon suffers from night blindness because she is a picky eater, resulting in vitamin B deficiency. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question119_1"]="Nyctalopia is caused by Vitamin A deficiency.",
    ["OXExam_Question120"]="Koko from Payon grinds her teeth at night because she has zinc deficiency. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question121"]="Ragnarok Online is a game adapted from a <color=#F2C730FF>comic</color>.  True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question122"]="Damage dealt by <color=#F2C730FF>magic attacks</color> is affected by <color=#F2C730FF>the target's size</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question122_1"]="Damage dealt by magic attacks is not affected by the target's size.",
    ["OXExam_Question123"]="The biggest land animal is an <color=#F2C730FF>elephant</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question124"]="<color=#F2C730FF>Poison</color> attacks increase damage toward <color=#F2C730FF>all attributes</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question124_1"]="Poison attacks only increase damage toward some attributes.",
    ["OXExam_Question125"]="<color=#F2C730FF>Attack Speed (ASPD)</color> and <color=#F2C730FF>Final Attack Speed (Final ASPD)</color> are different stats. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question126"]="<color=#F2C730FF>Crit</color> and <color=#F2C730FF>Final Crit</color> are the same stat. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question126_1"]="Crit and Final Crit are not the same stat.",
    ["OXExam_Question127"]="<color=#F2C730FF>Dodge</color> and <color=#F2C730FF>Final Dodge</color> are the same stat. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question127_1"]="Dodge and Final Dodge are not the same stat.",
    ["OXExam_Question128"]="The amount of holes in a round of golf is <color=#F2C730FF>20</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question128_1"]="18",
    ["OXExam_Question129"]="After using <color=#F2C730FF>Magnum Break</color>, the attribute of normal attacks will be changed to <color=#F2C730FF>Fire</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question130"]="After using <color=#F2C730FF>Aspersio</color>, the attribute of the target's normal attacks will be changed to <color=#F2C730FF>Holy</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question131"]="Only <color=#F2C730FF>Merchants</color> can open <color=#F2C730FF>shops</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question131_1"]="All pets with the Merchant affix can open shops.",
    ["OXExam_Question132"]="Every day at<color=#F2C730FF>12:00</color> PM and <color=#F2C730FF>8:00</color> PM, you can refill <color=#F2C730FF>Odin's Blessing</color> in <color=#F2C730FF>Prontera</color> more quickly than normal. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question133"]="You can reduce the <color=#F2C730FF>variable channeling</color> time of skills by increasing your <color=#F2C730FF>haste (VIG)</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question134"]="The <color=#F2C730FF>respawn times</color> for <color=#F2C730FF>MVPs</color> and <color=#F2C730FF>Minis</color> are the same. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question134_1"]="The respawn times for MVPs and Minis are different.",
    ["OXExam_Question135"]="When searching for items to buy at <color=#F2C730FF>shops</color>, you can only open <color=#F2C730FF>each shop</color> to search individually. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question135_1"]="You can use the Shop Finder sold at the Sundries Store to quickly search.",
    ["OXExam_Question136"]="At the Exchange Center, after an item is sold for <color=#F2C730FF>Diamonds</color>, you can earn an <color=#F2C730FF>equivalent amount of Crystals</color> corresponding to the Diamonds deducted after tax. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question137"]="Once Maya activates <color=#F2C730FF>Defensive Stance</color>, <color=#F2C730FF>Ranged classes</color> should <color=#F2C730FF>boost their DPS</color> to break the shield. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question137_1"]="Ranged classes should stay back.",
    ["OXExam_Question138"]="It's said the <color=#F2C730FF>Munak</color> and <color=#F2C730FF>Bongun</color> were a loving <color=#F2C730FF>couple</color> before they became monsters. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question138_1"]="Munak and Bongun are siblings.",
    ["OXExam_Question139"]="The <color=#F2C730FF>father and daughter</color> outside the <color=#F2C730FF>Prontera South Gate</color> are <color=#F2C730FF>not</color> actually related by blood. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question140"]="There are <color=#F2C730FF>9</color> different types of <color=#F2C730FF>Poring</color> living in Midgard. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question140_1"]="There are 7 types of Poring.",
    ["OXExam_Question141"]="Kafra Corporation <color=#F2C730FF>headquarters</color> is located in the city of canals, <color=#F2C730FF>Alberta</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question141_1"]="It's located in the border city Aldebaran.",
    ["OXExam_Question142"]="The border city <color=#F2C730FF>Morroc</color> has a flourishing <color=#F2C730FF>cotton industry</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question143"]="Currently there are <color=#F2C730FF>9</color> different types of <color=#F2C730FF>masked Goblins</color> in Midgard. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question143_1"]="There are 8 types of masked Goblins.",
    ["OXExam_Question144"]="<color=#F2C730FF>Vagabond Wolves</color> become stronger at <color=#F2C730FF>night</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question145"]="<color=#F2C730FF>Eclipses</color> love the scent of <color=#F2C730FF>Durian Grass</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question146"]="The accessory worn by <color=#F2C730FF>Baphomet</color> is known as the <color=#F2C730FF>Demon Ring</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question147"]="Legend has it a <color=#F2C730FF>Nightmare's</color> eyes have the power to <color=#F2C730FF>see into a person's heart</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question148"]="The Mini <color=#F2C730FF>Deviling </color> is a <color=#F2C730FF>large</color> monster. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question148_1"]="The Deviling is a medium-sized monster.",
    ["OXExam_Question149"]="Assassins will always enter <color=#F2C730FF>hiding</color> when using <color=#F2C730FF>rolling</color> or <color=#F2C730FF>hiding</color> skills. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question150"]="Ragnarok is a game that is adapted from a <color=#F2C730FF>manhwa</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question151"]="A <color=#F2C730FF>Poring</color>'s favorite food is <color=#F2C730FF>apple juice</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question152"]="The <color=#F2C730FF>Worn Out Scroll</color> and <color=#F2C730FF>Alcohol</color> are drops from <color=#F2C730FF>Undead</color> monsters. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question152_1"]="Dropped by Demon monsters.",
    ["OXExam_Question153"]="MVPs and Minis summoned using the <color=#F2C730FF>Bloody Branch</color> can only exist for a maximum of <color=#F2C730FF>1 hour</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question154"]="Drake's <color=#F2C730FF>Crow</color> is always perched on his <color=#F2C730FF>left shoulder</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question155"]="<color=#F2C730FF>Geffen</color> is home to the <color=#F2C730FF>Mage Guild</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question156"]="<color=#F2C730FF>Shattering Shrooms</color> don't just appear at night. They can be gathered on <color=#F2C730FF>sunny</color> <color=#F2C730FF>days</color> as well. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question156_1"]="It can only be found early in the morning or in the evening.",
    ["OXExam_Question157"]="When taking part in <color=#F2C730FF>Guild KVM</color>, party members of the same faction can be from <color=#F2C730FF>different guilds</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question157_1"]="Only guild members are allowed.",
    ["OXExam_Question158"]="You can catch <color=#F2C730FF>6</color> different types of fish in the <color=#F2C730FF>Underwater Cave</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question159"]="When showing off his biceps, <color=#F2C730FF>Hollgrehenn</color> likes to raise <color=#F2C730FF>both arms</color> first before raising his <color=#F2C730FF>right arm</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question159_1"]="He raises both arms first then raises his left arm.",
    ["OXExam_Question160"]="<color=#F2C730FF>Three</color> lotuses bloom at Payon's <color=#F2C730FF>Bright Lotus Pond</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question161"]="<color=#F2C730FF>W</color> is known as Kafra's <color=#F2C730FF>Miss Popular</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question162"]="Everyone uses their <color=#F2C730FF>left arm</color> in the Tavern's <color=#F2C730FF>Arm Wrestling</color> minigame. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question162_1"]="Arm Wrestling uses the right arm.",
    ["OXExam_Question163"]="The <color=#F2C730FF>Moonlight Flower</color> has beautiful <color=#F2C730FF>red</color> pupils. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question164"]="The red stripes on a <color=#F2C730FF>King Dramoh</color> are scars from being <color=#F2C730FF>boiled at high temperatures</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question165"]="You can use a <color=#F2C730FF>Panacea</color> to remove the debuff from getting hit by Phreeoni's <color=#F2C730FF>Acid Rain</color> attack. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question166"]="A <color=#F2C730FF>Katar</color> deals 100% damage to <color=#F2C730FF>Medium and Small monsters</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question166_1"]="Deals 100% damage to Small monsters.",
    ["OXExam_Question167"]="During <color=#F2C730FF>Wilderness AFK</color>, party size is proportional to the bonus coefficient. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question168"]="You can obtain <color=#F2C730FF>Orange Equipment</color> via the following methods: MVP, Mini, Exchange Center, and Equipment Vending Machine. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question169"]="On the Skills page, active skills are presented in <color=#F2C730FF>round</color> icons. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question170"]="On the Skills page, passive skills are presented in <color=#F2C730FF>square</color> icons. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question171"]="When the skill settings are on Auto, the level of <color=#F2C730FF>active skills</color> cannot be adjusted. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question171_1"]="The level of active skills can be adjusted in Auto settings.",
    ["OXExam_Question172"]="You can purchase the Neuralizer from Alberta's <color=#F2C730FF>Crystal Store</color> and use it to reset skill points. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question173"]="You can purchase the Magical Stone from Alberta's <color=#F2C730FF>Crystal Store</color> and use it to reset attribute points. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question174"]="<color=#F2C730FF>Ultimate Showdown</color> is fair and balanced. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question175"]="By participating in <color=#F2C730FF>Ultimate Showdown</color>, a player can get a lot of <color=#F2C730FF>Shadow Equipment</color> upgrade materials. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question176"]="<color=#F2C730FF>Yoyo</color>'s favorite fruit is a Juicy Grape. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question177"]="A <color=#F2C730FF>Baby Desert Wolf</color>'s favorite food is Animal Gore. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question177_1"]="A Baby Desert Wolf's favorite food is Livestock Gore.",
    ["OXExam_Question178"]="<color=#F2C730FF>Odin's Blessing</color> only works on monsters within 3 levels of the caster. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question178_1"]="Only works on monsters within 6 levels of the caster.",
    ["OXExam_Question179"]="<color=#F2C730FF>Odin's Blessing</color> can only be obtained from Daily Missions. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question179_1"]="Available by completing Daily Missions and from AFK on the Prontera scene.",
    ["OXExam_Question180"]="Participating in the <color=#F2C730FF>Tavern Minigame</color> can get you <color=#F2C730FF>Stamina Potions</color>. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question181"]="<color=#F2C730FF>Kafra Service Employees</color> can teleport you to cities that you have never visited before. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question182"]="When <color=#F2C730FF>capturing pets</color>, the lower the monster's HP, the higher the success rate. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question183"]="For the additional rewards of <color=#F2C730FF>Odin's Blessing</color>, item dropping from monsters is not bound by level reduction. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question184"]="When you <color=#F2C730FF>kill a monster</color> in the normal state, item dropping from the monster is bound by level reductions. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question185"]="You can purchase the <color=#F2C730FF>Change Name Card</color> in the game to change your character's name. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question186"]="You can unlock higher enchantment levels by increasing Favor with NPCs. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question187"]="Only heterosexual couples are allowed in the game. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question187_1"]="All of the above",
    ["OXExam_Question188"]="The Automatic Fishing Rod can be exchanged with Fish Print Commemorative Coins in the game. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question189"]="Priest's skill Sanctuary can deal damage to the undead and demons. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question190"]="There are 4 progress chests in the Carnival. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question190_1"]="5 in total",
    ["OXExam_Question191"]="Only Swordmen can engage in Cavalry Combat. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question191_1"]="Apply to both Swordman and Ranger",
    ["OXExam_Question192"]="Tilt your head and open your mouth slightly when applying eye drops so that you won't blink easily. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXExam_Question193"]="When dust gets into your eyes, close your eyes and cough a few times, and the dust will come out by itself. True <color=#64b4ff>(O)</color> or False <color=#ff6481>(X)</color>?",
    ["OXMidAutumnQuestion001"]=" The Mid-Autumn Festival originated from <color=#F2C730FF>astronomical worship</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion002"]="The Mid-Autumn Festival was first recorded in the <color=#F2C730FF>Rites of Zhou</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion003"]="The Mid-Autumn Festival became an officially recognized national festival in the <color=#F2C730FF>Sui Dynasty</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion003_1"]="It became an officially recognized national festival in the Tang Dynasty.",
    ["OXMidAutumnQuestion004"]="\"A small cake that resembles the moon, with a soft and sweet filling\" is a reference to <color=#F2C730FF>moon cakes</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion005"]="The reunion image of the Mid-Autumn Festival started from the <color=#F2C730FF>Northern Song Dynasty</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion005_1"]="It started in the Ming Dynasty.",
    ["OXMidAutumnQuestion006"]="Besides the worshipping of the moon, <color=#F2C730FF>osmanthus</color> is also a major focus of Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion007"]="There is a custom of <color=#F2C730FF>lighting up ship-shaped lanterns</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion008"]="During \"chasing the moon\\,\" guests are invited to continue enjoying the moon for <color=#F2C730FF>one week</color> after the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion008_1"]="During \"chasing the moon\\,\" guests are invited to continue enjoying the moon on the next day after the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion009"]="Mid-Autumn Festival also has the custom of <color=#F2C730FF>playing lantern riddles</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion010"]="In the southeastern parts of China, there is also the custom of <color=#F2C730FF>watching the tide</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion011"]="During the Mid-Autumn Festival, the custom of erecting paper lanterns with high poles is called <color=#F2C730FF>lantern riddles</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion011_1"]="This custom is called Mid-Autumn trees.",
    ["OXMidAutumnQuestion012"]="The making of \"pomelo lanterns\" is a custom exclusive to <color=#F2C730FF>adults</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion012_1"]="The making of pomelo lanterns is an exclusive activity for children.",
    ["OXMidAutumnQuestion013"]="There are also lanterns on the Mid-Autumn Festival, and the <color=#F2C730FF>scale is the same</color> as that of the Lantern Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion013_1"]="On the Mid-Autumn Festival, the lanterns are of a much smaller scale than on the Lantern Festival.",
    ["OXMidAutumnQuestion014"]="The <color=#F2C730FF>fire dragon dance</color> is also a Mid-Autumn Festival custom. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion015"]="\"Listening to incense\" refers to <color=#F2C730FF>receiving guidance from the gods</color> after the burning of incense to make one's wishes come true. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion015_1"]="When \"listening to incense\\,\" the first thing you hear after asking a question while the incense is burning is the gods' answer to your question.",
    ["OXMidAutumnQuestion016"]="The \"tower burning\" custom refers to the burning of <color=#F2C730FF>towers</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion016_1"]="\"Tower burning\" refers to the burning of tower-shaped lanterns.",
    ["OXMidAutumnQuestion017"]="The prototype of the Rabbit God is a <color=#F2C730FF>moon rabbit</color> from the moon palace. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion018"]="In the Ming Dynasty, the court <color=#F2C730FF>enjoyed eating crabs</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion019"]="\"Men don't worship the moon, and women don't offer sacrifice at the hearth\" means that <color=#F2C730FF>men don't celebrate the Mid-Autumn Festival</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion020"]="The custom of playing with the Rabbit God during the Mid-Autumn Festival started in the <color=#F2C730FF>early Qing Dynasty</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion020_1"]="This custom originated in the late Ming Dynasty.",
    ["OXMidAutumnQuestion021"]="In the Jiangnan area of China, the activity of going out for a stroll along bustling streets during the Mid-Autumn Festival is referred to as <color=#F2C730FF>\"walking the moon\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion022"]="During the Mid-Autumn Festival, children put incense on pomelos and dance, which is an activity called \"fragrant dancing meteor balls\". This activity originated in <color=#F2C730FF>northern China</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion022_1"]="The custom of \"fragrant dancing meteor balls\" originated in Sichuan.",
    ["OXMidAutumnQuestion023"]="The Mid-Autumn Festival custom called \"moon cake gambling\\,\" which originated in southern Fujian is a type of <color=#F2C730FF>dice game</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion024"]="\"Qingmiaoshe\" is an activity carried out in northern China to worship the <color=#F2C730FF>moon</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion024_1"]="\"Qingmiaoshe\" is an activity carried out to worship the God of the Earth.",
    ["OXMidAutumnQuestion025"]="In some parts of <color=#F2C730FF>Hebei</color>, Mid-Autumn Festival is also called \"Little New Year\". True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion026"]="The Mongolian people have a <color=#F2C730FF>\"chasing the moon\"</color> custom in which some riders chase the moon until it sets in the west. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion027"]="The Tibetian people have a \"searching for the moon\" Mid-Autumn Festival custom that is related to the <color=#F2C730FF>reflection of the moon in the water</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion028"]="The \"walking on the moon\" custom of the Kam people in Guangxi is to <color=#F2C730FF>enjoy the moon while on horseback</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion028_1"]="\"Walking on the moon\" refers to forming a singing and dancing team to perform under the moonlight.",
    ["OXMidAutumnQuestion029"]="\"String of moons\" is a Mid-Autumn Festival custom in which ethnic minorities of Yunnan <color=#F2C730FF>visit their relatives</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion029_1"]="\"String of moons\" is a custom for young men and women to form a good relationship with each other.",
    ["OXMidAutumnQuestion030"]="<color=#F2C730FF>\"Jumping the moon\"</color> is the custom of the Yi people in Yunnan in which they sing and dance in the moonlight. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion031"]="\"Tiger Day\" is what the Gelao people call the <color=#F2C730FF>Mid-Autumn Festival</color>. On this day, they will slaughter bulls. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion031_1"]="\"Tiger Day\" refers to the several days before the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion032"]="During the Mid-Autumn Festival, the Korean people will build a \"moon-watching frame\" for the <color=#F2C730FF>children</color> to watch the moon. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion032_1"]="The moon-watching frame is for the elderly to watch the moon.",
    ["OXMidAutumnQuestion033"]="The <color=#F2C730FF>Zhuang people</color> have the custom of inviting the Moon God during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion034"]="In the Zhuang people's custom of inviting the Moon God, it is necessary to have a <color=#F2C730FF>man</color> act as a spokesperson. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion034_1"]="The spokesperson should be a woman.",
    ["OXMidAutumnQuestion035"]="In the Zhuang people's custom of inviting the Moon God, everyone <color=#F2C730FF>listens</color> to the singing of the spokesperson of the Moon God. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion035_1"]="When inviting the Moon God, the people sing antiphonally with the spokesperson of the Moon God instead of just listening.",
    ["OXMidAutumnQuestion036"]="In the Zhuang people's custom of inviting the Moon God, it <color=#F2C730FF>isn't necessary</color> to see off the Moon God returning to the sky. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion036_1"]="After inviting the Moon God, it is necessary to see off the Moon God returning to the sky.",
    ["OXMidAutumnQuestion037"]="The <color=#F2C730FF>Li people</color> call the Mid-Autumn Festival the \"August Meeting\" or the \"Harmonizing Festival\". True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion038"]="In the Li people's \"Harmonizing Festival\\,\" the leading male and female youths are called the <color=#F2C730FF>\"harmonizing leaders\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion039"]="In the Li people's \"August Meeting\\,\" there is <color=#F2C730FF>no</color> custom of eating moon cakes. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion039_1"]="The Li people have a custom of eating moon cakes.",
    ["OXMidAutumnQuestion040"]="In Korea, the Mid-Autumn Festival is also called the <color=#F2C730FF>\"day of Gabae\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion041"]="In English, Korea's Chuseok is known as the <color=#F2C730FF>\"Korea's Thanksgiving\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion042"]="Vietnam's Mid-Autumn Festival is held to commemorate <color=#F2C730FF>Agui</color> in the legends. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion043"]="In Vietnamese legends, Agui is a <color=#F2C730FF>God of Medicine who has excellent medical skills</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion043_1"]="Agui used the bodhi tree to treat people's illnesses, not his own medical skills.",
    ["OXMidAutumnQuestion044"]="In Vietnamese legends, Agui climbed to the moon palace <color=#F2C730FF>by himself</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion044_1"]="The bodhi tree took Agui to fly to the moon palace.",
    ["OXMidAutumnQuestion045"]="Vietnam’s Mid-Autumn Festival activities are <color=#F2C730FF>more related to animals</color>, such as lion dances and carp lanterns. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion046"]="In Japan, the Mid-Autumn Festival is also called <color=#F2C730FF>Jūgoya</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion047"]="In Japan, the Mid-Autumn Festival is also called <color=#F2C730FF>Imomeigetsu</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion048"]="In Japan, it is a custom to <color=#F2C730FF>eat moon cakes</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion048_1"]="In Japan, it is customary to eat tsukimi dango during the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion049"]="In Japan, moon-viewing is called <color=#F2C730FF>\"tsukimi\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion050"]="When admiring the moon during the Mid-Autumn Festival in Japan, dango, miscanthus and other items will be displayed <color=#F2C730FF>in the house</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion051"]="The Mid-Autumn Festival is a very important festival in <color=#F2C730FF>Malaysia</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion052"]="In the <color=#F2C730FF>most original</color> version of the story, Chang'e ate an elixir and flew to the moon. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion052_1"]="The story of Chang'e eating an elixir and flying to the moon is a story that has been adapted and spread.",
    ["OXMidAutumnQuestion053"]="The recordation of the moon rabbit pounding medicine was first seen in Qu Yuan's <color=#F2C730FF>Heavenly Questions</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion054"]="According to the legends, the moon rabbit is <color=#F2C730FF>Chang'e's</color> rabbit, which flew with her to the moon palace. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion055"]="In all the legends, the moon rabbit is making <color=#F2C730FF>an immortality medicine</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion055_1"]="In Japanese legends, the moon rabbit is making rice cakes.",
    ["OXMidAutumnQuestion056"]="The famous musical composition <color=#F2C730FF>Raiment of Rainbows and Feathers</color> is related to Tang Xuanzong's in-the-dream tour of the moon palace. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion057"]="Moon cakes were once used to convey information for the uprisings in the <color=#F2C730FF>Yuan Dynasty</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion058"]="There is an allegorical saying: The moon on Mid-Autumn Festival—<color=#F2C730FF>open and upright</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion058_1"]="The moon on Mid-Autumn Festival—upright.",
    ["OXMidAutumnQuestion059"]="There is an allegorical saying: Eating rice cakes on Mid-Autumn Festival—<color=#F2C730FF>just right</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion059_1"]="Eating rice cakes on Mid-Autumn Festival—too early.",
    ["OXMidAutumnQuestion060"]="There is an allegorical saying: Gazing at lanterns on Mid-Autumn Festival—<color=#F2C730FF>about the same</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion060_1"]="Gazing at lanterns on Mid-Autumn Festival—half a year late.",
    ["OXMidAutumnQuestion061"]="There is an allegorical saying: Celebrating the new year on Mid-Autumn Festival—<color=#F2C730FF>in advance</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion061_1"]="Celebrating the new year on Mid-Autumn Festival—wrong season.",
    ["OXMidAutumnQuestion062"]="In some places, there is a custom of stealing food during the Mid-Autumn Festival. <color=#F2C730FF>The more food stolen</color>, the happier the owner would feel. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion062_1"]="In the custom of stealing food during the Mid-Autumn Festival, the more food that is stolen and eaten, the happier the owner feels.",
    ["OXMidAutumnQuestion063"]="The practice of boiling wax is a well-known Mid-Autumn Festival custom that is <color=#F2C730FF>still</color> practiced today. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion063_1"]="The practice of boiling wax has been forbidden since the last century due to safety concerns.",
    ["OXMidAutumnQuestion064"]="In addition to celebrating the autumn harvest, Chuseok on the Korean Peninsula also has the meaning of <color=#F2C730FF>celebrating the victory over Balhae</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion065"]="Ganggangsullae is a folk dance to celebrate the <color=#F2C730FF>Dragon Boat Festival</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion065_1"]="Ganggangsullae is a dance to celebrate the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion066"]="Besides referring to the Mid-Autumn Festival, \"tsukimi\" can also refer to <color=#F2C730FF>The Thirteenth Night</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion067"]="The Mid-Autumn Festival is also called the <color=#F2C730FF>\"Moonlight Festival\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion068"]="<color=#F2C730FF>Moon Prayer</color> is a custom for single men and women to pray to the Old Man Under the Moon for a good relationship. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion069"]="Watching the tide is a major custom of the Mid-Autumn Festival and is mainly held along the <color=#F2C730FF>northern coasts</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion069_1"]="The custom of watching the tide is mainly practiced in Zhejiang.",
    ["OXMidAutumnQuestion070"]="Moon basking is a custom in which <color=#F2C730FF>single women</color> bask under the moonlight at night to pray for a good relationship. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion070_1"]="\"Moon basking\" is a custom for married women to pray for children.",
    ["OXMidAutumnQuestion071"]="In <color=#F2C730FF>Jiangsu, China</color>, it is a custom to burn incense during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion072"]="<color=#F2C730FF>\"Stealing moon vegetables\"</color> is a custom of the Mid-Autumn Festival in which young women steal vegetables at night to seek a good marriage. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion073"]="The handkerchief-throwing marriage-solicitation custom originated in Fujian, China. In this custom, unmarried women <color=#F2C730FF>dress up as Chang'e</color> and throw a handkerchief to solicit suitors. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion074"]="Wu Gang <color=#F2C730FF>originally</color> lived on the moon and cut down osmanthus trees for a living. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion074_1"]="Wu Gang was punished to go to the moon palace.",
    ["OXMidAutumnQuestion075"]="<color=#F2C730FF>\"Hitting the moon\"</color> is a custom of the Tu people in which people scoop water and hit the reflection of the moon in the water with stones. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion076"]="The Rabbit God is a <color=#F2C730FF>moon rabbit</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion077"]="The Mid-Autumn dragon dance originated from the legend of the <color=#F2C730FF>python</color> that terrorized the people. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion078"]="At the request of Chang'e, the Rabbit God descended from the moon to treat illnesses and <color=#F2C730FF>got paid</color> for this. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion078_1"]="The Rabbit God didn't want to be paid and only wanted to borrow clothes to wear.",
    ["OXMidAutumnQuestion079"]="The custom of burning towers on Mid-Autumn Festival originated from <color=#F2C730FF>peasant uprisings</color> in the old days. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion080"]="During the Mid-Autumn Festival in Ryukyu, <color=#F2C730FF>people eat moon cakes and offer fuchagi as sacrifices</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion080_1"]="Both can be used as food and a sacrificial offering.",
    ["OXMidAutumnQuestion081"]="During the Mid-Autumn Festival, people worship the moon and the land, and the festival counts as a <color=#F2C730FF>harvest festival</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion082"]="Planting wheat on Mid-Autumn Festival—<color=#F2C730FF>hurry up</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion082_1"]="Planting wheat on Mid-Autumn Festival—too early.",
    ["OXMidAutumnQuestion083"]="The weather during Mid-Autumn—<color=#F2C730FF>gentle and pleasant</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion083_1"]="The weather during Mid-Autumn—neither hot nor cold.",
    ["OXMidAutumnQuestion084"]="Grinding grains for the new year on Mid-Autumn Festival—<color=#F2C730FF>unreasonable</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion084_1"]="Grinding grains for the new year on Mid-Autumn Festival—earlier.",
    ["OXMidAutumnQuestion085"]="Eating dumplings on Mid-Autumn Festival—<color=#F2C730FF>outrageous</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion085_1"]="Eating dumplings on Mid-Autumn Festival—breaking the rules.",
    ["OXMidAutumnQuestion086"]="Hitting rabbits on Mid-Autumn Festival—<color=#F2C730FF>revolt</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion086_1"]="Hitting rabbits on Mid-Autumn Festival—far from close.",
    ["OXMidAutumnQuestion087"]="Planting peanuts on Mid-Autumn Festival—<color=#F2C730FF>perfect timing</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion087_1"]="Planting peanuts on Mid-Autumn Festival—issuing confusing orders.",
    ["OXMidAutumnQuestion088"]="Fishing out the moon on the river bank—<color=#F2C730FF>hardworking</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion088_1"]="Fishing out the moon on the river bank—no good.",
    ["OXMidAutumnQuestion089"]="The moon chasing the sun—<color=#F2C730FF>impossible</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion089_1"]="The moon chasing the sun—they never meet.",
    ["OXMidAutumnQuestion090"]="When the clouds cover the moon on Mid-Autumn Festival—<color=#F2C730FF>pitch-black</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion090_1"]="When the clouds cover the moon on Mid-Autumn Festival—disappointing.",
    ["OXMidAutumnQuestion091"]="Seeing flames on Mid-Autumn Festival—<color=#F2C730FF>flustered</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion091_1"]="Seeing flames on Mid-Autumn Festival—cooling down.",
    ["OXMidAutumnQuestion092"]="Planting beans on Mid-Autumn Festival—<color=#F2C730FF>in a hurry</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion092_1"]="Planting beans on Mid-Autumn Festival—three seasons late.",
    ["OXMidAutumnQuestion093"]="Reunion cakes on Mid-Autumn Festival—<color=#F2C730FF>sharing</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion093_1"]="Reunion cakes on Mid-Autumn Festival—not to be given to outsiders.",
    ["OXMidAutumnQuestion094"]="Chang'e using scissors—<color=#F2C730FF>heartless</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion094_1"]="Chang'e using scissors—talented.",
    ["OXMidAutumnQuestion095"]="Striking the moon with a bamboo pole—<color=#F2C730FF>very bold</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion095_1"]="Striking the moon with a bamboo pole—it'll never hit.",
    ["OXMidAutumnQuestion096"]="The sun talking to the moon—<color=#F2C730FF>Loudspeaker</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion096_1"]="The sun talking to the moon—empty talk.",
    ["OXMidAutumnQuestion097"]="Mad dog biting the moon—<color=#F2C730FF>big appetite</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion097_1"]="Mad dog biting the moon—wildly arrogant.",
    ["OXMidAutumnQuestion098"]="A bald person chasing the moon—<color=#F2C730FF>like attracts like</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion098_1"]="A bald person chasing the moon—absorbing the light.",
    ["OXMidAutumnQuestion099"]="Lighting a lamp under the moon—<color=#F2C730FF>lending light to one another</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion099_1"]="Lighting a lamp under the moon—unnecessary.",
    ["OXMidAutumnQuestion100"]="Playing with a machete under the moon—<color=#F2C730FF>showing off</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion100_1"]="Pull it to the light",
    ["OXMidAutumnQuestion101"]=" The Mid-Autumn Festival originated from <color=#F2C730FF>the worship of a person</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion101_1"]="The Mid-Autumn Festival originated from astronomical worship.",
    ["OXMidAutumnQuestion102"]="The Mid-Autumn Festival was first recorded in <color=#F2C730FF>The Commentary of Zuo</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion102_1"]="Mid-Autumn was first recorded in the Rites of Zhou.",
    ["OXMidAutumnQuestion103"]="The Mid-Autumn Festival became an officially recognized national festival in the <color=#F2C730FF>Tang Dynasty</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion104"]="\"A small cake that resembles the moon, with a soft and sweet filling\" is a reference to <color=#F2C730FF>Zongzi</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion104_1"]="\"A small cake that resembles the moon, with a soft and sweet filling\" is a reference to moon cakes.",
    ["OXMidAutumnQuestion105"]="The reunion image of the Mid-Autumn Festival started from the <color=#F2C730FF>Ming and Qing Dynasties</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion106"]="Besides the worshipping of the moon, <color=#F2C730FF>peach trees</color> are also a major focus of Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion106_1"]="Besides the worshipping of the moon, osmanthus is also a major focus of Mid-Autumn Festival.",
    ["OXMidAutumnQuestion107"]="There <color=#F2C730FF>has never been</color> a custom of lighting up ship-shaped lanterns during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion107_1"]="There is a custom of lighting up ship-shaped lanterns during the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion108"]="\"chasing the moon\" is a custom where guests are invited to continue enjoying the moon <color=#F2C730FF>on the next day</color> after the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion109"]="Mid-Autumn Festival has <color=#F2C730FF>never</color> had the custom of lantern riddles. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion109_1"]="Mid-Autumn Festival has the custom of guessing lantern riddles.",
    ["OXMidAutumnQuestion110"]="In the <color=#F2C730FF>northwestern</color> parts of China, there is also the custom of watching the tide during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion110_1"]="In the southeastern parts of China, there is also the custom of watching the tide during the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion111"]="During the Mid-Autumn Festival, the custom of erecting paper lanterns with high poles is called <color=#F2C730FF>Mid-Autumn trees</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion112"]="The making of \"pomelo lanterns\" is a custom exclusive to <color=#F2C730FF>children</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion113"]="There are also lanterns on the Mid-Autumn Festival, but the scale is <color=#F2C730FF>much smaller than that of the Lantern Festival</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion114"]="The fire dragon dance <color=#F2C730FF>is not</color> a Mid-Autumn Festival custom. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion114_1"]="The fire dragon dance is a Mid-Autumn Festival custom in the southeastern regions.",
    ["OXMidAutumnQuestion115"]="When \"listening to incense\\,\" the first thing you hear after asking a question <color=#F2C730FF>while the incense is burning</color> is the answer to your question. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion116"]="The \"tower burning\" custom refers to the burning of <color=#F2C730FF>tower-shaped lanterns</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion117"]="The prototype of the Rabbit God is <color=#F2C730FF>Chang'e</color> from the moon palace. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion117_1"]="The prototype of the Rabbit God is a moon rabbit.",
    ["OXMidAutumnQuestion118"]="In the Ming Dynasty, the court <color=#F2C730FF>was not allowed to eat crabs</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion118_1"]="In the Ming Dynasty, the court enjoyed eating crabs during the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion119"]="\"Men don't worship the moon, and women don't offer sacrifice at the hearth\" means that <color=#F2C730FF>women</color> don't celebrate the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion119_1"]="\"Men don't worship the moon, and women don't offer sacrifice at the hearth\" means that men don't celebrate the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion120"]="The custom of playing with the Rabbit God during the Mid-Autumn Festival started in the <color=#F2C730FF>late Ming Dynasty</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion121"]="In the Jiangnan area of China, the activity of going out for a stroll along bustling streets during the Mid-Autumn Festival is referred to as <color=#F2C730FF>\"chasing the moon\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion121_1"]="This custom is called walking the moon.",
    ["OXMidAutumnQuestion122"]="During the Mid-Autumn Festival, children put incense on pomelos and dance, which is an activity called \"fragrant dancing meteor balls\". This activity originated in <color=#F2C730FF>Sichuan, China</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion123"]="The Mid-Autumn Festival custom called \"moon cake gambling\\,\" which originated in southern Fujian is a type of <color=#F2C730FF>card game</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion123_1"]="Moon cake gambling is a type of dice game.",
    ["OXMidAutumnQuestion124"]="\"Qingmiaoshe\" is an activity carried out in northern China to worship the <color=#F2C730FF>God of the Earth</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion125"]="In some parts of Hebei, Mid-Autumn Festival is also called the <color=#F2C730FF>\"Big New Year\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion125_1"]="In some parts of Hebei, the Mid-Autumn Festival is called \"Little New Year\".",
    ["OXMidAutumnQuestion126"]="The <color=#F2C730FF>Uyghurs</color> have a \"chasing the moon\" custom in which some riders chase the moon until it sets in the west. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion126_1"]="The Mongolian people have a chasing the moon custom.",
    ["OXMidAutumnQuestion127"]="The Tibetian people have a \"searching for the moon\" Mid-Autumn Festival custom that is related to the <color=#F2C730FF>shape of the moon in the sky</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion127_1"]="The\"searching for the moon\" Mid-Autumn Festival custom is related to the reflection of the moon in the water.",
    ["OXMidAutumnQuestion128"]="The \"walking on the moon\" custom of the Kam people in Guangxi is to <color=#F2C730FF>form a singing and dancing team</color> to perform under the moonlight. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion129"]="\"String of moons\" is a Mid-Autumn Festival custom for <color=#F2C730FF>young men and women</color> from ethnic minorities of Yunnan to form a good relationship with each other. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion130"]="\"Jumping the moon\" is the custom of the <color=#F2C730FF>Korean people</color> in which they sing and dance in the moonlight. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion130_1"]="\"Jumping the moon\" is a custom of the Yi people in Yunnan.",
    ["OXMidAutumnQuestion131"]="\"Tiger Day\" is what the Gelao people call the <color=#F2C730FF>several days before the Mid-Autumn Festival</color>. On these days, they will slaughter bulls in preparation for the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion132"]="During the Mid-Autumn Festival, the Korean people will build a \"moon-watching frame\" for the <color=#F2C730FF>elderly</color> to watch the moon. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion133"]="The Zhuang people have the custom of inviting the <color=#F2C730FF>Sun God</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion133_1"]="The Zhuang people invite the Moon God during the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion134"]="In the Zhuang people's custom of inviting the Moon God, it is necessary to have a <color=#F2C730FF>woman</color> act as a spokesperson. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion135"]="In the Zhuang people's custom of inviting the Moon God, the people <color=#F2C730FF>sing antiphonally</color> with the spokesperson of the Moon God. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion136"]="In the Zhuang people's custom of inviting the Moon God, it <color=#F2C730FF>is necessary</color> to see off the Moon God returning to the sky. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion137"]="The <color=#F2C730FF>Zhuang people</color> call the Mid-Autumn Festival the \"August Meeting\" or the \"Harmonizing Festival\". True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion137_1"]="Both these names are used by the Li people.",
    ["OXMidAutumnQuestion138"]="In the Li people's \"Harmonizing Festival\\,\" the <color=#F2C730FF>elderly males and females</color> are called the \"harmonizing leaders\". True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion138_1"]="In the \"Harmonizing Festival\\,\" the \"harmonizing leaders\" who lead the festival are male and female youths.",
    ["OXMidAutumnQuestion139"]="In the Li people's \"August Meeting\\,\" there is also a custom of <color=#F2C730FF>eating moon cakes</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion140"]="In <color=#F2C730FF>Japan</color>, the Mid-Autumn Festival is also called the \"day of Gabae\". True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion140_1"]="In Korea, the Mid-Autumn Festival is called the \"day of Gabae.\"",
    ["OXMidAutumnQuestion141"]="In English, Korea's Chuseok is known as the <color=#F2C730FF>\"Korea's Revival Festival\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion141_1"]="In English, Korea's Chuseok is known as the \"Korea's Thanksgiving.\"",
    ["OXMidAutumnQuestion142"]="The <color=#F2C730FF>Philippines'</color> Mid-Autumn Festival is held to commemorate Agui in the legends. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion142_1"]="Vietnam's Mid-Autumn Festival is held to commemorate Agui.",
    ["OXMidAutumnQuestion143"]="In Vietnamese legends, Agui used the <color=#F2C730FF>bodhi tree</color> to treat people's illnesses. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion144"]="In Vietnamese legends, the <color=#F2C730FF>bodhi tree</color> took Agui to fly to the moon palace. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion145"]="<color=#F2C730FF>Japan's</color> Mid-Autumn Festival activities are more related to animals, such as lion dances and carp lanterns. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion145_1"]="Vietnam's Mid-Autumn Festival activities are more related to animals.",
    ["OXMidAutumnQuestion146"]="In Japan, the Mid-Autumn Festival is also called <color=#F2C730FF>Izayoi</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion146_1"]="In Japan, the Mid-Autumn Festival is also called Jūgoya.",
    ["OXMidAutumnQuestion147"]="In Japan, the Mid-Autumn Festival is also called <color=#F2C730FF>Imomugetsu</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion147_1"]="In Japan, the Mid-Autumn Festival is also called Imomeigetsu.",
    ["OXMidAutumnQuestion148"]="In Japan, it is a custom to <color=#F2C730FF>eat tsukimi dango</color> during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion149"]="In <color=#F2C730FF>Korea</color>, moon-viewing is called \"tsukimi\". True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion149_1"]="\"Tsukimi\" is a moon-viewing activity of Japan.",
    ["OXMidAutumnQuestion150"]="When admiring the moon during the Mid-Autumn Festival in Japan, dango, miscanthus and other items will be displayed <color=#F2C730FF>in the courtyard</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion150_1"]="Exhibits are placed indoors during \"tsukimi.\"",
    ["OXMidAutumnQuestion151"]="To Malaysia, the Mid-Autumn Festival is just an <color=#F2C730FF>imported</color> festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion151_1"]="Malaysia's Mid-Autumn Festival is a very important traditional festival.",
    ["OXMidAutumnQuestion152"]="The story of Chang'e eating an elixir and flying to the moon is a story that has been <color=#F2C730FF>adapted</color> and passed down from generation to generation. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion153"]="The recordation of the moon rabbit pounding medicine was first seen in Qu Yuan's <color=#F2C730FF>Li Sao</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion153_1"]="The recordation of the moon rabbit pounding medicine originated from Qu Yuan's Heavenly Questions.",
    ["OXMidAutumnQuestion154"]="In the legends, the moon rabbit and Chang'e <color=#F2C730FF>have no relationship with each other</color>, and they went to the moon palace separately. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion154_1"]="The moon rabbit is Chang'e's rabbit, which flew with her to the moon palace.",
    ["OXMidAutumnQuestion155"]="In <color=#F2C730FF>Japanese legends</color>, the moon rabbit is not making an immortality medicine. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion156"]="The famous musical composition Raiment of Rainbows and Feathers is related to <color=#F2C730FF>Emperor Tang Taizong's</color> in-the-dream tour of the moon palace. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion157"]="Moon cakes were once used to convey information for the uprisings in the <color=#F2C730FF>Song Dynasty</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion157_1"]="Moon cakes were once used to convey information for the uprisings in the Yuan Dynasty.",
    ["OXMidAutumnQuestion158"]="There is an allegorical saying: The moon on Mid-Autumn Festival—<color=#F2C730FF>upright</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion159"]="There is an allegorical saying: Eating rice cakes on Mid-Autumn Festival—<color=#F2C730FF>too early</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion160"]="There is an allegorical saying: Gazing at lanterns on Mid-Autumn Festival—<color=#F2C730FF>half a year late</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion161"]="There is an allegorical saying: Celebrating the new year on Mid-Autumn Festival—<color=#F2C730FF>wrong season</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion162"]="In some places, there is a custom of stealing food during the Mid-Autumn Festival. <color=#F2C730FF>The more food stolen and eaten</color>, the happier the owner would feel. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion163"]="The practice of boiling wax as a celebratory activity <color=#F2C730FF>has already been forbidden</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion164"]="The Korean Peninsula's Chuseok celebration is <color=#F2C730FF>only to celebrate the autumn harvest</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion164_1"]="In addition to being a celebration of the autumn harvest, Chuseok on the Korean Peninsula also has the meaning of celebrating the victory over Balhae.",
    ["OXMidAutumnQuestion165"]="Ganggangsullae is a folk dance to celebrate the <color=#F2C730FF>Mid-Autumn Festival</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion166"]="Besides referring to the Mid-Autumn Festival, \"tsukimi\" can also refer to<color=#F2C730FF>The October Night</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion166_1"]="Besides referring to the Mid-Autumn Festival, \"tsukimi\" can also refer to The Thirteenth Night.",
    ["OXMidAutumnQuestion167"]="The Mid-Autumn Festival is also called the <color=#F2C730FF>\"Sunlight Festival\"</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion167_1"]="The Mid-Autumn Festival is also called the \"Moonlight Festival.\"",
    ["OXMidAutumnQuestion168"]="<color=#F2C730FF>Moongazing</color> is a custom for single men and women to pray to the Old Man Under the Moon for a good relationship. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion168_1"]="This activity is called Moon Prayer.",
    ["OXMidAutumnQuestion169"]="Watching the tide is a major custom of the Mid-Autumn Festival and is mainly held in <color=#F2C730FF>Zhejiang</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion170"]="Moon basking is a custom in which <color=#F2C730FF>women who don't have children</color> bask under the moonlight at night to pray for children. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion171"]="In <color=#F2C730FF>northern China</color>, it is a custom to burn incense during the Mid-Autumn Festival. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion171_1"]="In Jiangsu, China, it is a custom to burn incense during the Mid-Autumn Festival.",
    ["OXMidAutumnQuestion172"]="\"Stealing moon vegetables\" is a custom of the Mid-Autumn Festival in which young women steal vegetables at night for <color=#F2C730FF>fortune and prosperity</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion172_1"]="\"Stealing moon vegetables\" is practiced to seek a good marriage.",
    ["OXMidAutumnQuestion173"]="The handkerchief-throwing marriage-solicitation custom originated in Fujian, China. In this custom, unmarried women dress up as a <color=#F2C730FF>moon rabbit</color> and throw a handkerchief to solicit suitors. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion173_1"]="The handkerchief-throwing marriage-solicitation custom originated in Fujian, China. In this custom, unmarried women dress up as Chang'e.",
    ["OXMidAutumnQuestion174"]="Wu Gang was <color=#F2C730FF>punished</color> to live on the moon and cut down osmanthus trees. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion175"]="\"Hitting the moon\" is a custom of the <color=#F2C730FF>Tibetian people</color> in which people scoop water and hit the reflection of the moon in the water with stones. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion175_1"]="\"Hitting the moon\" is a custom of the Tu people.",
    ["OXMidAutumnQuestion176"]="The Rabbit God and the moon rabbit are <color=#F2C730FF>different</color> characters. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion176_1"]="The Rabbit God is a moon rabbit.",
    ["OXMidAutumnQuestion177"]="The Mid-Autumn dragon dance originated from the legend of the <color=#F2C730FF>dragon</color> that terrorized the people. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion177_1"]="The Mid-Autumn dragon dance custom originated from the legend of the python that terrorized the people.",
    ["OXMidAutumnQuestion178"]="At the request of Chang'e, the Rabbit God descended from the moon to treat illnesses, but he didn't <color=#F2C730FF>accept any payment</color> for this. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion179"]="The custom of burning towers on Mid-Autumn Festival originated from a <color=#F2C730FF>mutiny</color> in the old days. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion179_1"]="The custom of burning towers on the Mid-Autumn Festival originated from peasant uprisings in the old days.",
    ["OXMidAutumnQuestion180"]="During the Mid-Autumn Festival in Ryukyu, <color=#F2C730FF>fuchagi is eaten and offered as sacrifices</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion181"]="During the Mid-Autumn Festival, people only worship the moon, and the festival counts as a <color=#F2C730FF>astronomical festival</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion181_1"]="During the Mid-Autumn Festival, people worship the moon and the Earth God, and the festival counts as a harvest festival.",
    ["OXMidAutumnQuestion182"]="Planting wheat on Mid-Autumn Festival—<color=#F2C730FF>too early</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion183"]="The weather during Mid-Autumn—<color=#F2C730FF>neither hot nor cold</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion184"]="Grinding grains for the new year on Mid-Autumn Festival—<color=#F2C730FF>earlier</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion185"]="Eating dumplings on Mid-Autumn Festival—<color=#F2C730FF>breaking the rules</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion186"]="Hitting rabbits on Mid-Autumn Festival—<color=#F2C730FF>far from close</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion187"]="Planting peanuts on Mid-Autumn Festival—<color=#F2C730FF>issuing confusing orders</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion188"]="Fishing out the moon on the river bank—<color=#F2C730FF>no good</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion189"]="The moon chasing the sun—<color=#F2C730FF>they never meet</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion190"]="When the clouds cover the moon on Mid-Autumn Festival—<color=#F2C730FF>disappointing</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion191"]="Seeing flames on Mid-Autumn Festival—<color=#F2C730FF>cooling down</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion192"]="Planting beans on Mid-Autumn Festival—<color=#F2C730FF>three seasons late</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion193"]="Reunion cakes on Mid-Autumn Festival—<color=#F2C730FF>not to be given to outsiders</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion194"]="Chang'e using scissors—<color=#F2C730FF>talented</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion195"]="Striking the moon with a bamboo pole—<color=#F2C730FF>it'll never hit</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion196"]="The sun talking to the moon—<color=#F2C730FF>empty talk</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion197"]="Mad dog biting the moon—<color=#F2C730FF>wildly arrogant</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion198"]="A bald person chasing the moon—<color=#F2C730FF>absorbing the light</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion199"]="Lighting a lamp under the moon—<color=#F2C730FF>unnecessary</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
    ["OXMidAutumnQuestion200"]="Playing with a machete under the moon—<color=#F2C730FF>pull it to the light</color>. True <color=#64b4ff>(O)</color> or false <color=#ff6481>(X)</color>? ",
