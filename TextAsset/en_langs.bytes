    ["ResonateDesc_11"]="Awakening Tier I Criteria: Upgrade 2 pieces of equipment to:\nWeapon <color=#ffc821>+60</color>\nArmor <color=#ffc821>+30</color>\nAccessory <color=#ffc821>+15</color>",
    ["ResonateDesc_12"]="Awakening Tier II Criteria: Upgrade 4 pieces of equipment to:\nWeapon <color=#ffc821>+80</color>\nArmor <color=#ffc821>+40</color>\nAccessory <color=#ffc821>+20</color>",
    ["ResonateDesc_13"]="Awakening Tier 3 Criteria: Upgrade 6 pieces of equipment to:\nWeapon <color=#ffc821>+100</color>\nArmor <color=#ffc821>+50</color>\nAccessory <color=#ffc821>+25</color>",
    ["ResonateDesc_14"]="Awakening Tier IV Criteria: Upgrade 8 pieces of equipment to:\nWeapon <color=#ffc821>+120</color>\nArmor <color=#ffc821>+60</color>\nAccessory <color=#ffc821>+30</color>",
    ["ResonateDesc_15"]="Awakening Tier V Criteria: Upgrade 8 pieces of equipment to:\n Weapon <color=#ffc821>+140</color>\n Armor <color=#ffc821>+70</color>\n Accessory <color=#ffc821>+35</color>",
    ["ResonateDesc_16"]="Awakening Tier VI Criteria: Upgrade 8 pieces of equipment to:\n Weapon <color=#ffc821>+160</color>\n Armor <color=#ffc821>+80</color>\n Accessory <color=#ffc821>+40</color>",
