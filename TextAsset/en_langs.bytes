    ["TendencyDesc_1"]="Excel at absorbing and sharing damage.",
    ["TendencyDesc_2"]="Excel at supporting and providing buffs.",
    ["TendencyDesc_3"]="Excel at dealing ranged magic damage.",
    ["TendencyDesc_4"]="Excel at melee combat.",
    ["TendencyDesc_5"]="Excel at dealing single target physical burst damage.",
    ["TendencyDesc_6"]="Excel at dealing ranged physical damage.",
    ["TendencyName_1"]="Tank",
    ["TendencyName_2"]="Support",
