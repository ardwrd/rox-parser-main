        ["MVPRareDropShowLock"]={},
        ["MVPSortEnum"]=110,
        ["MonsterSubdivision"]=0,
        ["RestartExtraRefreshTime"]=0,
        ["countOfRaidDuration"]=6,
        ["description"]="MVPDes_31017",
        ["descriptionLocalized"]="在<color=#CA2E0AFF>海伊洛庄园</color>被魔物侵袭后，守卫队便频繁收到报告，声称在庄园的<color=#CA2E0AFF>废弃枯井</color>周围见到了拥有<color=#CA2E0AFF>白色翅膀</color>的<color=#CA2E0AFF>未知魔物</color>。但奇怪的是，所有与它<color=#CA2E0AFF>对视</color>过的人都会忘记当日所发生的一切，他们的记忆里只剩下一双通透的眼睛，从高悬的澄澈天空中投下视线，仿佛无时无刻都在<color=#CA2E0AFF>凝望着世间所有凡人的命运</color>。\n“祂平等地爱着每一个人，也平等地赐予他们死亡。”苍白的手抚摸过刻在枯井上的<color=#CA2E0AFF>神秘文字</color>，如叹息般的话语消散在夜晚冰凉的空气中。",
        ["dieNpcLastTime"]=0,
        ["dieNpcStaticId"]=0,
