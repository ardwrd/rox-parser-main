    ["Raid_Time_Des"]="剩余挑战时间：%s",
    ["RamadanQuestDesc_101"]="击杀魔物%s/%s次",
    ["RamadanQuestDesc_102"]="进行采矿%s/%s次",
    ["RamadanQuestDesc_103"]="装备强化%s/%s次",
    ["RamadanQuestDesc_104"]="给好友赠送礼物%s/%s次",
    ["RamadanQuestDesc_105"]="完成公会订单%s/%s次",
