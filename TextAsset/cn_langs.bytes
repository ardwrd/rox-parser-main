    ["DialogueOption20730021"]="那舞谱……？",
    ["DialogueOption20730041"]="只是可惜了，这…",
    ["DialogueOption20730042"]="根本不是勇者之剑",
    ["DialogueOption20730081"]="既然这样……",
    ["DialogueOption20730082"]="我还是你的见证者",
    ["DialogueOption20801011"]="（拍拍他）福金！",
    ["DialogueOption20801021"]="什么东西逃走了？",
    ["DialogueOption20801031"]="说人话！",
    ["DialogueOption20801041"]="照片就照片！",
    ["DialogueOption20802011"]="爆炸？！",
    ["DialogueOption20802021"]="那怎么办？",
    ["DialogueOption20802041"]="我明白了",
    ["DialogueOption20803011"]="你没事吧？！",
    ["DialogueOption20803021"]="帮…帮你装回去？",
    ["DialogueOption20803031"]="……机器人？",
    ["DialogueOption20803041"]="我不…啊是是是！",
    ["DialogueOption20804011"]="请问……",
    ["DialogueOption20804061"]="！！！",
    ["DialogueOption20805011"]="……？",
    ["DialogueOption20806021"]="？？！！",
    ["DialogueOption20806041"]="这根本不是狗狗！",
    ["DialogueOption20806051"]="我不……诶诶？！",
    ["DialogueOption20806061"]="奇……怪……？",
    ["DialogueOption20806062"]="有一点……柔软？",
    ["DialogueOption20806101"]="（惊醒）怎么了！",
    ["DialogueOption20807031"]="那个……",
    ["DialogueOption20807041"]="不要紧的",
    ["DialogueOption20807051"]="你有没有见过……",
    ["DialogueOption20807061"]="谢谢你！",
    ["DialogueOption20808051"]="（瞳孔地震）！！",
    ["DialogueOption20808091"]="呼……好像没事？",
    ["DialogueOption20809011"]="我只是个跑腿的…",
    ["DialogueOption20809021"]="我这就跟上去……",
    ["DialogueOption20809031"]="这是……？",
    ["DialogueOption20809061"]="（感激）谢谢你",
    ["DialogueOption20810011"]="……？",
    ["DialogueOption20810031"]="居然有人能骗过你",
    ["DialogueOption20810041"]="……是你的熟人？",
    ["DialogueOption20811011"]="朱诺大学的……",
    ["DialogueOption20811021"]="嗯？",
    ["DialogueOption20813011"]="说人话！！！",
    ["DialogueOption20813031"]="……9？",
    ["DialogueOption20813041"]="那个犯罪者的……",
    ["DialogueOption20813042"]="下一个目标？",
    ["DialogueOption20815011"]="那个人为什么…？",
    ["DialogueOption20816051"]="神秘仪器？",
    ["DialogueOption20816161"]="！！！",
    ["DialogueOption20816181"]="你做什么？！",
    ["DialogueOption20817011"]="（安慰他）",
    ["DialogueOption20817021"]="可你不是说……",
    ["DialogueOption20817031"]="（思考）刚才……",
    ["DialogueOption20817041"]="那究竟是什么？",
    ["DialogueOption20817051"]="时空的夹缝是…？",
    ["DialogueOption20817061"]="（扶额）好了……",
    ["DialogueOption20817062"]="你不要解释了",
    ["DialogueOption20817071"]="你的意思是……？",
    ["DialogueOption20817081"]="9！",
    ["DialogueOption20830011"]="你在做什么",
    ["DialogueOption20830041"]="你……很推崇他？",
    ["DialogueOption20830051"]="那该怎么办？",
    ["DialogueOption20830091"]="你是想……",
    ["DialogueOption20830101"]="要穿越时空？",
    ["DialogueOption20830111"]="我愿意！",
    ["DialogueOption20830121"]="为什么不自己去！",
    ["DialogueOption20830131"]="原来是这样",
    ["DialogueOption20830132"]="……它最好是",
    ["DialogueOption20831011"]="有，但是……",
    ["DialogueOption20831012"]="没有",
    ["DialogueOption20831041"]="什、什么？",
    ["DialogueOption20832011"]="正确的时间线？",
    ["DialogueOption20834011"]="（告知经过）",
    ["DialogueOption20834021"]="关于伽莫夫……",
    ["DialogueOption20834031"]="告知伽莫夫的相貌",
    ["DialogueOption20834041"]="是……今年？",
    ["DialogueOption20834051"]="告知伽莫夫的异样",
    ["DialogueOption20834071"]="他劝达纳托斯放弃",
    ["DialogueOption20834072"]="追击梦罗克",
    ["DialogueOption20836011"]="你很冷静",
    ["DialogueOption20836021"]="那你会遗憾吗",
    ["DialogueOption20837011"]="你没事吧",
    ["DialogueOption20837042"]="下一个地点是？",
    ["DialogueOption20841011"]="你生气啦？",
    ["DialogueOption20841031"]="露诗也在？",
    ["DialogueOption20841041"]="到底发生了什么？",
    ["DialogueOption20843011"]="你都知道了？",
    ["DialogueOption20843021"]="你需要什么？",
    ["DialogueOption20844011"]="<color=#CA2E0AFF>“勇敢地说出实话”</color>",
    ["DialogueOption20844021"]="难道他对露诗…？",
    ["DialogueOption20844031"]="你认识的……？",
    ["DialogueOption20844061"]="让我试试",
    ["DialogueOption20860011"]="你要干什么？",
    ["DialogueOption20860031"]="你好凶残！",
    ["DialogueOption20860041"]="谁说我要离开？",
    ["DialogueOption20860042"]="就没有别的活动吗",
    ["DialogueOption20860071"]="嘘，小声一点……",
    ["DialogueOption20860091"]="可是……",
    ["DialogueOption20861011"]="有看到陈流吗？",
    ["DialogueOption20861031"]="你不想让他回来？",
    ["DialogueOption20861041"]="……我可以帮忙吗？",
    ["DialogueOption20863011"]="丢掉快丢掉！！！",
    ["DialogueOption20863012"]="丢完去洗手！！！",
    ["DialogueOption20863031"]="陈流呢？",
    ["DialogueOption20863041"]="所以……？",
    ["DialogueOption20863051"]="听起来非常不错",
    ["DialogueOption20863052"]="听起来非常不妙",
    ["DialogueOption20864011"]="陈流呢？",
    ["DialogueOption20864031"]="（威胁）你说不说？",
    ["DialogueOption20864032"]="（妥协）求你……",
    ["DialogueOption20865011"]="现在可以告诉我…",
    ["DialogueOption20865021"]="……",
    ["DialogueOption20866011"]="（战斗架势）喂！",
    ["DialogueOption20866021"]="义体？？？",
    ["DialogueOption20866041"]="你！！！",
    ["DialogueOption20867021"]="我来带陈流回去",
    ["DialogueOption20867031"]="你只是要",
    ["DialogueOption20867032"]="为他手术？",
    ["DialogueOption20867071"]="谁是介绍人",
    ["DialogueOption20867081"]="……我明白了",
    ["DialogueOption20868011"]="（看向艾缪）",
    ["DialogueOption20868021"]="？？？",
    ["DialogueOption20868051"]="你们先等等……",
    ["DialogueOption20868071"]="我来！",
    ["DialogueOption20869021"]="你用了什么材料？",
    ["DialogueOption20869031"]="……",
    ["DialogueOption20869101"]="？！",
    ["DialogueOption20870011"]="哇哦~",
    ["DialogueOption20870031"]="可是困在……",
    ["DialogueOption20870032"]="里希塔乐的人……",
    ["DialogueOption20871041"]="你是怎么知道……",
    ["DialogueOption20873021"]="咳咳！咳咳咳！",
    ["DialogueOption20873031"]="在朱诺已经…",
    ["DialogueOption20873041"]="……？",
    ["DialogueOption20873051"]="问卷在哪？",
    ["DialogueOption20873071"]="我明白了",
    ["DialogueOption20874011"]="住手！",
    ["DialogueOption20874021"]="（说明来意）",
    ["DialogueOption20874031"]="你把问卷填完",
    ["DialogueOption20875011"]="我还想知道……",
    ["DialogueOption20875021"]="那些工人……",
    ["DialogueOption20875041"]="我只是觉得……",
    ["DialogueOption20875042"]="不应该这样……",
    ["DialogueOption20876011"]="你怎么知道？",
    ["DialogueOption20876021"]="关于雷根贝勒……",
    ["DialogueOption20876031"]="那你……",
    ["DialogueOption20876041"]="开个价吧",
    ["DialogueOption20876051"]="要这个干什么？",
    ["DialogueOption20877011"]="你的回报？",
    ["DialogueOption20877021"]="？",
    ["DialogueOption20877041"]="……",
    ["DialogueOption20877071"]="（陷入沉思）",
    ["DialogueOption20877081"]="？！",
    ["DialogueOption20877082"]="还我龙心！！！",
    ["DialogueOption20878011"]="其实……",
    ["DialogueOption20878021"]="（共享信息）",
    ["DialogueOption20878031"]="如果……",
    ["DialogueOption20879011"]="哇啊！",
    ["DialogueOption20879021"]="你跟踪我？",
    ["DialogueOption20879022"]="你怎么了？",
    ["DialogueOption20879051"]="我是来……",
    ["DialogueOption20879071"]="我帮你问问？",
    ["DialogueOption20890011"]="还有很多……",
    ["DialogueOption20890051"]="交给我吧",
    ["DialogueOption20891011"]="那你的选题？",
    ["DialogueOption20892011"]="怎么了？",
    ["DialogueOption20892021"]="什么货物？",
    ["DialogueOption20892041"]="（提起问卷）",
    ["DialogueOption20892051"]="我陪你一起去！",
    ["DialogueOption20893081"]="你要多少？",
    ["DialogueOption20894011"]="三个开发部？",
    ["DialogueOption20895011"]="（表明身份）",
    ["DialogueOption20896011"]="难道你也？",
    ["DialogueOption20896021"]="可以为你申请权限",
    ["DialogueOption20896022"]="等回到普隆德拉",
    ["DialogueOption20896031"]="……",
    ["DialogueOption20896041"]="什么意思？",
    ["DialogueOption20896051"]="（将信将疑）",
    ["DialogueOption20896061"]="让我去吉芬帮你",
    ["DialogueOption20896062"]="才是你的目的吧",
    ["DialogueOption20896081"]="一言为定！",
    ["DialogueOption20897031"]="（解释原委）",
    ["DialogueOption20897071"]="？？？",
    ["DialogueOption20898011"]="你没事吧？",
    ["DialogueOption20898021"]="有什么区别吗",
    ["DialogueOption20898041"]="我突然觉得",
    ["DialogueOption20898042"]="刚才不需要我救",
    ["DialogueOption20900011"]="为什么？！",
    ["DialogueOption20900021"]="你要我<color=#CA2E0AFF>跟踪</color>它们？",
    ["DialogueOption20901011"]="我背你去！",
    ["DialogueOption20901012"]="我一个人去追！",
    ["DialogueOption20901051"]="中止",
    ["DialogueOption20902011"]="要分开合作吗",
    ["DialogueOption20902031"]="这是你设定的吗吧",
    ["DialogueOption20903011"]="（讲述经过）",
    ["DialogueOption20903021"]="（指出全部位置）",
    ["DialogueOption20903031"]="怎么了？",
    ["DialogueOption20904011"]="发生什么事了",
    ["DialogueOption20904021"]="梦罗克那边呢",
    ["DialogueOption20904041"]="（看向他的黑眼圈）",
    ["DialogueOption20904061"]="（转告云旭日的话）",
    ["DialogueOption20906051"]="什么？！",
    ["DialogueOption20907011"]="请问……",
    ["DialogueOption20908021"]="他们已到拉赫了？",
    ["DialogueOption20908031"]="什么！！！",
    ["DialogueOption20908051"]="可偏偏是矿区…",
    ["DialogueOption20908061"]="可以",
    ["DialogueOption20908062"]="不可以",
    ["DialogueOption20908091"]="什么？",
    ["DialogueOption20908101"]="从哪里开始搜集呢",
    ["DialogueOption20909011"]="我想向您打听",
    ["DialogueOption20909012"]="圣伊修米娅教皇",
    ["DialogueOption20909021"]="您认识她？",
    ["DialogueOption20909051"]="那结果呢？",
    ["DialogueOption20909071"]="完全不同的",
    ["DialogueOption20909072"]="双重历史……",
    ["DialogueOption20911011"]="告诉我",
    ["DialogueOption20911012"]="他们为什么缺席",
    ["DialogueOption20911031"]="？！！",
    ["DialogueOption20911041"]="通信？",
    ["DialogueOption20912021"]="你对这里不熟悉",
    ["DialogueOption20912022"]="调查的事交给我",
    ["DialogueOption20912031"]="我现在的身份是…",
    ["DialogueOption20912041"]="我明白",
    ["DialogueOption20913011"]="我订了",
    ["DialogueOption20913021"]="各来一份",
    ["DialogueOption20913031"]="我想打听几个人",
    ["DialogueOption20914011"]="（描述成员容貌）",
    ["DialogueOption20914021"]="我是他们的同伴",
    ["DialogueOption20914022"]="我是他们的仇家",
    ["DialogueOption20914081"]="导游是谁？",
    ["DialogueOption20914091"]="我要见那个小孩",
    ["DialogueOption20914101"]="（付款）",
    ["DialogueOption20915031"]="追去哪里了？",
    ["DialogueOption20915051"]="为什么不查？",
    ["DialogueOption20915061"]="！！！",
    ["DialogueOption20915071"]="带我进去",
    ["DialogueOption20915081"]="（付款）",
    ["DialogueOption20915091"]="（付款）",
    ["DialogueOption20915101"]="（付款）",
    ["DialogueOption20916011"]="我来报名",
    ["DialogueOption20916021"]="（试探询问）",
    ["DialogueOption20917011"]="你从哪里得到的！",
    ["DialogueOption20917021"]="（踩住他的手）",
    ["DialogueOption20917031"]="说清楚一点！",
    ["DialogueOption20917041"]="带去哪里？",
    ["DialogueOption20917051"]="你们老板呢？",
    ["DialogueOption20917061"]="（踩住）今天的事……",
    ["DialogueOption20918011"]="什么事",
    ["DialogueOption20918031"]="！！！",
    ["DialogueOption20918041"]="退房后的去向呢",
    ["DialogueOption20919011"]="（分享信息）",
    ["DialogueOption20919031"]="你是说……",
    ["DialogueOption20920011"]="你有没有见过……",
    ["DialogueOption20920021"]="你放她通过了吗",
    ["DialogueOption20921021"]="……",
    ["DialogueOption20921031"]="（不能暴露身份…）",
    ["DialogueOption20921041"]="（歌蒂来过这里…）",
    ["DialogueOption20921042"]="（如果我是她……）",
    ["DialogueOption20921051"]="（一定有痕迹留下）",
    ["DialogueOption20921052"]="（快寻找、快！）",
    ["DialogueOption20921061"]="（那是…！）",
    ["DialogueOption20921062"]="（歌蒂的匕首和…）",
    ["DialogueOption20921071"]="（紧急求救信号…）",
    ["DialogueOption20921072"]="后退半步",
    ["DialogueOption20922011"]="（告知发现）",
    ["DialogueOption20922041"]="什么意思？",
    ["DialogueOption20922042"]="不该立刻救人吗？",
    ["DialogueOption20922071"]="（体谅）",
    ["DialogueOption20922072"]="（不体谅）",
    ["DialogueOption20922101"]="当然",
    ["DialogueOption20930021"]="不不不，我不是……",
    ["DialogueOption20930031"]="放手！",
    ["DialogueOption20931011"]="我不认识你啊！",
    ["DialogueOption20931012"]="阿尔奎因团长？",
    ["DialogueOption20932021"]="可她的铠甲……",
    ["DialogueOption20932041"]="古城？",
    ["DialogueOption20933041"]="她是教国的建国者",
    ["DialogueOption20933071"]="您的意思是？",
    ["DialogueOption20934031"]="你说了……",
    ["DialogueOption20934051"]="我们也要喝么？",
    ["DialogueOption20934091"]="柯蒂士……",
    ["DialogueOption20935011"]="是你在呼唤我们吗",
    ["DialogueOption20935031"]="是的",
    ["DialogueOption20935041"]="（转述情况）",
    ["DialogueOption20935051"]="什么？",
    ["DialogueOption20936011"]="没有……",
    ["DialogueOption20936021"]="！！！",
    ["DialogueOption20936031"]="那我怎么问？",
    ["DialogueOption20936071"]="他要消散了！",
    ["DialogueOption20937011"]="（解释经过）",
    ["DialogueOption20937061"]="我……",
    ["DialogueOption20938161"]="（出言告知）",
    ["DialogueOption20938162"]="（沉默以对）",
    ["DialogueOption20939011"]="（转告）",
    ["DialogueOption20939031"]="？？？",
    ["DialogueOption20941021"]="你们好？",
    ["DialogueOption20941031"]="你也是为了",
    ["DialogueOption20941032"]="报道晨月节庆典？",
    ["DialogueOption20942021"]="（表示赞赏）",
    ["DialogueOption20942022"]="（不以为意）",
    ["DialogueOption20942051"]="但我听说",
    ["DialogueOption20942052"]="尤斯神官将缺席…",
    ["DialogueOption20942061"]="玛拉姆",
    ["DialogueOption20942071"]="真的",
    ["DialogueOption20942101"]="？？？",
    ["DialogueOption20942111"]="？？？",
    ["DialogueOption20942131"]="我？",
    ["DialogueOption20943011"]="其他人呢",
    ["DialogueOption20943021"]="是原来的淘金地吗",
    ["DialogueOption20944011"]="关于铁血神官…",
    ["DialogueOption20944012"]="（沉默不语）",
    ["DialogueOption20945011"]="我从灰狼村…",
    ["DialogueOption20945021"]="这里的人对游牧民…",
    ["DialogueOption20945031"]="（提起专访内容）",
    ["DialogueOption20945041"]="！！！",
    ["DialogueOption20945071"]="好吧",
    ["DialogueOption20946011"]="（掏出相机）",
    ["DialogueOption20948011"]="接下来你打算？",
    ["DialogueOption20948021"]="运输……物流？",
    ["DialogueOption20948031"]="我可以先替他取材",
    ["DialogueOption20949021"]="我见到警卫了",
    ["DialogueOption20951021"]="是素材有问题吗",
    ["DialogueOption20951031"]="其实还有……",
    ["DialogueOption20951051"]="需要重新取材吗？",
    ["DialogueOption20951061"]="？？？",
    ["DialogueOption20951071"]="你的意思是……",
    ["DialogueOption20951081"]="你的猜测太危险",
    ["DialogueOption20951082"]="既得利益者……",
    ["DialogueOption20952011"]="我只是路过",
    ["DialogueOption20952012"]="没接到你的委托",
    ["DialogueOption20952031"]="难度不大，可以",
    ["DialogueOption20952032"]="我要走了，告辞",
    ["DialogueOption20954011"]="你看它的叶片……",
    ["DialogueOption20954021"]="它的茎枝……",
    ["DialogueOption20954031"]="它的根系……",
    ["DialogueOption20954061"]="维奥拉老师？",
    ["DialogueOption20954071"]="中等耐心？",
    ["DialogueOption20954091"]="？？？",
    ["DialogueOption20955011"]="（说明来意）",
    ["DialogueOption20955021"]="她在拉赫",
    ["DialogueOption20955041"]="冷静一点！",
    ["DialogueOption20955051"]="应该是这样",
    ["DialogueOption20956011"]="不能用吗？",
    ["DialogueOption20957011"]="你怎么了？",
    ["DialogueOption20959021"]="维奥拉建议你",
    ["DialogueOption20959022"]="更换论文命题",
    ["DialogueOption20960021"]="……什么？",
    ["DialogueOption20961021"]="你怎么了？",
    ["DialogueOption20961031"]="那我去问村长",
    ["DialogueOption20961041"]="！！！",
    ["DialogueOption20961051"]="对不起……",
    ["DialogueOption20961091"]="嘘——",
    ["DialogueOption20961111"]="我可以帮上什么吗",
    ["DialogueOption20961121"]="你都不怕",
    ["DialogueOption20961122"]="我怕什么",
    ["DialogueOption20962011"]="（说明来意）",
    ["DialogueOption20962081"]="这次，我们一定会",
    ["DialogueOption20962082"]="完成村长的心愿",
    ["DialogueOption20963031"]="你们在说什么？",
    ["DialogueOption20963041"]="……",
    ["DialogueOption20963051"]="当然！",
    ["DialogueOption20963071"]="（讲述葬礼流程）",
    ["DialogueOption20963091"]="我可以试试……",
    ["DialogueOption20965011"]="但灰狼村……",
    ["DialogueOption20965041"]="让我想想……",
    ["DialogueOption20967041"]="所以你为什么愿意",
    ["DialogueOption20967042"]="参加葬礼呢？",
    ["DialogueOption20969021"]="是诗寇蒂的石板？",
    ["DialogueOption20970011"]="我需要做什么吗？",
    ["DialogueOption20971031"]="他们是？",
    ["DialogueOption20972011"]="（说明来意）",
    ["DialogueOption20972021"]="是的",
    ["DialogueOption20972061"]="交给我吧",
    ["DialogueOption20974011"]="您……",
    ["DialogueOption20975011"]="石板怎么了？",
    ["DialogueOption20975021"]="我立刻前往古城",
    ["DialogueOption20976021"]="可我身处当下",
    ["DialogueOption20976022"]="有必须变强的理由",
    ["DialogueOption20976031"]="未来不是我一人的",
    ["DialogueOption20976032"]="它属于很多很多人",
    ["DialogueOption20976071"]="我明白了！",
    ["DialogueOption20977011"]="我该怎么做？",
    ["DialogueOption20977021"]="是<color=#CA2E0AFF>克里图拉学院</color>…",
    ["DialogueOption20977031"]="<color=#CA2E0AFF>一转的职业导师</color>…",
    ["DialogueOption20978021"]="（说明来意）",
    ["DialogueOption20978031"]="是什么？",
    ["DialogueOption20978061"]="……我明白了",
    ["DialogueOption20979011"]="（说明来意）",
    ["DialogueOption20979021"]="它是我重要的同伴",
    ["DialogueOption20981021"]="你们也会到场吗？",
    ["DialogueOption20983021"]="众生？",
    ["DialogueOption20987011"]="（讲述体会）",
    ["DialogueOption20988031"]="怎么啦？",
    ["DialogueOption20988041"]="可以给我吗？",
    ["DialogueOption20989011"]="（说明情况）",
    ["DialogueOption20989031"]="贵族孩子……",
    ["DialogueOption20989032"]="教皇陛下？",
    ["DialogueOption20989041"]="喂喂喂——",
    ["DialogueOption20991021"]="（展示童话书）",
    ["DialogueOption20993011"]="你是？",
    ["DialogueOption20993031"]="发生什么事？",
    ["DialogueOption20993051"]="（虽设定不同……）",
    ["DialogueOption20993052"]="（却是书中剧情……）",
    ["DialogueOption20993081"]="我们一起去！",
    ["DialogueOption20994051"]="当然可以！",
    ["DialogueOption20996011"]="（讲述梦境）",
    ["DialogueOption20996031"]="不如，一起看看",
    ["DialogueOption20996032"]="书中结局吧",
    ["DialogueOption20997011"]="童话故事的结局",
    ["DialogueOption20997012"]="总是幸福美满",
    ["DialogueOption20998031"]="你是？",
    ["DialogueOption20999021"]="？？？",
    ["DialogueOption20999041"]="您……",
    ["DialogueOption21000011"]="你偷听我们！",
    ["DialogueOption21000021"]="……",
    ["DialogueOption21000031"]="那你知道他们",
    ["DialogueOption21000032"]="是什么关系吗",
    ["DialogueOption21000041"]="？？？",
    ["DialogueOption21001031"]="嗯……",
    ["DialogueOption21002111"]="什么？",
    ["DialogueOption21004051"]="（礼貌问好）",
    ["DialogueOption21005021"]="是博格斯说的！",
    ["DialogueOption21006011"]="（陈述经过）",
    ["DialogueOption21006051"]="接下来你打算……",
    ["DialogueOption21006061"]="要帮你留意",
    ["DialogueOption21006062"]="神殿附近的房子吗",
    ["DialogueOption21007011"]="学识渊博的教授",
    ["DialogueOption21007012"]="也要看书学习吗",
    ["DialogueOption21007021"]="你说巴尔文特？",
    ["DialogueOption21008031"]="你的意思是……",
    ["DialogueOption21009011"]="你好？",
    ["DialogueOption21009021"]="什么？！",
    ["DialogueOption21009031"]="（穿越出错了…）",
    ["DialogueOption21009041"]="等一下！别拍我！",
    ["DialogueOption21010011"]="我……",
    ["DialogueOption21010091"]="你说……",
    ["DialogueOption21010092"]="你叫巴尔文特？",
    ["DialogueOption21010101"]="你就是巴尔文特！",
    ["DialogueOption21010121"]="巴尔文特，你得…",
    ["DialogueOption21011041"]="你想说什么？",
    ["DialogueOption21011071"]="去哪里取回？",
    ["DialogueOption21011091"]="所以……",
    ["DialogueOption21011092"]="这是遗留的指令？",
    ["DialogueOption21012011"]="是的",
    ["DialogueOption21012021"]="他们关系不好吗？",
    ["DialogueOption21015021"]="（尝试说服）",
    ["DialogueOption21015081"]="她只是希望你",
    ["DialogueOption21015082"]="解开心结",
    ["DialogueOption21015111"]="可塔莫琳说",
    ["DialogueOption21015112"]="你对机械很感兴趣",
    ["DialogueOption21017041"]="你可以的",
    ["DialogueOption21017051"]="雷根修姆很适合你",
    ["DialogueOption21017061"]="想修好塔莫琳吗？",
    ["DialogueOption21017101"]="加入雷根修姆吧",
    ["DialogueOption21017102"]="你会得到你想要的",
    ["DialogueOption21019011"]="我不是……",
    ["DialogueOption21019021"]="佣兵动乱？",
    ["DialogueOption21019022"]="现在是几几年？",
    ["DialogueOption21019031"]="我也是佣兵！",
    ["DialogueOption21019032"]="我来投奔亲戚！",
    ["DialogueOption21020011"]="巴尔文特先生？",
    ["DialogueOption21020031"]="他要离开了吗？",
    ["DialogueOption21020041"]="那你知道",
    ["DialogueOption21020042"]="他为什么不高兴吗",
    ["DialogueOption21021031"]="他为什么拒收？",
    ["DialogueOption21021091"]="什么！！！",
    ["DialogueOption21021111"]="告辞！",
    ["DialogueOption21022021"]="我……",
    ["DialogueOption21022031"]="……",
    ["DialogueOption21022051"]="我在时空旅行",
    ["DialogueOption21022052"]="遇到了巴尔文特",
    ["DialogueOption21022061"]="巴尔文特将为你",
    ["DialogueOption21022062"]="试图篡改整个时空",
    ["DialogueOption21022071"]="（如实相告）",
    ["DialogueOption21022081"]="是的",
    ["DialogueOption21022101"]="不是这样的",
    ["DialogueOption21023021"]="你在说什么？！",
    ["DialogueOption21023091"]="我只是按照",
    ["DialogueOption21023092"]="既定的历史",
    ["DialogueOption21023101"]="！！！",
    ["DialogueOption21023111"]="……",
    ["DialogueOption21023161"]="！！！",
    ["DialogueOption21024011"]="我……",
    ["DialogueOption21024021"]="那该怎么办",
    ["DialogueOption21025011"]="来自异世界的敌人？",
    ["DialogueOption21025041"]="我明白了！",
    ["DialogueOption21026011"]="这里是....",
    ["DialogueOption21026021"]="\n另一个世界…\n",
    ["DialogueOption21026031"]="告知女神的话",
    ["DialogueOption21026041"]="摇头",
    ["DialogueOption21026051"]="我来帮忙",
    ["DialogueOption21026061"]="是女神的指引",
    ["DialogueOption21027011"]="今天没什么事情呢！",
    ["DialogueOption21027021"]="什么？",
    ["DialogueOption21027022"]="当然！",
    ["DialogueOption21027041"]="不清楚哦..",
    ["DialogueOption21027042"]="不过...",
    ["DialogueOption21027051"]="我可以帮你拿到那个人的作品",
    ["DialogueOption21027061"]="举手之劳。",
    ["DialogueOption21028011"]="我在找...",
    ["DialogueOption21028021"]="太好了？",
    ["DialogueOption21028031"]="好的！",
    ["DialogueOption21028041"]="怎么了？",
    ["DialogueOption21028051"]="好吧...",
    ["DialogueOption21029011"]="醒醒...",
    ["DialogueOption21029021"]="我是来...",
    ["DialogueOption21029031"]="握拳",
    ["DialogueOption21029041"]="我不想要永生...",
    ["DialogueOption21029042"]="我只想要诗集..",
    ["DialogueOption21030011"]="我想...",
    ["DialogueOption21030021"]="是这样的...",
    ["DialogueOption21030031"]="我来负责！",
    ["DialogueOption21030041"]="包在我身上",
    ["DialogueOption21030101"]="奇怪，怎么会有人找到这里来…",
    ["DialogueOption21030201"]="嗯，不错不错~",
    ["DialogueOption21030301"]="嗯，不错不错~",
    ["DialogueOption21030401"]="很好~很好！",
    ["DialogueOption21030501"]="头……好晕……难受……",
    ["DialogueOption21030601"]="熬好了，快趁热把药水盛出来！",
    ["DialogueOption21031011"]="不必了!",
    ["DialogueOption21031101"]="哇啊~！被发现了！",
    ["DialogueOption21031201"]="哦~我的新娘回来了！",
    ["DialogueOption21031301"]="哦，这些东西可真恶心…奥丁啊，这股气味…",
    ["DialogueOption21031401"]="这都是为了爱情…呃…我要窒息了…",
    ["DialogueOption21031501"]="希望希芙里能够喜欢…呕！",
    ["DialogueOption21031601"]="是谁？胆敢冒犯俄塞里斯大人的尊严！",
    ["DialogueOption21031701"]="啊，糟了糟了，这上面全是黑狐的口水……",
    ["DialogueOption21031801"]="哦，非常感谢！你看，这手指还在微微颤动呢~",
    ["DialogueOption21031901"]="鲜红的，怦怦直跳的心脏~属于俄塞里斯大人！",
    ["DialogueOption21032001"]="看这额头的弧度，是多么高贵啊~",
    ["DialogueOption21032011"]="诗集...",
    ["DialogueOption21032101"]="那么，我们也该继续长眠了…冒险者，希望不会再见。",
    ["DialogueOption21032201"]="来来——顺时针搅一搅，药汤药水齐冒泡~",
    ["DialogueOption21032301"]="继续——逆时针搅一搅，千奇百怪变成宝~",
    ["DialogueOption21033011"]="没错，内容是...",
    ["DialogueOption21034011"]="什么？",
    ["DialogueOption21034021"]="微精灵？",
    ["DialogueOption21034022"]="那是什么？",
    ["DialogueOption21034041"]="魔法之都..",
    ["DialogueOption21034051"]="包在我身上！",
    ["DialogueOption21035011"]="说明来意..",
    ["DialogueOption21035031"]="求求你！",
    ["DialogueOption21035032"]="通融通融！",
    ["DialogueOption21035051"]="我去试试！",
    ["DialogueOption21036011"]="告知事情经过",
    ["DialogueOption21036021"]="除非？",
    ["DialogueOption21036022"]="有什么回转余地么？",
    ["DialogueOption21036031"]="她是...",
    ["DialogueOption21036032"]="女神预言的...",
    ["DialogueOption21037011"]="谢谢夸奖！",
    ["DialogueOption21037021"]="谢谢！",
    ["DialogueOption21038011"]="其实是...",
    ["DialogueOption21038031"]="举手之劳..",
    ["DialogueOption21039011"]="我是来...",
    ["DialogueOption21039021"]="我这就去！",
    ["DialogueOption21039022"]="小鱼干卖光啦！",
    ["DialogueOption21039041"]="好吧。",
    ["DialogueOption21040021"]="那个...",
    ["DialogueOption21040031"]="说明来意..",
    ["DialogueOption21040041"]="一条鱼？",
    ["DialogueOption21040051"]="原来是这样？",
    ["DialogueOption21041011"]="告知事情经过",
    ["DialogueOption21041021"]="并不是...",
    ["DialogueOption21041022"]="他只是想买一条鱼...",
    ["DialogueOption21041041"]="让你看看我的技术！",
    ["DialogueOption21042021"]="不用谢。",
    ["DialogueOption21042031"]="我来帮你！",
    ["DialogueOption21042032"]="包在我身上！",
    ["DialogueOption21050301"]="哦哦~没错没错，就是这个！",
    ["DialogueOption21050401"]="我的老朋友，现在又到了并肩作战的时候了。",
    ["DialogueOption23010101"]="实在是太慢了……太慢了！",
    ["DialogueOption23010201"]="（惊喜表情泡）",
    ["DialogueOption23010301"]="哇，非常感谢！",
    ["DialogueOption23010401"]="奥丁啊，这些兔子到底发了什么疯？",
    ["DialogueOption23010501"]="哇，非常感谢！",
    ["DialogueOption23020101"]="啊……痛痛痛痛痛——！！！",
    ["DialogueOption23020201"]="喔~这些草药就能治好我的伤口？",
    ["DialogueOption23020301"]="一定要记住，蜂兵可是非常敏感的魔物哦！",
    ["DialogueOption23020401"]="（爱心表情泡）",
    ["DialogueOption23020501"]="（惊喜表情泡）",
    ["DialogueOption23020601"]="雷神之锤敲击过的大地，裂开的山脉名为妙勒尼~♪",
    ["DialogueOption23020602"]="空间魔法笼罩着的森林，是谁破除了千年的封印~♪",
    ["DialogueOption23020603"]="凝聚的魔力终会扩散，令有智慧的昆虫发生异变~♪",
    ["DialogueOption23020604"]="统领族群的新任王者，将在诸神的注视之下出现~♪",
    ["DialogueOption23020701"]="什么…竟然有这种事？！",
    ["DialogueOption23020702"]="啊~啊，这简直不敢想象！",
    ["DialogueOption23020801"]="它好像……要裂开了？",
    ["DialogueOption23020802"]="等等，这里面的……它不是普通的蜂兵！",
    ["DialogueOption23030101"]="冒险者，我们可以谈一谈吗？",
    ["DialogueOption23030201"]="这……这怎么可能！",
    ["DialogueOption23030301"]="（惊喜表情泡）",
    ["DialogueOption23030401"]="我绝不允许……你再吞噬我的族人！",
    ["DialogueOption23030501"]="唿——唿唿唿！！！",
    ["DialogueOption23030601"]="从今天起，我会带领埃及帝国繁荣昌盛！",
    ["DialogueOption23030602"]="与我的王后——伊西丝一起！",
    ["DialogueOption23030701"]="俄塞里斯大人……",
    ["DialogueOption23030801"]="愿安毕斯神保佑法老王！保佑王后！",
    ["DialogueOption23030901"]="（口水表情泡）",
    ["DialogueOption23031001"]="睁开双眼吧，迷惘的法老王。",
    ["DialogueOption23031002"]="肉体已经归于尘土，但灵魂将会不朽！",
    ["DialogueOption23031101"]="你是……",
    ["DialogueOption23031102"]="冥神大人……",
    ["DialogueOption23040101"]="这都是我的错……谁能帮帮我……",
    ["DialogueOption23040201"]="呵，这块黏土板埋藏得可真够深的！",
    ["DialogueOption23040301"]="这……这是什么？",
    ["DialogueOption23040401"]="（害怕表情泡）",
    ["DialogueOption23040501"]="看啊，它吃得很开心呢~",
    ["DialogueOption23040601"]="（高兴表情泡）",
    ["DialogueOption23040701"]="你到底怎么了？",
    ["DialogueOption23040702"]="啊！",
    ["DialogueOption23040801"]="（愤怒表情泡）",
    ["DialogueOption23040901"]="萝洁……这一切都是我的错……",
    ["DialogueOption23040902"]="如果……如果一切可以重来……",
    ["DialogueOption23041001"]="这……为什么会这样？！",
    ["DialogueOption23041002"]="菲拉斯，救救我！",
    ["DialogueOption23041003"]="不……菲拉斯……救……",
    ["DialogueOption23041101"]="（愤怒表情泡）",
    ["DialogueOption23041201"]="……",
    ["DialogueOption28030101"]="那么拜托你了哦~",
    ["DialogueOption28030201"]="（疑惑表情泡）",
    ["DialogueOption28040101"]="现在，我们将献上这名女童的鲜血……",
    ["DialogueOption28040201"]="为了伟大的魔神——梦罗克大人！",
    ["DialogueOption28040301"]="呜呜……哥哥……",
    ["DialogueOption28060101"]="（高兴表情泡）",
