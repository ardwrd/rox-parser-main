    ["DialogueBubble610801142"]="请注意听，我要切换背景音乐了哦！",
    ["DialogueBubble610801158"]="接下来，我要播放电码了哦，请注意听！",
    ["DialogueBubble610801203"]="3",
    ["DialogueBubble610801208"]="8",
    ["DialogueBubble610801909"]="10个字母像栅栏一样排开……那每行应该有5个字母！",
    ["DialogueBubble610803001"]="●●-●",
    ["DialogueBubble610803002"]="●-",
    ["DialogueBubble610803003"]="●-●",
