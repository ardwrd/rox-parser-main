    ["FairyBuffDes_10201"]="对恶魔系魔物伤害增加 %s",
    ["FairyBuffDes_20201"]="对天使系魔物伤害增加 %s",
    ["FairyBuffDes_30201"]="对无形系&不死系魔物伤害增加 %s",
    ["FairyBuffDes_40201"]="对植物系&人系魔物伤害增加 %s",
    ["FairyBuffDes_50201"]="对龙系&动物系魔物伤害增加 %s",
