    ["ui_ROXIC_019"]="在组队阶段结束时队伍人数少于6人将自动解散",
    ["ui_ROXIC_020"]="可在发送招募至聊天【赛事】频道",
    ["ui_ROXIC_021"]="队伍名称不大于7个字",
    ["ui_ROXIC_022"]="轮空",
