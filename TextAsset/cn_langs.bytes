    ["OXExam_Question031"]="<color=#F2C730FF>短剑</color>可对<color=#F2C730FF>小型魔物</color>造成100%的伤害,对<color=#64b4ff>（O）</color>或错<color=#ff6481>（X）</color>？",
    ["OXExam_Question032"]="<color=#F2C730FF>单手剑</color>可对<color=#F2C730FF>大、中型魔物</color>造成100%的伤害,对<color=#64b4ff>（O）</color>或错<color=#ff6481>（X）</color>？",
    ["OXExam_Question032_1"]="单手剑只有对中型魔物造成100%伤害",
    ["OXExam_Question033"]="<color=#F2C730FF>单手剑</color>可对<color=#F2C730FF>中型魔物</color>造成100%的伤害,对<color=#64b4ff>（O）</color>或错<color=#ff6481>（X）</color>？",
    ["OXExam_Question034"]="<color=#F2C730FF>双手剑</color>可对<color=#F2C730FF>大型魔物</color>造成100%的伤害,对<color=#64b4ff>（O）</color>或错<color=#ff6481>（X）</color>？",
    ["OXExam_Question035"]="<color=#F2C730FF>双手剑</color>可对<color=#F2C730FF>中型魔物</color>造成100%的伤害,对<color=#64b4ff>（O）</color>或错<color=#ff6481>（X）</color>？",
