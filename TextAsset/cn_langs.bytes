    ["SongGanJie2023_15"]="Enjoy The Party",
    ["SongGanJie2023_16"]="匹配对手阶段，无法调整道具",
    ["SongkranFestivalTask_001"]="参与副本%s/%s次",
    ["SongkranFestivalTask_002"]="参与MINI%s/%s次",
    ["SongkranFestivalTask_003"]="参与MVP%s/%s次",
    ["SongkranFestivalTask_004"]="击杀%s/%s只魔物",
    ["SongkranFestivalTask_005"]="分享%s/%s次活动",
