    ["SEA_Achievement_Name_580141"]="骑游天下",
    ["SEA_Achievement_Name_580148"]="与宠同行",
    ["SEA_Achievement_Name_580155"]="周游世界",
    ["SEA_Achievement_Name_580162"]="友谊之框",
    ["SEA_Achievement_Name_580169"]="个性之框",
    ["SEA_Achievement_Name_580176"]="传声之框",
    ["SEA_Achievement_Name_580183"]="百变动作",
    ["SEA_Achievement_Name_580190"]="扭蛋世界",
    ["SEA_Achievement_Name_580197"]="野钓河边",
    ["SEA_Achievement_Name_580204"]="矿洞历险",
    ["SEA_Achievement_Name_580211"]="花草满园",
    ["SEA_Achievement_Name_580218"]="最佳钓手",
    ["SEA_Achievement_Name_580225"]="白金矿工",
    ["SEA_Achievement_Name_580232"]="满级园丁",
    ["SEA_Achievement_Name_580239"]="熔炉之心",
    ["SEA_Achievement_Name_580246"]="神厨当家",
    ["SEA_Achievement_Name_580253"]="抓宠高手",
    ["SEA_Achievement_Name_580260"]="训宠专家",
    ["SEA_Achievement_Name_580267"]="商会挚友",
    ["SEA_Achievement_Name_580274"]="公会挚友",
    ["SEA_Achievement_Name_580281"]="皇家买方",
    ["SEA_Achievement_Name_580288"]="五星卖家",
    ["SEA_Achievement_Name_580295"]="天降红包",
    ["SEA_Achievement_Name_580302"]="顶级贵宾",
    ["SEA_AnniversaryCommand"]="公共频道输入 <color=#EA538C>\"Happy 4th Anniversary\"</color> 即可激活口令奖励",
    ["SEA_AnniversaryCommand_CommandLock"]="输入口令后再来领取吧",
    ["SEA_AnniversaryCommand_Day1"]="1day",
    ["SEA_AnniversaryCommand_Day2"]="2days",
    ["SEA_AnniversaryCommand_Day3"]="3days",
    ["SEA_AnniversaryCommand_Day4"]="4days",
    ["SEA_AnniversaryCommand_Day5"]="5days",
    ["SEA_AnniversaryCommand_Day6"]="6days",
    ["SEA_AnniversaryCommand_Day7"]="7days",
    ["SEA_AnniversaryCommand_Day8"]="8days",
    ["SEA_AnniversaryCommand_EndTime"]="本期截止时间：2022年6月30日",
    ["SEA_AnniversaryCommand_Help01_01"]="每日祝福说明：\n1.本次周年庆活动期间，累积登陆指定天数，即可领取【签到奖励】\n2.周年庆6.18当日开启口令，在公共频道输入口令即可激活【口令奖励】\n3.口令开启后，至周年庆活动结束前使用，均可激活【口令奖励】\n4.【口令奖励】可领取数量等同于累积登陆天数",
    ["SEA_AnniversaryCommand_Lock"]="等奖励激活后再来领取吧",
    ["SEA_AnniversaryFuncDesc1"]="可领取奖励",
    ["SEA_AnniversaryFuncDesc2"]="导入成就领取奖励",
    ["SEA_AnniversaryFuncDesc3"]="可领取奖励",
    ["SEA_AnniversaryFuncDesc4"]="购买时装",
    ["SEA_Anniversary_Duration"]="活动时间：%s ~ %s",
    ["SEA_Anniversary_WorldKVM"]="开启神选者之战II\n<size=18>2022/06/20</size>",
    ["SEA_Year2MemoirDes1_004"]="\n卡普拉的贵宾席正等你入座。",
    ["SEA_Year2MemoirDes1_010"]="\n相信你的目光，已投向多职业转换的道路。",
    ["SEA_Year2MemoirDes1_017"]="\n冒险者啊，去唤醒你的影装吧。",
    ["SEA_Year2MemoirDes1_018"]="\n还要去参与MVP&MINI的战斗，",
    ["SEA_Year2MemoirDes1_019"]="还要去突破副本次数“0”的记录，",
    ["SEA_Year2MemoirDes1_021"]="还要去攀登无尽的恩德勒斯塔，",
    ["SEA_Year2MemoirDes1_023"]="还要去捍卫KVM的公会荣耀。\n如此，方能造就勇者的胸怀。",
    ["SEA_Year2MemoirDes1_026"]="\n享受单身，或缄默言爱，都听情而动。",
    ["SEA_Year2MemoirDes1_028"]="\n独行天下，或随遇而安，",
    ["SEA_Year2MemoirDes1_029"]="都顺意而行。",
    ["SEA_Year2MemoirDes1_032"]="\n一人成团，或三两相伴，都随心而往。",
    ["SEA_Year2MemoirDes1_037"]="\n交易行的大门已经敞开，来成交第一笔订单吧~",
    ["SEA_Year2MemoirDes1_039"]="\n挑选商品上架，赚足你的第一桶金。",
    ["SEA_Year2MemoirDes1_041"]="\n用水晶交易，买下心仪的物品。",
    ["SEA_Year2MemoirDes1_043"]="\n用钻石交易，清空你的购物车。\n谁能拒绝，买买买的快乐呢~",
    ["SEA_Year2MemoirDes1_053"]="\n只为挑选最佳同伴！",
    ["SEA_Year2MemoirDes1_055"]="\n添置时装，填满空空的衣橱吧~",
    ["SEA_Year2MemoirDes1_057"]="\n增加动作，找到自己的社交风格吧~",
    ["SEA_Year2MemoirDes1_059"]="\n购买坐骑，和它一起漫步大陆吧~",
    ["SEA_Year2MemoirDes_001"]="你好，<color=#c69d46>%s</color>，",
    ["SEA_Year2MemoirDes_002"]="自<color=#c69d46>%s</color>起，",
    ["SEA_Year2MemoirDes_003"]="你已在米德加兹度过<color=#c69d46>%s</color>日的冒险时光，",
    ["SEA_Year2MemoirDes_004"]="并于<color=#c69d46>%s</color>成为卡普拉贵宾。",
    ["SEA_Year2MemoirDes_005"]="\n时光如缕，岁月如珠，\n让我们一起细数，\n以你之名留下的传奇。",
    ["SEA_Year2MemoirDes_006"]="你在<color=#c69d46>%s</color>一转为<color=#c69d46>%s</color>，",
    ["SEA_Year2MemoirDes_007"]="在<color=#c69d46>%s</color>天后成功二转，",
    ["SEA_Year2MemoirDes_008"]="在<color=#c69d46>%s</color>天后完成二转进阶，",
    ["SEA_Year2MemoirDes_009"]="在<color=#c69d46>%s</color>天后成为光荣的三转冒险者。",
    ["SEA_Year2MemoirDes_010"]="你还激活了<color=#c69d46>%s</color>条职业分支，\n让世界看到全能冒险者的天赋。",
    ["SEA_Year2MemoirDes_012"]="<color=#c69d46>%s</color>次强化，",
    ["SEA_Year2MemoirDes_013"]="<color=#c69d46>%s</color>次精炼至<color=#c69d46>%s</color>，",
    ["SEA_Year2MemoirDes_014"]="<color=#c69d46>%s</color>次附魔至<color=#c69d46>%s</color>，",
    ["SEA_Year2MemoirDes_015"]="<color=#c69d46>%s</color>张卡片记录神装养成之路。",
    ["SEA_Year2MemoirDes_016"]="奥丁啊，你居然还有<color=#c69d46>%s</color>张金卡！",
    ["SEA_Year2MemoirDes_017"]="成功升级了<color=#c69d46>%s</color>次影装，",
    ["SEA_Year2MemoirDes_018"]="<color=#c69d46>%s</color>次与MVP&MINI的战斗，",
    ["SEA_Year2MemoirDes_019"]="<color=#c69d46>%s</color>次惊险的副本，",
    ["SEA_Year2MemoirDes_020"]="<color=#c69d46>%s</color>次副本点赞。",
    ["SEA_Year2MemoirDes_021"]="<color=#c69d46>%s</color>层的恩德勒斯塔的攀登，",
    ["SEA_Year2MemoirDes_022"]="<color=#c69d46>%s</color>次通关团队副本，",
    ["SEA_Year2MemoirDes_023"]="<color=#c69d46>%s</color>次KVM的浴血奋战。\n你用无尽的武炼，锤锻出炽热的勇者之心。",
    ["SEA_Year2MemoirDes_026"]="<color=#c69d46>%s</color>，你与TA缔结甜蜜的契约。",
    ["SEA_Year2MemoirDes_028"]="<color=#c69d46>%s</color>，",
    ["SEA_Year2MemoirDes_029"]="你加入了<color=#c69d46>%s</color>。",
    ["SEA_Year2MemoirDes_030"]="\n光阴流转，世事变迁，",
    ["SEA_Year2MemoirDes_031"]="你现在是<color=#c69d46>%s</color>的<color=#c69d46>%s</color>。",
    ["SEA_Year2MemoirDes_032"]="你结识了<color=#c69d46>%s</color>名好友，愿友谊之花永不凋零。",
    ["SEA_Year2MemoirDes_034"]="你累计赠送好友<color=#c69d46>%s</color>次礼物，",
    ["SEA_Year2MemoirDes_035"]="点滴心意，悉数珍藏。",
    ["SEA_Year2MemoirDes_037"]="\n你是交易行的常客，已成交<color=#c69d46>%s</color>张订单。",
    ["SEA_Year2MemoirDes_039"]="\n身为卖方，你在交易行赚得<color=#c69d46>%s</color>水晶。",
    ["SEA_Year2MemoirDes_041"]="身为水晶买方，你在交易行中花费<color=#c69d46>%s</color>水晶。",
    ["SEA_Year2MemoirDes_043"]="身为钻石买方，你在交易行中花费<color=#c69d46>%s</color>钻石。\n公平交易，等价交换，市场的规律，你烂熟于心。",
    ["SEA_Year2MemoirDes_046"]="垂钓<color=#c69d46>%s</color>次，",
    ["SEA_Year2MemoirDes_047"]="将钓鱼等级升至<color=#c69d46>%s</color>。",
    ["SEA_Year2MemoirDes_048"]="园艺<color=#c69d46>%s</color>次，",
    ["SEA_Year2MemoirDes_049"]="将园艺等级升至<color=#c69d46>%s</color>。",
    ["SEA_Year2MemoirDes_050"]="挖矿<color=#c69d46>%s</color>次，",
    ["SEA_Year2MemoirDes_051"]="将挖矿等级升至<color=#c69d46>%s</color>。",
    ["SEA_Year2MemoirDes_052"]="认真抓宠<color=#c69d46>%s</color>次，",
    ["SEA_Year2MemoirDes_053"]="终于在当前拥有<color=#c69d46>%s</color>个宠物同伴，",
    ["SEA_Year2MemoirDes_054"]="你的宠物收集进度是<color=#c69d46>%s</color>%%",
    ["SEA_Year2MemoirDes_055"]="<color=#c69d46>%s</color>件时装，定格永恒时尚。",
    ["SEA_Year2MemoirDes_057"]="<color=#c69d46>%s</color>个动作，点亮社交之星。",
    ["SEA_Year2MemoirDes_059"]="<color=#c69d46>%s</color>个坐骑，度过春秋冬夏。",
    ["SEA_Year2MemoirDes_061"]="\n纵使时光生锈，",
    ["SEA_Year2MemoirDes_062"]="我们的回忆不朽。",
    ["SEA_Year2MemoirShareDes1_003"]="从零开始，学习交易知识，努力赚得第一桶晶，",
    ["SEA_Year2MemoirShareDes_001"]="<color=#c69d46>%s</color>，冒险者<color=#c69d46>%s</color>来到米德加兹大陆啦~",
    ["SEA_Year2MemoirShareDes_002"]="从零开始，强化<color=#c69d46>%s</color>次，精炼<color=#c69d46>%s</color>次，附魔<color=#c69d46>%s</color>次，",
    ["SEA_Year2MemoirShareDes_003"]="从零开始，学习交易知识，赚取<color=#c69d46>%s</color>枚水晶，",
    ["SEA_Year2MemoirShareDes_004"]="就让这闪闪发光的装备和水晶，",
    ["SEA_Year2MemoirShareDes_005"]="成为<color=#c69d46>%s</color>天都不曾白费的证明！",
    ["SEA_YearMemoirDes_001"]="<color=#ecc993>%s</color>，你以<color=#ecc993>%s</color>之名来到卢恩王国。",
    ["SEA_YearMemoirDes_002"]="<color=#ecc993>%s</color>，你获得了卡普拉公司的友谊。",
    ["SEA_YearMemoirDes_003"]="<color=#ecc993>%s</color>日的冒险让你变得更加强大。",
    ["SEA_YearMemoirDes_004"]="如今，你已成为二转冒险者<color=#ecc993>%s</color>日，",
    ["SEA_YearMemoirDes_005"]="二转进阶冒险者<color=#ecc993>%s</color>日，",
    ["SEA_YearMemoirDes_006"]="三转冒险者<color=#ecc993>%s</color>日。",
    ["SEA_YearMemoirDes_021"]="\n你对装备养成小有心得，",
    ["SEA_YearMemoirDes_022"]="<color=#ecc993>%s</color>次强化，<color=#ecc993>%s</color>次的精炼，<color=#ecc993>%s</color>次的附魔，",
    ["SEA_YearMemoirDes_023"]="你终于打造出精炼等级<color=#ecc993>%s</color>的装备,",
    ["SEA_YearMemoirDes_024"]="你的附魔最高等级达到了<color=#ecc993>%s</color>级。",
    ["SEA_YearMemoirDes_031"]="\n想获得最强装备吗？\n去找忽克连吧，\n他会告诉你装备养成的奥秘。\n不过，要冷静。",
    ["SEA_YearMemoirDes_041"]="\n你是天生的魔物猎手，",
    ["SEA_YearMemoirDes_042"]="<color=#ecc993>%s</color>次的MVP&MINI作战中，",
    ["SEA_YearMemoirDes_043"]="有<color=#ecc993>%s</color>次是你为魔物敲响最后的丧钟。",
    ["SEA_YearMemoirDes_044"]="你完成了<color=#ecc993>%s</color>次副本历练，",
    ["SEA_YearMemoirDes_045"]="<color=#ecc993>%s</color>个点赞见证你浴血的风姿。",
    ["SEA_YearMemoirDes_051"]="\n战斗是冒险的增味剂，\n不如试试王城外的蓝疯兔？\n毛绒绒的手感一定很棒~",
    ["SEA_YearMemoirDes_061"]="\n最幸运的冒险者，会遇见同伴与爱人。",
    ["SEA_YearMemoirDes_062"]="你在<color=#ecc993>%s</color>许下白首之约，",
    ["SEA_YearMemoirDes_063"]="在<color=#ecc993>%s</color>加入<color=#ecc993>%s</color>,",
    ["SEA_YearMemoirDes_064"]="时光荏苒，你已是<color=#ecc993>%s</color>的<color=#ecc993>%s</color>。",
    ["SEA_YearMemoirDes_065"]="你与<color=#ecc993>%s</color>名好友结缘。",
    ["SEA_YearMemoirDes_071"]="\n你似乎更珍惜独行的自由，\n又或许命运还在为你挑选同伴。\n不必着急，\n无论一人独行还是两人相伴，\n风景都在等你。",
    ["SEA_YearMemoirDes_081"]="\n你是交易行的常客，",
    ["SEA_YearMemoirDes_082"]="已在交易行成功进行了<color=#ecc993>%s</color>笔交易，",
    ["SEA_YearMemoirDes_083"]="赚得<color=#ecc993>%s</color>枚水晶，",
    ["SEA_YearMemoirDes_084"]="支出<color=#ecc993>%s</color>枚水晶，<color=#ecc993>%s</color>枚钻石。",
    ["SEA_YearMemoirDes_091"]="\n听过悦耳的钱币落地声吗？\n现在就去交易行，\n让它们落在你的手中吧~",
    ["SEA_YearMemoirDes_101"]="\n冒险之外，你的日常生活也同样有趣，",
    ["SEA_YearMemoirDes_102"]="<color=#ecc993>%s</color>次的钓鱼造就<color=#ecc993>%s</color>级的钓鱼大师，",
    ["SEA_YearMemoirDes_103"]="<color=#ecc993>%s</color>次的挖矿塑造<color=#ecc993>%s</color>级的采矿专家，",
    ["SEA_YearMemoirDes_104"]="<color=#ecc993>%s</color>次的园艺成就<color=#ecc993>%s</color>级的园艺大师，",
    ["SEA_YearMemoirDes_105"]="<color=#ecc993>%s</color>次的抓宠让<color=#ecc993>%s</color>个小可爱伴你成长，",
    ["SEA_YearMemoirDes_106"]="你的宠物收集度为<color=#ecc993>%s%%</color>。",
    ["SEA_YearMemoirDes_111"]="\n要试着发掘生活的乐趣吗？\n冒险脚步停下后，\n世界依然广阔。",
    ["SEA_YearMemoirDes_Data"]="2021年8月至今",
    ["SEA_YearMemoirDes_Duration"]="活动时间：%s",
    ["SEA_YearMemoirDes_End"]="End",
    ["SEA_YearMemoirDes_EndTime"]="领奖截止：%s",
    ["SEA_YearMemoirDes_Open"]="开启",
    ["SEA_YearMemoirDes_RewardTips"]="看完回忆录激活奖励",
    ["SEA_YearMemoirDes_Title"]="冒险回忆",
    ["SEA_YearMemoirShareDes_001"]="<color=#ecc993>%s</color>，我以<color=#ecc993>%s</color>之名来到卢恩王国……",
    ["SEA_YearMemoirShareDes_002"]="我总共进行了<color=#ecc993>%s</color>次精炼，目前拥有最高达到精炼<color=#ecc993>+%s</color>级！",
    ["SEA_YearMemoirShareDes_003"]="<color=#ecc993>%s</color>次MVP&MINI作战，<color=#ecc993>%s</color>次副本，造就魔物猎手的传说！",
    ["SEA_YearMemoirShareDes_004"]="我在ROX结识了<color=#ecc993>%s</color>名冒险伙伴~",
    ["SPCure"]="SP恢复",
    ["SSBRDes_1"]="鎏金的榜单，记录的是每一位冒险者在与邪恶怪物的战斗中做出的不朽贡献。米德加尔特的命运，终将掌握在冒险者们的手中。请勿忘记，全域降临战排行榜会在每日23:05（UTC+7）更新。",
    ["SSBRDes_2"]="各方的勇士们早已摩拳擦掌！看看这排行榜！它书写着坚韧的守护、书写着激烈的进攻，它记叙了一场场光荣的胜利！战斗吧！命运已准备好为最后的赢家落下笔锋！",
    ["SSBRDes_3"]="众神在上，整个世界都将目光投向这个舞台。排行正随着神选者们的战斗变化，战意正随着时间的流逝攀升。蒙受众神偏爱之人！让这个榜单作为见证，在战斗中写下属于你们的史诗！",
    ["SSBRDes_4"]="战斗潮流尚未停歇！英勇的战士辗转在数个激斗的战场，用武器和意志与战斗共舞！此刻，诸英雄同在，翻阅这份排行，让我们共同见证，是谁——战至世界之巅？",
