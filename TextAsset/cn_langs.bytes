    ["ui_AceHunterRules_001"]="争霸赛规则",
    ["ui_AceHunterRules_002"]="参赛资格规则",
    ["ui_AceHunterRules_003"]="王牌争霸赛规则",
    ["ui_AceHunterRules_004"]="托尼·崔会给拥有资格参赛的玩家发送邀请函，邀请函以邮件的方式发送",
    ["ui_AceHunterRules_005"]="持有邀请函的玩家可以报名参加比赛，报名之后，邀请函将被收回",
    ["ui_AceHunterRules_006"]="邀请函当天有效，获得的邀请函如不使用，第二天将会作废",
    ["ui_AceHunterRules_007"]="报名规则",
    ["ui_AceHunterRules_008"]="活动日期：11月10日~11月17日",
    ["ui_AceHunterRules_009"]="活动总时：21:00-21:25",
    ["ui_AceHunterRules_010"]="报名时间：21:00-21:03",
    ["ui_AceHunterRules_011"]="入场时间：21:03-21:05",
    ["ui_AceHunterRules_012"]="报名需要使用邀请函，在报名开放时，会收到公告通知和提示通知",
    ["ui_AceHunterRules_013"]="报名流程",
    ["ui_AceHunterRules_014"]="邮件领取资格证",
    ["ui_AceHunterRules_015"]="报名",
    ["ui_AceHunterRules_016"]="报名成功",
    ["ui_AceHunterRules_017"]="进入赛场",
    ["ui_AceHunterRules_018"]="贿赂通道规则",
    ["ui_AceHunterRules_019"]="没有获得邀请函的玩家可通过贿赂托尼·崔获取参赛资格",
    ["ui_AceHunterRules_020"]="贿赂通道仅有10个名额，依照贿赂金额大小排序，价高进场",
    ["ui_AceHunterRules_021"]="贿赂金额不做上限控制，最少缴纳10000zeny",
    ["ui_AceHunterRules_022"]="在报名截止时，与托尼·崔对话，获取贿赂结果，未获得资格的冒险家则在对话后，返还一半的贿赂金",
    ["ui_AceHunterRules_023"]="贿赂流程",
    ["ui_AceHunterRules_024"]="NPC对话",
    ["ui_AceHunterRules_025"]="使用金币zeny贿赂",
    ["ui_AceHunterRules_026"]="确认贿赂结果",
    ["ui_AceHunterRules_027"]="赛前规则",
    ["ui_AceHunterRules_028"]="比赛开始前，参赛者必须进入争霸赛赛场",
    ["ui_AceHunterRules_029"]="进入场景后，参赛者将会自动解除组队状态",
    ["ui_AceHunterRules_030"]="在开赛倒计时结束后，没有进入赛场的参赛者，将无法进入场景，视为放弃参赛资格",
    ["ui_AceHunterRules_031"]="准备房间规则",
    ["ui_AceHunterRules_032"]="报名期间，将开设30个赛场，每个赛场参赛者为30人",
    ["ui_AceHunterRules_033"]="在准备期间，可随意退出当前赛场",
    ["ui_AceHunterRules_034"]="参赛规则",
    ["ui_AceHunterRules_035"]="参赛者在开赛后，允许主动退出，退出后，视为丧失比赛资格",
    ["ui_AceHunterRules_036"]="参赛者在比赛期间离线，会保留参赛者形象，并记录期间受到攻击的血量与攻击的伤害",
    ["ui_AceHunterRules_037"]="参赛者被击杀后丧失参赛资格",
    ["ui_AceHunterRules_038"]="参赛者将以观众的身份进入观战状态",
    ["ui_AceHunterRules_039"]="参赛者死亡后离开赛场，可以以观众身份重新进入",
    ["ui_AceHunterRules_040"]="观众规则",
    ["ui_AceHunterRules_041"]="开赛后，冒险家可以以观众的身份进入比赛场地观战",
    ["ui_AceHunterRules_042"]="观众以随机的方式进入正在比赛的赛场",
    ["ui_AceHunterRules_043"]="观众无法被参赛者看到，处于隐身状态",
    ["ui_AceHunterRules_044"]="参赛者被淘汰之后，将会自动转变为观众模式",
    ["ui_AceHunterRules_045"]="参赛者无法使用观众模式进入赛场",
    ["ui_AceHunterRules_046"]="初赛结束规则",
    ["ui_AceHunterRules_047"]="当前场次中仅剩余1人冒险家存活，则判定该房间完成初赛",
    ["ui_AceHunterRules_048"]="初赛结束15秒后，该名优胜者将被传入决赛房间",
    ["ui_AceHunterRules_049"]="观众不会被传送至决赛房间",
    ["ui_AceHunterRules_050"]="比赛结束后30秒后赛场将被移除",
    ["ui_AceHunterRules_051"]="完成初赛并存活的参赛者，将会被传送至决赛房间",
    ["ui_AceHunterRules_052"]="决赛参赛者在开始前可随意离开房间，再次与NPC对话，可直接传送至比赛房间",
    ["ui_AceHunterRules_053"]="决赛规则",
    ["ui_AceHunterRules_054"]="决赛将会在全部初赛结束后2分钟正式开始",
    ["ui_AceHunterRules_055"]="全部初赛结束后，决赛赛场将会开放，参赛者可直接被传送至决赛赛场",
    ["ui_AceHunterRules_056"]="决赛开始前，晋级者可以随意离开房间，准备时间为2分钟",
    ["ui_AceHunterRules_057"]="准备时间结束后，如果没有返回决赛赛场，则视为丧失资格",
    ["ui_AceHunterRules_058"]="离开赛场的晋级者可通过与托尼·崔对话进入赛场，也可通过竞技场面板的【参战】进入",
    ["ui_AceHunterRules_059"]="决赛结束规则",
    ["ui_AceHunterRules_060"]="当该赛场内仅剩一名参赛者存活或倒计时时间结束时，判定活动结束",
    ["ui_AceHunterRules_061"]="将该参赛者标记为王牌斗士，并发放终极大奖",
    ["ui_AceHunterRules_062"]="比赛结束倒计时30秒后，房间将被移除",
    ["ui_AceHunterRules_063"]="奖励领取",
    ["ui_AceHunterRules_064"]="玩家被击杀后，即出现结算界面",
    ["ui_AceHunterRules_065"]="排名列表显示规则：按照名次降序显示参赛者的名次，当前未死亡的玩家不显示",
    ["ui_AceHunterRules_066"]="奖励直接发放给玩家，同时在结算界面展示本场该玩家的奖励",
