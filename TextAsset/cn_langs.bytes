    ["DialogueOption32403042"]="是艾泽王子的要求",
    ["DialogueOption32404011"]="帕尼，我们……",
    ["DialogueOption32404021"]="…我们能帮你什么？",
    ["DialogueOption32404031"]="好，交给我",
    ["DialogueOption32405041"]="（点头）当时……",
    ["DialogueOption32405061"]="……！！！",
    ["DialogueOption32406041"]="……？",
    ["DialogueOption324070101"]="刺客抓到了吗？",
    ["DialogueOption32407081"]="是那个毒药瓶…？",
    ["DialogueOption32408011"]="难道你就是……？",
    ["DialogueOption32408021"]="虽然只是猜测……",
    ["DialogueOption32408031"]="（惊讶）兰德尔？",
    ["DialogueOption32408081"]="你难道没试过…？",
    ["DialogueOption32408091"]="（无奈）那我去吧",
    ["DialogueOption32410081"]="洛伦佐是谁",
    ["DialogueOption32410091"]="好",
    ["DialogueOption32411011"]="（告知详情）",
    ["DialogueOption32411041"]="那我还能做什么？",
    ["DialogueOption32501011"]="波尔呢？",
    ["DialogueOption32501021"]="那我现在……",
    ["DialogueOption32501031"]="……？",
    ["DialogueOption32501041"]="（点头）我明白了",
    ["DialogueOption32504011"]="你们在这里做什么",
    ["DialogueOption32504061"]="我可以留在这里",
    ["DialogueOption32504071"]="好",
    ["DialogueOption32505011"]="你还好吧？",
    ["DialogueOption32505021"]="下毒的人出现了吗",
    ["DialogueOption32505031"]="那……艾泽……？",
    ["DialogueOption32505041"]="皇家骑士团的兵变",
    ["DialogueOption32505042"]="宴会侍者被替换",
    ["DialogueOption32505051"]="我只是想……",
    ["DialogueOption32506011"]="（摇头）",
    ["DialogueOption32506021"]="……为什么？",
    ["DialogueOption32506041"]="你到底想说什么…",
    ["DialogueOption32506051"]="艾伦，你别这样…",
    ["DialogueOption32506061"]="……好。",
    ["DialogueOption32508011"]="艾伦他……",
    ["DialogueOption32508021"]="另外，艾伦的毒…",
    ["DialogueOption32508031"]="（惊喜）难道…？",
    ["DialogueOption32508051"]="噗嗤……",
    ["DialogueOption32509011"]="怎么了？",
    ["DialogueOption32509021"]="好",
    ["DialogueOption32510011"]="……？",
    ["DialogueOption32510021"]="立即进入",
    ["DialogueOption32510022"]="稍作等待",
    ["DialogueOption32511021"]="（惊讶）这不是…",
    ["DialogueOption32516011"]="我……",
    ["DialogueOption32520051"]="艾泽？！",
    ["DialogueOption325220121"]="艾泽？！",
    ["DialogueOption32523011"]="大主教，艾泽他…",
    ["DialogueOption32523041"]="大主教，我能否…",
    ["DialogueOption32523042"]="为艾泽收殓遗体？",
    ["DialogueOption32523061"]="……",
    ["DialogueOption32524031"]="那些宴会侍者",
    ["DialogueOption32524041"]="也许艾泽早就……",
    ["DialogueOption32524051"]="在西门墓地，他…",
    ["DialogueOption32524061"]="巴尔塔家的旧事？",
    ["DialogueOption32524081"]="我们是不是……",
    ["DialogueOption32524082"]="不该怀疑他？",
    ["DialogueOption32524091"]="（点头）",
    ["DialogueOption32525051"]="波尔？",
    ["DialogueOption32525061"]="包括巴尔塔吗？",
    ["DialogueOption32525081"]="就这么放过他们？",
    ["DialogueOption32525091"]="（叹气）那好吧",
    ["DialogueOption32601021"]="纳户特基格……？",
    ["DialogueOption32601031"]="他要你们做什么？",
    ["DialogueOption32601051"]="只是参加派对？",
    ["DialogueOption32602051"]="你们别吵了……",
    ["DialogueOption32602081"]="？？？",
    ["DialogueOption32603011"]="……好",
    ["DialogueOption32604011"]="……什么意思？",
    ["DialogueOption32604021"]="……？",
    ["DialogueOption32605011"]="（疑惑）测试…？",
    ["DialogueOption32605021"]="……要？",
    ["DialogueOption32606011"]="？！？！",
    ["DialogueOption32606041"]="那你岂不是…？",
    ["DialogueOption32607011"]="（晃晃空瓶子）",
    ["DialogueOption32607031"]="这是什么药水？",
    ["DialogueOption32607071"]="…你们在说什么？",
    ["DialogueOption32701011"]="已经哭到打嗝了",
    ["DialogueOption32701012"]="能不能停下来啊！",
    ["DialogueOption32701021"]="（扶额）要不我…",
    ["DialogueOption32701041"]="……？",
    ["DialogueOption32705011"]="……渡？",
    ["DialogueOption32705031"]="（疑惑）是吗…？",
    ["DialogueOption32705061"]="……？",
    ["DialogueOption32706011"]="……怎么会这样？",
    ["DialogueOption32706021"]="有人来了？！",
    ["DialogueOption32801011"]="这是谁的墓？",
    ["DialogueOption32801021"]="果然……",
    ["DialogueOption32801022"]="你才是死灵骑士?",
    ["DialogueOption32801031"]="？！",
    ["DialogueOption32802011"]="你没事吧？",
    ["DialogueOption32802021"]="（说明情况）",
    ["DialogueOption32802041"]="我只是想知道……",
    ["DialogueOption328030101"]="你还好吗？",
    ["DialogueOption32803011"]="那墓志铭也是……？",
    ["DialogueOption328030111"]="你等我！",
    ["DialogueOption32803021"]="（点头）",
    ["DialogueOption32803031"]="（惊讶）难道…？",
    ["DialogueOption32803061"]="你……没赶上吗？",
    ["DialogueOption32803081"]="……是死灵骑士？",
    ["DialogueOption32804011"]="我可以为你保密…",
    ["DialogueOption32804012"]="但是……",
    ["DialogueOption32804031"]="可亡灵不是……？",
    ["DialogueOption32804051"]="所以你才……？",
    ["DialogueOption32804061"]="是刚才的药水？",
    ["DialogueOption32805021"]="你放开她！",
    ["DialogueOption32806031"]="？！",
    ["DialogueOption32901021"]="谁说我要…？！",
    ["DialogueOption32901041"]="（老师也太拼了）",
    ["DialogueOption32901042"]="（老师大可不必）",
    ["DialogueOption32903011"]="（给他一拳）",
    ["DialogueOption32905011"]="他还活着吗？",
    ["DialogueOption32905031"]="谁是接应人？",
    ["DialogueOption32906011"]="你就是……",
    ["DialogueOption32906012"]="所以雷贝布尔格…",
    ["DialogueOption32906021"]="你的主人是沃……",
    ["DialogueOption32907011"]="没有，你为什么…",
    ["DialogueOption32907021"]="我都想知道……",
    ["DialogueOption32907041"]="为什么不动用……",
    ["DialogueOption32907061"]="你是怎么搭上……",
    ["DialogueOption32907071"]="麦吉尔他……",
    ["DialogueOption32907072"]="真的会死吗……",
    ["DialogueOption33002011"]="点金药水？",
    ["DialogueOption33003011"]="灵魂……",
    ["DialogueOption33003021"]="会长……",
    ["DialogueOption33004011"]="你旁边的是……",
    ["DialogueOption33005011"]="倒入酒精……",
    ["DialogueOption33102011"]="准备好了！",
    ["DialogueOption33201021"]="是的",
    ["DialogueOption33202031"]="强大的魔物？",
    ["DialogueOption33203021"]="（惊恐）你又要…",
    ["DialogueOption33203041"]="你想做什么？",
    ["DialogueOption33205011"]="冥神？",
    ["DialogueOption33205051"]="那能不能……",
    ["DialogueOption33207031"]="我愿意！",
    ["DialogueOption33302011"]="准备好了！",
    ["DialogueOption33401021"]="是的",
    ["DialogueOption33403021"]="哈米德导师说……",
    ["DialogueOption33403031"]="以自己……？",
    ["DialogueOption33403041"]="可是……？",
    ["DialogueOption33405011"]="这是什么？",
    ["DialogueOption33405021"]="可是……",
    ["DialogueOption33405031"]="等价交换",
    ["DialogueOption33405041"]="是……",
    ["DialogueOption33502011"]="准备好了！",
    ["DialogueOption33602011"]="准备好了！",
    ["DialogueOption33603021"]="是的",
    ["DialogueOption33604011"]="（说明来意）",
    ["DialogueOption33604061"]="当然！",
    ["DialogueOption33605011"]="？？？",
    ["DialogueOption33605021"]="初与终的卷轴？",
    ["DialogueOption33605031"]="你是守护者？",
    ["DialogueOption33605041"]="你做了什么？",
    ["DialogueOption33605071"]="它要献祭卷轴？",
    ["DialogueOption33605091"]="为什么不求援呢？",
    ["DialogueOption33605151"]="我……",
    ["DialogueOption33606011"]="可不可以……",
    ["DialogueOption33606021"]="我愿意……",
    ["DialogueOption33606041"]="我只遵从",
    ["DialogueOption33606042"]="心的决定",
    ["DialogueOption33606071"]="我愿意！",
    ["DialogueOption33701011"]="……？",
    ["DialogueOption33701021"]="你有没有看见……",
    ["DialogueOption33701022"]="小女孩和机器人？",
    ["DialogueOption33701041"]="谢谢！",
    ["DialogueOption33704011"]="这声音…是罗根？",
    ["DialogueOption33705011"]="（叹气）我不打你",
    ["DialogueOption33705012"]="只要你告诉我……",
    ["DialogueOption33705021"]="……望风？",
    ["DialogueOption33705031"]="她去干什么了？",
    ["DialogueOption33705041"]="那些吸引魔物的…",
    ["DialogueOption33705061"]="……<color=#CA2E0AFF>西边</color>？",
    ["DialogueOption33706011"]="玛蒂斯汀？",
    ["DialogueOption33706021"]="这是你的机器人吗？",
    ["DialogueOption33706031"]="那你在哪里？",
    ["DialogueOption33706041"]="你饿了吗？",
    ["DialogueOption33706051"]="今天是你的生日？",
    ["DialogueOption33706061"]="……你等我一会",
    ["DialogueOption33707011"]="我知道的",
    ["DialogueOption33707021"]="不，谢谢您的关心",
    ["DialogueOption33707031"]="我会注意的",
    ["DialogueOption33708011"]="（点头）另外……",
    ["DialogueOption33708041"]="我明白了，谢谢您",
    ["DialogueOption33709011"]="是的，想吃吗？",
    ["DialogueOption33709021"]="那你先出来",
    ["DialogueOption33709031"]="（叹气）玛蒂斯汀",
    ["DialogueOption33709032"]="不要做坏孩子",
    ["DialogueOption33709051"]="…我给过你机会了",
    ["DialogueOption33711021"]="……？？？",
    ["DialogueOption33711031"]="（迟疑）你是……",
    ["DialogueOption33711061"]="你有双重人格…？",
    ["DialogueOption33711071"]="……噗嗤",
    ["DialogueOption33711072"]="果然还是个小孩子",
    ["DialogueOption33711081"]="……别动",
    ["DialogueOption33712051"]="以后都会帮你包扎",
    ["DialogueOption33712052"]="也会陪你说话玩耍",
    ["DialogueOption33712061"]="…雷根贝勒公司？",
    ["DialogueOption33712071"]="（伸手）来约定吧",
    ["DialogueOption33712081"]="不陪他玩啦！",
    ["DialogueOption33713011"]="我申请了……",
    ["DialogueOption33713021"]="以后也是你的家了",
    ["DialogueOption33713031"]="相遇和离别……",
    ["DialogueOption33713032"]="都是成长的一部分",
    ["DialogueOption33713051"]="真正的家人……",
    ["DialogueOption33713052"]="不会一味听从命令",
    ["DialogueOption33713071"]="（摸摸她的头）",
    ["DialogueOption33713091"]="我们<color=#CA2E0AFF>来日方长</color>",
    ["DialogueOption33802021"]="明白了！",
    ["DialogueOption33802031"]="明！白！了！",
    ["DialogueOption33802061"]="明！白！了！",
    ["DialogueOption33901011"]="院长，我……",
    ["DialogueOption34001031"]="所以这座修道院…",
    ["DialogueOption34003011"]="（令人作呕的味道充斥鼻腔，米勒教官神色如常，示意你看向前方锈蚀的铁闸门）\n现在，我们和七百年前的他们一样，面临着行动的拐点——<color=#CA2E0AFF>一扇地图上并不存在的门。</color>",
    ["DialogueOption34004011"]="是的",
    ["DialogueOption34004031"]="是……贤者虫？",
    ["DialogueOption34004061"]="！！！",
    ["DialogueOption34005011"]="那故事？",
    ["DialogueOption34102011"]="准备好了！",
    ["DialogueOption34201021"]="是的",
    ["DialogueOption34202011"]="“她”是谁？",
    ["DialogueOption34202031"]="好吧",
    ["DialogueOption34203011"]="我是……",
    ["DialogueOption34203021"]="他们死了？",
    ["DialogueOption34203031"]="可是……",
    ["DialogueOption34203041"]="你认识施密特王？",
    ["DialogueOption34203061"]="我会坚守正义",
    ["DialogueOption34203062"]="也需要强大的力量",
    ["DialogueOption34203091"]="我的老师说过…",
    ["DialogueOption34203101"]="什么？",
    ["DialogueOption34402011"]="什么？",
    ["DialogueOption34402021"]="你……！",
    ["DialogueOption34501011"]="争斗？",
    ["DialogueOption34501041"]="我……",
    ["DialogueOption34601081"]="回握她的手",
    ["DialogueOption34601082"]="对她点点头",
    ["DialogueOption34601111"]="忘川？",
    ["DialogueOption34602011"]="你们不想赢？",
    ["DialogueOption34602061"]="为什么要去石阵？",
    ["DialogueOption34602071"]="如果我不同意呢？",
    ["DialogueOption34602081"]="……我同意",
    ["DialogueOption34603011"]="你还好吗？",
    ["DialogueOption34604011"]="这里通向？",
    ["DialogueOption34604021"]="你们！",
    ["DialogueOption34604031"]="我……",
    ["DialogueOption34604041"]="我……",
    ["DialogueOption34605021"]="我想知道",
    ["DialogueOption34605022"]="一切我该知道的",
    ["DialogueOption34605031"]="这些邪骸战士…",
    ["DialogueOption34605041"]="我不明白……",
    ["DialogueOption34605051"]="你也是这样认为？",
    ["DialogueOption34605061"]="你去哪里？",
    ["DialogueOption34701021"]="是的",
    ["DialogueOption34702011"]="你还好吗？",
    ["DialogueOption34702031"]="他们当时是想……",
    ["DialogueOption34702061"]="我不想",
    ["DialogueOption34702062"]="以这样的方式胜利",
    ["DialogueOption34705011"]="他们本不必死",
    ["DialogueOption34705021"]="你到底想做什么",
    ["DialogueOption34705031"]="我也是你的学生！",
    ["DialogueOption34705061"]="我不明白……",
    ["DialogueOption34902011"]="关于修行……",
    ["DialogueOption35101011"]="（碰拳）",
    ["DialogueOption35102021"]="重……",
    ["DialogueOption35103011"]="（点头）",
    ["DialogueOption35301021"]="是的",
    ["DialogueOption35302011"]="我选择继续！",
    ["DialogueOption35303011"]="不能改变吗？",
    ["DialogueOption35303031"]="输了怎么办？",
    ["DialogueOption35304021"]="那名兽人……",
    ["DialogueOption35401011"]="我该怎么做？",
    ["DialogueOption35401021"]="是<color=#CA2E0AFF>克里图拉学院</color>…",
    ["DialogueOption35401031"]="<color=#CA2E0AFF>一转的职业导师</color>…",
    ["DialogueOption35402011"]="这是？？？",
    ["DialogueOption35402021"]="？？？",
    ["DialogueOption35402061"]="我这就去！",
    ["DialogueOption35403011"]="这是……",
    ["DialogueOption35403031"]="那些书灵是……",
    ["DialogueOption35403051"]="当然！",
    ["DialogueOption35502011"]="新的转职……",
    ["DialogueOption35502031"]="更强大的核心？",
    ["DialogueOption35502051"]="为什么是十个？",
    ["DialogueOption35503011"]="没有",
    ["DialogueOption35503012"]="有！",
    ["DialogueOption35602011"]="我想……",
    ["DialogueOption35602021"]="您可以帮我吗？",
    ["DialogueOption35702021"]="！！！",
    ["DialogueOption35702041"]="啊？？？",
    ["DialogueOption35703011"]="（讲述经过）",
    ["DialogueOption35703021"]="（展示武器）",
    ["DialogueOption35802021"]="（说明来意）",
    ["DialogueOption35802031"]="那……？",
    ["DialogueOption35803011"]="（得意）我可是…",
    ["DialogueOption35803021"]="（害羞地摸摸脑袋）",
    ["DialogueOption35803022"]="（骄傲地叉腰）",
    ["DialogueOption35803051"]="当然！我……",
    ["DialogueOption35804011"]="那我……？",
    ["DialogueOption35901021"]="那我……？",
    ["DialogueOption35902011"]="不，我还……",
    ["DialogueOption35902021"]="难道是……？",
    ["DialogueOption35902041"]="您是希望我……？",
    ["DialogueOption35902051"]="如何找到精灵？",
    ["DialogueOption35902052"]="如何解除封印？",
    ["DialogueOption35902071"]="创造者？",
    ["DialogueOption35902072"]="保护者？",
    ["DialogueOption35902073"]="毁灭者？",
    ["DialogueOption35902091"]="（点头）我明白了",
    ["DialogueOption35903011"]="你好？",
    ["DialogueOption35903021"]="……你在说什么？",
    ["DialogueOption35903041"]="（捡起）这是？！",
    ["DialogueOption36002011"]="……什么？",
    ["DialogueOption36002021"]="……你别闹了",
    ["DialogueOption36002031"]="我想成为……",
    ["DialogueOption36002041"]="真死……？",
    ["DialogueOption36002042"]="假死……？",
    ["DialogueOption36003021"]="流氓的决心！",
    ["DialogueOption36003031"]="差不多？？",
    ["DialogueOption36004011"]="你是……左塞？",
    ["DialogueOption36004021"]="你想要什么？",
    ["DialogueOption36005011"]="？？？",
    ["DialogueOption36005021"]="……大可不必",
    ["DialogueOption36102011"]="……你好做作啊",
    ["DialogueOption36102031"]="（用琴敲他）",
    ["DialogueOption36102032"]="（用鞭子抽他）",
    ["DialogueOption3610301"]="许久不见，冒险者。看起来……你的技艺又精进了不少。",
    ["DialogueOption36103031"]="颂者先自述……？",
    ["DialogueOption36103032"]="舞者须悦己……？",
    ["DialogueOption36103081"]="您的意思是……？",
    ["DialogueOption36103091"]="（陷入沉思）",
    ["DialogueOption36103101"]="……我试试看",
    ["DialogueOption36107031"]="……白纸？",
    ["DialogueOption36107032"]="（灵光乍现）有了！",
    ["DialogueOption36107041"]="谢谢你，琪琪！",
    ["DialogueOption36108011"]="我希望自己……",
    ["DialogueOption36108012"]="永远都是一张白纸",
    ["DialogueOption36108021"]="因为我……",
    ["DialogueOption36108071"]="（期待）所以我……？",
    ["DialogueOption36202011"]="你好呀~",
    ["DialogueOption36202021"]="？？？",
    ["DialogueOption36202041"]="……大可不必",
    ["DialogueOption36203011"]="（点头）",
    ["DialogueOption36203021"]="进化药剂？",
    ["DialogueOption36203041"]="……为什么？",
    ["DialogueOption36203051"]="那第二条规则呢？",
    ["DialogueOption36203071"]="当然！",
    ["DialogueOption36205031"]="（点头）",
    ["DialogueOption36205032"]="（摇头）",
    ["DialogueOption36205051"]="那转职……？",
    ["DialogueOption36205071"]="！！！",
    ["DialogueOption36205081"]="谢谢您！",
    ["DialogueOption36302021"]="（骄傲）我已经…",
    ["DialogueOption36302041"]="我这就去！",
    ["DialogueOption36303021"]="那我……？",
    ["DialogueOption36303031"]="放马过来吧！",
    ["DialogueOption36304011"]="……那些佛像？",
    ["DialogueOption36304021"]="然后呢？",
    ["DialogueOption36305011"]="（展示驱魔之火）",
    ["DialogueOption36305021"]="他们究竟是……？",
    ["DialogueOption36305031"]="！！！",
    ["DialogueOption36305051"]="我会的！",
    ["DialogueOption36401031"]="马因司院长……",
    ["DialogueOption36402011"]="院长，我……",
    ["DialogueOption36403011"]="怎么了？",
    ["DialogueOption36403012"]="唐德思怎么不在？",
    ["DialogueOption36403041"]="你为什么……",
    ["DialogueOption36403071"]="（不对劲……）",
    ["DialogueOption36404011"]="另外的足迹…",
    ["DialogueOption36404021"]="出发吧！",
    ["DialogueOption36405011"]="！？",
    ["DialogueOption36405021"]="这是怎么回事？",
    ["DialogueOption36405041"]="那她为什么要……？",
    ["DialogueOption36405061"]="守护他人",
    ["DialogueOption36405062"]="奋勇战斗",
    ["DialogueOption36405063"]="探索未知",
    ["DialogueOption36405131"]="我也是！",
    ["DialogueOption36406031"]="如果感到迷茫…",
    ["DialogueOption36406032"]="不如问问你的心？",
    ["DialogueOption36406071"]="……哎？",
    ["DialogueOption36406081"]="所以你们……",
    ["DialogueOption36502031"]="难道是……",
    ["DialogueOption36503011"]="我……",
    ["DialogueOption36503021"]="为什么一定要…？",
    ["DialogueOption36503041"]="那你之前说……",
    ["DialogueOption36503061"]="！？",
    ["DialogueOption36504011"]="这里难道……",
    ["DialogueOption36504041"]="怎么可能！",
    ["DialogueOption36504042"]="明明……",
