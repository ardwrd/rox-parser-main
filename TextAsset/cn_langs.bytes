    ["DialogueOption82003011"]="不…我不是…",
    ["DialogueOption82003021"]="怎么说？",
    ["DialogueOption82003031"]="可魔物毕竟是魔物",
    ["DialogueOption82004011"]="你说的似乎有道理",
    ["DialogueOption82005011"]="（上交血液样本）",
    ["DialogueOption82005012"]="（进行劝说）",
    ["DialogueOption82101031"]="不好，你快别说了",
    ["DialogueOption82102011"]="照片？",
    ["DialogueOption82102021"]="欸？好吧",
    ["DialogueOption82103011"]="额…过奖了~",
    ["DialogueOption82103021"]="欸？我吗？",
    ["DialogueOption82103031"]="好吧",
    ["DialogueOption82104011"]="啊？和尸体？",
    ["DialogueOption82104021"]="好吧，那我帮你",
    ["DialogueOption82105011"]="还好吧…",
    ["DialogueOption82105021"]="别这样看我…",
    ["DialogueOption82105031"]="真拿你没办法",
    ["DialogueOption82106061"]="你就帮帮他吧~",
    ["DialogueOption82107031"]="你需要帮忙？",
    ["DialogueOption82108011"]="你要干什么？",
    ["DialogueOption82109011"]="你这是…？",
    ["DialogueOption82201011"]="您是在祈求什么？",
    ["DialogueOption82201021"]="她之前回应过吗？",
    ["DialogueOption82202011"]="接待的条件是？",
    ["DialogueOption82204011"]="这声音很可疑",
    ["DialogueOption82204021"]="好吧",
    ["DialogueOption82205011"]="（告知详情）",
    ["DialogueOption82206021"]="我想我得调查一番",
    ["DialogueOption82209011"]="我这就去看看",
    ["DialogueOption82211011"]="从实招来！",
    ["DialogueOption82211021"]="所以你就利用她？",
    ["DialogueOption82211031"]="就怎样？",
    ["DialogueOption82301031"]="你怎么会在这里？",
    ["DialogueOption82301041"]="那其他人呢？",
    ["DialogueOption82301061"]="……",
    ["DialogueOption82303011"]="你是说…？",
    ["DialogueOption82308011"]="（告知详情）",
    ["DialogueOption82309021"]="这是…怎么了？",
    ["DialogueOption82310011"]="娣洁她…",
    ["DialogueOption82310021"]="他们如此饥饿…",
    ["DialogueOption82310031"]="还有脚印方向…",
    ["DialogueOption82312011"]="我也认同",
    ["DialogueOption82313021"]="这话是什么意思？",
    ["DialogueOption82313051"]="奇味果在哪儿？",
    ["DialogueOption82314011"]="这石头怎么了？",
    ["DialogueOption82401011"]="……不许动！",
    ["DialogueOption82401021"]="（被呛到）咳咳！",
    ["DialogueOption82401031"]="你是……？",
    ["DialogueOption82401041"]="巫医是怎么回事？",
    ["DialogueOption82401061"]="…（陷入沉思）",
    ["DialogueOption82401091"]="欣然答应",
    ["DialogueOption82401092"]="先观察状况",
    ["DialogueOption82402011"]="我也……",
    ["DialogueOption82402021"]="（思索）庞德……",
    ["DialogueOption82403011"]="（如实相告）",
    ["DialogueOption82403021"]="果然！",
    ["DialogueOption82403031"]="要想办法……",
    ["DialogueOption82403041"]="这是……？",
    ["DialogueOption82404011"]="……钱？",
    ["DialogueOption82404021"]="（点头）我去",
    ["DialogueOption82405011"]="我想……",
    ["DialogueOption82405021"]="（向他张开五指）",
    ["DialogueOption82405031"]="？？？",
    ["DialogueOption82406031"]="？？？？",
    ["DialogueOption82406091"]="？！？！？！",
    ["DialogueOption82407011"]="庞德的符咒……",
    ["DialogueOption82408041"]="你是魔鬼吗？？？",
    ["DialogueOption82408061"]="你太大声了！",
    ["DialogueOption82408071"]="以后……",
    ["DialogueOption82501011"]="孩子的啼哭声？",
    ["DialogueOption82501021"]="没问题，交给我吧",
    ["DialogueOption82502011"]="（告知详情）",
    ["DialogueOption82502021"]="灵媒？",
    ["DialogueOption82503011"]="废墟中的幽灵…",
    ["DialogueOption82503021"]="她见到我就跑啊…",
    ["DialogueOption82504011"]="怎么在这里等呢？",
    ["DialogueOption82504021"]="你家…",
    ["DialogueOption82506011"]="（告知详情）",
    ["DialogueOption82601011"]="丢了什么东西？",
    ["DialogueOption82601021"]="丢失在哪里？",
    ["DialogueOption82601031"]="？？？",
    ["DialogueOption82601051"]="人没事就是万幸了",
    ["DialogueOption82601061"]="我找找看",
    ["DialogueOption82605011"]="别急！我去采药！",
    ["DialogueOption82606011"]="强盗？",
    ["DialogueOption82606021"]="（拜里恩的说法）",
    ["DialogueOption82607011"]="（询问真相）",
    ["DialogueOption82608021"]="别想跑！",
    ["DialogueOption82701031"]="这可不行~",
    ["DialogueOption82701041"]="自自自、自己人！",
    ["DialogueOption82701051"]="你们要去钟楼？",
    ["DialogueOption82701071"]="我可以进入钟楼",
    ["DialogueOption82701081"]="（点头）",
    ["DialogueOption82704011"]="你是乔伊斯吗？",
    ["DialogueOption82704021"]="我受人所托……",
    ["DialogueOption82704031"]="没关系",
    ["DialogueOption82704032"]="我们尽快回去吧",
    ["DialogueOption82704051"]="好，你在这里等我",
    ["DialogueOption82705011"]="最后那页调查记录",
    ["DialogueOption82705021"]="你说谎了吗？",
    ["DialogueOption82707011"]="（如实相告）",
    ["DialogueOption82707021"]="什么意思？",
    ["DialogueOption82707061"]="抱歉，是我……",
    ["DialogueOption82801011"]="（打招呼）",
    ["DialogueOption82801021"]="好呀",
    ["DialogueOption82801061"]="？",
    ["DialogueOption82801071"]="那……？",
    ["DialogueOption82801081"]="好~",
    ["DialogueOption82802011"]="那么英雄的……",
    ["DialogueOption82807031"]="粉红色头发",
    ["DialogueOption82807032"]="深蓝色头发",
    ["DialogueOption82807061"]="星月法杖",
    ["DialogueOption82807062"]="漆黑大剑",
    ["DialogueOption82807091"]="代表爱与和平消灭你",
    ["DialogueOption82807092"]="高傲而寡言",
    ["DialogueOption82809031"]="粉红色头发",
    ["DialogueOption82809032"]="深蓝色头发",
    ["DialogueOption82809061"]="星月法杖",
    ["DialogueOption82809062"]="漆黑大剑",
    ["DialogueOption82809091"]="代表爱与和平消灭你",
    ["DialogueOption82809092"]="高傲而寡言",
    ["DialogueOption82901011"]="你怎么了？",
    ["DialogueOption82901031"]="？？？",
    ["DialogueOption82902011"]="？？？",
    ["DialogueOption82906011"]="……",
    ["DialogueOption82909011"]="对他跳舞",
    ["DialogueOption82909012"]="拿出武器",
    ["DialogueOption82909021"]="把漂亮小妞交出来",
    ["DialogueOption82909022"]="把你的钱包交出来",
    ["DialogueOption82909031"]="（偷看泰依琳）",
    ["DialogueOption82909041"]="…那我就不客气了",
    ["DialogueOption82910011"]="（悄悄看向泰依琳）",
    ["DialogueOption82910021"]="我……我不差钱！",
    ["DialogueOption82910031"]="（再看一眼泰依琳）",
    ["DialogueOption82910041"]="我…我喜欢男的！",
    ["DialogueOption82911061"]="（落井下石）",
    ["DialogueOption82911062"]="（幸灾乐祸）",
    ["DialogueOption83001011"]="你在算什么~？",
    ["DialogueOption83001021"]="勇者爷爷是谁呀？",
    ["DialogueOption83001031"]="那爸爸叫他什么？",
    ["DialogueOption83001041"]="为什么呀~？",
    ["DialogueOption83001061"]="嗯~？",
    ["DialogueOption83001071"]="（忍笑）好~",
    ["DialogueOption83002011"]="我给您看看！",
    ["DialogueOption83002021"]="必须先治疗",
    ["DialogueOption83002031"]="麦佩妮会担心",
    ["DialogueOption83002041"]="如果……",
    ["DialogueOption83003011"]="你为什么……",
    ["DialogueOption83003021"]="那我有条件",
    ["DialogueOption83003022"]="你只能旁观",
    ["DialogueOption83005011"]="你怎么了？",
    ["DialogueOption83006011"]="……？",
    ["DialogueOption83007021"]="这到底是……？",
    ["DialogueOption83007041"]="那龙眼宝石……？",
    ["DialogueOption83101031"]="需要帮忙吗~",
    ["DialogueOption83101051"]="？！",
    ["DialogueOption83101061"]="没问题",
    ["DialogueOption83102011"]="（上前打招呼）",
    ["DialogueOption83103011"]="我是……",
    ["DialogueOption83103021"]="（点头）",
    ["DialogueOption83103031"]="（叙述猜测）",
    ["DialogueOption83103051"]="那刚才的学生…！",
    ["DialogueOption83105011"]="其他学生的遗体…",
    ["DialogueOption83105021"]="……？",
    ["DialogueOption83106011"]="你早就知道？",
    ["DialogueOption83106021"]="那你为什么……！",
    ["DialogueOption83201011"]="你怎么了？",
    ["DialogueOption83201031"]="什么力量？",
    ["DialogueOption83202011"]="你们没事吧？",
    ["DialogueOption83202021"]="我可以采药！",
    ["DialogueOption83202061"]="宝贝？",
    ["DialogueOption83202101"]="你说吧",
    ["DialogueOption83203011"]="我怀疑......",
    ["DialogueOption83203021"]="可是......",
    ["DialogueOption83204051"]="你想怎么样？",
    ["DialogueOption83205011"]="别难过了",
    ["DialogueOption83205031"]="接下来怎么办？",
    ["DialogueOption83206011"]="你的使命！",
    ["DialogueOption83206031"]="只能用武力了",
    ["DialogueOption83207011"]="扔进火山了",
    ["DialogueOption83207021"]="为了让你清醒",
    ["DialogueOption83207031"]="不客气",
    ["DialogueOption83207041"]="我想想......",
    ["DialogueOption83301011"]="（询问情况）",
    ["DialogueOption83301031"]="连原因都不知道？",
    ["DialogueOption83301051"]="我尽力而为。",
    ["DialogueOption83302011"]="听说您的女儿…",
    ["DialogueOption83302021"]="我希望能帮忙。",
    ["DialogueOption83302022"]="请告诉我实情。",
    ["DialogueOption83302041"]="执念有这么深？",
    ["DialogueOption83302042"]="为什么劝不住？",
    ["DialogueOption83302051"]="若证实誓言为假…",
    ["DialogueOption83302052"]="是不是就能结束…",
    ["DialogueOption83303011"]="我听了你的故事…",
    ["DialogueOption83303012"]="我其实相当感动…",
    ["DialogueOption83303021"]="关于誓言……",
    ["DialogueOption83303041"]="真是意料之中……",
    ["DialogueOption83304011"]="事已至此……",
    ["DialogueOption83304012"]="誓言不过是……",
    ["DialogueOption83304021"]="……",
    ["DialogueOption83305011"]="你在三年前……",
    ["DialogueOption83305012"]="你就是那个……",
    ["DialogueOption83305021"]="林赛她……",
    ["DialogueOption83305031"]="……",
    ["DialogueOption83305041"]="……她还在等着你。",
    ["DialogueOption83305051"]="她还在等着你。",
    ["DialogueOption83305061"]="…这是真的…",
    ["DialogueOption83306011"]="……",
    ["DialogueOption83306031"]="他没有信守承诺。",
    ["DialogueOption83306032"]="…对不起，我…",
    ["DialogueOption83401011"]="王冠的主人...",
    ["DialogueOption83401012"]="像特里斯坦三世…",
    ["DialogueOption83401021"]="（晃钱袋）",
    ["DialogueOption83401031"]="借王冠一用",
    ["DialogueOption83401041"]="什么？",
    ["DialogueOption83402011"]="杰克",
    ["DialogueOption83402031"]="你在说谎！",
    ["DialogueOption83403011"]="我要告发你！",
    ["DialogueOption83403021"]="具体点！",
    ["DialogueOption83403031"]="嗯？",
    ["DialogueOption83404011"]="你怎么了？",
    ["DialogueOption83404031"]="金色十字架......",
    ["DialogueOption83501021"]="……",
    ["DialogueOption83501022"]="你需要帮助吧？",
    ["DialogueOption83501061"]="……好吧。",
    ["DialogueOption83502011"]="我现在正在……",
    ["DialogueOption83502012"]="寻找多伊尔……",
    ["DialogueOption83502071"]="请讲讲多伊尔吧！",
    ["DialogueOption83502101"]="……好吧好吧",
    ["DialogueOption83503041"]="…他还做了什么？",
    ["DialogueOption83503051"]="……",
    ["DialogueOption83503071"]="你们说的这些……",
    ["DialogueOption83503072"]="其实是我做的……",
    ["DialogueOption83504011"]="不是你喊的吗……",
    ["DialogueOption83504021"]="约好？",
    ["DialogueOption83504031"]="这么严重？",
    ["DialogueOption83504041"]="所以现在这是……",
    ["DialogueOption83504051"]="那只好找下一个…",
    ["DialogueOption83504052"]="奥利弗现在在哪？",
    ["DialogueOption83505011"]="多伊尔他……",
    ["DialogueOption83505021"]="他在和别人约会！",
    ["DialogueOption83505031"]="……？",
    ["DialogueOption83505032"]="你不怪他？",
    ["DialogueOption83505051"]="…他说过蓝鸢尾么",
    ["DialogueOption83506011"]="…其实他……",
    ["DialogueOption83506021"]="…没什么。",
    ["DialogueOption83506031"]="…看来必须去。",
    ["DialogueOption83506032"]="找到雷思丽了。",
    ["DialogueOption83507011"]="我来找多伊尔……",
    ["DialogueOption83507031"]="我只是来找他。",
    ["DialogueOption83508011"]="（靠近他）",
    ["DialogueOption83508021"]="加拉赫要我来的。",
    ["DialogueOption83508031"]="（踹他一脚）",
    ["DialogueOption83508032"]="（打他一拳）",
    ["DialogueOption83508041"]="（提起三叶虫靠近）",
    ["DialogueOption83508051"]="不想碰这东西…",
    ["DialogueOption83508052"]="就照我说的做……",
    ["DialogueOption83508061"]="我还有一点要求。",
    ["DialogueOption83508062"]="别再祸害姑娘们。",
    ["DialogueOption83508071"]="回去找加拉赫吧。",
    ["DialogueOption83508072"]="回剧团去道歉吧。",
    ["DialogueOption83601011"]="发生什么事？",
    ["DialogueOption83601021"]="我来帮你调查！",
    ["DialogueOption83602011"]="怎么受伤的？",
    ["DialogueOption83603011"]="怎么受伤的？",
    ["DialogueOption83604011"]="怎么偷袭的？",
    ["DialogueOption83605011"]="我想买一杯啤酒",
    ["DialogueOption83606011"]="难道你就是？",
    ["DialogueOption83606031"]="这样不好哦",
    ["DialogueOption83607011"]="就是它",
    ["DialogueOption84001011"]="那我这就……！",
    ["DialogueOption84001031"]="要我去搜集吗？",
    ["DialogueOption84001041"]="（点头）我明白",
    ["DialogueOption84001042"]="需要什么食材？",
    ["DialogueOption84001061"]="好",
    ["DialogueOption84002041"]="（好奇）什么梦？",
    ["DialogueOption84003011"]="艾泽他，已经……",
    ["DialogueOption84004011"]="……能行吗？",
    ["DialogueOption84101011"]="你还好吗，艾伦？",
    ["DialogueOption84101021"]="你别这样……",
    ["DialogueOption84101031"]="我……",
    ["DialogueOption84101041"]="好",
    ["DialogueOption84103041"]="我去！",
    ["DialogueOption84104031"]="……我去找找吧",
    ["DialogueOption84105051"]="遗骨？！",
    ["DialogueOption84105081"]="……好",
    ["DialogueOption84106041"]="艾伦……？",
    ["DialogueOption84201031"]="你也是王国的人？",
    ["DialogueOption84202011"]="？",
    ["DialogueOption84202031"]="好，你说",
    ["DialogueOption84202041"]="失去联系？",
    ["DialogueOption84202071"]="他们的名字是？",
    ["DialogueOption84202091"]="交给我吧",
    ["DialogueOption84202092"]="那你干什么",
    ["DialogueOption84203061"]="住手！！！",
    ["DialogueOption84204011"]="我想问……",
    ["DialogueOption84204012"]="你怎么会来共和国",
    ["DialogueOption84204041"]="我想请你……",
    ["DialogueOption84204061"]="等等！",
    ["DialogueOption84204062"]="你的同行者是谁？",
    ["DialogueOption84204071"]="他去了哪里？",
    ["DialogueOption84204081"]="难道是他？",
    ["DialogueOption84205011"]="什么？",
    ["DialogueOption84205021"]="（说明来意）",
    ["DialogueOption84205051"]="你们在说什么？",
    ["DialogueOption84205061"]="这里是？",
    ["DialogueOption84205071"]="？？？",
    ["DialogueOption84205121"]="我愿意！",
    ["DialogueOption84205122"]="你不要过来啊！",
    ["DialogueOption84205151"]="你去哪？等等我！",
    ["DialogueOption84206031"]="（怀疑）",
    ["DialogueOption84207011"]="科技的力量赢了！",
    ["DialogueOption84208011"]="（恶寒）离我远点！",
    ["DialogueOption84208021"]="老师？",
    ["DialogueOption84208061"]="（愤怒）陈！流！",
    ["DialogueOption84208071"]="要说话算话！",
    ["DialogueOption84209011"]="谁？",
    ["DialogueOption84209021"]="怎么借助？",
    ["DialogueOption84209031"]="（愤怒）不行！",
    ["DialogueOption84209041"]="不是这样的……",
    ["DialogueOption84210011"]="他们人呢？",
    ["DialogueOption84210021"]="集结？",
    ["DialogueOption84210031"]="要去做什么？",
    ["DialogueOption84210041"]="我可以见他们吗",
    ["DialogueOption84210061"]="当然可以！",
    ["DialogueOption84301011"]="你说",
    ["DialogueOption84301021"]="他们长什么样？",
    ["DialogueOption84301031"]="熟悉的形容……",
    ["DialogueOption84301041"]="交给我吧",
    ["DialogueOption84302011"]="（揶揄）你们……",
    ["DialogueOption84302041"]="停停停！",
    ["DialogueOption84302051"]="关于委托……",
    ["DialogueOption84302061"]="什么事？",
    ["DialogueOption84302071"]="有没有别的办法…",
    ["DialogueOption84302101"]="喂——",
    ["DialogueOption84302111"]="我考虑下……",
    ["DialogueOption84302131"]="我还没有答应呢！",
    ["DialogueOption84303011"]="（说明来意）",
    ["DialogueOption84303021"]="在一起准备道具",
    ["DialogueOption84303051"]="……",
    ["DialogueOption84303071"]="你的意思是？",
    ["DialogueOption84305011"]="（说明来意）",
    ["DialogueOption84305041"]="你要几个？",
    ["DialogueOption84306021"]="表演节目是？",
    ["DialogueOption84307051"]="既然讨厌政治",
    ["DialogueOption84307052"]="为什么还要响应",
    ["DialogueOption84307111"]="等等等等！",
    ["DialogueOption84307112"]="谁的婚礼？",
    ["DialogueOption84401011"]="又怎么啦？",
    ["DialogueOption84401031"]="你说漏嘴了",
    ["DialogueOption84401061"]="你……",
    ["DialogueOption84402091"]="住手！！！",
    ["DialogueOption84402111"]="？？？",
    ["DialogueOption84402121"]="我来是带你和……",
    ["DialogueOption84402141"]="（眩晕）我……",
    ["DialogueOption84403011"]="别闹了……",
    ["DialogueOption84403021"]="我没有……",
    ["DialogueOption84403041"]="好吧……",
    ["DialogueOption84404021"]="我……",
    ["DialogueOption84404101"]="第374页",
    ["DialogueOption84404161"]="你……就算被施加了混淆魔法，你们也不可以擅动图书馆内的书！",
    ["DialogueOption84404171"]="我们走！",
    ["DialogueOption84405011"]="怎么啦？",
    ["DialogueOption84405051"]="要不……",
    ["DialogueOption84405052"]="你答应过的！",
    ["DialogueOption84405061"]="喂喂喂！",
    ["DialogueOption84405071"]="陈流也在哦",
    ["DialogueOption84405081"]="痛痛痛、松开…",
    ["DialogueOption84406011"]="无可奉告",
    ["DialogueOption84406021"]="这怎么行？！",
    ["DialogueOption84406031"]="诶？？？",
    ["DialogueOption84406041"]="可是……",
    ["DialogueOption84501011"]="好久不见~",
    ["DialogueOption84501021"]="（询问任务内容）",
    ["DialogueOption84501031"]="我无意干涉王室",
    ["DialogueOption84501032"]="但他们是我的朋友",
    ["DialogueOption84501041"]="你愿意说了？",
    ["DialogueOption84502021"]="里希塔乐镇？",
    ["DialogueOption84502041"]="那派遣队的任务…",
    ["DialogueOption84503011"]="是的",
    ["DialogueOption84503021"]="他们为何来共和国",
    ["DialogueOption84503031"]="我担心……",
    ["DialogueOption84504011"]="关于派遣队……",
    ["DialogueOption84504012"]="希望能继续协助……",
    ["DialogueOption84504021"]="我会的",
    ["DialogueOption84601011"]="需要帮忙吗？",
    ["DialogueOption84601021"]="什么发布会？",
    ["DialogueOption84601031"]="不是",
