    ["AnniversaryMessageTips_015"]="%s后开启下一场次，每场持续10分钟",
    ["AnniversaryMessageTips_016"]="活动时间：%s~%s",
    ["AnniversaryMessageTips_017"]="许愿成功",
    ["AnniversaryMessageTips_018"]="%s开启",
